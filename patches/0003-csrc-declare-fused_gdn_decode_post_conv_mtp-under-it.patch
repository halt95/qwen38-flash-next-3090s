From 87bcb40dd8c1addb9caca7e84c73266dec1bedf5 Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Mon, 7 Sep 2026 21:40:46 -0400
Subject: [PATCH 3/6] csrc: declare fused_gdn_decode_post_conv_mtp under its own VLLM_ENABLE_FUSED_GDN_DECODE guard (Ampere-only builds)

---
 csrc/libtorch_stable/ops.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/csrc/libtorch_stable/ops.h b/csrc/libtorch_stable/ops.h
index c14194671..c17ec128e 100644
--- a/csrc/libtorch_stable/ops.h
+++ b/csrc/libtorch_stable/ops.h
@@ -400,7 +400,11 @@ void fused_kda_decode(
     torch::stable::Tensor& out, std::optional<double> lower_bound,
     std::optional<torch::stable::Tensor> output_gate,
     std::optional<torch::stable::Tensor> norm_weight, double norm_eps);
+#endif
 
+// Declared under its own guard: FUSED_GDN_DECODE builds on 8.0/8.6 where
+// FUSED_KDA_DECODE (9.0a+) does not.
+#ifdef VLLM_ENABLE_FUSED_GDN_DECODE
 void fused_gdn_decode_post_conv_mtp(
     torch::stable::Tensor const& mixed_qkv, torch::stable::Tensor const& a,
     torch::stable::Tensor const& b, torch::stable::Tensor const& a_log,
