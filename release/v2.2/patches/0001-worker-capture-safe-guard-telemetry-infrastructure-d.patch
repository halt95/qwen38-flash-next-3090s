diff --git a/tests/v1/worker/gpu/test_guard_reader_nonblocking.py b/tests/v1/worker/gpu/test_guard_reader_nonblocking.py
new file mode 100644
index 0000000000..94721e1da2
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_reader_nonblocking.py
@@ -0,0 +1,135 @@
+# SPDX-License-Identifier: Apache-2.0
+"""the instrumentation readers must never wait on the compute stream.
+
+The first cadence reader did a synchronous pageable ``tolist()`` from its thread; the driver held the CUDA context lock
+while that copy waited for the stream, and a pending PLE pull-transport wait on the stream (whose producer needs the
+same lock) deadlocked the worker. These tests park a kernel on the current (compute) stream and require a reader tick
+to return while it is still running. On the pre-fix reader the first GPU test blocks for the kernel's duration.
+"""
+import threading
+import time
+
+import pytest
+import torch
+
+from vllm.v1.worker import guard_telemetry
+
+SLEEP_CYCLES = 4_000_000_000  # ~2 s on a 3090 (torch.cuda._sleep spins for this many cycles)
+
+
+def test_cpu_tensor_reads_directly():
+    r = guard_telemetry.NonBlockingReader()
+    t = torch.tensor([[1, 2, 3]], dtype=torch.int64)
+    r.register("cpu", t)
+    assert r.poll_one("cpu") == [[1, 2, 3]]
+    t[0, 0] = 7
+    assert r.poll()["cpu"] == [[7, 2, 3]]
+
+
+def test_register_refuses_to_run_inside_a_capture(monkeypatch):
+    """Creating the side stream inside a cudagraph capture is not capture-safe."""
+    r = guard_telemetry.NonBlockingReader()
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: True)
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required for the cuda-tensor branch")
+    t = torch.zeros(2, dtype=torch.int64, device="cuda")
+    with pytest.raises(RuntimeError, match="during cudagraph capture"):
+        r.register("x", t)
+
+
+def test_report_waits_for_the_confirming_tick_cpu():
+    """A count rise seen in copy k is reported from copy k+1 (maxima current by then)."""
+    device = torch.device("cpu")
+    guard_telemetry.reset_for_test()
+    buf = guard_telemetry.counter(0, device)  # allocates the cpu buffer
+    full = guard_telemetry._buffers[device]
+    site = guard_telemetry.SITE_MAMBA_COPY
+    full[site, 0] = 2                       # count written, maxima not yet
+    guard_telemetry._poll_once()            # rise seen -> pending, nothing reported
+    assert guard_telemetry._seen.get((device, site), 0) == 0
+    full[site, 1] = 9 + guard_telemetry.GUARD_BIAS   # maxima land before the next tick
+    guard_telemetry._poll_once()            # confirming tick reports count 2 with row 9
+    assert guard_telemetry._seen.get((device, site), 0) == 2
+    snap = guard_telemetry.snapshot()
+    key = f"{device}:{guard_telemetry.SITE_NAMES[site]}"
+    assert snap[key][:2] == [2, 9]
+    guard_telemetry.reset_for_test()
+
+
+def test_module_reader_is_the_non_blocking_kind():
+    assert isinstance(guard_telemetry._nb_reader, guard_telemetry.NonBlockingReader)
+    src = open(guard_telemetry.__file__, encoding="utf-8").read()
+    body = src[src.index("def _poll_once"):src.index("def _arm(")]
+    assert ".tolist()" not in body.replace("host.tolist()", ""), "the cadence reader must not read the device buffer synchronously"
+    assert "poll_one(" in body
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_reader_tick_returns_while_the_compute_stream_is_busy():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    torch.cuda.synchronize(device)
+    # prime: one poll starts the first copy (nothing to report yet)
+    guard_telemetry._poll_once()
+    torch.cuda.synchronize(device)
+
+    # Park a long kernel on the compute (current) stream, then tick the reader.
+    torch.cuda._sleep(SLEEP_CYCLES)
+    t0 = time.monotonic()
+    guard_telemetry._poll_once()
+    tick = time.monotonic() - t0
+    # Prove the stream really was busy: the sync must take a while.
+    t1 = time.monotonic()
+    torch.cuda.synchronize(device)
+    busy = time.monotonic() - t1
+    # The tick assertion comes first: a blocking reader spends the whole sleep inside the tick and would then make
+    # the busy control read ~0 (negative control).
+    assert tick < 0.25, f"reader tick took {tick:.3f}s while the compute stream was busy: it waited on the stream (reader/compute-stream deadlock)"
+    assert tick + busy > 0.5, f"control failed: the parked kernel finished in {tick + busy:.3f}s, the test cannot discriminate"
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_reader_tick_from_a_thread_returns_while_the_compute_stream_is_busy():
+    """The production shape: the tick runs on the reader thread while the main thread owns the stream."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    guard_telemetry._poll_once()
+    torch.cuda.synchronize(device)
+    torch.cuda._sleep(SLEEP_CYCLES)
+    done = threading.Event()
+    elapsed = {}
+
+    def tick():
+        t0 = time.monotonic()
+        guard_telemetry._poll_once()
+        elapsed["tick"] = time.monotonic() - t0
+        done.set()
+
+    threading.Thread(target=tick, name="test-guard-reader", daemon=True).start()
+    finished = done.wait(timeout=1.0)
+    torch.cuda.synchronize(device)
+    assert finished, "the reader tick did not return within 1 s while the compute stream was busy (reader/compute-stream deadlock)"
+    assert elapsed["tick"] < 0.25
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_hits_written_before_a_stall_are_still_reported():
+    """Non-blocking must not mean lossy: a count written on the compute stream is reported once the copy lands."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    buf = guard_telemetry._buffers[device]
+    site = guard_telemetry.SITE_MAMBA_COPY
+    buf[site, 0] += 3  # a "masked access" count, written on the compute stream
+    buf[site, 1] = 5 + guard_telemetry.GUARD_BIAS
+    torch.cuda._sleep(SLEEP_CYCLES // 4)
+    torch.cuda.synchronize(device)
+    # copy -> rise seen -> confirming copy -> report: four ticks at most
+    for _ in range(4):
+        guard_telemetry._poll_once()
+    assert guard_telemetry._seen.get((device, site), 0) == 3
+    snap = guard_telemetry.snapshot()
+    key = f"{device}:{guard_telemetry.SITE_NAMES[site]}"
+    assert snap[key][0] == 3 and snap[key][1] == 5
diff --git a/tests/v1/worker/gpu/test_guard_telemetry_defaults_drain.py b/tests/v1/worker/gpu/test_guard_telemetry_defaults_drain.py
new file mode 100644
index 0000000000..6799a80c4b
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_telemetry_defaults_drain.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounds-guard instrumentation: release defaults, reader loss and the final drain.
+
+1. Release defaults are off / 0.05 with both variables absent (earlier
+   builds defaulted to warn), and a
+   non-finite or non-positive interval is rejected at import.
+2. A reader that loses a device arms the stop (the fatal-site contract is
+   otherwise silently void).
+3. drain() reports a hit the cadence reader never saw and raises for an
+   always-fatal site when asked; it is what a stage end / orderly shutdown
+   calls so a last-step hit cannot be lost.
+"""
+
+import importlib
+import os
+import sys
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="CUDA required"
+)
+
+
+def _fresh(monkeypatch, **env):
+    for k in ("VLLM_E2_GUARD_MODE", "VLLM_E2_GUARD_INTERVAL"):
+        monkeypatch.delenv(k, raising=False)
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+    sys.modules.pop("vllm.v1.worker.guard_telemetry", None)
+    return importlib.import_module("vllm.v1.worker.guard_telemetry")
+
+
+def test_release_defaults_with_env_absent(monkeypatch):
+    gt = _fresh(monkeypatch)
+    assert gt._MODE == "off"  # v2: default off
+    assert gt._INTERVAL == pytest.approx(0.05)
+
+
+@pytest.mark.parametrize("bad", ["nan", "inf", "-inf", "0", "-1", "abc"])
+def test_bad_interval_rejected_at_import(monkeypatch, bad):
+    with pytest.raises(ValueError):
+        _fresh(monkeypatch, VLLM_E2_GUARD_INTERVAL=bad)
+
+
+def test_reader_loss_arms_the_stop(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="warn")  # the reader exists only when opted in (default off)
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt.reset_for_test()
+
+    # v2: the cadence reader no longer reads the device buffer itself; it
+    # polls the NonBlockingReader. Inject the read failure there.
+    def broken_poll(key):
+        raise RuntimeError("simulated D2H failure")
+
+    monkeypatch.setattr(gt._nb_reader, "poll_one", broken_poll)
+    gt._poll_once()
+    assert device in gt._read_disabled
+    with pytest.raises(RuntimeError, match="fatal-site contract"):
+        gt.check_pending()
+
+
+def test_drain_reports_last_step_hit_and_raises_for_fatal_site(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="warn")  # warn mode (opt-in since v2.0.1): a plain site must NOT raise
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt.reset_for_test()
+    buf = gt._buffers[device]
+    # a hit at a non-fatal site, written as the kernels would (count, row, val)
+    plain = next(s for s in gt.SITE_NAMES if s not in gt._ALWAYS_FATAL_SITES)
+    buf[plain, 0] = 3
+    snap = gt.drain(raise_on_fatal=True)
+    assert any(v[0] == 3 for v in snap.values())
+    gt.check_pending()  # nothing armed under warn for a plain site
+    # a hit at the always-fatal RoPE site: drain must raise when asked
+    buf[gt.SITE_QSA_ROPE_POS, 0] = 1
+    with pytest.raises(RuntimeError, match="FINAL DRAIN"):
+        gt.drain(raise_on_fatal=True)
+    # and the non-raising form still arms the stop for the engine thread
+    gt.reset_for_test()
+    buf[gt.SITE_QSA_ROPE_POS, 0] = 1
+    gt.drain()
+    with pytest.raises(RuntimeError):
+        gt.check_pending()
+
+
+def test_drain_is_silent_under_off(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="off")
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt._buffers[device][gt.SITE_QSA_ROPE_POS, 0] = 1
+    assert gt.drain(raise_on_fatal=True) == {}
