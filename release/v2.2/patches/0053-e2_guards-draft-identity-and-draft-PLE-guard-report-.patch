+# ------------------------------------------ the e2-identity draft line
+
+#: The startup smoke's anchored parser for the identity line.
+_IDENTITY_LINE = re.compile(
+    r"e2-identity\[(?P<tag>PP\d+_TP\d+)\]: ple_backend=(?P<backend>\S+) "
+    r"ple_method=(?P<method>\S+) ple_weight_dtype=(?P<dtype>\S+) "
+    r"breakable=(?P<brk>ON|OFF) "
+    r"compile_mode=(?P<cmode>\S+) cudagraph_mode=(?P<gmode>\S+) "
+    r"role=(?P<role>target|draft)\s*$"
+)
+
+
+def _compiled_draft(live: bool):
+    """A draft model whose only compile wrapper is live (or not)."""
+    import torch.nn as nn
+
+    from vllm.compilation.wrapper import TorchCompileWithNoGuardsWrapper
+
+    class _Wrapped(nn.Module, TorchCompileWithNoGuardsWrapper):
+        def __init__(self) -> None:
+            nn.Module.__init__(self)
+
+    inner = _Wrapped()
+    inner.do_not_compile = not live
+    inner.compilation_config = SimpleNamespace(mode=CompilationMode.VLLM_COMPILE)
+    outer = nn.Module()
+    outer.model = inner
+    return outer
+
+
+def _shared_config():
+    """The ONE engine CompilationConfig, as the drafter's holder carries it."""
+    return SimpleNamespace(
+        compilation_config=SimpleNamespace(
+            mode=CompilationMode.VLLM_COMPILE,
+            cudagraph_mode=CUDAGraphMode.FULL_AND_PIECEWISE,
+        )
+    )
+
+
+def _resolved_speculator(model, prefill, decode):
+    """V2 autoregressive / MTP speculator after init_cudagraph_manager."""
+    return SimpleNamespace(
+        model=model,
+        vllm_config=_shared_config(),
+        prefill_cudagraph_manager=(
+            None if prefill is None else SimpleNamespace(cudagraph_mode=prefill)
+        ),
+        decode_cudagraph_manager=(
+            None if decode is None else SimpleNamespace(cudagraph_mode=decode)
+        ),
+    )
+
+
+def _logged_identity(monkeypatch, fn, *args) -> list[str]:
+    from vllm.v1.worker import e2_identity
+
+    lines: list[str] = []
+    monkeypatch.setattr(e2_identity, "_rank_tag", lambda: "PP1_TP0")
+    monkeypatch.setattr(
+        e2_identity.logger, "info", lambda fmt, *a: lines.append(fmt % a)
+    )
+    monkeypatch.setattr(
+        e2_identity.logger, "warning", lambda fmt, *a: lines.append("WARN " + fmt % a)
+    )
+    fn(*args)
+    return lines
+
+
+def test_draft_identity_reports_the_drafters_resolved_graph_state(monkeypatch) -> None:
+    """The draft line read compile/cudagraph from the target's
+    shared VllmConfig (FULL_AND_PIECEWISE), while the V2 MTP speculator runs
+    prefill FULL_AND_PIECEWISE + decode FULL_DECODE_ONLY (the modes
+    e2-guard[runtime] logs). It must report the managers and the live wrapper,
+    in the smoke-anchored format."""
+    from vllm.v1.worker import e2_identity
+
+    runner = SimpleNamespace(
+        speculator=_resolved_speculator(
+            _compiled_draft(live=True),
+            CUDAGraphMode.FULL_AND_PIECEWISE,
+            CUDAGraphMode.FULL_DECODE_ONLY,
+        )
+    )
+    lines = _logged_identity(monkeypatch, e2_identity.log_draft_identity, runner)
+    assert len(lines) == 1, lines
+    m = _IDENTITY_LINE.search(lines[0])
+    assert m, lines[0]
+    assert m["role"] == "draft" and m["tag"] == "PP1_TP0"
+    assert m["cmode"] == "VLLM_COMPILE"
+    assert m["gmode"] == "prefill:FULL_AND_PIECEWISE,decode:FULL_DECODE_ONLY"
+    assert m["backend"] == m["method"] == m["dtype"] == "none"
+
+
+def test_draft_identity_compile_mode_is_the_live_wrapper(monkeypatch) -> None:
+    """Same shared config (VLLM_COMPILE); only the draft wrapper's liveness
+    differs -- the line must follow the wrapper, not the config."""
+    from vllm.v1.worker import e2_identity
+
+    runner = SimpleNamespace(
+        speculator=_resolved_speculator(
+            _compiled_draft(live=False),
+            CUDAGraphMode.FULL_AND_PIECEWISE,
+            CUDAGraphMode.FULL_DECODE_ONLY,
+        )
+    )
+    (line,) = _logged_identity(monkeypatch, e2_identity.log_draft_identity, runner)
+    m = _IDENTITY_LINE.search(line)
+    assert m and m["cmode"] == "NONE", line
+
+
+@pytest.mark.parametrize("shape", ["single", "unbuilt", "v1"])
+def test_draft_identity_other_speculator_shapes(monkeypatch, shape) -> None:
+    """Single-manager speculator -> bare mode; manager not built -> unresolved;
+    V1 drafter -> its dispatcher's mode. All still parse."""
+    from vllm.v1.worker import e2_identity
+
+    if shape == "single":
+        holder = SimpleNamespace(
+            model=_compiled_draft(live=True),
+            vllm_config=_shared_config(),
+            cudagraph_manager=SimpleNamespace(
+                cudagraph_mode=CUDAGraphMode.FULL_DECODE_ONLY
+            ),
+        )
+        runner, want = SimpleNamespace(speculator=holder), "FULL_DECODE_ONLY"
+    elif shape == "unbuilt":
+        holder = _resolved_speculator(_compiled_draft(live=True), None, None)
+        runner = SimpleNamespace(speculator=holder)
+        want = "prefill:unresolved,decode:unresolved"
+    else:
+        holder = SimpleNamespace(
+            model=_compiled_draft(live=True),
+            vllm_config=_shared_config(),
+            cudagraph_dispatcher=SimpleNamespace(
+                keys_initialized=True, cudagraph_mode=CUDAGraphMode.PIECEWISE
+            ),
+        )
+        runner, want = SimpleNamespace(drafter=holder), "PIECEWISE"
+    (line,) = _logged_identity(monkeypatch, e2_identity.log_draft_identity, runner)
+    m = _IDENTITY_LINE.search(line)
+    assert m and m["role"] == "draft" and m["gmode"] == want, line
+
+
+def test_target_line_at_load_draft_line_after_kv_init(monkeypatch) -> None:
+    """Load time logs the target line only (config level, unchanged); the
+    draft line is logged by log_draft_identity, which the worker calls after
+    initialize_kv_cache, where the drafter's managers are resolved."""
+    from vllm.v1.worker import e2_identity
+
+    runner = SimpleNamespace(
+        get_model=lambda: None,
+        speculator=_resolved_speculator(
+            _compiled_draft(live=True),
+            CUDAGraphMode.FULL_AND_PIECEWISE,
+            CUDAGraphMode.FULL_DECODE_ONLY,
+        ),
+    )
+    lines = _logged_identity(
+        monkeypatch, e2_identity.log_launch_identity, runner, _shared_config()
+    )
+    assert len(lines) == 1, lines
+    m = _IDENTITY_LINE.search(lines[0])
+    assert m and m["role"] == "target", lines
+    assert (m["cmode"], m["gmode"]) == ("VLLM_COMPILE", "FULL_AND_PIECEWISE")
+    # No drafter on this rank (not the last PP stage): no draft line, no warning.
+    assert (
+        _logged_identity(monkeypatch, e2_identity.log_draft_identity, SimpleNamespace())
+        == []
+    )
+    # The worker wiring: log_draft_identity follows initialize_kv_cache.
+    src = (REPO / "vllm/v1/worker/gpu_worker.py").read_text(encoding="utf-8")
+    body = src[src.index("def initialize_from_config") :]
+    body = body[: body.index("\n    def ", 1)]
+    assert "log_draft_identity(self.model_runner)" in body
+    assert body.index("initialize_kv_cache(") < body.index(
+        "log_draft_identity(self.model_runner)"
+    )
+
