+def _ple_config(ids, *, num_hidden_layers=4, mtp_layers=1):
+    def text():
+        return SimpleNamespace(
+            ple_layer_ids=list(ids),
+            num_hidden_layers=num_hidden_layers,
+            mtp_num_hidden_layers=mtp_layers,
+        )
+
+    return SimpleNamespace(
+        engram_config=SimpleNamespace(cpu_offload=False),
+        model_config=SimpleNamespace(hf_text_config=text()),
+        speculative_config=SimpleNamespace(
+            draft_model_config=SimpleNamespace(hf_text_config=text())
+        ),
+    )
+
+
+def _ple_guard_ids(monkeypatch, config, role) -> str:
+    lines: list[str] = []
+    monkeypatch.setattr(
+        e2_guards.logger, "info", lambda fmt, *args: lines.append(fmt % args)
+    )
+    assert_ple_mode(config, role=role)
+    (line,) = lines
+    return line.rsplit("ple_layer_ids=", 1)[1]
+
+
+def test_draft_ple_guard_reports_the_drafters_own_ple_layers(monkeypatch) -> None:
+    """The reference host logged ple_layer_ids=[2] on the DRAFT guard
+    line -- the target's ids, read from the target's model_config. The MTP
+    drafter's layers (num_hidden_layers + i) carry no PLE block, so the draft
+    line must say []; the target line keeps [2]."""
+    monkeypatch.setenv(PULL_TRANSPORT_ENV, "1")
+    _clear_envs_cache()
+    cfg = _ple_config([2])
+    assert _ple_guard_ids(monkeypatch, cfg, "target") == "[2]."
+    assert _ple_guard_ids(monkeypatch, cfg, "draft") == "[]."
+
+
+def test_draft_ple_ids_follow_the_mtp_layer_range(monkeypatch) -> None:
+    """Discrimination: an id that DOES name an MTP layer (num_hidden_layers+1)
+    is reported on the draft line -- the rule is the drafter's own layers, not
+    'always empty'. (Qwen4ExpTextConfig rejects such ids; this is a stand-in.)"""
+    monkeypatch.setenv(PULL_TRANSPORT_ENV, "1")
+    _clear_envs_cache()
+    cfg = _ple_config([2, 5], num_hidden_layers=4, mtp_layers=1)
+    assert _ple_guard_ids(monkeypatch, cfg, "draft") == "[5]."
+    assert _ple_guard_ids(monkeypatch, cfg, "target") == "[2, 5]."
