         f"breakable={'ON' if is_breakable_cudagraph_enabled() else 'OFF'} "
-        f"compile_mode={_enum_name(getattr(compilation, 'mode', None))} "
-        f"cudagraph_mode={_enum_name(getattr(compilation, 'cudagraph_mode', None))} "
+        f"compile_mode={compile_mode} "
