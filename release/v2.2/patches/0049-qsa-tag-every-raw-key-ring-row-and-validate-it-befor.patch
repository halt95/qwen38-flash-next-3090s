+def test_clear_then_commit_orders_correctly_on_a_real_ring():
+    """Claim -> clear -> the new owner's commit: the commit survives (the
+    clear never lands after it), and an uncommitted row reads tag 0."""
+    from vllm.models.qwen4_exp.common import qsa_cache
+
+    cache = qsa_cache.QSAKeyStateCache(
+        head_size=128,
+        dtype=torch.bfloat16,
+        cache_rope_positions=True,
+        cache_config=SimpleNamespace(block_size=32),
+        prefix="ringtag.order",
+        vllm_config=SimpleNamespace(
+            compilation_config=SimpleNamespace(static_forward_context={})
+        ),
+        compress_ratio=4,
+    )
+    unified = torch.full((3, 1, 8, 144), 0.25, dtype=torch.bfloat16)
+    cache.bind_kv_cache(unified)
+    residue = int(cache.ring_tag_cache[1, 0, 0, 0])
+    assert residue != 0
+    # step N: scheduler claimed block 1; the runner clears before the forward
+    clear_ring_row_tags(ring_tag_layers({"l": cache}), [1], torch.device("cpu"))
+    # step N forward: the new owner commits positions 100, 101
+    for position in (100, 101):
+        cache.ring_tag_cache[1, position % 8, 0, 0] = position + 1
+    tags = cache.ring_tag_cache[1, :, 0, 0].tolist()
+    assert tags[100 % 8] == 101 and tags[101 % 8] == 102
+    assert [t for i, t in enumerate(tags) if i not in (100 % 8, 101 % 8)] == [0] * 6
+    # other blocks untouched
+    assert int(cache.ring_tag_cache[0, 0, 0, 0]) == residue
