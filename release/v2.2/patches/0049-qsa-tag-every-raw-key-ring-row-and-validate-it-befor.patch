--- /dev/null
+++ b/tests/v1/core/test_qsa_ring_resume_alignment.py
@@ -0,0 +1,266 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Ring-row tag fix: can a prefix-cache hit make a request's
+FIRST QSA group read raw-key ring rows this request never wrote?
+
+The ring (CircularBufferSpec) is not prefix-cacheable: a request that resumes
+from a cache hit at position k starts with an empty ring. The pre-indexer's
+first group reads ring rows iff k is not a multiple of the compression ratio R
+(rows [k - k % R, k)). The ring-row tag fix makes such a read rank-fatal, so a legitimate
+unaligned resume would be a false positive. This file pins, on the local
+(no KV connector) path the model runs in production, that k % R == 0 always:
+
+  1. the ring never takes part in hit lookup (prefix_cacheable False, skipped
+     by the coordinator, its finder returns 0) -- kv_cache_coordinator.py
+     attention_groups loop, single_type_kv_cache_manager.py
+     CircularBufferManager.find_longest_cache_hit;
+  2. every hit length is a multiple of the coordinator's cache-hit alignment
+     (scheduler block, or the hash block under Mamba "align" partial hits),
+     including the full-prompt "recompute the last token" cap and the EAGLE
+     block drop -- kv_cache_manager.py get_computed_blocks;
+  3. boot refuses any alignment that is not a multiple of every
+     prefix-cacheable tokens_per_state, i.e. of R -- kv_cache_utils.py
+     resolve_kv_cache_block_sizes;
+  4. preemption restarts from 0 -- scheduler.py _preempt_request.
+
+The one path that CAN resume unaligned is an external KV connector
+(num_external_computed_tokens is arbitrary; a full-prompt async load resets
+to num_tokens - 1, scheduler.py _update_waiting_for_remote_kv). There the ring
+history must come from the connector: a connector that transfers the ring
+brings the producer's committed rows and tags (and the tag fix no longer clears the
+tags of a block an async load is filling); one that does not has no history
+to give, and failing closed is the correct outcome -- the recurrent GDN state
+at k cannot be rewound to an aligned k' < k. Production runs no connector.
+"""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.v1.core import kv_cache_utils as ku
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+from vllm.v1.core.kv_cache_utils import get_request_block_hasher, init_none_hash
+from vllm.v1.kv_cache_interface import (
+    CircularBufferSpec,
+    FullAttentionSpec,
+    KVCacheConfig,
+    KVCacheGroupSpec,
+    MambaSpec,
+    MLAAttentionSpec,
+)
+from vllm.v1.request import Request
+
+pytestmark = pytest.mark.cpu_test
+
+R = 4  # QSA compress ratio == MLAAttentionSpec.tokens_per_state
+BLOCK = 16  # stands in for the production 3200 (both multiples of R)
+REPO = Path(__file__).resolve().parents[3]
+
+
+def first_group_ring_rows(chunk_start: int, ratio: int = R) -> list[int]:
+    """Ring rows the pre-indexer's first group reads for a chunk starting at
+    chunk_start -- the kernel's arithmetic (qsa_pre_indexer.py: first_boundary,
+    first_position, source_in_chunk)."""
+    first_boundary = ((chunk_start + ratio) // ratio) * ratio - 1
+    first_position = first_boundary - (ratio - 1)
+    return [p for p in range(first_position, first_position + ratio) if p < chunk_start]
+
+
+def test_the_checker_can_fail():
+    """Negative control for everything below: an unaligned resume (the
+    connector full-prompt reset to num_tokens - 1) DOES read ring rows."""
+    assert first_group_ring_rows(52934) == [52932, 52933]
+    assert first_group_ring_rows(53 - 1) == []  # 52 is aligned
+    assert first_group_ring_rows(54 - 1) == [52]
+    for k in range(0, 64, R):
+        assert first_group_ring_rows(k) == []
+
+
+def _config() -> KVCacheConfig:
+    return KVCacheConfig(
+        num_blocks=256,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["attn"],
+                FullAttentionSpec(
+                    block_size=BLOCK, num_kv_heads=1, head_size=1, dtype=torch.float32
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["comp"],
+                MLAAttentionSpec(
+                    block_size=BLOCK,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float32,
+                    tokens_per_state=R,
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["ring"],
+                CircularBufferSpec(
+                    block_size=8, num_kv_heads=1, head_size=1, dtype=torch.float32
+                ),
+            ),
+        ],
+    )
+
+
+def _request(rid: str, tokens: list[int], hash_block: int) -> Request:
+    params = SamplingParams(max_tokens=4)
+    params.update_from_generation_config({}, eos_token_id=100)
+    return Request(
+        request_id=rid,
+        prompt_token_ids=tokens,
+        mm_features=None,
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(hash_block, sha256),
+    )
+
+
+def _mamba_align_group() -> KVCacheGroupSpec:
+    return KVCacheGroupSpec(
+        ["gdn"],
+        MambaSpec(
+            shapes=((4,),),
+            dtypes=(torch.float32,),
+            block_size=BLOCK,
+            mamba_cache_mode="align",
+        ),
+    )
+
+
+def _sweep_hits(*, use_eagle: bool, hash_block: int, mamba_align: bool) -> set[int]:
+    """Every hit length the real KVCacheManager returns for prompts of every
+    length in a range, for both a full-prompt repeat (capped to
+    num_tokens - 1) and a prompt continuation."""
+    init_none_hash(sha256)
+    config = _config()
+    if mamba_align:
+        config.kv_cache_groups.append(_mamba_align_group())
+    assert not config.kv_cache_groups[2].kv_cache_spec.prefix_cacheable
+    hits = set()
+    for length in range(BLOCK + 1, 5 * BLOCK + 3):
+        mgr = KVCacheManager(
+            config,
+            max_model_len=4096,
+            scheduler_block_size=BLOCK,
+            hash_block_size=hash_block,
+            enable_caching=True,
+            use_eagle=use_eagle,
+        )
+        prompt = list(range(1000, 1000 + length))
+        first = _request("a", prompt, hash_block)
+        blocks, hit, _ = mgr.get_computed_blocks(first)
+        assert hit == 0
+        assert mgr.allocate_slots(first, length, hit, blocks) is not None
+        mgr.free(first)
+        for rid, tokens in (("b", prompt), ("c", prompt + [7, 8, 9])):
+            req = _request(rid, tokens, hash_block)
+            blocks, hit, _ = mgr.get_computed_blocks(req)
+            hits.add(hit)
+            # the ring contributes no cached block: its history starts empty
+            assert len(blocks.blocks[2]) == 0
+    return hits
+
+
+@pytest.mark.parametrize(
+    "use_eagle,hash_block,mamba_align",
+    [
+        (False, BLOCK, False),
+        (True, BLOCK, False),
+        # Mamba "align" fine-grained (partial) hits: lengths 20, 24, 28, ...
+        # (EAGLE + Mamba needs the eagle-group annotation this stand-in does
+        # not model -- it returns no hit at all, so it is not swept here.)
+        (False, R, True),
+    ],
+    ids=["block", "block-eagle", "partial-hits"],
+)
+def test_every_local_prefix_hit_resumes_on_a_group_boundary(
+    use_eagle, hash_block, mamba_align
+):
+    hits = _sweep_hits(
+        use_eagle=use_eagle, hash_block=hash_block, mamba_align=mamba_align
+    )
+    for hit in hits:
+        assert hit % R == 0 and first_group_ring_rows(hit) == [], hit
+    # the sweep really produced non-trivial hits (else it proves nothing)
+    assert max(hits) >= 3 * BLOCK
+    if mamba_align:  # ...and really partial ones
+        assert any(hit % BLOCK for hit in hits)
+
+
+def test_failing_control_a_finer_hash_block_would_open_the_path():
+    """What the boot check below closes: with partial hits on a hash block of
+    2 (not a multiple of R) the SAME sweep returns hits that make the first
+    group read ring rows this request never wrote."""
+    hits = _sweep_hits(use_eagle=False, hash_block=2, mamba_align=True)
+    assert any(first_group_ring_rows(hit) for hit in hits), sorted(hits)
+
+
+def _boot_config(prefix_match_unit):
+    return SimpleNamespace(
+        cache_config=SimpleNamespace(
+            block_size=BLOCK,
+            enable_prefix_caching=True,
+            prefix_match_unit=prefix_match_unit,
+        ),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=None,
+    )
+
+
+def _boot_groups():
+    return KVCacheConfig(
+        num_blocks=64,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            *_config().kv_cache_groups,
+            KVCacheGroupSpec(
+                ["gdn"],
+                MambaSpec(
+                    shapes=((4,),),
+                    dtypes=(torch.float32,),
+                    block_size=BLOCK,
+                    mamba_cache_mode="align",
+                ),
+            ),
+        ],
+    )
+
+
+def test_boot_refuses_a_hit_alignment_finer_than_the_qsa_group():
+    """With Mamba "align" partial hits the alignment drops to the hash block;
+    a hash block that is not a multiple of R would allow an unaligned resume,
+    and boot refuses it."""
+    with pytest.raises(ValueError, match="per-state compression"):
+        ku.resolve_kv_cache_block_sizes(_boot_groups(), _boot_config(2))
+    # control: an R-multiple hash block is accepted and stays R-aligned
+    sched, hash_bs = ku.resolve_kv_cache_block_sizes(_boot_groups(), _boot_config(4))
+    assert sched == BLOCK and hash_bs % R == 0
+
+
+def _function(path: Path, name: str) -> ast.FunctionDef:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return node
+    raise AssertionError(f"{name} not found in {path}")
+
+
+def test_preemption_restarts_from_zero():
+    fn = _function(REPO / "vllm/v1/core/sched/scheduler.py", "_preempt_request")
+    assigns = [
+        ast.unparse(n)
+        for n in ast.walk(fn)
+        if isinstance(n, ast.Assign)
+        and any("num_computed_tokens" in ast.unparse(t) for t in n.targets)
+    ]
+    assert "request.num_computed_tokens = 0" in assigns
