@@ -0,0 +1,367 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""v2.2 ring-row tag fix, manager half: the unconditional, ordered ring tag clear.
+
+`_record_new_block_ids` keeps `CircularBufferSpec` out of whole-block zeroing
+(single_type_kv_cache_manager.py:117-121), so a re-claimed ring block keeps
+its previous occupant's bytes. The tag fix does not change that; it records EVERY
+ring claim on a separate list, unconditionally (never under
+`needs_kv_cache_zeroing`), ships it as `SchedulerOutput.new_ring_block_ids_to_clear`
+and the runner clears the rows' TAG words right after the zeroer and before
+copies and the forward -- i.e. before the new owner's first ring access.
+
+FAILING CONTROL: on the unmodified tree (without this fix) every
+test here fails -- `take_new_ring_block_ids`, the SchedulerOutput field and
+`vllm.v1.worker.ring_tags` do not exist, and nothing calls a ring clear.
+"""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.core.block_pool import BlockPool
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.core.single_type_kv_cache_manager import (
+    CircularBufferManager,
+    FullAttentionManager,
+)
+from vllm.v1.kv_cache_interface import CircularBufferSpec, FullAttentionSpec
+from vllm.v1.worker.ring_tags import clear_ring_row_tags, ring_tag_layers
+
+pytestmark = pytest.mark.cpu_test
+
+REPO = Path(__file__).resolve().parents[3]
+
+
+def _ring_manager(pool: BlockPool, *, zeroing: bool) -> CircularBufferManager:
+    spec = CircularBufferSpec(
+        block_size=8, num_kv_heads=1, head_size=144, dtype=torch.bfloat16
+    )
+    return CircularBufferManager(
+        spec,
+        block_pool=pool,
+        enable_caching=False,
+        kv_cache_group_id=0,
+        scheduler_block_size=8,
+        needs_kv_cache_zeroing=zeroing,
+        max_admission_blocks_per_request=1,
+    )
+
+
+@pytest.mark.parametrize("zeroing", [False, True], ids=["no-zeroing", "zeroing"])
+def test_every_ring_claim_is_recorded_whatever_the_zeroing_gate(zeroing):
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=zeroing)
+    (a,) = mgr.allocate_new_blocks("a", num_tokens=100, num_tokens_main_model=100)
+    (b,) = mgr.allocate_new_blocks("b", num_tokens=3, num_tokens_main_model=3)
+    # later steps of the same request claim nothing new
+    assert mgr.allocate_new_blocks("a", 200, 200) == []
+    assert mgr.take_new_ring_block_ids() == [a.block_id, b.block_id]
+    # drained: a second take is empty
+    assert mgr.take_new_ring_block_ids() == []
+    # the ring stays OUT of whole-block zeroing (unchanged behaviour)
+    assert not mgr.records_new_block_ids
+    assert mgr.take_new_block_ids() == []
+
+
+def test_external_claim_is_recorded_too():
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=False)
+    mgr.allocate_external_computed_blocks("x", 16, 16)
+    (block,) = mgr.req_to_blocks["x"]
+    assert mgr.take_new_ring_block_ids() == [block.block_id]
+
+
+def test_a_block_freed_before_the_drain_is_not_cleared():
+    """Claimed then freed in the same scheduling pass (the request was
+    preempted after its allocation): the block may belong to another group
+    by the time the worker runs, so the clear must not touch it."""
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=False)
+    (a,) = mgr.allocate_new_blocks("a", 8, 8)
+    (b,) = mgr.allocate_new_blocks("b", 8, 8)
+    mgr.free("a")
+    assert mgr.take_new_ring_block_ids() == [b.block_id]
+
+
+def test_a_block_freed_and_reclaimed_in_one_pass_is_cleared_once():
+    pool = BlockPool(num_gpu_blocks=2, enable_caching=False, hash_block_size=8)
