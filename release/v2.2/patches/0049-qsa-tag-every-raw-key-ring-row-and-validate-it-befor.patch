+def test_async_kv_load_marks_the_request_ring_blocks_for_skipping():
+    """The async-load branch of schedule() records the request's ring blocks
+    in _skip_ring_clear_block_ids OUTSIDE the needs_kv_cache_zeroing guard
+    (an out-of-band write of the producer's ring must not be followed by a
+    tag clear that wipes its committed tags)."""
+    fn = _function(REPO / "vllm/v1/core/sched/scheduler.py", "schedule")
+    hits = []
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Call) and "_skip_ring_clear_block_ids.update" in (
+            ast.unparse(node.func)
+        ):
+            hits.append(ast.unparse(node))
+    assert hits and all("get_ring_block_ids" in h for h in hits)
+    for node in ast.walk(fn):
+        if isinstance(node, ast.If) and "needs_kv_cache_zeroing" in ast.unparse(
+            node.test
+        ):
+            assert "_skip_ring_clear_block_ids" not in ast.unparse(node)
+
