+def _reference_rope_rows(
+    cos_sin_cache: torch.Tensor,
+    x: torch.Tensor,
+    pos_t: int,
+    pos_h: int,
+    pos_w: int,
+    mrope: bool,
+) -> torch.Tensor:
+    """NeoX rotary on the first half of D, torch only (independent of both the
+    fused _norm_rope and apply_qsa_rope). MRoPE picks the axis per rotary pair
+    the way Qwen interleaves them: h on pairs 1,4,7.. up to 3*MROPE_H, w on
+    pairs 2,5,8.. up to 3*MROPE_W, t elsewhere."""
+    half, quarter = D // 2, D // 4
+    table = cos_sin_cache.float()
+    pairs = torch.arange(quarter, device=x.device)
+    if mrope:
+        h_mask = ((pairs % 3) == 1) & (pairs <= 3 * MROPE_SECTION[1])
+        w_mask = ((pairs % 3) == 2) & (pairs <= 3 * MROPE_SECTION[2])
+        axis_pos = torch.where(
+            h_mask,
+            torch.full_like(pairs, pos_h),
+            torch.where(w_mask, torch.full_like(pairs, pos_w), pos_t),
+        )
+    else:
+        axis_pos = torch.full_like(pairs, pos_t)
+    cos = table[axis_pos, pairs]
+    sin = table[axis_pos, quarter + pairs]
+    r0, r1 = x[:quarter], x[quarter:half]
+    return torch.cat((r0 * cos - r1 * sin, r1 * cos + r0 * sin, x[half:]))
+
+
+def _reference_compressed_rows(
+    cos_sin_cache,
+    k_weight,
+    keys,
+    positions,
+    logical_positions,
+    query_start_loc,
+    compressed_slots,
+    history,
+    raw_block_table,
+    state_size,
+    *,
+    mrope,
+    cache_rope_positions,
+    is_2d_positions,
+) -> dict[int, torch.Tensor]:
+    """{compressed slot: expected row} for every completed group, recomputed
+    from the inputs: mean of the group's four raw keys (historical ones from
+    the pre-launch ring, rounded to bf16 like the model), Gemma RMSNorm, then
+    RoPE at the group's first token."""
+    out: dict[int, torch.Tensor] = {}
+    starts = query_start_loc.tolist()
+    for request in range(len(starts) - 1):
+        q0, q1 = starts[request], starts[request + 1]
+        chunk_start = int(logical_positions[q0])
+        block = int(raw_block_table[request, 0])
+        for token in range(q0, q1):
+            slot = int(compressed_slots[token])
+            if slot < 0:
+                continue
+            end = int(logical_positions[token])
+            rows, first = [], None
+            for position in range(end - CR + 1, end + 1):
+                if position >= chunk_start:
+                    t = q0 + position - chunk_start
+                    rows.append(keys[t].float())
+                    pos3 = (
+                        [int(positions[a, t]) for a in range(3)]
+                        if is_2d_positions
+                        else [int(positions[t])] * 3
+                    )
+                else:
+                    ring_row = history[block, position % state_size, 0]
+                    rows.append(ring_row[:D].float())
+                    tail = ring_row[ROPE_POS_OFFSET:].view(torch.int64)
+                    pos3 = [int(v) for v in tail[:3]]
+                if not cache_rope_positions:
+                    # without cached coordinates the kernel rotates the group
+                    # by its first LOGICAL position on every axis
+                    pos3 = [position] * 3
+                if first is None:
+                    first = pos3
+            pooled = (torch.stack(rows).sum(0) / CR).to(torch.bfloat16).float()
+            normed = pooled * torch.rsqrt(pooled.pow(2).mean() + EPS)
+            normed = (normed * (k_weight.float() + 1.0)).to(torch.bfloat16).float()
+            out[slot] = _reference_rope_rows(cos_sin_cache, normed, *first, mrope=mrope)
+    return out
