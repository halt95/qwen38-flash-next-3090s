+def _function(path: Path, name: str) -> ast.FunctionDef:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return node
+    raise AssertionError(f"{name} not found in {path}")
+
+
+def test_scheduler_drains_ring_claims_unconditionally():
+    path = REPO / "vllm/v1/core/sched/scheduler.py"
+    fn = _function(path, "schedule")
+    found = False
+    for node in ast.walk(fn):
+        if isinstance(node, ast.keyword) and node.arg == "new_ring_block_ids_to_clear":
+            src = ast.unparse(node.value)
+            assert "_get_new_ring_block_ids_to_clear" in src
+            assert "needs_kv_cache_zeroing" not in src
+            found = True
+    assert found, "SchedulerOutput is built without new_ring_block_ids_to_clear"
+    body = _function(path, "_get_new_ring_block_ids_to_clear").body
+    if isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):
+        body = body[1:]  # the docstring may name the gate it is not under
+    drain = "\n".join(ast.unparse(stmt) for stmt in body)
+    assert "take_new_ring_block_ids" in drain
+    assert "needs_kv_cache_zeroing" not in drain
+
+
+def _drain_scheduler(ring_ids, skip):
+    from vllm.v1.core.sched.scheduler import Scheduler
+
+    sched = Scheduler.__new__(Scheduler)
+    sched.kv_cache_manager = SimpleNamespace(
+        take_new_ring_block_ids=lambda: list(ring_ids)
+    )
+    sched._skip_ring_clear_block_ids = set(skip)
+    return sched
+
+
+def test_drain_ships_every_claim_and_skips_only_async_load_targets():
+    sched = _drain_scheduler([3, 5, 9], skip={5})
+    assert sched._get_new_ring_block_ids_to_clear() == [3, 9]
+    # the skip set is one-shot, like _skip_zero_block_ids
+    assert sched._skip_ring_clear_block_ids == set()
+    assert _drain_scheduler([], skip=set())._get_new_ring_block_ids_to_clear() is None
+
