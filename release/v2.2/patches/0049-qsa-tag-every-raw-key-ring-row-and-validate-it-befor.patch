+class _TagLayer:
+    def __init__(self, num_blocks: int, prefix: str = "layer"):
+        self.prefix = prefix
+        self.ring_tag_cache = torch.arange(
+            1, num_blocks * 8 + 1, dtype=torch.int64
+        ).view(num_blocks, 8, 1, 1)
+        self.cleared: list[list[int]] = []
+
+    def clear_ring_row_tags(self, block_ids: torch.Tensor) -> None:
+        self.cleared.append(block_ids.tolist())
+        self.ring_tag_cache.index_fill_(0, block_ids, 0)
+
