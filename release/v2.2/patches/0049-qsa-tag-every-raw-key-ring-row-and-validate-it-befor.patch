+# SPDX-License-Identifier: Apache-2.0
+"""Ring-row tag fix reference-host harness: the ring-residue variants, before and after the fix.
+
+Derived from an earlier crash-replay harness.
+The decode row under test (52,934 computed,
+4 scheduled -> chunk start 2 mod 4, so its first group reads two ring rows),
+real metadata from build_qsa_metadata_triton, one process per variant (an
+illegal address is sticky and would void every later variant).
+
+It runs unchanged on BOTH trees and says which one it is on:
+  * fixed   (tag fix): rows are D+16 wide with a tag word; SITE_QSA_RING_UNCOMMITTED
+                   exists; layer_id is passed.
+  * unfixed (pre-fix kernels, an earlier commit): rows D+12, no tag.
+
+--disable-guard9 swaps _norm_rope for a clone WITHOUT the guard-9 clamp
+before the first launch (Triton resolves the callee from the kernel module's
+globals at compile time). The `guard9_probe` variant proves the swap took:
+it feeds a valid-tag row whose position is one past the cos/sin table, which
+guard 9 counts (> 0) and the clone does not (== 0).
+
+Expected outcomes (ACCEPT column of the summary):
+  variant                unfixed, guard 9 off   unfixed, guard 9 on   fixed
+  ring_realistic         clean                  clean                 clean, site 0
+  ring_uncommitted_row   FAULT (memcheck/IMA)   guard9 > 0 (masked)   request_error
+  ring_untouched_residue FAULT or silent*       guard9 >= 0*          request_error
+  ring_every_row_2/_3    silent (blind)         silent (blind)        request_error
+  guard9_probe           guard9 == 0            guard9 > 0            guard9 > 0, site 0
+* untouched residue is whatever the allocator left; the crash replay measured it
+  reaching the rope load (11 memcheck reads), but a run where it decodes in
+  range is the silent-corruption outcome, not a clean one.
+"request_error" = no fault, SITE_QSA_RING_UNCOMMITTED count > 0, its record
+names request row 0 and a historical source position, guard 9 count 0, and
+the group's compressed slot left unwritten.
+
+  python ring_tag_replay.py --self-test            # CPU, geometry only
+  python ring_tag_replay.py [--disable-guard9]     # all variants, isolated
+  compute-sanitizer --tool memcheck python ring_tag_replay.py --only X
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+
+D = 128
+HQ = 4
+CR = 4
+STATE = 8
+COMP_PAGE = 800
+NUM_BLOCKS = 317
+TABLE_WIDTH = 82
+MAX_MODEL_LEN = 262144
+MROPE = (11, 11, 10)
+LAYER = 3
+VICTIM_RING, FRESH_RING = 5, 60
+
+# (computed, scheduled) of the request under test
+SHAPES = {
+    "ring_realistic": (52934, 4),
+    "ring_uncommitted_row": (52934, 4),
+    "ring_untouched_residue": (52934, 4),
+    "ring_every_row_2": (52935, 4),
+    "ring_every_row_3": (52935, 4),
+    "guard9_probe": (52934, 4),
+}
+VARIANTS = list(SHAPES)
+
+
+def historical_positions(computed: int) -> list[int]:
+    """Ring rows the first group of a chunk starting at `computed` reads."""
+    first = computed - computed % CR
+    return list(range(first, computed))
+
+
+def self_test() -> int:
+    ok = True
+
+    def check(name, cond):
+        nonlocal ok
+        ok = ok and bool(cond)
+        print(f"  {'PASS' if cond else 'FAIL'}  {name}")
+
+    check("the decode row reads two ring rows", historical_positions(52934) == [52932, 52933])
+    check(
+        "every-row shape reads three",
+        historical_positions(52935) == [52932, 52933, 52934],
+    )
+    check("rows 4,5 for the decode row", [p % STATE for p in (52932, 52933)] == [4, 5])
+    # the crash replay's victim committed positions 100/101, i.e. rows 4/5 -- the
+    # very rows the reader picks. Here the victim sits at 96/97 (rows 0/1) so
+    # the reader's rows stay residue, which is the case being asked about.
+    check("victim rows 96,97 -> 0,1, disjoint from 4,5", [96 % 8, 97 % 8] == [0, 1])
+    check("the group ends inside the chunk", (52934 - 52934 % 4 + 3) < 52934 + 4)
+    print(f"self-test: {'PASS' if ok else 'FAIL'}")
+    return 0 if ok else 1
+
+
+def _unguarded_norm_rope():
+    """_norm_rope with the guard-9 block and clamp removed, same signature."""
+    from vllm.triton_utils import tl, triton
+
+    @triton.jit
+    def _norm_rope(
+        x,
+        pos_t,
+        pos_h,
+        pos_w,
+        cos_sin_ptr,
+        cos_sin_stride,
+        cos_sin_rows,
+        guard_ctr,
+        norm_weight_ptr,
+        eps,
+        IS_MROPE: tl.constexpr,
+        MROPE_H: tl.constexpr,
+        MROPE_W: tl.constexpr,
+    ):
+        TILE_T: tl.constexpr = x.shape[0]
+        TILE_H: tl.constexpr = x.shape[1]
+        DD: tl.constexpr = x.shape[2]
+        ROWS: tl.constexpr = TILE_T * TILE_H
+        HALF: tl.constexpr = DD // 2
+        QUARTER: tl.constexpr = DD // 4
+        pairs = tl.arange(0, QUARTER)
+        if IS_MROPE:
+            h_mask = ((pairs % 3) == 1) & (pairs <= 3 * MROPE_H)
+            w_mask = ((pairs % 3) == 2) & (pairs <= 3 * MROPE_W)
+            t_mask = ~(h_mask | w_mask)
+            base = cos_sin_ptr + pairs[None, :]
+            pos_rows = (pos_t, pos_h, pos_w)
+            axis_masks = (t_mask, h_mask, w_mask)
+            cos = tl.zeros((TILE_T, QUARTER), dtype=cos_sin_ptr.dtype.element_ty)
+            sin = tl.zeros((TILE_T, QUARTER), dtype=cos_sin_ptr.dtype.element_ty)
+            for axis in tl.static_range(3):
+                cos += tl.load(
+                    base + pos_rows[axis][:, None] * cos_sin_stride,
+                    mask=axis_masks[axis][None, :],
+                    other=0,
+                )
+                sin += tl.load(
+                    base + pos_rows[axis][:, None] * cos_sin_stride + QUARTER,
+                    mask=axis_masks[axis][None, :],
+                    other=0,
+                )
+        else:
+            cos = tl.load(
+                cos_sin_ptr + pos_t[:, None] * cos_sin_stride + pairs[None, :]
+            )
+            sin = tl.load(
+                cos_sin_ptr + pos_t[:, None] * cos_sin_stride + QUARTER + pairs[None, :]
+            )
+        cos = tl.reshape(
+            tl.broadcast_to(cos[:, None, :], (TILE_T, TILE_H, QUARTER)), (ROWS, QUARTER)
+        )
+        sin = tl.reshape(
+            tl.broadcast_to(sin[:, None, :], (TILE_T, TILE_H, QUARTER)), (ROWS, QUARTER)
+        )
+        x = tl.reshape(x, (ROWS, DD)).to(tl.float32)
+        weight = tl.load(norm_weight_ptr + tl.arange(0, DD)).to(tl.float32) + 1.0
+        rrms = tl.rsqrt(tl.sum(x * x, axis=1) / DD + eps)
+        y = (x * rrms[:, None] * weight[None, :]).to(cos.dtype)
+        rotated, passthrough = tl.split(
+            tl.permute(tl.reshape(y, (ROWS, 2, HALF)), (0, 2, 1))
+        )
+        r0, r1 = tl.split(
+            tl.permute(tl.reshape(rotated, (ROWS, 2, QUARTER)), (0, 2, 1))
+        )
+        out0 = r0 * cos - r1 * sin
+        out1 = r1 * cos + r0 * sin
+        rotated = tl.reshape(tl.permute(tl.join(out0, out1), (0, 2, 1)), (ROWS, HALF))
+        result = tl.reshape(
+            tl.permute(tl.join(rotated, passthrough), (0, 2, 1)), (ROWS, DD)
+        )
+        return tl.reshape(result, (TILE_T, TILE_H, DD))
+
+    return _norm_rope
+
+
+def run_variant(variant: str, disable_guard9: bool) -> dict:
+    import torch
+
+    from vllm.models.qwen4_exp.common import qsa_cache as qc
+    from vllm.models.qwen4_exp.nvidia.ops import qsa_pre_indexer as qpi
+    from vllm.v1.attention.backend import CommonAttentionMetadata
+    from vllm.v1.worker import guard_telemetry as gt
+
+    fixed = hasattr(gt, "SITE_QSA_RING_UNCOMMITTED")
+    width = D + (16 if fixed else 12)
+    rec: dict = {
+        "variant": variant,
+        "tree": "fixed" if fixed else "unfixed",
+        "guard9": "disabled" if disable_guard9 else "present",
+    }
+    if disable_guard9:
+        qpi._norm_rope = _unguarded_norm_rope()
+    device = torch.device("cuda:0")
+    torch.manual_seed(20260923)
+    gt.prealloc(device)
+    gt.reset_for_test()
+
+    computed, sched = SHAPES[variant]
+    seq = computed + sched
+    qsl = torch.tensor([0, sched], dtype=torch.int32)
+    ring_tab = torch.full((1, 1), VICTIM_RING, dtype=torch.int32, device=device)
+
+    def md_for(table):
+        return CommonAttentionMetadata(
+            query_start_loc=qsl.to(device),
+            query_start_loc_cpu=qsl,
+            seq_lens=torch.tensor([seq], dtype=torch.int32, device=device),
+            num_reqs=1,
+            num_actual_tokens=sched,
+            max_query_len=sched,
+            max_seq_len=seq,
+            block_table_tensor=table,
+            slot_mapping=torch.zeros(sched, dtype=torch.int64, device=device),
+        )
+
+    def bufs():
+        return [
+            torch.empty(sched, dtype=d, device=device)
+            for d in (torch.int32, torch.int64, torch.int32, torch.int64)
+        ]
+
+    _t, logical, _v, state_slots = qc.build_qsa_metadata_triton(
+        md_for(ring_tab),
+        *bufs(),
+        storage_block_size=STATE,
+        compress_ratio=1,
+        circular_buffer_size=STATE,
+        k_work_metadata_buffer=None,
+        request_capacity=None,
+    )
+    comp_tab = (
+        ((torch.arange(TABLE_WIDTH, device=device) % (NUM_BLOCKS - 1)) + 1)
+        .to(torch.int32)
+        .reshape(1, -1)
+    )
+    kwb = torch.empty(
+        max((sched + CR - 1) // CR, 1), 2, dtype=torch.int32, device=device
+    )
+    _t2, _l2, _v2, comp_slots = qc.build_qsa_metadata_triton(
+        md_for(comp_tab),
+        *bufs(),
+        storage_block_size=COMP_PAGE,
+        compress_ratio=CR,
+        circular_buffer_size=0,
+        k_work_metadata_buffer=kwb,
+        request_capacity=8,
+    )
+
+    shape = (NUM_BLOCKS, STATE, 1, width)
+    if variant == "ring_untouched_residue":
+        dirty = torch.empty(shape, dtype=torch.bfloat16, device=device)
+        dirty.normal_(mean=0.0, std=6.0e4)
+        del dirty
+        ring = torch.empty(shape, dtype=torch.bfloat16, device=device)
+    else:
+        ring = torch.zeros(shape, dtype=torch.bfloat16, device=device)
+    # 64 rows of slack past the table the kernel is told about, so the
+    # guard9_probe read one row past the end stays inside this allocation
+    cos_sin = torch.randn(
+        (MAX_MODEL_LEN + 64, D // 2), dtype=torch.bfloat16, device=device
+    )[:MAX_MODEL_LEN]
+    comp = torch.full(
+        (NUM_BLOCKS, COMP_PAGE, 1, D), 7.0, dtype=torch.bfloat16, device=device
+    )
+    ones = torch.ones(D, dtype=torch.bfloat16, device=device)
+
+    def write_row(position: int, pos_value: int | None, tag: int | None):
+        row = ring[VICTIM_RING, position % STATE, 0]
+        row[:D].normal_()
+        tail = row[D:].view(torch.int64)
+        tail[:3] = pos_value if pos_value is not None else position
+        if fixed:
+            tail[3] = position + 1 if tag is None else tag
+
+    hist = historical_positions(computed)
+    rec["historical_positions"] = hist
+    if variant == "ring_realistic":
+        for p in hist:  # this request committed them
+            write_row(p, 1234, None)
+    elif variant == "ring_uncommitted_row":
+        ring[VICTIM_RING].fill_(0.25)  # residue everywhere...
+        for p in (96, 97):  # ...but the previous occupant's
+            write_row(p, 1234, None)  # rows 0-1 (its own positions)
+    elif variant.startswith("ring_every_row"):
+        bad = hist[1] if variant.endswith("_2") else hist[2]
+        for p in hist:
+            write_row(p, 1234, None)
+        write_row(bad - STATE, 1234, None)  # same row, previous lap
+        rec["stale_position"] = bad
+    elif variant == "guard9_probe":
+        for p in hist:
+            write_row(p, MAX_MODEL_LEN, None)  # one past the table, valid tag
+
+    kw = dict(compress_ratio=CR, mrope_section=MROPE, rope_pos_offset=D)
+    if fixed:
+        kw["layer_id"] = LAYER
+    if variant == "ring_untouched_residue":
+        # the victim step commits rows 0-1 through the kernel itself
+        v_logical = torch.tensor([96, 97], dtype=torch.int64, device=device)
+        qpi.qsa_pre_indexer(
+            torch.randn((2, HQ * D), dtype=torch.bfloat16, device=device),
+            torch.randn((2, D), dtype=torch.bfloat16, device=device),
+            v_logical.unsqueeze(0).expand(3, -1).contiguous(),
+            cos_sin,
+            ones,
+            ones,
+            1e-6,
+            torch.empty((2, HQ, D), dtype=torch.bfloat16, device=device),
+            ring,
+            torch.tensor(
+                [VICTIM_RING * STATE, VICTIM_RING * STATE + 1],
+                dtype=torch.int64,
+                device=device,
+            ),
+            ring_tab,
+            torch.tensor([0, 2], dtype=torch.int32, device=device),
+            v_logical,
+            comp,
+            torch.full((2,), -1, dtype=torch.int64, device=device),
+            torch.zeros(1, 2, dtype=torch.int32, device=device),
+            **kw,
+        )
+        torch.cuda.synchronize()
+        gt.reset_for_test()
+
+    q = torch.randn((sched, HQ * D), dtype=torch.bfloat16, device=device)
+    k = torch.randn((sched, D), dtype=torch.bfloat16, device=device)
+    pos = logical.to(torch.int64).unsqueeze(0).expand(3, -1).contiguous()
+    q_out = torch.empty((sched, HQ, D), dtype=torch.bfloat16, device=device)
+    qpi.qsa_pre_indexer(
+        q,
+        k,
+        pos,
+        cos_sin,
+        ones,
+        ones,
+        1e-6,
+        q_out,
+        ring,
+        state_slots,
+        ring_tab,
+        md_for(ring_tab).query_start_loc,
+        logical,
+        comp,
+        comp_slots,
+        kwb,
+        **kw,
+    )
+    torch.cuda.synchronize()
+
+    g9 = gt.counter(gt.SITE_QSA_ROPE_POS, device).tolist()
+    rec["guard9_count"] = g9[0]
+    if fixed:
+        site = gt.counter(gt.SITE_QSA_RING_UNCOMMITTED, device).tolist()
+        rec["ring_site_count"] = site[0]
+        rec["ring_record"] = gt.decode_ring_record(site[1])
+        rec["ring_found_tag"] = gt.decode_slot(site[2])
+    first_boundary = computed - computed % CR + CR - 1
+    tok = first_boundary - computed
+    slot = int(comp_slots[tok])
+    rec["group_slot_written"] = bool(
+        (comp[slot // COMP_PAGE, slot % COMP_PAGE, 0] != 7.0).any()
+    )
+    rec["status"] = "ran"
+    return rec
+
+
+def verdict(rec: dict) -> str:
+    v, tree, g9off = rec["variant"], rec.get("tree"), rec.get("guard9") == "disabled"
+    if rec["status"] != "ran":
+        return "FAULT"
+    if tree == "fixed":
+        if v in ("ring_realistic",):
+            ok = (
+                rec["ring_site_count"] == 0
+                and rec["guard9_count"] == 0
+                and rec["group_slot_written"]
+            )
+            return "clean" if ok else "UNEXPECTED"
+        if v == "guard9_probe":
+            want = 0 if g9off else 1
+            ok = rec["ring_site_count"] == 0 and (
+                (rec["guard9_count"] > 0) == bool(want)
+            )
+            return (
+                f"guard9 {'off' if g9off else 'on'} confirmed" if ok else "UNEXPECTED"
+            )
+        r = rec.get("ring_record") or {}
+        ok = (
+            rec["ring_site_count"] > 0
+            and rec["guard9_count"] == 0
+            and not rec["group_slot_written"]
+            and r.get("request_row") == 0
+            and r.get("layer") == LAYER
+            and r.get("source_position") in rec["historical_positions"]
+        )
+        return "request_error" if ok else "UNEXPECTED"
+    # unfixed tree
+    if v == "guard9_probe":
+        ok = (rec["guard9_count"] == 0) if g9off else (rec["guard9_count"] > 0)
+        return f"guard9 {'off' if g9off else 'on'} confirmed" if ok else "UNEXPECTED"
+    if v.startswith("ring_every_row") or v == "ring_realistic":
+        return "silent" if rec["guard9_count"] == 0 else "UNEXPECTED"
+    return "masked by guard 9" if rec["guard9_count"] > 0 else "silent"
+
+
+def main(argv) -> int:
+    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    p.add_argument("--self-test", action="store_true")
+    p.add_argument("--only", default="")
+    p.add_argument("--disable-guard9", action="store_true")
+    p.add_argument(
+        "--in-process",
+        action="store_true",
+        help="run the named variant(s) here (child mode)",
+    )
+    args = p.parse_args(argv)
+    if args.self_test:
+        os.environ["CUDA_VISIBLE_DEVICES"] = ""
+        return self_test()
+    names = [n for n in args.only.split(",") if n] or VARIANTS
+    for n in names:
+        if n not in SHAPES:
+            print(f"unknown variant {n!r}; known: {', '.join(VARIANTS)}")
+            return 2
+    if args.in_process:
+        for n in names:
+            rec = run_variant(n, args.disable_guard9)
+            rec["accept"] = verdict(rec)
+            print(json.dumps(rec, sort_keys=True), flush=True)
+        return 0
+    rc = 0
+    for n in names:
+        child = [
+            sys.executable,
+            os.path.abspath(__file__),
+            "--in-process",
+            "--only",
+            n,
+        ] + (["--disable-guard9"] if args.disable_guard9 else [])
+        out = subprocess.run(child, capture_output=True, text=True)
+        lines = [ln for ln in out.stdout.splitlines() if ln.startswith("{")]
+        if out.returncode != 0 or not lines:
+            rec = {
+                "variant": n,
+                "status": "fault",
+                "accept": "FAULT",
+                "exit": out.returncode,
+                "stderr_tail": out.stderr.strip().splitlines()[-4:],
+            }
+            print(json.dumps(rec, sort_keys=True), flush=True)
+        else:
+            for ln in lines:
+                print(ln, flush=True)
+                if json.loads(ln).get("accept") == "UNEXPECTED":
+                    rc = 1
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
