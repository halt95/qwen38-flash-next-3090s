diff --git a/tests/v1/worker/gpu/test_qsa_ring_tags_gpu.py b/tests/v1/worker/gpu/test_qsa_ring_tags_gpu.py
new file mode 100644
index 0000000000..8987e52fac
--- /dev/null
+++ b/tests/v1/worker/gpu/test_qsa_ring_tags_gpu.py
@@ -0,0 +1,311 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""v2.2 ring-row tag fix, kernel half (GPU): the pre-indexer's ring-row tag contract.
+
+Writer: every committed ring row gets tag = logical_position + 1 in word 3 of
+its int64 tail. Reader: every HISTORICAL source row of a pooled group must
+carry exactly source_position + 1; otherwise the group's pooled load, its RoPE
+tail read and its compressed-slot store are masked and SITE_QSA_RING_UNCOMMITTED
+records one coherent first-offender record (layer, request row, source position
++ the tag found there).
+
+Each positive case is paired with its clean twin in the same test (same batch,
+history committed correctly) that must count 0 and write the slot -- a counter
+that reads the same in both worlds measures nothing.
+
+FAILING CONTROL: on the unmodified tree (an earlier commit) the module fails at
+collection (QSA_RING_TAIL_ELEMENTS / QSA_RING_TAG_WORD do not exist). Were the
+constants shimmed, the old launcher also has no ``layer_id`` (TypeError), no
+tag writer (the writer test reads tag 0) and no reader check (the every-row
+test counts nothing and writes the slot).
+"""
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.common.qsa_cache import (
+    QSA_RING_TAG_WORD,
+    QSA_RING_TAIL_ELEMENTS,
+)
+from vllm.v1.worker import guard_telemetry as gt
+
+pytestmark = pytest.mark.gpu
+
+CR = 4
+D = 128
+HQ = 4
+STATE = 8
+WIDTH = D + QSA_RING_TAIL_ELEMENTS
+NUM_BLOCKS = 8
+COMP_PAGE = 800
+MAX_POS = 4096
+LAYER = 7
+SENTINEL = 7.0
+MROPE = (11, 11, 10)
+
+
+def _device():
+    return torch.device("cuda", torch.cuda.current_device())
+
+
+def _pos3(position: int) -> list[int]:
+    # distinct, in-range MRoPE coordinates per position
+    return [position, position // 7 + 3, position // 13 + 11]
+
+
+class _Batch:
+    """Requests (ring block, chunk_start, query_len) as one decode/prefill batch."""
+
+    def __init__(self, requests, device):
+        self.device = device
+        self.requests = requests
+        logical, slots, comp, qsl, work = [], [], [], [0], []
+        comp_next = 0
+        self.group_slot: dict[tuple[int, int], int] = {}
+        for r, (block, start, qlen) in enumerate(requests):
+            for i in range(qlen):
+                p = start + i
+                logical.append(p)
+                slots.append(block * STATE + p % STATE if i >= qlen - STATE else -1)
+                if (p + 1) % CR == 0:
+                    comp.append(comp_next)
+                    self.group_slot[(r, p)] = comp_next
+                    comp_next += 1
+                else:
+                    comp.append(-1)
+            qsl.append(qsl[-1] + qlen)
+            groups = (start + qlen) // CR - start // CR
+            work += [[r, w] for w in range(max(groups, 1))]
+        T = len(logical)
+        self.T = T
+        self.logical = torch.tensor(logical, dtype=torch.int64, device=device)
+        self.positions = (
+            torch.tensor([_pos3(p) for p in logical], dtype=torch.int64)
+            .t()
+            .contiguous()
+            .to(device)
+        )
+        self.state_slots = torch.tensor(slots, dtype=torch.int64, device=device)
+        self.comp_slots = torch.tensor(comp, dtype=torch.int64, device=device)
+        self.qsl = torch.tensor(qsl, dtype=torch.int32, device=device)
+        self.state_table = torch.tensor(
+            [[b] for b, _s, _q in requests], dtype=torch.int32, device=device
+        )
+        self.work = torch.tensor(work, dtype=torch.int32, device=device)
+        g = torch.Generator(device="cpu").manual_seed(1234)
+        self.q = torch.randn(T, HQ * D, generator=g).to(device, torch.bfloat16)
+        self.k = torch.randn(T, D, generator=g).to(device, torch.bfloat16)
+        self.cos_sin = torch.randn(MAX_POS, D // 2, generator=g).to(
+            device, torch.bfloat16
+        )
+        self.ring = torch.zeros(
+            NUM_BLOCKS, STATE, 1, WIDTH, dtype=torch.bfloat16, device=device
+        )
+        self.comp = torch.full(
+            (NUM_BLOCKS, COMP_PAGE, 1, D), SENTINEL, dtype=torch.bfloat16, device=device
+        )
+        self.q_out = torch.empty(T, HQ, D, dtype=torch.bfloat16, device=device)
+
+    def commit(self, block: int, position: int, *, tag: int | None = None):
+        """What a correct earlier step of this request leaves in the ring."""
+        row = self.ring[block, position % STATE, 0]
+        g = torch.Generator(device="cpu").manual_seed(position)
+        row[:D] = torch.randn(D, generator=g).to(self.device, torch.bfloat16)
+        tail = row[D:].view(torch.int64)
+        tail[:3] = torch.tensor(_pos3(position), device=self.device)
+        tail[QSA_RING_TAG_WORD] = position + 1 if tag is None else tag
+
+    def tag(self, block: int, row: int) -> int:
+        return int(self.ring[block, row, 0, D:].view(torch.int64)[QSA_RING_TAG_WORD])
+
+    def run(self, *, rope=True):
+        from vllm.models.qwen4_exp.nvidia.ops.qsa_pre_indexer import qsa_pre_indexer
+
+        qsa_pre_indexer(
+            self.q,
+            self.k,
+            self.positions if rope else self.logical,
+            self.cos_sin,
+            torch.ones(D, dtype=torch.bfloat16, device=self.device),
+            torch.ones(D, dtype=torch.bfloat16, device=self.device),
+            1e-6,
+            self.q_out,
+            self.ring,
+            self.state_slots,
+            self.state_table,
+            self.qsl,
+            self.logical,
+            self.comp,
+            self.comp_slots,
+            self.work,
+            compress_ratio=CR,
+            mrope_section=MROPE if rope else None,
+            rope_pos_offset=D if rope else None,
+            layer_id=LAYER,
+        )
+        torch.cuda.synchronize()
+
+    def slot_written(self, request: int, end_position: int) -> bool:
+        slot = self.group_slot[(request, end_position)]
+        row = self.comp[slot // COMP_PAGE, slot % COMP_PAGE, 0]
+        return not bool(torch.all(row == SENTINEL))
+
+
+def _site():
+    return gt.counter(gt.SITE_QSA_RING_UNCOMMITTED, _device()).tolist()
+
+
+def _rope_site():
+    return gt.counter(gt.SITE_QSA_ROPE_POS, _device()).tolist()
+
+
+@pytest.fixture(autouse=True)
+def _fresh_counters():
+    gt.prealloc(_device())
+    gt.reset_for_test()
+    yield
+    gt.reset_for_test()
+
+
+# --------------------------------------------------------------------------
+# writer
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("rope", [True, False], ids=["mrope", "text"])
+@pytest.mark.parametrize("qlen", [3, 6, 13], ids=["no-group", "short", "long"])
+def test_writer_tags_every_committed_row(rope, qlen):
+    b = _Batch([(2, 40, qlen)], _device())
+    b.run(rope=rope)
+    committed = list(range(40 + max(qlen - STATE, 0), 40 + qlen))
+    for p in committed:
+        assert b.tag(2, p % STATE) == p + 1, f"row for position {p}"
+        if rope:
+            tail = b.ring[2, p % STATE, 0, D:].view(torch.int64)
+            assert tail[:3].tolist() == _pos3(p)
+    untouched = set(range(STATE)) - {p % STATE for p in committed}
+    for row in untouched:
+        assert b.tag(2, row) == 0
+    assert _site() == [0, 0, 0]
+
+
+# --------------------------------------------------------------------------
+# reader: the every-row control and its clean twin
+# --------------------------------------------------------------------------
+
+
+def _three_historical_rows(device):
+    # chunk start 1003 = 3 mod 4: the first group is 1000..1003 and 1000,
+    # 1001, 1002 all come from the ring
+    b = _Batch([(3, 1003, 4)], device)
+    for p in (1000, 1001, 1002):
+        b.commit(3, p)
+    return b
+
+
+def test_clean_twin_counts_zero_and_writes_the_slot():
+    b = _three_historical_rows(_device())
+    b.run()
+    assert _site() == [0, 0, 0]
+    assert b.slot_written(0, 1003)
+    assert _rope_site()[0] == 0
+
+
+@pytest.mark.parametrize("bad", [1001, 1002], ids=["row2", "row3"])
+def test_only_the_second_or_third_row_stale_is_flagged(bad):
+    """First row valid; ONE later row holds an in-range stale position and key
+    from the previous lap of the ring (it was committed for bad - 8). Guard 9
+    cannot see it (the position is in range) and neither could a first-row
+    check. The group must not be pooled and its slot must stay unwritten."""
+    b = _three_historical_rows(_device())
+    b.commit(3, bad - STATE)  # overwrites the row with the previous lap
+    assert b.tag(3, bad % STATE) == bad - STATE + 1
+    b.run()
+    n, rec, found = _site()
+    assert n == 1
+    assert gt.decode_ring_record(rec) == {
+        "layer": LAYER,
+        "request_row": 0,
+        "source_position": bad,
+    }
+    assert gt.decode_slot(found) == bad - STATE + 1
+    assert not b.slot_written(0, 1003)
+    assert _rope_site()[0] == 0  # guard 9 blind, as argued
+    # the Q path is independent of the ring and still ran
