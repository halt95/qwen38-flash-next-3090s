+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""v2.2 ring-row tag fix, CPU half: the raw-key ring row contract.
+
+The pre-indexer used to read a historical ring row's int64 position tail with
+nothing tying the row to the request or the position (the ring-residue
+illegal-address class). The ring-row tag fix grows the tail to four int64 words
+(pos_t, pos_h, pos_w, tag = logical_position + 1), validates the tag of EVERY
+historical row before pooling, and clears the tag words of a ring block when it
+is claimed. This file pins, without Triton or a GPU:
+
+  * the layout: spec width D+16 (was D+12 with MRoPE, D without), the V1
+    position view (3 int64, same bytes as before) and the tag view (word 3);
+  * the claim clear touches the tag words of the named blocks and nothing else;
+  * the torch reference of the reader's rule, including the every-row case
+    (only the 2nd or 3rd row of a group bad) that guard 9 cannot see;
+  * the new telemetry site: declared, named, fatal, coherent record packing;
+  * the production KV-pool impact of the wider row (0 blocks at 4.1e9).
+
+FAILING CONTROL: on the unmodified tree (without this fix) every
+test here fails -- the constants/helpers do not exist (ImportError at
+collection) and the spec width is 140, not 144.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.common import qsa_cache
+from vllm.models.qwen4_exp.common.qsa_cache import (
+    QSA_RING_TAG_WORD,
+    QSA_RING_TAIL_ELEMENTS,
+    QSA_RING_TAIL_WORDS,
+    qsa_ring_group_rows_valid,
+    qsa_ring_row_tags,
+)
+from vllm.v1.kv_cache_interface import CircularBufferSpec
+from vllm.v1.worker import guard_telemetry as gt
+
+D = 128
+CR = 4
+STATE = 8
+
+
+def _key_cache(*, rope: bool, head: int = D, block_size: int = 3200):
+    return qsa_cache.QSAKeyStateCache(
+        head_size=head,
+        dtype=torch.bfloat16,
+        cache_rope_positions=rope,
+        cache_config=SimpleNamespace(block_size=block_size),
+        prefix=f"ringtag.raw.{rope}.{head}.{block_size}",
+        vllm_config=SimpleNamespace(
+            compilation_config=SimpleNamespace(static_forward_context={})
+        ),
+        compress_ratio=CR,
+    )
+
+
+# --------------------------------------------------------------------------
+# layout: spec width, strides, views
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("rope", [True, False], ids=["mrope", "text"])
+def test_spec_width_is_key_plus_four_int64_words(rope):
+    cache = _key_cache(rope=rope)
+    assert QSA_RING_TAIL_WORDS == 4 and QSA_RING_TAIL_ELEMENTS == 16
+    assert cache.head_size == D + 16
+    # production: MTP K=3 -> ring capacity 8, row 144 bf16 = 288 bytes
+    spec = cache.get_kv_cache_spec(SimpleNamespace(num_speculative_tokens=3))
+    assert isinstance(spec, CircularBufferSpec)
+    assert spec.head_size == 144 and spec.block_size == STATE
+    assert spec.page_size_bytes == STATE * 144 * 2 == 2304
+
+
+def test_tail_starts_on_an_int64_boundary_for_odd_key_widths():
+    # a key width that is not a multiple of 4 bf16 is padded before the tail
+    cache = _key_cache(rope=True, head=126, block_size=32)
+    assert cache.rope_position_offset == 128
+    assert cache.head_size == 128 + 16
+
+
+def _bound(rope: bool, num_blocks: int = 3):
+    cache = _key_cache(rope=rope, block_size=32)
+    # the unified [blocks, 1, states, width] view, with a padded block stride
+    # like the real packed pool (block stride > states * width)
+    width = cache.head_size
+    storage = torch.zeros(num_blocks, STATE * width + 32, dtype=torch.bfloat16)
+    unified = torch.as_strided(
+        storage, (num_blocks, 1, STATE, width), (STATE * width + 32, 0, width, 1)
+    )
+    cache.bind_kv_cache(unified)
+    return cache
+
+
+def test_views_alias_the_right_bytes():
+    cache = _bound(rope=True)
+    assert cache.key_cache.shape == (3, STATE, 1, D)
+    assert cache.rope_position_cache.shape == (3, STATE, 1, 3)
+    assert cache.rope_position_cache.dtype == torch.int64
+    assert cache.ring_tag_cache.shape == (3, STATE, 1, 1)
+    # same storage, word 3 of the tail
+    cache.rope_position_cache[1, 5, 0] = torch.tensor([11, 22, 33])
+    cache.ring_tag_cache[1, 5, 0, 0] = 44
+    tail_bytes = cache.kv_cache[1, 5, 0, D:].contiguous().view(torch.int64)
+    assert tail_bytes.tolist() == [11, 22, 33, 44]
+    # the position view is the pre-tag view (first 3 words): V1 stores into
+    # it unchanged and never reaches the tag
+    assert cache.rope_position_cache.stride(-1) == 1
+
+
+def test_text_ring_has_a_tag_but_no_position_view():
+    cache = _bound(rope=False)
+    assert cache.rope_position_cache is None
+    assert cache.ring_tag_cache is not None
+    cache.ring_tag_cache[2, 7, 0, 0] = 9
+    assert cache.kv_cache[2, 7, 0, D:].contiguous().view(torch.int64)[3] == 9
+
+
+def test_bind_rejects_the_pre_tag_width():
+    cache = _key_cache(rope=True, block_size=32)
+    old = torch.zeros(2, 1, STATE, D + 12, dtype=torch.bfloat16)
+    with pytest.raises(ValueError, match="width"):
+        cache.bind_kv_cache(old)
+
+
+# --------------------------------------------------------------------------
+# the claim clear
+# --------------------------------------------------------------------------
+
+
+def test_claim_clear_zeroes_only_the_tag_words_of_the_named_blocks():
+    cache = _bound(rope=True, num_blocks=4)
+    # every byte non-zero, then remember it
+    cache.kv_cache.view(torch.int16).fill_(0x1234)
+    storage_before = cache.kv_cache.clone()
+    cache.clear_ring_row_tags(torch.tensor([1, 3]))
+    after = cache.kv_cache
+    tags = cache.ring_tag_cache[..., 0]
+    assert torch.all(tags[[1, 3]] == 0)
+    assert torch.all(tags[[0, 2]] != 0)
+    # nothing but the tag words changed
+    changed = after.view(torch.int16) != storage_before.view(torch.int16)
+    changed_cols = changed.nonzero()[:, -1].unique().tolist()
+    tag_cols = list(range(D + 4 * QSA_RING_TAG_WORD, D + 4 * QSA_RING_TAG_WORD + 4))
+    assert changed_cols == tag_cols
+    assert changed.nonzero()[:, 0].unique().tolist() == [1, 3]
+
+
+def test_claim_clear_before_bind_is_loud():
+    cache = _key_cache(rope=True, block_size=32)
+    with pytest.raises(RuntimeError, match="before the KV cache was bound"):
+        cache.clear_ring_row_tags(torch.tensor([0]))
+
+
+# --------------------------------------------------------------------------
+# the reader's rule (torch reference of the kernel check)
+# --------------------------------------------------------------------------
+
+
+def _group(chunk_start: int):
+    """The first group of a chunk starting at chunk_start (the only one that
+    can cross): its four source positions and which of them are historical."""
+    first_boundary = ((chunk_start + CR) // CR) * CR - 1
+    positions = torch.arange(first_boundary - CR + 1, first_boundary + 1)
+    return positions, positions < chunk_start
+
+
+def _committed_ring(positions):
+    """found tags for rows this request committed at exactly these positions"""
+    return qsa_ring_row_tags(positions)
+
+
+def test_tags_are_logical_position_plus_one_and_never_zero():
+    tags = qsa_ring_row_tags(torch.tensor([0, 1, 52933]))
+    assert tags.dtype == torch.int64
+    assert tags.tolist() == [1, 2, 52934]
+
+
+@pytest.mark.parametrize("chunk_start", [52933, 52934, 52935, 52936])
+def test_committed_history_validates(chunk_start):
+    positions, historical = _group(chunk_start)
+    ok = qsa_ring_group_rows_valid(
+        _committed_ring(positions)[None], positions[None], historical[None]
+    )
+    assert ok.tolist() == [True]
+
+
+@pytest.mark.parametrize("bad_row", [1, 2], ids=["row2", "row3"])
+def test_every_row_is_checked_not_only_the_first(bad_row):
+    """First row valid, only the 2nd or 3rd row of the group stale -- an
+    in-range position and key from the previous lap of the ring (the row
+    holds position p-8). Guard 9 is blind to this (the position is in
+    range); a first-row-only check is blind to it too."""
+    chunk_start = 52935  # 3 historical rows: 52932, 52933, 52934
+    positions, historical = _group(chunk_start)
+    assert historical.tolist() == [True, True, True, False]
+    found = _committed_ring(positions).clone()
+    found[bad_row] = positions[bad_row] - STATE + 1  # previous lap's tag
+    ok = qsa_ring_group_rows_valid(found[None], positions[None], historical[None])
+    assert ok.tolist() == [False]
+    # ...and the first row alone would have passed
+    first_only = qsa_ring_group_rows_valid(
+        found[None, :1], positions[None, :1], historical[None, :1]
+    )
+    assert first_only.tolist() == [True]
+
+
+@pytest.mark.parametrize(
+    "found_tag",
+    [0, 0x3E803E803E803E80, -1, 7],
+    ids=["cleared", "bf16-filler-residue", "negative-residue", "other-position"],
+)
+def test_uncommitted_rows_fail(found_tag):
+    positions, historical = _group(52934)
+    found = torch.full_like(positions, found_tag)
+    ok = qsa_ring_group_rows_valid(found[None], positions[None], historical[None])
+    assert ok.tolist() == [False]
+
+
+def test_in_chunk_rows_are_never_checked():
+    # aligned chunk start: no historical row, garbage in the ring is irrelevant
+    positions, historical = _group(52936)
+    assert not historical.any()
+    found = torch.full_like(positions, 0x3E803E803E803E80)
+    ok = qsa_ring_group_rows_valid(found[None], positions[None], historical[None])
+    assert ok.tolist() == [True]
+
+
+def test_previous_occupant_same_position_needs_the_claim_clear():
+    """The collision the claim clear exists for: the previous occupant
+    committed the SAME logical positions into the same rows, so its tags are
+    exactly the ones the new owner expects. The reader alone cannot tell;
+    after the clear the rows read 0 and fail."""
+    positions, historical = _group(52934)
+    found = _committed_ring(positions)  # left by the previous occupant
+    assert qsa_ring_group_rows_valid(
+        found[None], positions[None], historical[None]
+    ).tolist() == [True]
+    cache = _bound(rope=True, num_blocks=2)
+    for p, tag in zip(positions.tolist(), found.tolist()):
+        cache.ring_tag_cache[1, p % STATE, 0, 0] = tag
+    cache.clear_ring_row_tags(torch.tensor([1]))
+    after = cache.ring_tag_cache[1, positions % STATE, 0, 0]
+    assert qsa_ring_group_rows_valid(
+        after[None], positions[None], historical[None]
+    ).tolist() == [False]
+
+
+# --------------------------------------------------------------------------
+# telemetry site
+# --------------------------------------------------------------------------
+
+
+def test_site_is_declared_named_and_fatal():
+    site = gt.SITE_QSA_RING_UNCOMMITTED
+    assert site == 11 and gt.NUM_SITES == 12
+    assert "UNCOMMITTED" in gt.SITE_NAMES[site]
+    assert site in gt._ALWAYS_FATAL_SITES
+    ctr = gt.counter(site, torch.device("cpu"))
+    assert ctr.dtype == torch.int64 and ctr.numel() == gt.SLOTS_PER_SITE
+    assert ctr.data_ptr() != gt.counter(gt.SITE_QSA_RING_SKIP, "cpu").data_ptr()
+
+
+@pytest.mark.parametrize(
+    "layer,row,pos", [(3, 0, 52932), (48, 255, 262143), (-1, 7, 0)]
+)
+def test_record_packing_round_trips(layer, row, pos):
+    biased = gt.encode_ring_record(layer, row, pos) + gt.GUARD_BIAS
+    assert 0 < biased <= (1 << 63) - 1
+    assert gt.decode_ring_record(biased) == {
+        "layer": layer,
+        "request_row": row,
+        "source_position": pos,
+    }
+    assert gt.decode_ring_record(0) is None
+
+
+def test_reader_reports_one_coherent_record_and_arms(monkeypatch):
+    gt.reset_for_test()
+    msgs = []
+    monkeypatch.setattr(gt.logger, "warning", lambda fmt, m: msgs.append(m))
+    rows = [[0, 0, 0] for _ in range(gt.NUM_SITES)]
+    rows[gt.SITE_QSA_RING_UNCOMMITTED] = [
+        2,
+        gt.encode_ring_record(7, 1, 52933) + gt.GUARD_BIAS,
+        0 + gt.GUARD_BIAS,  # the row held tag 0: cleared, never committed
+    ]
+    gt._report_rows(torch.device("cpu"), rows)
+    assert len(msgs) == 1
+    text = msgs[0]
+    assert "2 uncommitted" in text
+    assert "'layer': 7" in text and "'request_row': 1" in text
+    assert "'source_position': 52933" in text
+    assert "held tag 0" in text
+    with pytest.raises(RuntimeError, match="uncommitted"):
+        gt.check_pending()
+    gt.reset_for_test()
+
+
+# --------------------------------------------------------------------------
+# KV capacity: the wider row at the production shape
+# --------------------------------------------------------------------------
+
+
+def test_production_pool_blocks_unchanged_by_the_tag_word():
+    """Qwen3.8-Flash-Next at TP2 x PP2 (25/23), MTP K=3, fp8 KV, block 3200,
+    --kv-cache-memory 4100000000: 317 blocks with the D+12 row and with the
+    D+16 row. The ring is a one-block-per-request state group whose pages
+    (6-7 layers x 2,304 B) sit in a 11.5-12.9 MB block, so four more bf16 per
+    row cannot change the block count or the per-request block need; the
+    reported pool (806,792 tokens on the reference host) therefore stays. (This offline
+    stand-in reports 839,390 for both widths: it does not annotate the draft
+    group, so its blocks-per-request differ from the reference host's; the DELTA is the
+    measurement.)"""
+    import tests.v1.test_pp_kv_projection as prod
+    from vllm.v1.core import kv_cache_utils as ku
+
+    real = _key_cache(rope=True).get_kv_cache_spec(
+        SimpleNamespace(num_speculative_tokens=3)
+    )
+    assert real.head_size == 144  # the row this tree actually allocates
+    results = {}
+    for name, ring in (
+        (
+            # instrument check: an absurdly wide ring DOES move the capacity,
+            # so equality below is a measurement, not a probe that ignores
+            # the ring (the ring group splits and costs blocks per request)
+            "sensitivity",
+            CircularBufferSpec(
+                block_size=8,
+                num_kv_heads=1,
+                head_size=262144,
+                head_size_v=0,
+                dtype=torch.bfloat16,
+            ),
+        ),
+        (
+            "pre_tag",
+            CircularBufferSpec(
+                block_size=8,
+                num_kv_heads=1,
+                head_size=140,
+                head_size_v=0,
+                dtype=torch.bfloat16,
+            ),
+        ),
+        ("tagged", real),
+    ):
+        saved = prod._RING
+        prod._RING = ring
+        try:
+            specs = [
+                prod._stage(0, 25, mtp=False),
+                prod._stage(0, 25, mtp=False),
+                prod._stage(25, 48, mtp=True),
+                prod._stage(25, 48, mtp=True),
+            ]
+            cfg = prod._config()
+            configs = ku.get_kv_cache_configs(cfg, specs, [4_100_000_000] * 4)
+            sched = ku.generate_scheduler_kv_cache_config(configs)
+            results[name] = (
+                [c.num_blocks for c in configs],
+                ku.get_kv_cache_capacity(cfg, sched)[0],
+            )
+        finally:
+            prod._RING = saved
+    assert results["sensitivity"][1] < results["pre_tag"][1]
+    assert results["pre_tag"][0] == [317] * 4
+    assert results["tagged"] == results["pre_tag"]
