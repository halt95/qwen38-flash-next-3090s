+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_medium_overflow_tie_keeps_highest_indices() -> None:
+    """Most-recent-wins at the cutoff, with an analytically known answer.
+
+    Random float32 values essentially never tie at the k-th place, so the
+    exactness tests above never exercise the tie rule at all -- they pass
+    whichever direction it cuts. Here every element of the row carries the
+    SAME value, so:
+
+      * the coarse threshold bin holds the whole row (> 4,096) -> overflow,
+      * `#{key > pivot}` is 0 and the entire selection is the tie group,
+      * `tie_total` (seq_len) far exceeds `equal_count` (top_k), so both
+        index-radix tie rounds actually run,
+      * the cut spans several high-byte index buckets and lands mid-bucket.
+
+    Under most-recent-wins the answer is forced: the top_k HIGHEST indices,
+    emitted ascending. `torch.topk` cannot supply this expectation -- with all
+    values equal its index choice is arbitrary -- so the reference is computed
+    from the rule itself.
+    """
+    torch.set_default_device("cuda:0")
+    num_rows, seq_len, width, top_k = 4, 12345, 12352, 2048
+
+    before = _read_exact_counters()
+    if before is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: no "
+            "persistent_topk_exact_counters op. A skip is not a pass."
+        )
+    if before[4] == 0:
+        pytest.skip(
+            "MERLIN_TOPK_EXACT_MEDIUM=0: control arm, the tie rule is not "
+            "claimed here."
+        )
+
+    logits = torch.full((num_rows, width), 1.5, dtype=torch.float32, device="cuda")
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+    indices = torch.empty((num_rows, top_k), dtype=torch.int32, device="cuda")
+    _run_topk_backend("persistent_topk", logits, lengths, indices, top_k, seq_len)
+    torch.accelerator.synchronize()
+
+    after = _read_exact_counters()
+    assert after[1] - before[1] == num_rows, "the row did not overflow as designed"
+    assert after[2] - before[2] == num_rows, "the exact restart did not run"
+    assert after[3] == before[3], "the exact fallback reported a fault"
+
+    # The cut must genuinely exercise both tie rounds, or the test is weaker
+    # than it looks: several high-byte buckets, and not on a bucket boundary.
+    cut = seq_len - top_k
+    assert (cut >> 8) != ((seq_len - 1) >> 8), "tie cut spans only one bucket"
+    assert cut % 256 != 0, "tie cut sits on a bucket boundary"
+
+    expected = torch.arange(cut, seq_len, dtype=torch.int32, device="cuda")
+    for row in range(num_rows):
+        assert torch.equal(indices[row], expected), (
+            f"row {row}: most-recent-wins should select indices "
+            f"[{cut}, {seq_len}) in ascending order; got "
+            f"{indices[row][:4].tolist()}..{indices[row][-4:].tolist()}"
+        )
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_exact_counters_rejects_unsafe_output() -> None:
+    """The counter op writes five raw int32s; it must refuse unusable layouts.
+
+    A CUDA scalar expanded to five elements satisfies a numel check while
+    owning one element of storage, and a strided view would receive the values
+    in the wrong slots. Both must be rejected before the raw pointer is taken.
+    `reset` without `sync` must also be rejected: zeroing while kernels are in
+    flight drops their atomics silently.
+    """
+    torch.set_default_device("cuda:0")
+    op = getattr(torch.ops._C, "persistent_topk_exact_counters", None)
+    if op is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: no "
+            "persistent_topk_exact_counters op. A skip is not a pass."
+        )
+
+    ok = torch.zeros(_EXACT_COUNTER_SLOTS, dtype=torch.int32, device="cuda")
+    op(ok, 0, 1)  # the control: this layout must be accepted
+
+    expanded = torch.zeros(1, dtype=torch.int32, device="cuda").expand(
+        _EXACT_COUNTER_SLOTS
+    )
+    with pytest.raises(Exception):
+        op(expanded, 0, 1)
+
+    strided = torch.zeros(2 * _EXACT_COUNTER_SLOTS, dtype=torch.int32, device="cuda")[
+        ::2
+    ]
+    with pytest.raises(Exception):
+        op(strided, 0, 1)
+
+    too_small = torch.zeros(_EXACT_COUNTER_SLOTS - 1, dtype=torch.int32, device="cuda")
+    with pytest.raises(Exception):
+        op(too_small, 0, 1)
+
+    with pytest.raises(Exception):
+        op(ok, 1, 0)  # reset without sync is not a complete handoff
