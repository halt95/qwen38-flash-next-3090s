+        # With float32 samples an exact tie at the cutoff is vanishingly
+        # unlikely; assert set equality only when the boundary is unambiguous,
+        # so the test never passes by accident on a tie.
+        boundary = torch.topk(logits[row], top_k + 1).values
+        if boundary[top_k - 1] != boundary[top_k]:
+            assert set(got.cpu().tolist()) == set(reference.indices.cpu().tolist()), (
+                f"row {row}: selected index set differs from torch.topk"
+            )
+
+        assert len(set(got.cpu().tolist())) == top_k, f"row {row}: duplicate indices"
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_medium_overflow_is_bit_reproducible() -> None:
+    """Two identical launches must return byte-identical index tensors.
+
+    The exact restart emits by a block-scan rank over ascending element index,
+    never by atomicAdd arrival, so the output is reproducible AND sorted.
+    Upstream's rescan is set-exact but arrival-ordered, and sparse attention
+    sums the selected keys in output order -- so order alone forks the hidden
+    state.  This is the assertion that separates the two implementations.
+    """
+    torch.set_default_device("cuda:0")
+    num_rows, seq_len, top_k = 8, 12288, 512
+
+    counters = _read_exact_counters()
+    if counters is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: this build has "
+            "no persistent_topk_exact_counters op, so the exact path cannot be "
+            "shown to have run. A skip here does not count as a pass."
+        )
+    if counters[4] == 0:
+        pytest.skip(
+            "MERLIN_TOPK_EXACT_MEDIUM=0: control arm. Emission order is not "
+            "claimed here; a qualification run must also execute the arm with "
+            "the switch on."
+        )
+
+    _, first = _run_medium_overflow_row(num_rows, seq_len, top_k, seed=0)
+    first = first.clone()
+    _, second = _run_medium_overflow_row(num_rows, seq_len, top_k, seed=0)
+
+    assert torch.equal(first, second), (
+        "two identical launches returned different index tensors"
+    )
+
+    # Ascending index order is the property that makes the Python-side
+    # MERLIN_QSA_SORT a no-op on these rows rather than a correction.
+    diffs = first[:, 1:].to(torch.int64) - first[:, :-1].to(torch.int64)
+    assert bool((diffs > 0).all()), "exact-path output is not ascending in index"
+
