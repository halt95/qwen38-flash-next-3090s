+++ b/tests/models/qwen4_exp/test_host_embed_capture_sentinel.py
@@ -0,0 +1,202 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The captured-replay host sentinel for the host-embedding layer (reference-host tier).
+
+The host-embedding work's bytewise check passed: on the real Merlin-e1 BF16
+table, TP2 over real NCCL, all 36 cases equal and the negative control (one
+flipped host byte) detected on both ranks. Its own title records what it did
+NOT settle:
+
+    "compiled-forward/captured-replay sentinel not yet run"
+    "that the SERVING path uses the same storage after compile and CUDA-graph
+     capture: the CPU-sentinel check through compiled forward and captured
+     replay, with residency recorded at each lifecycle stage"
+
+That is not a restatement of the layer-level gate. The layer-level gate proves
+the UVA read is byte-exact when Python calls it. This proves the READ IS STILL
+THE UVA READ after capture -- that graph capture did not bake a device-resident
+copy of the table into the replay. Those are different claims, and only the
+second one is about the serving path.
+
+WHY THIS IS THE RIGHT SHAPE OF CHECK. Equality alone cannot distinguish them:
+a captured replay that silently reads a stale device copy produces IDENTICAL
+bytes for identical inputs, forever. So equality is the first arm and a HOST
+SENTINEL is the second: mutate one row in the pinned host table between capture
+and replay and require the replay to produce the EXACT expected post-mutation
+bytes. If it does not, the replay is not reading live host memory, and every
+byte-equality result taken under capture was evidence about a copy
+(an instrument must discriminate both worlds).
+
+WHAT THE SENTINEL DOES *NOT* PROVE. Observing the
+mutation proves the replay DEPENDS ON MUTABLE HOST DATA. It does not prove
+exclusive UVA residency: a replay that copies the host row into a device buffer
+before reading it, on every launch, would also observe the mutation and pass.
+Ruling that out needs storage-identity and residency evidence
+(`host_memory_stats()` per worker, device allocation deltas across the
+lifecycle), which is not collected and is not asserted here. Do not read a
+pass as "therefore UVA".
+
+STATUS: NEVER EXECUTED. This module was written offline with no CUDA
+compiler; it is compile-checked only. It is a reference-host test.
+
+WHAT IT COVERS AND WHAT IT DOES NOT. It covers the standalone layer under a
+real ``torch.cuda.CUDAGraph`` capture, which is the part that can be asserted
+without booting an engine. It does NOT cover the layer inside the model's
+compiled piecewise forward on Flash-Next; that needs a real boot with
+``VLLM_HOST_EMBED_TABLE`` on, reading the sentinel through a served completion,
+and is the part of the host-embedding check not covered here. Do not treat it as closed on this file
+alone.
+"""
+
+import os
+
+import pytest
+import torch
+
+import vllm.model_executor.layers.vocab_parallel_embedding as vpe
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    PinnedHostVocabParallelEmbedding,
+)
+
+VOCAB = 4096
+HIDDEN = 256
+DTYPE = torch.bfloat16
+SENTINEL_ID = 1234
+
+pytestmark = [
+    pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA UVA"),
+    pytest.mark.skipif(
+        os.environ.get("VLLM_E2_GPU_TESTS") != "1",
+        reason="set VLLM_E2_GPU_TESTS=1 to run GPU tests (shared GPU host)",
+    ),
+]
+
+
+@pytest.fixture
+def layer(monkeypatch: pytest.MonkeyPatch) -> PinnedHostVocabParallelEmbedding:
+    """A real host-table embedding at TP=1, so no collective is involved.
+
+    TP=1 is deliberate: the host-embedding work already settled the TP2 collective bytewise. The
+    open question is capture, and a second rank only adds a way for this test
+    to fail for an unrelated reason.
+    """
+    if not vpe.PIN_MEMORY:
+        pytest.skip("pinned memory is unavailable")
+    monkeypatch.setattr(vpe, "get_tensor_model_parallel_rank", lambda: 0)
+    monkeypatch.setattr(vpe, "get_tensor_model_parallel_world_size", lambda: 1)
+    monkeypatch.setattr(vpe, "tensor_model_parallel_all_reduce", lambda value: value)
+
+    embedding = PinnedHostVocabParallelEmbedding(
+        VOCAB, HIDDEN, params_dtype=DTYPE
+    )
+    assert embedding.weight.is_pinned(), "the table must be pinned to be mapped"
+    assert embedding.accelerator_weight_view is not None, "no UVA view"
+    values = torch.arange(VOCAB * HIDDEN, dtype=torch.int32) % 251
+    embedding.weight.data.copy_(values.reshape(VOCAB, HIDDEN).to(DTYPE))
+    return embedding
+
+
+def _ids() -> torch.Tensor:
+    return torch.tensor(
+        [0, 1, SENTINEL_ID, VOCAB - 1, SENTINEL_ID],
+        dtype=torch.int32,
+        device="cuda",
+    )
+
+
+def _bytes(tensor: torch.Tensor) -> bytes:
+    return tensor.contiguous().view(torch.uint8).cpu().numpy().tobytes()
+
+
+def test_captured_replay_is_byte_identical_to_the_eager_forward(layer) -> None:
+    """Arm 1: capture must not change a single output byte."""
+    ids = _ids()
+    eager = _bytes(layer(ids))
+
+    static_ids = ids.clone()
+    graph = torch.cuda.CUDAGraph()
+    # A warm-up on a side stream: capturing a first-ever launch also captures
+    # its lazy initialisation (a lazy load that blocks behind a stream wait).
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        static_out = layer(static_ids)
+    torch.cuda.current_stream().wait_stream(side)
+    with torch.cuda.graph(graph):
+        static_out = layer(static_ids)
+
+    graph.replay()
+    torch.cuda.synchronize()
+
+    assert _bytes(static_out) == eager, (
+        "the captured replay's output differs from the eager forward on the "
+        "same ids and the same table"
+    )
+
+
+def test_a_host_sentinel_written_after_capture_is_visible_to_the_replay(
+    layer,
+) -> None:
+    """Arm 2, THE FAILING CONTROL: does the replay still read host memory?
+
+    Arm 1 passes whether the replay reads the UVA view or a device copy baked
+    in at capture time, because both produce the same bytes for the same ids.
+    Writing the host table AFTER capture separates them: only a real UVA read
+    sees the new row.
+
+    A failure here does not mean the output is wrong today -- it means every
+    byte-equality result taken under capture is evidence about a copy, and the
+    host-table saving (the reason the layer exists) is not what it claims on
+    the serving path.
+    """
+    ids = _ids()
+    static_ids = ids.clone()
+
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        static_out = layer(static_ids)
+    torch.cuda.current_stream().wait_stream(side)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        static_out = layer(static_ids)
+
+    graph.replay()
+    torch.cuda.synchronize()
+    before = _bytes(static_out)
+
+    # The sentinel: one row of the PINNED HOST table, written from the CPU
+    # with no device copy anywhere.
+    row = layer.weight.data[SENTINEL_ID]
+    original = row.clone()
+    row.fill_(torch.finfo(DTYPE).max)
+
+    # `after != before` is too weak -- ANY change passes it,
+    # including a wrong one. Build the exact bytes the replay must now produce
+    # and require equality with them. A partially updated output, a torn row
+    # or a different row moving all satisfy inequality and fail this.
+    expected_rows = []
+    for token in ids.tolist():
+        source = row if token == SENTINEL_ID else layer.weight.data[token]
+        expected_rows.append(source.clone())
+    expected = _bytes(torch.stack(expected_rows).to("cuda"))
+
+    graph.replay()
+    torch.cuda.synchronize()
+    after = _bytes(static_out)
+
+    assert after != before, (
+        "the captured replay did not observe a row written directly into the "
+        "pinned host table: it is reading something other than the live host "
+        "storage"
+    )
+    assert after == expected, (
+        "the captured replay changed, but not to the expected post-mutation "
+        "bytes -- it is not a clean read of the mutated host row"
+    )
+
+    # Restore and prove the observation is two-way, not a one-off artefact.
+    row.copy_(original)
+    graph.replay()
+    torch.cuda.synchronize()
+    assert _bytes(static_out) == before
diff --git a/tests/v1/worker/gpu/test_guard_telemetry_limits.py b/tests/v1/worker/gpu/test_guard_telemetry_limits.py
new file mode 100644
index 0000000000..9fa75364bf
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_telemetry_limits.py
@@ -0,0 +1,328 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Guard telemetry: the documented limits, pinned by test rather than by change.
+
+Three limits of the bounds-guard telemetry are documented rather than fixed in code.
+This module pins the ones that are testable offline. The coverage table and the
+reader/producer stream-ordering argument that go with them are design notes not
+shipped with this tree.
+The three limits:
+
+  * Independent maxima, remaining half -- the (row, value) fields are INDEPENDENT
+    lifetime maxima. The labelling half shipped earlier (the WARNING no
+    longer calls them an "example"); what was missing is a worked example
+    proving the reported pair can be a pair that never occurred. That is
+    ``test_the_reported_pair_can_be_one_that_never_occurred``.
+  * Encoding limits -- the int64 bias encoding loses or falsifies extreme values.
+    Closed by test, not by change: the encoding is correct for every value a
+    correct kernel can produce, and the tests below pin exactly where it stops
+    being able to carry one, plus the fact that the COUNT always survives.
+  * Zero hits -- "zero hits implies no output bit changed" is false in
+    general. See ``test_zero_hits_is_not_bitwise_equivalence`` below; it is a
+    documentation test, and it says so.
+
+No GPU: nothing here allocates a counter buffer or launches a kernel. The
+producer arithmetic is exercised through ``encode_slot``, which is the same
+expression the Triton bodies inline, and the consumer through the real
+``_report_rows``.
+"""
+
+import logging
+
+import pytest
+import torch
+
+from vllm.v1.worker import guard_telemetry as gt
+
+_CPU = torch.device("cpu")
+
+
+@pytest.fixture(autouse=True)
+def _clean_high_water_marks():
+    """``_report_rows`` only reports a count ABOVE what it last saw.
+
+    A test that leaves ``_seen`` behind makes the NEXT test silently measure
+    nothing -- the trap the module's own comment on ``_seen`` describes.
+    """
+    gt.reset_for_test()
+    yield
+    gt.reset_for_test()
+
+
+class _Collector(logging.Handler):
+    def __init__(self) -> None:
+        super().__init__(level=logging.WARNING)
+        self.messages: list[str] = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        self.messages.append(record.getMessage())
+
+
+@pytest.fixture
+def warnings_from_the_reader():
+    """Capture the reader's WARNINGs off the real logger object.
+
+    Not ``caplog``: vLLM's root "vllm" logger is configured with
+    ``propagate: False``, so records never reach the handler pytest installs
+    on the ROOT logger and the capture would be empty. Attaching to the
+    module's own logger is the only capture that cannot quietly see nothing
+    (a capture that can see nothing measures nothing).
+    """
+    target = getattr(gt.logger, "logger", gt.logger)
+    handler = _Collector()
+    previous_level = target.level
+    target.addHandler(handler)
+    target.setLevel(logging.WARNING)
+    try:
+        yield handler.messages
+    finally:
+        target.removeHandler(handler)
+        target.setLevel(previous_level)
+
+
+# ---------------------------------------------------------------------------
+# Encoding limits -- int64 encoding of extreme values
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "value",
+    [0, 1, -1, 42, -42, (1 << 31) - 1, -((1 << 31) - 1), 1 << 40],
+)
+def test_ordinary_values_round_trip(value: int) -> None:
+    """Every value a correct kernel can produce survives the encoding.
+
+    A row or index is an int32-range quantity, so this covers the whole domain
+    the guards actually record. The cases below are about metadata that is
+    already corrupt -- which is precisely when a guard fires.
+    """
+    assert gt.decode_slot(gt.encode_slot(value)) == value
+
+
+def test_int32_min_is_falsified_as_nothing_recorded() -> None:
+    """The one value the encoding cannot distinguish from an unwritten slot.
+
+    ``-GUARD_BIAS`` encodes to exactly 0, and 0 is the zeroed-buffer sentinel
+    for "this slot was never written". So a guard that masks an access at row
+    INT32_MIN reports its ROW as absent.
+    """
+    assert gt.encode_slot(-gt.GUARD_BIAS) == 0
+    assert gt.decode_slot(0) is None
+
+
+def test_values_below_int32_min_are_lost_by_atomic_max() -> None:
+    """Below ``-GUARD_BIAS`` the encoded word is negative.
+
+    The slot is only ever written with ``tl.atomic_max`` into a buffer zeroed
+    at allocation, and 0 > any negative, so the store is a no-op and the slot
+    still reads 0. Modelled here as ``max(0, encoded)`` because that is
+    exactly what the atomic does; there is no Triton in this test.
+    """
+    for value in (-gt.GUARD_BIAS - 1, -(1 << 40), -(1 << 62)):
+        encoded = gt.encode_slot(value)
+        assert encoded < 0, value
+        assert gt.decode_slot(max(0, encoded)) is None, value
+
+
+def test_the_encodable_window_is_where_the_constants_say_it_is() -> None:
+    """Pin the published bounds so a later change to GUARD_BIAS moves them."""
+    assert gt.decode_slot(gt.encode_slot(gt.GUARD_MIN_ENCODABLE)) == (
+        gt.GUARD_MIN_ENCODABLE
+    )
+    assert gt.decode_slot(gt.encode_slot(gt.GUARD_MAX_ENCODABLE)) == (
+        gt.GUARD_MAX_ENCODABLE
+    )
+    # One step below the window is the falsified case, not a round trip.
+    assert gt.encode_slot(gt.GUARD_MIN_ENCODABLE - 1) == 0
+    # One step above it does not fit in the int64 slot at all.
+    assert gt.encode_slot(gt.GUARD_MAX_ENCODABLE + 1) > (1 << 63) - 1
+
+
+def test_the_count_survives_an_unencodable_value_and_the_report_says_so(
+    warnings_from_the_reader: list[str],
+) -> None:
+    """The operational half of the encoding limits.
+
+    ``n_masked`` carries no bias and is written with ``atomic_add``, so it
+    advances whatever the offending value was. A report of "3 masked accesses,
+    row None, index None" is therefore a report of three REAL masked faults --
+    not a report of nothing. Before this change the message said only "row-field
+    None", which reads as "nothing recorded" to anyone who has not read the
+    encoding.
+
+    What the message must NOT do is diagnose WHY the field is None. The reader
+    has no ordering dependency on the producer, so an unobserved maximum and an
+    unencodable one read identically; the first draft of this clause claimed
+    "unencodable" outright and was wrong to.
+    """
+    rows = [[0, 0, 0] for _ in range(gt.NUM_SITES)]
+    rows[gt.SITE_MAMBA_COPY] = [3, 0, 0]  # count 3, both maxima unencodable
+
+    gt._report_rows(_CPU, rows)
+
+    assert len(warnings_from_the_reader) == 1, warnings_from_the_reader
+    text = warnings_from_the_reader[0]
+    assert "masked 3 out-of-range access(es)" in text
+    assert "row-field None" in text
+    assert "UNOBSERVED OR UNENCODABLE, not absent" in text
+    # It must not claim to know which of the two it is.
+    assert "no ordering dependency on the producer" in text
+
+
+# ---------------------------------------------------------------------------
+# Independent maxima -- the fields are independent; the worked example
+# ---------------------------------------------------------------------------
+
+
+def test_the_reported_pair_can_be_one_that_never_occurred(
+    warnings_from_the_reader: list[str],
+) -> None:
+    """THE EXAMPLE PAIR.
+
+    Two masked accesses at one site, in this order:
+
+      hit A: row 3, offending index 100
+      hit B: row 7, offending index 5
+
+    Each slot independently keeps its lifetime maximum, so the slots end at
+    row 7 and index 100 and the reader reports the pair **(7, 100)** -- a
+    combination that never happened on the device. Row 7's access was at
+    index 5; index 100's access was at row 3.
+
+    This is why the WARNING labels them independent lifetime maxima and why no
+    attribution may be built on the pair: to chase a single access you need
+    the count plus a repro, not this triple. Anyone wanting a coherent
+    (row, value) sample needs the other half -- a capture that writes
+    both slots under one atomic decision -- which this tree does NOT implement.
+    """
+    slots = [0, 0, 0]
+    for row, value in ((3, 100), (7, 5)):
+        slots[0] += 1
+        slots[1] = max(slots[1], gt.encode_slot(row))
+        slots[2] = max(slots[2], gt.encode_slot(value))
+
+    assert gt.decode_slot(slots[1]) == 7
+    assert gt.decode_slot(slots[2]) == 100
+    assert (7, 100) not in {(3, 100), (7, 5)}
+
+    rows = [[0, 0, 0] for _ in range(gt.NUM_SITES)]
+    rows[gt.SITE_GDN_DECODE_STATE] = slots
+
+    gt._report_rows(_CPU, rows)
+
+    assert len(warnings_from_the_reader) == 1, warnings_from_the_reader
+    text = warnings_from_the_reader[0]
+    assert "row-field 7, index-field 100" in text
+    assert "independent lifetime maxima, not one observed pair" in text
+    # ...and no suffix about unobservable fields: both decoded fine.
+    assert "UNOBSERVED OR UNENCODABLE" not in text
+
+
+# ---------------------------------------------------------------------------
+# Zero hits is not bitwise equivalence
+# ---------------------------------------------------------------------------
+
+
+def test_zero_hits_is_not_bitwise_equivalence() -> None:
+    """A DOCUMENTATION TEST. It asserts the guard set's shape, not a behaviour.
+
+    The tempting claim is "zero guard hits implies no output bit
+    changed". It holds only for live, valid inputs, and there are two ways out
+    of it that a counter at zero cannot exclude:
+
+    1. **The guards are bounds checks.** Every site in ``SITE_NAMES`` masks an
+       OUT-OF-RANGE access and counts it. A wrong-but-in-range row is not an
+       out-of-range access, so it is invisible here by construction -- stated
+       for the mamba copy site in the guard design notes ("Blind to: a column or row that
+       is in range but wrong -- the common case for a recycled slot,
+       producing a silent wrong state copy"). That is the whole of the
+       vllm#55506 / llama.cpp#29092 class, which is why it needed its own
+       instrument (``test_mamba_slot_ownership``) rather than a counter.
+
+    2. **``NULL_BLOCK_ID`` rows change bytes uncounted.** Block id 0 is the
+       pool's placeholder (``core/block_pool.py:188-191``,
+       ``v1/attention/backends/utils.py:46``), which no request owns. The
+       copy guard's ``<= 0`` branch is DELIBERATELY not counted -- the guard design notes:
+       "Also blind to the ``<= 0`` path, deliberately: NULL_BLOCK_ID is 0 and
+       is the ordinary unallocated marker". Where such a row is zero-filled
+       rather than skipped, inactive bytes are written and no counter moves.
+       Those bytes belong to no live request, so no OUTPUT bit changes -- but
+       "zero hits" is evidence about live rows only, and a claim of bitwise
+       equivalence has to be made about the output tensor, not inferred from
+       the counters.
+
+    So a v2.2 result may say "no guard fired", never "no output bit changed"
+    (measure the property, not the proxy). The check below is that the
+    guard set is still a bounds-check set of the size this argument was
+    written against; if a site is added, this argument is re-read.
+    """
+    assert gt.NUM_SITES == 11
+    assert set(gt.SITE_NAMES) == set(range(gt.NUM_SITES))
+    # The one non-bounds site, which is telemetry and not a masked fault.
+    assert "SKIPPED" in gt.SITE_NAMES[gt.SITE_QSA_RING_SKIP]
+
+
+# ---------------------------------------------------------------------------
+# The diagnostic gates are registered knobs
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        (None, "off"),
+        ("", "off"),  # `VAR=` is how scripts and fixtures clear a variable
+        ("   ", "off"),
+        ("off", "off"),
+        ("1", "warn"),  # continuity with the earlier boolean gates
+        ("warn", "warn"),
+        ("RAISE", "raise"),
+        (" Warn ", "warn"),
+    ],
+)
+def test_e2_diagnostic_gates_normalize_identically(
+    monkeypatch: pytest.MonkeyPatch, raw: str | None, expected: str
+) -> None:
+    """One normalizer for the whole family, so the registry cannot lie.
+
+    Both PLE diagnostic gates are registered in ``vllm.envs`` and read from there by the
+    modules that act on them. If a module re-parsed the variable itself, the
+    value ``vllm.envs`` reports (and hashes, and logs) could differ from the
+    value the check applies.
+    """
+    import vllm.envs as envs
+
+    for name in ("VLLM_E2_PLE_FLAG_CHECK", "VLLM_E2_MAMBA_SLOT_OWNERSHIP"):
+        monkeypatch.delenv(name, raising=False)
+        if raw is not None:
+            monkeypatch.setenv(name, raw)
+        assert envs.environment_variables[name]() == expected, (name, raw)
+
+
+def test_a_set_but_unrecognised_gate_is_a_boot_error(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Fail closed: a broken gate must not silently disarm its instrument."""
+    import vllm.envs as envs
+
+    monkeypatch.setenv("VLLM_E2_MAMBA_SLOT_OWNERSHIP", "yes")
+    with pytest.raises(ValueError, match="off|warn|raise"):
+        envs.environment_variables["VLLM_E2_MAMBA_SLOT_OWNERSHIP"]()
+
+
+def test_the_host_side_gates_are_not_compile_factors() -> None:
+    """They gate host Python outside any capture and add no graph node.
+
+    Hashing them would invalidate every compile cache the moment a diagnostic
+    boot is taken -- which is precisely when the cache is wanted. If either
+    ever grows a device-side component this test should fail and be revisited,
+    not deleted.
+    """
+    import vllm.envs as envs
+
+    monkeypatch_free = envs.compile_factors()
+    assert "VLLM_E2_PLE_FLAG_CHECK" not in monkeypatch_free
+    assert "VLLM_E2_MAMBA_SLOT_OWNERSHIP" not in monkeypatch_free
+    # ...but they ARE registered, so `vllm.envs` can report them.
+    assert "VLLM_E2_PLE_FLAG_CHECK" in envs.environment_variables
+    assert "VLLM_E2_MAMBA_SLOT_OWNERSHIP" in envs.environment_variables
diff --git a/tests/v1/worker/gpu/test_mamba_slot_ownership.py b/tests/v1/worker/gpu/test_mamba_slot_ownership.py
new file mode 100644
index 0000000000..89131efe06
--- /dev/null
+++ b/tests/v1/worker/gpu/test_mamba_slot_ownership.py
@@ -0,0 +1,366 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Ownership of the mamba state slot a request resumes into.
+
+THE HAZARD (llama.cpp#29092 class; the vllm#55506 failure mode is one
+instance). Mamba state blocks are the one KV class in this tree with neither
+zeroing nor an ownership instrument:
+
+* ``single_type_kv_cache_manager.py:96-99`` gates the recording of newly
+  allocated blocks for zeroing on ``isinstance(kv_cache_spec, AttentionSpec)``.
+  ``MambaSpec`` is not an ``AttentionSpec``, so mamba state blocks are never
+  zeroed by ``KVBlockZeroer`` (``gpu/model_runner.py:1213``).
+* the host-side KV-zeroer ownership check (``sched/scheduler.py``) only inspects
+  ``new_block_ids_to_zero`` -- a list mamba blocks are never on.
+* a genuinely fresh request is safe anyway: ``gdn_attn.py:401`` sets
+  ``has_initial_state = context_lens_tensor > 0``, so at ``context_len == 0``
+  the GDN kernel ignores whatever the reused block holds.
+* a RESUMING request is not. With ``has_initial_state`` true the kernel
+  consumes the block's contents, and the only thing that puts the right
+  contents there is the align copy. The bounds guards bound the
+  indices; a bounds check cannot catch a wrong-but-in-range row, which is the
+  whole of this class.
+
+So the safety of a resuming request rested entirely on the correctness of the
+align copy's row selection -- which is the row-attribution fix, itself the fix for
+having got that row wrong once. These tests give that argument an instrument.
+
+GPU-FREE, INCLUDING THE FAILING CONTROL. The check is host side by
+construction, and ``test_pp_deferred_mamba_block_table`` already drives the
+real production plumbing (``MambaHybridModelState._ensure_align_ctx`` ->
+``MambaSpecDecodeGPUContext.initialize_from_forward_context`` ->
+``run_fused_postprocess_align``) on CPU tensors with the Triton launch
+captured instead of run. The control reuses that scenario builder rather than a
+stand-in (a hook contract needs the real classes), flips the production
+row rule ``ALIGN_BT_ROW_IS_REQ`` off, and requires the check to fire. No GPU
+time is needed; what a reference-host run would add is the end-to-end consequence
+(acceptance-length collapse, constant-token loops), not the assertion.
+
+SCOPE LIMIT, stated because it is a real one: ``run_fused_postprocess_align``
+is engine-thread Python, so a CAPTURED replay does not re-enter it and the
+check does not run for one. It covers the launch path, which is where the row
+is selected.
+"""
+
+import pytest
+
+from tests.v1.worker.gpu.test_pp_deferred_mamba_block_table import (
+    _build_scenario,
+    _run_deferred,
+)
+from vllm.v1.worker import mamba_utils as mamba_utils_mod
+from vllm.v1.worker.mamba_utils import mamba_slot_ownership_violations
+
+# vllm#55506's own reproduction permutation. A NON-IDENTITY batch-row ->
+# req-slot mapping is load-bearing for the control: with an identity mapping
+# ``batch_idx == req_idx`` and the two row rules are indistinguishable
+# (the needle shape is a variable). Four entries is also >= 3 concurrent
+# requests, the concurrency at which tomasruizt reproduced #55506 under
+# PP2 + MTP + prefix caching.
+_PERM = (2, 0, 3, 1)
+
+
+def _arm(monkeypatch: pytest.MonkeyPatch, mode: str = "raise") -> None:
+    monkeypatch.setattr(mamba_utils_mod, "_SLOT_OWNERSHIP_MODE", mode)
+
+
+# ---------------------------------------------------------------------------
+# End-to-end through the real align plumbing
+# ---------------------------------------------------------------------------
+
+
+def test_production_row_rule_reports_no_ownership_violation(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The green world: with ALIGN_BT_ROW_IS_REQ the check must stay silent.
+
+    A check that fires on correct metadata is worse than no check (a
+    guard rule), so this arm is not decoration: it is what makes the control
+    below evidence about the row rule rather than about the fixture.
+    """
+    _arm(monkeypatch)
+    scenario = _build_scenario(slot_mapping=_PERM)
+    _run_deferred(scenario, monkeypatch)
+    assert scenario.ctx.last_slot_ownership_violations == []
+
+
+def test_bt_row_is_req_false_makes_the_check_fire(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """THE FAILING CONTROL: flip the row rule off, the check must fire.
+
+    This is the vllm#55506 world reproduced offline. The deferred align
+    post-process carries an ``idx_mapping`` captured ``pp_size`` steps earlier,
+    so with ``BT_ROW_IS_REQ`` off the kernel resolves batch row 0 -- which the
+    mapping says is request slot 2 -- to block-table row 0, another request's
+    slot. tomasruizt measured the consequence as acceptance length collapsing
+    to 1.00 for stretches; on this fork it showed as all-NaN logits and
+    constant-token loops.
+
+    If this test passes without the assertion firing, the assertion measures
+    nothing (an instrument must discriminate both worlds).
+    """
+    _arm(monkeypatch)
+    monkeypatch.setattr(mamba_utils_mod, "ALIGN_BT_ROW_IS_REQ", False)
+    scenario = _build_scenario(slot_mapping=_PERM)
+
+    with pytest.raises(RuntimeError, match="state-slot ownership violation"):
+        _run_deferred(scenario, monkeypatch)
+
+    findings = scenario.ctx.last_slot_ownership_violations
+    assert any(f.startswith("row attribution:") for f in findings), findings
+    # ...and it is not only an index complaint: the block ids differ, so the
+    # copy really would land on another request's recurrent state.
+    assert any(f.startswith("destination disagreement:") for f in findings), findings
+
+
+def test_warn_mode_records_without_stopping_the_step(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """warn is the mode for a long stress boot; raise is for a repro."""
+    _arm(monkeypatch, "warn")
+    monkeypatch.setattr(mamba_utils_mod, "ALIGN_BT_ROW_IS_REQ", False)
+    scenario = _build_scenario(slot_mapping=_PERM)
+
+    _run_deferred(scenario, monkeypatch)
+
+    assert scenario.ctx.last_slot_ownership_violations
+
+
+def test_off_is_off(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Default: nothing is copied to the host and nothing is recorded."""
+    _arm(monkeypatch, "off")
+    monkeypatch.setattr(mamba_utils_mod, "ALIGN_BT_ROW_IS_REQ", False)
+    scenario = _build_scenario(slot_mapping=_PERM)
+
+    _run_deferred(scenario, monkeypatch)
+
+    assert scenario.ctx.last_slot_ownership_violations == []
+
+
+def test_an_identity_mapping_hides_the_defect_from_this_check(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Why the control uses a permutation, asserted rather than asserted-about.
+
+    With an identity mapping ``batch_idx == req_idx``, so the wrong row rule
+    selects the right row anyway and the check is silent although the rule is
+    wrong. That is not a defect in the check -- there is nothing wrong with
+    the step -- but it IS a constraint on any future reproduction attempt:
+    a single-stream or in-order batch cannot exhibit #55506, which is why
+    upstream needed >= 3 concurrent requests to see it at all.
+    """
+    _arm(monkeypatch)
+    monkeypatch.setattr(mamba_utils_mod, "ALIGN_BT_ROW_IS_REQ", False)
+    scenario = _build_scenario(slot_mapping=(0, 1, 2))
+
+    _run_deferred(scenario, monkeypatch)
+
+    assert scenario.ctx.last_slot_ownership_violations == []
+
+
+# ---------------------------------------------------------------------------
+# The three properties, directly on the pure checker
+# ---------------------------------------------------------------------------
+
+_BLOCK_SIZE = 16
+
+
+def _clean_kwargs(**overrides):
+    """One copying request (slot 0) and one bystander, tables disjoint."""
+    kwargs = dict(
+        num_reqs=2,
+        idx_mapping=[0, 1],
+        bt_row_is_req=True,
+        block_tables=[[[10, 11, 12], [20, 21, 22], [30, 31, 32]]],
+        num_rows=3,
+        num_accepted_tokens=[2, 2, 2],
+        state_idx=[0, 0, 0],
+        new_num_computed_tokens=[32, 40, 40],
+        block_size=_BLOCK_SIZE,
+    )
+    kwargs.update(overrides)
+    return kwargs
+
+
+def test_clean_case_is_clean() -> None:
+    assert mamba_slot_ownership_violations(**_clean_kwargs()) == []
+
+
+def test_a_row_that_does_not_reach_the_block_table_is_not_judged() -> None:
+    """``needs_copy`` false means the kernel returns before any dereference.
+
+    Judging such a row would make the check fire on rows the kernel never
+    touches, i.e. on correct metadata.
+    """
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(
+            # One batch row, mapped to slot 1, whose 40 computed tokens leave
+            # the accepted window inside the running block: needs_copy false.
+            # The row rule is WRONG here (batch row 0 != slot 1) and the check
+            # still says nothing, because the kernel never reaches the table.
+            num_reqs=1,
+            bt_row_is_req=False,
+            idx_mapping=[1, 0],
+            new_num_computed_tokens=[32, 40, 40],
+        )
+    )
+    assert findings == []
+
+
+def test_two_requests_resuming_into_one_state_block_is_a_collision() -> None:
+    """The llama.cpp#29092 shape with the row rule CORRECT.
+
+    Row attribution and destination agreement both pass -- each request reads
+    its own row -- and the tables still hand both of them block 11. Only the
+    collision property catches this, which is why it is separate and not a
+    corollary of the row rule.
+    """
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(
+            block_tables=[[[10, 11, 12], [20, 11, 22], [30, 31, 32]]],
+            new_num_computed_tokens=[32, 32, 40],
+        )
+    )
+    assert len(findings) == 1, findings
+    assert findings[0].startswith("block collision:")
+    assert "slot 0" in findings[0] and "slot 1" in findings[0]
+
+
+def test_null_block_id_rows_are_not_a_collision() -> None:
+    """Block id 0 is the pool's placeholder; no request owns it.
+
+    ``NULL_BLOCK_ID`` (``v1/attention/backends/utils.py:46``) is popped out of
+    the free queue at construction (``core/block_pool.py:188-191``), so two
+    rows carrying 0 are two unallocated columns, not a shared state block.
+    Treating that as a collision would fire on every partially allocated
+    batch.
+    """
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(
+            block_tables=[[[10, 0, 12], [20, 0, 22], [30, 31, 32]]],
+            new_num_computed_tokens=[32, 32, 40],
+        )
+    )
+    assert findings == []
+
+
+def test_a_row_outside_the_persistent_table_is_reported_and_not_indexed() -> None:
+    """Out-of-range rows are the bounds guards' business, but the check must
+    not itself index past the table while reporting one."""
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(
+            num_reqs=3,
+            bt_row_is_req=False,
+            idx_mapping=[2, 1, 0],
+            num_rows=2,
+            new_num_computed_tokens=[32, 40, 32],
+        )
+    )
+    # Batch row 2 resolves to table row 2 with only 2 rows registered.
+    assert any(f.startswith("row bound:") for f in findings), findings
+    # Batch row 0 is in range but wrong, and is reported as such -- the two
+    # findings are different properties, not one restated.
+    assert any(f.startswith("row attribution:") for f in findings), findings
+    assert any(f.startswith("destination disagreement:") for f in findings), findings
+
+
+def test_a_request_slot_past_the_decision_arrays_is_reported() -> None:
+    """The per-slot arrays are read at ``req_idx``; a slot past them is
+    malformed metadata, and the checker must say so rather than raise."""
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(num_reqs=1, idx_mapping=[7])
+    )
+    assert len(findings) == 1, findings
+    assert findings[0].startswith("slot bound:")
+
+
+def test_a_negative_request_slot_is_skipped() -> None:
+    """``req_idx < 0`` is the kernel's own inactive-row sentinel."""
+    assert (
+        mamba_slot_ownership_violations(
+            **_clean_kwargs(idx_mapping=[-1, 1], bt_row_is_req=False)
+        )
+        == []
+    )
+
+
+def test_a_short_idx_mapping_is_reported_rather_than_raising() -> None:
+    """An instrument that dies is an instrument that is not there."""
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(num_reqs=3, idx_mapping=[0, 1])
+    )
+    assert any("idx_mapping is shorter" in f for f in findings), findings
+
+
+# ---------------------------------------------------------------------------
+# What the narrowed instrument gained
+# ---------------------------------------------------------------------------
+
+
+def test_a_writer_colliding_with_a_live_non_copying_owner_is_caught() -> None:
+    """A destination-only collision map missed this case.
+
+    Slot 1 is live this step and does NOT copy (40 computed tokens leave its
+    accepted window inside the running block), so it never appeared in a map
+    built from copying requests' destinations. Its current state block is 20.
+    Slot 0 copies into column 1, which also holds block 20. That is a writer
+    landing on a live owner's recurrent state -- the llama.cpp#29092 shape --
+    and it must be reported.
+    """
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(
+            block_tables=[[[10, 20, 12], [20, 21, 22], [30, 31, 32]]],
+            new_num_computed_tokens=[32, 40, 40],
+        )
+    )
+    assert len(findings) == 1, findings
+    assert findings[0].startswith("block collision:")
+    assert "live source" in findings[0], findings[0]
+
+
+def test_a_negative_destination_column_is_reported_not_wrapped() -> None:
+    """A negative column indexes a Python list FROM THE END.
+
+    Accepted count 1 with computed count 0 gives ``dst_col == -1``. The device
+    guard masks that access. An unbounded reader here would instead fetch the
+    LAST column and could report a collision on a block the kernel never
+    touches -- an instrument inventing a finding is worse than a silent one.
+    """
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(
+            num_reqs=1,
+            idx_mapping=[0],
+            num_accepted_tokens=[1, 2, 2],
+            new_num_computed_tokens=[0, 40, 40],
+        )
+    )
+    assert findings, "a -1 destination column must be reported"
+    assert all(f.startswith("malformed metadata:") for f in findings), findings
+    # The last column (block 12) must not have been read as a real claim.
+    assert not any("12" in f and "collision" in f for f in findings), findings
+
+
+def test_pointer_registration_disagreement_is_reported() -> None:
+    """The one INDEPENDENT source of truth this layer has.
+
+    Everything else in this checker is derived from the same table it is
+    validating. If the kernel was handed a different address, every other
+    finding in the run is about the wrong tensor, and zero findings would be
+    meaningless rather than reassuring.
+    """
+    findings = mamba_slot_ownership_violations(
+        **_clean_kwargs(registered_ptrs=[0xDEAD0000], view_ptrs=[0xBEEF0000])
+    )
+    assert len(findings) == 1, findings
+    assert findings[0].startswith("pointer registration:")
+
+
+def test_matching_pointers_are_silent() -> None:
+    """A check that fires on correct metadata is worse than no check."""
+    assert (
+        mamba_slot_ownership_violations(
+            **_clean_kwargs(registered_ptrs=[0xCAFE0000], view_ptrs=[0xCAFE0000])
+        )
+        == []
+    )
