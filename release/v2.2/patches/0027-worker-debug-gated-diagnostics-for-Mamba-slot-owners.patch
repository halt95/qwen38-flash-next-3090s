+def _e2_diagnostic_mode(name: str) -> str:
+    """Normalize an E2 diagnostic gate to off|warn|raise.
+
+    One normalizer for every knob in the family, so a registry entry and the
+    module that acts on it cannot disagree about what the environment said.
+    ``1`` is accepted as ``warn`` for continuity with the earlier boolean
+    gates. A set-but-unrecognised value is a boot error, not a silent ``off``:
+    a broken gate that disarms its own instrument is the failure mode these
+    diagnostics exist to avoid.
+    """
+    # An EMPTY value means off, not a boot error. Shell scripts and pytest
+    # fixtures both use `VAR=` to mean "unset" (see tests/v1/worker/
+    # test_e2_memstats.py), and rejecting it would turn a routine way of
+    # clearing the variable into a crash.
+    value = os.environ.get(name, "off").strip().lower() or "off"
+    if value == "1":
+        return "warn"
+    if value not in ("off", "warn", "raise"):
+        raise ValueError(
+            f"{name} must be off|warn|raise (or 1 for warn), got {value!r}"
+        )
+    return value
+
