+        accept_token_bias = aligned_new_computed - num_tokens_running_state
+        dst_col = aligned_new_computed // block_size - 1
+        if src_col == dst_col and accept_token_bias == 0:
+            continue  # no-op self-copy: the kernel returns before the copy
+
+        row_used = req_idx if bt_row_is_req else batch_idx
+
+        # (1) row attribution
+        if row_used != req_idx:
+            violations.append(
+                f"row attribution: batch row {batch_idx} is request slot "
+                f"{req_idx}, but the align post-process will read block-table "
+                f"row {row_used}. Under PP the idx_mapping was captured "
+                f"pp_size steps before this launch, so row {row_used} belongs "
+                f"to a different micro-batch's request (vllm#55506)."
+            )
+        if not 0 <= row_used < num_rows:
+            violations.append(
+                f"row bound: batch row {batch_idx} resolves to block-table row "
+                f"{row_used}, outside [0, {num_rows})"
+            )
