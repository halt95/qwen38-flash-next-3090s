+
+# -------------------------------------------------------------- the draft role
+
+
+def test_the_draft_role_is_checked_independently(monkeypatch) -> None:
+    """Qwen4ExpMTP builds Qwen4ExpMultiTokenPredictor, not CausalLM."""
