diff --git a/tests/v1/test_e2_guards.py b/tests/v1/test_e2_guards.py
new file mode 100644
index 0000000000..a3b683988d
--- /dev/null
+++ b/tests/v1/test_e2_guards.py
@@ -0,0 +1,215 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Focused cases for the fork's startup graph-profile guard.
+
+An earlier version was rejected for accepting values upstream
+treats as off, rejecting valid ``CompilationMode.NONE`` boots, swallowing read
+errors, and missing the drafter. Each of those is a case below.
+
+These use a plain stand-in config rather than a real ``VllmConfig``: the guard
+reads exactly three attributes, and building a real config needs a checkpoint.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.config import CompilationMode, CUDAGraphMode
+from vllm.v1 import e2_guards
+from vllm.v1.e2_guards import (
+    ALLOW_BREAKABLE_ENV,
+    BREAKABLE_ENV,
+    EXPECTED_MODE_ENV,
+    assert_graph_profile_is_executable,
+    breakable_resolved,
+)
+
+
+def _config(
+    mode: CompilationMode = CompilationMode.NONE,
+    cudagraph_mode: CUDAGraphMode = CUDAGraphMode.FULL,
+    architectures: tuple[str, ...] = ("Qwen4ExpForCausalLM",),
+):
+    return SimpleNamespace(
+        model_config=SimpleNamespace(architectures=list(architectures)),
+        compilation_config=SimpleNamespace(mode=mode, cudagraph_mode=cudagraph_mode),
+    )
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for name in (BREAKABLE_ENV, ALLOW_BREAKABLE_ENV, EXPECTED_MODE_ENV):
+        monkeypatch.delenv(name, raising=False)
+    # Keep the envs accessor from dominating the raw reading in these cases.
+    monkeypatch.setattr(e2_guards, "breakable_resolved", breakable_resolved)
+
+
+# --------------------------------------------------------------- the parser
+
+
+@pytest.mark.parametrize("raw", ["0", "2", "true", "True", "FALSE", "", "01"])
+def test_only_the_exact_string_one_is_on(monkeypatch, raw: str) -> None:
+    """Match envs.py:937 exactly. A stricter parser is a FALSE REJECTION."""
+    monkeypatch.setenv(BREAKABLE_ENV, raw)
+    monkeypatch.setattr(
+        "vllm.envs.VLLM_USE_BREAKABLE_CUDAGRAPH", False, raising=False
+    )
+    assert breakable_resolved() is False
+
+
+def test_the_raw_reading_wins_when_envs_is_stale(monkeypatch) -> None:
+    """_maybe_enable_breakable_cudagraph mutates os.environ after envs caches."""
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    monkeypatch.setattr(
+        "vllm.envs.VLLM_USE_BREAKABLE_CUDAGRAPH", False, raising=False
+    )
+    assert breakable_resolved() is True
+
+
+def test_the_envs_reading_wins_when_the_raw_value_is_absent(monkeypatch) -> None:
+    monkeypatch.delenv(BREAKABLE_ENV, raising=False)
+    monkeypatch.setattr(
+        "vllm.envs.VLLM_USE_BREAKABLE_CUDAGRAPH", True, raising=False
+    )
+    assert breakable_resolved() is True
+
+
+# ------------------------------------------------------------- the rejections
+
+
+def test_an_unpinned_launch_fails(monkeypatch) -> None:
+    """Absence is the state the upstream auto-enable feeds on."""
+    with pytest.raises(RuntimeError, match="is not set"):
+        assert_graph_profile_is_executable(_config())
+
+
+def test_breakable_on_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    with pytest.raises(RuntimeError, match="resolved ON"):
+        assert_graph_profile_is_executable(_config())
+
+
+def test_piecewise_with_vllm_compile_and_breakable_off_fails(monkeypatch) -> None:
+    """The BLOCKER: upstream accepts this at config time and dies at capture."""
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    with pytest.raises(RuntimeError, match="cudagraph_utils.py:605"):
+        assert_graph_profile_is_executable(
+            _config(
+                mode=CompilationMode.VLLM_COMPILE,
+                cudagraph_mode=CUDAGraphMode.FULL_AND_PIECEWISE,
+            )
+        )
+
+
+def test_expected_mode_mismatch_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    monkeypatch.setenv(EXPECTED_MODE_ENV, "FULL_DECODE_ONLY")
+    with pytest.raises(RuntimeError, match="EXPECTED_CUDAGRAPH_MODE"):
+        assert_graph_profile_is_executable(_config(cudagraph_mode=CUDAGraphMode.FULL))
+
+
+# ------------------------------------------------------------- the permissions
+
+
+def test_compilation_none_with_full_graphs_is_permitted(monkeypatch) -> None:
+    """FALSE REJECTION control.
+
+    On v0.30.0's NVIDIA Qwen4Exp path NONE is a normal resolved state -- #55272
+    removed the compile wrappers -- so treating NONE as evidence of the
+    auto-enable, which the first version of this guard did, rejects the one
+    profile that is actually executable.
+    """
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    assert_graph_profile_is_executable(
+        _config(mode=CompilationMode.NONE, cudagraph_mode=CUDAGraphMode.FULL)
+    )
+
+
+def test_none_plus_full_decode_only_is_permitted(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    assert_graph_profile_is_executable(
+        _config(
+            mode=CompilationMode.NONE, cudagraph_mode=CUDAGraphMode.FULL_DECODE_ONLY
+        )
+    )
+
+
+def test_eager_is_permitted(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    assert_graph_profile_is_executable(
+        _config(mode=CompilationMode.NONE, cudagraph_mode=CUDAGraphMode.NONE)
+    )
+
+
+def test_expected_mode_match_passes(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    monkeypatch.setenv(EXPECTED_MODE_ENV, "FULL")
+    assert_graph_profile_is_executable(_config(cudagraph_mode=CUDAGraphMode.FULL))
+
+
+# ------------------------------------------------------------ fail-closed paths
+
+
+def test_a_missing_compilation_config_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = SimpleNamespace(
+        model_config=SimpleNamespace(architectures=["Qwen4ExpForCausalLM"]),
+        compilation_config=None,
+    )
+    with pytest.raises(RuntimeError, match="no compilation_config"):
+        assert_graph_profile_is_executable(cfg)
+
+
+def test_a_missing_model_config_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = SimpleNamespace(model_config=None, compilation_config=SimpleNamespace())
+    with pytest.raises(RuntimeError, match="no model_config"):
+        assert_graph_profile_is_executable(cfg)
+
+
+def test_an_unreadable_switch_fails_rather_than_reporting_off(monkeypatch) -> None:
+    """A guard that cannot read its own input must not answer False."""
+    monkeypatch.delenv(BREAKABLE_ENV, raising=False)
+
+    class _Boom:
+        def __getattr__(self, name):
+            raise RuntimeError("envs unavailable")
+
+    monkeypatch.setitem(__import__("sys").modules, "vllm.envs", _Boom())
+    with pytest.raises(RuntimeError):
+        breakable_resolved()
+
+
+# ------------------------------------------------------------------ the opt-out
+
+
+def test_the_opt_out_is_loud_and_skips_the_checks(monkeypatch, caplog) -> None:
+    monkeypatch.setenv(ALLOW_BREAKABLE_ENV, "1")
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    with caplog.at_level("WARNING"):
+        assert_graph_profile_is_executable(
+            _config(
