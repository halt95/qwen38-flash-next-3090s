index 0000000000..815a22fc08
--- /dev/null
+++ b/tests/models/qwen4_exp/test_ple_fp8_selector_checkpoint.py
@@ -0,0 +1,276 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The shipped Flash-Next checkpoint must still select the FP8 PLE method on v0.30.0.
+
+Why this file exists (vLLM 0.30 rebase). Our
+fork used to force the FP8 PLE embedding method from a 21-line catch-all branch
+in ``_get_ple_embedding_quant_method``. That function lived in the half of
+``vllm/models/qwen4_exp/nvidia/ple_layer.py`` that upstream #54371 deleted, so
+the branch is gone from the 0.30 base and the environment switch that fed it
+(``VLLM_PLE_FP8_GLOBAL_SCALE``) is now inert.
+
+v0.30.0 selects instead in ``Qwen4ExpPLEEmbeddingMethod.from_quant_config``
+(``ngram_embedding.py:168-208``), which is stricter: it takes the FP8 path from
+``text_config.ple_embedding_dtype == "float8_e4m3fn"`` (``:174-175``), and for a
+quantization config that is neither ``Fp8Config`` nor a ModelOpt variant it
+**raises** ``NotImplementedError`` (``:186-190``). Our checkpoint is
+compressed-tensors, so without that key the model would not build at all.
+
+The first version of this file was rejected for reading a plain dict and
+never exercising the resolution chain, for naming the wrong engine prefix, and
+for conflating a dequantization check with a scale-loading check. This version
+walks the real chain --
+``Qwen4ExpConfig(**config.json)`` (``models/qwen4_exp/config.py:231``)
+-> ``get_hf_text_config()`` (``transformers_utils/config.py:1142``)
+-> ``getattr(text_config, "ple_embedding_dtype")`` as
+``ngram_embedding.py:694-699`` reads it -- and keeps the three questions apart.
+
+Fixture provenance: the published checkpoint's ``config.json``, the
+published v2.0.1 card. Excerpted verbatim for every field the
+selector or the resolver touches; ``config_groups`` keeps one representative
+group and ``ignore`` its first nine entries.
+"""
+
+import pytest
+
+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (  # noqa: E501
+    CompressedTensorsConfig,
+)
+from vllm.model_executor.layers.quantization.fp8 import Fp8Config
+from vllm.models.qwen4_exp.nvidia.ngram_embedding import (
+    Qwen4ExpPLEEmbeddingMethod,
+    Qwen4ExpPLEFp8EmbeddingMethod,
+    Qwen4ExpPLEUnquantizedEmbeddingMethod,
+)
+
+# ``ple_layer_ids = [2]`` selects the decoder layer whose ``layer_idx + 1`` is 2
+# (``nvidia/model.py:303``), i.e. zero-based layer **1** -- not layer 2. The
+# multimodal entry class wraps the text model under ``language_model``
+# (``nvidia/model.py:1111-1114``); the PLE layer prefix is ``.ple``
+# (``:309-314``), the embedding ``.ple_embedding`` (``ple_layer.py:102``) and
+# the table ``.ngram_embedding`` (``ngram_embedding.py``).
+_PLE_PREFIX_MM = "language_model.model.layers.1.ple.ple_embedding.ngram_embedding"
+_PLE_PREFIX_TEXT = "model.layers.1.ple.ple_embedding.ngram_embedding"
+
+# ---------------------------------------------------------------------------
+# Verbatim excerpt of the shipped checkpoint's config.json.
+# ---------------------------------------------------------------------------
+SHIPPED_CONFIG = {
+    "architectures": ["Qwen4ExpForConditionalGeneration"],
+    "model_type": "qwen4_exp",
+    "image_token_id": 248056,
+    "video_token_id": 248057,
+    "vision_start_token_id": 248053,
+    "vision_end_token_id": 248054,
+    "tie_word_embeddings": False,
+    "text_config": {
+        "model_type": "qwen4_exp_text",
+        # The key the whole selection now hangs on.
+        "ple_embedding_dtype": "float8_e4m3fn",
+        "ple_layer_ids": [2],
+    },
+    "quantization_config": {
+        "quant_method": "compressed-tensors",
+        "format": "pack-quantized",
+        "quantization_status": "compressed",
+        "kv_cache_scheme": None,
+        "sparsity_config": {},
+        "transform_config": {},
+        "config_groups": {
+            "group_0": {
+                "targets": ["Linear"],
+                "weights": {
+                    "num_bits": 4,
+                    "type": "int",
+                    "symmetric": True,
+                    "strategy": "group",
+                    "group_size": 128,
+                    "dynamic": False,
+                    "observer": "minmax",
+                    "observer_kwargs": {},
+                    "actorder": None,
+                    "block_structure": None,
+                },
+            },
+        },
+        # The PLE is EXCLUDED from the quantization config -- which is exactly
+        # why the type-based dispatch cannot see that the table is FP8.
+        "ignore": [
+            "lm_head",
+            "re:.*embed_tokens.*",
+            "re:.*\\.ple\\..*",
+            "re:.*visual\\..*",
+            "re:.*\\.gate$",
+            "re:.*hyper_connection.*",
+            "re:.*indexer.*",
+            "re:.*shared_expert.*",
+            "re:.*\\.self_attn\\..*",
+        ],
+    },
+}
+
+
+def _quant_config() -> CompressedTensorsConfig:
+    import copy
+
+    return CompressedTensorsConfig.from_config(
+        copy.deepcopy(SHIPPED_CONFIG["quantization_config"])
+    )
+
+
+def _resolved_text_config():
+    """Walk the real chain the engine walks, not a dict lookup.
+
+    ``ModelConfig`` stores ``get_hf_text_config(self.hf_config)``
+    (``config/model.py:641``); that calls ``PretrainedConfig.get_text_config()``
+    (``transformers_utils/config.py:1142``); ``Qwen4ExpConfig.__init__`` builds
+    the nested ``Qwen4ExpTextConfig`` from the ``text_config`` dict
+    (``models/qwen4_exp/config.py:231``).
+    """
+    import copy
+
+    from vllm.models.qwen4_exp.config import Qwen4ExpConfig
+    from vllm.transformers_utils.config import get_hf_text_config
+
+    raw = copy.deepcopy(SHIPPED_CONFIG)
+    raw.pop("architectures", None)
+    raw.pop("model_type", None)
+    return get_hf_text_config(Qwen4ExpConfig(**raw))
+
+
+def _embedding_dtype_as_the_engine_reads_it(text_config) -> str | None:
+    """``ngram_embedding.py:694-699`` -> ``getattr(config, "ple_embedding_dtype")``."""
+    return getattr(text_config, "ple_embedding_dtype", None)
+
+
+# --------------------------------------------------------------------------
+# 1. the resolution chain
+# --------------------------------------------------------------------------
+
+
+def test_the_key_survives_the_real_text_config_resolution() -> None:
+    """THE CHAIN: nested dict -> Qwen4ExpConfig -> get_hf_text_config -> getattr."""
+    text_config = _resolved_text_config()
+    assert _embedding_dtype_as_the_engine_reads_it(text_config) == "float8_e4m3fn"
+    assert list(text_config.ple_layer_ids) == [2]
+
+
+def test_a_top_level_only_key_is_lost_on_the_text_path() -> None:
+    """RESIDUAL RISK, made executable.
+
+    A checkpoint copy that carried the key at the top level of a NESTED config
+    would not be seen by ``hf_text_config``, and the same checkpoint would then
+    hit the raise. This is a known caveat of the 0.30 port.
+    It says nothing about a FLAT config, which ``Qwen4ExpConfig`` converts into
+    a text config itself -- do not generalise it.
+    """
+    import copy
+
+    from vllm.models.qwen4_exp.config import Qwen4ExpConfig
+    from vllm.transformers_utils.config import get_hf_text_config
+
+    raw = copy.deepcopy(SHIPPED_CONFIG)
+    raw.pop("architectures", None)
+    raw.pop("model_type", None)
+    raw["ple_embedding_dtype"] = raw["text_config"].pop("ple_embedding_dtype")
+    text_config = get_hf_text_config(Qwen4ExpConfig(**raw))
+    assert _embedding_dtype_as_the_engine_reads_it(text_config) is None
+
+
+# --------------------------------------------------------------------------
+# 2. the selector
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("prefix", [_PLE_PREFIX_MM, _PLE_PREFIX_TEXT])
+def test_shipped_checkpoint_selects_the_fp8_ple_method(prefix: str) -> None:
+    """THE PROPERTY: compressed-tensors + the resolved key -> FP8 PLE, no raise.
+
+    Parametrised over both prefixes because the config-key branch precedes every
+    prefix-dependent check; if that ever stops being true, this fails.
+    """
+    method = Qwen4ExpPLEEmbeddingMethod.from_quant_config(
+        _quant_config(),
+        prefix,
+        _embedding_dtype_as_the_engine_reads_it(_resolved_text_config()),
+    )
+    assert isinstance(method, Qwen4ExpPLEFp8EmbeddingMethod)
+
+
+def test_without_the_config_key_the_shipped_checkpoint_raises() -> None:
+    """FAILING CONTROL: the key is load-bearing, not decorative.
+
+    Drop it and the same checkpoint hits ``ngram_embedding.py:186-190``. If this
+    stops raising, upstream has widened the selector and the offline conclusion
+    must be re-read -- it does not mean we are safer.
+    """
+    with pytest.raises(NotImplementedError):
+        Qwen4ExpPLEEmbeddingMethod.from_quant_config(
+            _quant_config(), _PLE_PREFIX_MM, None
+        )
+
+
+def test_the_key_beats_an_otherwise_unquantized_verdict() -> None:
+    """The key short-circuits before the ignore-list check.
+
+    ``re:.*\\.ple\\..*`` puts our PLE in the ignore list. On an ``Fp8Config``
+    that resolves to the *unquantized* method -- shown here as the contrast --
+    so the key must win, or an FP8 table would be read as bf16.
+    """
+    fp8_config = Fp8Config(
+        is_checkpoint_fp8_serialized=True, ignored_layers=[_PLE_PREFIX_MM]
+    )
+    assert isinstance(
+        Qwen4ExpPLEEmbeddingMethod.from_quant_config(fp8_config, _PLE_PREFIX_MM, None),
+        Qwen4ExpPLEUnquantizedEmbeddingMethod,
+    )
+    assert isinstance(
+        Qwen4ExpPLEEmbeddingMethod.from_quant_config(
+            fp8_config, _PLE_PREFIX_MM, "float8_e4m3fn"
+        ),
+        Qwen4ExpPLEFp8EmbeddingMethod,
+    )
+
+
+# --------------------------------------------------------------------------
+# 3. the scale -- a SEPARATE question from selection
+# --------------------------------------------------------------------------
+
+
+def test_fp8_ple_method_rejects_an_unloaded_global_scale() -> None:
+    """Sentinel rejection only. This does NOT prove checkpoint scale LOADING.
+
+    ``create_fp8_scale_parameter`` fills the parameter with the float32 sentinel
+    and the weight loader is expected to overwrite it; proving that the loader
+    does so needs a checkpoint shard, which belongs to a reference-host loader test,
+    not here.
+    """
+    import torch
+    from torch import nn
+
+    method = Qwen4ExpPLEFp8EmbeddingMethod()
+    unloaded = nn.Module()
+    unloaded.weight_scale = nn.Parameter(
+        torch.full((1,), torch.finfo(torch.float32).min, dtype=torch.float32),
+        requires_grad=False,
+    )
+    with pytest.raises(ValueError, match="missing its global scale"):
+        method.process_weights_after_loading(unloaded)
+
+
+def test_fp8_ple_dequantization_applies_the_scale() -> None:
+    """Dequantization arithmetic only, with a hand-set scale. Not loading."""
+    import torch
+    from torch import nn
+
+    method = Qwen4ExpPLEFp8EmbeddingMethod()
+    loaded = nn.Module()
+    loaded.weight_scale = nn.Parameter(
+        torch.tensor([0.25], dtype=torch.float32), requires_grad=False
+    )
+    method.process_weights_after_loading(loaded)  # must not raise
+
+    embeddings = torch.tensor([[1.0, 2.0]], dtype=torch.float32)
+    torch.testing.assert_close(
+        method.dequantize(loaded, embeddings, torch.float32), embeddings * 0.25
+    )
