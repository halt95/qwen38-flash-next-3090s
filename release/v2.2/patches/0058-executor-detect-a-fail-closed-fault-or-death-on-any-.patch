+            pid = getattr(proc, "pid", None)
+            if pidfd_open is not None and pid is not None:
+                try:
+                    pidfd = pidfd_open(pid)
+                except OSError:
+                    # ESRCH (already reaped) or no pidfd support: the sentinel.
+                    pidfd = None
+            try:
+                waitable = pidfd if pidfd is not None else proc.sentinel
+                waitables.append((waitable, proc, pidfd))
+            except BaseException:
+                # Not yet in `waitables`: the outer handler would miss it.
+                if pidfd is not None:
+                    os.close(pidfd)
+                raise
