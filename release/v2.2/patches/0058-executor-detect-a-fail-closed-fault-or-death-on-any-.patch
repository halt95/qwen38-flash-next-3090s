diff --git a/tests/v1/executor/test_multiproc_fatal_any_rank.py b/tests/v1/executor/test_multiproc_fatal_any_rank.py
new file mode 100644
index 0000000000..bf1a0ff99f
--- /dev/null
+++ b/tests/v1/executor/test_multiproc_fatal_any_rank.py
@@ -0,0 +1,343 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A fail-closed fault on ANY rank reaches the executor before the process is gone.
+
+Rank-1 fault test (earlier build, TP2xPP2): the PLE
+test fault cut=exc_in_release fired on PP0_TP1 (rank 1). ple_fail_closed wrote
+its line and traceback and os._exit(1)ed. The engine then sat in
+mq.dequeue for 300 s ("No available shared memory broadcast block found in 60
+seconds" x4) and was killed by the harness; "Worker proc ... died
+unexpectedly" never appeared. The rank showed Z in ps but was never reaped.
+
+The executor's monitor (start_worker_monitor, stock upstream code) waits on
+the workers' process sentinels only. A sentinel closes when the kernel has
+torn down the WHOLE thread group -- for a worker holding a CUDA context that
+is seconds after os._exit (F1/F2/F3/F5 on rank 0 in the same series: 8.0 s
+between the fatal line and the monitor's log line), and when a thread of the
+dying rank waits in-kernel on a live peer it does not close while the peer
+lives. The fault test's rank 1 became reapable only after rank 0's own 300 s progress
+deadline killed rank 0 (rank 3's gloo recv from rank 1 broke at +2.0 s,
+two seconds after rank 0's fatal at +0.0 s). The same leader-Z /
+thread-in-exit state was sampled on the reference host for the PLE offload child
+(test_multiproc_ple_exit_without_reap.py).
+
+The fix: a per-worker fault pipe. ple_fail_closed writes one byte on it
+right before os._exit; the monitor waits on it next to the sentinels and
+starts the failure ladder at once, which ends the peers -- and that is what
+frees the stuck teardown.
+
+The stuck-teardown state is modelled here without a GPU: the worker's leader
+thread leaves alone (raw SYS_exit) while another thread keeps the thread
+group alive, so its sentinel stays open and it is not reapable -- exactly
+what the executor saw in the rank-1 fault test.
+
+Failing controls on the earlier build: test_fatal_on_any_rank_wakes_the_
+monitor_before_its_teardown (the monitor stays blocked) and
+test_worker_main_registers_the_fault_pipe (nothing registers it).
+"""
+
+import ctypes
+import multiprocessing
+import os
+import platform
+import signal
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+pytestmark = [
+    pytest.mark.skip_global_cleanup,
+    pytest.mark.skipif(
+        sys.platform != "linux" or platform.machine() not in ("x86_64", "aarch64"),
+        reason="needs Linux process sentinels and a raw SYS_exit number",
+    ),
+]
+
+_SYS_EXIT = {"x86_64": 60, "aarch64": 93}.get(platform.machine(), -1)
+_LINGER_S = 30.0
+_MONITOR_WAIT_S = 5.0
+
+
+def _leader_exit(code: int) -> None:
+    """Only the calling thread leaves; the thread group (and its fds) stay."""
+    ctypes.CDLL(None).syscall(_SYS_EXIT, code)
+
+
+def _worker(mode: str, fault_pipe, linger_s: float) -> None:
+    from vllm.v1.ple_offload import fatal
+
+    # Absent on the earlier build: that is the failing control, not an error.
+    register = getattr(fatal, "set_fatal_notify_fd", None)
+    if register is not None and fault_pipe is not None:
+        register(fault_pipe.fileno())
+    if mode == "idle":
+        time.sleep(600)
+    # Non-daemon: keeps the thread group alive after the leader leaves.
+    threading.Thread(target=time.sleep, args=(linger_s,)).start()
+    if mode == "fatal-stuck":
+        # ple_fail_closed ends with os._exit(1); here that exit is the
+        # leader-only one, so the process stays unreapable like the fault test's rank 1.
+        os._exit = _leader_exit  # type: ignore[assignment]
+        fatal.ple_fail_closed(
+            where="release_outputs",
+            rank=1,
+            layer="language_model.model.layers.1.ple.ple_embedding",
+            sequence=52,
+            error=RuntimeError("PLE test fault: exc_in_release"),
+        )
+    if mode == "orderly-close":
+        fault_pipe.close()
+        time.sleep(linger_s)
+    os._exit(1 if mode == "crash" else 0)
+
+
+class _Executor:
+    """The surface start_worker_monitor's closure uses."""
+
+    def __init__(self, workers):
+        self.workers = workers
+        self.is_failed = False
+        self.shutting_down = False
+        self.shutdown_calls = 0
+        self.callback_calls = 0
+        self.failure_callback = self._callback
+
+    def _callback(self):
+        self.callback_calls += 1
+
+    def shutdown(self):
+        self.shutdown_calls += 1
+
+
+def _spawn(mode: str, rank: int, linger_s: float = _LINGER_S):
+    ctx = multiprocessing.get_context("spawn")
+    fault_reader, fault_writer = ctx.Pipe(duplex=False)
+    proc = ctx.Process(
+        target=_worker,
+        args=(mode, fault_writer, linger_s),
+        name=f"VllmWorker-{rank}",
+        daemon=True,
+    )
+    proc.start()
+    fault_writer.close()
+    return SimpleNamespace(
+        proc=proc,
+        rank=rank,
+        fault_reader=fault_reader,
+        death_writer=None,
+        worker_response_mq=None,
+        shutdown_state=None,
+    )
+
+
+def _start_monitor(executor) -> threading.Thread:
+    from vllm.v1.executor.multiproc_executor import MultiprocExecutor
+
+    thread = threading.Thread(
+        target=MultiprocExecutor.start_worker_monitor,
+        args=(executor,),
+        kwargs={"inline": True},
+        daemon=True,
+        name="MultiprocWorkerMonitor-test",
+    )
+    thread.start()
+    return thread
+
+
+@pytest.fixture
+def workers():
+    spawned = []
+    yield spawned
+    for w in spawned:
+        # SIGKILL ends the lingering thread too; then the group is reapable.
+        if w.proc.is_alive():
+            os.kill(w.proc.pid, signal.SIGKILL)
+        w.proc.join(10)
+        w.fault_reader.close()
+
+
+def test_fatal_on_any_rank_wakes_the_monitor_before_its_teardown(workers):
+    """Rank-1 fault: rank 1 fails closed, stays unreapable; the monitor must not wait."""
+    workers.append(_spawn("idle", 0))
+    workers.append(_spawn("fatal-stuck", 1))
+    executor = _Executor(workers)
+    thread = _start_monitor(executor)
+    thread.join(_MONITOR_WAIT_S)
+    assert not thread.is_alive(), (
+        f"monitor still blocked {_MONITOR_WAIT_S} s after a fail-closed fault on "
+        "rank 1 whose process teardown has not finished (leader gone, thread "
+        "group alive, sentinel open): this is the rank-1 fault hang"
+    )
+    # It returned while the rank was still not reapable -- the point.
+    assert workers[1].proc.is_alive()
+    assert executor.is_failed
+    assert executor.shutdown_calls == 1
+    assert executor.callback_calls == 1
+    assert executor.failure_callback is None
+
+
+def test_plain_death_is_still_detected_by_the_sentinel(workers):
+    workers.append(_spawn("idle", 0))
+    workers.append(_spawn("crash", 1, linger_s=0.0))
+    executor = _Executor(workers)
+    thread = _start_monitor(executor)
+    thread.join(_MONITOR_WAIT_S)
+    assert not thread.is_alive()
+    assert executor.is_failed
+    assert executor.shutdown_calls == 1
+    assert workers[1].proc.exitcode == 1
+
+
+def test_orderly_close_of_the_fault_pipe_is_not_a_fault(workers):
+    """EOF on the fault pipe (worker_main's finally) must not start the ladder."""
+    orderly_s = 1.5
+    workers.append(_spawn("orderly-close", 0, linger_s=orderly_s))
+    workers.append(_spawn("idle", 1))
+    executor = _Executor(workers)
+    thread = _start_monitor(executor)
+    thread.join(orderly_s / 2)
+    assert thread.is_alive(), "monitor treated the closed fault pipe as a fault"
+    assert executor.shutdown_calls == 0
+    thread.join(_MONITOR_WAIT_S)
+    assert not thread.is_alive(), "sentinel death not seen after the fault-pipe EOF"
+    assert executor.is_failed
+    assert workers[0].proc.exitcode == 0
+
+
+def test_worker_main_registers_the_fault_pipe(monkeypatch):
+    """worker_main hands the fault pipe to the fatal module, and unregisters it."""
+    import vllm.v1.executor.multiproc_executor as executor_module
+    from vllm.v1.ple_offload import fatal
+
+    seen = {}
+
+    class _Inner:
+        def shutdown(self):
+            pass
+
+    def fake_init(self, *args, **kwargs):
+        self.rank = 1
+        self.worker = _Inner()
+        self.rpc_broadcast_mq = None
+        self.worker_response_mq = SimpleNamespace(
+            export_handle=lambda: None,
+            wait_until_ready=lambda: None,
+            shutdown=lambda: None,
+        )
+        self.peer_response_handles = []
+
+    def busy_loop(self):
+        seen["registered_fd"] = getattr(fatal, "_FATAL_NOTIFY_FD", None)
+        raise ValueError("boom")
+
+    monkeypatch.setattr(executor_module.WorkerProc, "__init__", fake_init)
+    monkeypatch.setattr(executor_module.WorkerProc, "worker_busy_loop", busy_loop)
+    monkeypatch.setattr(executor_module, "destroy_model_parallel", lambda: None)
+    monkeypatch.setattr(
+        executor_module, "destroy_distributed_environment", lambda: None
+    )
+    monkeypatch.setattr(executor_module, "maybe_init_worker_tracer", lambda **k: None)
+    monkeypatch.setattr(executor_module, "set_worker_net_device", lambda *a, **k: None)
+    monkeypatch.setattr(
+        executor_module, "_install_worker_parent_death_signal", lambda pid: None
+    )
+    monkeypatch.setattr(executor_module.signal, "signal", lambda *a, **k: None)
+    ready_reader, ready_writer = multiprocessing.Pipe(duplex=False)
+    fault_reader, fault_writer = multiprocessing.Pipe(duplex=False)
+    fault_fd = fault_writer.fileno()
+    # An unexpected busy-loop failure ends in exit code 1 after the teardown
+    # (any-rank fix).
+    with pytest.raises(SystemExit) as exited:
+        executor_module.WorkerProc.worker_main(
+            vllm_config=SimpleNamespace(
+                parallel_config=SimpleNamespace(
+                    assigned_physical_gpu_ids=None, numa_bind=False
+                )
+            ),
+            ready_pipe=ready_writer,
+            death_pipe=None,
+            fault_pipe=fault_writer,
+            shutdown_state=None,
+            inherited_fds=[],
+            expected_parent_pid=os.getpid(),
+        )
+    assert exited.value.code == 1
+    ready_reader.close()
+    assert seen.get("registered_fd") == fault_fd, seen
+    assert getattr(fatal, "_FATAL_NOTIFY_FD", "unset") is None
+    # Closed on the way out: EOF, which the monitor does not count as a fault.
+    assert fault_reader.poll(1.0), "worker_main left its fault pipe open"
+    with pytest.raises(EOFError):
+        fault_reader.recv_bytes()
+    fault_reader.close()
+
+
+def test_fail_closed_during_teardown_still_sends_the_fault_byte(monkeypatch):
+    """The fault fd stays registered through worker teardown.
+
+    worker_main's finally unregistered and closed the fault pipe BEFORE
+    worker.shutdown(); a PLE fail-closed inside that teardown (the drain waits
+    on the PLE transport) could not send its byte and the hang window reopened.
+    """
+    import vllm.v1.executor.multiproc_executor as executor_module
+    from vllm.v1.ple_offload import fatal
+
+    class _Inner:
+        def shutdown(self):
+            # ple_fail_closed's notify, from inside the teardown.
+            fatal.notify_parent_fatal()
+
+    def fake_init(self, *args, **kwargs):
+        self.rank = 1
+        self.worker = _Inner()
+        self.rpc_broadcast_mq = None
+        self.worker_response_mq = SimpleNamespace(
+            export_handle=lambda: None,
+            wait_until_ready=lambda: None,
+            shutdown=lambda: None,
+        )
+        self.peer_response_handles = []
+
+    def busy_loop(self):
+        raise ValueError("boom")
+
+    monkeypatch.setattr(executor_module.WorkerProc, "__init__", fake_init)
+    monkeypatch.setattr(executor_module.WorkerProc, "worker_busy_loop", busy_loop)
+    monkeypatch.setattr(executor_module, "destroy_model_parallel", lambda: None)
+    monkeypatch.setattr(
+        executor_module, "destroy_distributed_environment", lambda: None
+    )
+    monkeypatch.setattr(executor_module, "maybe_init_worker_tracer", lambda **k: None)
+    monkeypatch.setattr(executor_module, "set_worker_net_device", lambda *a, **k: None)
+    monkeypatch.setattr(
+        executor_module, "_install_worker_parent_death_signal", lambda pid: None
+    )
+    monkeypatch.setattr(executor_module.signal, "signal", lambda *a, **k: None)
+    ready_reader, ready_writer = multiprocessing.Pipe(duplex=False)
+    fault_reader, fault_writer = multiprocessing.Pipe(duplex=False)
+    with pytest.raises(SystemExit):
+        executor_module.WorkerProc.worker_main(
+            vllm_config=SimpleNamespace(
+                parallel_config=SimpleNamespace(
+                    assigned_physical_gpu_ids=None, numa_bind=False
+                )
+            ),
+            ready_pipe=ready_writer,
+            death_pipe=None,
+            fault_pipe=fault_writer,
+            shutdown_state=None,
+            inherited_fds=[],
+            expected_parent_pid=os.getpid(),
+        )
+    ready_reader.close()
+    assert fault_reader.poll(1.0), "no byte and no EOF on the fault pipe"
+    data = os.read(fault_reader.fileno(), 1)
+    fault_reader.close()
+    assert data == b"F", (
+        f"a fail-closed inside worker teardown sent {data!r}: the fault fd was "
+        "already unregistered/closed"
+    )
+    assert getattr(fatal, "_FATAL_NOTIFY_FD", "unset") is None
