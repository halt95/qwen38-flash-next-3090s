@@ -0,0 +1,226 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The worker monitor must see ANY rank's exit, even with an fd inheritor.
+
+The rank-1 fault test (an earlier build): the PLE fault killed PP0_TP1 (rank 1) in
+release_outputs. The worker sat as a zombie, GPU 1 emptied, but the executor
+never logged "died unexpectedly" and EngineCore hung in the RPC broadcast
+("No available shared memory broadcast block"). The monitor waited on
+proc.sentinel, a pipe whose write end the worker holds -- and the worker's
+torch_shm_manager child (started by the PLE host-buffer registration under the
+"file_system" sharing strategy) inherited that write end and outlived it,
+kept alive by rank 0's PLE child mapping rank 1's buffers. Rank-0 faults only
+looked detected because rank 0's death took the PLE child, and so the
+managers, down with it.
+
+The inheritor here is a forked grandchild that sleeps; it holds every fd the
+worker had, the sentinel's write end included.
+"""
+
+import contextlib
+import inspect
+import multiprocessing
+import os
+import signal
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+pytestmark = [
+    pytest.mark.skip_global_cleanup,
+    pytest.mark.skipif(sys.platform != "linux", reason="fork + pidfd"),
+]
+
+# A healthy worker detects a death within this bound on the earlier build's rank-0 path
+# (sentinel fires at exit); a pidfd fires at the exit itself.
+_DETECT_BOUND_S = 5.0
+_INHERITOR_LIFETIME_S = 60.0
+
+
+def _healthy_worker():
+    time.sleep(600)
+
+
+def _dying_worker(inheritor_pid, spawn_inheritor):
+    if spawn_inheritor:
+        pid = os.fork()
+        if pid == 0:
+            # Stand-in for torch_shm_manager: holds the inherited fds.
+            time.sleep(_INHERITOR_LIFETIME_S)
+            os._exit(0)
+        inheritor_pid.value = pid
+    time.sleep(0.5)
+    # Stand-in for ple_fail_closed: no cleanup, straight out.
+    os._exit(1)
+
+
+def _executor(procs):
+    from vllm.v1.executor.multiproc_executor import MultiprocExecutor
+
+    executor = object.__new__(MultiprocExecutor)
+    executor.workers = [
+        SimpleNamespace(
+            proc=p,
+            rank=rank,
+            death_writer=None,
+            worker_response_mq=None,
+            shutdown_state=None,
+        )
+        for rank, p in enumerate(procs)
+    ]
+    executor.is_failed = False
+    executor.rpc_broadcast_mq = None
+    executor.response_mqs = []
+    failed = threading.Event()
+    executor.failure_callback = failed.set
+    return executor, failed
+
+
+@pytest.mark.parametrize("spawn_inheritor", [False, True])
+@pytest.mark.parametrize("dying_rank", [0, 1])
+def test_worker_exit_detected_on_any_rank(dying_rank, spawn_inheritor):
+    ctx = multiprocessing.get_context("fork")
+    inheritor_pid = ctx.Value("i", 0)
+    procs = []
+    for rank in range(2):
+        if rank == dying_rank:
+            proc = ctx.Process(
+                target=_dying_worker,
+                args=(inheritor_pid, spawn_inheritor),
+                name=f"VllmWorker-{rank}",
+                daemon=True,
+            )
+        else:
+            proc = ctx.Process(
+                target=_healthy_worker, name=f"VllmWorker-{rank}", daemon=True
+            )
+        proc.start()
+        procs.append(proc)
+
+    executor, failed = _executor(procs)
+    try:
+        start = time.monotonic()
+        executor.start_worker_monitor()
+        detected = failed.wait(_DETECT_BOUND_S + 5.0)
+        elapsed = time.monotonic() - start
+        assert detected, (
+            f"rank {dying_rank} exited (inheritor={spawn_inheritor}) but the "
+            f"monitor never reported it within {_DETECT_BOUND_S + 5.0:.0f} s; "
+            f"dying proc alive per waitpid: {procs[dying_rank].is_alive()}"
+        )
+        assert elapsed <= _DETECT_BOUND_S, elapsed
+        assert executor.is_failed
+        assert procs[dying_rank].exitcode == 1
+        # The failure ladder ended the healthy survivor too.
+        assert not any(p.is_alive() for p in procs)
+    finally:
+        for p in procs:
+            if p.is_alive():
+                p.kill()
+            p.join(timeout=5)
+        if inheritor_pid.value:
+            with contextlib.suppress(ProcessLookupError):
+                os.kill(inheritor_pid.value, signal.SIGKILL)
+
+
+def test_exit_waitables_close_opened_pidfds_when_a_later_proc_fails(monkeypatch):
+    """_worker_exit_waitables is exception-safe."""
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    opened: list[int] = []
+    real_open = os.pidfd_open
+
+    def recording_open(pid):
+        fd = real_open(pid)
+        opened.append(fd)
+        return fd
+
+    class _Broken:
+        pid = None  # no pidfd: falls back to the sentinel, which raises
+
+        @property
+        def sentinel(self):
+            raise ValueError("process not started")
+
+    class _Self:
+        pid = os.getpid()
+        sentinel = -1
+
+    monkeypatch.setattr(executor_module.os, "pidfd_open", recording_open)
+    with pytest.raises(ValueError):
+        executor_module._worker_exit_waitables([_Self(), _Self(), _Broken()])
+    assert len(opened) == 2, opened
+    leaked = []
+    for fd in opened:
+        try:
+            os.fstat(fd)
+            leaked.append(fd)
+        except OSError:
+            pass
+    for fd in leaked:
+        os.close(fd)
+    assert not leaked, f"pidfds left open after the failure: {leaked}"
+
+
+def test_exit_waitables_close_the_pidfd_of_the_failing_iteration(monkeypatch):
+    """A failure between opening a pidfd and recording it.
+
+    An exception is injected (via a trace function) on the line that records
+    the (waitable, proc, pidfd) tuple, after the pidfd for that proc was
+    opened; that pidfd must be closed too, not only the earlier ones.
+    """
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    opened: list[int] = []
+    real_open = os.pidfd_open
+
+    def recording_open(pid):
+        fd = real_open(pid)
+        opened.append(fd)
+        return fd
+
+    class _Self:
+        pid = os.getpid()
+        sentinel = -1
+
+    monkeypatch.setattr(executor_module.os, "pidfd_open", recording_open)
+    code = executor_module._worker_exit_waitables.__code__
+    append_lines = {
+        code.co_firstlineno + i
+        for i, line in enumerate(
+            inspect.getsource(executor_module._worker_exit_waitables).splitlines()
+        )
+        if "waitables.append(" in line
+    }
+    assert len(append_lines) == 1, append_lines
+
+    class _Injected(Exception):
+        pass
+
+    def tracer(frame, event, arg):
+        if frame.f_code is not code:
+            return None
+
+        def local(frame, event, arg):
+            if event == "line" and frame.f_lineno in append_lines and opened:
+                raise _Injected
+            return local
+
+        return local
+
+    sys.settrace(tracer)
+    try:
+        with pytest.raises(_Injected):
+            executor_module._worker_exit_waitables([_Self()])
+    finally:
+        sys.settrace(None)
+    assert len(opened) == 1, opened
+    try:
+        os.fstat(opened[0])
+    except OSError:
+        return
+    os.close(opened[0])
+    pytest.fail("the pidfd opened in the failing iteration was left open")
