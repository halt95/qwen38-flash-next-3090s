@@ -0,0 +1,355 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pre-READY worker death, and the inherited-pipe leak behind the rank-1 fault hang.
+
+The rank-1 fault test: a PLE-owning worker's torch_shm_manager child (fork and
+program load, from the PLE host-buffer registration) inherited the worker's
+end of the sentinel pipe and outlived it, so the executor never saw rank 1
+die. The same inheritance covers the READY pipe: a worker dying between the
+registration and READY left WorkerProc.wait_for_ready waiting for an EOF that
+never came.
+"""
+
+import contextlib
+import multiprocessing
+import multiprocessing.connection
+import os
+import signal
+import subprocess
+import sys
+import threading
+import time
+
+import pytest
+
+pytestmark = [
+    pytest.mark.skip_global_cleanup,
+    pytest.mark.skipif(sys.platform != "linux", reason="fork + pidfd"),
+]
+
+_BOUND_S = 5.0
+
+
+def _die_before_ready(inheritor_pid):
+    # Stand-in for torch_shm_manager: a forked child holding every fd,
+    # the READY pipe's write end included.
+    pid = os.fork()
+    if pid == 0:
+        time.sleep(60)
+        os._exit(0)
+    inheritor_pid.value = pid
+    time.sleep(0.3)
+    os._exit(1)  # died during init, READY never sent
+
+
+def test_wait_for_ready_sees_a_worker_die_before_ready():
+    from vllm.v1.executor.multiproc_executor import (
+        UnreadyWorkerProcHandle,
+        WorkerProc,
+    )
+
+    ctx = multiprocessing.get_context("fork")
+    inheritor_pid = ctx.Value("i", 0)
+    ready_reader, ready_writer = ctx.Pipe(duplex=False)
+    proc = ctx.Process(
+        target=_die_before_ready, args=(inheritor_pid,), name="VllmWorker-1"
+    )
+    proc.start()
+    ready_writer.close()
+    handle = UnreadyWorkerProcHandle(proc, 1, ready_reader)
+
+    outcome: dict = {}
+
+    def run():
+        try:
+            WorkerProc.wait_for_ready([handle])
+            outcome["result"] = "returned"
+        except BaseException as exc:  # noqa: BLE001
+            outcome["result"] = exc
+
+    waiter = threading.Thread(target=run, daemon=True)
+    try:
+        start = time.monotonic()
+        waiter.start()
+        waiter.join(_BOUND_S + 5.0)
+        elapsed = time.monotonic() - start
+        assert not waiter.is_alive(), (
+            "wait_for_ready still waiting for READY from a worker that exited "
+            f"{elapsed:.1f} s ago (an inheritor holds the pipe's write end)"
+        )
+        assert isinstance(outcome.get("result"), Exception), outcome
+        assert "initialization failed" in str(outcome["result"])
+        assert elapsed <= _BOUND_S, elapsed
+    finally:
+        if inheritor_pid.value:
+            with contextlib.suppress(ProcessLookupError):
+                os.kill(inheritor_pid.value, signal.SIGKILL)
+        waiter.join(10)
+        proc.join(5)
+
+
+def _spawned_worker_starts_a_helper(helper_pid):
+    from vllm.v1.executor import multiproc_executor
+
+    # The worker_main step under test; absent on unfixed code.
+    guard = getattr(
+        multiproc_executor, "_make_inherited_pipes_close_on_exec", lambda: None
+    )
+    guard()
+    # Stand-in for torch_shm_manager: a helper program started with no fd
+    # closing, as libshm does. It outlives every bound below (killed in the
+    # test's cleanup), so a fired sentinel cannot be the helper's own exit.
+    helper = subprocess.Popen(["sleep", "3600"], close_fds=False)
+    helper_pid.value = helper.pid
+    os._exit(1)
+
+
+def _proc_state(pid):
+    """/proc/<pid>/stat state letter, or None if the pid is gone."""
+    try:
+        with open(f"/proc/{pid}/stat") as f:
+            stat = f.read()
+    except OSError:
+        return None
+    return stat[stat.rindex(")") + 2 :].split()[0]
+
+
+def _running(pid):
+    state = _proc_state(pid)
+    return state is not None and state not in ("Z", "X")
+
+
+def test_running_check_rejects_a_zombie():
+    """os.kill(pid, 0) cannot tell a zombie from a live process; _running can."""
+    pid = os.fork()
+    if pid == 0:
+        os._exit(0)
+    try:
+        deadline = time.monotonic() + 5
+        while _proc_state(pid) != "Z" and time.monotonic() < deadline:
+            time.sleep(0.01)
+        assert _proc_state(pid) == "Z"
+        os.kill(pid, 0)  # succeeds on the zombie: the old check passed here
+        assert not _running(pid)
+    finally:
+        os.waitpid(pid, 0)
+    assert _running(os.getpid())
+
+
+# The worker exits right after publishing the helper's pid; its sentinel must
+# fire within this bound while the helper is provably still alive.
+_SENTINEL_BOUND_S = 2.0
+
+
+def test_started_helper_does_not_inherit_the_sentinel():
+    ctx = multiprocessing.get_context("spawn")
+    helper_pid = ctx.Value("i", 0)
+    proc = ctx.Process(
+        target=_spawned_worker_starts_a_helper, args=(helper_pid,), daemon=True
+    )
+    proc.start()
+    try:
+        # Spawn + import can take a while; the bound starts at the helper's
+        # start (the worker exits right after it).
+        deadline = time.monotonic() + 120
+        while not helper_pid.value and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert helper_pid.value, "the helper never started"
+        fired = multiprocessing.connection.wait(
+            [proc.sentinel], timeout=_SENTINEL_BOUND_S
+        )
+        # The helper must still be RUNNING (not gone, and not a zombie --
+        # os.kill(pid, 0) succeeds on a zombie too).
+        assert _running(helper_pid.value), (
+            f"helper {helper_pid.value} is not running: "
+            f"state={_proc_state(helper_pid.value)}"
+        )
+        assert fired, (
+            f"the worker exited but its sentinel did not fire within "
+            f"{_SENTINEL_BOUND_S} s while the helper it started is alive: the "
+            "helper inherited the sentinel pipe's write end"
+        )
+        proc.join(5)
+        assert proc.exitcode == 1
+    finally:
+        if proc.is_alive():
+            proc.kill()
+        if helper_pid.value:
+            with contextlib.suppress(ProcessLookupError):
+                os.kill(helper_pid.value, signal.SIGKILL)
+
+
+def test_guard_marks_inherited_pipes_only():
+    from vllm.v1.executor import multiproc_executor
+
+    guard = multiproc_executor._make_inherited_pipes_close_on_exec
+    stdio = {}
+    for fd in (0, 1, 2):
+        with contextlib.suppress(OSError):
+            stdio[fd] = os.get_inheritable(fd)
+    reader, writer = os.pipe()
+    try:
+        os.set_inheritable(reader, True)
+        os.set_inheritable(writer, True)
+        guard()
+        assert not os.get_inheritable(reader)
+        assert not os.get_inheritable(writer)
+        for fd, before in stdio.items():
+            assert os.get_inheritable(fd) == before, fd
+    finally:
+        os.close(reader)
+        os.close(writer)
+
+
+# ---- Pre-READY waiting keeps the sentinel fallback and the fault pipe
+
+_PRE_READY_BOUND_S = 3.0
+
+
+def _exits_with_ready_writer_held_by_a_helper(ready_writer, helper_pid):
+    # A helper program inherits ONLY the READY pipe's write end (fork's
+    # sentinel end is close-on-exec), so the READY pipe never EOFs while the
+    # sentinel does fire at the exit.
+    helper = subprocess.Popen(["sleep", "60"], pass_fds=(ready_writer.fileno(),))
+    helper_pid.value = helper.pid
+    os._exit(1)
+
+
+def _fault_byte_before_ready(fault_writer):
+    # ple_fail_closed's notify during init; the process then stays alive
+    # (its teardown is pinned), so no exit signal fires either.
+    os.write(fault_writer.fileno(), b"F")
+    time.sleep(60)
+
+
+def _wait_for_ready_in_thread(handles):
+    from vllm.v1.executor.multiproc_executor import WorkerProc
+
+    outcome: dict = {}
+
+    def run():
+        try:
+            WorkerProc.wait_for_ready(handles)
+            outcome["result"] = "returned"
+        except BaseException as exc:  # noqa: BLE001
+            outcome["result"] = exc
+
+    waiter = threading.Thread(target=run, daemon=True)
+    start = time.monotonic()
+    waiter.start()
+    waiter.join(_PRE_READY_BOUND_S)
+    return waiter, outcome, time.monotonic() - start
+
+
+def test_pre_ready_death_is_seen_by_the_sentinel_when_no_pidfd(monkeypatch):
+    import vllm.v1.executor.multiproc_executor as executor_module
+    from vllm.v1.executor.multiproc_executor import UnreadyWorkerProcHandle
+
+    def no_pidfd(pid):
+        raise OSError(38, "pidfd_open unavailable")
+
+    monkeypatch.setattr(executor_module.os, "pidfd_open", no_pidfd, raising=False)
+    ctx = multiprocessing.get_context("fork")
+    helper_pid = ctx.Value("i", 0)
+    ready_reader, ready_writer = ctx.Pipe(duplex=False)
+    proc = ctx.Process(
+        target=_exits_with_ready_writer_held_by_a_helper,
+        args=(ready_writer, helper_pid),
+        name="VllmWorker-1",
+    )
+    proc.start()
+    ready_writer.close()
+    handle = UnreadyWorkerProcHandle(proc, 1, ready_reader)
+    try:
+        waiter, outcome, elapsed = _wait_for_ready_in_thread([handle])
+        assert not waiter.is_alive(), (
+            f"no pidfd: wait_for_ready dropped the sentinel fallback and is "
+            f"still waiting {elapsed:.1f} s after the worker exited"
+        )
+        assert isinstance(outcome.get("result"), Exception), outcome
+    finally:
+        if helper_pid.value:
+            with contextlib.suppress(ProcessLookupError):
+                os.kill(helper_pid.value, signal.SIGKILL)
+        proc.join(5)
+
+
