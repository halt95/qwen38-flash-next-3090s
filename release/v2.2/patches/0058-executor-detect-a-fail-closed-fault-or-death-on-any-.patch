+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The worker monitor's two wake sources together: fault byte + process exit.
+
+The rank-1 fault hang had two root causes. First fix: the sentinel's
+write end was inherited by the worker's torch_shm_manager child, so the exit
+never showed on it (fix: wait on a pidfd). Second fix: the dying
+rank's kernel teardown waits on a live peer, so no exit-based signal fires
+(fix: the fail-closed path writes one byte on a fault pipe before os._exit).
+The merged monitor must take whichever arrives first and must not count a
+fault pipe's EOF as a fault. Each case below fails on one of the two parents.
+"""
+
+import contextlib
+import multiprocessing
+import os
+import signal
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+pytestmark = [
+    pytest.mark.skip_global_cleanup,
+    pytest.mark.skipif(sys.platform != "linux", reason="fork + pidfd"),
+]
+
+_BOUND_S = 2.0
+
+
+def _healthy(fault_writer):
+    time.sleep(600)
+
+
+def _fault_byte_then_stuck(fault_writer):
+    # ple_fail_closed's notify, then a teardown that does not finish (the
+    # process stays alive, so neither its pidfd nor its sentinel fires).
+    os.write(fault_writer.fileno(), b"F")
+    time.sleep(600)
+
+
+def _silent_death_with_inheritor(fault_writer, inheritor_pid):
+    # A non-fail-closed death (no byte) whose fd-holding grandchild keeps the
+    # sentinel AND the fault pipe's write end open (no EOF either).
+    pid = os.fork()
+    if pid == 0:
+        time.sleep(60)
+        os._exit(0)
+    inheritor_pid.value = pid
+    time.sleep(0.3)
+    os._exit(1)
+
+
+def _orderly_eof_then_exit(fault_writer):
+    # worker_main's finally closes the fault pipe (EOF, no byte) and the
+    # process exits: a death, not a reported fault.
+    fault_writer.close()
+    time.sleep(0.3)
+    os._exit(0)
+
+
+def _run(dying_target, extra_args=()):
+    import vllm.v1.executor.multiproc_executor as executor_module
+    from vllm.v1.executor.multiproc_executor import MultiprocExecutor
+
+    ctx = multiprocessing.get_context("fork")
+    procs, handles = [], []
+    for rank in range(2):
+        fault_reader, fault_writer = ctx.Pipe(duplex=False)
+        target = dying_target if rank == 1 else _healthy
+        args = (fault_writer, *extra_args) if rank == 1 else (fault_writer,)
+        proc = ctx.Process(
+            target=target, args=args, name=f"VllmWorker-{rank}", daemon=True
+        )
+        proc.start()
+        fault_writer.close()
+        procs.append(proc)
+        handles.append(
+            SimpleNamespace(
+                proc=proc,
+                rank=rank,
+                death_writer=None,
+                worker_response_mq=None,
+                shutdown_state=None,
+                fault_reader=fault_reader,
+            )
+        )
+    executor = object.__new__(MultiprocExecutor)
+    executor.workers = handles
+    executor.is_failed = False
+    executor.rpc_broadcast_mq = None
+    executor.response_mqs = []
+    failed = threading.Event()
+    executor.failure_callback = failed.set
+
+    messages: list[str] = []
+    real_error = executor_module.logger.error
+
+    def capture(msg, *args, **kwargs):
+        messages.append(msg % args if args else msg)
+        return real_error(msg, *args, **kwargs)
+
+    executor_module.logger.error = capture
+    try:
+        start = time.monotonic()
+        executor.start_worker_monitor()
+        detected = failed.wait(_BOUND_S + 8.0)
+        elapsed = time.monotonic() - start
+    finally:
+        executor_module.logger.error = real_error
+        for p in procs:
+            if p.is_alive():
+                p.kill()
+            p.join(5)
+    return detected, elapsed, messages
+
+
+def test_fault_byte_wins_while_the_process_is_still_alive():
+    detected, elapsed, messages = _run(_fault_byte_then_stuck)
+    assert detected, "fault byte written, process alive: monitor never woke"
+    assert elapsed <= _BOUND_S, elapsed
+    assert any("VllmWorker-1 reported a fatal fault" in m for m in messages), messages
+
+
+def test_silent_death_with_an_fd_inheritor_is_seen_by_its_exit():
+    inheritor_pid = multiprocessing.get_context("fork").Value("i", 0)
+    try:
+        detected, elapsed, messages = _run(
+            _silent_death_with_inheritor, (inheritor_pid,)
+        )
+    finally:
+        if inheritor_pid.value:
+            with contextlib.suppress(ProcessLookupError):
+                os.kill(inheritor_pid.value, signal.SIGKILL)
+    assert detected, "worker exited (no fault byte, inherited fds): not seen"
+    assert elapsed <= _BOUND_S + 1.0, elapsed
+    assert any("VllmWorker-1 died unexpectedly" in m for m in messages), messages
+
+
+def test_fault_pipe_eof_is_not_a_fault():
+    detected, elapsed, messages = _run(_orderly_eof_then_exit)
+    assert detected, "worker exited after closing its fault pipe: not seen"
+    assert elapsed <= _BOUND_S + 1.0, elapsed
+    assert any("VllmWorker-1 died unexpectedly" in m for m in messages), messages
+    assert not any("reported a fatal fault" in m for m in messages), messages
