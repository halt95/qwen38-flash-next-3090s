+def test_failure_ladder_ignores_a_wall_clock_step(monkeypatch):
+    """An earlier ladder timed its graces with time.time().
+
+    A wall-clock step forward (NTP, maintainer) mid-ladder made every wait
+    expire at once, so a survivor still inside its FINAL DRAIN was SIGTERMed.
+    """
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    real_time = time.time
+    calls = {"n": 0}
+
+    def stepping_time():
+        # Steps forward an hour between any two reads.
+        calls["n"] += 1
+        return real_time() + 3600.0 * calls["n"]
