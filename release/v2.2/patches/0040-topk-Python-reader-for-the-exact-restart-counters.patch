@@ -2090,3 +2092,61 @@ def test_persistent_topk_exact_counters_rejects_unsafe_output() -> None:
 
     with pytest.raises(Exception):
         op(ok, 1, 0)  # reset without sync is not a complete handoff
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_topk_exact_counters_reader_log_line(monkeypatch) -> None:
+    """The Python reader must produce the exact line the smoke greps.
+
+    Runs the op path directly -- no engine, no model -- so a failure here is
+    the reader's, not a serving regression. Asserting the format with a regex
+    is the point: the smoke keys on these field names, and a reader that
+    prints something else is as good as no reader at all.
+    """
+    from vllm.models.qwen4_exp.nvidia.ops import topk_counters
+
+    torch.set_default_device("cuda:0")
+    direct = _read_exact_counters()
+    if direct is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: no "
+            "persistent_topk_exact_counters op. A skip is not a pass."
+        )
+
+    monkeypatch.setenv("MERLIN_TOPK_EXACT_COUNTERS_LOG", "1")
+    monkeypatch.setenv("MERLIN_TOPK_COUNTER_SLOTS", str(_EXACT_COUNTER_SLOTS))
+    assert envs.MERLIN_TOPK_EXACT_COUNTERS_LOG == 1
+
+    counters = topk_counters.read()
+    assert list(counters) == [
+        "rows",
+        "overflow",
+        "fallbacks",
+        "faults",
+        "switch",
+    ], f"unexpected slot names: {list(counters)}"
+    assert counters == dict(zip(counters, direct, strict=True)), (
+        "the reader disagrees with a direct op call"
+    )
+
+    line = topk_counters.log_line("PP0_TP0")
+    assert re.fullmatch(
+        r"topk-exact-counters rank=PP0_TP0 rows=\d+ overflow=\d+ "
+        r"fallbacks=\d+ faults=\d+ switch=\d+",
+        line,
+    ), f"log line does not match the documented format: {line!r}"
+
+    # The cadence gate must also be able to emit -- a reader that never fires
+    # from maybe_log() is the same defect one level up.
+    topk_counters._last_log_monotonic = 0.0
+    expected = line.replace("PP0_TP0", topk_counters.rank_tag())
+    assert topk_counters.maybe_log() == expected
+    # ... and must then stay silent until the period elapses.
+    assert topk_counters.maybe_log() == ""
+
+    # Unknown slot counts must degrade to positional names, never mislabel.
+    assert topk_counters.slot_names(7) == tuple(f"slot{i}" for i in range(7))
+    if getattr(torch.ops._C, "persistent_topk_exact_counters_slots", None) is None:
+        monkeypatch.setenv("MERLIN_TOPK_COUNTER_SLOTS", "7")
+        assert topk_counters.slot_count() == 7
