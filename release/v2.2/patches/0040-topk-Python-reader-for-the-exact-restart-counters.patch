+            # never fire on them. Outside any capture: this is the engine
+            # thread between steps (read() re-checks).
+            topk_counters.maybe_log()
             # Update the request states.
             self.update_pp_decode_requests()
             self.finish_requests(scheduler_output)
@@ -2479,6 +2489,9 @@ class GPUModelRunner(LoRAModelRunnerMixin):
         """Release GPU tensors (model weights, KV caches, workspace) so that
         memory is reclaimable when running in the same process."""
         torch.accelerator.synchronize()
+        # The last window of a run is the one a cadence log always
+        # misses; emit it before the device state goes away.
+        topk_counters.maybe_log(force=True)
         if self._ple_offload_connector is not None:
             self._ple_offload_connector.close()
             self._ple_offload_connector = None
