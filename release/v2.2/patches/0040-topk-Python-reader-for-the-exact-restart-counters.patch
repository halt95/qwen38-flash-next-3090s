             # A Python bool; adds no device sync to the step. Late and
             # rank-local -- see guard_telemetry.check_pending.
             guard_telemetry.check_pending()
+            # Post-step read of the top-k exact-restart counters, i.e.
+            # everything the previous steps accumulated. Off unless
