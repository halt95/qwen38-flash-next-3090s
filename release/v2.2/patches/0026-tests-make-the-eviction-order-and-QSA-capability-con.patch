@@ -700,6 +700,7 @@ def test_deferred_victim_stops_the_preemption_cascade():
     assert first.request_id in out2.num_scheduled_tokens
     assert first.status == RequestStatus.RUNNING
 
+
 def _make_pool_with_cached_blocks(num_blocks: int, block_size: int = 16):
     """Build a BlockPool holding `num_blocks` allocated, hashed blocks.
 
@@ -727,43 +728,125 @@ def _eviction_order(pool: BlockPool) -> list[int]:
     return order
 
 
+def _seed_request_blocks(manager, request_id: str, blocks_per_group: int):
+    """Give every group's single-type manager a real, hashed block list.
+
+    Blocks come from the manager's own pool and are hashed so that
+    ``BlockPool.free_blocks`` routes them down the cached branch, which appends
+    to the back of the free queue in the order it is handed -- that order IS
+    the eviction order. Unhashed blocks are *prepended* instead and would mask
+    what is being measured.
+
+    Returns the per-group block ids in allocation order.
+    """
+    pool = manager.block_pool
+    allocated: list[list[int]] = []
+    for group_id, group_mgr in enumerate(manager.coordinator.single_type_managers):
+        blocks = pool.get_new_blocks(blocks_per_group)
+        for i, block in enumerate(blocks):
+            block.set_block_hash(
+                BlockHashWithGroupId(f"g{group_id}b{i}".encode()),
+                num_tokens=pool.hash_block_size,
+            )
+        group_mgr.req_to_blocks[request_id] = blocks
+        allocated.append([b.block_id for b in blocks])
+    return allocated
+
+
+def _free_through_scheduler(manager, request, defer: bool, ours: set[int]) -> list[int]:
+    """Free ``request`` through the real scheduler helper, one way or the other.
+
+    ``defer=False`` takes ``_free_request_blocks``'s immediate branch
+    (``KVCacheManager.free`` -> ``KVCacheCoordinator.free`` -> one reversed
+    ``free_blocks`` per group). ``defer=True`` takes the deferred branch
+    (``pop_blocks_for_free`` -> ``deferred_frees`` -> ``_drain_deferred_frees``).
+    Both are the production methods; only the gate differs.
+    """
+    scheduler = _create_deferring_scheduler()
+    scheduler.kv_cache_manager = manager
+    scheduler.defer_block_free = defer
+    scheduler.processed_step_seq = 0
+    scheduler.sched_step_seq = 1
+    request.last_sched_seq = 1
+
+    scheduler._free_request_blocks(request)
+    if defer:
+        assert scheduler.deferred_frees, (
+            "last_sched_seq > processed_step_seq must take the deferred branch; "
+            "if it did not, this arm is not testing the deferred path"
+        )
+        scheduler.processed_step_seq = 1
+        scheduler._drain_deferred_frees()
+        assert not scheduler.deferred_frees
+    else:
+        assert not scheduler.deferred_frees
+
+    # The pool also holds blocks this request never owned; they are unhashed,
+    # so `free_blocks` never touched them and they sit ahead of ours in the
+    # queue. Filter to the request's own blocks, whose relative order is
+    # exactly what was handed to `free_blocks`.
+    return [bid for bid in _eviction_order(manager.block_pool) if bid in ours]
+
+
 def test_deferred_free_matches_immediate_free_eviction_order():
     """Regression for the deferred-free path collapsing per-group eviction
     order for multi-group (hybrid) KV caches.
 
-    Group A owns blocks [1, 2, 3] (allocation order) and group B owns
-    [4, 5, 6]. The immediate-free path frees each group in its own
-    reversed ``free_blocks`` call; the fixed deferred-free path must
-    reproduce exactly that order, not a single flattened reversal.
+    Drives BOTH arms through the production code -- ``Scheduler.
+    _free_request_blocks`` over a real two-group ``KVCacheManager``, its real
+    ``KVCacheCoordinator``, the real ``deferred_frees`` deque and the real
+    ``_drain_deferred_frees`` -- and compares the resulting eviction order.
+    Constructing the two orders by hand and calling ``BlockPool.free_blocks``
+    directly would leave every production statement unexercised, so reverting
+    the patch would not fail the test.
+
+    The immediate path frees each group in its own reversed ``free_blocks``
+    call (``SingleTypeKVCacheManager.free``). The deferred path pops all groups
+    into ONE concatenated list and drains it in a single ``free_blocks`` call,
+    so the per-group reversal has to be applied before the concatenation --
+    which is what ``KVCacheCoordinator.pop_blocks_for_free`` now does.
+
+    Reverting the patch (no per-group reverse in ``pop_blocks_for_free``, a
+    ``reversed()`` back in ``_drain_deferred_frees``) makes the deferred arm
+    return ``reversed(g0_alloc + g1_alloc)`` -- whole groups in the wrong order
+    relative to the immediate arm -- which fails both the equality assertion
+    and the explicit pre-patch-shape assertion below.
     """
-    group_a_alloc = [1, 2, 3]
-    group_b_alloc = [4, 5, 6]
-
-    # Immediate path: KVCacheCoordinator.free() -> one reversed free_blocks
-    # call per single-type manager (group).
-    pool_imm, by_id = _make_pool_with_cached_blocks(6)
-    for group in (group_a_alloc, group_b_alloc):
-        pool_imm.free_blocks([by_id[i] for i in reversed(group)])
-    immediate_order = _eviction_order(pool_imm)
-
-    # Fixed deferred path: groups are kept separate (each already reversed)
-    # and freed in their own call on drain -- mirroring the immediate path.
-    pool_fixed, by_id = _make_pool_with_cached_blocks(6)
-    ordered_groups = [list(reversed(group_a_alloc)), list(reversed(group_b_alloc))]
-    for group in ordered_groups:
-        pool_fixed.free_blocks([by_id[i] for i in group])
-    fixed_order = _eviction_order(pool_fixed)
-
-    assert fixed_order == immediate_order == [3, 2, 1, 6, 5, 4]
-
-    # The old (buggy) deferred path flattened both groups then reversed once,
-    # which produces a different order. Guard against regressing back to it.
-    pool_buggy, by_id = _make_pool_with_cached_blocks(6)
-    flattened = group_a_alloc + group_b_alloc
-    pool_buggy.free_blocks([by_id[i] for i in reversed(flattened)])
-    buggy_order = _eviction_order(pool_buggy)
-    assert buggy_order == [6, 5, 4, 3, 2, 1]
-    assert buggy_order != immediate_order
+    blocks_per_group = 3
+    request = create_requests(num_requests=1, num_tokens=NUM_PROMPT_TOKENS)[0]
+
+    imm_manager = _make_two_group_kv_cache_manager(num_blocks=20)
+    def_manager = _make_two_group_kv_cache_manager(num_blocks=20)
+    assert len(imm_manager.coordinator.single_type_managers) == 2, (
+        "a single-group config cannot distinguish the two orders at all"
+    )
+
+    allocated = _seed_request_blocks(imm_manager, request.request_id, blocks_per_group)
+    assert allocated == _seed_request_blocks(
+        def_manager, request.request_id, blocks_per_group
+    ), "the two arms must start from identical per-group allocations"
+    assert not set(allocated[0]) & set(allocated[1]), (
+        "groups must own disjoint block ids or a group mix-up is invisible"
+    )
+    ours = {bid for group in allocated for bid in group}
+
+    immediate_order = _free_through_scheduler(imm_manager, request, False, ours)
+    deferred_order = _free_through_scheduler(def_manager, request, True, ours)
+
+    # Pin the shape as well as the equality: tail-first within a group, groups
+    # in their coordinator order.
+    expected = [bid for group in allocated for bid in reversed(group)]
+    assert immediate_order == expected
+    assert deferred_order == immediate_order
+
+    # The pre-patch deferred implementation flattened every group then reversed
+    # once. Assert the observed order is not that, so a revert cannot pass.
+    pre_patch_order = list(reversed([bid for group in allocated for bid in group]))
+    assert pre_patch_order != expected, (
+        "the fixture does not separate the two implementations; with this "
+        "shape the test could not fail on a revert"
+    )
+    assert deferred_order != pre_patch_order
 
 
 def test_pop_blocks_for_free_returns_eviction_order():
