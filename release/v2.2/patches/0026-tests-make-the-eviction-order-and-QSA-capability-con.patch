+++ b/tests/models/qwen4_exp/test_qsa_backend_capability.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Capability contract of ``Qwen4ExpQSAFlashAttentionBackend``.
+
+QSA stores e4m3 bytes in a uint8 cache written by ``reshape_and_cache_flash``
+and dequantizes them inside its own Triton kernel; flash-attn never runs over
+that cache. The backend therefore overrides two capability classmethods so the
+parent's flash-attn fp8 probe cannot veto the configuration.
+
+``AttentionBackend.validate_configuration`` (vllm/v1/attention/backend.py:262)
+is the entry point that calls both -- ``supports_kv_cache_dtype`` at :289 and
+``supports_combination`` at :335 -- so it is what these tests drive.
+
+ON WHAT THIS DOES AND DOES NOT ESTABLISH. ``Qwen4ExpQSAAttention.__init__``
+(nvidia/qsa.py) assigns ``self.attn_backend = Qwen4ExpQSAFlashAttentionBackend``
+and constructs the impl directly; ``QWEN4_EXP_QSA_TRITON`` is not in the
+selection registry, so a boot does not route this class through
+``platforms/cuda.py``'s ``validate_configuration`` call. These tests therefore
+pin the backend's declared contract, not a boot outcome, and a boot with the
+overrides removed is NOT guaranteed to fail. (``vllm/models/hy_v4/nvidia/
+attention.py:604`` shows the in-tree pattern for a model that does validate its
+own backend explicitly; QSA does not do that today.) The fp8-cache gate that a
+boot actually hits is ``_validated_qsa_fp8_dtype`` plus the
+``_QSA_SUPPORTED_CACHE_DTYPES`` check in ``Qwen4ExpQSAAttention.__init__``.
+"""
+
+import pytest
+import torch
+
+from vllm.config.cache import CacheDType
+from vllm.models.qwen4_exp.nvidia.qsa import Qwen4ExpQSAFlashAttentionBackend
+from vllm.platforms.interface import DeviceCapability
+from vllm.v1.attention.backend import AttentionType
+from vllm.v1.attention.backends.flash_attn import FlashAttentionBackend
+
+pytestmark = pytest.mark.cpu_test
+
+# sm_86: the capability this fork's QSA fp8 path is gated to.
+_SM86 = DeviceCapability(8, 6)
+_FA_PROBE = "vllm.v1.attention.backends.flash_attn.flash_attn_supports_kv_cache_dtype"
+_FP8_REASON = "FP8 KV cache requires"
+_DTYPE_REASON = "kv_cache_dtype not supported"
+
+
+class _NoOverrideBackend(Qwen4ExpQSAFlashAttentionBackend):
+    """The same backend with exactly the two overrides taken away.
+
+    ``__func__`` is unwrapped and re-wrapped so ``cls`` still binds to this
+    subclass: it keeps our ``supported_kv_cache_dtypes`` and differs from the
+    real backend in nothing but the two methods under test. Assigning the bound
+    parent classmethods instead would silently swap the dtype list too, and the
+    control would no longer isolate the overrides.
+    """
+
+    supports_kv_cache_dtype = classmethod(
+        FlashAttentionBackend.supports_kv_cache_dtype.__func__
+    )
+    supports_combination = classmethod(
+        FlashAttentionBackend.supports_combination.__func__
+    )
+
+
+def _validate(backend, kv_cache_dtype: CacheDType | None, **overrides):
+    kwargs = dict(
+        head_size=128,
+        dtype=torch.bfloat16,
+        kv_cache_dtype=kv_cache_dtype,
+        block_size=16,
+        use_mla=False,
+        has_sink=False,
+        use_sparse=True,  # QSA.is_sparse() is True
+        use_mm_prefix=False,
+        use_per_head_quant_scales=False,
+        device_capability=_SM86,
+        attn_type=AttentionType.DECODER,
+    )
+    kwargs.update(overrides)
+    return backend.validate_configuration(**kwargs)
+
+
+def _combination(backend, kv_cache_dtype: CacheDType | None, **overrides):
+    kwargs = dict(
+        head_size=128,
+        dtype=torch.bfloat16,
+        kv_cache_dtype=kv_cache_dtype,
+        block_size=16,
+        use_mla=False,
+        has_sink=False,
+        use_sparse=True,
+        use_mm_prefix=False,
+        device_capability=_SM86,
+    )
+    kwargs.update(overrides)
+    return backend.supports_combination(**kwargs)
+
+
+@pytest.mark.parametrize("kv_cache_dtype", ["fp8", "fp8_e4m3"])
+def test_fp8_survives_validation_with_the_fa_probe_rejecting(
+    monkeypatch, kv_cache_dtype
+):
+    """With the flash-attn fp8 probe forced to reject, the overridden backend
+    must still accept the dtype, and the control without the overrides must not.
+
+    Forcing the probe is what makes this a test that can fail: on a host where
+    flash-attn happens to support fp8 the parent would accept it too, and the
+    override would be indistinguishable from its absence
+    (an instrument must discriminate both worlds).
+
+    Assertions are on the two specific reasons rather than on an empty list,
+    so unrelated reasons a particular host contributes cannot mask or fake the
+    result.
+    """
+    monkeypatch.setattr(_FA_PROBE, lambda *a, **k: False)
+
+    ours = _validate(Qwen4ExpQSAFlashAttentionBackend, kv_cache_dtype)
+    assert _DTYPE_REASON not in ours
+    assert not any(_FP8_REASON in r for r in ours), ours
+
+    # FAILING CONTROL: remove the overrides, keep everything else.
+    control = _validate(_NoOverrideBackend, kv_cache_dtype)
+    assert _DTYPE_REASON in control, (
+        "the parent must reject this dtype once the probe rejects it; if it "
+        "does not, this test proves nothing about the override"
+    )
+    assert any(_FP8_REASON in r for r in control), control
+
+    # The two classes must differ in exactly these reasons and nothing else.
+    assert set(control) - set(ours) == {
+        _DTYPE_REASON,
+        *(r for r in control if _FP8_REASON in r),
+    }
+    assert not set(ours) - set(control)
+
+
+def test_bfloat16_path_is_untouched(monkeypatch):
+    """The overrides must not change the non-quantized cache at all: the parent
+    never consults the fp8 probe for it, so both classes must agree."""
+    monkeypatch.setattr(_FA_PROBE, lambda *a, **k: False)
+    for kv_cache_dtype in ("auto", "bfloat16"):
+        assert _validate(Qwen4ExpQSAFlashAttentionBackend, kv_cache_dtype) == _validate(
+            _NoOverrideBackend, kv_cache_dtype
+        )
+
+
+def test_unsupported_cache_dtype_is_still_rejected():
+    """``supports_kv_cache_dtype`` overrides the flash-attn probe, not the
+    class's own dtype list: a dtype QSA does not store must still fail."""
+    assert not Qwen4ExpQSAFlashAttentionBackend.supports_kv_cache_dtype("fp8_e5m2")
+    assert Qwen4ExpQSAFlashAttentionBackend.supports_kv_cache_dtype(None)
+    assert Qwen4ExpQSAFlashAttentionBackend.supports_kv_cache_dtype("fp8_e4m3")
+    assert _DTYPE_REASON in _validate(Qwen4ExpQSAFlashAttentionBackend, "fp8_e5m2")
+
+
+def test_supports_combination_suppresses_only_the_fp8_clause(monkeypatch):
+    """``supports_combination`` must narrow the parent, not silence it.
+
+    Returning None unconditionally would advertise fewer restrictions than
+    ``forward_qsa`` enforces (it raises on ALiBi, attention sinks and sliding
+    windows), so the parent's other clauses have to survive.
+    """
+    monkeypatch.setattr(_FA_PROBE, lambda *a, **k: False)
+
+    # The fp8 clause is suppressed...
+    assert _combination(Qwen4ExpQSAFlashAttentionBackend, "fp8_e4m3") is None
+    parent_said = _combination(_NoOverrideBackend, "fp8_e4m3")
+    assert parent_said is not None and _FP8_REASON in parent_said
+
+    # ...but the sink/compute-capability clause is not, for fp8 or otherwise.
+    # sm_86 < 9.0, so the parent rejects sinks here and QSA must say so too.
+    for kv_cache_dtype in ("fp8_e4m3", "bfloat16", None):
+        reason = _combination(
+            Qwen4ExpQSAFlashAttentionBackend, kv_cache_dtype, has_sink=True
+        )
+        assert reason is not None, kv_cache_dtype
+        assert "sink" in reason
+        assert reason == _combination(_NoOverrideBackend, kv_cache_dtype, has_sink=True)
