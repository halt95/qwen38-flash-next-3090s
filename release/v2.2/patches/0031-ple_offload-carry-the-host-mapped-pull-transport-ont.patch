+def _run_bounded_child(
+    source: str,
+    tmp_path: Path,
+    *arguments: str,
+    expected_exitcode: int = 0,
+) -> None:
+    marker = tmp_path / f"started-{time.monotonic_ns()}"
+    process = subprocess.Popen(
+        [sys.executable, "-c", source, str(marker), *arguments],
+        stderr=subprocess.DEVNULL,
+        start_new_session=os.name == "posix",
+    )
+    stayed_alive = False
+    try:
+        deadline = time.monotonic() + 120
+        while not marker.exists() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert marker.exists(), (
+            "child did not finish cold startup within 120 seconds"
+        )
+        process.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        stayed_alive = True
+    finally:
+        if process.poll() is None:
+            if os.name == "posix":
+                os.killpg(process.pid, signal.SIGKILL)
+            else:
+                process.terminate()
+            process.wait(timeout=120)
+
+    assert not stayed_alive, "child stayed alive after the bounded operation"
+    assert process.returncode == expected_exitcode
+
