+def _runner(query_start_loc: list[int]) -> PleOffloadRunner:
+    runner = PleOffloadRunner.__new__(PleOffloadRunner)
+    flag = torch.zeros(1, dtype=torch.int32)
+    target = SimpleNamespace(
+        host_output_buffer=torch.zeros(4, 2),
+        host_flag=flag,
+    )
+    runner._worker_targets = {0: {"ple": [target]}}
+    runner._scratch_bufs = {0: {"ple": torch.empty(4, 2)}}
+    query = torch.zeros(3, dtype=torch.int32)
+    query[: len(query_start_loc)] = torch.tensor(
+        query_start_loc, dtype=torch.int32
+    )
+    runner._input_bufs = {
+        0: PleOffloadInputBuffers(
+            input_ids_buf=torch.zeros(4, dtype=torch.int32),
+            query_start_loc_buf=query,
+            ngram_context_buf=torch.zeros(2, 1, dtype=torch.int32),
+        )
