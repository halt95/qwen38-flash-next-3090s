+def test_shutdown_marks_ple_stopping_before_teardown(monkeypatch) -> None:
+    worker = gpu_worker.Worker.__new__(gpu_worker.Worker)
+    worker._ple_offload_stopping = False
+    order: list[tuple[str, bool]] = []
+
+    def record(name: str):
+        def call() -> None:
+            order.append((name, worker._ple_offload_stopping))
+
+        return call
+
+    monkeypatch.setattr(gpu_worker.gc, "unfreeze", record("gc"))
+    monkeypatch.setattr(
+        gpu_worker,
+        "ensure_kv_transfer_shutdown",
+        record("kv"),
+    )
+    monkeypatch.setattr(
+        gpu_worker,
+        "ensure_ec_transfer_shutdown",
+        record("ec"),
+    )
+    monkeypatch.setattr(
+        gpu_worker.current_platform,
+        "is_cuda_alike",
+        lambda: False,
+    )
+
+    worker.profiler = None
+    worker.weight_transfer_engine = None
+    worker.elastic_ep_executor = SimpleNamespace(shutdown=record("elastic"))
+    worker._ple_offload_worker_handle = SimpleNamespace(close=record("offload"))
+    worker.model_runner = SimpleNamespace(shutdown=record("runner"))
+
+    worker.shutdown()
+
+    assert order
+    assert all(stopping for _, stopping in order)
+    assert [name for name, _ in order][:2] == ["gc", "kv"]
+
+
+class _RequestThread:
+    def __init__(self, order: list[str], *, stops: bool) -> None:
+        self.order = order
+        self.stops = stops
+        self.alive = True
+
+    def is_alive(self) -> bool:
+        return self.alive
+
+    def join(self, timeout: float) -> None:
+        self.order.append("thread.join")
+        if self.stops:
+            self.alive = False
+
+
+def _record(order: list[str], name: str):
+    def call(*_args: Any, **_kwargs: Any) -> None:
+        order.append(name)
+
+    return call
+
+
+def _make_connector_for_close(
+    order: list[str], *, thread_stops: bool
+) -> PleOffloadConnector:
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._request_thread = _RequestThread(order, stops=thread_stops)
+    connector._request_queue = SimpleNamespace(put=_record(order, "queue.stop"))
+    connector._pinned_input_buffers = []
+    connector._mapped_host_buffers = []
+    connector._d2h_event_pool = object()
+    connector._registration_socket = SimpleNamespace(
+        close=_record(order, "socket.close")
+    )
+    connector._zmq_ctx = SimpleNamespace(term=_record(order, "context.term"))
+    connector._progress = SimpleNamespace(close=_record(order, "progress.close"))
+    connector.release_host_storage = _record(order, "storage.release")
+    return connector
+
+
+def test_connector_close_releases_storage_last() -> None:
+    order: list[str] = []
+    connector = _make_connector_for_close(order, thread_stops=True)
+
+    connector.close()
+
+    assert order[-1] == "storage.release"
+    assert order.index("thread.join") < order.index("context.term")
+    assert order.index("context.term") < order.index("storage.release")
+
+
+def test_connector_close_defers_storage_release_if_thread_does_not_stop() -> None:
+    order: list[str] = []
+    connector = _make_connector_for_close(order, thread_stops=False)
+
+    connector.close()
+
+    assert "storage.release" not in order
+    assert "socket.close" not in order
+    assert "context.term" not in order
+    assert order[-1] == "progress.close"
+
+
+def test_offload_child_unlinks_owned_ipc_after_context_term(monkeypatch) -> None:
+    order: list[str] = []
+    ipc_addr = "ipc:///tmp/ple-owned-test.sock"
+    pull_socket = SimpleNamespace(
+        bind=_record(order, "socket.bind"),
+        close=_record(order, "socket.close"),
+    )
+    zmq_context = SimpleNamespace(
+        socket=lambda _kind: pull_socket,
+        term=_record(order, "context.term"),
+    )
+
+    class FakeRunner:
+        layer_names: list[str] = []
+
+        def __init__(self, _config: object) -> None:
+            pass
+
+        def accept_registrations(self, _socket: object, _count: int) -> None:
+            order.append("registrations.accept")
+
+        def busy_loop(self, _socket: object, _event: object) -> None:
+            order.append("runner.busy_loop")
+
+    ready_pipe = SimpleNamespace(
+        send_bytes=_record(order, "ready.send"),
+        close=_record(order, "ready.close"),
+    )
+    monkeypatch.setattr(ple_worker, "decorate_logs", lambda _name: None)
+    monkeypatch.setattr(ple_worker, "mark_as_offload_worker", lambda: None)
+    monkeypatch.setattr(ple_worker, "_prepare_cuda_free_process", lambda: None)
+    monkeypatch.setattr(ple_worker, "_init_offload_distributed", lambda: None)
+    monkeypatch.setattr(
+        ple_worker,
+        "set_current_vllm_config",
+        lambda _config: contextlib.nullcontext(),
+    )
+    monkeypatch.setattr(ple_worker, "PleOffloadRunner", FakeRunner)
+    monkeypatch.setattr(ple_worker.zmq, "Context", lambda: zmq_context)
+    monkeypatch.setattr(ple_worker.signal, "signal", lambda *_args: None)
+    monkeypatch.setattr(ple_worker.torch.cuda, "is_initialized", lambda: False)
+    monkeypatch.setattr(
+        ple_worker,
+        "_unlink_ipc_socket",
+        lambda address: order.append(f"ipc.unlink:{address}"),
+    )
+
+    ple_worker.PleOffloadWorker.proc_main(
+        SimpleNamespace(),
+        num_workers=1,
+        ipc_addr=ipc_addr,
+        ready_pipe=ready_pipe,
+    )
+
+    assert order.index("socket.close") < order.index("context.term")
+    assert order[-1] == f"ipc.unlink:{ipc_addr}"
