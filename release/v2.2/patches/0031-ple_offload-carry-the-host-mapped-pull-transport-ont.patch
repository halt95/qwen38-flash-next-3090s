+import vllm_ple_test_fault as test_fault
+
+
+def _spec(monkeypatch, tmp_path, value):
+    monkeypatch.setenv("VLLM_PLE_TEST_FAULT_LOG", str(tmp_path / "fault.log"))
+    spec = test_fault._parse_fault_spec(value)
+    assert spec is not None
+    return spec
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "cut=park_before_publish,ordinal=1,tp=0",
+        "cut=launch_silent_ready,ordinal=1,pp=0",
+        "cut=drop_request,ordinal=1,tp=1,pp=0",
+        "cut=exc_after_prepare,ordinal=1,tp=0,pp=1",
+    ],
+)
+def test_impossible_role_selectors_are_rejected(monkeypatch, tmp_path, value):
+    monkeypatch.setenv("VLLM_PLE_TEST_FAULT_LOG", str(tmp_path / "fault.log"))
+    with pytest.raises(ValueError):
+        test_fault._parse_fault_spec(value)
+
+
