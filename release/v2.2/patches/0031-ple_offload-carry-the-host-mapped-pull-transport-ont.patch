+# SPDX-License-Identifier: Apache-2.0
+
+import multiprocessing
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+import vllm.v1.executor.multiproc_executor as executor_module
+from vllm.v1.executor.multiproc_executor import WorkerProc
+from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+
+class _BrokenAsyncOutput:
+    def get_output(self) -> Any:
+        raise RuntimeError("injected asynchronous output failure")
+
+
+class _Progress:
+    sequence = 9
+
+    def __init__(self, pending: bool) -> None:
+        self.has_pending_completions = pending
+
+
+class _Connector:
+    rank = 2
+    _layers = {"ple": object()}
+
+    def __init__(self, pending: bool) -> None:
+        self._progress = _Progress(pending)
+
+    @property
+    def has_pending_completions(self) -> bool:
+        return self._progress.has_pending_completions
+
+    def _fail_closed(self, where: str, error: BaseException) -> None:
+        ple_fail_closed(
+            where=where,
+            rank=self.rank,
+            layer="ple",
+            sequence=self._progress.sequence,
+            error=error,
+        )
+
+
+def _async_output_failure_case(pending: bool) -> None:
+    connector = _Connector(pending)
+    worker = SimpleNamespace(
+        model_runner=SimpleNamespace(_ple_offload_connector=connector)
+    )
+    proc = WorkerProc.__new__(WorkerProc)
+    proc.worker = SimpleNamespace(worker=worker)
+    proc.worker_response_mq = None
+
+    # Exercise the real async-output exception recovery branch without needing
+    # to construct the production dataclass's CUDA-backed fields.
+    executor_module.AsyncModelRunnerOutput = _BrokenAsyncOutput
+    proc.enqueue_output(_BrokenAsyncOutput())
+
+
+@pytest.mark.parametrize(
+    ("pending", "must_die"),
+    [(True, True), (False, False)],
+)
+def test_async_output_failure_obeys_pending_ple_ownership(
+    pending: bool,
+    must_die: bool,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    process = context.Process(
+        target=_async_output_failure_case,
+        args=(pending,),
+    )
+    process.start()
+    process.join(timeout=120)
+    assert not process.is_alive()
+    if must_die:
+        assert process.exitcode not in (None, 0)
+    else:
+        assert process.exitcode == 0
diff --git a/tests/v1/ple_offload/test_progress_deadline.py b/tests/v1/ple_offload/test_progress_deadline.py
new file mode 100644
index 0000000000..5e7ca19d7e
--- /dev/null
+++ b/tests/v1/ple_offload/test_progress_deadline.py
@@ -0,0 +1,216 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import multiprocessing
+import os
+import threading
+from pathlib import Path
+from typing import Any
+
+import pytest
+import torch
+
+import vllm.v1.ple_offload.connector as connector_module
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.progress import PleProgressMonitor
+
+
+class _PendingEvent:
+    def record(self, stream: Any) -> None:
+        stream.recorded = True
+
+    def query(self) -> bool:
+        return False
+
+
+class _BrokenEvent(_PendingEvent):
+    def __init__(self, query_entered: Any) -> None:
+        self.query_entered = query_entered
+
+    def query(self) -> bool:
+        self.query_entered.set()
+        raise RuntimeError("injected event query failure")
+
+
+class _FakeStream:
+    recorded = False
+
+    def synchronize(self) -> None:
+        return
+
+
+class _FakeLayer:
+    def release_offloaded_output(self, stream: Any) -> None:
+        stream.reset_written = True
+
+
+def _silent_producer_case(block_input: bool, started: Any) -> None:
+    monitor = PleProgressMonitor(
+        rank=2,
+        layer_names=("ple",),
+        serving_deadline_s=0.2,
+        startup_deadline_s=1.0,
+    )
+    monitor.begin(startup=False, num_tokens=32)
+    started.set()
+
+    if block_input:
+        # Models the request thread stuck in d2h_done_event.synchronize().
+        threading.Thread(
+            target=threading.Event().wait,
+            daemon=True,
+        ).start()
+
+    # Neither the fake producer nor the test terminates the process. The
+    # independent progress monitor must do so.
+    threading.Event().wait()
+
+
+@pytest.mark.parametrize("block_input", [False, True])
+def test_progress_deadline_terminates_alive_silent_worker(
+    block_input: bool,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    started = context.Event()
+    process = context.Process(
+        target=_silent_producer_case,
+        args=(block_input, started),
+    )
+    process.start()
+    # Cold vLLM import in the spawned child takes 4-8 s on the reference host; the deadline
+    # itself (0.2 s) is only charged after `started` is set.
+    assert started.wait(timeout=120)
+    process.join(timeout=10)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+
+
+def _pending_completion_case(use_release_wrapper: bool, started: Any) -> None:
+    monitor = PleProgressMonitor(
+        rank=2,
+        layer_names=("ple",),
+        serving_deadline_s=0.2,
+        startup_deadline_s=1.0,
+    )
+    if use_release_wrapper:
+        stream = _FakeStream()
+        connector_module.torch.cuda.current_stream = lambda device=None: stream
+        connector_module.torch.cuda.Event = _PendingEvent
+        connector_module.torch.cuda.is_current_stream_capturing = lambda: False
+        connector_module._rowdump.enabled = lambda: False
+
+        connector = PleOffloadConnector.__new__(PleOffloadConnector)
+        connector.device = torch.device("cpu")
+        connector.rank = 2
+        connector.tp_rank = 0
+        connector._layers = {"ple": _FakeLayer()}
+        connector._progress = monitor
+        connector._rowdump_n = None
+        connector._after_dummy = False
+        monitor.begin(startup=False, num_tokens=8)
+        connector.release_outputs()
+        assert stream.recorded
+        assert stream.reset_written
+    else:
+        monitor.begin(startup=False, num_tokens=8)
+        monitor.track_completion(_PendingEvent())
+        monitor.complete()
+    started.set()
+    threading.Event().wait()
+
+
+@pytest.mark.parametrize("use_release_wrapper", [False, True])
+def test_pending_gpu_completion_expires_after_release_returns(
+    use_release_wrapper: bool,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    started = context.Event()
+    process = context.Process(
+        target=_pending_completion_case,
+        args=(use_release_wrapper, started),
+    )
+    process.start()
+    assert started.wait(timeout=120)
+    process.join(timeout=10)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+
+
+@pytest.mark.parametrize("value", [float("inf"), float("nan"), -1.0, 1e12])
+def test_constructor_rejects_invalid_deadlines(value: float) -> None:
+    with pytest.raises(ValueError, match="finite"):
+        PleProgressMonitor(
+            rank=0,
+            layer_names=("ple",),
+            serving_deadline_s=value,
+            startup_deadline_s=1.0,
+        )
+    with pytest.raises(ValueError, match="finite"):
+        PleProgressMonitor(
+            rank=0,
+            layer_names=("ple",),
+            serving_deadline_s=1.0,
+            startup_deadline_s=value,
+        )
+
+
+@pytest.mark.parametrize(
+    "name",
+    ["VLLM_PLE_PROGRESS_DEADLINE_S", "VLLM_PLE_STARTUP_DEADLINE_S"],
+)
+@pytest.mark.parametrize("value", ["inf", "nan", "-1", "1e12"])
+def test_environment_rejects_invalid_deadlines(
+    monkeypatch: pytest.MonkeyPatch,
+    name: str,
+    value: str,
+) -> None:
+    monkeypatch.setenv("VLLM_PLE_PROGRESS_DEADLINE_S", "1")
+    monkeypatch.setenv("VLLM_PLE_STARTUP_DEADLINE_S", "1")
+    monkeypatch.setenv(name, value)
+    with pytest.raises(ValueError, match="finite"):
+        PleProgressMonitor.from_environment(rank=0, layer_names=("ple",))
+
+
+def _monitor_exception_case(
+    started: Any,
+    query_entered: Any,
+    diagnostic_path: str,
+) -> None:
+    diagnostic_fd = os.open(diagnostic_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    os.dup2(diagnostic_fd, 2)
+    os.close(diagnostic_fd)
+    monitor = PleProgressMonitor(
+        rank=4,
+        layer_names=("ple",),
+        serving_deadline_s=10.0,
+        startup_deadline_s=10.0,
+    )
+    monitor.begin(startup=False, num_tokens=8)
+    # Set before arming the failing event: the monitor thread's os._exit must not
+    # race a multiprocessing Event.set() that holds the shared condition lock.
+    started.set()
+    monitor.track_completion(_BrokenEvent(query_entered))
+    monitor.complete()
+    threading.Event().wait()
+
+
+def test_monitor_thread_exception_is_fatal(tmp_path: Path) -> None:
+    context = multiprocessing.get_context("spawn")
+    started = context.Event()
+    query_entered = context.Event()
+    diagnostic_path = tmp_path / "monitor-fatal.txt"
+    process = context.Process(
+        target=_monitor_exception_case,
+        args=(started, query_entered, str(diagnostic_path)),
+    )
+    process.start()
+    assert started.wait(timeout=120)
+    assert query_entered.wait(timeout=10)
+    process.join(timeout=10)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+    diagnostic = diagnostic_path.read_text(encoding="utf-8")
+    assert "where=progress-monitor-thread" in diagnostic
+    assert (
+        "error=RuntimeError:injected event query failure"
+        in diagnostic
+    )
diff --git a/tests/v1/ple_offload/test_shm_unlink.py b/tests/v1/ple_offload/test_shm_unlink.py
new file mode 100644
index 0000000000..600a7bb7e2
--- /dev/null
+++ b/tests/v1/ple_offload/test_shm_unlink.py
@@ -0,0 +1,397 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import os
+from multiprocessing.reduction import ForkingPickler
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.v1.ple_offload import connector as connector_module
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.protocol import PleOffloadRegistration
+
+
+def _require_file_system_shm() -> None:
+    if (
+        os.name != "posix"
+        or not os.path.isdir("/dev/shm")
+        or not os.access("/dev/shm", os.W_OK)
+    ):
+        pytest.skip("POSIX /dev/shm is unavailable")
+    if "file_system" not in torch_mp.get_all_sharing_strategies():
+        pytest.skip("torch file_system sharing is unavailable")
+
+
+def _shm_path(tensor: torch.Tensor) -> Path:
+    _, filename, _ = tensor.untyped_storage()._share_filename_cpu_()
+    return Path("/dev/shm") / os.fsdecode(filename).lstrip("/")
+
+
+def _make_connector_storage() -> tuple[PleOffloadConnector, list[torch.Tensor]]:
+    original_strategy = torch_mp.get_sharing_strategy()
+    torch_mp.set_sharing_strategy("file_system")
+    try:
+        host_outputs = {
+            "layer.0": torch.arange(12, dtype=torch.float32)
+            .reshape(3, 4)
+            .share_memory_(),
+            "layer.1": torch.arange(8, dtype=torch.float32)
+            .reshape(2, 4)
+            .share_memory_(),
+        }
+        host_flags = {
+            name: torch.zeros(16, dtype=torch.int32).share_memory_()
+            for name in host_outputs
+        }
+        input_ids = torch.arange(16, dtype=torch.int32).share_memory_()
+        query_start_loc = torch.arange(5, dtype=torch.int32).share_memory_()
+        ngram_context = torch.arange(12, dtype=torch.int32).reshape(4, 3)
+        ngram_context.share_memory_()
+
+        registration = PleOffloadRegistration(
+            worker_id=0,
+            tp_rank=0,
+            dp_rank=0,
+            host_output_buffers=host_outputs,
+            host_flag_tensors=host_flags,
+            input_ids_buf=input_ids,
+            query_start_loc_buf=query_start_loc,
+            ngram_context_buf=ngram_context,
+        )
+        # Match producer serialization and worker reconstruction. loads()
+        # consumes the transfer reference added by dumps(), leaving storage
+        # destruction able to reach the allocator's zero-counter branch.
+        payload = ForkingPickler.dumps(registration)
+        rebuilt_registration = ForkingPickler.loads(payload)
+        assert isinstance(rebuilt_registration, PleOffloadRegistration)
+        del rebuilt_registration
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._host_output_bufs = host_outputs
+    connector._host_flags = host_flags
+    connector._reserved_host_storage_filenames = set()
+    connector._input_ids_buf = input_ids
+    connector._query_start_loc_buf = query_start_loc
+    connector._ngram_context_buf = ngram_context
+    tensors = [
+        *host_outputs.values(),
+        *host_flags.values(),
+        input_ids,
+        query_start_loc,
+        ngram_context,
+    ]
+    assert len(tensors) == 7
+    return connector, tensors
+
+
+def test_release_host_storage_unlinks_names_but_keeps_mappings() -> None:
+    _require_file_system_shm()
+    connector, tensors = _make_connector_storage()
+    paths = [_shm_path(tensor) for tensor in tensors]
+    before = [tensor.clone() for tensor in tensors]
+    assert len(set(paths)) == 7
+    assert all(path.exists() for path in paths)
+
+    connector.release_host_storage()
+    connector.release_host_storage()
+
+    assert all(not path.exists() for path in paths)
+    for tensor, expected in zip(tensors, before):
+        assert torch.equal(tensor, expected)
+        tensor.add_(1)
+        assert torch.equal(tensor, expected + 1)
+
+
+def test_without_release_helper_names_remain(monkeypatch) -> None:
+    _require_file_system_shm()
+    connector, tensors = _make_connector_storage()
+    paths = [_shm_path(tensor) for tensor in tensors]
+
+    with monkeypatch.context() as patch:
+        patch.setattr(
+            connector_module,
+            "_unlink_filename_shared_storage",
+            lambda _tensor, _reservations: None,
+        )
+        connector.release_host_storage()
+
+    # Do not manually unlink these while their unreserved storages are live.
+    # Normal storage destruction removes them after the test frame is released.
+    assert all(path.exists() for path in paths)
+
+
+def test_release_host_storage_does_not_convert_fd_shared_storage() -> None:
+    if "file_descriptor" not in torch_mp.get_all_sharing_strategies():
+        pytest.skip("torch file_descriptor sharing is unavailable")
+    original_strategy = torch_mp.get_sharing_strategy()
+    torch_mp.set_sharing_strategy("file_descriptor")
+    try:
+        fd_tensor = torch.arange(8, dtype=torch.int32).share_memory_()
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._host_output_bufs = {"layer.0": fd_tensor}
+    connector._host_flags = {}
+    connector._reserved_host_storage_filenames = set()
+    connector._input_ids_buf = torch.arange(2, dtype=torch.int32)
+    connector._query_start_loc_buf = torch.arange(2, dtype=torch.int32)
+    connector._ngram_context_buf = None
+    expected = fd_tensor.clone()
+
+    connector.release_host_storage()
+
+    assert fd_tensor.untyped_storage()._get_shared_fd() >= 0
+    assert torch.equal(fd_tensor, expected)
+
+
+class _FakeFilenameStorage:
+    def __init__(self, filename: bytes) -> None:
+        self.device = torch.device("cpu")
+        self.filename = filename
+        self.increfs = 0
+        self.decrefs = 0
+
+    def is_shared(self) -> bool:
+        return True
+
+    def _get_shared_fd(self) -> int:
+        raise RuntimeError("filename-backed storage has no shared fd")
+
+    def _share_filename_cpu_(self) -> tuple[bytes, bytes, int]:
+        return b"manager", self.filename, 4
+
+    def _shared_incref(self) -> None:
+        self.increfs += 1
+
+    def _shared_decref(self) -> "_FakeFilenameStorage":
+        self.decrefs += 1
+        return self
+
+
+class _FakeTensor:
+    def __init__(self, storage: _FakeFilenameStorage) -> None:
+        self.storage = storage
+
+    def untyped_storage(self) -> _FakeFilenameStorage:
+        return self.storage
+
+
+def _make_fake_connector(tensor: _FakeTensor) -> PleOffloadConnector:
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    # Repeat the same storage in several connector positions to cover aliases.
+    connector._host_output_bufs = {"layer.0": tensor}
+    connector._host_flags = {"layer.0": tensor}
+    connector._reserved_host_storage_filenames = set()
+    connector._input_ids_buf = tensor
+    connector._query_start_loc_buf = tensor
+    connector._ngram_context_buf = None
+    return connector
+
+
+def test_release_host_storage_reserves_each_name_once(monkeypatch) -> None:
+    storage = _FakeFilenameStorage(b"/ple-test-reservation")
+    connector = _make_fake_connector(_FakeTensor(storage))
+    unlinked: list[str] = []
+    monkeypatch.setattr(connector_module.os, "unlink", unlinked.append)
+
+    connector.release_host_storage()
+    connector.release_host_storage()
+
+    assert storage.increfs == 1
+    assert storage.decrefs == 0
+    assert unlinked == ["/dev/shm/ple-test-reservation"]
+
+
+def test_release_host_storage_rolls_back_on_unlink_failure(monkeypatch) -> None:
+    storage = _FakeFilenameStorage(b"/ple-test-rollback")
+    connector = _make_fake_connector(_FakeTensor(storage))
+
+    def fail_unlink(_path: str) -> None:
+        raise PermissionError("test unlink failure")
+
+    monkeypatch.setattr(connector_module.os, "unlink", fail_unlink)
+
+    connector.release_host_storage()
+
+    # The fake connector aliases one storage in four positions. A rolled-back
+    # reservation is retried by the next alias in the same pass (by design: the
+    # name is still present), so every reservation must be balanced by a
+    # rollback and nothing may stay reserved.
+    assert storage.increfs >= 1
+    assert storage.increfs == storage.decrefs
+    assert connector._reserved_host_storage_filenames == set()
+
+
+_BALANCED_LIFETIME_SCRIPT = r"""
+import gc
+import os
+from multiprocessing.reduction import ForkingPickler
+from pathlib import Path
+
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.v1.ple_offload.connector import (
+    PleOffloadConnector,
+    _PROCESS_LIFETIME_REGISTERED_STORAGE,
+)
+from vllm.v1.ple_offload.protocol import PleOffloadRegistration
+
+
+def shm_path(tensor):
+    _, filename, _ = tensor.untyped_storage()._share_filename_cpu_()
+    return Path("/dev/shm") / os.fsdecode(filename).lstrip("/")
+
+
+class Progress:
+    def close(self):
+        pass
+
+
+original_strategy = torch_mp.get_sharing_strategy()
+torch_mp.set_sharing_strategy("file_system")
+try:
+    host_outputs = {
+        "layer.0": torch.arange(12, dtype=torch.float32)
+        .reshape(3, 4)
+        .share_memory_(),
+        "layer.1": torch.arange(8, dtype=torch.float32)
+        .reshape(2, 4)
+        .share_memory_(),
+    }
+    host_flags = {
+        name: torch.zeros(16, dtype=torch.int32).share_memory_()
+        for name in host_outputs
+    }
+    input_ids = torch.arange(16, dtype=torch.int32).share_memory_()
+    query_start_loc = torch.arange(5, dtype=torch.int32).share_memory_()
+    ngram_context = torch.arange(12, dtype=torch.int32).reshape(4, 3)
+    ngram_context.share_memory_()
+
+    registration = PleOffloadRegistration(
+        worker_id=1,
+        tp_rank=1,
+        dp_rank=0,
+        host_output_buffers=host_outputs,
+        host_flag_tensors=host_flags,
+        input_ids_buf=input_ids,
+        query_start_loc_buf=query_start_loc,
+        ngram_context_buf=ngram_context,
+    )
+    payload = ForkingPickler.dumps(registration)
+    rebuilt_registration = ForkingPickler.loads(payload)
+finally:
+    torch_mp.set_sharing_strategy(original_strategy)
+
+connector = PleOffloadConnector.__new__(PleOffloadConnector)
+connector._host_output_bufs = host_outputs
+connector._host_flags = host_flags
+connector._reserved_host_storage_filenames = set()
+connector._input_ids_buf = input_ids
+connector._query_start_loc_buf = query_start_loc
+connector._ngram_context_buf = ngram_context
+
+# Exercise the production close ordering without CUDA or transport setup.
+connector._request_thread = None
+connector._pinned_input_buffers = []
+connector._mapped_host_buffers = []
+connector._d2h_event_pool = object()
+connector._registration_socket = None
+connector._zmq_ctx = None
+connector._progress = Progress()
+
+tensors = [
+    *host_outputs.values(),
+    *host_flags.values(),
+    input_ids,
+    query_start_loc,
+    ngram_context,
+]
+assert len(tensors) == 7
+assert len({tensor.untyped_storage()._weak_ref() for tensor in tensors}) == 7
+
+# TP != 0 creates and serializes its input buffers without CUDA registration
+# or the process-lifetime reference used by TP0.
+unpinned_tp_input = input_ids
+assert not connector._pinned_input_buffers
+assert all(
+    unpinned_tp_input is not registered
+    for registered in _PROCESS_LIFETIME_REGISTERED_STORAGE
+)
+
+paths = [shm_path(tensor) for tensor in tensors]
+before = [tensor.clone() for tensor in tensors]
+assert all(path.exists() for path in paths)
+
+connector.close()
+connector.close()
+
+assert all(not path.exists() for path in paths)
+for tensor, expected in zip(tensors, before):
+    assert torch.equal(tensor, expected)
+    tensor.add_(1)
+    assert torch.equal(tensor, expected + 1)
+del tensor, expected
+
+# Remove every original and reconstructed tensor reference. With an unreserved
+# allocator this reaches counter zero after manual unlink and aborts the child.
+connector._host_output_bufs = {}
+connector._host_flags = {}
+connector._input_ids_buf = None
+connector._query_start_loc_buf = None
+connector._ngram_context_buf = None
+del connector
+del rebuilt_registration
+del registration
+del payload
+del unpinned_tp_input
+del tensors
+del before
+del host_outputs
+del host_flags
+del input_ids
+del query_start_loc
+del ngram_context
+gc.collect()
+
+assert all(not path.exists() for path in paths)
+"""
+
+
+def test_close_balanced_filename_storage_lifetime_exits_cleanly() -> None:
+    _require_file_system_shm()
+
+    # Resolve from the connector actually imported by this pytest process. This
+    # lets the red command run this patched test against an unpatched worktree.
+    import_root = Path(connector_module.__file__).resolve().parents[3]
+    env = os.environ.copy()
+    inherited_pythonpath = env.get("PYTHONPATH")
+    env["PYTHONPATH"] = (
+        os.pathsep.join((str(import_root), inherited_pythonpath))
+        if inherited_pythonpath
+        else str(import_root)
+    )
+
+    completed = subprocess.run(
+        [sys.executable, "-c", _BALANCED_LIFETIME_SCRIPT],
+        cwd=import_root,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+
+    assert completed.returncode == 0, (
+        "balanced PLE storage destruction failed "
+        f"(exit code {completed.returncode})\n"
+        f"stdout:\n{completed.stdout}\n"
+        f"stderr:\n{completed.stderr}"
+    )
