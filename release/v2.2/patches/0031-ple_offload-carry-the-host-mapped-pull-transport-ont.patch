+class _BlockingStrError(Exception):
+    def __str__(self) -> str:
+        __import__("threading").Event().wait()
+        return "unreachable"
+
+
+def _blocking_fatal_formatter_case(marker_path: str) -> None:
+    from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+    Path(marker_path).write_text("armed", encoding="utf-8")
+    try:
+        raise _BlockingStrError()
+    except BaseException as error:
+        ple_fail_closed(
+            where="blocking-formatter",
+            rank=1,
+            layer="ple",
+            sequence=3,
+            error=error,
+        )
