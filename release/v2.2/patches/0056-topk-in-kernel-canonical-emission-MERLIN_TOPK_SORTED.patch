+  state |= field(g_cached_sorted_emit.load(std::memory_order_acquire)) << 12;
+  state |= int64_t{7} << 48;
+  state |= int64_t{2} << 56;
   return state;
 #else
   return 0;  // layout version 0: no persistent_topk on ROCm
