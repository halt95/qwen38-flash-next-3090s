+def test_overflow_without_repair_keeps_stale_bytes_semantics(path):
+    """EXACT_DECODE=0 / EXACT_MEDIUM=0 overflow can leave slots the buffered
+    path never wrote this launch; they hold whatever the output tensor held.
+    The Python sort sorts those stale values too, and so must we."""
