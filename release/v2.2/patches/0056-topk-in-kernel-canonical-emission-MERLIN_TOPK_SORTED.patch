+def _run_arm(tmp_path, name, env_over, extra_args=()):
+    out = tmp_path / f"{name}.pt"
+    env = {k: v for k, v in os.environ.items() if not k.startswith("MERLIN_")}
+    env.update(env_over)
+    proc = subprocess.run(
+        [sys.executable, str(_ARM), str(out), *extra_args],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=1800,
+    )
+    assert proc.returncode == 0, proc.stdout[-4000:] + proc.stderr[-4000:]
+    return torch.load(out, weights_only=True), proc.stderr
