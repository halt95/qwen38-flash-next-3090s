@@ -2280,15 +2465,25 @@ __global__ void __launch_bounds__(kThreadsPerBlock, 2)
               row_input, row_output, seq_len, params.det_ties,
               params.tie_recent, params.exact_counters, params.exact_decode);
           if (decode_needs_exact) {
