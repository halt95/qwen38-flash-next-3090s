+class _TopkOps(_FakeOps):
+    """Fake _C: persistent_topk writes a fixed UNSORTED row."""
+
+    def __init__(self, state, row):
+        super().__init__(state)
+        self.row = row
+
+    def persistent_topk(self, logits, lengths, out, ws, k, maxlen):
+        out.copy_(self.row.expand_as(out))
+
+    cooperative_topk = persistent_topk
