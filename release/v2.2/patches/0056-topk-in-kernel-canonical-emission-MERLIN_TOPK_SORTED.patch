+def _run_topk(monkeypatch, state, sort_on, row):
+    fake = _TopkOps(state, row)
+    _install(monkeypatch, fake)
+    monkeypatch.setattr(qsa_indexer, "_QSA_SORT", sort_on)
+    out = torch.empty(2, row.numel(), dtype=torch.int32)
+    qsa_indexer._topk(
+        torch.zeros(2, 64),
+        torch.zeros(2, dtype=torch.int32),
+        4 * row.numel(),
+        4,
+        out,
+        torch.empty(8, dtype=torch.uint8),
+    )
+    return out
