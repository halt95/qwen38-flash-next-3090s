       }
       continue;
     }
@@ -2300,11 +2495,27 @@ __global__ void __launch_bounds__(kThreadsPerBlock, 2)
         cta_in_group, ctas_per_group, barrier_phase, radix_iter, tx,
         params.det_large, params.exact_counters, params.fault_inject_cta,
         params.fault_inject_emit,
-        effective_tie_recent(params.det_ties, params.tie_recent));
+        effective_tie_recent(params.det_ties, params.tie_recent),
+        params.sorted_emit);
     radix_iter++;
   }
 }
 
+// MERLIN_TOPK_SORTED_EMIT for the two host-side fallbacks that bypass
+// persistent_topk_kernel (FilteredTopK, needs >= 128 KiB opt-in smem, and
+// top_k_per_row_decode, needs a cooperative launch that does not fit).  Both
+// are unreachable on a 3090 at the shapes Flash-Next serves (the fallbacks
+// never dispatch there), but with the knob on the Python sort is gone, so the op's
+// contract -- canonical order on EVERY dispatch -- is kept here rather than
+// assumed.  One block per row, launched on the same stream right after the
+// fallback, so it is stream-ordered after the fallback's stores.
+template <int TopK>
+__global__ void __launch_bounds__(kThreadsPerBlock)
+    sorted_emit_rows_kernel(int32_t* __restrict__ output, uint32_t num_rows) {
+  if (blockIdx.x >= num_rows) return;
+  sorted_emit_row<TopK>(output + static_cast<size_t>(blockIdx.x) * TopK);
+}
+
 }  // namespace persistent
 
