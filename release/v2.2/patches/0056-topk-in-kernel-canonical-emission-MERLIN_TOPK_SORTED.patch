@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One ARM of the MERLIN_TOPK_SORTED_EMIT GPU equivalence test (GPU only).
+
+Not a test module: test_merlin_topk_sorted_emit.py runs this file in a fresh
+subprocess per arm, because every persistent_topk switch is a C++ static
+resolved once per process. The caller sets the MERLIN_* environment.
+
+    python merlin_sorted_emit_arm.py OUT.pt [--graph]
+
+Writes {"cells": {name: int32 [rows, k] CPU tensor}, "meta": {...}} with the
+RAW kernel output (no Python sort), the exact counters after the run and the
+toggle_state fields. Inputs are seeded and generated on the CPU, so every arm
+sees the same bytes. The output buffer is PRE-FILLED with a fixed pattern
+before each launch, so a slot a path leaves unwritten (overflow without its
+repair) holds the same stale bytes in every arm.
+
+Cell names starting with `racy_` have a launch-order-dependent SET in the
+production arm (decode overflow with MERLIN_TOPK_EXACT_DECODE=0), so the
+cross-arm equality skips them; the canonical-order check still covers them.
+"""
+
+import sys
+import zlib
+
+import torch
+
+import vllm._custom_ops  # noqa: F401  (loads vllm._C)
+from vllm.v1.worker.e2_toggles import decode_topk_state
+
+WORKSPACE = 1024 * 1024
+
+
+def _row(kind: str, n: int, gen: torch.Generator) -> torch.Tensor:
+    if kind == "ties":
+        levels = torch.tensor([0.0, 0.0, 0.0, 0.5, 1.0, 2.0])
+        return levels[torch.randint(0, 6, (n,), generator=gen)]
+    if kind == "allequal":
+        return torch.full((n,), 1.25)
+    if kind == "signedzero":
+        x = torch.where(
+            torch.rand(n, generator=gen) < 0.5, torch.tensor(0.0), torch.tensor(-0.0)
+        )
+        hot = torch.rand(n, generator=gen) < 0.02
+        x[hot] = torch.rand(int(hot.sum()), generator=gen) + 1.0
+        return x
+    if kind == "neginf":
+        x = torch.randn(n, generator=gen)
+        x[torch.rand(n, generator=gen) < 0.7] = float("-inf")
+        return x
+    if kind == "distinct":
+        return torch.randperm(n, generator=gen).float() * 1e-3
+    if kind == "onebin":
+        return 1.0 + torch.rand(n, generator=gen) * 0.01
+    raise ValueError(kind)
+
+
+# (name, k, row lengths, kind). Lengths are in BLOCKS; 32,768 / 32,769 are the
+# 131,072 / 131,076-token medium/large boundary at compress 4.
+CELLS = [
+    ("trivial_300", 512, [300] * 4, "ties"),
+    ("trivial_512", 512, [512] * 4, "ties"),
+    ("decode_600_ties", 512, [600] * 4, "ties"),
+    ("decode_1024_ties", 512, [1024] * 4, "ties"),  # 4K tokens
+    ("decode_4096_signedzero", 512, [4096] * 4, "signedzero"),
+    ("decode_3000_neginf", 512, [3000] * 4, "neginf"),
+    ("racy_decode_8192_allequal", 512, [8192] * 4, "allequal"),
+    ("racy_decodeovf_7000_onebin", 512, [7000] * 4, "onebin"),
+    ("medium_8193_ties", 512, [8193] * 4, "ties"),
+    ("medium_16384_ties", 512, [16384] * 4, "ties"),  # 65K tokens
+    ("medium_12288_onebin", 512, [12288] * 4, "onebin"),  # medium-path restart
+    ("medium_32768_allequal", 512, [32768] * 4, "allequal"),  # 131,072 tokens
+    ("medium_32768_signedzero", 512, [32768] * 4, "signedzero"),
+    ("large_32769_ties", 512, [32769] * 2, "ties"),  # 131,076 tokens
+    ("large_33750_ties", 512, [33750] * 2, "ties"),  # 135K tokens
+    ("large_50000_allequal", 512, [50000] * 2, "allequal"),
+    ("large_65536_signedzero", 512, [65536] * 2, "signedzero"),
+    ("large_40000_distinct", 512, [40000] * 2, "distinct"),
+    ("mixed_batch_ties", 512, [100, 600, 8192, 8193, 32768, 32769, 40000, 512], "ties"),
+    ("k2048_decode_ties", 2048, [6000] * 2, "ties"),
+    ("k2048_medium_allequal", 2048, [20000] * 2, "allequal"),
+    ("k2048_large_ties", 2048, [45000] * 2, "ties"),
+]
+
+
+def _inputs(name, k, lengths, kind):
+    # crc32, not hash(): str hashing is salted per process, and every arm
+    # must see the same bytes.
+    gen = torch.Generator().manual_seed(zlib.crc32(name.encode()))
+    stride = max(lengths)
+    logits = torch.full((len(lengths), stride), float("-inf"))
+    for r, n in enumerate(lengths):
+        logits[r, :n] = _row(kind, n, gen)
+    prefill = torch.stack(
+        [torch.randperm(4 * k, generator=gen)[:k] - k // 2 for _ in lengths]
+    ).to(torch.int32)
+    return logits, torch.tensor(lengths, dtype=torch.int32), prefill
+
+
+def _launch(logits, lengths, out, ws, k):
+    torch.ops._C.persistent_topk(logits, lengths, out, ws, k, int(lengths.max()))
+
+
+def main() -> int:
+    out_path = sys.argv[1]
+    graph = "--graph" in sys.argv[2:]
+    dev = torch.device("cuda")
+    ws = torch.empty(WORKSPACE, dtype=torch.uint8, device=dev)
+    cells, replays_ok = {}, True
+    for name, k, lengths, kind in CELLS:
+        logits, lens, prefill = _inputs(name, k, lengths, kind)
+        logits, lens = logits.to(dev), lens.to(dev)
+        out = prefill.to(dev).clone()
+        _launch(logits, lens, out, ws, k)
+        torch.cuda.synchronize()
+        cells[name] = out.cpu().clone()
+        if graph:
+            static_out = prefill.to(dev).clone()
+            g = torch.cuda.CUDAGraph()
+            s = torch.cuda.Stream()
+            s.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(s):
+                _launch(logits, lens, static_out, ws, k)  # warm on a side stream
+            torch.cuda.current_stream().wait_stream(s)
+            with torch.cuda.graph(g):
+                _launch(logits, lens, static_out, ws, k)
+            static_out.copy_(prefill.to(dev))
+            g.replay()
+            torch.cuda.synchronize()
+            if not name.startswith("racy_"):
+                replays_ok &= torch.equal(static_out.cpu(), cells[name])
+    counters = torch.zeros(
+        torch.ops._C.persistent_topk_exact_counters_slots(),
+        dtype=torch.int64,
+        device=dev,
+    )
+    torch.ops._C.persistent_topk_exact_counters(counters, 0, 1)
+    toggles = decode_topk_state(int(torch.ops._C.persistent_topk_toggle_state()))
+    meta = {
+        "counters": counters.cpu().tolist(),
+        "toggle_sorted_emit": toggles["sorted_emit"]
+        if isinstance(toggles, dict)
+        else toggles,
+        "toggles": str(toggles),
+        "graph_replays_match_eager": bool(replays_ok),
+    }
+    torch.save({"cells": cells, "meta": meta}, out_path)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
