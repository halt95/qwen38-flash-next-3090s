+def test_signed_zero_canonicalisation_would_change_the_set():
+    """Why #55122's +-0.0 change is NOT adopted: with the pivot at zero, +0.0
+    currently outranks -0.0 regardless of index; treating them as a tie hands
+    the choice to the index rule and changes the SET."""
+    # +0.0 at the OLD end, -0.0 at the recent end, the cutoff inside zero.
+    x = np.array([0.0] * 100 + [-0.0] * 600 + [1.0] * 400, dtype=np.float32)
+    ours, *_ = reference_select(ordered_key(x), 512, True)
+    canon = ordered_key(np.where(x == 0, np.float32(0.0), x))  # -0 -> +0
+    theirs, *_ = reference_select(canon, 512, True)
+    assert not np.array_equal(ours, theirs)
+    assert set(range(0, 100)) <= set(ours.tolist())  # all +0.0 kept today
+    assert not set(range(0, 100)) & set(theirs.tolist())  # all lost after
