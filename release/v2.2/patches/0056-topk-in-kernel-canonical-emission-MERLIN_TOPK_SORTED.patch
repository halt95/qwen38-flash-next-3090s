+// ---------------------------------------------------------------------------
+// MERLIN_TOPK_SORTED_EMIT: every persistent_topk
+// row leaves the op in the canonical order the Python MERLIN_QSA_SORT imposes
+// (ascending index, padding last as -1), so qsa_indexer.py can drop that sort.
+// See sorted_emit_row() in persistent_topk.cuh for the contract; the selected
+// SET is never touched.  Resolved once per process like every switch here, so
+// it is a launch constant a cudagraph bakes in.  Default OFF: the maintainer
+// promotes after reference-host qualification.
+//
+// This std::getenv is the single source of truth.  Python does not parse the
+// variable to decide anything: qsa_indexer.py asks THIS cache, through
+// persistent_topk_toggle_state() field 6, after its first launch -- so the
+// Python sort is skipped only when the kernel that ran says it sorted.
+// ---------------------------------------------------------------------------
+bool sorted_emit_enabled() {
+  static const bool enabled = [] {
+    const char* raw = std::getenv("MERLIN_TOPK_SORTED_EMIT");
+    return publish_cached(
+        g_cached_sorted_emit,
+        (raw != nullptr && raw[0] != '\0') ? (std::atoi(raw) != 0) : false);
+  }();
+  return enabled;
+}
