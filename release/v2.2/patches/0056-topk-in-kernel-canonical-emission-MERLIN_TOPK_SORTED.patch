@@ -0,0 +1,904 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MERLIN_TOPK_SORTED_EMIT: in-kernel canonical emission.
+
+The claim under test: with the knob on, every row persistent_topk returns is
+BYTE-IDENTICAL to what the knob-off kernel returns after the Python
+MERLIN_QSA_SORT (`qsa_indexer._canonical`: ascending, padding last as -1), on
+every path the tree dispatches -- trivial, decode (buffered and exact restart),
+medium (buffered and exact restart), large (deterministic and the legacy
+tail) and the host fallbacks -- with the SAME selected set, so production
+outputs cannot change.
+
+Two halves:
+
+CPU (runnable offline, no GPU):
+  * a reference model of each path's selection + tie rule + emission LAYOUT
+    (the arrival-order layouts are modelled as seeded permutations; the
+    ascending layouts -- trivial, restart, large deterministic -- are ports of the kernel's
+    own slot arithmetic, including the host's chunking);
+  * a port of sorted_emit_row() (bitmap words, popcount exclusive scan, bit
+    walk, -1 fill, counting-sort fallback);
+  * property tests: sorted_emit_row(emission) == _canonical(emission)
+    byte-for-byte on random rows with heavy ties, +-0.0, -inf, and lengths
+    across 512/513, 8192/8193, 32,768/32,769 (131,072/131,076 tokens), for
+    the paths the kernel re-emits; native emission == _canonical(native) for
+    the paths it skips; and every path's set == the exact top-k under the
+    effective tie rule;
+  * pathological rows (duplicates, stale, out-of-range, INT32_MAX, odd
+    negatives) through the fallback;
+  * FAILING CONTROLS: a canonicaliser without duplicate detection, without the
+    -1 fill, the identity (sort skipped), and a flipped tie rule each FAIL the
+    same checks -- so the checks can fail;
+  * the Python gate: kernel_sorted_emit() reads toggle_state field 6, latches,
+    refuses layout 1, never latches `uninit`; _topk skips the sort only then.
+
+GPU (reference host; written here, run on a GPU host): the knob is a
+process-lifetime C++ static, so each arm is a SUBPROCESS
+(`merlin_sorted_emit_arm.py`). Knob-on raw output must equal knob-off output
+after `_canonical`, cell by cell, as int32 bytes; the failing controls (knob
+off without the sort, and the tie rule flipped) must DIFFER.
+
+    pytest --noconftest tests/kernels/test_merlin_topk_sorted_emit.py
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+import torch
+
+qsa_indexer = pytest.importorskip(
+    "vllm.models.qwen4_exp.nvidia.ops.qsa_indexer",
+    reason="qsa_indexer needs triton (the reference-host venv has it; offline runs use the shim)",
+)
+
+INT32_MAX = 0x7FFFFFFF
+
+# Kernel constants (csrc/libtorch_stable/persistent_topk.cuh).
+RADIX_THRESHOLD = 32768
+HIST2048_THRESHOLD = 8192
+MAX_BUFFERED_ITEMS = 4096
+DBUF = (8192 - 8 - 2 * (256 + 128)) // 2  # 3708
+BITMAP_WORDS = 1024
+BITMAP_BITS = 32 * BITMAP_WORDS
+K_SMEM_MEDIUM = 35968
+K_FIXED_SMEM_LARGE = ((256 + 256 + 5) * 4 + 15) & ~15
+SMEM_OPTIN_3090 = 101376
+
+
+def canonical(row: np.ndarray) -> np.ndarray:
+    """The REAL Python reference: qsa_indexer._canonical on an int32 row."""
+    t = torch.from_numpy(np.ascontiguousarray(row, dtype=np.int32)).view(1, -1)
+    return qsa_indexer._canonical(t).view(-1).numpy()
+
+
+# ============================================================ keys ==========
+def ordered_key(x: np.ndarray) -> np.ndarray:
+    """convert_to_uint32_v2: +0.0 orders ABOVE -0.0 (we do not adopt #55122's
+    signed-zero canonicalisation)."""
+    bits = np.ascontiguousarray(x, dtype=np.float32).view(np.uint32)
+    neg = (bits & np.uint32(0x80000000)) != 0
+    return np.where(neg, ~bits, bits | np.uint32(0x80000000)).astype(np.uint32)
+
+
+def effective_tie_recent(det_ties: bool, tie_recent: bool) -> bool:
+    return tie_recent if det_ties else True
+
+
+# ======================================================= dispatch ===========
+def path_of(seq_len: int, top_k: int) -> str:
+    if seq_len > RADIX_THRESHOLD:
+        return "large"
+    if seq_len <= top_k:
+        return "trivial"
+    if seq_len <= HIST2048_THRESHOLD:
+        return "decode"
+    return "medium"
+
+
+# ====================================================== reference ===========
+def reference_select(keys: np.ndarray, top_k: int, keep_recent: bool):
+    """Exact top-k by key; among elements EQUAL to the k-th key keep the
+    highest indices (most-recent-wins) or the lowest (oldest-wins).
+    Returns (selected index set as sorted int64, pivot key, #eq kept, #eq)."""
+    n = keys.size
+    assert n >= top_k
+    pivot = np.sort(keys)[::-1][top_k - 1]
+    gt = np.nonzero(keys > pivot)[0]
+    eq = np.nonzero(keys == pivot)[0]
+    need = top_k - gt.size
+    kept_eq = eq[-need:] if keep_recent else eq[:need]
+    return np.sort(np.concatenate([gt, kept_eq])), pivot, need, eq.size
+
+
+# ================================================= path emissions ===========
+def emit_trivial(seq_len: int, top_k: int) -> np.ndarray:
+    """persistent_topk_kernel trivial branch, verbatim."""
+    i = np.arange(top_k)
+    return np.where(i < seq_len, i, -1).astype(np.int32)
+
+
+def emit_buffered(keys, top_k, det_ties, tie_recent, rng, candidates=None):
+    """Decode-/medium-buffered emission LAYOUT: winners by warp arrival
+    (a seeded permutation) in slots [0, TopK - fin); a partially kept pivot
+    group at [TopK - fin + rank] (rank by index in the tie direction when
+    TIE_DET, arrival order otherwise).  `candidates` is the decode path's
+    padded range: n_vec * 4 elements, -inf past seq_len."""
+    if candidates is not None:
+        keys = candidates
+    n = keys.size
+    pivot = np.sort(keys)[::-1][top_k - 1]
+    gt = np.nonzero(keys > pivot)[0]
+    eq = np.nonzero(keys == pivot)[0]
+    need = top_k - gt.size
+    out = np.full(top_k, -7, dtype=np.int64)  # never survives: all slots written
+    if need == eq.size:  # whole pivot group kept: no pass-3 tie cut
+        winners = np.concatenate([gt, eq])
+        out[:] = rng.permutation(winners)
+        return out.astype(np.int32)
+    out[: top_k - need] = rng.permutation(gt)
+    if det_ties:
+        ranked = eq[::-1] if tie_recent else eq  # rank 0 = first kept
+        out[top_k - need :] = ranked[:need]
+    else:  # atomicAdd(&sFIN, -1): first `need` arrivals keep a slot
+        out[top_k - need :] = rng.permutation(eq)[:need]
+    assert n >= top_k
+    return out.astype(np.int32)
+
+
+def emit_restart(keys: np.ndarray, top_k: int, tie_recent: bool) -> np.ndarray:
+    """medium_exact_restart(): four 8-bit radix rounds, the two-round index
+    tie walk, then flag + exclusive prefix over 1,024-wide tiles in index
+    order.  A port of the kernel's arithmetic, not a restatement of the rule."""
+    length = keys.size
+    prefix, remaining, tie_total = 0, top_k, 0
+    masks = [0, 0xFF000000, 0xFFFF0000, 0xFFFFFF00]
+    for rnd in range(4):
+        shift = 24 - 8 * rnd
+        sel = (keys & np.uint32(masks[rnd])) == np.uint32(prefix)
+        hist = np.bincount(
+            (keys[sel] >> np.uint32(shift)) & np.uint32(0xFF), minlength=256
+        )
+        count_above = 0
+        for b in range(255, -1, -1):
+            if count_above + hist[b] >= remaining:
+                remaining -= count_above
+                prefix |= b << shift
+                if rnd == 3:
+                    tie_total = int(hist[b])
+                break
+            count_above += int(hist[b])
+        else:
+            raise AssertionError("no crossing bin")
+    pivot, equal_count = np.uint32(prefix), remaining
+    tie_cut = 0 if tie_recent else 0xFFFFFFFF
+    if tie_total > equal_count:
+        eq_idx = np.nonzero(keys == pivot)[0]
+        need = equal_count
+        hist = np.bincount((eq_idx >> 8) & 0xFF, minlength=256)
+        order = range(255, -1, -1) if tie_recent else range(256)
+        count_above = 0
+        for b in order:
+            if count_above + hist[b] >= need:
+                high, need = b, need - count_above
+                break
+            count_above += int(hist[b])
+        in_high = eq_idx[((eq_idx >> 8) & 0xFF) == high]
+        hist = np.bincount(in_high & 0xFF, minlength=256)
+        count_above = 0
+        for b in order:
+            if count_above + hist[b] >= need:
+                tie_cut = (high << 8) | b
+                break
+            count_above += int(hist[b])
+    out = np.full(top_k, -9, dtype=np.int64)
+    base_rank = 0
+    idx_all = np.arange(length)
+    keep_tie = idx_all >= tie_cut if tie_recent else idx_all <= tie_cut
+    flag = (keys > pivot) | ((keys == pivot) & keep_tie)
+    for base in range(0, -(-length // 1024) * 1024, 1024):
+        f = flag[base : base + 1024]
+        rank = np.cumsum(f) - f  # BlockScan ExclusiveSum
+        for t in np.nonzero(f)[0]:
+            pos = base_rank + rank[t]
+            assert pos < top_k, "restart fault path"
+            out[pos] = base + t
+        base_rank += int(f.sum())
+    assert base_rank == top_k
+    return out.astype(np.int32)
+
+
+def large_geometry(stride: int, num_rows: int) -> tuple[int, int]:
+    """launch_persistent_topk's ctas_per_group / chunk_size, 3090 opt-in."""
+    if num_rows <= 4:
+        eff = min(SMEM_OPTIN_3090, K_SMEM_MEDIUM)
+    elif num_rows <= 8:
+        eff = min(SMEM_OPTIN_3090, 48 * 1024)
+    else:
+        eff = SMEM_OPTIN_3090
+    max_chunk = (eff - K_FIXED_SMEM_LARGE) // 4
+    vec = 4 if stride % 4 == 0 else (2 if stride % 2 == 0 else 1)
+    max_chunk = (max_chunk // vec) * vec
+    max_chunk = max(max_chunk, vec * 1024)
+    ctas = -(-stride // max_chunk)
+    chunk = -(-stride // ctas)
+    chunk = -(-chunk // vec) * vec
+    chunk = min(chunk, max_chunk)
+    return ctas, chunk
+
+
+def emit_large_det(keys, top_k, tie_recent, stride, num_rows) -> np.ndarray:
+    """radix_emit_deterministic(): per-CTA gt/eq counts, the directional CTA
+    walk handing out `equal_needed`, cut_rank/keep_width, and the slot
+    gt_base + eq_keep_base + gt_rank + kept_eq_before."""
+    seq_len = keys.size
+    ctas, chunk = large_geometry(stride, num_rows)
+    assert 4 * ctas <= 256, "host gate would route to the legacy tail"
+    pivot = np.sort(keys)[::-1][top_k - 1]
+    equal_needed = top_k - int((keys > pivot).sum())
+    chunks = [keys[c * chunk : min((c + 1) * chunk, seq_len)] for c in range(ctas)]
+    gt = [int((ch > pivot).sum()) for ch in chunks]
+    eq = [int((ch == pivot).sum()) for ch in chunks]
+    keep = [0] * ctas
+    seen = 0
+    order = range(ctas - 1, -1, -1) if tie_recent else range(ctas)
+    for c in order:
+        want = max(equal_needed - seen, 0)
+        keep[c] = min(want, eq[c])
+        seen += eq[c]
+    out = np.full(top_k, -11, dtype=np.int64)
+    for c, ch in enumerate(chunks):
+        gt_base, eq_keep_base = sum(gt[:c]), sum(keep[:c])
+        cut_rank = (eq[c] - keep[c]) if tie_recent else 0
+        f_gt = (ch > pivot).astype(np.int64)
+        f_eq = (ch == pivot).astype(np.int64)
+        gt_rank = np.cumsum(f_gt) - f_gt  # exclusive, ascending element index
+        eq_rank = np.cumsum(f_eq) - f_eq
+        sel = (f_gt == 1) | (
+            (f_eq == 1) & (eq_rank >= cut_rank) & (eq_rank - cut_rank < keep[c])
+        )
+        kept_before = np.clip(eq_rank - cut_rank, 0, keep[c])
+        slot = gt_base + eq_keep_base + gt_rank + kept_before
+        assert (slot[sel] < top_k).all(), "X4 fault path"
+        out[slot[sel]] = c * chunk + np.nonzero(sel)[0]
+    return out.astype(np.int32)
+
+
+def emit_large_legacy(keys, top_k, rng) -> np.ndarray:
+    """v2.0.1 tail: > pivot by per-CTA arrival, then pivot-equal by global
+    arrival until TopK -- set racy on ties, order racy everywhere."""
+    pivot = np.sort(keys)[::-1][top_k - 1]
+    gt = np.nonzero(keys > pivot)[0]
+    eq = np.nonzero(keys == pivot)[0]
+    need = top_k - gt.size
+    return np.concatenate([rng.permutation(gt), rng.permutation(eq)[:need]]).astype(
+        np.int32
+    )
+
+
+# ================================================ sorted_emit_row() =========
+def sorted_emit_row(
+    row: np.ndarray, *, dup_check=True, fill=True, force_fast=False
+) -> np.ndarray:
+    """Port of persistent_topk.cuh sorted_emit_row(). The keyword switches
+    exist ONLY to build the failing controls."""
+    top_k = row.size
+    vals = row.astype(np.int64)
+    bitmap = [0] * BITMAP_WORDS
+    fallback = False
+    for v in vals:  # E1 (the atomicOr order cannot matter: OR is commutative)
+        if v >= 0:
+            if v < BITMAP_BITS:
+                bit = 1 << (int(v) & 31)
+                if bitmap[int(v) >> 5] & bit and dup_check:
+                    fallback = True
+                bitmap[int(v) >> 5] |= bit
+            elif not force_fast:
+                fallback = True
+    out = row.astype(np.int64).copy()  # slots the kernel does not write keep bytes
+    if not fallback:
+        pops = [bin(w).count("1") for w in bitmap]
+        excl = np.concatenate([[0], np.cumsum(pops)[:-1]])
+        total = int(sum(pops))
+        for tx, w in enumerate(bitmap):  # one bitmap word per thread
+            pos = int(excl[tx])
+            while w:
+                b = (w & -w).bit_length() - 1  # __ffs - 1
+                if pos < top_k:
+                    out[pos] = (tx << 5) | b
+                pos += 1
+                w &= w - 1
+        if fill:
+            out[total:] = -1
+    else:
+        key = np.where(vals < 0, INT32_MAX, vals)
+        idx = np.arange(top_k)
+        less = (key[None, :] < key[:, None]).sum(axis=1)
+        tie_before = (
+            (key[None, :] == key[:, None]) & (idx[None, :] < idx[:, None])
+        ).sum(axis=1)
+        rank = less + tie_before
+        out[rank] = np.where(key == INT32_MAX, -1, key)
+    return out.astype(np.int32)
+
+
+# ================================================== the harness =============
+def make_row(seq_len: int, kind: str, rng: np.random.Generator) -> np.ndarray:
+    if kind == "heavy_ties":  # relu(q.k) sums: many exact zeros, few levels
+        levels = np.array([0.0, 0.0, 0.0, 0.5, 1.0, 2.0], dtype=np.float32)
+        return levels[rng.integers(0, levels.size, seq_len)]
+    if kind == "signed_zero":  # +0.0 / -0.0 at the cutoff
+        x = np.where(rng.random(seq_len) < 0.5, np.float32(0.0), np.float32(-0.0))
+        x = x.astype(np.float32)
+        hot = rng.random(seq_len) < 0.02
+        x[hot] = rng.random(int(hot.sum())).astype(np.float32) + 1.0
+        return x
+    if kind == "neg_inf":  # masked blocks
+        x = rng.standard_normal(seq_len).astype(np.float32)
+        x[rng.random(seq_len) < 0.7] = -np.inf
+        return x
+    if kind == "all_equal":
+        return np.full(seq_len, 1.25, dtype=np.float32)
+    if kind == "distinct":
+        return rng.permutation(seq_len).astype(np.float32) * np.float32(1e-3)
+    if kind == "one_coarse_bin":  # medium / decode overflow class
+        return (1.0 + rng.random(seq_len) * 0.01).astype(np.float32)
+    raise ValueError(kind)
+
+
+def emissions(
+    seq_len,
+    top_k,
+    kind,
+    det_ties,
+    tie_recent,
+    rng,
+    *,
+    num_rows=1,
+    exact_medium=True,
+    exact_decode=False,
+    det_large=True,
+):
+    """(path, native emission, re-emitted by sorted_emit_row?) for one row."""
+    x = make_row(seq_len, kind, rng)
+    keys = ordered_key(x)
+    path = path_of(seq_len, top_k)
+    eff = effective_tie_recent(det_ties, tie_recent)
+    if path == "trivial":
+        return path, x, emit_trivial(seq_len, top_k), False
+    if path == "decode":
+        n_pad = -(-seq_len // 4) * 4
+        cand = ordered_key(
+            np.concatenate([x, np.full(n_pad - seq_len, -np.inf, dtype=np.float32)])
+        )
+        top_bin_pop = _half_bin_population_at_threshold(cand, top_k)
+        if top_bin_pop > DBUF and exact_decode:
+            return "decode-restart", x, emit_restart(keys, top_k, eff), False
+        if top_bin_pop > DBUF:
+            return "decode-overflow", x, None, True  # modelled separately
+        return (
+            path,
+            x,
+            emit_buffered(keys, top_k, det_ties, tie_recent, rng, candidates=cand),
+            True,
+        )
+    if path == "medium":
+        coarse_pop = _coarse_bin_population_at_threshold(keys, x, top_k)
+        if coarse_pop > MAX_BUFFERED_ITEMS and exact_medium:
+            return "medium-restart", x, emit_restart(keys, top_k, eff), False
+        if coarse_pop > MAX_BUFFERED_ITEMS:
+            return "medium-overflow", x, None, True
+        return path, x, emit_buffered(keys, top_k, det_ties, tie_recent, rng), True
+    ctas, _ = large_geometry(seq_len, num_rows)
+    if det_large and 4 * ctas <= 256:
+        return path, x, emit_large_det(keys, top_k, eff, seq_len, num_rows), False
+    return "large-legacy", x, emit_large_legacy(keys, top_k, rng), True
+
+
+def _half_key16(x: np.ndarray) -> np.ndarray:
+    h = x.astype(np.float16).view(np.uint16)
+    return np.where(h & 0x8000, ~h, h | 0x8000).astype(np.uint16)
+
+
+def _half_bin_population_at_threshold(cand_keys: np.ndarray, top_k: int) -> int:
+    x = cand_keys.copy()
+    # back to float for the half bin: invert ordered_key
+    neg = (x & np.uint32(0x80000000)) == 0
+    bits = np.where(neg, ~x, x & np.uint32(0x7FFFFFFF)).astype(np.uint32)
+    f = bits.view(np.float32)
+    b = _half_key16(f) >> 5
+    hist = np.bincount(b, minlength=2048)
+    suf = np.cumsum(hist[::-1])[::-1]
+    thr = int(np.nonzero(suf >= top_k)[0].max())
+    return int(hist[thr]) if suf[thr] - hist[thr] < top_k else 0
+
+
+def _coarse_bin_population_at_threshold(keys, x, top_k) -> int:
+    """histogram_256_topk's M1: threshold = the bin with suffix > TopK and
+    next suffix <= TopK (strict, unlike decode); a next suffix of exactly TopK
+    resolves the row without collecting, so nothing overflows."""
+    b = _half_key16(x) >> 8
+    hist = np.bincount(b, minlength=256)
+    suf = np.cumsum(hist[::-1])[::-1]
+    thr = int(np.nonzero(suf > top_k)[0].max())
+    above = suf[thr] - hist[thr]
+    return int(hist[thr]) if above != top_k else 0
+
+
+def assert_bytes(a: np.ndarray, b: np.ndarray, what: str):
+    a32 = np.ascontiguousarray(a, dtype=np.int32)
+    b32 = np.ascontiguousarray(b, dtype=np.int32)
+    assert a32.tobytes() == b32.tobytes(), what
+
+
+# Lengths in BLOCKS (QSA k=512 blocks, compress 4): 131,072 tokens = 32,768
+# blocks (medium's last), 131,076 = 32,769 (large's first).
+BOUNDARY_LENGTHS = [
+    1,
+    300,
+    511,
+    512,
+    513,
+    700,
+    4096,
+    8191,
+    8192,
+    8193,
+    12000,
+    32767,
+    32768,
+    32769,
+    32770,
+    33750,
+    50000,
+]
+KINDS = [
+    "heavy_ties",
+    "signed_zero",
+    "neg_inf",
+    "all_equal",
+    "distinct",
+    "one_coarse_bin",
+]
+TIE_CONFIGS = [(True, True), (True, False), (False, False)]  # (TIE_DET, RECENT)
+
+
+def _cases(top_k):
+    for seq_len in BOUNDARY_LENGTHS:
+        for kind in KINDS:
+            if seq_len > 8192 and kind in ("distinct",) and seq_len % 3:
+                continue  # keep the grid affordable
+            yield seq_len, kind
+
+
+@pytest.mark.parametrize("top_k", [512, 2048])
+@pytest.mark.parametrize("det_ties,tie_recent", TIE_CONFIGS)
+@pytest.mark.parametrize(
+    "exact_decode,det_large",
+    [(False, True), (True, False)],  # production / the two other arms
+)
+def test_sorted_emission_equals_python_sort_every_path(
+    top_k, det_ties, tie_recent, exact_decode, det_large
+):
+    """THE property: knob-on bytes == knob-off bytes after `_canonical`, and
+    the set is the exact top-k under the effective rule (deterministic
+    configurations) -- on every path at every boundary length."""
+    rng = np.random.default_rng(1000 * top_k + 10 * det_ties + tie_recent)
+    seen_paths = set()
+    for seq_len, kind in _cases(top_k):
+        path, x, native, reemitted = emissions(
+            seq_len,
+            top_k,
+            kind,
+            det_ties,
+            tie_recent,
+            rng,
+            exact_decode=exact_decode,
+            det_large=det_large,
+        )
+        seen_paths.add(path)
+        if native is None:
+            continue  # overflow-without-repair rows: see the stale-slot test
+        knob_off_after_sort = canonical(native)
+        knob_on = sorted_emit_row(native) if reemitted else native
+        assert_bytes(
+            knob_on, knob_off_after_sort, f"{path} len={seq_len} kind={kind} k={top_k}"
+        )
+        # set check against the independent reference
+        if path == "trivial":
+            continue
+        keys = ordered_key(x)
+        if path == "decode":
+            n_pad = -(-seq_len // 4) * 4
+            keys = ordered_key(
+                np.concatenate([x, np.full(n_pad - seq_len, -np.inf, dtype=np.float32)])
+            )
+        racy = (path in ("decode", "medium") and not det_ties) or path == "large-legacy"
+        ref, pivot, need, n_eq = reference_select(
+            keys, top_k, effective_tie_recent(det_ties, tie_recent)
+        )
+        got = np.sort(knob_on.astype(np.int64))
+        if racy and need < n_eq:
+            # racy tie membership: only the value multiset is determined
+            assert np.array_equal(np.sort(keys[got]), np.sort(keys[ref]))
+        else:
+            assert np.array_equal(got, ref), f"{path} len={seq_len} kind={kind}"
+    want = {"trivial", "decode", "medium", "medium-restart"}
+    want |= {"decode-restart", "large-legacy"} if exact_decode else {"large"}
+    assert want <= seen_paths, seen_paths
+
+
+@pytest.mark.parametrize("det_ties,tie_recent", TIE_CONFIGS)
+def test_restart_and_large_det_are_already_canonical(det_ties, tie_recent):
