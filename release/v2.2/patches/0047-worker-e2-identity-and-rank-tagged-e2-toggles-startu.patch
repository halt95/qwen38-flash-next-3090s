diff --git a/tests/test_merlin_e2_toggles.py b/tests/test_merlin_e2_toggles.py
new file mode 100644
index 0000000000..3cd3c1f80e
--- /dev/null
+++ b/tests/test_merlin_e2_toggles.py
@@ -0,0 +1,420 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for vllm/v1/worker/e2_toggles.py.
+
+Parsing parity with the C++ (glibc atoi) and Python (int()) readers including
+odd spellings; the effective map for the toggles-ON and knob-absent boots;
+once-only emission; emission with the counter log OFF; deferral while a C++
+static is uninitialised; the n-a paths; and a line the smoke can tokenise.
+
+    pytest --noconftest tests/test_merlin_e2_toggles.py
+"""
+
+import ctypes
+import ctypes.util
+import logging
+import os
+import sys
+
+import pytest
+
+from vllm.v1.worker import e2_toggles as t
+
+
+# ------------------------------------------------------------ atoi parity ----
+ATOI_CASES = [
+    (b"1", 1),
+    (b"0", 0),
+    (b"00", 0),
+    (b"01", 1),
+    (b"true", 0),  # FULL_K=true reads as OFF (the release note's warning)
+    (b"yes", 0),
+    (b"on", 0),
+    (b" 1", 1),
+    (b"\t\n\v\f\r1", 1),
+    (b"+1", 1),
+    (b"-1", -1),
+    (b"-0", 0),
+    (b"+ 1", 0),  # sign then space: no digits
+    (b"1abc", 1),
+    (b"1 ", 1),
+    (b"0x1", 0),
+    (b"1.9", 1),
+    (b"2147483647", 2147483647),
+    (b"2147483648", -2147483648),  # (int) keeps the low 32 bits
+    (b"4294967296", 0),  # 2^32 -> 0: set but reads OFF
+    (b"4294967297", 1),
+    (b"99999999999999999999", -1),  # strtol clamps to LONG_MAX -> low 32 = -1
+    (b"-99999999999999999999", 0),  # LONG_MIN -> low 32 = 0
+    (b"\xc2\xa01", 0),  # NBSP is not C-locale whitespace
+    (b"\xef\xbc\x91", 0),  # fullwidth digit one: not a C digit
+    (b"", 0),
+]
+
+
+@pytest.mark.parametrize("raw,want", ATOI_CASES)
+def test_c_atoi_table(raw, want):
+    assert t.c_atoi(raw) == want
+
+
+def _glibc():
+    if not sys.platform.startswith("linux"):
+        return None
+    name = ctypes.util.find_library("c")
+    if not name:
+        return None
+    libc = ctypes.CDLL(name)
+    gnu = getattr(libc, "gnu_get_libc_version", None)
+    if gnu is None:
+        return None
+    libc.atoi.restype = ctypes.c_int
+    libc.atoi.argtypes = [ctypes.c_char_p]
+    return libc
+
+
+@pytest.mark.skipif(_glibc() is None, reason="parity against the real atoi needs glibc")
+@pytest.mark.parametrize("raw,want", ATOI_CASES)
+def test_c_atoi_matches_glibc(raw, want):
+    assert t.c_atoi(raw) == _glibc().atoi(raw)
+
+
+@pytest.mark.parametrize(
+    "raw,unset_value,want",
+    [
+        (None, False, False),
+        (b"", False, False),  # empty = unset for the default-OFF getters
+        (None, True, True),
+        (b"", True, True),  # EXACT_MEDIUM= / DET_LARGE= keep the default ON
+        (b"0", True, False),
+        (b"1", False, True),
+        (b"true", False, False),
+        (b"true", True, False),  # a non-numeric value turns a default-ON switch OFF
+        (b"4294967296", False, False),
+        (b"-1", False, True),
+    ],
+)
+def test_cxx_switch(raw, unset_value, want):
+    assert t.cxx_switch(raw, unset_value) is want
+
+
+@pytest.mark.parametrize(
+    "raw,want",
+    [
+        (None, "0"),
+        ("0", "0"),
+        ("1", "1"),
+        ("2", "1"),
+        (" 1 ", "1"),
+        ("+1", "1"),
+        ("-0", "0"),
+        ("1_0", "1"),
+        ("１", "1"),  # Python int() accepts non-ASCII digits
+        ("true", "invalid"),  # envs.py raises: the engine would not boot
+        ("", "invalid"),
+        ("0x1", "invalid"),
+    ],
+)
+def test_qsa_sort_value(raw, want):
+    assert t.qsa_sort_value(raw) == want
+
+
+def test_qsa_sort_value_matches_envs_reader(monkeypatch):
+    """The mirror IS the reader: same int() call as vllm/envs.py:2372."""
+    import vllm.envs as envs
+
+    for raw in ("0", "1", " 1 ", "1_0", "１", "-0"):
+        monkeypatch.setenv("MERLIN_QSA_SORT", raw)
+        assert t.qsa_sort_value(raw) == ("1" if envs.MERLIN_QSA_SORT else "0")
+    for raw in ("true", ""):
+        monkeypatch.setenv("MERLIN_QSA_SORT", raw)
+        with pytest.raises(ValueError):
+            _ = envs.MERLIN_QSA_SORT
+        assert t.qsa_sort_value(raw) == "invalid"
+
+
+def test_effective_tie_recent():
+    assert t.effective_tie_recent(False, False) is True
+    assert t.effective_tie_recent(False, True) is True
+    assert t.effective_tie_recent(True, False) is False
+    assert t.effective_tie_recent(True, True) is True
+
+
+# ------------------------------------------------------- effective maps ----
+def _env(values):
+    def cxx(name):
+        v = values.get(name)
+        return None if v is None else v.encode()
+
+    return cxx, values.get
+
+
+ON = {
+    "MERLIN_FULL_K": "1",
+    "MERLIN_QSA_SORT": "1",
+    "MERLIN_TIE_DET": "1",
+    "MERLIN_TIE_RECENT": "1",
+}
+ON_MAP = {
+    "full_k": "1",
+    "qsa_sort": "1",
+    "tie_det": "1",
+    "tie_recent": "1",
+    "tie_recent_effective": "1",
+    "exact_medium": "1",
+    "exact_decode": "0",
+    "det_large": "1",
+}
+ABSENT_MAP = {
+    "full_k": "0",
+    "qsa_sort": "0",
+    "tie_det": "0",
+    "tie_recent": "0",
+    "tie_recent_effective": "1",
+    "exact_medium": "1",
+    "exact_decode": "0",
+    "det_large": "1",
+}
+
+
+def test_effective_map_toggles_on():
+    raw, eff = t.environ_view(*_env(ON))
+    assert eff == ON_MAP
+    assert raw["MERLIN_TOPK_EXACT_MEDIUM"] == "unset"
+    assert raw["MERLIN_FULL_K"] == "1"
+
+
+def test_effective_map_knob_absent():
+    raw, eff = t.environ_view(*_env({}))
+    assert eff == ABSENT_MAP
+    assert set(raw.values()) == {"unset"}
+
+
+def test_effective_map_odd_spellings():
+    _, eff = t.environ_view(
+        *_env(
+            {
+                "MERLIN_FULL_K": "true",  # C++ atoi -> OFF
+                "MERLIN_TIE_DET": " 1",
+                "MERLIN_TIE_RECENT": "0",
+                "MERLIN_TOPK_EXACT_MEDIUM": "",  # empty -> default ON
+                "MERLIN_TOPK_DET_LARGE": "off",  # atoi("off") == 0 -> OFF
+                "MERLIN_QSA_SORT": "true",
+            }
+        )
+    )
+    assert eff["full_k"] == "0"
+    assert eff["tie_det"] == "1"
+    assert eff["tie_recent_effective"] == "0"  # TIE_DET=1 TIE_RECENT=0 = oldest-wins
+    assert eff["exact_medium"] == "1"
+    assert eff["det_large"] == "0"
+    assert eff["qsa_sort"] == "invalid"
+
+
+def test_encode_raw():
+    assert t.encode_raw(None) == "unset"
+    assert t.encode_raw(b"1") == "1"
+    assert t.encode_raw(b"") == '""'
+    assert t.encode_raw(b"unset") == '"unset"'
+    assert t.encode_raw(b"1 2") == '"1\\x202"'
+    assert t.encode_raw(b'a"b') == '"a\\x22b"'
+    for v in (b"", b" x ", b"\xff", b"a\tb"):
+        assert " " not in t.encode_raw(v)
+
+
+# ----------------------------------------------------------- cpp decode ----
+def _pack(fields, version=1, count=6):
+    state = 0
+    for i, f in enumerate(fields):
+        state |= f << (2 * i)
+    return state | (count << 48) | (version << 56)
+
+
+def test_decode_topk_state():
+    assert t.decode_topk_state(_pack([1, 1, 1, 1, 0, 1])) == {
+        "tie_det": "1",
+        "tie_recent": "1",
+        "tie_recent_effective": "1",
+        "exact_medium": "1",
+        "exact_decode": "0",
+        "det_large": "1",
+    }
+    assert t.decode_topk_state(_pack([2, 2, 2, 1, 2, 2]))["tie_det"] == "uninit"
+    assert t.decode_topk_state(_pack([3, 0, 0, 0, 0, 0]))["tie_det"] == "invalid"
+    assert isinstance(t.decode_topk_state(_pack([0] * 6, version=2)), str)
+    assert isinstance(t.decode_topk_state(_pack([0] * 6, count=5)), str)
+    assert isinstance(t.decode_topk_state(0), str)  # ROCm build: version 0
+
+
+def test_decode_full_k_state():
+    assert [t.decode_full_k_state(v) for v in (-1, 0, 1, 7)] == [
+        "uninit",
+        "0",
+        "1",
+        "invalid",
+    ]
+
+
+# ------------------------------------------------------------- emission ----
+CPP_ON = {k: ON_MAP[k] for k in t.CPP_ORDER}
+
+
+class _Capture(logging.Handler):
+    def __init__(self):
+        super().__init__()
+        self.lines = []
+
+    def emit(self, record):
+        self.lines.append(record.getMessage())
+
+
+@pytest.fixture
+def capture():
+    t._reset_for_tests()
+    handler = _Capture()
+    t.logger.addHandler(handler)
+    old = t.logger.level
+    t.logger.setLevel(logging.INFO)
+    yield handler
+    t.logger.removeHandler(handler)
+    t.logger.setLevel(old)
+    t._reset_for_tests()
+
+
+def _kw(cpp=CPP_ON, env=None, device=None, qsa="1", tag="PP1_TP0"):
+    return dict(
+        tag_fn=lambda: tag,
+        getenv_fn=lambda: (_env(ON if env is None else env)[0], "libc-getenv"),
+        cpp_fn=lambda: cpp,
+        device_fn=lambda: device or {"switch": "1", "switch_large": "1"},
+        qsa_fn=lambda: qsa,
+    )
+
+
+def parse(line):
+    """How the startup smoke tokenises the line (sections; key=value tokens)."""
+    tokens = line.split()
+    assert tokens[0].startswith("e2-toggles[") and tokens[0].endswith("]:")
+    out, section = {"tag": tokens[0][len("e2-toggles[") : -2]}, "raw"
+    for tok in tokens[1:]:
+        if tok.endswith(":"):
+            section = tok[:-1]
+            continue
+        key, sep, value = tok.partition("=")
+        out.setdefault(section, {})[key if sep else tok] = value if sep else ""
+    return out
+
+
+def test_emits_once_per_process(capture, monkeypatch):
+    for k, v in ON.items():
+        monkeypatch.setenv(k, v)
+    line = t.arm(**_kw())
+    assert line and capture.lines == [line]
+    assert t.maybe_emit(**_kw()) == ""
+    assert t.maybe_emit(force=True, **_kw()) == ""
+    assert t.arm(**_kw()) == ""
+    assert len([m for m in capture.lines if m.startswith("e2-toggles[")]) == 1
+
+
+def test_not_before_arm(capture):
+    assert t.maybe_emit(**_kw()) == ""
+    assert capture.lines == []
+
+
+def test_fires_with_counter_log_off(capture, monkeypatch):
+    for k, v in ON.items():
+        monkeypatch.setenv(k, v)
+    for value in (None, "0"):
+        t._reset_for_tests()
+        if value is None:
+            monkeypatch.delenv("MERLIN_TOPK_EXACT_COUNTERS_LOG", raising=False)
+        else:
+            monkeypatch.setenv("MERLIN_TOPK_EXACT_COUNTERS_LOG", value)
+        assert t.arm(**_kw()).startswith("e2-toggles[PP1_TP0]: pid=")
+
+
+def test_line_contents_toggles_on(capture, monkeypatch):
+    for k, v in ON.items():
+        monkeypatch.setenv(k, v)
+    p = parse(t.arm(**_kw()))
+    assert p["tag"] == "PP1_TP0"
+    assert p["raw"]["pid"] == str(os.getpid())
+    assert p["raw"]["MERLIN_FULL_K"] == "1"
+    assert p["raw"]["MERLIN_TOPK_DET_LARGE"] == "unset"
+    eff = dict(p["effective"])
+    assert eff.pop("source") == "libc-getenv"
+    assert eff == ON_MAP
+    cpp = dict(p["cpp-cache"])
+    assert cpp.pop("source") == "cpp-cache"
+    assert cpp == CPP_ON
+    assert p["python"] == {"qsa_sort": "1", "source": "qsa_indexer._QSA_SORT"}
+    assert p["device"] == {
+        "switch": "1",
+        "switch_large": "1",
+        "source": "counter-slots-8-9",
+    }
+
+
+def test_line_knob_absent(capture, monkeypatch):
+    for k in t.RAW_ORDER:
+        monkeypatch.delenv(k, raising=False)
+    cpp = {k: ABSENT_MAP[k] for k in t.CPP_ORDER}
+    p = parse(t.arm(**_kw(cpp=cpp, env={}, qsa="0")))
+    eff = dict(p["effective"])
+    eff.pop("source")
+    assert eff == ABSENT_MAP
+
+
+def test_cpp_op_absent_is_n_a_and_emits_at_once(capture, monkeypatch):
+    for k, v in ON.items():
+        monkeypatch.setenv(k, v)
+    line = t.arm(**_kw(cpp="op-absent:_C.persistent_topk_toggle_state"))
+    p = parse(line)
+    assert p["cpp-cache"] == {
+        "n-a": "",
+        "reason": "op-absent:_C.persistent_topk_toggle_state",
+    }
+
+
+def test_defers_while_a_static_is_uninit(capture, monkeypatch):
+    for k, v in ON.items():
+        monkeypatch.setenv(k, v)
+    pending = dict(CPP_ON, full_k="uninit")
+    assert t.arm(**_kw(cpp=pending)) == ""
+    assert t.maybe_emit(**_kw(cpp=pending)) == ""
+    notes = [m for m in capture.lines if m.startswith("e2-toggles deferred on PP1_TP0")]
+    assert len(notes) == 1 and "full_k" in notes[0]
+    assert not any(m.startswith("e2-toggles[") for m in capture.lines)
+    line = t.maybe_emit(**_kw())  # the next step: every static filled
+    assert parse(line)["cpp-cache"]["full_k"] == "1"
+
+
+def test_forced_at_shutdown_while_uninit(capture, monkeypatch):
+    for k, v in ON.items():
+        monkeypatch.setenv(k, v)
+    pending = dict(CPP_ON, full_k="uninit")
+    t.arm(**_kw(cpp=pending))
+    line = t.maybe_emit(force=True, **_kw(cpp=pending))
+    assert parse(line)["cpp-cache"]["full_k"] == "uninit"
+
+
+def test_never_raises(capture):
+    def boom():
+        raise RuntimeError("no groups")
+
+    kw = _kw()
+    kw["cpp_fn"] = boom
+    assert t.arm(**kw) == ""
+    assert capture.lines
+    assert capture.lines[-1].startswith("e2-toggles[PP1_TP0]: unavailable")
+    assert t.maybe_emit(**_kw()) == ""  # an unavailable line is still the one line
+
+
+def test_default_sources_do_not_raise_on_cpu(monkeypatch):
+    """The real cpp/device/qsa probes on a CPU build: n-a, never an exception."""
+    assert isinstance(t.cpp_cache(), (str, dict))
+    assert set(t.device_switches()) == {"switch", "switch_large"}
+    assert t.qsa_sort_live() in ("0", "1", "n-a")
+    read, source = t._libc_getenv()
+    assert source in ("libc-getenv", "os-environ")
+    monkeypatch.setenv("MERLIN_TIE_DET", "7")
+    assert read("MERLIN_TIE_DET") == b"7"
