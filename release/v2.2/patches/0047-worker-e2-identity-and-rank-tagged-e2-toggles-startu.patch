--- a/csrc/libtorch_stable/moe/marlin_moe_wna16/ops.cu
+++ b/csrc/libtorch_stable/moe/marlin_moe_wna16/ops.cu
@@ -33,6 +33,7 @@
 #include <torch/headeronly/util/Exception.h>
 
 #include "libtorch_stable/torch_utils.h"
+#include <atomic>
 #include <cstdlib>
 
 namespace {
@@ -53,14 +54,31 @@ namespace {
 // This std::getenv is the SINGLE source of truth. vllm/envs.py carries a raw
 // passthrough entry for validate_environ and the compile-factor hash only;
 // nothing in Python may parse this name a second time.
+//
+// The initialiser also
+// publishes the value it cached into g_cached_full_k (-1 = not initialised
+// yet; nothing else writes it), and marlin_moe_full_k_state() below only
+// LOADS it -- asking never fills the cache. Host code only.
 // -------------------------------------------------------------------------
+std::atomic<int> g_cached_full_k{-1};
+
 bool merlin_full_k() {
   static const bool enabled = [] {
     const char* raw = std::getenv("MERLIN_FULL_K");
-    return (raw != nullptr && raw[0] != '\0') ? (std::atoi(raw) != 0) : false;
+    const bool value =
+        (raw != nullptr && raw[0] != '\0') ? (std::atoi(raw) != 0) : false;
+    g_cached_full_k.store(value ? 1 : 0, std::memory_order_release);
+    return value;
   }();
   return enabled;
 }
+
+// MERLIN_FULL_K as this process cached it: -1 = not initialised yet (no Marlin
+// MoE launch has happened in this process), 0 = off, 1 = on. Tensor-free, no
+// CUDA call.
+int64_t marlin_moe_full_k_state() {
+  return static_cast<int64_t>(g_cached_full_k.load(std::memory_order_acquire));
+}
 }  // namespace
 
 #define STATIC_ASSERT_SCALAR_TYPE_VALID(scalar_t)               \
@@ -736,3 +754,14 @@ torch::stable::Tensor moe_wna16_marlin_gemm(
 STABLE_TORCH_LIBRARY_IMPL(_moe_C, CUDA, m) {
   m.impl("moe_wna16_marlin_gemm", TORCH_BOX(&moe_wna16_marlin_gemm));
 }
+
+// v2.2 -- defined and registered in this TU so the query exists exactly when
+// the static it reads does. Tensor-free, so CompositeExplicitAutograd (a CUDA
+// registration could never be dispatched to without a tensor argument).
+STABLE_TORCH_LIBRARY_FRAGMENT(_moe_C, m) {
+  m.def("marlin_moe_full_k_state() -> int");
+}
+
+STABLE_TORCH_LIBRARY_IMPL(_moe_C, CompositeExplicitAutograd, m) {
+  m.impl("marlin_moe_full_k_state", TORCH_BOX(&marlin_moe_full_k_state));
+}
