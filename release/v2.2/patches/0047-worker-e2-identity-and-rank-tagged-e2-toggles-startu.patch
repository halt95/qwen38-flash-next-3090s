 csrc/libtorch_stable/ops.h                    |   4 +
 csrc/libtorch_stable/topk.cu                  |  89 +++-
 csrc/libtorch_stable/torch_bindings.cpp       |   5 +
 tests/test_merlin_e2_toggles.py               | 420 +++++++++++++++++
 vllm/v1/worker/e2_identity.py                 | 148 ++++++
 vllm/v1/worker/e2_toggles.py                  | 444 ++++++++++++++++++
 vllm/v1/worker/gpu/model_runner.py            |   7 +-
 vllm/v1/worker/gpu_worker.py                  |  13 +
 9 files changed, 1154 insertions(+), 7 deletions(-)
