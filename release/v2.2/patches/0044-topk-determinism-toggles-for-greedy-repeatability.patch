+# ---------------------------------------------------------------------------
+# MERLIN_QSA_SORT: canonicalise the ORDER of the selected block indices.
+#
+# persistent_topk assigns output slots by atomicAdd, so two identical requests
+# get the same selected SET in a different ORDER (measured on the reference host: matching
+# sorted hashes, differing raw hashes). Sparse attention then accumulates over
+# those blocks in whatever order it was handed, and fp32 addition is not
+# associative, so the arithmetic moves. Sorting is semantically a no-op -- the
+# same blocks are attended either way -- and makes the accumulation order
+# canonical.
+#
+# Padding (negative sentinels) is pushed to the END so the valid prefix is
+# preserved: `_expand_qsa_indices_kernel` truncates by POSITION
+# (`complete_blocks = min(visible_blocks, BLOCK_TOPK)`), and position is never
+# compared against a score anywhere in the chain, so there is no relevance-rank
+# contract for the sort to break.
+#
+# Branch-free and sync-free on purpose. `.any()` / `.item()` raise
+# cudaErrorStreamCaptureUnsupported inside graph capture; that cost one boot
+# on the reference host and is why this version has no Python-visible branch on data.
+#
+# Resolved once at import so it is a launch constant: a cudagraph captures the
+# op sequence that was live at capture time. Default OFF -- promotion is a release
+# decision, which is the maintainer's.
+# ---------------------------------------------------------------------------
+_QSA_SORT = envs.MERLIN_QSA_SORT
+
+
+def _qsa_canonicalise(block_indices: torch.Tensor) -> None:
+    """Sort selected block indices ascending, padding last. In place, shape preserved."""
+    if not _QSA_SORT:
+        return
+    big = torch.iinfo(block_indices.dtype).max
+    tmp = torch.where(
+        block_indices < 0, torch.full_like(block_indices, big), block_indices
+    )
+    tmp = torch.sort(tmp, dim=-1).values
+    block_indices.copy_(torch.where(tmp == big, torch.full_like(tmp, -1), tmp))
+
