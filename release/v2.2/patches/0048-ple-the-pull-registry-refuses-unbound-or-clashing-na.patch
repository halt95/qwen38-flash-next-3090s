+def test_pull_registry_refuses_unbound_and_clashing_names(monkeypatch) -> None:
+    """setup_cross_process_offload must not register under
+    the default '<unbound>' name nor let a second layer overwrite a first one's
+    entry (the op would resolve the wrong pointers). Re-arming the SAME layer
+    is allowed."""
+    import pytest
+    import torch
+
+    m = _import_ple_offload_layer(monkeypatch)
+    monkeypatch.setattr(m, "_PULL_LAYERS", {})
+
+    class _L(m.PleOffloadLayer):
+        def forward_impl(self, hidden_states, input_ids, *a, **k):  # pragma: no cover
+            return hidden_states
+
+    def armed(name):
+        layer = _L.__new__(_L)
+        torch.nn.Module.__init__(layer)
+        layer._ple_offload_name = name
+        return layer
+
+    sem = object()
+    buf = torch.empty(2, 2)
+    with pytest.raises(RuntimeError, match="no _ple_offload_name"):
+        armed("<unbound>").setup_cross_process_offload(buf, sem, host_output_ptr=1, host_row_bytes=8)
+    a = armed("L1")
+    a.setup_cross_process_offload(buf, sem, host_output_ptr=1, host_row_bytes=8)
+    a.setup_cross_process_offload(buf, sem, host_output_ptr=2, host_row_bytes=8)  # re-arm ok
+    assert m._PULL_LAYERS["L1"] is a
+    with pytest.raises(RuntimeError, match="two layers armed"):
+        armed("L1").setup_cross_process_offload(buf, sem, host_output_ptr=3, host_row_bytes=8)
+
+
+def test_nvidia_qwen4exp_ops_carry_no_pointer_like_int_params() -> None:
+    """A schema walk -- no custom op registered by the
+    NVIDIA qwen4_exp / PLE offload path may take an int parameter named like a
+    pointer/address (the AOT cache bakes Python ints as constants)."""
+    import ast
+    import pathlib
+
+    root = pathlib.Path(__file__).resolve().parents[2] / "vllm"
+    files = [root / "model_executor/layers/ple_offload_layer.py",
+             *sorted((root / "models/qwen4_exp/nvidia").rglob("*.py")),
+             *sorted((root / "v1/ple_offload").rglob("*.py"))]
+    bad = []
+    for f in files:
+        tree = ast.parse(f.read_text(encoding="utf-8"))
+        funcs = {n.name: n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)}
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Call) and getattr(node.func, "id", "") == "direct_register_custom_op":
+                kw = {k.arg: k.value for k in node.keywords}
+                fn = getattr(kw.get("op_func"), "id", None)
+                if fn not in funcs:
+                    continue
+                for a in funcs[fn].args.args:
+                    ann = ast.unparse(a.annotation) if a.annotation is not None else ""
+                    if ann == "int" and any(t in a.arg for t in ("ptr", "addr", "pointer")):
+                        bad.append(f"{f.name}:{fn}({a.arg})")
+    assert not bad, f"pointer-like int op params (AOT-baking hazard): {bad}"
