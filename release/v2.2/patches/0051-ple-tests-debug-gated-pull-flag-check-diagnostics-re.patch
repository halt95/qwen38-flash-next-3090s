+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The PLE flag pre-launch check is WIRED on this tree, not just registered.
+
+Why this file exists (PLE diagnostics port to 0.30). On the pre-fix kernel branch,
+an earlier commit had ``VLLM_E2_PLE_FLAG_CHECK`` registered in ``envs.py`` -- parsed,
+normalized, kept out of the compile factors -- but the connector code that
+reads it had been dropped by the rebase (the PLE-diagnostics changes were replayed onto
+the 0.30 base before the PLE offload package was restored there). A diagnostics run
+with the knob on would have reported "zero findings" from an instrument that
+never ran. ``test_stale_flag_assertion.py`` pins the pure helpers; it cannot
+catch this, because the helpers can exist while nothing calls them.
+
+These tests drive the REAL ``PleOffloadConnector._prepare_forward_impl`` with
+the transport's I/O (``_launch``, the stream synchronize) replaced, and the
+REAL ``stale_offload_flags`` reading real ``CpuGpuSemaphore`` flags. GPU-free.
+
+FAILING CONTROL: on that earlier commit every test in this file fails --
+``_PLE_FLAG_CHECK_MODE`` / ``_check_flags_clear_before_launch`` do not exist and
+``VLLM_E2_PLE_FLAG_CHECK`` has no reader outside ``envs.py``.
+"""
+
+import importlib
+import re
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import vllm
+import vllm.envs as envs
+from vllm.model_executor.layers.ple_offload_layer import (
+    CpuGpuSemaphore,
+    PleOffloadLayer,
+)
+from vllm.v1.ple_offload import connector as connector_mod
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+
+HIDDEN = 4
+
+
+class _ProbeLayer(PleOffloadLayer):
+    def forward_impl(self, hidden_states, input_ids, *args, **kwargs):
+        return hidden_states
+
+
+def _layer(flag_value: int) -> _ProbeLayer:
+    layer = _ProbeLayer()
+    layer.setup_cross_process_offload(
+        gpu_output_buffer=torch.zeros(8, HIDDEN, dtype=torch.bfloat16),
+        semaphore=CpuGpuSemaphore.from_ipc_tensor(
+            torch.tensor([flag_value], dtype=torch.int32)
+        ),
+    )
+    return layer
+
+
+class _Harness:
+    """A real connector object with only its I/O edges replaced."""
+
+    def __init__(self, monkeypatch, *, mode: str, tp_rank: int, flag: int):
+        monkeypatch.setattr(connector_mod, "_PLE_FLAG_CHECK_MODE", mode)
+        self.syncs = 0
+        self.launches: list[int] = []
+        self.warnings: list[str] = []
+        self.infos: list[str] = []
+
+        def _sync():
+            self.syncs += 1
+
+        monkeypatch.setattr(
+            torch.cuda,
+            "current_stream",
+            lambda device=None: SimpleNamespace(synchronize=_sync),
+        )
+        monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: False)
+        monkeypatch.setattr(
+            connector_mod.logger,
+            "warning",
+            lambda fmt, *args: self.warnings.append(fmt % args),
+        )
+        monkeypatch.setattr(
+            connector_mod.logger,
+            "info",
+            lambda fmt, *args: self.infos.append(fmt % args),
+        )
+        conn = object.__new__(PleOffloadConnector)
+        conn._input_ids_buf = torch.zeros(64, dtype=torch.int32)
+        conn._query_start_loc_buf = torch.zeros(9, dtype=torch.int32)
+        conn._after_dummy = False
+        conn._rowdump_n = None
+        conn.device = torch.device("cpu")
+        conn.dp_rank, conn.tp_rank, conn.pp_rank = 0, tp_rank, 0
+        conn._layers = {"ple.0": _layer(CpuGpuSemaphore.RESET_VALUE)}
+        conn._layers["ple.1"] = _layer(flag)
+
+        def _launch(num_reqs, num_tokens, **kwargs):
+            self.launches.append(num_tokens)
+
+        conn._launch = _launch
+        self.conn = conn
+
+    def real_forward(self, num_tokens: int = 7) -> None:
+        self.conn._prepare_forward_impl(2, num_tokens, False)
+
+
+STALE = CpuGpuSemaphore.DONE_VALUE
+CLEAR = CpuGpuSemaphore.RESET_VALUE
+
+
+def test_raise_mode_refuses_to_publish_into_a_stale_flag(monkeypatch):
+    h = _Harness(monkeypatch, mode="raise", tp_rank=0, flag=STALE)
+    with pytest.raises(RuntimeError, match=r"#53899.*\('ple\.1', 1\)"):
+        h.real_forward()
+    assert h.launches == [], "published into a stale flag"
+    assert h.syncs == 1, "the read was not ordered behind the model stream"
+
+
+def test_warn_mode_reports_and_still_launches(monkeypatch):
+    h = _Harness(monkeypatch, mode="warn", tp_rank=0, flag=STALE)
+    h.real_forward(num_tokens=11)
+    assert h.launches == [11]
+    assert len(h.warnings) == 1 and "('ple.1', 1)" in h.warnings[0]
+
+
+def test_off_mode_does_no_work_on_the_launch_path(monkeypatch):
+    """Production default: no synchronize, no read, no report."""
+    h = _Harness(monkeypatch, mode="off", tp_rank=0, flag=STALE)
+    h.real_forward()
+    assert h.launches == [7]
+    assert h.syncs == 0 and h.warnings == []
+
+
+def test_clear_flags_on_the_publishing_rank_are_silent(monkeypatch):
+    h = _Harness(monkeypatch, mode="raise", tp_rank=0, flag=CLEAR)
+    h.real_forward()
+    assert h.launches == [7] and h.warnings == [] and h.syncs == 1
+
+
+def test_a_non_publishing_rank_is_not_judged(monkeypatch):
+    """TP1's flag may legitimately carry THIS step's fan-out."""
+    h = _Harness(monkeypatch, mode="raise", tp_rank=1, flag=STALE)
+    h.real_forward()
+    assert h.launches == [7] and h.warnings == [] and h.syncs == 0
+
+
+def test_dummy_forwards_are_not_checked(monkeypatch):
+    h = _Harness(monkeypatch, mode="raise", tp_rank=0, flag=STALE)
+    dummies: list[int] = []
+    h.conn._signal_dummy_outputs_impl = dummies.append
+    h.conn._prepare_forward_impl(1, 5, True)
+    assert dummies == [5] and h.syncs == 0 and h.launches == []
+
+
+def _liveness(h: _Harness) -> list[str]:
+    return [line for line in h.infos if line.startswith("PLE flag check")]
+
+
+def test_the_publishing_rank_reports_that_the_check_ran(monkeypatch):
+    """Liveness: first check and every heartbeat carry a running count.
+
+    Zero findings on a diagnostics run is evidence only if the check ran; this line is
+    what a diagnostics run greps. Heartbeat 2: lines at checks 1 and 2, the
+    third (stale, warn) counted and reported by its own warning.
+    """
+    monkeypatch.setattr(connector_mod, "_E2_CHECK_HEARTBEAT", 2)
+    h = _Harness(monkeypatch, mode="warn", tp_rank=0, flag=CLEAR)
+    h.real_forward()
+    h.real_forward()
+    h.conn._layers["ple.1"] = _layer(STALE)
+    h.real_forward()
+    tail = "(dp_rank=0, tp_rank=0, pp_rank=0)"
+    assert _liveness(h) == [
+        f"PLE flag check (mode=warn): 1 checks run, 0 with findings {tail}",
+        f"PLE flag check (mode=warn): 2 checks run, 0 with findings {tail}",
+    ]
+    assert h.conn._flag_checks_run == 3 and h.conn._flag_check_findings == 1
+    assert len(h.warnings) == 1
+
+
+def test_a_non_publishing_rank_says_once_that_it_does_not_judge(monkeypatch):
+    h = _Harness(monkeypatch, mode="warn", tp_rank=1, flag=STALE)
+    h.real_forward()
+    h.real_forward()
+    assert _liveness(h) == [
+        "PLE flag check (mode=warn): non-publishing rank, not judged here by "
+        "design (dp_rank=0, tp_rank=1, pp_rank=0)"
+    ]
+
+
+def test_off_mode_logs_no_liveness(monkeypatch):
+    h = _Harness(monkeypatch, mode="off", tp_rank=0, flag=CLEAR)
+    h.real_forward()
+    assert _liveness(h) == []
+
+
+@pytest.mark.parametrize(
+    ("raw", "mode"), [(None, "off"), ("1", "warn"), ("raise", "raise")]
+)
+def test_the_connector_mode_is_the_registry_value(monkeypatch, raw, mode):
+    """The module-level mode is read through ``envs``, so the value the
+    registry reports and the value the check applies cannot drift."""
+    if raw is None:
+        monkeypatch.delenv("VLLM_E2_PLE_FLAG_CHECK", raising=False)
+    else:
+        monkeypatch.setenv("VLLM_E2_PLE_FLAG_CHECK", raw)
+    try:
+        reloaded = importlib.reload(connector_mod)
+        assert mode == reloaded._PLE_FLAG_CHECK_MODE
+        assert mode == envs.VLLM_E2_PLE_FLAG_CHECK
+    finally:
+        monkeypatch.delenv("VLLM_E2_PLE_FLAG_CHECK", raising=False)
+        importlib.reload(connector_mod)
+
+
+def _diagnostic_knobs() -> list[str]:
+    source = Path(envs.__file__).read_text(encoding="utf-8")
+    return sorted(set(re.findall(r'_e2_diagnostic_mode\(\s*"(\w+)"', source)))
+
+
+def test_every_e2_diagnostic_knob_has_a_reader_outside_envs():
+    """A registered diagnostic with no reader reports "zero findings" forever.
+
+    Class guard for the defect this port fixes: registration and the read site
+    travelled in different commits and a rebase kept one without the other.
+    """
+    knobs = _diagnostic_knobs()
+    assert {"VLLM_E2_PLE_FLAG_CHECK", "VLLM_E2_MAMBA_SLOT_OWNERSHIP"} <= set(knobs)
+    root = Path(vllm.__file__).parent
+    readers: dict[str, list[str]] = {k: [] for k in knobs}
+    for path in root.rglob("*.py"):
+        if path.name == "envs.py" and path.parent == root:
+            continue
+        text = path.read_text(encoding="utf-8", errors="replace")
+        for knob in knobs:
+            if f"envs.{knob}" in text:
+                readers[knob].append(str(path.relative_to(root)))
+    unread = [k for k, files in readers.items() if not files]
+    assert unread == [], f"registered but never read via envs: {unread}"
