+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The pull transport's staleness precondition, read back instead of argued.
+
+vllm#53899 (GB10/sm_121, TP=1, PIECEWISE and FULL_DECODE_ONLY): the capture
+path signalled dummy PLE outputs, the first real step's
+``cuStreamWaitValue32(flag == DONE_VALUE)`` was satisfied by that DUMMY signal,
+its release reset the flag, and the worker's late copy raised it again for the
+next step -- so every forward consumed the PREVIOUS step's PLE rows for the
+life of the server. ``cudagraph_mode=NONE`` was correct.
+
+This tree holds the precondition structurally (``_signal_dummy_outputs_impl``
+-> dummy forward -> ``_release_outputs_impl`` resets every layer and
+synchronizes while ``_after_dummy`` is set -> TP barrier at the dummy->real
+transition), but nothing ever read the flag back. ``stale_offload_flags`` is
+that read, and these tests pin its contract.
+
+No GPU is required: ``CpuGpuSemaphore.from_ipc_tensor`` accepts any int32
+tensor, and only ``reset``/``signal``/``wait_reset`` (never called here) touch
+the CUDA driver. The layer is a real ``PleOffloadLayer`` subclass configured
+through the real ``setup_cross_process_offload``, not a stand-in.
+"""
+
+import torch
+
+from vllm.model_executor.layers.ple_offload_layer import (
+    CpuGpuSemaphore,
+    PleOffloadLayer,
+    flag_check_is_authoritative,
+    stale_offload_flags,
+)
+
+HIDDEN = 4
+
+
+class _ProbeLayer(PleOffloadLayer):
+    """Minimal real subclass: the base class is abstract on forward_impl."""
+
+    def forward_impl(
+        self,
+        hidden_states: torch.Tensor,
+        input_ids: torch.Tensor,
+        *args: object,
+        **kwargs: object,
+    ) -> torch.Tensor:
+        return hidden_states
+
+
+def _layer(flag_value: int) -> _ProbeLayer:
+    layer = _ProbeLayer()
+    flag = torch.tensor([flag_value], dtype=torch.int32)
+    layer.setup_cross_process_offload(
+        gpu_output_buffer=torch.zeros(8, HIDDEN, dtype=torch.bfloat16),
+        semaphore=CpuGpuSemaphore.from_ipc_tensor(flag),
+    )
+    return layer
+
+
+def test_cleared_flags_are_not_reported() -> None:
+    """The correct world: every semaphore clear before a real launch."""
+    layers = {
+        "ple.0": _layer(CpuGpuSemaphore.RESET_VALUE),
+        "ple.1": _layer(CpuGpuSemaphore.RESET_VALUE),
+    }
+    assert stale_offload_flags(layers) == []
+
+
+def test_a_leftover_signal_is_reported_with_its_layer() -> None:
+    """The #53899 world: a signal no forward consumed survives into a launch.
