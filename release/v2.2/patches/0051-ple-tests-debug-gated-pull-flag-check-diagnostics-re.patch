+# ---------------------------------------------------------------------------
+# Which rank may judge the flag at all
+# ---------------------------------------------------------------------------
+
+
+def test_only_the_publishing_rank_may_judge_the_flag() -> None:
+    """``flag == 0`` before a launch is an invariant on TP0 ONLY.
+
+    ``_launch`` publishes only on TP0. The offload worker then fans the result
+    out to EVERY registered target, each gated only on that target's own flag
+    having been reset. So this interleaving is legal and healthy:
