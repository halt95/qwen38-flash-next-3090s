+def _launch_sites_in_this_file() -> list[tuple[int, str, int, list[str], list]]:
+    """``(lineno, kernel, n_positional, keyword_names, positional_exprs)`` for
+    every ``<kernel>[grid](...)`` call in this module's source."""
+    tree = ast.parse(inspect.getsource(sys.modules[__name__]))
+    sites = []
+    for node in ast.walk(tree):
+        if not (isinstance(node, ast.Call) and isinstance(node.func, ast.Subscript)):
+            continue
+        target = node.func.value
+        if not (isinstance(target, ast.Name) and target.id in _LAUNCHED_KERNELS):
+            continue
+        assert not any(isinstance(a, ast.Starred) for a in node.args), (
+            f"line {node.lineno}: a *args launch cannot be checked statically"
+        )
+        sites.append(
+            (
+                node.lineno,
+                target.id,
+                len(node.args),
+                [kw.arg for kw in node.keywords],
+                node.args,
+            )
+        )
+    return sites
+
+
+def launch_arity_findings(sites) -> list[str]:
+    """Every way a launch site fails to bind its kernel's signature.
+
+    The rule this file follows: runtime parameters are passed POSITIONALLY and
+    all of them are passed; ``tl.constexpr`` parameters (read from the kernel's
+    own source annotations, since ``block_size`` is a lower-case constexpr) are
+    passed by keyword. A launch one runtime parameter
+    short does not fail until Triton binds it on a GPU, which is how
+    ``test_precopy_matches_v1_copy_specs`` stayed broken from that change onwards
+    without anyone seeing it (it was never run). Checked here with no device.
+    """
+    findings = []
+    for lineno, name, n_pos, kw_names, pos_exprs in sites:
+        kernel = _LAUNCHED_KERNELS[name]
+        fn = getattr(kernel, "fn", kernel)
+        sig = inspect.signature(fn)
+        [fdef] = [
+            n
+            for n in ast.parse(textwrap.dedent(inspect.getsource(fn))).body
+            if isinstance(n, ast.FunctionDef)
+        ]
+        constexpr = {
+            a.arg
+            for a in fdef.args.args
+            if a.annotation is not None
+            and ast.unparse(a.annotation).endswith("constexpr")
+        }
+        assert constexpr, f"{name}: no tl.constexpr parameters found in source"
+        runtime = [p for p in sig.parameters if p not in constexpr]
+        if n_pos != len(runtime):
+            findings.append(
+                f"line {lineno}: {name} launched with {n_pos} positional "
+                f"argument(s), kernel declares {len(runtime)} runtime "
+                f"parameter(s) {runtime}"
+            )
+            continue
+        try:
+            sig.bind(*([None] * n_pos), **dict.fromkeys(kw_names))
+        except TypeError as error:
+            findings.append(f"line {lineno}: {name}: {error}")
+            continue
+        # The bounds-guard counter slot must be handed a guard counter, not
+        # whatever tensor happened to land in that position.
+        if "guard_ctr" in runtime:
+            expr = pos_exprs[runtime.index("guard_ctr")]
+            text = ast.unparse(expr)
+            if "guard" not in text:
+                findings.append(
+                    f"line {lineno}: {name}: guard_ctr position receives "
+                    f"{text!r}, not a guard counter"
+                )
+    return findings
+
+
+def test_every_launch_in_this_file_binds_the_kernel_signature():
+    """GPU-free: each kernel launch in this module binds its real signature.
+
+    An earlier ``test_precopy_matches_v1_copy_specs`` passed 15 positionals
+    to a kernel that has taken 17 since the bounds-guard instrumentation added
+    ``block_table_num_rows`` and ``guard_ctr``, and nothing noticed because the
+    GPU tier never ran it. FAILING CONTROL: on the unrepaired file this reports
+    the precopy launch as 15 vs 17 (see ``test_arity_check_discriminates``).
+    """
+    sites = _launch_sites_in_this_file()
+    kernels_seen = {name for _l, name, *_rest in sites}
+    assert kernels_seen == set(_LAUNCHED_KERNELS), (
+        f"expected launches of {sorted(_LAUNCHED_KERNELS)}, found "
+        f"{sorted(kernels_seen)}: the scan is not seeing this file's launches"
+    )
+    assert launch_arity_findings(sites) == []
+
+
+def test_arity_check_discriminates():
+    """The check fires on the pre-repair launch shape (the failing control).
+
+    Rebuilds the exact pre-repair precopy launch -- the row stride followed
+    directly by the state metadata, 15 positionals -- and one with the right
+    arity but a non-guard tensor in the counter slot. Both must be reported,
+    or the green result above is a test that cannot fail.
+    """
+    pre_repair = ast.parse(
+        "precopy_mamba_align_fused_kernel[grid](dst_col, src_col, bias, "
+        "bt_ptrs, bt.stride(0), base, blk_stride, elem, inner, width, group, "
+        "drc, drs, idx_mapping, num_reqs, COPY_BLOCK_SIZE=1024, "
+        "CONV_STATE_DIM_FIRST=False, HAS_IDX_MAPPING=True, TEMPORAL_TILES=1)",
+        mode="eval",
+    ).body
+    wrong_slot = ast.parse(
+        "precopy_mamba_align_fused_kernel[grid](dst_col, src_col, bias, "
+        "bt_ptrs, bt.stride(0), bt.size(0), base, base, blk_stride, elem, "
+        "inner, width, group, drc, drs, idx_mapping, num_reqs, "
+        "COPY_BLOCK_SIZE=1024, CONV_STATE_DIM_FIRST=False)",
+        mode="eval",
+    ).body
+
+    def _site(call):
+        return (
+            call.lineno,
+            call.func.value.id,
+            len(call.args),
+            [kw.arg for kw in call.keywords],
+            call.args,
+        )
+
+    [arity] = launch_arity_findings([_site(pre_repair)])
+    assert "15 positional" in arity and "17 runtime" in arity, arity
+    [slot] = launch_arity_findings([_site(wrong_slot)])
+    assert "guard_ctr position receives 'base'" in slot, slot
 
 
