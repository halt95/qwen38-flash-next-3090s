+
+def test_every_stale_layer_is_named_not_just_the_first() -> None:
+    """Attribution matters: #53899's fix resets EVERY layer's semaphore."""
+    layers = {f"ple.{i}": _layer(CpuGpuSemaphore.DONE_VALUE) for i in range(3)}
+    assert stale_offload_flags(layers) == [
+        ("ple.0", 1),
+        ("ple.1", 1),
+        ("ple.2", 1),
