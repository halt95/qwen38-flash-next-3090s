+def test_freed_slot_is_rejected_before_any_negative_index_load():
+    """A -1 row must be rejected *before* the decision arrays are read.
+
+    ``mamba_utils.py:441-442`` returns on ``req_idx < 0`` before the loads at
+    ``:445-446``. A prior version of this test seeded decisions at some other
+    slot, which the kernel would never have touched either way, so it proved
+    nothing about the guard. This one plants the poison
+    where a missing guard would actually look: index -1 of every per-req array
+    and row -1 of the block table, which are real memory owned by the backing
+    tensors in ``_build``.
+
+    If the guard were deleted, the kernel would read
+    ``num_accepted=4, state_idx=0, new_num_computed=48`` -> a copy with bias 3
+    into block-table row -1, writing CANARY_DST from CANARY_SRC. Both canaries
+    are covered by ``_assert_only_blocks_changed``, so that write fails the
+    test.
+
+    The row after the -1 must also still copy correctly, which is the
+    positioning check.
+    """
+    fx = _build(slot_mapping=(5, 1, 2))
+    _launch(fx, [-1, 5, 2], {5: (4, 0, 48), 2: (2, 0, 40)})
+
+    dst = phys(5, 2)
+    _assert_bitwise(
+        fx.conv[dst][: CONV_WIDTH - 3], fx.conv0[phys(5, 0)][3:], "conv dst"
+    )
+    _assert_bitwise(fx.temporal[dst], fx.temporal0[phys(5, 3)], "temporal dst")
+    _assert_only_blocks_changed(fx, {dst})
+
+
+def test_generation_masked_reuse_is_skipped_end_to_end():
+    """The -1 above, but produced by the real generation masking.
+
+    ``mask_from_generation_change`` in the CPU sibling test drives
+    ``PPHandler.get_prev_sampled_outputs`` (pp_utils.py:132-140) and returns
+    the mapping it computes; here that mapping is fed to the kernel. Slot 1 is
+    the one whose generation moved -- it was freed and its slot handed to a new
+    request between capture and use -- so its row must copy nothing even though
+    slot 1 now carries decisions that would copy.
+    """
+    from tests.v1.worker.gpu.test_pp_deferred_mamba_block_table import (
+        mask_from_generation_change,
+    )
+
+    mapping = mask_from_generation_change(
+        idx_mapping=[5, 1, 2], reused_slot_rows=[1]
+    )
+    assert mapping == [5, -1, 2], mapping
+
+    fx = _build(slot_mapping=(5, 1, 2))
+    _launch(fx, mapping, {5: (4, 0, 48), 1: (4, 0, 48), 2: (2, 0, 40)})
+
+    dst = phys(5, 2)
+    _assert_bitwise(
+        fx.conv[dst][: CONV_WIDTH - 3], fx.conv0[phys(5, 0)][3:], "conv dst"
+    )
+    _assert_bitwise(fx.temporal[dst], fx.temporal0[phys(5, 3)], "temporal dst")
+    # Slot 1's own blocks are untouched despite its copy-shaped decisions.
+    _assert_only_blocks_changed(fx, {dst})
+
