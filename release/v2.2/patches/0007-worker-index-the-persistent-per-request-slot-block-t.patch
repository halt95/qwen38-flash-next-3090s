+def test_same_column_with_positive_bias_copies_and_still_resets():
+    """The early-exit guard is a conjunction, and this is the other conjunct.
+
+    new=33, a=4 -> aligned=32, running=30, needs_copy; bias = 4-1-1 = 2;
+    dst_col = 1; state_idx = 1, so src_block_idx == dest_block_idx but
+    token_bias != 0. The kernel must NOT return: conv takes the same-block
+    memmove branch (mamba_utils.py:320-336) and temporal reads
+    ``src_col + token_bias`` = column 3, a different physical block.
+
+    Together with the previous test this makes the exit observable in both
+    directions: same column and zero bias moves nothing, same column and
+    positive bias moves bytes.
+    """
+    fx = _build()
+    num_accepted = _launch(
+        fx, [5, 1, 2], {5: (4, 1, 33), 1: (2, 0, 40), 2: (2, 0, 40)}
+    )
+
+    blk = phys(5, 1)  # both the conv source and the destination
+    temporal_src = phys(5, 3)  # src_col + bias = 3
+
+    # conv, same block, shifted left by token_bias = 2
+    _assert_bitwise(fx.conv[blk][: CONV_WIDTH - 2], fx.conv0[blk][2:], "conv shift")
+    _assert_bitwise(
+        fx.conv[blk][CONV_WIDTH - 2 :], fx.conv0[blk][CONV_WIDTH - 2 :], "conv tail"
+    )
+    # temporal, from a different block
+    _assert_bitwise(fx.temporal[blk], fx.temporal0[temporal_src], "temporal dst")
+
+    _assert_only_blocks_changed(fx, {blk})
+    # The reset store fires here too: it is guarded only on src == dst.
+    assert int(num_accepted[5].item()) == 1
+
