+def test_self_copy_exits_without_touching_state_and_resets_num_accepted():
+    """src_block_idx == dest_block_idx and bias == 0 -> return (mamba_utils:478).
+
+    new=33, a=2 -> aligned=32, running=32, needs_copy true, bias=0, dst_col=1;
+    state_idx=1 makes src == dst. Seeding num_accepted at 2 rather than 1 is
+    what makes the reset store observable: the kernel must write
+    num_accepted_tokens_out[req] = 1 (mamba_utils.py:473-475) *before* the early
+    return, so deleting that store now fails the test. (A prior version seeded 1 and
+    asserted 1, which a deleted store would have passed.)
+
+    Limit, stated rather than papered over: unchanged bytes cannot distinguish
+    "returned at the guard" from "fell through and memcpy'd a block onto
+    itself", because those are byte-identical by construction. What the reset
+    store does establish is that the kernel got past `needs_copy` and evaluated
+    `src == dst`, so it is the *guard* that stopped it and not an earlier
+    return. The conjunction itself is covered by the next test.
+    """
+    fx = _build()
+    num_accepted = _launch(
+        fx, [5, 1, 2], {5: (2, 1, 33), 1: (2, 0, 40), 2: (2, 0, 40)}
+    )
+
+    _assert_only_blocks_changed(fx, set())
+    assert int(num_accepted[5].item()) == 1
+
+
