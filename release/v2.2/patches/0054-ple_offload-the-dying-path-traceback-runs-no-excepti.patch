+_FATAL_TRACEBACK_SOURCE = r"""
+from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+
+class AcceleratorLikeError(RuntimeError):
+    pass
+
+
+def launch_kernel():
+    raise ValueError("root cause detail")
+
+
+def step():
+    try:
+        launch_kernel()
+    except ValueError as cause:
+        raise AcceleratorLikeError("CUDA error: an illegal memory access") from cause
+
+
+try:
+    step()
+except BaseException as error:
+    ple_fail_closed(
+        where="transport-traceback",
+        rank=0,
+        layer="ple",
+        sequence=7,
+        error=error,
+    )
+"""
+
+
+def test_fatal_helper_traceback_names_subclass_frames_and_cause() -> None:
+    """The dying-path traceback still carries what the early boot lacked: the
+    real (subclass) type, its message, the raising frames and the chain."""
+    completed = subprocess.run(
+        [sys.executable, "-c", _FATAL_TRACEBACK_SOURCE],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.PIPE,
+        timeout=120,
+    )
+    stderr = completed.stderr.decode("utf-8", "replace")
+    assert completed.returncode == 1, stderr
+    assert "PLE fatal: where=transport-traceback" in stderr
+    assert "PLE fatal traceback follows:" in stderr
+    assert "AcceleratorLikeError: CUDA error: an illegal memory access" in stderr
+    assert "ValueError: root cause detail" in stderr
+    assert "direct cause of the following exception" in stderr
+    assert "in launch_kernel" in stderr
+    assert "in step" in stderr
+    # Interpreter order: the cause's block precedes the outer exception's.
+    assert stderr.index("ValueError: root cause detail") < stderr.index(
+        "AcceleratorLikeError: CUDA error"
+    )
+
+
 @pytest.mark.skipif(sys.platform == "win32", reason="process groups are POSIX-only")
 def test_wait_for_ready_rejects_non_string_status_without_comparison(
     tmp_path: Path,
