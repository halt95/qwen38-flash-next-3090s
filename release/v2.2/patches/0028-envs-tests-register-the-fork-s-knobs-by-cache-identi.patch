diff --git a/tests/conftest.py b/tests/conftest.py
index 5fd594a04a..982caee675 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1600,6 +1600,25 @@ def pytest_addoption(parser):
 
 
 def pytest_collection_modifyitems(config, items):
+    # Flash-Next fork (v2.2): one place that decides what a GPU test is.
+    # `@pytest.mark.gpu` auto-skips without a device and makes the GPU-free tier
+    # SELECTABLE as `-m "not gpu"`, which a per-test skipif cannot do -- a
+    # skipif still reports the item as a skip rather than removing it.
+    #
+    # What this does NOT do: it does not make collection
+    # GPU-dependency-free. This hook runs after every module has been imported
+    # and every item collected, so a module whose import reaches CUDA, Triton or
+    # an absent vLLM extension still fails at COLLECTION, before any marker is
+    # consulted. Making the CPU tier collect cleanly is a separate job: defer
+    # those imports, or run the tier on its declared supported platform.
+    # The marker is also not authorization to use a busy shared device --
+    # test_pp_deferred_mamba_gpu.py keeps its separate VLLM_E2_GPU_TESTS opt-in.
+    if not torch.cuda.is_available():
+        skip_gpu = pytest.mark.skip(reason="no CUDA device (pytest marker: gpu)")
+        for item in items:
+            if "gpu" in item.keywords:
+                item.add_marker(skip_gpu)
+
     if config.getoption("--optional"):
         # --optional given in cli: do not skip optional tests
         return
