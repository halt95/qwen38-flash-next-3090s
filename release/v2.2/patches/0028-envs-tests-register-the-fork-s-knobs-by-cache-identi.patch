+# ---------------------------------------------------------------------------
+# Flash-Next fork: the cache-factor contract (v2.2 fork knobs)
+#
+# compile_factors() is a deny-list, so a knob's classification is invisible
+# unless something asserts it. These tests are that assertion. They are CPU-only
+# and import nothing beyond vllm.envs, so they belong to the GPU-free tier.
+#
+# AOT identity vs CAPTURE identity: compile_factors() keys only the first. A
+# knob listed as hashed is genuinely protected across processes; a knob that is
+# only a capture factor is hashed conservatively and its capture safety still
+# rests on not changing the value between capture and replay in one process.
+# These tests check the AOT side, which is the side this file can check.
+#
+# Each row is (name, value to set, value the getter must then return). The
+# expected value matters: a getter that ignored the environment would still
+# satisfy a bare membership check, so every row proves the entry is live.
+# ---------------------------------------------------------------------------
+
+_FORK_HASHED = [
+    ("VLLM_HOST_EMBED_TABLE", "1", True),
+    ("VLLM_PLE_FP8_GLOBAL_SCALE", "1", True),
+    ("VLLM_QSA_KV_CLIP_COUNT", "7", "7"),
+    ("VLLM_QSA_KV_COLLECT", "/var/tmp/qsa-absmax", "/var/tmp/qsa-absmax"),
+    # Capture-configuration factor read in C++ (topk.cu exact_medium_enabled);
+    # the Python entry is a raw passthrough, never a second parser.
+    ("MERLIN_TOPK_EXACT_MEDIUM", "0", "0"),
+]
+
+_FORK_IGNORED = [
+    ("VLLM_QSA_KV_SCALES", "/var/tmp/scales.json", "/var/tmp/scales.json"),
+    # "WARN" also checks the .strip().lower() mirror of the read site.
+    ("VLLM_E2_GUARD_MODE", " WARN ", "warn"),
+    ("VLLM_E2_GUARD_INTERVAL", "0.25", "0.25"),
+    ("VLLM_E2_MEMSTATS", "2", "2"),
+    ("VLLM_E2_MEMSTATS_DIR", "/var/tmp/memstats", "/var/tmp/memstats"),
+    ("VLLM_E2_SCHED_LOG", "/var/tmp/sched.jsonl", "/var/tmp/sched.jsonl"),
+    ("VLLM_E2_ZERO_OWNERSHIP_CHECK", "1", True),
+    ("VLLM_PLE_OFFLOAD_HOME_DEVICE", "2", "2"),
+    ("VLLM_PLE_OFFLOAD_READY_TIMEOUT", "1800", 1800.0),
+    ("VLLM_PLE_OFFLOAD_WAIT_TIMEOUT", "45", 45.0),
+    ("VLLM_PLE_PROGRESS_DEADLINE_S", "30", 30.0),
+    ("VLLM_PLE_STARTUP_DEADLINE_S", "60", 60.0),
+    ("VLLM_PLE_TEST_FAULT", "cut=exc_in_release,ordinal=3,rank=any", None),
+    ("VLLM_PLE_TEST_FAULT_GATE", "/var/tmp/gate", "/var/tmp/gate"),
+    ("VLLM_PLE_TEST_FAULT_LOG", "/var/tmp/fault.log", "/var/tmp/fault.log"),
+    # Read sites arrive with the slot-ownership assertions.
+    ("VLLM_E2_PLE_FLAG_CHECK", "1", "warn"),
+    ("VLLM_E2_MAMBA_SLOT_OWNERSHIP", " RAISE ", "raise"),
+]
+
+# Not in this repository at all: a reference-host-side patch stack. Named in
+# the TODO block in envs.py and deliberately unregistered until someone reads
+# their real read sites and classifies both identities.
+_FORK_UNAUDITED = [
+    "MERLIN_FULL_K",
+    "MERLIN_QSA_SORT",
+    "MERLIN_TIE_DET",
+    "MERLIN_TIE_RECENT",
+    "MERLIN_PIN_BSM",
+]
+
+
+def _fresh_env_value(name: str):
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+    return getattr(envs, name)
+
+
+@pytest.mark.parametrize(("name", "value", "expected"), _FORK_HASHED)
+def test_fork_knob_is_a_cache_factor(
+    name: str, value: str, expected, monkeypatch: pytest.MonkeyPatch
+):
+    """A knob that can change a compiled or captured artifact must be hashed,
+    and the hashed value must follow the environment."""
+    assert name in environment_variables
+    monkeypatch.setenv(name, value)
+    assert _fresh_env_value(name) == expected
+    factors = envs.compile_factors()
+    assert name in factors
+    assert factors[name] == expected
+
+
+@pytest.mark.parametrize(("name", "value", "expected"), _FORK_IGNORED)
+def test_fork_runtime_knob_is_not_a_cache_factor(
+    name: str, value: str, expected, monkeypatch: pytest.MonkeyPatch
+):
+    """A path, timeout, log cadence or host-side assertion must never
+    invalidate the compile cache -- while still being read."""
+    assert name in environment_variables
+    monkeypatch.setenv(name, value)
+    if expected is not None:
+        assert _fresh_env_value(name) == expected
+    assert name not in envs.compile_factors()
+
+
+@pytest.mark.parametrize("name", _FORK_UNAUDITED)
+def test_unaudited_host_side_knob_stays_listed_until_it_is_classified(name: str):
+    """The TODO block in envs.py is a gate, not a note.
+
+    Registering one of these without classifying it -- which means deleting it
+    from that block once its AOT and capture identity are written down against
+    its real read site -- is the exact failure the fork's env rule
+    exists to prevent, so it fails here.
+    """
+    source = Path(envs.__file__).read_text(encoding="utf-8")
+    listed = name in source
+    if name in environment_variables:
+        assert not listed, (
+            f"{name} is registered but still named in the envs.py TODO block: "
+            "classify its AOT and capture identity from its real read site and "
+            "remove it from that block"
+        )
+    else:
+        assert listed, (
+            f"{name} is neither registered nor named in the envs.py TODO block; "
+            "every fork knob must be accounted for"
+        )
+
+
+def test_fork_cache_factor_lists_are_disjoint_and_registered():
+    """Negative control for the two tables above."""
+    hashed = {n for n, _, _ in _FORK_HASHED}
+    ignored = {n for n, _, _ in _FORK_IGNORED}
+    assert not hashed & ignored
+    for name in hashed | ignored:
+        assert name in environment_variables, name
