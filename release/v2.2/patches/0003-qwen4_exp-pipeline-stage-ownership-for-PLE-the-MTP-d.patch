From c0a30ae373dbc68521fdc2b508def60245ddcceb Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Tue, 22 Sep 2026 04:11:27 -0400
Subject: [PATCH 03/58] qwen4_exp: pipeline-stage ownership for PLE, the MTP
 drafter and the vision tower

Each pipeline stage builds only the parts it owns: PLE when every PLE layer
lives on stage 0, MTP under PP (port of vLLM PR #46994 minus its ROCm MLA file
and tests) with the drafter on the last stage, and the vision tower on the
first stage only.
---
 vllm/model_executor/models/config.py        |  21 +++-
 vllm/models/qwen4_exp/nvidia/model.py       |  41 +++++--
 vllm/models/qwen4_exp/nvidia/model_state.py |   8 +-
 vllm/models/qwen4_exp/nvidia/mtp.py         |   6 +-
 vllm/v1/worker/gpu_worker.py                | 112 ++++++++++++++++++++
 5 files changed, 170 insertions(+), 18 deletions(-)

diff --git a/vllm/model_executor/models/config.py b/vllm/model_executor/models/config.py
index bbbe98bc8d..5c55412ee0 100644
--- a/vllm/model_executor/models/config.py
+++ b/vllm/model_executor/models/config.py
@@ -876,12 +876,25 @@ class Qwen4ExpForConditionalGenerationConfig(Qwen3_5ForConditionalGenerationConf
             )
         # Checked again in Qwen4ExpModelState; rejecting it here keeps the
         # engine from loading weights first.
+        # vllm#54709: PLE only needs raw input_ids on the rank that owns a PLE
+        # layer. Allow PP>1 as long as every PLE layer lives on pipeline rank 0.
         if text_config.ple_layer_ids and parallel_config.pipeline_parallel_size > 1:
-            raise NotImplementedError(
-                "Qwen4Exp N-gram PLE embedding requires pipeline_parallel_size=1 "
-                "because non-first pipeline ranks do not receive the raw input_ids "
-                "it needs. Please run with PP=1."
+            from vllm.distributed.utils import get_pp_indices
+
+            rank0_start, rank0_end = get_pp_indices(
+                int(text_config.num_hidden_layers),
+                0,
+                parallel_config.pipeline_parallel_size,
             )
+            ple_idx = [int(i) - 1 for i in text_config.ple_layer_ids]
+            if min(ple_idx) < rank0_start or max(ple_idx) >= rank0_end:
+                raise NotImplementedError(
+                    "Qwen4Exp N-gram PLE embedding requires every PLE layer to "
+                    f"live on pipeline rank 0 (layers {rank0_start}.."
+                    f"{rank0_end - 1}), but PLE layers are at {ple_idx}. Give "
+                    "rank 0 more layers via VLLM_PP_LAYER_PARTITION, or run "
+                    "with PP=1."
+                )
         multimodal_config = vllm_config.model_config.multimodal_config
         if multimodal_config is not None and multimodal_config.language_model_only:
             _strip_qwen4_exp_mrope(vllm_config.model_config)
