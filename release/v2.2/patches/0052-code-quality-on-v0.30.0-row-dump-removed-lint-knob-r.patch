     for name in hashed | ignored:
         assert name in environment_variables, name
+
+
+# ---------------------------------------------------------------------------
+# Read-site census on 0.30. Every table above is a list somebody wrote; none
+# of them is checked against the READ SITES. That is how the 0.30 release tree
+# came to read VLLM_PLE_ROW_DUMP (restored by the pull-transport carry after it was deleted
+# it) and MERLIN_TOPK_COUNTER_SLOTS (the medium-path counter reader) with neither classified,
+# and how MERLIN_TOPK_EXACT_COUNTERS_LOG sat in ignored_factors with no test
+# asserting it. The census closes the loop in both directions:
+#
+#   source -> tables: every fork-family name the tree mentions (Python, C++ and
+#     the two PLE bootstrap packages) is hashed, ignored, fenced as unaudited,
+#     a build-time define, or upstream's own registration.
+#   registry -> tables: every fork-family name registered in envs.py has its
+#     cache-factor classification asserted by one of the tables.
+#
+# A knob that changes compiled code but is missing from the cache key is a
+# correctness bug on an AOT cache-load boot (the loaded artifact skips guard
+# evaluation), so "unclassified" must fail here rather than on the reference host.
+# ---------------------------------------------------------------------------
+
+_FORK_FAMILY = re.compile(
+    r"\b(?:MERLIN_[A-Z0-9_]+|VLLM_(?:E2|PLE|QSA)_[A-Z0-9_]+|VLLM_HOST_EMBED_TABLE)\b"
+)
+
+# Preprocessor defines consumed at BUILD time (-D / #ifndef / #define), never a
+# getenv; test_exact_trap_is_a_build_define_not_an_env_var pins the reasoning
+# for the first, and test_build_defines_are_not_env_reads re-checks them all.
+_BUILD_DEFINES = [
+    "MERLIN_TOPK_EXACT_TRAP",
+    "MERLIN_TOPK_DIAG_DELAY",
+    "MERLIN_TOPK_DIAG_PREREPAIR",
+    "MERLIN_TOPK_DIAG_FORCE_FAULT",
+    "MERLIN_TOPK_DIAG_FORCE_FAULT_CTA",
+    "MERLIN_TOPK_DIAG_ANY",
+]
+
+# In the fork's name family but registered and hashed by UPSTREAM v0.30.0
+# (the pinned-host UVA PLE switch the PLE pull transport refuses).
+_UPSTREAM_OWNED = ["VLLM_PLE_CPU_OFFLOAD"]
+
+_CENSUS_ROOTS = ("vllm", "csrc", "vllm_ple_offload_bootstrap", "vllm_ple_test_fault")
+_CENSUS_SUFFIXES = {".py", ".cu", ".cuh", ".cpp", ".h", ".c"}
+
+
+def _all_tabled() -> set[str]:
+    tables = _FORK_HASHED + _FORK_IGNORED + _TIEDET_HASHED + _TIEDET_KERNEL_SWITCHES
+    return {n for n, _, _ in tables + _LARGEDET_FAULT_INJECTORS}
+
+
+def _classified() -> set[str]:
+    return (
+        _all_tabled() | set(_TIEDET_UNAUDITED) | set(_BUILD_DEFINES) | set(_UPSTREAM_OWNED)
+    )
+
+
+def _census(sources) -> dict[str, set[str]]:
+    """{fork-family name: files mentioning it} over (relpath, text) pairs."""
+    found: dict[str, set[str]] = {}
+    for rel, text in sources:
+        for name in _FORK_FAMILY.findall(text):
+            found.setdefault(name, set()).add(rel)
+    return found
+
+
+def _tree_sources():
+    root = Path(envs.__file__).resolve().parents[1]
+    envs_py = Path(envs.__file__).resolve()
+    for sub in _CENSUS_ROOTS:
+        base = root / sub
+        if not base.is_dir():
+            continue
+        for path in base.rglob("*"):
+            if path.suffix not in _CENSUS_SUFFIXES or path.resolve() == envs_py:
+                continue
+            text = path.read_text(encoding="utf-8", errors="replace")
+            yield str(path.relative_to(root)), text
+
+
+def test_every_fork_knob_in_the_source_is_classified():
+    found = _census(_tree_sources())
+    assert found, "census scanned nothing: the source tree is not beside envs.py"
+    missing = {n: sorted(f) for n, f in found.items() if n not in _classified()}
+    assert not missing, (
+        "fork knobs read or named in the tree but in no classification table "
+        "(hash it, ignore it with a reason, fence it, or delete the reader): "
+        f"{missing}"
+    )
+
+
+def test_every_registered_fork_knob_has_an_asserted_classification():
+    registered = {n for n in environment_variables if _FORK_FAMILY.fullmatch(n)}
+    untested = sorted(registered - _all_tabled() - set(_UPSTREAM_OWNED))
+    assert not untested, (
+        f"registered fork knobs whose hashed/ignored status no test asserts: {untested}"
+    )
+
+
+def test_build_defines_are_not_env_reads():
+    """A name classified as a build define must never be read at run time."""
+    reads = re.compile(r"(?:getenv|environ(?:\.get)?)\s*[\(\[]\s*[\"'](\w+)[\"']")
+    runtime: set[str] = set()
+    for _, text in _tree_sources():
+        runtime.update(reads.findall(text))
+    assert not runtime & set(_BUILD_DEFINES), runtime & set(_BUILD_DEFINES)
+    for name in _BUILD_DEFINES:
+        assert name not in environment_variables, name
+
+
+def test_census_discriminates_both_worlds():
+    """Control: the census must flag an unclassified reader and pass a
+    classified one -- a scan that reports the same thing in both measures
+    nothing."""
+    unknown = [("x.py", 'os.environ.get("VLLM_PLE_EXAMPLE_KNOB", "")')]
+    known = [("x.py", 'os.environ.get("VLLM_QSA_KV_CLIP_COUNT", "")')]
+    cxx = [("x.cu", 'const char* raw = std::getenv("MERLIN_EXAMPLE_SWITCH");')]
+    assert set(_census(unknown)) - _classified() == {"VLLM_PLE_EXAMPLE_KNOB"}
+    assert set(_census(known)) - _classified() == set()
+    assert set(_census(cxx)) - _classified() == {"MERLIN_EXAMPLE_SWITCH"}
+    # Upstream names outside the family never enter the census.
+    assert _census([("x.py", 'os.getenv("VLLM_USE_AOT_COMPILE")')]) == {}
+
+
+# Read sites: the census above proves every knob is CLASSIFIED; it says
+# nothing about whether a knob is READ. The envs.py comments do, and on
+# the earlier base they were right that VLLM_E2_PLE_FLAG_CHECK had no reader. The diagnostics change
+# relanded its reader (connector.py), so the tables now say which knobs must
+# have a read site and which are INERT, and this test checks both against the
+# tree. A regression either way (a reader dropped by a carry, or an inert knob
+# silently wired) fails here instead of in a reference-host arm that reports "zero
+# findings" from an instrument that never ran.
+_MUST_BE_READ = {
+    "VLLM_E2_PLE_FLAG_CHECK": "vllm/v1/ple_offload/connector.py",
+    "VLLM_E2_MAMBA_SLOT_OWNERSHIP": "vllm/v1/worker/mamba_utils.py",
+}
+_INERT_NO_READ_SITE = ["VLLM_PLE_FP8_GLOBAL_SCALE"]
+
+_READ_SITE = re.compile(
+    r"\benvs\.(\w+)\b"
+    r"|(?:getenv|environ(?:\.get)?)\s*[\(\[]\s*[\"'](\w+)[\"']"
+)
+
+
+def _read_sites(sources) -> dict[str, set[str]]:
+    """{name: files that READ it} (envs.<NAME> or an environ/getenv read)."""
+    sites: dict[str, set[str]] = {}
+    for rel, text in sources:
+        for attr, raw in _READ_SITE.findall(text):
+            sites.setdefault(attr or raw, set()).add(rel.replace("\\", "/"))
+    return sites
+
+
+def test_read_site_status_matches_the_tables():
+    sites = _read_sites(_tree_sources())
+    for name, where in _MUST_BE_READ.items():
+        assert where in sites.get(name, set()), (
+            f"{name} must be read in {where}; read sites found: "
+            f"{sorted(sites.get(name, set()))}"
+        )
+    for name in _INERT_NO_READ_SITE:
+        assert name not in sites, (
+            f"{name} is documented INERT but is read in {sorted(sites[name])}: "
+            "move it to the compile factors or out of the inert list"
+        )
+    # Both tables are classified knobs, and disjoint.
+    assert set(_MUST_BE_READ) <= _classified()
+    assert set(_INERT_NO_READ_SITE) <= _classified()
+    assert not set(_MUST_BE_READ) & set(_INERT_NO_READ_SITE)
+
+
+def test_read_site_scan_discriminates_both_worlds():
+    """Control: a mention in a docstring is not a read; envs.X and getenv are."""
+    mention = [("a.py", '"""VLLM_E2_PLE_FLAG_CHECK=off|warn|raise"""')]
+    via_envs = [("a.py", "_M: str = envs.VLLM_E2_PLE_FLAG_CHECK")]
+    via_getenv = [("a.py", 'os.getenv("VLLM_PLE_FP8_GLOBAL_SCALE", "0")')]
+    assert "VLLM_E2_PLE_FLAG_CHECK" not in _read_sites(mention)
+    assert _read_sites(via_envs)["VLLM_E2_PLE_FLAG_CHECK"] == {"a.py"}
+    assert _read_sites(via_getenv)["VLLM_PLE_FP8_GLOBAL_SCALE"] == {"a.py"}
