diff --git a/tests/v1/ple_offload/test_rowdump_deleted.py b/tests/v1/ple_offload/test_rowdump_deleted.py
new file mode 100644
index 0000000000..97216e2824
--- /dev/null
+++ b/tests/v1/ple_offload/test_rowdump_deleted.py
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The PLE row dump stays deleted on the 0.30 tree.
+
+An earlier cleanup deleted ``vllm/v1/ple_offload/rowdump.py`` and its call
+sites: it was a byte-level push-vs-pull diff for a push transport that no
+longer exists, and nothing reads the ``b"PLER"`` records it writes. The pull-transport
+carry (an earlier commit) restored it verbatim from the E2 base, so the 0.30
+release tree read ``VLLM_PLE_ROW_DUMP`` again -- an unregistered ``VLLM_`` name
+that validate_environ reports as unknown, on the per-step publish path.
+
+Source-level on purpose: importing the connector needs cuda-python, which the
+GPU-free tier does not have, and the property is "no reader and no call site",
+which the source states directly.
+"""
+
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[3]
+_PKG = _ROOT / "vllm" / "v1" / "ple_offload"
+
+
+def _sources():
+    for sub in ("vllm", "vllm_ple_offload_bootstrap", "vllm_ple_test_fault"):
+        base = _ROOT / sub
+        if base.is_dir():
+            yield from base.rglob("*.py")
+
+
+def test_rowdump_module_is_gone():
+    assert _PKG.is_dir(), f"PLE offload package missing at {_PKG}"
+    assert not (_PKG / "rowdump.py").exists()
+
+
+@pytest.mark.parametrize("name", ["connector.py", "worker.py"])
+def test_transport_has_no_rowdump_call_site(name: str):
+    text = (_PKG / name).read_text(encoding="utf-8")
+    assert "rowdump" not in text, f"{name} still imports or calls the row dump"
+
+
+def test_nothing_reads_the_row_dump_env():
+    readers = [
+        str(p.relative_to(_ROOT))
+        for p in _sources()
+        if "VLLM_PLE_ROW_DUMP" in p.read_text(encoding="utf-8", errors="replace")
+    ]
+    assert not readers, f"VLLM_PLE_ROW_DUMP still read by {readers}"
