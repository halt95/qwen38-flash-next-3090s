--- a/vllm/v1/e2_guards.py
+++ b/vllm/v1/e2_guards.py
@@ -214,5 +214,151 @@ def assert_graph_profile_is_executable(vllm_config, *, role: str = "target") ->
     )
 
 
+# --------------------------------------------------------------------------
+# PLE transport: carry the pull transport, UVA disabled.
+# --------------------------------------------------------------------------
+
+#: The fork's pull-transport switch (strict "0"/"1"; registered and hashed in
+#: vllm/envs.py). Renamed from the E2 base's VLLM_PLE_CPU_OFFLOAD.
+PULL_TRANSPORT_ENV = "VLLM_E2_PLE_PULL_TRANSPORT"
+#: Upstream v0.30.0's switch for the pinned-host UVA PLE backend. Same name as
+#: the E2 base's pull switch, opposite default (upstream: "1").
+UPSTREAM_UVA_ENV = "VLLM_PLE_CPU_OFFLOAD"
+
+
+def pull_transport_enabled() -> bool:
+    """Whether the fork's pull transport is on. Strict; raises on bad values.
+
+    One source: the registered accessor ``envs.VLLM_E2_PLE_PULL_TRANSPORT``,
+    whose parser (``envs._e2_strict_switch``) accepts exactly unset/"0"/"1".
+    """
+    import vllm.envs as envs
+
+    return bool(envs.VLLM_E2_PLE_PULL_TRANSPORT)
+
+
+def check_upstream_uva_env_against_pull() -> None:
+    """Fail loud if the old name would turn upstream's UVA path on.
+
+    With the pull transport on, ``VLLM_PLE_CPU_OFFLOAD`` may be unset (the
+    fork then supplies ``cpu_offload=False`` as the Engram default) or exactly
+    ``"0"``. ``"1"`` -- the E2-era spelling of "enable our offload" -- would
+    enable upstream's pinned-host UVA backend beside ours: a double offload.
+    Any other value is rejected rather than interpreted. With the pull
+    transport off this function does nothing: the name is upstream's.
+    """
+    if not pull_transport_enabled():
+        return
+    raw = os.environ.get(UPSTREAM_UVA_ENV)
+    if raw is None or raw == "0":
+        return
+    if raw == "1":
+        raise RuntimeError(
+            f"e2-guard: {PULL_TRANSPORT_ENV}=1 and {UPSTREAM_UVA_ENV}=1. On "
+            f"vLLM v0.30.0 {UPSTREAM_UVA_ENV} is UPSTREAM's switch for the "
+            "pinned-host UVA PLE backend (default on), not the E2 pull "
+            "transport, so this launch asks for both transports at once. Unset "
+            f"{UPSTREAM_UVA_ENV} or export {UPSTREAM_UVA_ENV}=0 "
+            "(the pull transport replaces that switch)."
+        )
+    raise ValueError(
+        f"e2-guard: {PULL_TRANSPORT_ENV}=1 and {UPSTREAM_UVA_ENV}={raw!r}. "
+        f'With the pull transport on, {UPSTREAM_UVA_ENV} must be unset or '
+        'exactly "0"; any other value is refused rather than guessed.'
+    )
+
+
+def pull_transport_cpu_offload_default(upstream_default: bool) -> bool:
+    """The Engram ``cpu_offload`` default, as this fork resolves it.
+
+    Pull off: ``upstream_default`` unchanged (the tree behaves as upstream).
+    Pull on: the old-name check above, then ``False`` -- upstream's UVA
+    backend is never the default beside the pull transport.
+    """
+    if not pull_transport_enabled():
+        return upstream_default
+    check_upstream_uva_env_against_pull()
+    return False
+
+
+def verify_engram_against_pull(engram_config) -> None:
+    """Refuse an explicit ``cpu_offload=True`` while the pull transport is on.
+
+    ``--engram-config '{"cpu_offload": true}'`` takes precedence over every
+    default, so it is checked on the resolved object, not the environment.
+    """
+    if not pull_transport_enabled():
+        return
+    check_upstream_uva_env_against_pull()
+    if engram_config is not None and bool(engram_config.cpu_offload):
+        raise RuntimeError(
+            f"e2-guard: {PULL_TRANSPORT_ENV}=1 but the resolved EngramConfig "
+            "has cpu_offload=True (upstream's pinned-host UVA PLE backend). "
+            "Both transports would own the PLE table. Drop cpu_offload from "
+            "--engram-config (or set it false), or turn the pull transport off."
+        )
+
+
+#: Effective PLE modes, as the guard names them.
+PLE_MODE_PULL = "pull"  # E2 pull transport (VLLM_E2_PLE_PULL_TRANSPORT=1)
+PLE_MODE_UVA = "uva"  # upstream Qwen4ExpPLEPinnedHostEmbedding
+PLE_MODE_DEVICE = "device"  # upstream Qwen4ExpPLEDeviceEmbedding
+PLE_MODE_NONE = "none"  # no Engram config resolved (no PLE layers / not CUDA)
+
+
+def resolve_ple_mode(vllm_config) -> str:
+    """The PLE transport this process will build, or an error if mixed.
+
+    Reads the two inputs that decide it -- the pull switch (strict) and the
+    RESOLVED ``engram_config.cpu_offload`` -- and nothing else. Mixed states
+    raise; there is no fallback from one transport to another.
+    """
+    pull = pull_transport_enabled()
+    check_upstream_uva_env_against_pull()
+    engram_config = getattr(vllm_config, "engram_config", None)
+    cpu_offload = (
+        None if engram_config is None else bool(engram_config.cpu_offload)
+    )
+    if pull:
+        if cpu_offload:
+            raise RuntimeError(
+                f"e2-guard: {PULL_TRANSPORT_ENV}=1 with a resolved Engram "
+                "cpu_offload=True: the pull transport and upstream's UVA "
+                "backend would both own the PLE table."
+            )
+        return PLE_MODE_PULL
+    if cpu_offload is None:
+        return PLE_MODE_NONE
+    return PLE_MODE_UVA if cpu_offload else PLE_MODE_DEVICE
+
+
+def assert_ple_mode(vllm_config, *, role: str = "target") -> str:
+    """Startup guard: resolve, assert and log the effective PLE mode.
+
+    Runs beside ``assert_graph_profile_is_executable`` at model construction
+    for ``role="target"`` and ``role="draft"`` (the MTP drafter carries the
+    target's EngramConfig and the same process environment, so a mixed
+    configuration fails there too). NOT disabled by VLLM_E2_ALLOW_BREAKABLE:
+    that opt-out is about graph identity, not about owning the PLE table twice.
+    """
+    mode = resolve_ple_mode(vllm_config)
+    model_config = getattr(vllm_config, "model_config", None)
+    text_config = getattr(model_config, "hf_text_config", None)
+    ple_layer_ids = list(getattr(text_config, "ple_layer_ids", None) or [])
+    engram_config = getattr(vllm_config, "engram_config", None)
+    logger.info(
+        "e2-guard[%s]: ple_mode=%s pull_transport=%d engram_cpu_offload=%s "
+        "%s=%s ple_layer_ids=%s.",
+        role,
+        mode,
+        1 if mode == PLE_MODE_PULL else 0,
+        None if engram_config is None else bool(engram_config.cpu_offload),
+        UPSTREAM_UVA_ENV,
+        os.environ.get(UPSTREAM_UVA_ENV, "<unset>"),
+        ple_layer_ids,
+    )
+    return mode
+
+
 #: Back-compatible name for the earlier call sites.
 assert_breakable_cudagraph_pinned = assert_graph_profile_is_executable
