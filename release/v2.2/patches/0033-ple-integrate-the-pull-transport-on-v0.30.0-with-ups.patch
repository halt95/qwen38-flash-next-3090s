+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""PLE mode resolution and the guard's refusal of mixed configs.
+
+CPU-only. Imports nothing beyond ``vllm.envs`` and ``vllm.v1.e2_guards`` (plus
+the standard library), so it runs under ``pytest --noconftest`` on a CPU-only machine
+without pyzmq or a CUDA build. Configs are stand-ins: the resolver reads only
+``engram_config.cpu_offload`` and ``model_config.hf_text_config.ple_layer_ids``.
+
+Every refusal has a FAILING CONTROL: the same input with the one deciding
+factor flipped must pass, or a deliberately lax implementation must be shown
+to accept what the real one rejects -- otherwise the refusal test could pass
+because everything raises.
+"""
+
+import re
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+import vllm.envs as envs
+from vllm.v1 import e2_guards
+from vllm.v1.e2_guards import (
+    PLE_MODE_DEVICE,
+    PLE_MODE_NONE,
+    PLE_MODE_PULL,
+    PLE_MODE_UVA,
+    PULL_TRANSPORT_ENV,
+    UPSTREAM_UVA_ENV,
+    assert_ple_mode,
+    check_upstream_uva_env_against_pull,
+    pull_transport_cpu_offload_default,
+    pull_transport_enabled,
+    resolve_ple_mode,
+    verify_engram_against_pull,
+)
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+def _clear_envs_cache() -> None:
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    monkeypatch.delenv(PULL_TRANSPORT_ENV, raising=False)
+    monkeypatch.delenv(UPSTREAM_UVA_ENV, raising=False)
+    _clear_envs_cache()
+    yield
+    _clear_envs_cache()
+
+
+def _set(monkeypatch, name: str, value: str | None) -> None:
+    if value is None:
+        monkeypatch.delenv(name, raising=False)
+    else:
+        monkeypatch.setenv(name, value)
+    _clear_envs_cache()
+
+
+def _config(cpu_offload: bool | None, ple_layer_ids=(2,)):
+    return SimpleNamespace(
+        engram_config=(
+            None if cpu_offload is None else SimpleNamespace(cpu_offload=cpu_offload)
+        ),
+        model_config=SimpleNamespace(
+            hf_text_config=SimpleNamespace(ple_layer_ids=list(ple_layer_ids))
+        ),
+    )
+
+
+# ------------------------------------------------------ the strict switch
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"), [(None, False), ("0", False), ("1", True)]
+)
+def test_switch_accepts_exactly_unset_0_1(monkeypatch, raw, expected) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, raw)
+    assert pull_transport_enabled() is expected
+
+
+@pytest.mark.parametrize(
+    "raw", ["true", "True", "yes", "on", "", " 1", "1 ", "01", "2"]
+)
+def test_switch_rejects_every_other_spelling(monkeypatch, raw) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, raw)
+    with pytest.raises(ValueError, match=PULL_TRANSPORT_ENV):
+        pull_transport_enabled()
+
+
+def test_switch_rejection_control_a_lax_parser_accepts_true(monkeypatch) -> None:
+    """Failing control: the E2 base's parser (``.lower() in ("true", "1")``)
+    would have turned the transport ON for "true"; the registered one must not.
+    Without this, the rejection test above could pass on a parser that raises
+    for everything -- so "1" is re-checked through the same path."""
+
+    def e2_base_parser(raw: str) -> bool:
+        return raw.lower() in ("true", "1")
+
+    assert e2_base_parser("true") is True
+    monkeypatch.setenv(PULL_TRANSPORT_ENV, "true")
+    with pytest.raises(ValueError):
+        envs._e2_strict_switch(PULL_TRANSPORT_ENV)
+    monkeypatch.setenv(PULL_TRANSPORT_ENV, "1")
+    assert envs._e2_strict_switch(PULL_TRANSPORT_ENV) is True
+
+
+def test_switch_is_registered_and_hashed(monkeypatch) -> None:
+    """Registered, live, and NOT in compile_factors' deny-list.
+
+    compile_factors() itself is exercised by tests/test_envs.py's
+    _FORK_HASHED row; on a CPU-only machine without pyzmq an unrelated getter makes it
+    raise, so here the deny-list is read from source instead.
+    """
+    assert PULL_TRANSPORT_ENV in envs.environment_variables
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    assert envs.environment_variables[PULL_TRANSPORT_ENV]() is True
+    src = _src("vllm/envs.py")
+    start = src.index("    ignored_factors: set[str] = {")
+    end = src.index("\n    }\n", start)
+    assert PULL_TRANSPORT_ENV not in src[start:end]
+    # Control: a knob that IS ignored is found by the same slice.
+    assert '"VLLM_E2_ALLOW_BREAKABLE"' in src[start:end]
+
+
+# ------------------------------------------- the old name while pull is on
+
+
+@pytest.mark.parametrize("old", [None, "0"])
+def test_old_name_unset_or_zero_is_accepted_with_pull_on(monkeypatch, old) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    _set(monkeypatch, UPSTREAM_UVA_ENV, old)
+    check_upstream_uva_env_against_pull()
+
+
+def test_old_name_one_with_pull_on_is_the_double_offload(monkeypatch) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    _set(monkeypatch, UPSTREAM_UVA_ENV, "1")
+    with pytest.raises(RuntimeError, match="both transports"):
+        check_upstream_uva_env_against_pull()
+
+
+@pytest.mark.parametrize("old", ["2", "true", "00", ""])
+def test_old_name_other_values_with_pull_on_are_refused(monkeypatch, old) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    _set(monkeypatch, UPSTREAM_UVA_ENV, old)
+    with pytest.raises(ValueError, match=UPSTREAM_UVA_ENV):
+        check_upstream_uva_env_against_pull()
+
+
+@pytest.mark.parametrize("pull", [None, "0"])
+def test_old_name_control_pull_off_leaves_it_to_upstream(monkeypatch, pull) -> None:
+    """Failing control: the SAME VLLM_PLE_CPU_OFFLOAD=1 passes with pull off."""
+    _set(monkeypatch, PULL_TRANSPORT_ENV, pull)
+    _set(monkeypatch, UPSTREAM_UVA_ENV, "1")
+    check_upstream_uva_env_against_pull()
+
+
+# ------------------------------------------------ the Engram default
+
+
+@pytest.mark.parametrize("upstream_default", [True, False])
+def test_default_is_upstream_verbatim_with_pull_off(monkeypatch, upstream_default):
+    assert pull_transport_cpu_offload_default(upstream_default) is upstream_default
+
+
+def test_default_is_false_with_pull_on_even_if_upstream_says_true(monkeypatch):
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    assert pull_transport_cpu_offload_default(True) is False
+
+
+def test_default_with_pull_on_still_refuses_the_old_name(monkeypatch):
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    _set(monkeypatch, UPSTREAM_UVA_ENV, "1")
+    with pytest.raises(RuntimeError):
+        pull_transport_cpu_offload_default(True)
+
+
+# ------------------------------------------------ mode resolution
+
+
+@pytest.mark.parametrize(
+    ("pull", "cpu_offload", "mode"),
+    [
+        (None, None, PLE_MODE_NONE),
+        (None, True, PLE_MODE_UVA),
+        (None, False, PLE_MODE_DEVICE),
+        ("0", True, PLE_MODE_UVA),
+        ("1", False, PLE_MODE_PULL),
+        ("1", None, PLE_MODE_PULL),
+    ],
+)
+def test_mode_resolution_table(monkeypatch, pull, cpu_offload, mode) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, pull)
+    assert resolve_ple_mode(_config(cpu_offload)) == mode
+
+
+def test_mixed_config_is_refused(monkeypatch) -> None:
+    """Pull on + an explicit --engram-config cpu_offload=true: no fallback."""
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    with pytest.raises(RuntimeError, match="both own the PLE table"):
+        resolve_ple_mode(_config(True))
+    with pytest.raises(RuntimeError, match="cpu_offload=True"):
+        verify_engram_against_pull(SimpleNamespace(cpu_offload=True))
+
+
+def test_mixed_config_control_same_engram_with_pull_off_is_uva(monkeypatch) -> None:
+    """Failing control: the identical EngramConfig resolves (to UVA) and
+    verifies cleanly once the one deciding factor, the switch, is off."""
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "0")
+    assert resolve_ple_mode(_config(True)) == PLE_MODE_UVA
+    verify_engram_against_pull(SimpleNamespace(cpu_offload=True))
+
+
+def test_mixed_config_control_pull_on_with_cpu_offload_false_is_pull(monkeypatch):
+    """Failing control on the other factor: pull on, cpu_offload flipped."""
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    assert resolve_ple_mode(_config(False)) == PLE_MODE_PULL
+    verify_engram_against_pull(SimpleNamespace(cpu_offload=False))
+
+
+# ------------------------------------------------ the guard line
+
+
+_GUARD_LINE = re.compile(
+    r"e2-guard\[(?P<role>\w+)\]: ple_mode=(?P<mode>\w+) pull_transport=(?P<p>[01]) "
+    r"engram_cpu_offload=(?P<co>True|False|None) VLLM_PLE_CPU_OFFLOAD=(?P<old>\S+) "
+    r"ple_layer_ids=(?P<ids>\[[^\]]*\])\."
+)
+
+
+def _captured_guard_line(monkeypatch, config, role: str) -> str:
+    lines: list[str] = []
+    monkeypatch.setattr(
+        e2_guards.logger, "info", lambda fmt, *args: lines.append(fmt % args)
+    )
+    assert_ple_mode(config, role=role)
+    assert len(lines) == 1, lines
+    return lines[0]
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+def test_guard_line_names_the_mode_for_both_roles(monkeypatch, role) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    ids = (2,) if role == "target" else ()  # the MTP drafter forces PLE off
+    line = _captured_guard_line(monkeypatch, _config(False, ids), role)
+    m = _GUARD_LINE.fullmatch(line)
+    assert m, line
+    assert m["role"] == role and m["mode"] == PLE_MODE_PULL and m["p"] == "1"
+    assert m["co"] == "False" and m["old"] == "<unset>"
+
+
+def test_guard_refuses_the_drafter_too(monkeypatch) -> None:
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    with pytest.raises(RuntimeError):
+        assert_ple_mode(_config(True, ()), role="draft")
+
+
+def test_guard_ignores_the_breakable_opt_out(monkeypatch) -> None:
+    """VLLM_E2_ALLOW_BREAKABLE=1 must not disarm the PLE refusal."""
+    _set(monkeypatch, PULL_TRANSPORT_ENV, "1")
+    monkeypatch.setenv(e2_guards.ALLOW_BREAKABLE_ENV, "1")
+    with pytest.raises(RuntimeError):
+        assert_ple_mode(_config(True))
+
+
+# --------------------------------------- source-level wiring (no imports)
+
+
+def _src(rel: str) -> str:
+    return (REPO / rel).read_text(encoding="utf-8")
+
+
+def test_uva_constructor_and_selector_refuse_the_pull_switch() -> None:
+    """ngram_embedding.py cannot be imported CPU-only; check the two
+    refusal sites exist in source, before the UVA table is allocated."""
+    src = _src("vllm/models/qwen4_exp/nvidia/ngram_embedding.py")
+    init = src.index("class Qwen4ExpPLEPinnedHostEmbedding")
+    refuse = src.index("if envs.VLLM_E2_PLE_PULL_TRANSPORT:", init)
+    alloc = src.index("get_accelerator_view_from_cpu_tensor(self.weight)", init)
+    assert refuse < alloc
+    assert "if use_uva and envs.VLLM_E2_PLE_PULL_TRANSPORT:" in src
+
+
+def test_no_fork_code_reads_the_old_name() -> None:
+    offenders = []
+    for rel in (
+        "vllm/model_executor/layers/ple_offload_layer.py",
+        "vllm/v1/ple_offload/worker.py",
+        "vllm/v1/ple_offload/connector.py",
+        "vllm/v1/worker/gpu_worker.py",
+        "vllm/v1/executor/multiproc_executor.py",
+        "vllm/v1/executor/uniproc_executor.py",
+        "vllm/config/parallel.py",
+        "vllm/models/qwen4_exp/nvidia/ple_layer.py",
+        "vllm/models/qwen4_exp/nvidia/ple_pull.py",
+    ):
+        if "VLLM_PLE_CPU_OFFLOAD" in _src(rel):
+            offenders.append(rel)
+    assert not offenders
+
+
+_SMOKE_PLE = re.compile(
+    r"Initialized PLE embedding (?P<prefix>\S+?): quantization_method=(?P<method>"
+    r"[A-Za-z0-9_]+), weight_dtype=(?P<dtype>[A-Za-z0-9_.]+), weight_device=(?P<dev>"
+    r"[A-Za-z0-9_:]+), pinned=(?P<pin>True|False)"
+)  # the startup smoke's parser, copied verbatim
+
+
+@pytest.mark.parametrize(
+    "rel",
+    [
+        "vllm/models/qwen4_exp/nvidia/ple_pull.py",
+        "vllm/models/qwen4_exp/nvidia/ngram_embedding.py",
+    ],
+)
+def test_producer_line_format_matches_the_smoke(rel) -> None:
+    src = _src(rel)
+    fmt = (
+        "Initialized PLE embedding %s: quantization_method=%s, "
+        "weight_dtype=%s, weight_device=%s, pinned=%s, backend=%s"
+    )
+    joined = re.sub(r'"\s*\n\s*"', "", src)
+    assert fmt in joined
+    line = fmt % (
+        "model.layers.1.ple.ple_embedding.ngram_embedding",
+        "Qwen4ExpPLEFp8EmbeddingMethod",
+        "torch.float8_e4m3fn",
+        "cpu",
+        False,
+        "E2PullTransport",
+    )
+    m = _SMOKE_PLE.search(line)
+    assert m and m["dtype"] == "torch.float8_e4m3fn" and m["pin"] == "False"
