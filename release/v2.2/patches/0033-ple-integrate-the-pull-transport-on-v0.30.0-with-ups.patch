diff --git a/vllm/envs.py b/vllm/envs.py
index 734a95cd0a..35047dd469 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -376,6 +376,18 @@ if TYPE_CHECKING:
     # to decide behaviour. Registered with the medium-path exact restart
     # so the cache-factor contract is complete.
     MERLIN_TOPK_EXACT_MEDIUM: str | None = None
