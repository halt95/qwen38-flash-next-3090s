diff --git a/tests/v1/engine/test_engine_core_teardown_signal.py b/tests/v1/engine/test_engine_core_teardown_signal.py
new file mode 100644
index 0000000000..94a5255908
--- /dev/null
+++ b/tests/v1/engine/test_engine_core_teardown_signal.py
@@ -0,0 +1,194 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""EngineCore must survive a late SIGTERM while it tears down its executor.
+
+Workers carry PR_SET_PDEATHSIG=SIGKILL, so an EngineCore that dies before
+model_executor.shutdown() has reaped them SIGKILLs every worker before its
+bounds-guard FINAL DRAIN runs. Observed on an earlier-build shutdown: the
+process-group SIGTERM started the shutdown, the API server's process manager
+sent a second SIGTERM in the same second, the finally block had already reset
+SIGTERM to SIG_DFL, EngineCore died before "[shutdown] Executor: waiting for
+worker exit", and FINAL DRAIN printed on 2 of 4 ranks.
+
+The test drives the real EngineCoreProc.run_engine_core with a fake engine whose
+shutdown() receives that second SIGTERM mid-teardown. Unfixed code: the child
+dies with -SIGTERM before teardown completes (the failing control).
+"""
+
+import contextlib
+import multiprocessing
+import os
+import signal
+import sys
+import time
+from types import SimpleNamespace
+
+import pytest
+
+pytestmark = pytest.mark.skipif(
+    not sys.platform.startswith("linux"), reason="fork + POSIX signals"
+)
+
+
+def _child_run(conn, mode: str = "once") -> None:
+    import logging
+
+    from vllm.v1.engine import core
+
+    if mode == "once-hang":
+        core._TEARDOWN_SIGNAL_BOUND_S = 1.0
+
+    run_engine_core = core.EngineCoreProc.run_engine_core
+
+    records: list[str] = []
+
+    class _Capture(logging.Handler):
+        def emit(self, record):
+            records.append(record.getMessage())
+
+    core.logger.addHandler(_Capture(level=logging.WARNING))
+
+    class _FakeEngineCore:
+        def __init__(self, *args, **kwargs):
+            import queue
+
+            self.input_queue = queue.Queue()
+            self.shutdown_state = None
+            self.vllm_config = kwargs["vllm_config"]
+
+        def run_busy_loop(self):
+            # As after the first (process-group) SIGTERM: the busy loop exits.
+            raise SystemExit
+
+        def has_work(self):
+            return False
+
+        def shutdown(self):
+            # The process manager's SIGTERM, delivered mid-teardown.
+            conn.send(("teardown-start", None))
+            os.kill(os.getpid(), signal.SIGTERM)
+            if mode == "twice-hang":
+                time.sleep(0.2)
+                conn.send(("second-signal", None))
+                os.kill(os.getpid(), signal.SIGTERM)
+            if mode in ("twice-hang", "once-hang"):
+                time.sleep(3600)  # teardown hangs (e.g. distributed cleanup)
+            time.sleep(0.3)  # the executor waiting for its workers
+            conn.send(("teardown-done", None))
+
+    core.EngineCoreProc = _FakeEngineCore
+    core.maybe_register_config_serialize_by_value = lambda: None
+    core.set_process_title = lambda *a, **k: None
+    core.maybe_init_worker_tracer = lambda *a, **k: None
+    core.decorate_logs = lambda *a, **k: None
+
+    vllm_config = SimpleNamespace(
+        parallel_config=SimpleNamespace(
+            data_parallel_size=1,
+            numa_bind=False,
+            data_parallel_index=0,
+            reconfigure_for_independent_dp_rank=lambda: None,
+        ),
+        kv_transfer_config=None,
+        model_config=SimpleNamespace(is_moe=False),
+        shutdown_timeout=60,
+    )
+    with contextlib.suppress(SystemExit):
+        run_engine_core(vllm_config=vllm_config)
+    conn.send(
+        (
+            "after",
+            {
+                "sigterm_is_default": signal.getsignal(signal.SIGTERM)
+                is signal.SIG_DFL,
+                "sigint_is_default": signal.getsignal(signal.SIGINT) is signal.SIG_DFL,
+                "warnings": records,
+            },
+        )
+    )
+    conn.close()
+
+
+def test_late_sigterm_does_not_kill_engine_core_teardown():
+    ctx = multiprocessing.get_context("fork")
+    parent, child = ctx.Pipe(duplex=False)
+    proc = ctx.Process(target=_child_run, args=(child,))
+    proc.start()
+    child.close()
+    events = {}
+    deadline = time.monotonic() + 60
+    while time.monotonic() < deadline:
+        if not parent.poll(0.1):
+            # after exit, drain whatever was sent before it
+            if not proc.is_alive() and not parent.poll(0):
+                break
+            continue
+        try:
+            name, payload = parent.recv()
+        except EOFError:
+            break
+        events[name] = payload
+        if name == "after":
+            break
+    proc.join(30)
+    assert "teardown-start" in events, f"fake teardown never ran: {events}"
+    assert proc.exitcode != -signal.SIGTERM, (
+        "EngineCore died of the SIGTERM delivered during teardown "
+        "(workers would be SIGKILLed before their FINAL DRAIN)"
+    )
+    assert "teardown-done" in events, f"teardown did not complete: {events}"
+    after = events.get("after")
+    assert after is not None, f"run_engine_core did not return: {events}"
+    assert proc.exitcode == 0, proc.exitcode
+    # default dispositions are restored once teardown is over
+    assert after["sigterm_is_default"] and after["sigint_is_default"], after
+    # fail loud: the deferred signal is logged
+    assert any(
+        "SIGTERM during resource teardown deferred" in m for m in after["warnings"]
+    ), after["warnings"]
+
+
+def _run_hanging_teardown(mode: str, bound_s: float):
+    ctx = multiprocessing.get_context("fork")
+    parent, child = ctx.Pipe(duplex=False)
+    proc = ctx.Process(target=_child_run, args=(child, mode))
+    start = time.monotonic()
+    proc.start()
+    child.close()
+    proc.join(bound_s)
+    elapsed = time.monotonic() - start
+    alive = proc.is_alive()
+    if alive:
+        proc.kill()
+        proc.join(10)
+    events = []
+    while True:
+        try:
+            if not parent.poll(0.2):
+                break
+            events.append(parent.recv()[0])
+        except (EOFError, OSError):
+            break
+    return alive, proc.exitcode, elapsed, events
+
+
+def test_second_late_signal_ends_a_hung_teardown():
+    # The deferral must be bounded. The first late SIGTERM is
+    # deferred (the drain-race fix); a second one while teardown hangs ends
+    # the process by that signal. Unfixed code (every late signal deferred)
+    # stays alive until killed (the failing control).
+    alive, exitcode, elapsed, events = _run_hanging_teardown("twice-hang", 15)
+    assert "teardown-start" in events and "second-signal" in events, events
+    assert not alive, f"hung teardown survived a second SIGTERM ({elapsed:.1f}s)"
+    assert exitcode == -signal.SIGTERM, exitcode
+    assert "teardown-done" not in events, events
+
+
+def test_teardown_watchdog_bounds_a_single_deferred_signal():
+    # One deferred SIGTERM, then teardown hangs: the watchdog ends the process
+    # (exit code 1) once _TEARDOWN_SIGNAL_BOUND_S (1 s here) has passed.
+    alive, exitcode, elapsed, events = _run_hanging_teardown("once-hang", 15)
+    assert "teardown-start" in events, events
+    assert not alive, f"hung teardown outlived the watchdog ({elapsed:.1f}s)"
+    assert exitcode == 1, exitcode
+    assert "teardown-done" not in events, events
