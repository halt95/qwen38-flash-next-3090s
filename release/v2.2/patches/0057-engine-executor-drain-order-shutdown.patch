+
+
+ple_worker.PleOffloadWorkerHandle.close = forbidden
+ple_worker.PleOffloadWorkerHandle._close_without_reap = forbidden
+t0 = time.monotonic()
+os.write(1, b"FIRE %.6f\n" % t0)
+try:
+    raise RuntimeError("PLE test fault: exc_after_prepare")
+except RuntimeError as error:
