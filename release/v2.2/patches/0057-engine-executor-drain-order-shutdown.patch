+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""A worker whose orderly shutdown has finished must exit, not linger.
+
+A fault-injection run with the drain-order deferred-signal fix: every rank printed
+its bounds-guard FINAL DRAIN within ~1 s of the executor closing the death pipes,
+but then stayed alive past VLLM_WORKER_SHUTDOWN_TIMEOUT_SECONDS (5 s); the
+executor logged two WARNINGs and SIGKILLed the workers at ~9 s. After
+Worker.shutdown() (drain, instrumentation flushes, PLE cleanup) WorkerProc
+destroys the model-parallel groups, and PyNcclCommunicator.destroy() joins its
+ncclCommAbort thread for up to 5 s per communicator while the CUDA graphs that
+captured NCCL ops are still alive. The executor's SIGTERM is then a no-op (the
+worker's handler raises SystemExit only once and the death-pipe monitor already
+set shutdown_requested), so the ladder runs to SIGKILL.
+
+The fake below reproduces that: destroy_model_parallel blocks _SLOW_DESTROY_S.
+Unfixed code pays it before the process can exit (the failing controls); fixed
+code runs WorkerProc.shutdown(destroy_distributed=False) and exits right after.
+"""
+
+import logging
+import multiprocessing
+import os
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+# CPU-only fakes: no process groups or device memory to clean up afterwards.
+pytestmark = pytest.mark.skip_global_cleanup
+
+_SLOW_DESTROY_S = 6.0  # > the executor's 5 s grace, like the NCCL destroy join
+_EXIT_BOUND_S = 3.0  # reference-host bound: all workers gone <= 3 s after the drain
+
+
+class _FakeMQ:
+    def __init__(self, entered: threading.Event | None = None):
+        self.entered = entered
+        self.stop = threading.Event()
+        self.shutting_down = False
+
+    def export_handle(self):
+        return None
+
+    def wait_until_ready(self):
+        pass
+
+    def shutdown(self):
+        self.shutting_down = True
+        self.stop.set()
+
+    def dequeue(self, indefinite=True):
+        if self.entered is not None:
+            self.entered.set()
+        # shm_broadcast.acquire_read raises RuntimeError("cancelled") once the
+        # death-pipe monitor has called shutdown().
+        self.stop.wait()
+        raise RuntimeError("cancelled")
+
+
+class _FakeInnerWorker:
+    """Stands in for gpu_worker.Worker; shutdown() is where FINAL DRAIN runs."""
+
+    def __init__(self, record):
+        self.record = record
+
+    def shutdown(self):
+        self.record("drain")
+
+
+def _patch_executor(executor_module, record, entered, slow_destroy_s, set_=setattr):
+    real_worker_proc = executor_module.WorkerProc
+
+    def fake_init(self, *args, **kwargs):
+        self.rank = 0
+        self.worker = _FakeInnerWorker(record)
+        self.rpc_broadcast_mq = _FakeMQ(entered)
+        self.worker_response_mq = _FakeMQ()
+        self.peer_response_handles = []
+        self.use_async_scheduling = False
+
+    def slow_destroy_model_parallel():
+        record("destroy_model_parallel")
+        time.sleep(slow_destroy_s)
+
+    set_(real_worker_proc, "__init__", fake_init)
+    set_(executor_module, "destroy_model_parallel", slow_destroy_model_parallel)
+    set_(
+        executor_module,
+        "destroy_distributed_environment",
+        lambda: record("destroy_distributed_environment"),
+    )
+    set_(executor_module, "maybe_init_worker_tracer", lambda **kwargs: None)
+    set_(executor_module, "set_worker_net_device", lambda *args, **kwargs: None)
+
+
+def _fake_config():
+    return SimpleNamespace(
+        parallel_config=SimpleNamespace(
+            assigned_physical_gpu_ids=None,
+            numa_bind=False,
+        )
+    )
+
+
+# ---------------------------------------------------------------------------
+# In-process: the real worker_main / WorkerProc.shutdown, os._exit intercepted.
+# ---------------------------------------------------------------------------
+
+
+class _Exited(BaseException):
+    def __init__(self, code):
+        super().__init__(code)
+        self.code = code
+
+
+def _run_worker_main_in_process(
+    monkeypatch,
+    *,
+    busy_loop_error=None,
+    fail_after_shutdown_request=False,
+    slow_destroy_s=_SLOW_DESTROY_S,
+):
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    events: list[tuple[str, float]] = []
+
+    def record(name):
+        events.append((name, time.monotonic()))
+
+    entered = threading.Event()
+    _patch_executor(
+        executor_module, record, entered, slow_destroy_s, monkeypatch.setattr
+    )
+    if busy_loop_error is not None:
+
+        def failing_busy_loop(self):
+            if fail_after_shutdown_request:
+                # Idle until the death-pipe monitor has set shutdown_requested
+                # and shut the queues down, then fail for a reason of its own.
+                entered.set()
+                assert self.rpc_broadcast_mq.stop.wait(30)
+            raise busy_loop_error
+
+        monkeypatch.setattr(
+            executor_module.WorkerProc, "worker_busy_loop", failing_busy_loop
+        )
+    # worker_main arms PDEATHSIG and installs SIGTERM/SIGINT handlers; keep
+    # both off the pytest process.
+    monkeypatch.setattr(
+        executor_module, "_install_worker_parent_death_signal", lambda pid: None
+    )
+    monkeypatch.setattr(executor_module.signal, "signal", lambda *a, **k: None)
+    monkeypatch.setattr(logging, "shutdown", lambda *a, **k: None)
+    # The orderly path marks this (pytest) process exit-imminent for the PLE
+    # handle; restore the flag so later PLE close() tests see a live process.
+    ple_worker = sys.modules.get("vllm.v1.ple_offload.worker")
+    if ple_worker is not None:
+        monkeypatch.setattr(
+            ple_worker,
+            "_PROCESS_EXIT_IMMINENT",
+            getattr(ple_worker, "_PROCESS_EXIT_IMMINENT", False),
+            raising=False,
+        )
+
+    def fake_exit(code):
+        record("os._exit")
+        raise _Exited(code)
+
+    monkeypatch.setattr(os, "_exit", fake_exit)
+
+    ctx = multiprocessing.get_context()
+    ready_reader, ready_writer = ctx.Pipe(duplex=False)
+    death_reader, death_writer = ctx.Pipe(duplex=False)
+
+    def close_death_pipe_when_idle():
+        # The executor's shutdown(): close the death pipe once the worker idles.
+        if entered.wait(30):
+            record("death_pipe_closed")
+            death_writer.close()
+
+    closer = threading.Thread(target=close_death_pipe_when_idle, daemon=True)
+    closer.start()
+
+    exit_code = None
+    start = time.monotonic()
+    try:
+        executor_module.WorkerProc.worker_main(
+            vllm_config=_fake_config(),
+            ready_pipe=ready_writer,
+            death_pipe=death_reader,
+            inherited_fds=[],
+            expected_parent_pid=os.getpid(),
+        )
+    except _Exited as exited:
+        exit_code = exited.code
+    except SystemExit as exited:
+        record("SystemExit")
+        exit_code = exited.code
+    finally:
+        entered.set()  # a failing busy loop never dequeues
+        closer.join(5)
+    assert ready_reader.recv()["status"] == "READY"
+    ready_reader.close()
+    return events, exit_code, time.monotonic() - start
+
+
+def test_orderly_shutdown_exits_right_after_drain(monkeypatch):
+    events, exit_code, _ = _run_worker_main_in_process(monkeypatch)
+    names = [name for name, _ in events]
+    assert "drain" in names, f"FINAL DRAIN never ran: {names}"
+    assert exit_code is not None, (
+        "worker_main returned instead of exiting the process after its "
+        f"orderly shutdown (the process would linger in teardown): {names}"
+    )
+    assert exit_code == 0
+    assert "destroy_model_parallel" not in names, (
+        f"the exit-only NCCL destroy ran before the process exit: {names}"
+    )
+    t = dict(events)
+    assert names.index("drain") < names.index("os._exit"), names
+    assert t["os._exit"] - t["drain"] <= _EXIT_BOUND_S, events
+
+
+def test_unexpected_busy_loop_failure_keeps_full_teardown(monkeypatch):
+    # Not an orderly shutdown (no shutdown request): unchanged behaviour --
+    # full WorkerProc.shutdown incl. distributed destroy, then a normal return.
+    events, exit_code, _ = _run_worker_main_in_process(
+        monkeypatch, busy_loop_error=ValueError("boom"), slow_destroy_s=0.0
+    )
+    names = [name for name, _ in events]
+    assert exit_code is None, names
+    assert names.count("drain") == 1, names
+    assert "destroy_model_parallel" in names, names
+    assert "destroy_distributed_environment" in names, names
+
+
+def test_failure_racing_shutdown_is_not_an_orderly_exit(monkeypatch):
+    # A real busy-loop failure that happens while a shutdown
+    # request is pending must not take the orderly exit-0 path. Unfixed code
+    # treats ANY exception as orderly once shutdown_requested is set (the
+    # failing control: exit code 0, no distributed teardown).
+    events, exit_code, _ = _run_worker_main_in_process(
+        monkeypatch,
+        busy_loop_error=ValueError("boom"),
+        fail_after_shutdown_request=True,
+        slow_destroy_s=0.0,
+    )
+    names = [name for name, _ in events]
+    assert "death_pipe_closed" in names, names
+    assert exit_code not in (None, 0), (
+        f"a worker failure that raced the shutdown request exited {exit_code!r} "
+        f"(hidden as a clean exit): {names}"
+    )
+    assert "os._exit" not in names, f"took the orderly exit path: {names}"
+    assert names.count("drain") == 1, names
+    assert "destroy_model_parallel" in names, names
+    assert "destroy_distributed_environment" in names, names
+
+
+def test_busy_loop_raises_shutdown_type_only_for_its_own_cancellation():
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    proc = executor_module.WorkerProc.__new__(executor_module.WorkerProc)
+    proc.rpc_broadcast_mq = _FakeMQ()
+    proc.rpc_broadcast_mq.shutdown()
+    with pytest.raises(executor_module.WorkerShutdownRequested):
+        proc.worker_busy_loop()
+
+    class _NotShutDownMQ(_FakeMQ):
+        def dequeue(self, indefinite=True):
+            raise RuntimeError("cancelled")  # but nobody shut this queue down
+
+    proc.rpc_broadcast_mq = _NotShutDownMQ()
+    with pytest.raises(RuntimeError) as info:
+        proc.worker_busy_loop()
+    assert not isinstance(info.value, executor_module.WorkerShutdownRequested)
+
+
+# ---------------------------------------------------------------------------
+# Real processes: the executor's own grace/SIGTERM/SIGKILL ladder.
+# ---------------------------------------------------------------------------
+
+
+def _worker_child(ready_pipe, death_pipe, events_pipe, parent_pid):
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    def record(name):
+        events_pipe.send((name, time.monotonic()))
+
+    _patch_executor(executor_module, record, None, _SLOW_DESTROY_S)
+    executor_module.WorkerProc.worker_main(
+        vllm_config=_fake_config(),
+        ready_pipe=ready_pipe,
+        death_pipe=death_pipe,
+        inherited_fds=[],
+        expected_parent_pid=parent_pid,
+    )
+
+
+def test_executor_reaps_drained_workers_within_grace():
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    ctx = multiprocessing.get_context("spawn")
+    procs, deaths, readers = [], [], []
+    for _ in range(2):  # two ranks, as the executor sees them
+        ready_reader, ready_writer = ctx.Pipe(duplex=False)
+        death_reader, death_writer = ctx.Pipe(duplex=False)
+        events_reader, events_writer = ctx.Pipe(duplex=False)
+        proc = ctx.Process(
+            target=_worker_child,
+            args=(ready_writer, death_reader, events_writer, os.getpid()),
+            daemon=True,
+        )
+        proc.start()
+        ready_writer.close()
+        death_reader.close()
+        events_writer.close()
+        assert ready_reader.poll(180), "worker child never became READY"
+        assert ready_reader.recv()["status"] == "READY"
