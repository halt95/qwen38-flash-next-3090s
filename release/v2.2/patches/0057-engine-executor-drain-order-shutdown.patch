diff --git a/tests/v1/executor/test_multiproc_failed_worker_ladder.py b/tests/v1/executor/test_multiproc_failed_worker_ladder.py
new file mode 100644
index 0000000000..9c591132f4
--- /dev/null
+++ b/tests/v1/executor/test_multiproc_failed_worker_ladder.py
@@ -0,0 +1,212 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""After a worker died, parked survivors are killed fast; draining ones are not.
+
+A drain fault-injection run (earlier build): the PLE fault killed rank 0. One
+survivor drained and exited at once. Two ranks sat in a collective with the
+dead rank, inside C code where neither the grace nor the SIGTERM reaches them,
+and the executor ran its full 5 s grace + 4 s SIGTERM wait before SIGKILL.
+Workers were gone 17.6 s after the fault, vs 8.7 s on an earlier build, where the
+engine died on the late SIGTERM and PDEATHSIG killed the survivors at once.
+the drain-order change keeps the engine alive for the drain, so the failure ladder has
+to be short on its own.
+
+A known hazard: a blanket 1 s cap can cut a survivor that is still
+draining. Each worker now publishes a shared byte: 0 = shutdown not started,
+1 = started (FINAL DRAIN in progress), 2 = done. Only workers with no drain
+signal get the 1 s ladder.
+
+A later drain fault-injection run: a survivor whose shutdown had STARTED blocked
+inside it on the dead rank (no FINAL DRAIN line) and got the full orderly
+ladder; workers gone 17.6 s after the fault. Started shutdowns now get a
+bounded 2 s grace on the failure path (every measured FINAL DRAIN < 0.1 s),
+then SIGTERM, then SIGKILL after 1 s.
+"""
+
+import contextlib
+import signal
+import subprocess
+import sys
+import time
+from types import SimpleNamespace
+
+import pytest
+
+pytestmark = [
+    pytest.mark.skip_global_cleanup,
+    pytest.mark.skipif(sys.platform == "win32", reason="POSIX signals"),
+]
+
+# Parked in a collective: ignores SIGTERM, never exits on its own.
+_PARKED = (
+    "import signal, time\n"
+    "signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
+    "print('ready', flush=True)\n"
+    "time.sleep(600)\n"
+)
+# Draining: default SIGTERM (would die -15), exits 0 by itself after 1.2 s --
+# 12x the longest FINAL DRAIN measured on the reference host, inside the 2 s failure grace.
+_DRAINING_S = 1.2
+_DRAINING = (
+    "import os, time\n"
+    "print('ready', flush=True)\n"
+    f"time.sleep({_DRAINING_S})\n"
+    "os._exit(0)\n"
+)
+
+
+class _Proc:
+    """The BaseProcess surface _ensure_worker_termination uses."""
+
+    def __init__(self, script):
+        self.popen = subprocess.Popen(
+            [sys.executable, "-c", script], stdout=subprocess.PIPE, text=True
+        )
+        assert self.popen.stdout.readline().strip() == "ready"
+
+    def is_alive(self):
+        return self.popen.poll() is None
+
+    def terminate(self):
+        self.popen.send_signal(signal.SIGTERM)
+
+    def kill(self):
+        self.popen.kill()
+
+
+class _Handle:
+    def __init__(self, script, state):
+        self.proc = _Proc(script)
+        self.death_writer = None
+        self.worker_response_mq = None
+        # None = no state published (older handle): treated as parked.
+        self.shutdown_state = None if state is None else SimpleNamespace(value=state)
+
+
+def _executor(workers, *, failed):
+    from vllm.v1.executor.multiproc_executor import MultiprocExecutor
+
+    executor = object.__new__(MultiprocExecutor)
+    executor.workers = workers
+    executor.is_failed = failed
+    executor.rpc_broadcast_mq = None
+    executor.response_mqs = []
+    return executor
+
+
+def _shutdown(specs, *, failed):
+    workers = [_Handle(script, state) for script, state in specs]
+    try:
+        start = time.monotonic()
+        _executor(workers, failed=failed).shutdown()
+        elapsed = time.monotonic() - start
+        # The ladder's last step sends SIGKILL without waiting for the reap.
+        for w in workers:
+            with contextlib.suppress(subprocess.TimeoutExpired):
+                w.proc.popen.wait(2)
+        codes = [w.proc.popen.returncode for w in workers]
+    finally:
+        for w in workers:
+            if w.proc.is_alive():
+                w.proc.kill()
+            w.proc.popen.wait(10)
+    return elapsed, codes
+
+
+def test_failure_shutdown_kills_parked_survivors_fast():
+    elapsed, codes = _shutdown([(_PARKED, 0), (_PARKED, None)], failed=True)
+    assert all(c is not None for c in codes), codes
+    assert elapsed < 3.0, (
+        f"a failure-triggered shutdown took {elapsed:.1f} s to kill ranks parked "
+        "with the dead rank (the orderly 5 s grace + 4 s SIGTERM ladder)"
+    )
+
+
+def test_failure_shutdown_lets_a_draining_survivor_finish():
+    elapsed, codes = _shutdown([(_DRAINING, 1), (_PARKED, 0)], failed=True)
+    assert codes[0] == 0, (
+        f"the draining survivor was signalled (exit {codes[0]}) instead of "
+        "finishing its FINAL DRAIN"
+    )
+    assert codes[1] is not None
+    # The parked survivor is SIGKILLed at ~2 s; the drainer was never signalled.
+    assert _DRAINING_S - 0.3 <= elapsed < 3.0, elapsed
+
+
+def test_failure_shutdown_ends_a_survivor_stuck_in_its_shutdown():
+    # Started its shutdown (state 1), then blocked on the dead rank: ignores
+    # SIGTERM like a rank inside a device synchronize, never exits by itself.
+    elapsed, codes = _shutdown([(_PARKED, 1), (_PARKED, 0)], failed=True)
+    assert all(c is not None for c in codes), codes
+    assert codes[0] == -signal.SIGKILL, codes
+    assert elapsed < 2.0 + 1.0 + 0.6, (
+        f"a failure-triggered shutdown took {elapsed:.1f} s to end a survivor "
+        "stuck inside its started shutdown (bound: 2 s grace + 1 s SIGTERM wait)"
+    )
+
+
+def test_orderly_shutdown_keeps_its_grace(monkeypatch):
+    monkeypatch.setenv("VLLM_WORKER_SHUTDOWN_TIMEOUT_SECONDS", "2")
+    elapsed, codes = _shutdown([(_PARKED, 0), (_PARKED, 0)], failed=False)
+    assert all(c is not None for c in codes), codes
+    # Unchanged: the configured grace, then the 4 s SIGTERM wait, then SIGKILL.
+    assert elapsed >= 2.0 + 4.0 - 0.5, elapsed
+
+
+def test_worker_main_publishes_shutdown_started_then_done(monkeypatch):
+    """worker_main marks 1 before WorkerProc.shutdown() (drain) and 2 after."""
+    import multiprocessing
+    import os
+
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    seen = []
+    state = multiprocessing.RawValue("b", 0)
+
+    class _Inner:
+        def shutdown(self):
+            seen.append(("drain", state.value))
+
+    def fake_init(self, *args, **kwargs):
+        self.rank = 0
+        self.worker = _Inner()
+        self.rpc_broadcast_mq = None
+        self.worker_response_mq = SimpleNamespace(
+            export_handle=lambda: None,
+            wait_until_ready=lambda: None,
+            shutdown=lambda: None,
+        )
+        self.peer_response_handles = []
+
+    def busy_loop(self):
+        seen.append(("busy", state.value))
+        raise ValueError("boom")  # an unexpected failure: full teardown path
+
+    monkeypatch.setattr(executor_module.WorkerProc, "__init__", fake_init)
+    monkeypatch.setattr(executor_module.WorkerProc, "worker_busy_loop", busy_loop)
+    monkeypatch.setattr(executor_module, "destroy_model_parallel", lambda: None)
+    monkeypatch.setattr(
+        executor_module, "destroy_distributed_environment", lambda: None
+    )
+    monkeypatch.setattr(executor_module, "maybe_init_worker_tracer", lambda **k: None)
+    monkeypatch.setattr(executor_module, "set_worker_net_device", lambda *a, **k: None)
+    monkeypatch.setattr(
+        executor_module, "_install_worker_parent_death_signal", lambda pid: None
+    )
+    monkeypatch.setattr(executor_module.signal, "signal", lambda *a, **k: None)
+    ready_reader, ready_writer = multiprocessing.Pipe(duplex=False)
+    executor_module.WorkerProc.worker_main(
+        vllm_config=SimpleNamespace(
+            parallel_config=SimpleNamespace(
+                assigned_physical_gpu_ids=None, numa_bind=False
+            )
+        ),
+        ready_pipe=ready_writer,
+        death_pipe=None,
+        shutdown_state=state,
+        inherited_fds=[],
+        expected_parent_pid=os.getpid(),
+    )
+    ready_reader.close()
+    assert seen == [("busy", 0), ("drain", 1)], seen
+    assert state.value == 2
diff --git a/tests/v1/executor/test_multiproc_ple_exit_without_reap.py b/tests/v1/executor/test_multiproc_ple_exit_without_reap.py
new file mode 100644
index 0000000000..4bab227522
--- /dev/null
+++ b/tests/v1/executor/test_multiproc_ple_exit_without_reap.py
@@ -0,0 +1,344 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Rank 0 waits for its PLE offload child to leave userspace, not for its reap.
+
+A drain run on an earlier build: on every F cycle three ranks exited
+right after their FINAL DRAIN, but Worker_PP0_TP0, the rank that owns the PLE
+offload process, sat in Worker.shutdown() -> PleOffloadWorkerHandle.close()
+until the executor's grace ran out (SIGTERM at +5 s, SIGKILL at +9 s). A
+read-only /proc sample showed the cause. The offload child (RSS ~51 GB)
+finished its userspace, and its leader went Z at ~+2.7 s. One thread stayed R
+with PF_EXITING set, in-kernel, freeing the address space, so the child was
+not reapable until ~+8.6 s.
+
+A known hazard: a Z leader alone does not prove the child left
+userspace, because another thread can still run. close() therefore waits for
+every task to be Z/X or PF_EXITING.
+
+Covered here:
+- the predicate itself, on a fake procfs;
+- close() does not wait for the reap once the thread group is in exit (fake
+  procfs over a live, unreaped child); the earlier build waits for the reap and fails this;
+- close() does wait while a non-leader thread still runs userspace (real
+  child whose leader exits alone); the earlier commit fails this;
+- the bound: a child that ignores SIGTERM is SIGKILLed within the bound, and
+  the bound fits inside the executor's grace;
+- the default close() still reaps.
+"""
+
+import contextlib
+import platform
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+from multiprocessing.connection import Connection
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+linux_only = pytest.mark.skipif(
+    sys.platform != "linux" or platform.machine() not in ("x86_64", "aarch64"),
+    reason="needs Linux /proc and a raw SYS_exit number",
+)
+
+_SYS_EXIT = {"x86_64": 60, "aarch64": 93}.get(platform.machine(), -1)
+
+# On SIGTERM: run the cleanup (unlink + marker, like proc_main's finally), then
+# the leader thread exits alone (raw SYS_exit) while a second thread keeps
+# running userspace for LINGER seconds. mode=ignore: SIGTERM is ignored.
+_STUB_CHILD = r"""
+import ctypes
+import os
+import pathlib
+import signal
+import sys
+import threading
+import time
+
+endpoint, marker, linger_s, sys_exit, mode = sys.argv[1:]
+stop = threading.Event()
+if mode == "ignore":
+    signal.signal(signal.SIGTERM, signal.SIG_IGN)
+else:
+    signal.signal(signal.SIGTERM, lambda _s, _f: stop.set())
+pathlib.Path(endpoint).touch()
+print("ready", flush=True)
+if mode == "ignore":
+    time.sleep(600)
+stop.wait()
+os.unlink(endpoint)
+pathlib.Path(marker).touch()
+
+
+def linger():
+    time.sleep(float(linger_s))  # userspace: NOT in the exit path yet
+    os._exit(0)
+
+
+threading.Thread(target=linger).start()
+ctypes.CDLL(None).syscall(int(sys_exit), 0)
+"""
+
+
+def _stat_line(pid, comm, state, flags):
+    # Field 9 (flags) is the 7th field after the parenthesised comm.
+    return f"{pid} ({comm}) {state} 1 1 1 0 -1 {flags} 0 0 0 0\n"
+
+
+def _fake_task_tree(root: Path, pid: int, tasks):
+    for tid, comm, state, flags in tasks:
+        d = root / str(pid) / "task" / str(tid)
+        d.mkdir(parents=True)
+        (d / "stat").write_text(_stat_line(tid, comm, state, flags))
+
+
+def _start_handle(tmp: Path, linger_s: float, mode: str = "graceful"):
+    from vllm.v1.ple_offload.worker import PleOffloadWorkerHandle
+
+    endpoint = tmp / "ple.sock"
+    marker = tmp / "cleanup.done"
+    proc = subprocess.Popen(
+        [
+            sys.executable,
+            "-c",
+            _STUB_CHILD,
+            str(endpoint),
+            str(marker),
+            str(linger_s),
+            str(_SYS_EXIT),
+            mode,
+        ],
+        stdout=subprocess.PIPE,
+        text=True,
+    )
+    assert proc.stdout.readline().strip() == "ready"
+    # gpu_worker._start_ple_offload_watchdog: a thread blocked in proc.wait()
+    # holds Popen._waitpid_lock for as long as the child is unreapable.
+    watchdog = threading.Thread(target=proc.wait, daemon=True)
+    watchdog.start()
+    parent_death, child_death = socket.socketpair()
+    handle = PleOffloadWorkerHandle(
+        proc=proc,
+        death_writer=Connection(parent_death.detach()),
+        ready_pipe_reader=None,
+        launch_deadline=time.monotonic() + 60,
+        ipc_addr=f"ipc://{endpoint}",
+    )
+    return handle, proc, watchdog, endpoint, marker, child_death
+
+
+def _finish(proc, watchdog, child_end, join_s=15):
+    with contextlib.suppress(ProcessLookupError):
+        if proc.returncode is None:
+            proc.send_signal(signal.SIGKILL)
+    watchdog.join(join_s)
+    child_end.close()
+
+
+@pytest.mark.parametrize(
+    "tasks, expected",
+    [
+        # Observed shape (a shutdown sample): leader Z, one task R with PF_EXITING.
+        ([(1, "python3.13", "Z", 0x40810C), (2, "python3.13", "R", 0x40044C)], True),
+        # Leader Z, a thread still in userspace (no PF_EXITING).
+        ([(1, "python3.13", "Z", 0x40810C), (2, "python3.13", "S", 0x400040)], False),
+        ([(1, "python3.13", "S", 0x400100)], False),
+        ([(1, "odd) comm (x", "X", 0)], True),
+        ([], True),
+    ],
+)
+def test_thread_group_predicate(tmp_path, tasks, expected):
+    from vllm.v1.ple_offload.worker import _child_thread_group_exiting
+
+    pid = 4242
+    if tasks:
+        _fake_task_tree(tmp_path, pid, tasks)
+    else:
+        (tmp_path / str(pid) / "task").mkdir(parents=True)
+    proc = type("P", (), {"pid": pid, "returncode": None})()
+    assert _child_thread_group_exiting(proc, str(tmp_path)) is expected
+
+
+@linux_only
+def test_exit_imminent_close_does_not_wait_for_the_reap(monkeypatch, tmp_path):
+    import vllm.v1.ple_offload.worker as ple_worker
+
+    monkeypatch.setattr(ple_worker, "_PROCESS_EXIT_IMMINENT", True, raising=False)
+    with tempfile.TemporaryDirectory() as d:
+        # A live child that will not exit on SIGTERM stands in for the 51 GB
+        # child: unreapable for as long as the test wants.
+        handle, proc, watchdog, endpoint, marker, child_end = _start_handle(
+            Path(d), 0, mode="ignore"
+        )
+        try:
+            # procfs says: leader Z, the other task R with PF_EXITING.
+            fake = tmp_path / "proc"
+            _fake_task_tree(
+                fake,
+                proc.pid,
+                [(proc.pid, "python3.13", "Z", 0x40810C), (1, "x", "R", 0x40044C)],
+            )
+            monkeypatch.setattr(ple_worker, "_PROC_ROOT", str(fake), raising=False)
+            start = time.monotonic()
+            handle.close()
+            elapsed = time.monotonic() - start
+            assert elapsed < 1.0, (
+                f"close() waited {elapsed:.1f} s for the offload child's reap "
+                "although its thread group was in the kernel exit path; the "
+                "executor's 5 s grace expires first on the reference host"
+            )
+            assert proc.poll() is None, "close() reaped or killed the child"
+            assert handle.death_writer is None
+        finally:
+            _finish(proc, watchdog, child_end)
+
