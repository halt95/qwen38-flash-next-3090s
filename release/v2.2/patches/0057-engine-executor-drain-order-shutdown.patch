+    monkeypatch.setattr(ple_worker, "_PROCESS_EXIT_IMMINENT", True, raising=False)
+    bound = ple_worker._EXIT_IMMINENT_CHILD_WAIT_S
+    # Rank 0 must be gone before the executor's grace; leave >= 1 s for the
+    # rest of its shutdown and its own exit.
