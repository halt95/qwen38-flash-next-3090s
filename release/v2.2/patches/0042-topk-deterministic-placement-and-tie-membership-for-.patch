+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_large_control_arm_is_untouched() -> None:
+    """MERLIN_TOPK_DET_LARGE=0 must be the real v2.0.1 baseline.
