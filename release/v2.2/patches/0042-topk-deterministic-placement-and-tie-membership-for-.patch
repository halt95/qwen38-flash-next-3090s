+            f"row {row}: control arm returned an out-of-range index"
+        )
+        assert got.unique().numel() == LARGEDET_TOP_K, (
+            f"row {row}: control arm returned a duplicate index"
+        )
+        got_values = logits[row][got].sort().values
+        assert torch.equal(got_values, ref_values), (
+            f"row {row}: control-arm values are not torch.topk's values"
+        )
