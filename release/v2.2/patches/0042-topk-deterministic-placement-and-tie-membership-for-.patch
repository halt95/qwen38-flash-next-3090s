+@torch.inference_mode()
+def test_persistent_topk_large_tie_keeps_highest_indices() -> None:
+    """Multi-CTA tie at the cutoff: most-recent-wins, ascending, reproducible."""
+    torch.set_default_device("cuda:0")
+    num_rows = 8  # <= 32 keeps the dispatch on persistent_topk
+
+    before = _largedet_counters_or_skip(require_on=True)
+
+    logits, expected = _build_largedet_tie_row(num_rows)
+    first = _run_largedet_row(logits).clone()
+    mid = _read_exact_counters()
+    second = _run_largedet_row(logits)
+    after = _read_exact_counters()
+
+    # 1. The instrument fired, with EXACT deltas. A lower bound would hide
+    #    double counting, and a green assertion below means nothing unless the
+    #    deterministic path is what produced it.
+    assert mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS] == num_rows, (
+        "the deterministic large path did not run on every row: "
+        f"{mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS]} of {num_rows}"
+    )
+    assert mid[_SLOT_LARGE_TIES_CUT] - before[_SLOT_LARGE_TIES_CUT] == num_rows, (
+        "the tie cut did not fire; this row is built so it must"
+    )
+    assert (
+        mid[_SLOT_LARGE_TIES_DROPPED] - before[_SLOT_LARGE_TIES_DROPPED]
+        == num_rows * LARGEDET_DROPPED
+    ), "the number of discarded pivot-equal elements is not the expected 388/row"
+    assert after[_SLOT_LARGE_FAULT] - before[_SLOT_LARGE_FAULT] == 0, (
+        "a large-path invariant fired; the output below is not meaningful"
+    )
+
+    ref_values = torch.topk(logits[0], LARGEDET_TOP_K).values.sort().values
+
+    for row in range(num_rows):
+        got = first[row].to(torch.int64)
+
+        # 2. Ascending in index. This is what makes the Python-side
+        #    MERLIN_QSA_SORT a no-op on these rows rather than a correction.
+        assert bool((got[1:] - got[:-1] > 0).all()), (
+            f"row {row}: large-path output is not ascending in index"
+        )
+
+        # 3. The set is the analytic one: everything above the pivot, plus the
+        #    312 HIGHEST-indexed of the 700 pivot-equal elements.
+        assert torch.equal(got.cpu(), expected), (
+            f"row {row}: selected set is not most-recent-wins at the cutoff"
+        )
+
+        # 4. The weaker check torch.topk can make: same value multiset.
+        got_values = logits[row][got].sort().values
+        assert torch.equal(got_values, ref_values), (
+            f"row {row}: selected values are not torch.topk's values"
+        )
+
+    # 5. Bit identity across two launches on identical input -- the property
+    #    that separates this path from the arrival-ordered one at 135K.
+    assert torch.equal(first, second), (
+        "two identical launches returned different index tensors"
+    )
+
