+# ---------------------------------------------------------------------------
+# Large-path (multi-CTA radix_topk) deterministic placement and ties
+#
+# Above RADIX_THRESHOLD = 32,768 compressed columns a row is split across a
+# group of CTAs.  In v2.0.1 the pivot is exact and order-independent, but
+# everything after it is a race: a CTA's base offset into the row is its
+# arrival order at `state->output_counter`, its slot inside that base is
+# arrival order at a shared counter, and which pivot-equal elements survive the
+# `pos < TopK` cut is decided by whoever gets there first.  The first two
+# permute the selected list — which sparse attention consumes as an ordered
+# gather, so they fork the hidden state — and the third changes the set.
+#
+# The row below is built so all three are visible at once:
+#   * 200 elements strictly above the pivot, scattered over the whole row,
+#   * 700 elements exactly AT the pivot, also scattered, so the tie group spans
+#     every CTA chunk and several index high-byte buckets,
+#   * top_k = 512, so exactly 312 of the 700 must survive and 388 must be cut.
+#
+# `torch.topk`'s own index choice inside a 700-way tie is arbitrary, so it
+# cannot supply the expectation.  The reference is computed from the shipped
+# rule instead — most-recent-wins, i.e. the 312 HIGHEST indices — and
+# torch.topk is used for the weaker check it can make, the value multiset.
+# ---------------------------------------------------------------------------
+
+LARGEDET_SEQ_LEN = 40960  # > RADIX_THRESHOLD (32768): the multi-CTA radix path
+LARGEDET_TOP_K = 512
+LARGEDET_ABOVE = 200  # elements strictly greater than the pivot
+LARGEDET_TIE = 700  # elements exactly equal to the pivot
+LARGEDET_KEPT = LARGEDET_TOP_K - LARGEDET_ABOVE  # 312 of the 700 survive
+LARGEDET_DROPPED = LARGEDET_TIE - LARGEDET_KEPT  # 388 are cut
+
+
+def _build_largedet_tie_row(num_rows: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Identical rows with a deliberate multi-CTA tie at the cutoff.
+
+    Returns (logits, expected_indices) where expected_indices is the ascending
+    int64 index list the deterministic kernel must return for every row.
+    """
+    gen = torch.Generator(device="cpu").manual_seed(19)
+    perm = torch.randperm(LARGEDET_SEQ_LEN, generator=gen, device="cpu")
+    above_idx = perm[:LARGEDET_ABOVE]
+    tie_idx = perm[LARGEDET_ABOVE : LARGEDET_ABOVE + LARGEDET_TIE]
+
+    # Filler stays in [0, 0.5) so nothing outside the two planted groups can
+    # reach the pivot; the planted values are exact binary fractions, so the
+    # 700 tie elements are bit-identical as float32 and really do tie.
+    row = torch.rand(
+        LARGEDET_SEQ_LEN, generator=gen, dtype=torch.float32, device="cpu"
+    ) * 0.5
+    row[tie_idx] = 2.0
+    row[above_idx] = 3.0
+
+    logits = row.to("cuda").unsqueeze(0).repeat(num_rows, 1).contiguous()
+
+    kept_tie = torch.sort(tie_idx).values[-LARGEDET_KEPT:]
+    expected = torch.sort(torch.cat([above_idx, kept_tie])).values.to(torch.int64)
+    assert expected.numel() == LARGEDET_TOP_K
+    return logits, expected
+
+
+def _run_largedet_row(logits: torch.Tensor) -> torch.Tensor:
+    num_rows, seq_len = logits.shape
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+    indices = torch.empty((num_rows, LARGEDET_TOP_K), dtype=torch.int32, device="cuda")
+    _run_topk_backend(
+        "persistent_topk", logits, lengths, indices, LARGEDET_TOP_K, seq_len
+    )
+    torch.accelerator.synchronize()
+    return indices
+
+
+def _largedet_counters_or_skip(require_on: bool) -> list[int]:
+    counters = _read_exact_counters()
+    if counters is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: this build has "
+            "no persistent_topk_exact_counters op, so the large path cannot be "
+            "shown to have run deterministically. A skip is not a pass."
+        )
+    if require_on and counters[_SLOT_DET_LARGE_ON] == 0:
+        pytest.skip(
+            "MERLIN_TOPK_DET_LARGE=0: control arm. Determinism is not claimed "
+            "here; a qualification run must also execute the arm with the "
+            "switch on."
+        )
+    if not require_on and counters[_SLOT_DET_LARGE_ON] != 0:
+        pytest.skip(
+            "MERLIN_TOPK_DET_LARGE=1: this is the control-arm test and must be "
+            "run a second time with the switch off. A qualification run needs "
+            "BOTH arms."
+        )
+    return counters
+
