+def _maybe_load_qsa_static_kv_scales(model: nn.Module) -> None:
+    """Apply a static QSA K/V scale sidecar when VLLM_QSA_KV_SCALES names one.
+
+    Placed where the loader's own docstring requires: after checkpoint weights
+    are loaded, before profiling, warmup or cudagraph capture. Unset env var ->
+    no-op (the attention layer logs the default 1.0 per layer so the
+    uncalibrated state stays visible). Set but unusable -> the exception
+    propagates: a calibration that was requested and silently not applied is
+    worse than one never requested.
+    """
+    path = os.environ.get(_QSA_KV_SCALES_ENV, "").strip()
+    if not path:
+        return
+    # The PLE offload worker builds the whole target on the meta device and loads
+    # only PLE weights through load_weights; a fill_ on its meta scale buffers
+    # would log success without calibrating any GPU worker.
+    local_qsa: list[Qwen4ExpQSAAttention] = []
+    inner: Qwen4ExpModel | None = None
+    for module in model.modules():
+        if isinstance(module, Qwen4ExpModel) and inner is None:
+            inner = module
+        if isinstance(module, Qwen4ExpQSAAttention):
+            local_qsa.append(module)
+    for layer in local_qsa:
+        k_scale = getattr(layer, "_k_scale", None)
+        if isinstance(k_scale, torch.Tensor) and k_scale.device.type == "meta":
+            logger.info(
+                "Qwen4Exp QSA: model is on meta (PLE offload worker); "
+                "static K/V scales are applied by the GPU workers only"
+            )
+            return
+    if inner is None:
+        raise ValueError("Qwen4Exp QSA: no Qwen4ExpModel found for the sidecar")
+    if not inner._qsa_layer_ids:
+        # A requested calibration for a model without QSA layers is a
+        # configuration error, never a silent no-op.
+        raise ValueError(
+            f"Qwen4Exp QSA: {_QSA_KV_SCALES_ENV} is set but the model has no "
+            "QSA (indexer) attention layers"
+        )
+    # Whole-model QSA layer set (all pipeline stages) = "<stack>.<idx>.self_attn.attn"
+    # for every configured QSA index. The stack prefix is read from a LOCAL QSA
+    # layer's registered layer_name whenever one exists: this hook also runs
+    # inside the nested Qwen4ExpForCausalLM.load_weights, where a module path
+    # relative to that submodule ("model.layers") would not match the names
+    # registered under the outer prefix ("language_model.model.layers") - the
+    # earlier boot failure. Only a stage with no QSA layer
+    # falls back to the module path (then no local name can disagree).
+    if local_qsa:
+        stack, sep, tail = local_qsa[0].layer_name.rpartition(".layers.")
+        if not sep or not tail.split(".")[0].isdigit():
+            raise ValueError(
+                f"Qwen4Exp QSA: unexpected layer name {local_qsa[0].layer_name!r}"
+            )
+        layers_path = f"{stack}.layers"
+    else:
+        layers_path = next(
+            (name for name, module in model.named_modules() if module is inner.layers),
+            None,
+        )
+        if layers_path is None:
+            raise ValueError("Qwen4Exp QSA: cannot locate the decoder layer stack")
+    expected = {
+        f"{layers_path}.{idx}.self_attn.attn" for idx in inner._qsa_layer_ids
+    }
+    if not local_qsa:
+        # A pipeline stage without a full-attention layer (only for a very
+        # uneven split): validate the complete sidecar here too, apply nothing.
+        logger.warning(
+            "Qwen4Exp QSA: this pipeline stage holds no QSA layer "
+            "(pipeline layers %d-%d); sidecar %s validated, nothing to apply",
+            inner.start_layer,
+            inner.end_layer,
+            path,
+        )
+    # strict: every QSA layer of the whole model must be in the sidecar. An empty
+    # or partial file silently leaving layers at scale 1.0 is exactly the failure
+    # this call site exists to prevent.
+    applied = load_qsa_static_kv_scales(
+        model, path, strict=True, expected_layer_names=expected
+    )
+    shown = ", ".join(sorted(applied)[:4])
+    logger.info(
+        "Qwen4Exp QSA: applied static K/V scales from %s to %d of %d layer(s) "
+        "(pipeline layers %d-%d): %s%s",
+        path,
+        len(applied),
+        len(expected),
+        inner.start_layer,
+        inner.end_layer,
+        shown,
+        " ..." if len(applied) > 4 else "",
+    )
+
