+// ---------------------------------------------------------------------------
+// MERLIN_TOPK_LARGE_FAULT_KIND.  TEST ONLY, companion to
+// the variable above; ignored unless MERLIN_TOPK_LARGE_FAULT_INJECT names a
+// CTA.
+//
+//   unset / "pre" (default)  force the PRE-EMISSION predicate, caught at X3.
+//   "emit"                   force the EMISSION-BOUND slot check, caught at X4.
+//
+// The two are mutually exclusive by construction: a pre-emission fault makes
+// `row_fault` nonzero, the emission block is skipped wholesale, and the X4
+// code -- including `suffix_sum[6]`, the word whose concurrent non-atomic
+// write this change is about -- is never reached.  The shipped injector could
+// therefore only ever exercise the arm that was already correct, which is why
+// the X4 arm had never been exercised.  Resolved once per process like
+// every other switch here, so it is a launch constant a cudagraph bakes in.
+// ---------------------------------------------------------------------------
+bool large_fault_inject_emit() {
+  static const bool emit = [] {
+    const char* raw = std::getenv("MERLIN_TOPK_LARGE_FAULT_KIND");
+    if (raw == nullptr || raw[0] == '\0') return false;
+    return std::strncmp(raw, "emit", 5) == 0;
+  }();
+  return emit;
+}
+
 // ---------------------------------------------------------------------------
 // Say the effective tie policy out loud, once.
 //
@@ -495,6 +521,7 @@ void launch_persistent_topk(const torch::stable::Tensor& logits,
         4u * ctas_per_group <= static_cast<uint32_t>(P::RADIX);
     params.det_large = det_large_enabled() && det_large_fits;
     params.fault_inject_cta = large_fault_inject_cta();
+    params.fault_inject_emit = large_fault_inject_emit();
     if (det_large_enabled() && !det_large_fits) {
       static std::atomic<bool> det_large_warned{false};
       if (!det_large_warned.exchange(true)) {
@@ -510,11 +537,15 @@ void launch_persistent_topk(const torch::stable::Tensor& logits,
       static std::atomic<bool> inject_warned{false};
       if (!inject_warned.exchange(true)) {
         std::fprintf(stderr,
-                     "[vllm] MERLIN_TOPK_LARGE_FAULT_INJECT=%d is set: the "
-                     "large path FORCES a fault in that CTA of every "
-                     "deterministic large row and returns an all -1 row. This "
-                     "is a test mode and must not be set in production.\n",
-                     params.fault_inject_cta);
+                     "[vllm] MERLIN_TOPK_LARGE_FAULT_INJECT=%d kind=%s is "
+                     "set: the large path FORCES a %s fault in that CTA of "
+                     "every deterministic large row and returns an all -1 row. "
+                     "This is a test mode and must not be set in "
+                     "production.\n",
+                     params.fault_inject_cta,
+                     params.fault_inject_emit ? "emit" : "pre",
+                     params.fault_inject_emit ? "emission-bound (X4)"
+                                              : "pre-emission (X3)");
       }
     }
     params.det_ties = det_ties_enabled();
