diff --git a/csrc/libtorch_stable/persistent_topk.cuh b/csrc/libtorch_stable/persistent_topk.cuh
index f8ce8597f5..85d217f9be 100644
--- a/csrc/libtorch_stable/persistent_topk.cuh
+++ b/csrc/libtorch_stable/persistent_topk.cuh
@@ -189,6 +189,87 @@ struct PersistentTopKParams {
   // constant like the two switches.  Setting it also suppresses __trap(), because
   // the point of injecting is to observe the trap-off row-failure policy.
   int fault_inject_cta;
+  // Which fault the injector forces in that CTA.
+  //   false (MERLIN_TOPK_LARGE_FAULT_KIND unset or `pre`): the PRE-EMISSION
+  //     predicate `my_keep > local_eq`, caught at X3.  Emission is skipped
+  //     entirely on that row, so this kind cannot reach the X4 code at all.
+  //   true (`emit`): the EMISSION-BOUND slot check inside the placement loop,
+  //     caught at X4.  This is the only way to exercise `suffix_sum[6]`, and
+  //     it exercises it the way the hardware would: every emitting thread of
+  //     the named CTA discovers an invalid slot at once, which is exactly the
+  //     concurrency the atomic exists for.
+  // Resolved once per process on the host, so it is a launch constant.
+  bool fault_inject_emit;
+};
+
+// ============================================================================
+// Device-global exact-path counters -- DECLARED HERE, ABOVE EVERY USER.
+//
+// This enum used to live beside the medium-path restart,
+// ~200 lines BELOW the decode template that increments
+// `kCtrDecodeOverflow`.  `counters` is a plain `unsigned long long*`
+// parameter, so that enumerator is a NON-DEPENDENT name: two-phase lookup
+// resolves it when the template is DEFINED, not when it is instantiated,
+// and the Linux build rejected the tree with
+//   persistent_topk.cuh(442): identifier "kCtrDecodeOverflow" is undefined.
+// An offline `nvcc -cubin` on a non-Linux host does NOT reproduce that on its own: nvcc
+// can drive cicc in Microsoft mode (`--ms_c++17 --microsoft_version=`), and that mode
+// defers non-dependent lookup to instantiation, where the enum is already
+// visible.  `-Xcudafe --dep_name` restores strict two-phase lookup and the
+// offline harness then reproduces the Linux diagnostic verbatim.
+//
+// The fix is the declaration ORDER, not a literal: every increment still
+// names its enumerator, so a slot renumbering stays a one-line edit here.
+// ============================================================================
+
+// Device-global counters.  Plain device atomics on a process-lifetime buffer:
+// no host sync and no host-visible allocation on the launch path, so this is
+// safe to record inside a cudagraph capture and on every replay.  Read from
+// Python with `torch.ops._C.persistent_topk_exact_counters`.
+//
+// The counters are `unsigned long long`, not `unsigned int`,
+// and the reader tensor is int64.  A u32 counter copied into a SIGNED int32
+// tensor goes negative, then wraps: at 65,536 columns with k=512 an all-equal
+// row drops 65,024 ties, so slot 6 crosses the signed boundary after 33,027
+// rows and wraps after 66,053, and a delta taken across that boundary is a
+// wrong number that looks like a measurement.  `atomicAdd(unsigned long long*)`
+// is native on sm_86, so the width costs nothing on the increment path.
+//
+// SLOT MAP (the tie-determinism + large-path integration, 11 slots).  The tie change numbered its decode
+// counter AROUND the large-path block rather than after the medium-path one, so the merged layout is
+// the union of the two branches with nothing renumbered and no external probe
+// silently re-reading a row count as a switch -- the failure a merged layout
+// must avoid.
+//
+//   [0] medium rows      [1] medium overflow   [2] medium exact fallback
+//   [3] medium exact fault
+//   [4]-[7]  large path (rows_large, ties_cut, ties_dropped, faults_large)
+//   [8] MERLIN_TOPK_EXACT_MEDIUM   [9] MERLIN_TOPK_DET_LARGE
+//   [10] decode overflow
+//
+// Slots 8-9 are written by the HOST after the device copy; the device never
+// touches them, and they are slots INSIDE the array, not two elements appended
+// after it.  A stale five- or ten-element reader buffer is rejected outright by
+// the length check in the reader op, which is the fail-loud direction.
+enum TopKExactCounter : int {
+  kCtrMediumRows = 0,           // denominator: medium-path rows entered
+  kCtrMediumOverflow = 1,       // rows where a 4,096-slot guard would drop
+  kCtrMediumExactFallback = 2,  // rows that took the exact restart
+  kCtrMediumExactFault = 3,     // exact restart could not complete
+  // Large path (multi-CTA radix_topk, seq_len > RADIX_THRESHOLD).
+  // Slots 4-7 are only ever touched by the deterministic emission, so they
+  // stay 0 in the MERLIN_TOPK_DET_LARGE=0 control arm: `[9] == 1 && [4] == 0`
+  // while large rows are known to have run means the host-side capacity gate
+  // (4 * ctas_per_group <= RADIX) turned the switch off for that launch.
+  kCtrLargeDetRows = 4,       // large rows emitted deterministically
+  kCtrLargeTiesCut = 5,       // rows where the pivot-equal group was cut
+  kCtrLargeTiesDropped = 6,   // pivot-equal elements discarded by those cuts
+  kCtrLargeFault = 7,         // large-path invariant violation
+  kSlotSwitchMedium = 8,        // host-written flag, NOT a device counter
+  kSlotSwitchLarge = 9,         // host-written flag, NOT a device counter
+  kCtrDecodeOverflow = 10,      // decode rows whose buffered-candidate count
+                                // exceeded DBUF before deterministic ranking
+  kNumTopKExactCounters = 11,   // total slots: device buffer AND reader output
 };
 
 // ============================================================================
