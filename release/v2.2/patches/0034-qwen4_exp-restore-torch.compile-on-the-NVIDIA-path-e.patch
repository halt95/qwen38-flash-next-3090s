+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Combined pull-transport + compile-profile tree: profile guard, exact pin, graph modes, plus the
+combined wiring (both guards on target and draft, pull dispatch).
+
+CPU-only. Configs are stand-ins except where the real ``CompilationConfig``
+resolver is the thing under test. Every refusal has a FAILING CONTROL: the
+same input with the one deciding factor flipped passes, or upstream's own
+reading is shown to accept what the fork's guard rejects.
+"""
+
+import ast
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+import vllm.envs as envs
+from vllm.config import CompilationConfig, CompilationMode, CUDAGraphMode
+from vllm.v1 import e2_guards
+from vllm.v1.e2_guards import (
+    ALLOW_BREAKABLE_ENV,
+    BREAKABLE_ENV,
+    EXPECTED_MODE_ENV,
+    PLE_MODE_PULL,
+    PULL_TRANSPORT_ENV,
+    REQUIRED_SPLITTING_OPS,
+    UPSTREAM_UVA_ENV,
+    assert_graph_profile_is_executable,
+    assert_ple_mode,
+    assert_resolved_cudagraph_modes,
+    breakable_resolved,
+)
+
+REPO = Path(__file__).resolve().parents[2]
+_NVIDIA = REPO / "vllm/models/qwen4_exp/nvidia"
+
+
+def _clear_envs_cache() -> None:
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for name in (
+        BREAKABLE_ENV,
+        ALLOW_BREAKABLE_ENV,
+        EXPECTED_MODE_ENV,
+        PULL_TRANSPORT_ENV,
+        UPSTREAM_UVA_ENV,
+    ):
+        monkeypatch.delenv(name, raising=False)
+    _clear_envs_cache()
+    yield
+    _clear_envs_cache()
+
+
+def _production_config(
+    architecture: str = "Qwen4ExpForCausalLM",
+    cudagraph_mode: CUDAGraphMode = CUDAGraphMode.FULL_AND_PIECEWISE,
+):
+    """The production request, resolved by the real CompilationConfig."""
+    cc = CompilationConfig(
+        mode=CompilationMode.VLLM_COMPILE, cudagraph_mode=cudagraph_mode
+    )
+    cc.set_splitting_ops_for_v1(all2all_backend="naive")
+    return SimpleNamespace(
+        model_config=SimpleNamespace(
+            architectures=[architecture],
+            hf_text_config=SimpleNamespace(ple_layer_ids=[2]),
+        ),
+        compilation_config=cc,
+        engram_config=SimpleNamespace(cpu_offload=False),
+    )
+
+
+def _production_env(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    monkeypatch.setenv(PULL_TRANSPORT_ENV, "1")
+    _clear_envs_cache()
+
+
+# --------------------------------------------------- the compile profile
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+def test_combined_guards_accept_the_production_profile(monkeypatch, role) -> None:
+    """compile + FULL_AND_PIECEWISE + breakable off + pull on: both guards pass.
+
+    The pull-transport port alone rejected this profile (its inherited guard); the combined tree
+    carries the compile-profile graph guard and the pull transport's PLE guard side by side.
+    """
+    _production_env(monkeypatch)
+    cfg = _production_config()
+    missing = [
+        op
+        for op in REQUIRED_SPLITTING_OPS
+        if op not in cfg.compilation_config.splitting_ops
+    ]
+    assert missing == []
+    assert_graph_profile_is_executable(cfg, role=role)
+    assert assert_ple_mode(cfg, role=role) == PLE_MODE_PULL
+
+
+def test_control_combined_profile_with_uva_requested_is_refused(monkeypatch) -> None:
+    """Same profile, cpu_offload=True resolved: the PLE guard refuses."""
+    _production_env(monkeypatch)
+    cfg = _production_config()
+    cfg.engram_config.cpu_offload = True
+    assert_graph_profile_is_executable(cfg)  # the graph half still passes
+    with pytest.raises(RuntimeError, match="both own the PLE table"):
+        assert_ple_mode(cfg, role="draft")
+
+
+def test_constructors_run_both_guards_then_the_compiled_submodule_check() -> None:
+    """Target and draft constructors: profile, PLE, then compiled submodule."""
+    for rel, cls_name, role in (
+        ("model.py", "Qwen4ExpForCausalLM", "target"),
+        ("mtp.py", "Qwen4ExpMTP", "draft"),
+    ):
+        tree = ast.parse((_NVIDIA / rel).read_text(encoding="utf-8"))
+        cls = next(
+            n
+            for n in ast.walk(tree)
+            if isinstance(n, ast.ClassDef) and n.name == cls_name
+        )
+        init = next(
+            n
+            for n in cls.body
+            if isinstance(n, ast.FunctionDef) and n.name == "__init__"
+        )
+        calls = []
+        for node in ast.walk(init):
+            if (
+                isinstance(node, ast.Call)
+                and isinstance(node.func, ast.Name)
+                and node.func.id.startswith("assert_")
+            ):
+                roles = [kw.value.value for kw in node.keywords if kw.arg == "role"]
+                calls.append((node.lineno, node.func.id, roles))
+        calls.sort()
+        assert [c[1] for c in calls] == [
+            "assert_graph_profile_is_executable",
+            "assert_ple_mode",
+            "assert_compiled_submodule",
+        ], (rel, calls)
+        assert all(c[2] == [role] for c in calls), (rel, calls)
+
+
+# ---------------------------------------------------- the exact "0" pin
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+def test_the_production_pin_zero_passes(monkeypatch, role) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    assert_graph_profile_is_executable(_production_config(), role=role)
+
+
+@pytest.mark.parametrize("raw", ["2", "true", "True", "false", "", "00", " 0", "no"])
+@pytest.mark.parametrize("role", ["target", "draft"])
+def test_a_pin_other_than_exactly_zero_is_refused(monkeypatch, raw, role) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, raw)
+    with pytest.raises(RuntimeError, match=rf"e2-guard\[{role}\].*exactly '0'"):
+        assert_graph_profile_is_executable(_production_config(), role=role)
+
+
+@pytest.mark.parametrize("raw", ["2", "true", "", "00"])
+def test_control_upstream_reads_those_values_as_off(monkeypatch, raw) -> None:
+    """FAILING CONTROL for the lax reading: upstream (and breakable_resolved)
+    calls each of these OFF, so a guard built on resolution alone would have
+    accepted them as a qualified pin -- the compile-profile guard's earlier behaviour."""
+    monkeypatch.setenv(BREAKABLE_ENV, raw)
+    monkeypatch.setattr(envs, "VLLM_USE_BREAKABLE_CUDAGRAPH", False, raising=False)
+    assert breakable_resolved() is False
+
+
+def test_one_is_still_reported_as_resolved_on(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    with pytest.raises(RuntimeError, match="resolved ON"):
+        assert_graph_profile_is_executable(_production_config())
+
+
+def test_the_debug_opt_out_is_separate_and_logged(monkeypatch) -> None:
+    """A non-"0" value under the logged opt-out boots (non-production)."""
+    messages: list[str] = []
+    monkeypatch.setattr(
+        e2_guards.logger, "warning", lambda msg, *args: messages.append(msg % args)
+    )
+    monkeypatch.setenv(BREAKABLE_ENV, "2")
+    monkeypatch.setenv(ALLOW_BREAKABLE_ENV, "1")
+    assert_graph_profile_is_executable(_production_config())
+    assert any(ALLOW_BREAKABLE_ENV in m and "promotion" in m.lower() for m in messages)
+
+
+# -------------------------------------- resolved modes before capture
+
+
+def _manager(mode):
+    return None if mode is None else SimpleNamespace(cudagraph_mode=mode)
+
+
+def _ar_speculator(prefill, decode):
+    """AutoRegressive / MTP speculator shape (prefill + decode managers)."""
+    return SimpleNamespace(
+        prefill_cudagraph_manager=_manager(prefill),
+        decode_cudagraph_manager=_manager(decode),
+    )
+
+
+F_AND_P = CUDAGraphMode.FULL_AND_PIECEWISE
+FDO = CUDAGraphMode.FULL_DECODE_ONLY
+
+
+def test_resolved_production_modes_pass() -> None:
+    cfg = _production_config()
+    assert_resolved_cudagraph_modes(
+        cfg, _manager(F_AND_P), _ar_speculator(F_AND_P, FDO)
+    )
+    assert_resolved_cudagraph_modes(cfg, _manager(F_AND_P), None)
+    # Multi-module MTP: one manager, FULL_DECODE_ONLY by design.
+    assert_resolved_cudagraph_modes(
+        cfg, _manager(F_AND_P), SimpleNamespace(cudagraph_manager=_manager(FDO))
+    )
+
+
+@pytest.mark.parametrize(
+    "target", [CUDAGraphMode.PIECEWISE, CUDAGraphMode.NONE, FDO, CUDAGraphMode.FULL]
+)
+def test_a_downgraded_target_mode_is_refused(target) -> None:
+    with pytest.raises(RuntimeError, match=r"e2-guard\[runtime\].*'target'"):
+        assert_resolved_cudagraph_modes(
+            _production_config(), _manager(target), _ar_speculator(F_AND_P, FDO)
+        )
+
+
+@pytest.mark.parametrize(
+    ("prefill", "decode"),
+    [
+        (CUDAGraphMode.PIECEWISE, FDO),
+        (FDO, FDO),
+        (F_AND_P, CUDAGraphMode.NONE),
+        (F_AND_P, F_AND_P),
+        (None, FDO),
+    ],
+)
+def test_a_downgraded_draft_mode_is_refused(prefill, decode) -> None:
+    with pytest.raises(RuntimeError, match=r"e2-guard\[runtime\].*draft\."):
+        assert_resolved_cudagraph_modes(
+            _production_config(), _manager(F_AND_P), _ar_speculator(prefill, decode)
+        )
+
+
+def test_a_missing_target_manager_or_unknown_speculator_is_refused() -> None:
+    with pytest.raises(RuntimeError, match="no manager"):
+        assert_resolved_cudagraph_modes(_production_config(), None, None)
+    with pytest.raises(RuntimeError, match="unrecognised speculator"):
+        assert_resolved_cudagraph_modes(
+            _production_config(), _manager(F_AND_P), SimpleNamespace()
+        )
+
+
+def test_other_architectures_are_untouched() -> None:
+    cfg = _production_config(architecture="Qwen3NextForCausalLM")
+    assert_resolved_cudagraph_modes(cfg, _manager(CUDAGraphMode.NONE), None)
+
+
+def test_the_runtime_opt_out_is_logged(monkeypatch) -> None:
+    messages: list[str] = []
+    monkeypatch.setattr(
+        e2_guards.logger, "warning", lambda msg, *args: messages.append(msg % args)
+    )
+    monkeypatch.setenv(ALLOW_BREAKABLE_ENV, "1")
+    assert_resolved_cudagraph_modes(
+        _production_config(), _manager(CUDAGraphMode.PIECEWISE), None
+    )
+    assert any("e2-guard[runtime]" in m for m in messages)
+
+
+def _resolve_with(cfg, **kwargs):
+    from vllm.v1.attention.backend import AttentionCGSupport
+
+    args = dict(
+        min_cg_support=AttentionCGSupport.ALWAYS,
+        min_cg_attn_backend="stand-in",
+        uniform_decode_query_len=4,  # MTP K=3
+        use_v2_model_runner=True,
+        piecewise_capture_available=True,
+    )
+    args.update(kwargs)
+    if isinstance(args["min_cg_support"], str):
+        args["min_cg_support"] = getattr(AttentionCGSupport, args["min_cg_support"])
+    return cfg.compilation_config.resolve_cudagraph_mode_and_sizes(**args)
+
+
+def test_real_resolver_keeps_the_production_mode_and_the_guard_passes() -> None:
+    cfg = _production_config()
+    resolved = _resolve_with(cfg)
+    assert resolved == F_AND_P
+    assert_resolved_cudagraph_modes(
+        cfg, _manager(resolved), _ar_speculator(resolved, FDO)
+    )
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "downgraded"),
+    [
+        # spec-decode FULL decode with a backend below UNIFORM_BATCH
+        ({"min_cg_support": "UNIFORM_SINGLE_TOKEN_DECODE"}, CUDAGraphMode.PIECEWISE),
+        # no compiled submodule and no breakable graphs: piecewise half dropped
+        ({"piecewise_capture_available": False}, CUDAGraphMode.FULL_DECODE_ONLY),
+    ],
+)
+def test_control_real_resolver_downgrade_is_caught(kwargs, downgraded) -> None:
+    """FAILING CONTROL driven by the real resolver: the construction guard
+    passed on the configured mode, the resolver downgraded it, and only the
+    runtime assertion sees that."""
+    cfg = _production_config()
+    os.environ[BREAKABLE_ENV] = "0"
+    try:
+        assert_graph_profile_is_executable(cfg)  # configured mode: accepted
+    finally:
+        os.environ.pop(BREAKABLE_ENV, None)
+    resolved = _resolve_with(cfg, **kwargs)
+    assert resolved == downgraded
+    with pytest.raises(RuntimeError, match=r"e2-guard\[runtime\]"):
+        assert_resolved_cudagraph_modes(cfg, _manager(resolved), None)
+
+
+def _capture_model_calls(source: str) -> list[tuple[int, str]]:
+    tree = ast.parse(source)
+    fn = next(
+        n
+        for n in ast.walk(tree)
+        if isinstance(n, ast.FunctionDef) and n.name == "capture_model"
+    )
+    events = []
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Return):
+            events.append((node.lineno, "return"))
+        elif isinstance(node, ast.Call):
+            f = node.func
+            name = f.id if isinstance(f, ast.Name) else getattr(f, "attr", "")
+            if name in ("assert_resolved_cudagraph_modes", "capture"):
+                events.append((node.lineno, name))
+    return sorted(events)
+
+
+def _guard_precedes_everything(events: list[tuple[int, str]]) -> bool:
+    return bool(events) and events[0][1] == "assert_resolved_cudagraph_modes"
+
+
+def test_v2_runner_asserts_before_any_capture_or_early_return() -> None:
+    source = (REPO / "vllm/v1/worker/gpu/model_runner.py").read_text(encoding="utf-8")
+    assert _guard_precedes_everything(_capture_model_calls(source))
+
+
+def test_control_runner_check_discriminates() -> None:
+    source = (REPO / "vllm/v1/worker/gpu/model_runner.py").read_text(encoding="utf-8")
+    stripped = source.replace("assert_resolved_cudagraph_modes(\n", "_removed_guard(\n")
+    assert stripped != source
+    assert not _guard_precedes_everything(_capture_model_calls(stripped))
+
+
+# ------------------------------------ pull dispatch
+
+
+def _class(path: Path, name: str) -> ast.ClassDef:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    return next(
+        n for n in ast.walk(tree) if isinstance(n, ast.ClassDef) and n.name == name
+    )
+
+
+def test_pull_module_dispatches_through_ple_offload_layer_forward() -> None:
+    """PleOffloadLayer is first in the MRO and the pull class defines no
+    forward, so the GPU placeholder runs PleOffloadLayer.forward (the
+    ple_offload_wait_copy op) -- never upstream's device/UVA forward."""
+    cls = _class(_NVIDIA / "ple_pull.py", "Qwen4ExpNGramEmbeddingPull")
+    assert [b.id for b in cls.bases] == ["PleOffloadLayer", "Qwen4ExpNGramEmbedding"]
+    methods = {n.name for n in cls.body if isinstance(n, ast.FunctionDef)}
+    assert "forward" not in methods
+    assert {"start_prefetch", "forward_impl", "dequantize_pulled"} <= methods
+
+
+def test_pull_module_is_built_without_layer_name() -> None:
+    """Only the upstream branch in ple_layer.py gets the compile-profile layer_name."""
+    tree = ast.parse((_NVIDIA / "ple_layer.py").read_text(encoding="utf-8"))
+    seen = {}
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call):
+            continue
+        f = node.func
+        name = (
+            f"{f.value.id}.{f.attr}"
+            if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name)
+            else getattr(f, "id", "")
+        )
+        if name in ("Qwen4ExpNGramEmbeddingPull.build", "Qwen4ExpNGramEmbedding"):
+            seen[name] = {kw.arg for kw in node.keywords}
+    assert "layer_name" not in seen["Qwen4ExpNGramEmbeddingPull.build"]
+    assert "layer_name" in seen["Qwen4ExpNGramEmbedding"]
+
+
+def test_device_ops_refuse_a_pull_module() -> None:
+    """The compile-profile op resolver refuses anything carrying the pull marker."""
+    tree = ast.parse((_NVIDIA / "ngram_embedding.py").read_text(encoding="utf-8"))
+    fn = next(
+        n
+        for n in ast.walk(tree)
+        if isinstance(n, ast.FunctionDef) and n.name == "_ple_embedding_of"
+    )
+    assert "dequantize_pulled" in ast.unparse(fn)
+
+
+def test_wait_copy_op_keeps_its_fake_impl() -> None:
+    tree = ast.parse(
+        (REPO / "vllm/model_executor/layers/ple_offload_layer.py").read_text(
+            encoding="utf-8"
+        )
+    )
+    regs = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and getattr(node.func, "id", "") == (
+            "direct_register_custom_op"
+        ):
+            kws = {kw.arg: kw.value for kw in node.keywords}
+            regs[kws["op_name"].value] = kws
+    wait_copy = regs["ple_offload_wait_copy"]
+    assert (
+        getattr(wait_copy.get("fake_impl"), "id", None) == "_ple_offload_wait_copy_fake"
+    )
+
+
+def test_wait_copy_is_not_a_splitting_op() -> None:
+    """Add it to splitting_ops only if a reference-host experiment shows
+    piecewise capture of the pull wait/copy is unsafe. Pinned so a change is
+    deliberate."""
+    assert "vllm::ple_offload_wait_copy" not in CompilationConfig._attention_ops
