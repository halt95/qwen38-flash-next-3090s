+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Compile-profile guard: the resolved graph profile for Qwen4Exp is VLLM_COMPILE +
+FULL_AND_PIECEWISE with the Qwen4Exp splitting ops present -- and it is NOT
+with upstream v0.30.0's breakable default (the failing control).
+
+CPU-only. The arch-dependent steps of ``VllmConfig.__post_init__`` run as the
+real unbound methods on a stand-in config (the pattern upstream's own
+``tests/test_config.py::test_breakable_cudagraph_platform_default`` uses),
+because a real ``VllmConfig`` for this architecture needs a checkpoint. The
+splitting ops come from the real ``CompilationConfig.set_splitting_ops_for_v1``.
+"""
+
+import ast
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+import vllm.config.vllm as vllm_config_module
+from vllm.config import CompilationConfig, CompilationMode, CUDAGraphMode, VllmConfig
+from vllm.config.vllm import default_breakable_cudagraph_architectures
+from vllm.v1 import e2_guards
+from vllm.v1.e2_guards import (
+    ALLOW_BREAKABLE_ENV,
+    BREAKABLE_ENV,
+    EXPECTED_MODE_ENV,
+    REQUIRED_SPLITTING_OPS,
+    assert_graph_profile_is_executable,
+)
+
+QWEN4EXP_ARCHITECTURES = (
+    "Qwen4ExpForCausalLM",
+    "Qwen4ExpForConditionalGeneration",
+    "Qwen4ExpMTP",
+)
+#: What upstream v0.30.0 ships (#55272 added the three Qwen4Exp names).
+UPSTREAM_V0300_DEFAULT = frozenset(
+    vllm_config_module.DEFAULT_BREAKABLE_CUDAGRAPH_ARCHITECTURES
+) | frozenset(QWEN4EXP_ARCHITECTURES)
+
+_NVIDIA = Path(vllm_config_module.__file__).resolve().parents[1] / (
+    "models/qwen4_exp/nvidia"
+)
+
+
+@pytest.fixture(autouse=True)
+def _cuda_like_platform(monkeypatch):
+    from vllm.platforms import current_platform
+
+    for name in (BREAKABLE_ENV, ALLOW_BREAKABLE_ENV, EXPECTED_MODE_ENV):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setattr(current_platform, "is_rocm", lambda: False)
+    # The auto-enable writes os.environ and then asks
+    # is_breakable_cudagraph_enabled(); read os.environ live with envs.py's
+    # exact semantics so a cached envs attribute cannot mask that write.
+    monkeypatch.setattr(
+        "vllm.compilation.breakable_cudagraph.is_breakable_cudagraph_enabled",
+        lambda: os.environ.get(BREAKABLE_ENV, "0") == "1",
+    )
+    monkeypatch.setattr(
+        e2_guards, "breakable_resolved", lambda: os.environ.get(BREAKABLE_ENV) == "1"
+    )
+    default_breakable_cudagraph_architectures.cache_clear()
+    yield
+    # _maybe_enable_breakable_cudagraph writes os.environ directly.
+    os.environ.pop(BREAKABLE_ENV, None)
+    default_breakable_cudagraph_architectures.cache_clear()
+
+
+def _resolve(architecture: str) -> SimpleNamespace:
+    """The arch-dependent part of VllmConfig.__post_init__, in its order.
+
+    Starts from the production request (-O2 default mode VLLM_COMPILE,
+    FULL_AND_PIECEWISE) and applies: breakable auto-enable (config/vllm.py
+    _maybe_enable_breakable_cudagraph), piecewise normalisation
+    (_normalize_piecewise_cudagraph_mode), splitting-op resolution
+    (CompilationConfig.set_splitting_ops_for_v1).
+    """
+    cfg = SimpleNamespace(
+        model_config=SimpleNamespace(architectures=[architecture]),
+        compilation_config=CompilationConfig(
+            mode=CompilationMode.VLLM_COMPILE,
+            cudagraph_mode=CUDAGraphMode.FULL_AND_PIECEWISE,
+        ),
+    )
+    cfg._uses_breakable_cudagraph_by_default = lambda: (
+        VllmConfig._uses_breakable_cudagraph_by_default(cfg)
+    )
+    enabled = VllmConfig._maybe_enable_breakable_cudagraph(cfg)
+    VllmConfig._normalize_piecewise_cudagraph_mode(
+        cfg, breakable_cudagraph_enabled=enabled
+    )
+    cfg.compilation_config.set_splitting_ops_for_v1(all2all_backend="naive")
+    cfg.breakable = enabled
+    return cfg
+
+
+# ---------------------------------------------------------------- this tree
+
+
+@pytest.mark.parametrize("architecture", QWEN4EXP_ARCHITECTURES)
+def test_resolved_profile_is_compile_full_and_piecewise(architecture) -> None:
+    cfg = _resolve(architecture)
+    cc = cfg.compilation_config
+    assert cfg.breakable is False
+    assert os.environ.get(BREAKABLE_ENV) is None  # not auto-set
+    assert cc.mode == CompilationMode.VLLM_COMPILE
+    assert cc.cudagraph_mode == CUDAGraphMode.FULL_AND_PIECEWISE
+    missing = [op for op in REQUIRED_SPLITTING_OPS if op not in cc.splitting_ops]
+    assert missing == []
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+@pytest.mark.parametrize("architecture", QWEN4EXP_ARCHITECTURES)
+def test_guard_accepts_the_resolved_profile(monkeypatch, architecture, role) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    assert_graph_profile_is_executable(_resolve(architecture), role=role)
+
+
+def test_qwen4exp_is_not_in_the_breakable_default_set() -> None:
+    assert not (
+        set(QWEN4EXP_ARCHITECTURES) & set(default_breakable_cudagraph_architectures())
+    )
+
+
+# ------------------------------------------------ failing control (upstream)
+
+
+@pytest.mark.parametrize("architecture", QWEN4EXP_ARCHITECTURES)
+def test_control_upstream_default_resolves_to_breakable_none(
+    monkeypatch, architecture
+) -> None:
+    """FAILING CONTROL: with v0.30.0's default set the same request resolves
+    to breakable-on + CompilationMode.NONE, i.e. not the qualified profile."""
+    monkeypatch.setattr(
+        vllm_config_module,
+        "DEFAULT_BREAKABLE_CUDAGRAPH_ARCHITECTURES",
+        UPSTREAM_V0300_DEFAULT,
+    )
+    default_breakable_cudagraph_architectures.cache_clear()
+    cfg = _resolve(architecture)
+    assert cfg.breakable is True
+    assert os.environ.get(BREAKABLE_ENV) == "1"
+    assert cfg.compilation_config.mode == CompilationMode.NONE
+    assert cfg.compilation_config.mode != CompilationMode.VLLM_COMPILE
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+def test_control_guard_rejects_upstream_default(monkeypatch, role) -> None:
+    monkeypatch.setattr(
+        vllm_config_module,
+        "DEFAULT_BREAKABLE_CUDAGRAPH_ARCHITECTURES",
+        UPSTREAM_V0300_DEFAULT,
+    )
+    default_breakable_cudagraph_architectures.cache_clear()
+    cfg = _resolve("Qwen4ExpForCausalLM")
+    with pytest.raises(RuntimeError, match=rf"e2-guard\[{role}\].*resolved ON"):
+        assert_graph_profile_is_executable(cfg, role=role)
+
+
+def test_control_compilation_none_is_rejected(
+    monkeypatch,
+) -> None:
+    """-O0 / CompilationMode.NONE (the eager-graph alternative) normalises
+    FULL_AND_PIECEWISE to FULL_DECODE_ONLY; the guard must reject it."""
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = _resolve("Qwen4ExpForCausalLM")
+    cfg.compilation_config.mode = CompilationMode.NONE
+    VllmConfig._normalize_piecewise_cudagraph_mode(
+        cfg, breakable_cudagraph_enabled=False
+    )
+    assert cfg.compilation_config.cudagraph_mode == CUDAGraphMode.FULL_DECODE_ONLY
+    with pytest.raises(RuntimeError, match="qualified profile"):
+        assert_graph_profile_is_executable(cfg)
+
+
+def test_control_missing_splitting_op_is_rejected(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = _resolve("Qwen4ExpForCausalLM")
+    cfg.compilation_config.splitting_ops.remove("vllm::qwen4_exp_compute_ple_ngram_ids")
+    with pytest.raises(RuntimeError, match="qwen4_exp_compute_ple_ngram_ids"):
+        assert_graph_profile_is_executable(cfg)
+
+
+# --------------------------------------------- source structure (no import)
+
+
+def _decorated_classes(source: str) -> set[str]:
+    out = set()
+    for node in ast.walk(ast.parse(source)):
+        if isinstance(node, ast.ClassDef):
+            for deco in node.decorator_list:
+                target = deco.func if isinstance(deco, ast.Call) else deco
+                if getattr(target, "id", None) == "support_torch_compile":
+                    out.add(node.name)
+    return out
+
+
+def _registered_ops(source: str) -> set[str]:
+    ops = set()
+    for node in ast.walk(ast.parse(source)):
+        if (
+            isinstance(node, ast.Call)
+            and getattr(node.func, "id", None) == "direct_register_custom_op"
+        ):
+            for kw in node.keywords:
+                if kw.arg == "op_name" and isinstance(kw.value, ast.Constant):
+                    ops.add(f"vllm::{kw.value.value}")
+    return ops
+
+
+def test_compile_wrappers_are_present_on_model_and_drafter() -> None:
+    model = (_NVIDIA / "model.py").read_text(encoding="utf-8")
+    mtp = (_NVIDIA / "mtp.py").read_text(encoding="utf-8")
+    assert "Qwen4ExpModel" in _decorated_classes(model)
+    assert {"Qwen4ExpMultiTokenPredictor", "Qwen4ExpMTP"} <= _decorated_classes(mtp)
+
+
+def test_control_wrapper_check_discriminates() -> None:
+    """The structural check fails on the #55272 shape (decorator removed)."""
+    model = (_NVIDIA / "model.py").read_text(encoding="utf-8")
+    stripped = model.replace("@support_torch_compile(", "@_removed_by_55272(")
+    assert "Qwen4ExpModel" not in _decorated_classes(stripped)
+
+
+def test_every_required_qwen4exp_split_is_registered_by_the_nvidia_model() -> None:
+    registered = set()
+    for name in ("qsa.py", "ple_layer.py", "ngram_embedding.py"):
+        registered |= _registered_ops((_NVIDIA / name).read_text(encoding="utf-8"))
+    ours = {op for op in REQUIRED_SPLITTING_OPS if "qwen4_exp" in op}
+    assert ours <= registered, ours - registered
+    # And each is a split in the default list, not only in the guard.
+    assert ours <= set(CompilationConfig._attention_ops)
+
+
+def test_guard_module_reads_the_same_list(monkeypatch) -> None:
+    """The guard's list and the config's list must not drift apart."""
+    assert set(REQUIRED_SPLITTING_OPS) <= set(CompilationConfig._attention_ops)
+    assert e2_guards.REQUIRED_CUDAGRAPH_MODE_NAME == "FULL_AND_PIECEWISE"
