From 230b29368e663d063982a30a64c9d7379b7474c6 Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Wed, 23 Sep 2026 08:18:03 -0400
Subject: [PATCH 39/58] ple: the pull op resolves live pointers by layer name

The wait/copy op took host pointers as Python-int arguments, which were baked
into the AOT compile cache as the tracing process's addresses; the first
forward after a cache-load boot then failed. The op now carries only
process-stable values and resolves pointers from a per-process registry.
---
 .../ple_offload/test_transport_bounded_io.py  |  2 +-
 tests/v1/test_ple_pull_compile_profile.py     | 68 +++++++++++++++++++
 .../layers/ple_offload_layer.py               | 45 ++++++++++--
 3 files changed, 107 insertions(+), 8 deletions(-)

diff --git a/tests/v1/ple_offload/test_transport_bounded_io.py b/tests/v1/ple_offload/test_transport_bounded_io.py
index 748fd46744..5a2aa199e9 100644
--- a/tests/v1/ple_offload/test_transport_bounded_io.py
+++ b/tests/v1/ple_offload/test_transport_bounded_io.py
@@ -275,7 +275,7 @@ def test_real_wait_copy_geometry_rejected_before_graph_publication(
 
     def capture_then_publish() -> None:
         with manager.capture_ple_copy_geometry(desc):
-            ple_layer_module._ple_offload_wait_copy_impl(
+            ple_layer_module._ple_offload_wait_copy_raw(
                 gpu_output_buffer,
                 hidden_states,
                 1,
diff --git a/tests/v1/test_ple_pull_compile_profile.py b/tests/v1/test_ple_pull_compile_profile.py
index d5bf87e307..d5c47a99e2 100644
--- a/tests/v1/test_ple_pull_compile_profile.py
+++ b/tests/v1/test_ple_pull_compile_profile.py
@@ -466,3 +466,71 @@ def test_draft_guard_reports_the_draft_architecture() -> None:
     assert e2_guards._profile(cfg, "draft")[0] == ["Qwen4ExpMTP"]
     no_spec = SimpleNamespace(**{**vars(cfg), "speculative_config": None})
     assert e2_guards._profile(no_spec, "draft")[0] == ["Qwen4ExpForConditionalGeneration"]
+
