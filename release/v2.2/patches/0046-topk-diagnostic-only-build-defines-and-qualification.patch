 tests/kernels/moe/test_merlin_full_k.py  | 188 +++++++
 tests/kernels/test_merlin_qsa_sort.py    | 161 ++++++
 tests/kernels/test_top_k_per_row.py      | 689 +++++++++++++++++++++++
 6 files changed, 1276 insertions(+)
