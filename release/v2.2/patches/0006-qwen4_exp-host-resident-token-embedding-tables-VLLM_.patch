+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA UVA")
+def test_u4_outer_post_load_preserves_pinned_uva_storage(monkeypatch):
+    vocab = 4096
+    hidden = 256
+    _set_tp(monkeypatch, 1, 2)
+    _require_cuda_pinned_memory()
+
+    # Account for construction, loading, and the outer post-load call.
+    torch.cuda.synchronize()
+    baseline = torch.cuda.memory_allocated()
+    torch.cuda.reset_peak_memory_stats()
+
+    layer = PinnedHostVocabParallelEmbedding(
+        vocab,
+        hidden,
+        params_dtype=torch.bfloat16,
+    )
+    view = layer.accelerator_weight_view
+    assert view is not None
+    weight_ptr = layer.weight.data_ptr()
+    weight_storage_ptr = layer.weight.untyped_storage().data_ptr()
+    view_ptr = view.data_ptr()
+    view_storage_ptr = view.untyped_storage().data_ptr()
+
+    loaded_weight = _weight(vocab, hidden)
+    local_table_bytes = layer.weight.numel() * layer.weight.element_size()
+
+    assert (
+        layer.weight_loader.__func__
+        is VocabParallelEmbedding.weight_loader
+    )
+    layer.weight_loader(layer.weight, loaded_weight)
+
+    model = nn.Module()
+    model.add_module("embed_tokens", layer)
+    monkeypatch.setattr(
+        loader_utils,
+        "maybe_retie_word_embeddings",
+        lambda *args, **kwargs: None,
+    )
+    loader_utils.process_weights_after_loading(
+        model,
+        SimpleNamespace(quantization=None),
+        torch.device("cuda"),
+    )
+
+    torch.cuda.synchronize()
+    peak_growth = torch.cuda.max_memory_allocated() - baseline
+
+    assert layer.weight.device.type == "cpu"
+    assert layer.weight.is_pinned()
+    assert layer.weight.data_ptr() == weight_ptr
+    assert layer.weight.untyped_storage().data_ptr() == weight_storage_ptr
+    assert view.device.type == "cuda"
+    assert view.shape == layer.weight.shape
+    assert view.dtype == layer.weight.dtype
+    assert view.data_ptr() == view_ptr
+    assert view.untyped_storage().data_ptr() == view_storage_ptr
+    assert set(dict(layer.named_parameters())) == {"weight"}
+    assert peak_growth < local_table_bytes
+
+    expected = loaded_weight.narrow(0, vocab // 2, vocab // 2)
+    _assert_same_bytes(layer.weight, expected)
+
+    # Pointer stability alone is insufficient: mutate the retained CPU
+    # parameter and prove that the CUDA view reads that same storage.
+    local_row = 7
+    global_id = vocab // 2 + local_row
+    sentinel = torch.arange(hidden, dtype=torch.float32).to(torch.bfloat16)
+    layer.weight[local_row].copy_(sentinel)
+    actual = layer(torch.tensor([global_id], device="cuda"))
+    torch.cuda.synchronize()
+    _assert_same_bytes(actual[0].cpu(), sentinel)
+
+
+@pytest.mark.skipif(
+    os.environ.get("VLLM_RUN_HOST_EMBED_BUDGET") != "1",
+    reason="set VLLM_RUN_HOST_EMBED_BUDGET=1 for the 606 MiB allocation report",
+)
+def test_u5_report_production_shard_host_allocation(monkeypatch):
+    _require_cuda_pinned_memory()
+    if not hasattr(torch.cuda, "host_memory_stats"):
+        pytest.skip("torch.cuda.host_memory_stats is unavailable")
+
+    _set_tp(monkeypatch, 0, 2)
+    before = torch.cuda.host_memory_stats()
+    allocated_key = "allocated_bytes.all.current"
+    reserved_key = "reserved_bytes.all.current"
+    if allocated_key not in before or reserved_key not in before:
+        pytest.skip("host allocator byte statistics are unavailable")
+
+    try:
+        layer = PinnedHostVocabParallelEmbedding(
+            248_320,
+            2_560,
+            params_dtype=torch.bfloat16,
+        )
+    except RuntimeError as exc:
+        pytest.skip(f"production-sized pinned allocation is unavailable: {exc}")
+
+    after = torch.cuda.host_memory_stats()
+    payload_bytes = layer.weight.numel() * layer.weight.element_size()
+    allocated_delta = after[allocated_key] - before[allocated_key]
+    reserved_delta = after[reserved_key] - before[reserved_key]
+    print(
+        "HOST_EMBED_PINNED_BUDGET "
+        f"payload_bytes={payload_bytes} "
+        f"allocated_bytes={allocated_delta} "
+        f"reserved_bytes={reserved_delta}"
+    )
+    assert payload_bytes == 635_699_200
+    assert layer.weight.is_pinned()
