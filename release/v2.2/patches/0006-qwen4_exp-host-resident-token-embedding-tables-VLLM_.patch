+def test_u2_ple_meta_construction_materializes_neither_table(monkeypatch):
+    monkeypatch.setenv(HOST_EMBED_TABLE_ENV, "1")
+    _patch_tiny_model_construction(monkeypatch)
+    config = _tiny_config()
+
+    with torch.device("meta"):
+        target = model_mod.Qwen4ExpModel(vllm_config=config)
+        predictor = mtp_mod.Qwen4ExpMultiTokenPredictor(vllm_config=config)
+
+    assert isinstance(target.embed_tokens, VocabParallelEmbedding)
+    assert not isinstance(
+        target.embed_tokens,
+        PinnedHostVocabParallelEmbedding,
+    )
+    assert target.embed_tokens.weight.device.type == "meta"
+
+    assert isinstance(predictor.embed_tokens, VocabParallelEmbedding)
+    assert not isinstance(
+        predictor.embed_tokens,
+        PinnedHostVocabParallelEmbedding,
+    )
+    assert predictor.embed_tokens.weight.device.type == "meta"
+
+
+def test_tied_embeddings_are_rejected_for_both_owners(monkeypatch):
+    monkeypatch.setenv(HOST_EMBED_TABLE_ENV, "1")
+    _patch_tiny_model_construction(monkeypatch)
+    config = _tiny_config(tie_word_embeddings=True)
+
+    with pytest.raises(ValueError, match="tie_word_embeddings=True"):
+        model_mod.Qwen4ExpModel(vllm_config=config)
+    with pytest.raises(ValueError, match="tie_word_embeddings=True"):
+        mtp_mod.Qwen4ExpMultiTokenPredictor(vllm_config=config)
