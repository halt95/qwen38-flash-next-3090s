+def test_u1_real_multimodal_text_mask_and_merge(monkeypatch):
+    _set_tp(monkeypatch, 0, 1)
+    weight = _weight()
+    with torch.device("cpu"):
+        embedding = PinnedHostVocabParallelEmbedding(
+            VOCAB,
+            HIDDEN,
+            params_dtype=torch.bfloat16,
+            create_accelerator_view=False,
+        )
+    embedding.weight_loader(embedding.weight, weight)
+
+    model = model_mod.Qwen4ExpForConditionalGeneration.__new__(
+        model_mod.Qwen4ExpForConditionalGeneration
+    )
+    nn.Module.__init__(model)
+    model.language_model = _LanguageModel(embedding)
+    model.language_model_only = False
+    model.use_deepstack = False
+    model._has_oov_mm_tokens = True
+
+    ids = torch.tensor([1, VOCAB + 5, 2, 64], dtype=torch.int64)
+    is_multimodal = torch.tensor([False, True, False, False])
+    image_row = torch.full((1, HIDDEN), 123, dtype=torch.bfloat16)
+
+    actual = model.embed_input_ids(
+        ids,
+        multimodal_embeddings=[image_row],
+        is_multimodal=is_multimodal,
+    )
+
+    expected = torch.zeros(4, HIDDEN, dtype=torch.bfloat16)
+    expected[0].copy_(weight[1])
+    expected[1].copy_(image_row[0])
+    expected[2].copy_(weight[2])
+    expected[3].copy_(weight[64])
+    _assert_same_bytes(actual, expected)
+
+
+class _PPGroup:
+    is_first_rank = True
+    is_last_rank = False
+
+
+class _StubModule(nn.Module):
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__()
+
+
+def _tiny_config(*, tie_word_embeddings: bool = False):
+    text_config = SimpleNamespace(
+        vocab_size=VOCAB,
+        hidden_size=HIDDEN,
+        hc_count=1,
+        layer_types=[],
+        num_hidden_layers=0,
+        mtp_num_hidden_layers=0,
+        rms_norm_eps=1e-6,
+        hc_lowrank=1,
+        tie_word_embeddings=tie_word_embeddings,
+    )
+    model_config = SimpleNamespace(
+        hf_text_config=text_config,
+        dtype=torch.bfloat16,
+    )
+    parallel_config = SimpleNamespace(
+        eplb_config=SimpleNamespace(num_redundant_experts=0),
+        use_sequence_parallel_moe=False,
+    )
+    scheduler_config = SimpleNamespace(max_num_batched_tokens=8)
+    # The @support_torch_compile wrapper reads vllm_config.compilation_config after
+    # __init__; mode NONE makes it return without compiling.
+    from vllm.config import CompilationMode
+
+    compilation_config = SimpleNamespace(mode=CompilationMode.NONE)
+    return SimpleNamespace(
+        model_config=model_config,
+        parallel_config=parallel_config,
+        scheduler_config=scheduler_config,
+        compilation_config=compilation_config,
+        speculative_config=None,
+        quant_config=None,
+    )
+
+
+def _patch_tiny_model_construction(monkeypatch) -> None:
+    _set_tp(monkeypatch, 0, 1)
+    monkeypatch.setattr(model_mod, "get_pp_group", lambda: _PPGroup())
+    monkeypatch.setattr(
+        model_mod,
+        "make_layers",
+        lambda *args, **kwargs: (0, 0, nn.ModuleList()),
+    )
+    monkeypatch.setattr(
+        model_mod,
+        "is_model_fused_shared_expert_compatible",
+        lambda *args, **kwargs: False,
+    )
+    monkeypatch.setattr(
+        model_mod,
+        "make_empty_intermediate_tensors_factory",
+        lambda *args, **kwargs: lambda *a, **k: None,
+    )
+
+    monkeypatch.setattr(
+        mtp_mod,
+        "_make_draft_vllm_config",
+        lambda *args, **kwargs: SimpleNamespace(quant_config=None),
+    )
+    monkeypatch.setattr(
+        mtp_mod,
+        "set_current_vllm_config",
+        lambda *args, **kwargs: nullcontext(),
+    )
+    monkeypatch.setattr(mtp_mod, "ColumnParallelLinear", _StubModule)
+    monkeypatch.setattr(mtp_mod, "GemmaRMSNorm", _StubModule)
+    monkeypatch.setattr(mtp_mod, "GatedResidual", _StubModule)
+    monkeypatch.setattr(
+        mtp_mod,
+        "is_model_fused_shared_expert_compatible",
+        lambda *args, **kwargs: False,
+    )
+    monkeypatch.setattr(
+        mtp_mod,
+        "make_empty_intermediate_tensors_factory",
+        lambda *args, **kwargs: lambda *a, **k: None,
+    )
+
