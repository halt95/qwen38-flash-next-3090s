+def _cuda_host_layer(monkeypatch, vocab=VOCAB, hidden=HIDDEN, world_size=1):
+    _require_cuda_pinned_memory()
+    _set_tp(monkeypatch, 0, world_size)
+    layer = PinnedHostVocabParallelEmbedding(
+        vocab,
+        hidden,
+        params_dtype=torch.bfloat16,
+    )
+    weight = _weight(vocab, hidden)
+    layer.weight_loader(layer.weight, weight)
+    return layer, weight
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA UVA")
+def test_u3_uva_lookup_is_graph_capturable_and_replayable(monkeypatch):
+    layer, weight = _cuda_host_layer(monkeypatch)
+    assert layer.weight.device.type == "cpu"
+    assert layer.weight.is_pinned()
+    assert layer.accelerator_weight_view is not None
+    assert layer.accelerator_weight_view.device.type == "cuda"
+
+    ids = torch.tensor([0, 1, 64, 66], device="cuda")
+    layer(ids)
+    torch.cuda.synchronize()
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        captured_output = layer(ids)
+
+    for replay_ids in (
+        torch.tensor([2, 3, 4, 5]),
+        torch.tensor([64, 65, 66, 0]),
+    ):
+        ids.copy_(replay_ids.to(device="cuda"))
+        graph.replay()
+        torch.cuda.synchronize()
+        _assert_same_bytes(
+            captured_output.cpu(),
+            weight[replay_ids],
+        )
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA UVA")
+def test_u3_three_lookup_steps_inside_one_graph(monkeypatch):
+    layer, weight = _cuda_host_layer(monkeypatch)
+    loop_ids = torch.tensor([1, 8, 32, 60], device="cuda")
+
+    for _ in range(3):
+        layer(loop_ids)
+    torch.cuda.synchronize()
+
+    graph = torch.cuda.CUDAGraph()
+    captured_steps = []
+    with torch.cuda.graph(graph):
+        for _ in range(3):
+            captured_steps.append(layer(loop_ids))
+            loop_ids.add_(1)
+
+    for seed in (
+        torch.tensor([1, 8, 32, 60]),
+        torch.tensor([4, 12, 40, 63]),
+    ):
+        loop_ids.copy_(seed.to(device="cuda"))
+        graph.replay()
+        torch.cuda.synchronize()
+        for step, output in enumerate(captured_steps):
+            _assert_same_bytes(output.cpu(), weight[seed + step])
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA UVA")
+def test_u3_parent_device_move_preserves_storage_and_dtype_move_fails(monkeypatch):
+    layer, _ = _cuda_host_layer(monkeypatch)
+    view = layer.accelerator_weight_view
+    assert view is not None
+    weight_ptr = layer.weight.data_ptr()
+    weight_storage_ptr = layer.weight.untyped_storage().data_ptr()
+    view_ptr = view.data_ptr()
+    view_storage_ptr = view.untyped_storage().data_ptr()
+
+    parent = nn.Module()
+    parent.add_module("embed_tokens", layer)
+    parent.add_module(
+        "projection",
+        nn.Linear(HIDDEN, HIDDEN, dtype=torch.bfloat16),
+    )
+
+    parent.to("cuda")
+    assert parent.projection.weight.device.type == "cuda"
+    assert layer.weight.device.type == "cpu"
+    assert layer.weight.is_pinned()
+    assert layer.weight.data_ptr() == weight_ptr
+    assert layer.weight.untyped_storage().data_ptr() == weight_storage_ptr
+    assert view.data_ptr() == view_ptr
+    assert view.untyped_storage().data_ptr() == view_storage_ptr
+
+    with pytest.raises(RuntimeError, match="fixed dtype"):
+        parent.to(torch.float32)
+    with pytest.raises(RuntimeError, match="fixed dtype"):
+        parent.half()
+
