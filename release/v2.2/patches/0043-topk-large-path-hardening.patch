+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_large_slot_residue_reuse() -> None:
+    """Every group must process >= 3 large rows, covering all 3 histogram slots.
+
+    `RadixRowState::histogram` is triple-buffered over four radix rounds, so
+    row iteration `r` reuses `histogram[r % 3]` for its final round AND for the
+    per-CTA count publication. The X1 barrier is what stops a fast CTA
+    overwriting that slot while a slow CTA still reads it, and the reuse is
+    only exercised when a group handles SEVERAL large rows in a row -- three,
+    to cover residues 0, 1 and 2. The original eight-row test gave one row per
+    group and never reached it.
+
+    The geometry is chosen, not hoped for. topk.cu sets
+    `num_groups = min(max_resident_ctas / ctas_per_group, num_rows)`, so with
+    32 rows of 262,144 columns: at `num_rows > 8` the chunk budget gives
+    ~24,824 elements, hence `ctas_per_group = ceil(262144/24824) = 11`; on a
+    3090 (82 SMs, occupancy 1 for a 1,024-thread CTA at this smem)
+    `max_resident_ctas = 81`, so `num_groups = 7` and the round-robin gives
+    every group 4 or 5 large rows. If a device produces a wider grid the
+    coverage claim weakens but nothing here becomes wrong: the assertions are
+    on the property (exact set, exact order, bit identity), not on the geometry.
+    """
+    torch.set_default_device("cuda:0")
+    num_rows = 32
+    seq_len = 262144
+    top_k = 512
+
+    before = _largedet_counters_or_skip(require_on=True)
+
+    cpu_row = _largedet_distribution("cross_cta_ties", seq_len, top_k, seed=1903)
+    expected = _largedet_reference(cpu_row, top_k)
+    logits = cpu_row.to("cuda").unsqueeze(0).repeat(num_rows, 1).contiguous()
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+
+    first = _largedet_launch(logits, lengths, top_k).clone()
+    mid = _read_exact_counters()
+    second = _largedet_launch(logits, lengths, top_k)
+
+    assert mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS] == num_rows
+    assert mid[_SLOT_LARGE_FAULT] - before[_SLOT_LARGE_FAULT] == 0, (
+        "a large-path invariant fired during slot reuse"
+    )
+    for row in range(num_rows):
+        got = first[row].to(torch.int64)
+        assert bool((got[1:] - got[:-1] > 0).all()), f"row {row}: not ascending"
+        assert torch.equal(got.cpu(), expected), (
+            f"row {row}: slot reuse changed the selected set"
+        )
+    assert torch.equal(first, second), (
+        "two identical launches over reused histogram slots differed"
+    )
