+        40960,  # large
+        2048,  # decode/short
+        49152,  # large
+        12288,  # medium
+        40960,  # large
+        LARGEDET_RADIX_THRESHOLD,  # exactly at the threshold: NOT large
+        57344,  # large
+    ]
+    num_rows = len(lengths_list)
+    seq_len = max(lengths_list)
+    num_large = sum(1 for n in lengths_list if n > LARGEDET_RADIX_THRESHOLD)
+
+    before = _largedet_counters_or_skip(require_on=True)
+
+    cpu_row = _largedet_distribution("cross_cta_ties", seq_len, top_k, seed=1901)
+    logits = cpu_row.to("cuda").unsqueeze(0).repeat(num_rows, 1).contiguous()
+    lengths = torch.tensor(lengths_list, dtype=torch.int32, device="cuda")
+
+    first = _largedet_launch(logits, lengths, top_k).clone()
+    mid = _read_exact_counters()
+    second = _largedet_launch(logits, lengths, top_k)
