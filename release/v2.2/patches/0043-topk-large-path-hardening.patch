+        # the global cut lands mid-chunk.
+        above = top_k // 3
+        tie = top_k  # > k - above, so the cut is strictly inside the tie group
+        perm = torch.randperm(seq_len, generator=gen)
+        row[perm[:above]] = 3.0
+        row[perm[above : above + tie]] = 2.0
+        return row
+
+    if kind == "cutoff_in_tile":
+        # The whole tie group is one contiguous 1,024-element window, i.e. one
+        # tile of one CTA, so the cut falls inside a single ballot/scan tile.
+        above = top_k - 512
+        tie = 1024
+        start = (seq_len // 2) & ~1023
+        perm = torch.randperm(seq_len, generator=gen)
+        picked = perm[perm >= start + tie][:above]
+        if int(picked.numel()) < above:  # pathological seed: use the head
+            picked = torch.arange(above)
+        row[picked] = 3.0
+        row[start : start + tie] = 2.0
+        return row
+
+    raise ValueError(f"unknown large-path distribution: {kind}")
+
+
+def _largedet_launch(logits: torch.Tensor, lengths: torch.Tensor, top_k: int):
+    indices = torch.empty((logits.shape[0], top_k), dtype=torch.int32, device="cuda")
+    _run_topk_backend(
+        "persistent_topk", logits, lengths, indices, top_k, int(lengths.max())
+    )
+    torch.accelerator.synchronize()
+    return indices
+
+
