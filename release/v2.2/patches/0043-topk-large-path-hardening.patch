+def test_persistent_topk_large_ragged_mixed_paths(top_k: int) -> None:
+    """Trivial, decode, medium and large rows in ONE launch.
+
+    A group that handles a short row between two large ones must not advance
+    `radix_iter` -- that is what makes the histogram-slot reuse argument hold
+    across interleaved traffic. Large rows get the exact set assertion; short
+    rows only get the value-multiset check, because their tie policy belongs to
+    the decode/medium paths, not to this branch.
+    """
