+        "the large path ran on the wrong number of rows: "
+        f"{mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS]} of {num_large}"
+        " -- check the RADIX_THRESHOLD boundary row"
+    )
+    assert mid[_SLOT_LARGE_FAULT] - before[_SLOT_LARGE_FAULT] == 0
+
+    for row, length in enumerate(lengths_list):
+        got = first[row].to(torch.int64)
+        prefix = cpu_row[:length]
