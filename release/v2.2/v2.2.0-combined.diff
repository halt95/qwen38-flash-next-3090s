+
+    # effective_tie_recent(det_ties, tie_recent) in persistent_topk.cuh, in
+    # Python. Keep the two in step: this is the reported policy, and the
+    # kernel's launcher prints the same resolution to stderr at first use.
+    det_ties = bool(int(os.environ.get("MERLIN_TIE_DET", "0") or "0"))
+    tie_recent = bool(int(os.environ.get("MERLIN_TIE_RECENT", "0") or "0"))
+    effective_recent = tie_recent if det_ties else True
+    if effective_recent != want_recent:
+        pytest.skip(
+            f"this worker resolves the tie direction to "
+            f"{'most-recent' if effective_recent else 'oldest'}-wins "
+            f"(MERLIN_TIE_DET={int(det_ties)} "
+            f"MERLIN_TIE_RECENT={int(tie_recent)}); run the "
+            f"{'most-recent' if want_recent else 'oldest'}-wins arm in a fresh "
+            f"process with "
+            + ("MERLIN_TIE_DET=0 (or =1 with MERLIN_TIE_RECENT=1)"
+               if want_recent else "MERLIN_TIE_DET=1 MERLIN_TIE_RECENT=0")
+        )
+
+    before = _read_exact_counters()
+    if before is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: no "
+            "persistent_topk_exact_counters op. A skip is not a pass."
+        )
+    if before[_SLOT_EXACT_MEDIUM_ON] == 0:
+        pytest.skip(
+            "MERLIN_TOPK_EXACT_MEDIUM=0: control arm, the tie rule is not "
+            "claimed here."
