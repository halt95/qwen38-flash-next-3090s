+
+    logits = torch.full((num_rows, width), 1.5, dtype=torch.float32, device="cuda")
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+    indices = torch.empty((num_rows, top_k), dtype=torch.int32, device="cuda")
+    _run_topk_backend("persistent_topk", logits, lengths, indices, top_k, seq_len)
+    torch.accelerator.synchronize()
+
+    after = _read_exact_counters()
+    assert after[1] - before[1] == num_rows, "the row did not overflow as designed"
+    assert after[2] - before[2] == num_rows, "the exact restart did not run"
+    assert after[3] == before[3], "the exact fallback reported a fault"
+
+    # The cut must genuinely exercise both index-radix rounds, or the test is
+    # weaker than it looks. Each direction has its own cut index and its own
+    # strength, stated separately rather than asserted as if they were one.
+    if want_recent:
+        # Highest top_k indices: cut at seq_len - top_k, several high-byte
+        # buckets away from the top and landing mid-bucket.
+        lo, hi = seq_len - top_k, seq_len
+        cut = lo
+        assert (cut >> 8) != ((seq_len - 1) >> 8), "tie cut spans only one bucket"
+        assert cut % 256 != 0, "tie cut sits on a bucket boundary"
+    else:
+        # Lowest top_k indices: cut at top_k - 1. top_k is a whole number of
+        # 256-index buckets, so this one necessarily lands on the LAST slot of
+        # its bucket -- which makes round B walk all 256 low bins before it
+        # crosses, the opposite corner from the arm above.
+        lo, hi = 0, top_k
+        cut = hi - 1
+        assert (cut >> 8) != 0, "tie cut spans only one bucket"
+        assert cut % 256 == 255, "the oldest-wins cut should end its bucket"
+    expected = torch.arange(lo, hi, dtype=torch.int32, device="cuda")
+    rule = "most-recent-wins" if want_recent else "oldest-wins"
+    for row in range(num_rows):
+        assert torch.equal(indices[row], expected), (
+            f"row {row}: {rule} should select indices "
+            f"[{lo}, {hi}) in ascending order; got "
+            f"{indices[row][:4].tolist()}..{indices[row][-4:].tolist()}"
+        )
+
+
+# ---------------------------------------------------------------------------
+# DECODE candidate truncation, the adversarial class.
+#
+# The decode path buffers the coarse threshold bin's candidates into a
+# 3,708-slot shared buffer (`DBUF`) and refines only what it retained.
+# MERLIN_TIE_DET ranks the survivors deterministically; it cannot recall a
+# winner that was never buffered. The historical zero-overflow measurements
+# establish workload coverage, not a capacity proof.
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_decode_overflow_is_detected() -> None:
+    """The failing control for the decode-overflow counter.
+
+    The adversarial row: 8,192 elements that all land in ONE coarse
+    half-precision bin, so the coarse pass separates nothing and every element
+    becomes a buffered candidate -- 8,192 of them into 3,708 slots. Within
+    that bin three FP32 levels, all rounding to the same half:
+
+      * indices [0, 511)      the highest value      -> the 511 true leaders,
+      * index   seq_len - 1   the middle value       -> the 512th true winner,
+      * everything else       the lowest value.
+
+    Element order does the rest: the 512th winner sits at the END of the row,
+    so it is appended after capacity is gone and is dropped before any ranking
+    runs. The returned set then holds the 511 leaders plus an arbitrary
+    element of the bulk.
+
+    This test asserts the COUNTER, not the repair: it is the control that
+    fails on a build without the detection (there is no slot 10 to read, and
+    the op rejects the 11-element buffer), and it is what makes the decode
+    path's determinism claim conditional on a measured number rather than on
+    an unmeasured assumption. Exactness is asserted only when the repair is
+    actually enabled, since MERLIN_TOPK_EXACT_DECODE is a launch constant this
+    process cannot change.
+    """
+    torch.set_default_device("cuda:0")
+    num_rows, seq_len, top_k = 4, 8192, 512
+    leaders = top_k - 1  # 511; the 512th winner is the tail element
+
+    before = _read_exact_counters()
+    if before is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: no "
+            "persistent_topk_exact_counters op. A skip is not a pass."
+        )
+
+    # Three FP32 levels a few ULPs apart. Half-precision spacing near 1.5 is
+    # 2**-10, about 8,000x these gaps, so all three round to the same half and
+    # therefore to the same coarse bin -- asserted below rather than assumed.
+    base = np.float32(1.5)
+    mid = np.nextafter(np.nextafter(base, np.float32(np.inf)), np.float32(np.inf))
+    high = np.nextafter(np.nextafter(mid, np.float32(np.inf)), np.float32(np.inf))
+    assert base < mid < high
+    assert np.float16(base) == np.float16(mid) == np.float16(high), (
+        "the three levels must share one half-precision bin or the row is not "
+        "adversarial"
+    )
+
+    logits = torch.full((num_rows, seq_len), float(base), dtype=torch.float32)
+    logits[:, :leaders] = float(high)
+    logits[:, seq_len - 1] = float(mid)
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32)
+    indices = torch.empty((num_rows, top_k), dtype=torch.int32)
+    _run_topk_backend("persistent_topk", logits, lengths, indices, top_k, seq_len)
+    torch.accelerator.synchronize()
+
+    after = _read_exact_counters()
+    fired = after[_SLOT_DECODE_OVERFLOW] - before[_SLOT_DECODE_OVERFLOW]
+    assert fired == num_rows, (
+        f"the decode candidate buffer overflowed on {num_rows} rows by "
+        f"construction (8,192 candidates into 3,708 slots) but the counter "
+        f"moved by {fired}; the truncation is happening unseen"
+    )
+
+    # Whatever the arm, the row must still be a well-formed selection.
+    for row in range(num_rows):
+        got = indices[row].tolist()
+        assert len(set(got)) == top_k, f"row {row}: duplicate indices"
+        assert all(0 <= i < seq_len for i in got), f"row {row}: index out of range"
+
+    if not bool(int(os.environ.get("MERLIN_TOPK_EXACT_DECODE", "0") or "0")):
+        pytest.skip(
+            "MERLIN_TOPK_EXACT_DECODE=0 (the default): detection asserted "
+            "above, the repair is not enabled in this process, so exactness "
+            "is NOT claimed for this row. Run this test again in a fresh "
+            "process with MERLIN_TOPK_EXACT_DECODE=1 for the repaired arm -- "
+            "a green detect-only run is half the gate."
+        )
+
+    # Repaired arm: the exact answer is forced and contains the tail winner.
+    expected = torch.tensor(
+        list(range(leaders)) + [seq_len - 1], dtype=torch.int32, device="cuda"
+    )
+    for row in range(num_rows):
+        assert torch.equal(indices[row], expected), (
+            f"row {row}: the exact decode restart should select "
+            f"[0, {leaders}) plus {seq_len - 1}; got "
+            f"{indices[row][:4].tolist()}..{indices[row][-4:].tolist()}"
+        )
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_exact_counters_rejects_unsafe_output() -> None:
+    """The counter op writes ten raw int64s; it must refuse unusable layouts.
+
+    A CUDA scalar expanded to ten elements satisfies a numel check while
+    owning one element of storage, and a strided view would receive the values
+    in the wrong slots. Both must be rejected before the raw pointer is taken.
+    `reset` without `sync` must also be rejected: zeroing while kernels are in
+    flight drops their atomics silently.
+
+    The dtype case is a large-path protocol break: the device
+    counters are 64-bit, so an int32 buffer would be filled from half of each
+    counter. It must be REJECTED, not quietly accepted -- that rejection is
+    how a stale caller finds out, and asserting it here is what makes the
+    break a contract rather than a comment.
+    """
+    torch.set_default_device("cuda:0")
+    op = getattr(torch.ops._C, "persistent_topk_exact_counters", None)
+    if op is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: no "
+            "persistent_topk_exact_counters op. A skip is not a pass."
+        )
+
+    ok = torch.zeros(_EXACT_COUNTER_SLOTS, dtype=torch.int64, device="cuda")
+    op(ok, 0, 1)  # the control: this layout must be accepted
+
+    slots_op = getattr(torch.ops._C, "persistent_topk_exact_counters_slots", None)
+    assert slots_op is not None, (
+        "the build must describe its own counter layout; a guessed length is "
+        "how a stale probe reads the wrong slots"
+    )
+    assert int(slots_op()) == _EXACT_COUNTER_SLOTS, (
+        f"build reports {int(slots_op())} slots, test expects "
+        f"{_EXACT_COUNTER_SLOTS}"
+    )
+
+    wrong_dtype = torch.zeros(_EXACT_COUNTER_SLOTS, dtype=torch.int32, device="cuda")
+    with pytest.raises(Exception):
+        op(wrong_dtype, 0, 1)
+
+    expanded = torch.zeros(1, dtype=torch.int64, device="cuda").expand(
+        _EXACT_COUNTER_SLOTS
+    )
+    with pytest.raises(Exception):
+        op(expanded, 0, 1)
+
+    strided = torch.zeros(2 * _EXACT_COUNTER_SLOTS, dtype=torch.int64, device="cuda")[
+        ::2
+    ]
+    with pytest.raises(Exception):
+        op(strided, 0, 1)
+
+    too_small = torch.zeros(_EXACT_COUNTER_SLOTS - 1, dtype=torch.int64, device="cuda")
+    with pytest.raises(Exception):
+        op(too_small, 0, 1)
+
+    # Too LARGE is rejected too. The check used to be `>=`, so a buffer sized
+    # for one layout was accepted by a build with another and the surplus
+    # slots read 0 -- a plausible answer from the wrong protocol.
+    too_large = torch.zeros(_EXACT_COUNTER_SLOTS + 1, dtype=torch.int64, device="cuda")
+    with pytest.raises(Exception):
+        op(too_large, 0, 1)
+
+    # This case matters: a stale medium-path five-element probe must
+    # be REJECTED, not filled with the wrong meanings.  It is the same length
+    # check as above, asserted at the length a real stale caller would use.
+    medium_sized = torch.zeros(5, dtype=torch.int64, device="cuda")
+    with pytest.raises(Exception):
+        op(medium_sized, 0, 1)
+
+    with pytest.raises(Exception):
+        op(ok, 1, 0)  # reset without sync is not a complete handoff
+
+
