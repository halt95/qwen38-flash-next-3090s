+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_large_fault_in_nonzero_cta_fails_closed() -> None:
+    """A fault raised OUTSIDE CTA 0 must still fail the whole row closed.
+
+    `my_keep > local_eq` is a CTA-LOCAL predicate -- it
+    compares a value that came back through global memory against this CTA's
