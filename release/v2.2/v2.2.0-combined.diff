+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_large_emission_fault_fails_closed() -> None:
+    """The EMISSION-BOUND (X4) fault arm, from CTA 0 and from a nonzero CTA.
+
+    `suffix_sum[6]` -- the per-CTA emission-violation flag --
+    was written with a plain `suffix_sum[6] = 1u`. Every thread whose computed
+    slot is out of range reaches that line, and an invariant failure is exactly
+    the situation in which many of them do at once, so the mechanism that
+    exists to DETECT the failure contained a concurrent non-atomic write of its
+    own. It is now `atomicOr(&suffix_sum[6], 1u)`.
+
+    The shipped injector could not reach this code at all. It forces the
+    PRE-EMISSION predicate, which makes `row_fault` nonzero; the whole emission
+    block is then skipped and `suffix_sum[6]` is never touched. So the X4 arm
+    had never been exercised, and the existing all -1 result proved only the
+    X3 arm. `MERLIN_TOPK_LARGE_FAULT_KIND=emit` selects the emission-bound
+    predicate instead, and forces it for every emitting thread of the named
+    CTA -- a single-writer injection would pass against the broken code and so
+    would measure nothing.
+
+    Both values of the CTA index are in scope here, unlike the X3 cell: CTA 0
+    is the CTA that performs the -1 fill, so "the fill happens even when the
+    discovering CTA is the filling CTA" and "…even when it is not" are two
+    different claims. Run this in its own process, once per CTA index -- the
+    injector is a function-local static baked in at the first launch:
+
+        MERLIN_TOPK_DET_LARGE=1 MERLIN_TOPK_LARGE_FAULT_INJECT=0 \
+            MERLIN_TOPK_LARGE_FAULT_KIND=emit pytest -k large_emission_fault
+        MERLIN_TOPK_DET_LARGE=1 MERLIN_TOPK_LARGE_FAULT_INJECT=1 \
+            MERLIN_TOPK_LARGE_FAULT_KIND=emit pytest -k large_emission_fault
+
+    Injection suppresses __trap(), so this is the trap-off arm of the policy.
+    The trap-on arm kills the CUDA context by construction and stays in a disposable
+    process (test_isolated_diag_trap_on_kills_only_the_child), not here.
+    """
+    torch.set_default_device("cuda:0")
+    num_rows = 8
+
+    inject = os.getenv("MERLIN_TOPK_LARGE_FAULT_INJECT")
+    kind = (os.getenv("MERLIN_TOPK_LARGE_FAULT_KIND") or "").strip()
+    if inject is None or inject.strip() in ("", "-1") or kind != "emit":
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build with the fault "
+            "cells unrun: the emission-bound arm needs "
+            "MERLIN_TOPK_LARGE_FAULT_INJECT=<cta> AND "
+            "MERLIN_TOPK_LARGE_FAULT_KIND=emit. Without the kind the injector "
+            "forces the PRE-emission fault, which skips the emission block "
+            "entirely and cannot exercise suffix_sum[6]. A skip is not a pass."
+        )
+    assert int(inject) >= 0
+
+    before = _largedet_counters_or_skip(require_on=True)
+
+    logits, _ = _build_largedet_tie_row(num_rows)
+    out = _run_largedet_row(logits)
+    after = _read_exact_counters()
+
+    # 1. The whole row is -1. The X4 arm's specific hazard is a PARTIAL row:
+    #    the CTAs that did not fault have already stored real indices by the
+    #    time the violation is discovered, so "contains -1" would pass on the
+    #    defect. The fill must overwrite every slot.
+    assert int(out.min()) == -1 and int(out.max()) == -1, (
+        "an emission-bound fault did not fill the row with -1: "
+        f"min={int(out.min())} max={int(out.max())}; "
+        f"{int((out != -1).sum())} of {out.numel()} slots survived"
+    )
+
+    # 2. EXACTLY one fault per row. Not one per CTA and -- the reason the
+    #    injector fires in every emitting thread -- not one per out-of-range
+    #    element.
+    delta = after[_SLOT_LARGE_FAULT] - before[_SLOT_LARGE_FAULT]
+    assert delta == num_rows, (
+        "the large-path fault counter did not increment exactly once per "
+        f"failed row: {delta} of {num_rows}"
+    )
+
+    # 3. The rows were still entered, and no tie measurement was recorded off
+    #    a faulted row.
+    assert after[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS] == num_rows, (
+        "faulted rows must still be counted as large-path rows"
+    )
+    assert after[_SLOT_LARGE_TIES_CUT] - before[_SLOT_LARGE_TIES_CUT] == 0, (
+        "a faulted row recorded a tie-cut measurement"
+    )
+    assert after[_SLOT_LARGE_TIES_DROPPED] - before[_SLOT_LARGE_TIES_DROPPED] == 0, (
+        "a faulted row recorded dropped-tie counts"
+    )
