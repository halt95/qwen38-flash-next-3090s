+# SPDX-License-Identifier: Apache-2.0
+
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+
+def _run_bounded_child(
+    source: str,
+    tmp_path: Path,
+    *arguments: str,
+    expected_exitcode: int = 0,
+) -> None:
+    marker = tmp_path / f"started-{time.monotonic_ns()}"
+    process = subprocess.Popen(
+        [sys.executable, "-c", source, str(marker), *arguments],
+        stderr=subprocess.DEVNULL,
+        start_new_session=os.name == "posix",
+    )
+    stayed_alive = False
+    try:
+        deadline = time.monotonic() + 120
+        while not marker.exists() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert marker.exists(), "child did not finish cold startup within 120 seconds"
+        process.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        stayed_alive = True
+    finally:
+        if process.poll() is None:
+            if os.name == "posix":
+                os.killpg(process.pid, signal.SIGKILL)
+            else:
+                process.terminate()
+            process.wait(timeout=120)
+
+    assert not stayed_alive, "child stayed alive after the bounded operation"
+    assert process.returncode == expected_exitcode
+
+
+_FATAL_SOURCE = r"""
+import os
+import sys
+import threading
+from pathlib import Path
+
+from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+scenario = sys.argv[2]
+
+if scenario == "blocking-name-property":
+    class Meta(type):
+        @property
+        def __name__(cls):
+            threading.Event().wait()
+
+    class Error(Exception, metaclass=Meta):
+        pass
+
+    error = Error()
+elif scenario == "blocking-str-descriptor":
+    class Descriptor:
+        def __get__(self, instance, owner):
+            threading.Event().wait()
+
+    class Error(Exception):
+        __str__ = Descriptor()
+
+    error = Error()
+elif scenario == "blocking-name-format":
+    class BlockingName(str):
+        def __format__(self, format_spec):
+            threading.Event().wait()
+
+    class Meta(type):
+        @property
+        def __name__(cls):
+            return BlockingName("Error")
+
+    class Error(Exception, metaclass=Meta):
+        pass
+
+    error = Error()
+elif scenario == "blocking-str-method":
+    class Error(Exception):
+        def __str__(self):
+            threading.Event().wait()
+
+    error = Error()
+elif scenario == "overridden-getattribute":
+    class Error(Exception):
+        def __getattribute__(self, name):
+            threading.Event().wait()
+
+    error = Error("detail")
+elif scenario == "str-subclass-argument":
+    class BlockingString(str):
+        def __format__(self, format_spec):
+            threading.Event().wait()
+
+        def __str__(self):
+            threading.Event().wait()
+
+    error = RuntimeError(BlockingString("detail"))
+elif scenario == "blocking-str-cause":
+    class Cause(Exception):
+        def __str__(self):
+            threading.Event().wait()
+
+    try:
+        try:
+            raise Cause()
+        except Cause as cause:
+            raise RuntimeError("outer") from cause
+    except RuntimeError as outer:
+        error = outer
+elif scenario == "huge-string":
+    error = RuntimeError("x" * (32 << 20))
+else:
+    raise AssertionError(scenario)
+
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+ple_fail_closed(
+    where="transport-fatal",
+    rank=1,
+    layer="ple",
+    sequence=3,
+    error=error,
+)
+"""
+
+
+@pytest.mark.parametrize(
+    "scenario",
+    [
+        "blocking-name-property",
+        "blocking-str-descriptor",
+        "blocking-name-format",
+    ],
+)
+def test_fatal_helper_avoids_exception_controlled_descriptors(
+    tmp_path: Path,
+    scenario: str,
+) -> None:
+    _run_bounded_child(
+        _FATAL_SOURCE,
+        tmp_path,
+        scenario,
+        expected_exitcode=1,
+    )
+
+
+@pytest.mark.parametrize(
+    "scenario",
+    [
+        "blocking-str-method",
+        "overridden-getattribute",
+        "str-subclass-argument",
+        "blocking-str-cause",
+        "huge-string",
+    ],
+)
+def test_fatal_helper_hard_exit_controls(
+    tmp_path: Path,
+    scenario: str,
+) -> None:
+    _run_bounded_child(
+        _FATAL_SOURCE,
+        tmp_path,
+        scenario,
+        expected_exitcode=1,
+    )
+
+
+_FATAL_TRACEBACK_SOURCE = r"""
+from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+
+class AcceleratorLikeError(RuntimeError):
+    pass
+
+
+def launch_kernel():
+    raise ValueError("root cause detail")
+
+
+def step():
+    try:
+        launch_kernel()
+    except ValueError as cause:
+        raise AcceleratorLikeError("CUDA error: an illegal memory access") from cause
+
+
+try:
+    step()
+except BaseException as error:
+    ple_fail_closed(
+        where="transport-traceback",
+        rank=0,
+        layer="ple",
+        sequence=7,
+        error=error,
+    )
+"""
+
+
+def test_fatal_helper_traceback_names_subclass_frames_and_cause() -> None:
+    """The dying-path traceback still carries what the early boot lacked: the
+    real (subclass) type, its message, the raising frames and the chain."""
+    completed = subprocess.run(
+        [sys.executable, "-c", _FATAL_TRACEBACK_SOURCE],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.PIPE,
+        timeout=120,
+    )
+    stderr = completed.stderr.decode("utf-8", "replace")
+    assert completed.returncode == 1, stderr
+    assert "PLE fatal: where=transport-traceback" in stderr
+    assert "PLE fatal traceback follows:" in stderr
+    assert "AcceleratorLikeError: CUDA error: an illegal memory access" in stderr
+    assert "ValueError: root cause detail" in stderr
+    assert "direct cause of the following exception" in stderr
+    assert "in launch_kernel" in stderr
+    assert "in step" in stderr
+    # Interpreter order: the cause's block precedes the outer exception's.
+    assert stderr.index("ValueError: root cause detail") < stderr.index(
+        "AcceleratorLikeError: CUDA error"
+    )
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="process groups are POSIX-only")
+def test_wait_for_ready_rejects_non_string_status_without_comparison(
+    tmp_path: Path,
+) -> None:
+    source = r"""
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+import vllm.v1.ple_offload.worker as worker_module
+
+class Status:
+    def __eq__(self, other):
+        threading.Event().wait()
+
+    def __ne__(self, other):
+        threading.Event().wait()
+
+class Reader:
+    def close(self):
+        return None
+
+sleeper = subprocess.Popen(
+    [sys.executable, "-c", "import time; time.sleep(120)"]
+)
+handle = worker_module.PleOffloadWorkerHandle(
+    proc=sleeper,
+    death_writer=None,
+    ready_pipe_reader=Reader(),
+    launch_deadline=time.monotonic() + 120,
+)
+worker_module._recv_bounded_connection_message = (
+    lambda reader, deadline: {
+        "status": Status(),
+        "layer_names": ["ple"],
+    }
+)
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+rejected = False
+closed = False
+reader_cleared = False
+try:
+    try:
+        worker_module.PleOffloadWorker.wait_for_ready(handle)
+    except RuntimeError:
+        rejected = True
+    # Postconditions are read before the emergency cleanup below can act.
+    # Stay inside the parent's 5 second bounded wait so a miss reports here.
+    close_deadline = time.monotonic() + 3
+    while sleeper.poll() is None and time.monotonic() < close_deadline:
+        time.sleep(0.05)
+    closed = sleeper.poll() is not None
+    reader_cleared = handle.ready_pipe_reader is None
+finally:
+    if sleeper.poll() is None:
+        sleeper.kill()
+        sleeper.wait(timeout=120)
+
+if not rejected:
+    raise AssertionError("invalid response status was not rejected")
+if not closed:
+    raise AssertionError("invalid response did not close the child")
+if not reader_cleared:
+    raise AssertionError("invalid response did not clear the ready reader")
+"""
+    _run_bounded_child(source, tmp_path)
+
+
+@pytest.mark.parametrize("identity", ["duplicate", "unbound"])
+def test_profile_breakable_initializer_follows_identity_validation(
+    tmp_path: Path,
+    identity: str,
+) -> None:
+    source = r"""
+import os
+import sys
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+
+from vllm.v1.worker.gpu.cudagraph_utils import ModelCudaGraphManager
+
+identity = sys.argv[2]
+if identity == "duplicate":
+    identities = ("shared", "shared")
+else:
+    identities = ("<unbound>",)
+
+modules = [
+    (
+        "module_" + str(index),
+        SimpleNamespace(
+            _is_cpu_offloaded=True,
+            _host_output_ptr=1,
+            _ple_offload_name=value,
+        ),
+    )
+    for index, value in enumerate(identities)
+]
+model = SimpleNamespace(named_modules=lambda: iter(modules))
+manager = ModelCudaGraphManager.__new__(ModelCudaGraphManager)
+spy = Path(sys.argv[1] + ".initializer")
+
+def blocking_initializer(model):
+    spy.write_text("called", encoding="utf-8")
+    threading.Event().wait()
+
+manager.init_breakable_cg_runner = blocking_initializer
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+
+prepare = getattr(manager, "_prepare_ple_capture", None)
+if prepare is None:
+    # This is the pre-fix profiling order: initialize before validation.
+    manager.init_breakable_cg_runner(model)
+else:
+    try:
+        prepare(model, initialize_breakable=True)
+    except RuntimeError as error:
+        if "distinct, bound" not in str(error):
+            raise
+    else:
+        raise AssertionError("invalid identities were accepted")
+
+if spy.exists():
+    raise AssertionError("initializer ran before identity rejection")
+"""
+    _run_bounded_child(source, tmp_path, identity)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="process groups are POSIX-only")
+@pytest.mark.parametrize("status", ["READY", "FAILURE"])
+def test_oversized_startup_response_becomes_bounded_failure(
+    tmp_path: Path,
+    status: str,
