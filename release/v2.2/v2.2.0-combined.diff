+++ b/vllm/v1/worker/e2_identity.py
@@ -0,0 +1,266 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Per-rank launch-identity log line (log-only; changes no behaviour).
+
+After model loading -- and after the PLE offload placeholders are armed -- every
+GPU worker rank logs one line per model role it holds::
+
+    e2-identity[PP<p>_TP<t>]: ple_backend=<class>@<transport> ple_method=<class>
+    ple_weight_dtype=<dtype> breakable=<ON|OFF> compile_mode=<mode>
+    cudagraph_mode=<mode> role=<target|draft>
+
+(one line in the log). ``role=target`` is logged after model loading;
+``role=draft`` is logged only where a draft model is loaded (the last PP
+stage), once the drafter's graph modes are resolved (after the KV cache is
+initialised -- see below). Every value is read from the live objects:
+
+* ``ple_backend``: the class of each PLE layer's ``ple_embedding`` module, and
+  the transport that serves its rows on this rank, read from the placeholder's
+  armed state -- ``host-mapped-pull`` (``_is_cpu_offloaded`` with a host output
+  pointer), ``ipc-push`` (offloaded, no host pointer) or ``local:<device>`` (the
+  rank owns the table).
+* ``ple_method``: the embedding's live ``quant_method``, or, on an offloaded
+  placeholder, the ``_offload_quant_method`` the rank dequantizes with.
+* ``ple_weight_dtype``: the table's dtype where the rank owns it; on an
+  offloaded placeholder, the dtype of the armed transfer buffer, into which the
+  offload process copies the table's rows unchanged
+  (``get_offload_output_dtype``).
+* ``breakable``: ``is_breakable_cudagraph_enabled()``, the switch the capture
+  path itself reads.
+* ``compile_mode`` / ``cudagraph_mode`` for ``role=target``: the engine's
+  ``CompilationConfig`` (config level, i.e. before KV-cache-time capture-mode
+  resolution).
+* ``compile_mode`` / ``cudagraph_mode`` for ``role=draft``: the DRAFTER's own
+  resolved state, not the config. The drafter is built with the target's
+  VllmConfig and there is one ``CompilationConfig`` in the engine, so the
+  config fields name the target's profile (the trap an earlier commit fixed for
+  the draft guard's architectures). What the drafter actually runs is:
+
+  - ``compile_mode``: the mode of the draft model's live
+    ``@support_torch_compile`` wrapper(s) (``do_not_compile`` false -- the
+    property the capture path tests, ``gpu/cudagraph_utils.py``
+    ``has_compiled_submodule``); ``NONE`` when no wrapper is live.
+  - ``cudagraph_mode``: the mode each speculator cudagraph manager holds after
+    ``init_cudagraph_manager`` (V2 runner): ``prefill:<m>,decode:<m>`` for the
+    autoregressive / MTP speculator, the bare mode for a single-manager
+    speculator; for a V1 drafter, its dispatcher's mode. These are the values
+    ``e2-guard[runtime]`` checks before capture. ``unresolved`` if a manager
+    does not exist yet.
+
+  Hence the draft line is logged from ``Worker.initialize_from_config`` after
+  ``initialize_kv_cache``, not at load time.
+
+A role with no PLE layer reports ``none`` for the three PLE fields; several
+distinct values on one rank are joined with ``,``.
+"""
+
+from typing import Any
+
+from torch import nn
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_NONE = "none"
+
+
+def _join(values: set[str]) -> str:
+    return ",".join(sorted(values)) if values else _NONE
+
+
+def _enum_name(value: Any) -> str:
+    if value is None:
+        return _NONE
+    return str(getattr(value, "name", value))
+
+
+def _ple_embeddings(model: nn.Module | None) -> list[nn.Module]:
+    """The ``ple_embedding`` module of every PLE layer in ``model``."""
+    if model is None:
+        return []
+    found = []
+    for module in model.modules():
+        embedding = module.__dict__.get("_modules", {}).get("ple_embedding")
+        if isinstance(embedding, nn.Module):
+            found.append(embedding)
+    return found
+
+
+def _transport(embedding: nn.Module) -> str:
+    if getattr(embedding, "_is_cpu_offloaded", False):
+        if getattr(embedding, "_host_output_ptr", None) is not None:
+            return "host-mapped-pull"
+        return "ipc-push"
+    weight = getattr(getattr(embedding, "ngram_embedding", None), "weight", None)
+    if weight is not None:
+        return f"local:{weight.device.type}"
+    return "local:unknown"
+
+
+def _method(embedding: nn.Module) -> str:
+    table = getattr(embedding, "ngram_embedding", None)
+    method = getattr(table, "quant_method", None)
+    if method is None:
+        method = getattr(embedding, "_offload_quant_method", None)
+    return type(method).__name__ if method is not None else _NONE
+
+
+def _weight_dtype(embedding: nn.Module) -> str:
+    weight = getattr(getattr(embedding, "ngram_embedding", None), "weight", None)
+    if weight is not None:
+        return str(weight.dtype)
+    if getattr(embedding, "_is_cpu_offloaded", False):
+        buffer = getattr(embedding, "_gpu_output_buffer", None)
+        if buffer is not None:
+            return str(buffer.dtype)
+    return "unknown"
+
+
+def _rank_tag() -> str:
+    from vllm.distributed.parallel_state import get_pp_group, get_tp_group
+
+    return f"PP{get_pp_group().rank_in_group}_TP{get_tp_group().rank_in_group}"
+
+
+def _draft(model_runner: Any) -> tuple[nn.Module | None, Any]:
+    """The loaded draft model and its holder (V2 speculator or V1 drafter)."""
+    for name in ("speculator", "drafter"):
+        holder = getattr(model_runner, name, None)
+        model = getattr(holder, "model", None)
+        if isinstance(model, nn.Module):
+            return model, holder
+    return None, None
+
+
+#: Written where a draft graph mode has no resolved source yet.
+UNRESOLVED = "unresolved"
+#: Speculator cudagraph-manager attributes (the set ``e2-guard[runtime]``
+#: reads), with the phase label each carries on the draft line.
+_DRAFT_MANAGER_PHASES = (
+    ("prefill_cudagraph_manager", "prefill"),
+    ("decode_cudagraph_manager", "decode"),
+    ("cudagraph_manager", None),
+)
+
+
+def _draft_compile_mode(model: nn.Module) -> str:
+    """Compile mode of the draft model's live ``@support_torch_compile`` wrappers.
+
+    ``NONE`` when no wrapper is live: the drafter then runs eager, whatever
+    the shared ``CompilationConfig.mode`` says.
+    """
+    from vllm.compilation.wrapper import TorchCompileWithNoGuardsWrapper
+
+    modes = {
+        _enum_name(getattr(getattr(m, "compilation_config", None), "mode", None))
+        for m in model.modules()
+        if isinstance(m, TorchCompileWithNoGuardsWrapper)
+        and not getattr(m, "do_not_compile", True)
+    }
+    return _join(modes) if modes else "NONE"
+
+
+def _draft_cudagraph_mode(holder: Any) -> str:
+    """The drafter's resolved cudagraph mode(s), read from its managers."""
+    parts = []
+    for attr, phase in _DRAFT_MANAGER_PHASES:
+        if not hasattr(holder, attr):
+            continue
+        manager = getattr(holder, attr)
+        mode = (
+            UNRESOLVED
+            if manager is None
+            else _enum_name(getattr(manager, "cudagraph_mode", None))
+        )
+        parts.append(mode if phase is None else f"{phase}:{mode}")
+    if parts:
+        return ",".join(parts)
+    # V1 drafter: one dispatcher, keyed in _check_and_update_cudagraph_mode.
+    dispatcher = getattr(holder, "cudagraph_dispatcher", None)
+    if dispatcher is not None and getattr(dispatcher, "keys_initialized", False):
+        return _enum_name(getattr(dispatcher, "cudagraph_mode", None))
+    return UNRESOLVED
+
+
+def identity_line(
+    tag: str,
+    model: nn.Module | None,
+    vllm_config: Any,
+    role: str,
+    *,
+    compile_mode: str | None = None,
+    cudagraph_mode: str | None = None,
+) -> str:
+    """One identity line. ``compile_mode`` / ``cudagraph_mode`` override the
+    config-level values (the draft role passes its resolved state)."""
+    from vllm.compilation.breakable_cudagraph import is_breakable_cudagraph_enabled
+
+    embeddings = _ple_embeddings(model)
+    backends = {f"{type(e).__name__}@{_transport(e)}" for e in embeddings}
+    compilation = getattr(vllm_config, "compilation_config", None)
+    if compile_mode is None:
+        compile_mode = _enum_name(getattr(compilation, "mode", None))
+    if cudagraph_mode is None:
+        cudagraph_mode = _enum_name(getattr(compilation, "cudagraph_mode", None))
+    return (
+        f"e2-identity[{tag}]: "
+        f"ple_backend={_join(backends)} "
+        f"ple_method={_join({_method(e) for e in embeddings})} "
+        f"ple_weight_dtype={_join({_weight_dtype(e) for e in embeddings})} "
+        f"breakable={'ON' if is_breakable_cudagraph_enabled() else 'OFF'} "
+        f"compile_mode={compile_mode} "
+        f"cudagraph_mode={cudagraph_mode} "
+        f"role={role}"
+    )
+
+
+def draft_identity_line(tag: str, draft_model: nn.Module, holder: Any) -> str:
+    """The ``role=draft`` line: PLE fields from the draft modules, graph fields
+    from the drafter's resolved state (never the shared CompilationConfig)."""
+    return identity_line(
+        tag,
+        draft_model,
+        getattr(holder, "vllm_config", None),
+        "draft",
+        compile_mode=_draft_compile_mode(draft_model),
+        cudagraph_mode=_draft_cudagraph_mode(holder),
+    )
+
+
+def log_launch_identity(model_runner: Any, vllm_config: Any) -> None:
+    """Log this rank's ``role=target`` line after model load. Never raises.
+
+    The ``role=draft`` line comes later, from :func:`log_draft_identity`, once
+    the drafter's graph modes exist.
+    """
+    tag = "PP?_TP?"
+    try:
+        tag = _rank_tag()
+        logger.info(
+            "%s", identity_line(tag, model_runner.get_model(), vllm_config, "target")
+        )
+    except Exception as error:  # log-only: identity must never break a boot
+        logger.warning(
+            "e2-identity[%s]: unavailable (%s: %s)", tag, type(error).__name__, error
+        )
+
+
+def log_draft_identity(model_runner: Any) -> None:
+    """Log this rank's ``role=draft`` line, if it holds a drafter. Never raises.
+
+    Call after ``initialize_kv_cache``: that is where the V2 runner resolves
+    the target's mode and ``init_cudagraph_manager`` derives the drafter's
+    (and where the V1 runner keys the drafter's dispatcher).
+    """
+    tag = "PP?_TP?"
+    try:
+        draft_model, holder = _draft(model_runner)
+        if draft_model is None:
+            return
+        tag = _rank_tag()
+        logger.info("%s", draft_identity_line(tag, draft_model, holder))
+    except Exception as error:  # log-only: identity must never break a boot
+        logger.warning(
+            "e2-identity[%s]: unavailable (%s: %s)", tag, type(error).__name__, error
+        )
diff --git a/vllm/v1/worker/e2_memstats.py b/vllm/v1/worker/e2_memstats.py
new file mode 100644
index 0000000000..9fcbfcfb7b
--- /dev/null
+++ b/vllm/v1/worker/e2_memstats.py
@@ -0,0 +1,200 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Debug-only allocator telemetry for E2, BOUNDARY-ONLY. Off unless
+VLLM_E2_MEMSTATS=<ctl poll seconds> and VLLM_E2_MEMSTATS_DIR=<dir>.
+
+WHY THIS IS NOT A SAMPLER ANY MORE. An earlier version read
+torch.cuda.memory_stats() and reset_peak_memory_stats() every VLLM_E2_MEMSTATS
+seconds. Both take the per-device caching-allocator mutex and the Python
+bindings do not release the GIL, so the old contract's claim that this thread
+"takes no lock shared with the model path" was FALSE. Three one-boot arms at a
+4.1e9 KV pin showed a monotone dose-response: sampling at 4 Hz wedged a stage-0
+worker during a 131K thinking-on row; at 1.1 Hz it survived that row and wedged during
+a 260K row; with the thread disabled the run completed every row. Causation
+is not established at n=1 per arm (a known limit of
+that capacity probe), but polling has no place
+inside a measured region, and it was never necessary: PyTorch maintains the
+allocator high-water marks itself, so reading them once per window is exact.
+
+WHAT THIS THREAD DOES NOW. Between window boundaries it makes NO CUDA calls and
+touches NO allocator state: its tick is a plain read of <dir>/window.ctl, which
+holds "<seq> <name>". The gate driver crosses a boundary only while the server
+is quiet (no request running). On a new seq the thread performs these
+boundary-only allocator reads:
+  1. memory_stats()            -> the closing window's exact high-water marks
+                                  and cumulative retry/OOM counters
+  2. reset_peak_memory_stats() -> immediately after the read, with no file I/O
+                                  in the gap
+  3. mem_get_info()            -> device free/total AT THAT QUIESCENT INSTANT
+  4. host_memory_stats()       -> pinned-host allocator current values, outside
+                                  the read-to-reset gap
+then writes the "close" record for the old window and the "ack" record for the
+new one.
+
+WHAT THIS MEASURES.
+  - A row's allocator peak is EXACT for that row's window (not a sampled
+    maximum; it cannot miss a transient).
+  - Device free/total is observed ONLY at quiescent boundaries. No minimum-free
+    figure exists for the inside of a row, and none may be reported.
+  - Retry and OOM counters are cumulative and never reset; per-row deltas come
+    from consecutive close records.
+  - There is NO interval-level peak. A qualifying interval is narrower
+    than its row and is identified only afterwards from the scheduler log, so
+    the peak attributable to it is the ROW-level high-water mark, which
+    over-includes the prefill ramp. Report this loss of resolution
+    explicitly.
+
+Records (one JSON per line): kind start | close | ack | error; rank, local,
+dev, pid; window, seq; and for close: allocated_bytes.all.current,
+reserved_bytes.all.current, alloc_peak_w, res_peak_w, retries, ooms, free,
+total, run_alloc_peak, run_res_peak, and a host object containing every
+host_memory_stats() key ending in ".current". Records are written with
+synchronous file I/O, never inside the read-to-reset gap. Nothing here raises
+into the worker.
+"""
+
+import json
+import os
+import threading
+import time
+
+import torch
+
+_SEG = float(os.environ.get("VLLM_E2_MEMSTATS", "0") or 0)
+_DIR = os.environ.get("VLLM_E2_MEMSTATS_DIR", "")
+_started = []
+VERSION = "e2_memstats/5-boundary-current-host"
+
+
+def _close_metrics(dev):
+    """Read one quiescent boundary; kept separate for CPU-only testing."""
+    s = torch.cuda.memory_stats(dev)
+    ap = int(s.get("allocated_bytes.all.peak", 0))
+    rp = int(s.get("reserved_bytes.all.peak", 0))
+    torch.cuda.reset_peak_memory_stats(dev)  # no file I/O in the gap
+    free, total = torch.cuda.mem_get_info(dev)
+    host_stats = torch.cuda.host_memory_stats()
+    host = {
+        key: int(value) for key, value in host_stats.items() if key.endswith(".current")
+    }
+    return {
+        "allocated_bytes.all.current": int(s.get("allocated_bytes.all.current", 0)),
+        "reserved_bytes.all.current": int(s.get("reserved_bytes.all.current", 0)),
+        "alloc_peak_w": ap,
+        "res_peak_w": rp,
+        "retries": int(s.get("num_alloc_retries", 0)),
+        "ooms": int(s.get("num_ooms", 0)),
+        "free": int(free),
+        "total": int(total),
+        "host": host,
+    }
+
+
+def enabled() -> bool:
+    return _SEG > 0 and bool(_DIR)
+
+
+def ensure_started(worker, armed_by: str = "compile_or_warm_up_model") -> None:
+    if _started:
+        return
+    dev = (
+        torch.cuda.current_device()
+    )  # captured on the worker's own thread: every call below passes it explicitly
+    t = threading.Thread(
+        target=_loop,
+        name="e2-memstats",
+        daemon=True,
+        args=(
+            dev,
+            getattr(worker, "rank", -1),
+            getattr(worker, "local_rank", -1),
+            armed_by,
+        ),
+    )
+    _started.append(t)
+    t.start()
+
+
+def _ctl():
+    try:
+        with open(os.path.join(_DIR, "window.ctl")) as f:
+            seq, name = f.read().split(None, 1)
+        return int(seq), name.strip()
+    except (OSError, ValueError):
+        return None
+
+
+def _loop(dev, rank, local, armed_by):
+    os.makedirs(_DIR, exist_ok=True)
+    # noqa SIM115: the handle lives as long as the telemetry daemon thread
+    # that writes to it; there is no scope to close it in.
+    f = open(  # noqa: SIM115
+        os.path.join(_DIR, f"memstats-rank{rank}-pid{os.getpid()}.jsonl"),
+        "a",
+        buffering=1,
+    )
+    base = {"rank": rank, "local": local, "dev": dev, "pid": os.getpid()}
+
+    def w(rec):
+        f.write(json.dumps({**base, **rec}, separators=(",", ":")) + "\n")
+
+    run_ap = run_rp = 0
+    seq, name = _ctl() or (0, "serve")
+    torch.cuda.reset_peak_memory_stats(dev)
+    w(
+        {
+            "kind": "start",
+            "t": round(time.time(), 4),
+            "m": round(time.monotonic(), 4),
+            "armed_by": armed_by,
+            "window": name,
+            "seq": seq,
+            "version": VERSION,
+            "poll_s": _SEG,
+        }
+    )
+    while True:
+        time.sleep(_SEG)
+        try:
+            c = _ctl()  # file read only: no CUDA, no allocator lock, no GIL-held call
+            if c is None or c[0] == seq:
+                continue
+            # Boundary. The driver only crosses one while the server is
+            # quiet, so this is the single point at which this thread
+            # touches the allocator at all.
+            metrics = _close_metrics(dev)
+            ap = metrics["alloc_peak_w"]
+            rp = metrics["res_peak_w"]
+            run_ap, run_rp = max(run_ap, ap), max(run_rp, rp)
+            w(
+                {
+                    "kind": "close",
+                    "t": round(time.time(), 4),
+                    "m": round(time.monotonic(), 4),
+                    "window": name,
+                    "seq": seq,
+                    **metrics,
+                    "run_alloc_peak": run_ap,
+                    "run_res_peak": run_rp,
+                }
+            )
+            seq, name = c
+            w(
+                {
+                    "kind": "ack",
+                    "t": round(time.time(), 4),
+                    "m": round(time.monotonic(), 4),
+                    "window": name,
+                    "seq": seq,
+                }
+            )
+        except Exception as e:  # noqa: BLE001 - telemetry must never raise into the worker
+            w(
+                {
+                    "kind": "error",
+                    "t": round(time.time(), 4),
+                    "m": round(time.monotonic(), 4),
+                    "window": name,
+                    "seq": seq,
+                    "error": f"{type(e).__name__}: {e}"[:300],
+                }
+            )
diff --git a/vllm/v1/worker/e2_toggles.py b/vllm/v1/worker/e2_toggles.py
new file mode 100644
index 0000000000..056a905413
--- /dev/null
+++ b/vllm/v1/worker/e2_toggles.py
@@ -0,0 +1,488 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Per-rank determinism-toggle line (log-only; changes no behaviour).
+
+Why this exists: the effective state of the
+four determinism toggles and the three persistent_topk switches must be
+attributable to a RANK and a PID. The kernel's own stderr line
+(``[merlin] persistent_topk tie policy: ...``, topk.cu report_tie_policy_once)
+is printed once per process with no tag, and FULL_K / QSA_SORT have no log
+producer at all. Every GPU worker therefore logs exactly one line::
+
+    e2-toggles[PP<p>_TP<t>]: pid=<pid> MERLIN_FULL_K=<raw> MERLIN_QSA_SORT=<raw>
+    MERLIN_TIE_DET=<raw> MERLIN_TIE_RECENT=<raw> MERLIN_TOPK_EXACT_MEDIUM=<raw>
+    MERLIN_TOPK_EXACT_DECODE=<raw> MERLIN_TOPK_DET_LARGE=<raw>
+    MERLIN_TOPK_SORTED_EMIT=<raw>
+    effective: full_k=<0|1> qsa_sort=<0|1|invalid> tie_det=<0|1> tie_recent=<0|1>
+    tie_recent_effective=<0|1> exact_medium=<0|1> exact_decode=<0|1>
+    det_large=<0|1> sorted_emit=<0|1> source=<libc-getenv|os-environ>
+    cpp-cache: <full_k=... tie_det=... tie_recent=... tie_recent_effective=...
+    exact_medium=... exact_decode=... det_large=... sorted_emit=...
+    source=cpp-cache | n-a reason=<why>>
+    python: qsa_sort=<0|1|n-a> sorted_emit_skip=<0|1|n-a>
+    source=qsa_indexer._QSA_SORT
+    device: switch=<0|1|n-a> switch_large=<0|1|n-a> source=counter-slots-8-9
+
+(one line in the log). ``<raw>`` is ``unset``, a plain token, or a double-quoted
+string with every byte outside ``[!-~]`` (and ``"`` / ``\\``) hex-escaped, so
+the line always splits on whitespace.
+
+WHAT EACH SECTION IS
+* ``effective:`` -- the environment at emission time, parsed with the SAME
+  rules the readers use (C++ ``std::getenv`` + ``std::atoi != 0`` for the six
+  C++ names, ``bool(int(...))`` for QSA_SORT; file:line of each below). The
+  C++ names are read through libc ``getenv`` -- the ``environ`` that
+  ``std::getenv`` reads -- not ``os.environ``, which can diverge from it after
+  an ``os.putenv``. A MIRROR of the parse, not the kernel's state. It exists
+  to report the rule; nothing may branch on it (vllm/envs.py "NOT A PYTHON
+  READ SITE" still holds: this module decides nothing).
+* ``cpp-cache:`` -- the kernel's switches as the C++ statics cached them, from
+  ``torch.ops._C.persistent_topk_toggle_state`` and
+  ``torch.ops._moe_C.marlin_moe_full_k_state`` (query ops that only LOAD a
+  mirror the static initialisers publish; they never fill a cache). ``n-a``
+  with a reason on a build without those ops -- the extensions this release
+  was first cut against (earlier v2.2 builds, not published) have none.
+* ``python:`` -- ``qsa_indexer._QSA_SORT``, the module constant the QSA sort
+  actually branches on (looked up in ``sys.modules``, never imported here;
+  ``n-a`` if the module was never loaded in this process), and
+  ``sorted_emit_skip`` -- ``qsa_indexer._kernel_sorted_emit_state``, i.e.
+  whether the Python sort is being SKIPPED because the kernel reported
+  MERLIN_TOPK_SORTED_EMIT through ``persistent_topk_toggle_state`` field 6
+  (``n-a`` until the first QSA top-k has run and latched it).
+* ``device:`` -- counter slots [8]/[9], which the counter op fills from the
+  C++ ``exact_medium_enabled()`` / ``det_large_enabled()`` statics
+  (topk.cu persistent_topk_exact_counters).
+
+WHEN. Once per worker, after ``compile_or_warm_up_model`` has run the MRV2
+kernel warmup and cudagraph capture (``arm()``), i.e. after this process's
+first persistent_topk and Marlin MoE launches -- NOT at the counter reader's
+first read: an integration boot logged its first counter line BEFORE
+the first tie-policy line in the engine log, because the
+first ``maybe_log`` runs at the head of the warmup's first execute step, before
+that step's forward. When the cpp-cache ops exist and a static is still
+uninitialised at ``arm()``, the line is deferred to the head of the first
+execute step where every static is filled, and forced out at shutdown
+otherwise (with ``uninit`` values, which the smoke FAILs). It does not depend on
+``MERLIN_TOPK_EXACT_COUNTERS_LOG``: it fires with the counter log off.
+
+WHAT THIS DOES NOT PROVE. Without the cpp-cache ops the C++ state is inferred,
+not read: for FULL_K, TIE_DET, TIE_RECENT and EXACT_DECODE the line is the
+environment at emission time run through the C++ parser's rules, and the only
+C++-derived evidence is ``device:`` (EXACT_MEDIUM and DET_LARGE) plus the
+untagged stderr policy line. The residual gap is an environment mutated
+between the kernel's first ``getenv`` and this read. Nothing in this tree does
+that (by grep of csrc/): no ``setenv``/``putenv``/``unsetenv`` under csrc/, and
+the only runtime ``os.environ.update`` calls in vllm/ are the RunAI streamer's
+fixed ``RUNAI_STREAMER_*`` keys (model_executor/model_loader/
+runai_streamer_loader.py:73) and the Ray executor's ``override_env_vars``
+(v1/executor/ray_utils.py:180), which the multiproc executor never calls. With the
+cpp-cache ops that gap closes for every C++ name. Even then the line proves the
+CONFIGURATION each rank ran, not that a switch changed any output: that is the
+job of an output-equality run (identical sends -> one distinct output).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from collections.abc import Callable
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+# (environment name, effective key, value when unset or empty) -- the C++
+# readers, each `static const bool enabled = [] { ... }();` once per process:
+#   MERLIN_FULL_K            csrc/libtorch_stable/moe/marlin_moe_wna16/ops.cu:57-63
+#   MERLIN_TIE_DET           csrc/libtorch_stable/topk.cu:60-66
+#   MERLIN_TIE_RECENT        csrc/libtorch_stable/topk.cu:52-58
+#   MERLIN_TOPK_EXACT_MEDIUM csrc/libtorch_stable/topk.cu:68-74   (unset -> ON)
+#   MERLIN_TOPK_EXACT_DECODE csrc/libtorch_stable/topk.cu:103-109
+#   MERLIN_TOPK_DET_LARGE    csrc/libtorch_stable/topk.cu:86-92   (unset -> ON)
+#   MERLIN_TOPK_SORTED_EMIT  csrc/libtorch_stable/topk.cu sorted_emit_enabled
+CXX_SWITCHES: tuple[tuple[str, str, bool], ...] = (
+    ("MERLIN_FULL_K", "full_k", False),
+    ("MERLIN_TIE_DET", "tie_det", False),
+    ("MERLIN_TIE_RECENT", "tie_recent", False),
+    ("MERLIN_TOPK_EXACT_MEDIUM", "exact_medium", True),
+    ("MERLIN_TOPK_EXACT_DECODE", "exact_decode", False),
+    ("MERLIN_TOPK_DET_LARGE", "det_large", True),
+    ("MERLIN_TOPK_SORTED_EMIT", "sorted_emit", False),
+)
+QSA_SORT_NAME = "MERLIN_QSA_SORT"
+RAW_ORDER = (
+    "MERLIN_FULL_K",
+    "MERLIN_QSA_SORT",
+    "MERLIN_TIE_DET",
+    "MERLIN_TIE_RECENT",
+    "MERLIN_TOPK_EXACT_MEDIUM",
+    "MERLIN_TOPK_EXACT_DECODE",
+    "MERLIN_TOPK_DET_LARGE",
+    "MERLIN_TOPK_SORTED_EMIT",
+)
+EFFECTIVE_ORDER = (
+    "full_k",
+    "qsa_sort",
+    "tie_det",
+    "tie_recent",
+    "tie_recent_effective",
+    "exact_medium",
+    "exact_decode",
+    "det_large",
+    "sorted_emit",
+)
+CPP_ORDER = tuple(k for k in EFFECTIVE_ORDER if k != "qsa_sort")
+
+_QSA_MODULE = "vllm.models.qwen4_exp.nvidia.ops.qsa_indexer"
+_C_SPACE = b" \t\n\v\f\r"  # isspace() in the "C" locale
+_LONG_MIN, _LONG_MAX = -(2**63), 2**63 - 1  # LP64 long, the reference host's glibc
+
+
+# --------------------------------------------------------------- parsers ----
+def c_atoi(raw: bytes) -> int:
+    """glibc ``atoi``: ``(int) strtol(raw, NULL, 10)`` (glibc stdlib/atoi.c).
+
+    Leading C-locale whitespace, one optional sign, then decimal digits up to
+    the first non-digit; no digits -> 0. ``strtol`` clamps to the ``long``
+    range and the ``(int)`` conversion keeps the low 32 bits (GCC's documented
+    modulo behaviour). So ``"true"`` -> 0, ``"1abc"`` -> 1, ``"0x1"`` -> 0,
+    ``" +1"`` -> 1, ``"+ 1"`` -> 0 and ``"4294967296"`` -> 0.
+    """
+    i, n = 0, len(raw)
+    while i < n and raw[i] in _C_SPACE:
+        i += 1
+    negative = False
+    if i < n and raw[i] in b"+-":
+        negative = raw[i] == ord("-")
+        i += 1
+    value, digits = 0, 0
+    while i < n and 0x30 <= raw[i] <= 0x39:
+        value = value * 10 + (raw[i] - 0x30)
+        digits += 1
+        i += 1
+    if digits == 0:
+        return 0
+    if negative:
+        value = -value
+    value = max(_LONG_MIN, min(_LONG_MAX, value))
+    value &= 0xFFFFFFFF
+    return value - (1 << 32) if value >= (1 << 31) else value
+
+
+def cxx_switch(raw: bytes | None, unset_value: bool) -> bool:
+    """The C++ getter body, both shapes:
+    default OFF  ``(raw != nullptr && raw[0] != '\\0') ? (atoi(raw) != 0) : false``
+    default ON   ``(raw == nullptr || raw[0] == '\\0') ? true : (atoi(raw) != 0)``
+    An environment value cannot contain NUL, so "empty" is exactly
+    ``raw[0] == '\\0'``."""
+    if raw is None or raw == b"":
+        return unset_value
+    return c_atoi(raw) != 0
+
+
+def qsa_sort_value(raw: str | None) -> str:
+    """vllm/envs.py:2372 ``bool(int(os.getenv("MERLIN_QSA_SORT", "0")))``,
+    read once at import by qsa_indexer.py:51 (``_QSA_SORT``). ``int()`` raises
+    on ``"true"`` and on ``""`` -- that engine would not have booted -- which is
+    reported as ``invalid`` rather than guessed. Python's own ``int`` is used,
+    so whitespace, ``+``/``-``, ``1_0`` and non-ASCII digits parse exactly as
+    the reader parses them."""
+    try:
+        return "1" if bool(int("0" if raw is None else raw)) else "0"
+    except ValueError:
+        return "invalid"
+
+
+def effective_tie_recent(det_ties: bool, tie_recent: bool) -> bool:
+    """csrc/libtorch_stable/persistent_topk.cuh:65-68: ``det_ties ? tie_recent
+    : true`` -- with TIE_DET off the restart paths keep most-recent-wins."""
+    return tie_recent if det_ties else True
+
+
+# --------------------------------------------------------------- sources ----
+def _libc_getenv() -> tuple[Callable[[str], bytes | None], str]:
+    """libc ``getenv``: the ``environ`` the C++ ``std::getenv`` calls read.
+
+    Falls back to ``os.environb`` / ``os.environ`` -- and says so in the line's
+    ``source=`` -- where there is no C library to ask (an offline run off Linux).
+    """
+    try:
+        import ctypes
+
+        getenv = ctypes.CDLL(None).getenv
+        getenv.restype = ctypes.c_char_p
+        getenv.argtypes = [ctypes.c_char_p]
+
+        def read(name: str) -> bytes | None:
+            return getenv(name.encode("ascii"))
+
+        return read, "libc-getenv"
+    except (OSError, AttributeError, TypeError):
+        pass
+    environb = getattr(os, "environb", None)
+    if environb is not None:
+        return (lambda name: environb.get(name.encode("ascii"))), "os-environ"
+
+    def read_environ(name: str) -> bytes | None:
+        value = os.environ.get(name)
+        return None if value is None else value.encode("utf-8", "surrogateescape")
+
+    return read_environ, "os-environ"
+
+
+def _printable(b: int) -> bool:
+    return 0x21 <= b <= 0x7E and b not in b'"\\'
+
+
+def encode_raw(raw: bytes | None) -> str:
+    """``unset``, a plain token, or a quoted, hex-escaped string -- never a
+    space, so the line splits on whitespace. The literal value ``unset`` is
+    quoted so it cannot pass for an absent variable."""
+    if raw is None:
+        return "unset"
+    if raw and raw != b"unset" and all(_printable(b) for b in raw):
+        return raw.decode("ascii")
+    return '"' + "".join(chr(b) if _printable(b) else f"\\x{b:02x}" for b in raw) + '"'
+
+
+def environ_view(
+    cxx_getenv: Callable[[str], bytes | None],
+    py_getenv: Callable[[str], str | None],
+) -> tuple[dict[str, str], dict[str, str]]:
+    """(raw value by name, effective map) from one read of the environment."""
+    raw: dict[str, str] = {}
+    flags: dict[str, bool] = {}
+    for name, key, unset_value in CXX_SWITCHES:
+        value = cxx_getenv(name)
+        raw[name] = encode_raw(value)
+        flags[key] = cxx_switch(value, unset_value)
+    qsa_raw = py_getenv(QSA_SORT_NAME)
+    raw[QSA_SORT_NAME] = encode_raw(
+        None if qsa_raw is None else qsa_raw.encode("utf-8", "surrogateescape")
+    )
+    eff = {key: "1" if flags[key] else "0" for key in flags}
+    eff["qsa_sort"] = qsa_sort_value(qsa_raw)
+    eff["tie_recent_effective"] = (
+        "1" if effective_tie_recent(flags["tie_det"], flags["tie_recent"]) else "0"
+    )
+    return raw, {key: eff[key] for key in EFFECTIVE_ORDER}
+
+
+_TOPK_STATE_FIELDS = (
+    "tie_det",
+    "tie_recent",
+    "tie_recent_effective",
+    "exact_medium",
+    "exact_decode",
+    "det_large",
+    "sorted_emit",
+)
+# Known layouts: version -> field count. Layout 2 is layout 1
+# plus field 6 (MERLIN_TOPK_SORTED_EMIT); fields 0-5 are unchanged.
+_TOPK_STATE_LAYOUTS = {1: 6, 2: 7}
+
+
+def decode_topk_state(state: int) -> dict[str, str] | str:
+    """Unpack ``persistent_topk_toggle_state()``: 2 bits per field (0 off,
+    1 on, 2 not initialised), field count at bits 48-55, layout version at
+    bits 56-62 -- (1, 6) or (2, 7). Any other layout is refused with a reason
+    string. A layout-1 build has no sorted emission, reported as ``n-a``."""
+    version, count = (state >> 56) & 0x7F, (state >> 48) & 0xFF
+    if _TOPK_STATE_LAYOUTS.get(version) != count:
+        return f"unknown-layout-v{version}-{count}-fields"
+    names = {0: "0", 1: "1", 2: "uninit"}
+    out = {
+        key: names.get((state >> (2 * i)) & 3, "invalid")
+        for i, key in enumerate(_TOPK_STATE_FIELDS[:count])
+    }
+    for key in _TOPK_STATE_FIELDS[count:]:
+        out[key] = "n-a"
+    return out
+
+
+def decode_full_k_state(state: int) -> str:
+    """``marlin_moe_full_k_state()``: -1 not initialised, 0 off, 1 on."""
+    return {-1: "uninit", 0: "0", 1: "1"}.get(int(state), "invalid")
+
+
+def _op(namespace: str, name: str):
+    try:
+        import torch
+
+        return getattr(getattr(torch.ops, namespace), name, None)
+    except (AttributeError, RuntimeError, ImportError):
+        return None
+
+
+def cpp_cache() -> dict[str, str] | str:
+    """The C++ cached switches, or a reason string when the build cannot say."""
+    topk_op = _op("_C", "persistent_topk_toggle_state")
+    full_k_op = _op("_moe_C", "marlin_moe_full_k_state")
+    missing = [
+        name
+        for name, op in (
+            ("_C.persistent_topk_toggle_state", topk_op),
+            ("_moe_C.marlin_moe_full_k_state", full_k_op),
+        )
+        if op is None
+    ]
+    if missing:
+        return "op-absent:" + ",".join(missing)
+    decoded = decode_topk_state(int(topk_op()))
+    if isinstance(decoded, str):
+        return decoded
+    out = dict(decoded, full_k=decode_full_k_state(int(full_k_op())))
+    return {key: out[key] for key in CPP_ORDER}
+
+
+def qsa_sort_live() -> str:
+    module = sys.modules.get(_QSA_MODULE)
+    if module is None or not hasattr(module, "_QSA_SORT"):
+        return "n-a"
+    return "1" if bool(module._QSA_SORT) else "0"
+
+
+def sorted_emit_skip_live() -> str:
+    """``qsa_indexer._kernel_sorted_emit_state``: 1 = the Python sort is being
+    skipped because the kernel reported sorted emission, 0 = not skipped,
+    ``n-a`` = not latched yet (or the module was never loaded)."""
+    module = sys.modules.get(_QSA_MODULE)
+    state = getattr(module, "_kernel_sorted_emit_state", None) if module else None
+    if state is None:
+        return "n-a"
+    return "1" if state else "0"
+
+
+def device_switches() -> dict[str, str]:
+    """Counter slots [8]/[9] (switch / switch_large). One synchronizing read
+    (topk_counters.read refuses inside a capture), so it is only called from
+    arm() and the head of an execute step."""
+    try:
+        from vllm.models.qwen4_exp.nvidia.ops import topk_counters
+
+        counters = topk_counters.read()
+    except Exception:
+        counters = {}
+    return {
+        key: str(counters[key]) if key in counters else "n-a"
+        for key in ("switch", "switch_large")
+    }
+
+
+# ------------------------------------------------------------------ line ----
+def toggles_line(
+    tag: str,
+    pid: int,
+    raw: dict[str, str],
+    effective: dict[str, str],
+    env_source: str,
+    cpp: dict[str, str] | str,
+    qsa_live: str,
+    device: dict[str, str],
+    sorted_skip: str = "n-a",
+) -> str:
+    parts = [f"e2-toggles[{tag}]: pid={pid}"]
+    parts += [f"{name}={raw[name]}" for name in RAW_ORDER]
+    parts.append("effective:")
+    parts += [f"{key}={effective[key]}" for key in EFFECTIVE_ORDER]
+    parts.append(f"source={env_source}")
+    parts.append("cpp-cache:")
+    if isinstance(cpp, str):
+        parts += ["n-a", f"reason={cpp}"]
+    else:
+        parts += [f"{key}={cpp[key]}" for key in CPP_ORDER]
+        parts.append("source=cpp-cache")
+    parts += [
+        "python:",
+        f"qsa_sort={qsa_live}",
+        f"sorted_emit_skip={sorted_skip}",
+        "source=qsa_indexer._QSA_SORT",
+    ]
+    parts.append("device:")
+    parts += [f"{key}={device[key]}" for key in ("switch", "switch_large")]
+    parts.append("source=counter-slots-8-9")
+    return " ".join(parts)
+
+
+def _rank_tag() -> str:
+    from vllm.distributed.parallel_state import get_pp_group, get_tp_group
+
+    return f"PP{get_pp_group().rank_in_group}_TP{get_tp_group().rank_in_group}"
+
+
+# ----------------------------------------------------------------- state ----
+_armed = False
+_emitted = False
+_deferral_noted = False
+
+
+def _reset_for_tests() -> None:
+    global _armed, _emitted, _deferral_noted
+    _armed = _emitted = _deferral_noted = False
+
+
+def arm(**kwargs) -> str:
+    """Once per worker, at the end of compile_or_warm_up_model (warmup and
+    capture done): emit now, unless a C++ static is still uninitialised."""
+    global _armed
+    _armed = True
+    return maybe_emit(**kwargs)
+
+
+def maybe_emit(
+    force: bool = False,
+    *,
+    tag_fn: Callable[[], str] = _rank_tag,
+    getenv_fn: Callable[[], tuple[Callable[[str], bytes | None], str]] = _libc_getenv,
+    cpp_fn: Callable[[], dict[str, str] | str] = cpp_cache,
+    device_fn: Callable[[], dict[str, str]] = device_switches,
+    qsa_fn: Callable[[], str] = qsa_sort_live,
+    sorted_skip_fn: Callable[[], str] = sorted_emit_skip_live,
+) -> str:
+    """Emit the line at most once per process. One bool check when already
+    emitted or not yet armed, so it can sit at the head of every execute step.
+    Never raises. Returns the line when this call emitted it, else ""."""
+    global _emitted, _deferral_noted
+    if _emitted or not _armed:
+        return ""
+    tag = "PP?_TP?"
+    try:
+        tag = tag_fn()
+        cpp = cpp_fn()
+        pending = (
+            sorted(k for k, v in cpp.items() if v == "uninit")
+            if isinstance(cpp, dict)
+            else []
+        )
+        if pending and not force:
+            if not _deferral_noted:
+                _deferral_noted = True
+                # Deliberately not 'e2-toggles[': the smoke counts those.
+                logger.info(
+                    "e2-toggles deferred on %s: C++ cache not initialised for %s",
+                    tag,
+                    ",".join(pending),
+                )
+            return ""
+        cxx_getenv, env_source = getenv_fn()
+        raw, effective = environ_view(cxx_getenv, os.environ.get)
+        line = toggles_line(
+            tag,
+            os.getpid(),
+            raw,
+            effective,
+            env_source,
+            cpp,
+            qsa_fn(),
+            device_fn(),
+            sorted_skip_fn(),
+        )
+        _emitted = True
+        logger.info("%s", line)
+        return line
+    except Exception as error:  # log-only: must never break a boot or a step
+        _emitted = True
+        logger.warning(
+            "e2-toggles[%s]: unavailable (%s: %s)", tag, type(error).__name__, error
+        )
+        return ""
