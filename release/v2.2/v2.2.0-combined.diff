+# BETWEEN these, never the whole file -- see its docstring for why.
+_UNAUDITED_START = "# --8<-- [start:unaudited-host-side-knobs]"
+_UNAUDITED_END = "# --8<-- [end:unaudited-host-side-knobs]"
