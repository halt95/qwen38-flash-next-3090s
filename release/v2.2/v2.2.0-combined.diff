+# of values C++ parses, hashed on the same conservative rule as the four above.
+# They are NOT in _TIEDET_HASHED because "unset reads falsy" says nothing useful
+# about them -- MERLIN_TOPK_EXACT_MEDIUM's C++ default is ON, so asserting it
+# under test_tiedet_toggle_defaults_off would be a test that cannot fail in the
+# direction that matters.
+_TIEDET_KERNEL_SWITCHES = [
+    ("MERLIN_TOPK_EXACT_MEDIUM", "0", "0"),
+    ("MERLIN_TOPK_EXACT_DECODE", "1", "1"),
+    ("MERLIN_TOPK_DET_LARGE", "1", "1"),
+]
