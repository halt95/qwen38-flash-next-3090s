+def _fresh_env_value(name: str):
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+    return getattr(envs, name)
+
+
+@pytest.mark.parametrize(("name", "value", "expected"), _FORK_HASHED)
+def test_fork_knob_is_a_cache_factor(
+    name: str, value: str, expected, monkeypatch: pytest.MonkeyPatch
+):
+    """A knob that can change a compiled or captured artifact must be hashed,
+    and the hashed value must follow the environment."""
+    assert name in environment_variables
+    monkeypatch.setenv(name, value)
+    assert _fresh_env_value(name) == expected
+    factors = envs.compile_factors()
+    assert name in factors
+    assert factors[name] == expected
+
+
+def _unaudited_names(source: str) -> set[str]:
+    """The knob names listed between the two fence markers.
+
+    Identifiers, not a substring scan: `"MERLIN_FULL_K" in block` is true for a
+    fence whose prose merely mentions the name, which is the same class of
+    defect one level down. Raises if the fence is missing or inverted, so
+    deleting a marker fails the gate instead of silently emptying it.
+    """
+    start = source.find(_UNAUDITED_START)
+    end = source.find(_UNAUDITED_END)
+    assert start != -1, f"missing marker {_UNAUDITED_START!r} in envs.py"
+    assert end != -1, f"missing marker {_UNAUDITED_END!r} in envs.py"
+    assert start < end, "unaudited-knob markers are inverted in envs.py"
+    block = source[start + len(_UNAUDITED_START) : end]
+    return set(re.findall(r"\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\b", block))
+
+
