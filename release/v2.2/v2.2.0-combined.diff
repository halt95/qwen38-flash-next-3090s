+def test_largedet_fault_injector_changes_the_cache_key(
+    name: str, value: str, expected, monkeypatch: pytest.MonkeyPatch
+):
+    """Arming an injector must move the compile factors, not just appear in them.
+
+    MERLIN_TOPK_LARGE_FAULT_INJECT was once unregistered and
+    capture-baked: a cudagraph captured with it armed keeps returning all -1
+    rows on replay whatever the environment says afterwards. Registration is
+    only worth something if the hashed value FOLLOWS the environment, so assert
+    both worlds -- unset reads None and absent-from-armed, armed reads the raw
+    string -- rather than membership alone, which a dead getter would satisfy.
+    """
+    monkeypatch.delenv(name, raising=False)
+    assert _fresh_env_value(name) is None
+    off = envs.compile_factors()
+    monkeypatch.setenv(name, value)
+    assert _fresh_env_value(name) == expected
+    on = envs.compile_factors()
+    assert off[name] != on[name], (
+        f"{name} is registered but its hashed value does not follow the "
+        "environment, so an injected build and a clean build share a cache key"
