+def test_persistent_topk_medium_overflow_tie_direction(want_recent: bool) -> None:
+    """The exact restart's tie cut, in BOTH directions, analytically known.
+
+    Random float32 values essentially never tie at the k-th place, so the
+    exactness tests above never exercise the tie rule at all -- they pass
+    whichever direction it cuts. Here every element of the row carries the
+    SAME value, so:
+
+      * the coarse threshold bin holds the whole row (> 4,096) -> overflow,
+      * `#{key > pivot}` is 0 and the entire selection is the tie group,
+      * `tie_total` (seq_len) far exceeds `equal_count` (top_k), so both
+        index-radix tie rounds actually run,
+      * the cut spans several high-byte index buckets and lands mid-bucket.
+
+    Both directions are forced answers: the top_k HIGHEST indices under
+    most-recent-wins, the top_k LOWEST under oldest-wins, emitted ascending
+    either way. `torch.topk` cannot supply either expectation -- with all
+    values equal its index choice is arbitrary -- so the reference is computed
+    from the rule itself.
+
+    The direction is a launch constant resolved once per
+    process from `MERLIN_TIE_DET` / `MERLIN_TIE_RECENT`, so the arm that does
+    not match this worker's environment cannot be exercised here and skips
+    LOUDLY naming the environment that would run it. Both arms must be run,
+    in two fresh worker processes -- a green run of one arm is half the gate.
+    """
+    torch.set_default_device("cuda:0")
