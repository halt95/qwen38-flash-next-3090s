+# cudagraph captured with the injector armed returns an all -1 row on every
+# replay, with nothing re-reading the environment to notice it was unset since.
+# So they are registered and hashed on the same conservative rule, and are kept
+# in their own table because they are not switches: unset means "no injection",
+# and a default-off assertion on them would be testing the absence of a test
+# mode rather than a shipped behaviour.
+_LARGEDET_FAULT_INJECTORS = [
+    ("MERLIN_TOPK_LARGE_FAULT_INJECT", "1", "1"),
+    ("MERLIN_TOPK_LARGE_FAULT_KIND", "emit", "emit"),
+]
