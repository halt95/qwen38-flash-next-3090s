+# ------------------------------------------------------- failing controls ----
+def _any_mismatch(fn, rows) -> bool:
+    for row in rows:
+        try:
+            if fn(row).tobytes() != canonical(row).astype(np.int32).tobytes():
+                return True
+        except (IndexError, AssertionError):
+            return True
+    return False
