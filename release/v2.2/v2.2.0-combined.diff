--- /dev/null
+++ b/tests/v1/worker/gpu/ring_tag_replay.py
@@ -0,0 +1,467 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Ring-row tag fix reference-host harness: the ring-residue variants, before and after the fix.
+
+Derived from an earlier crash-replay harness.
+The decode row under test (52,934 computed,
+4 scheduled -> chunk start 2 mod 4, so its first group reads two ring rows),
+real metadata from build_qsa_metadata_triton, one process per variant (an
+illegal address is sticky and would void every later variant).
+
+It runs unchanged on BOTH trees and says which one it is on:
+  * fixed   (tag fix): rows are D+16 wide with a tag word; SITE_QSA_RING_UNCOMMITTED
+                   exists; layer_id is passed.
+  * unfixed (pre-fix kernels, an earlier commit): rows D+12, no tag.
+
+--disable-guard9 swaps _norm_rope for a clone WITHOUT the guard-9 clamp
+before the first launch (Triton resolves the callee from the kernel module's
+globals at compile time). The `guard9_probe` variant proves the swap took:
+it feeds a valid-tag row whose position is one past the cos/sin table, which
+guard 9 counts (> 0) and the clone does not (== 0).
+
+Expected outcomes (ACCEPT column of the summary):
+  variant                unfixed, guard 9 off   unfixed, guard 9 on   fixed
+  ring_realistic         clean                  clean                 clean, site 0
+  ring_uncommitted_row   FAULT (memcheck/IMA)   guard9 > 0 (masked)   request_error
+  ring_untouched_residue FAULT or silent*       guard9 >= 0*          request_error
+  ring_every_row_2/_3    silent (blind)         silent (blind)        request_error
+  guard9_probe           guard9 == 0            guard9 > 0            guard9 > 0, site 0
+* untouched residue is whatever the allocator left; the crash replay measured it
+  reaching the rope load (11 memcheck reads), but a run where it decodes in
+  range is the silent-corruption outcome, not a clean one.
+"request_error" = no fault, SITE_QSA_RING_UNCOMMITTED count > 0, its record
+names request row 0 and a historical source position, guard 9 count 0, and
+the group's compressed slot left unwritten.
+
+  python ring_tag_replay.py --self-test            # CPU, geometry only
+  python ring_tag_replay.py [--disable-guard9]     # all variants, isolated
+  compute-sanitizer --tool memcheck python ring_tag_replay.py --only X
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+
+D = 128
+HQ = 4
+CR = 4
+STATE = 8
+COMP_PAGE = 800
+NUM_BLOCKS = 317
+TABLE_WIDTH = 82
+MAX_MODEL_LEN = 262144
+MROPE = (11, 11, 10)
+LAYER = 3
+VICTIM_RING, FRESH_RING = 5, 60
+
+# (computed, scheduled) of the request under test
+SHAPES = {
+    "ring_realistic": (52934, 4),
+    "ring_uncommitted_row": (52934, 4),
+    "ring_untouched_residue": (52934, 4),
+    "ring_every_row_2": (52935, 4),
+    "ring_every_row_3": (52935, 4),
+    "guard9_probe": (52934, 4),
+}
+VARIANTS = list(SHAPES)
+
+
+def historical_positions(computed: int) -> list[int]:
+    """Ring rows the first group of a chunk starting at `computed` reads."""
+    first = computed - computed % CR
+    return list(range(first, computed))
+
+
+def self_test() -> int:
+    ok = True
+
+    def check(name, cond):
+        nonlocal ok
+        ok = ok and bool(cond)
+        print(f"  {'PASS' if cond else 'FAIL'}  {name}")
+
+    check("the decode row reads two ring rows", historical_positions(52934) == [52932, 52933])
+    check(
+        "every-row shape reads three",
+        historical_positions(52935) == [52932, 52933, 52934],
+    )
+    check("rows 4,5 for the decode row", [p % STATE for p in (52932, 52933)] == [4, 5])
+    # the crash replay's victim committed positions 100/101, i.e. rows 4/5 -- the
+    # very rows the reader picks. Here the victim sits at 96/97 (rows 0/1) so
+    # the reader's rows stay residue, which is the case being asked about.
+    check("victim rows 96,97 -> 0,1, disjoint from 4,5", [96 % 8, 97 % 8] == [0, 1])
+    check("the group ends inside the chunk", (52934 - 52934 % 4 + 3) < 52934 + 4)
+    print(f"self-test: {'PASS' if ok else 'FAIL'}")
+    return 0 if ok else 1
+
+
+def _unguarded_norm_rope():
+    """_norm_rope with the guard-9 block and clamp removed, same signature."""
+    from vllm.triton_utils import tl, triton
+
+    @triton.jit
+    def _norm_rope(
+        x,
+        pos_t,
+        pos_h,
+        pos_w,
+        cos_sin_ptr,
+        cos_sin_stride,
+        cos_sin_rows,
+        guard_ctr,
+        norm_weight_ptr,
+        eps,
+        IS_MROPE: tl.constexpr,
+        MROPE_H: tl.constexpr,
+        MROPE_W: tl.constexpr,
+    ):
+        TILE_T: tl.constexpr = x.shape[0]
+        TILE_H: tl.constexpr = x.shape[1]
+        DD: tl.constexpr = x.shape[2]
+        ROWS: tl.constexpr = TILE_T * TILE_H
+        HALF: tl.constexpr = DD // 2
+        QUARTER: tl.constexpr = DD // 4
+        pairs = tl.arange(0, QUARTER)
+        if IS_MROPE:
+            h_mask = ((pairs % 3) == 1) & (pairs <= 3 * MROPE_H)
+            w_mask = ((pairs % 3) == 2) & (pairs <= 3 * MROPE_W)
+            t_mask = ~(h_mask | w_mask)
+            base = cos_sin_ptr + pairs[None, :]
+            pos_rows = (pos_t, pos_h, pos_w)
+            axis_masks = (t_mask, h_mask, w_mask)
+            cos = tl.zeros((TILE_T, QUARTER), dtype=cos_sin_ptr.dtype.element_ty)
+            sin = tl.zeros((TILE_T, QUARTER), dtype=cos_sin_ptr.dtype.element_ty)
+            for axis in tl.static_range(3):
+                cos += tl.load(
+                    base + pos_rows[axis][:, None] * cos_sin_stride,
+                    mask=axis_masks[axis][None, :],
+                    other=0,
+                )
+                sin += tl.load(
+                    base + pos_rows[axis][:, None] * cos_sin_stride + QUARTER,
+                    mask=axis_masks[axis][None, :],
+                    other=0,
+                )
+        else:
+            cos = tl.load(
+                cos_sin_ptr + pos_t[:, None] * cos_sin_stride + pairs[None, :]
+            )
+            sin = tl.load(
+                cos_sin_ptr + pos_t[:, None] * cos_sin_stride + QUARTER + pairs[None, :]
+            )
+        cos = tl.reshape(
+            tl.broadcast_to(cos[:, None, :], (TILE_T, TILE_H, QUARTER)), (ROWS, QUARTER)
+        )
+        sin = tl.reshape(
+            tl.broadcast_to(sin[:, None, :], (TILE_T, TILE_H, QUARTER)), (ROWS, QUARTER)
+        )
+        x = tl.reshape(x, (ROWS, DD)).to(tl.float32)
+        weight = tl.load(norm_weight_ptr + tl.arange(0, DD)).to(tl.float32) + 1.0
+        rrms = tl.rsqrt(tl.sum(x * x, axis=1) / DD + eps)
+        y = (x * rrms[:, None] * weight[None, :]).to(cos.dtype)
+        rotated, passthrough = tl.split(
+            tl.permute(tl.reshape(y, (ROWS, 2, HALF)), (0, 2, 1))
+        )
+        r0, r1 = tl.split(
+            tl.permute(tl.reshape(rotated, (ROWS, 2, QUARTER)), (0, 2, 1))
+        )
+        out0 = r0 * cos - r1 * sin
+        out1 = r1 * cos + r0 * sin
+        rotated = tl.reshape(tl.permute(tl.join(out0, out1), (0, 2, 1)), (ROWS, HALF))
+        result = tl.reshape(
+            tl.permute(tl.join(rotated, passthrough), (0, 2, 1)), (ROWS, DD)
+        )
+        return tl.reshape(result, (TILE_T, TILE_H, DD))
+
+    return _norm_rope
+
+
+def run_variant(variant: str, disable_guard9: bool) -> dict:
+    import torch
+
+    from vllm.models.qwen4_exp.common import qsa_cache as qc
+    from vllm.models.qwen4_exp.nvidia.ops import qsa_pre_indexer as qpi
+    from vllm.v1.attention.backend import CommonAttentionMetadata
+    from vllm.v1.worker import guard_telemetry as gt
+
+    fixed = hasattr(gt, "SITE_QSA_RING_UNCOMMITTED")
+    width = D + (16 if fixed else 12)
+    rec: dict = {
+        "variant": variant,
+        "tree": "fixed" if fixed else "unfixed",
+        "guard9": "disabled" if disable_guard9 else "present",
+    }
+    if disable_guard9:
+        qpi._norm_rope = _unguarded_norm_rope()
+    device = torch.device("cuda:0")
+    torch.manual_seed(20260923)
+    gt.prealloc(device)
+    gt.reset_for_test()
+
+    computed, sched = SHAPES[variant]
+    seq = computed + sched
+    qsl = torch.tensor([0, sched], dtype=torch.int32)
+    ring_tab = torch.full((1, 1), VICTIM_RING, dtype=torch.int32, device=device)
+
+    def md_for(table):
+        return CommonAttentionMetadata(
+            query_start_loc=qsl.to(device),
+            query_start_loc_cpu=qsl,
+            seq_lens=torch.tensor([seq], dtype=torch.int32, device=device),
+            num_reqs=1,
+            num_actual_tokens=sched,
+            max_query_len=sched,
+            max_seq_len=seq,
+            block_table_tensor=table,
+            slot_mapping=torch.zeros(sched, dtype=torch.int64, device=device),
+        )
+
+    def bufs():
+        return [
+            torch.empty(sched, dtype=d, device=device)
+            for d in (torch.int32, torch.int64, torch.int32, torch.int64)
+        ]
+
+    _t, logical, _v, state_slots = qc.build_qsa_metadata_triton(
+        md_for(ring_tab),
+        *bufs(),
+        storage_block_size=STATE,
+        compress_ratio=1,
+        circular_buffer_size=STATE,
+        k_work_metadata_buffer=None,
+        request_capacity=None,
+    )
+    comp_tab = (
+        ((torch.arange(TABLE_WIDTH, device=device) % (NUM_BLOCKS - 1)) + 1)
+        .to(torch.int32)
+        .reshape(1, -1)
+    )
+    kwb = torch.empty(
+        max((sched + CR - 1) // CR, 1), 2, dtype=torch.int32, device=device
+    )
+    _t2, _l2, _v2, comp_slots = qc.build_qsa_metadata_triton(
+        md_for(comp_tab),
+        *bufs(),
+        storage_block_size=COMP_PAGE,
+        compress_ratio=CR,
+        circular_buffer_size=0,
+        k_work_metadata_buffer=kwb,
+        request_capacity=8,
+    )
+
+    shape = (NUM_BLOCKS, STATE, 1, width)
+    if variant == "ring_untouched_residue":
+        dirty = torch.empty(shape, dtype=torch.bfloat16, device=device)
+        dirty.normal_(mean=0.0, std=6.0e4)
+        del dirty
+        ring = torch.empty(shape, dtype=torch.bfloat16, device=device)
+    else:
+        ring = torch.zeros(shape, dtype=torch.bfloat16, device=device)
+    # 64 rows of slack past the table the kernel is told about, so the
+    # guard9_probe read one row past the end stays inside this allocation
+    cos_sin = torch.randn(
+        (MAX_MODEL_LEN + 64, D // 2), dtype=torch.bfloat16, device=device
+    )[:MAX_MODEL_LEN]
+    comp = torch.full(
+        (NUM_BLOCKS, COMP_PAGE, 1, D), 7.0, dtype=torch.bfloat16, device=device
+    )
+    ones = torch.ones(D, dtype=torch.bfloat16, device=device)
+
+    def write_row(position: int, pos_value: int | None, tag: int | None):
+        row = ring[VICTIM_RING, position % STATE, 0]
+        row[:D].normal_()
+        tail = row[D:].view(torch.int64)
+        tail[:3] = pos_value if pos_value is not None else position
+        if fixed:
+            tail[3] = position + 1 if tag is None else tag
+
+    hist = historical_positions(computed)
+    rec["historical_positions"] = hist
+    if variant == "ring_realistic":
+        for p in hist:  # this request committed them
+            write_row(p, 1234, None)
+    elif variant == "ring_uncommitted_row":
+        ring[VICTIM_RING].fill_(0.25)  # residue everywhere...
+        for p in (96, 97):  # ...but the previous occupant's
+            write_row(p, 1234, None)  # rows 0-1 (its own positions)
+    elif variant.startswith("ring_every_row"):
+        bad = hist[1] if variant.endswith("_2") else hist[2]
+        for p in hist:
+            write_row(p, 1234, None)
+        write_row(bad - STATE, 1234, None)  # same row, previous lap
+        rec["stale_position"] = bad
+    elif variant == "guard9_probe":
+        for p in hist:
+            write_row(p, MAX_MODEL_LEN, None)  # one past the table, valid tag
+
+    kw = dict(compress_ratio=CR, mrope_section=MROPE, rope_pos_offset=D)
+    if fixed:
+        kw["layer_id"] = LAYER
+    if variant == "ring_untouched_residue":
+        # the victim step commits rows 0-1 through the kernel itself
+        v_logical = torch.tensor([96, 97], dtype=torch.int64, device=device)
+        qpi.qsa_pre_indexer(
+            torch.randn((2, HQ * D), dtype=torch.bfloat16, device=device),
+            torch.randn((2, D), dtype=torch.bfloat16, device=device),
+            v_logical.unsqueeze(0).expand(3, -1).contiguous(),
+            cos_sin,
+            ones,
+            ones,
+            1e-6,
+            torch.empty((2, HQ, D), dtype=torch.bfloat16, device=device),
+            ring,
+            torch.tensor(
+                [VICTIM_RING * STATE, VICTIM_RING * STATE + 1],
+                dtype=torch.int64,
+                device=device,
+            ),
+            ring_tab,
+            torch.tensor([0, 2], dtype=torch.int32, device=device),
+            v_logical,
+            comp,
+            torch.full((2,), -1, dtype=torch.int64, device=device),
+            torch.zeros(1, 2, dtype=torch.int32, device=device),
+            **kw,
+        )
+        torch.cuda.synchronize()
+        gt.reset_for_test()
+
+    q = torch.randn((sched, HQ * D), dtype=torch.bfloat16, device=device)
+    k = torch.randn((sched, D), dtype=torch.bfloat16, device=device)
+    pos = logical.to(torch.int64).unsqueeze(0).expand(3, -1).contiguous()
+    q_out = torch.empty((sched, HQ, D), dtype=torch.bfloat16, device=device)
+    qpi.qsa_pre_indexer(
+        q,
+        k,
+        pos,
+        cos_sin,
+        ones,
+        ones,
+        1e-6,
+        q_out,
+        ring,
+        state_slots,
+        ring_tab,
+        md_for(ring_tab).query_start_loc,
+        logical,
+        comp,
+        comp_slots,
+        kwb,
+        **kw,
+    )
+    torch.cuda.synchronize()
+
+    g9 = gt.counter(gt.SITE_QSA_ROPE_POS, device).tolist()
+    rec["guard9_count"] = g9[0]
+    if fixed:
+        site = gt.counter(gt.SITE_QSA_RING_UNCOMMITTED, device).tolist()
+        rec["ring_site_count"] = site[0]
+        rec["ring_record"] = gt.decode_ring_record(site[1])
+        rec["ring_found_tag"] = gt.decode_slot(site[2])
+    first_boundary = computed - computed % CR + CR - 1
+    tok = first_boundary - computed
+    slot = int(comp_slots[tok])
+    rec["group_slot_written"] = bool(
+        (comp[slot // COMP_PAGE, slot % COMP_PAGE, 0] != 7.0).any()
+    )
+    rec["status"] = "ran"
+    return rec
+
+
+def verdict(rec: dict) -> str:
+    v, tree, g9off = rec["variant"], rec.get("tree"), rec.get("guard9") == "disabled"
+    if rec["status"] != "ran":
+        return "FAULT"
+    if tree == "fixed":
+        if v in ("ring_realistic",):
+            ok = (
+                rec["ring_site_count"] == 0
+                and rec["guard9_count"] == 0
+                and rec["group_slot_written"]
+            )
+            return "clean" if ok else "UNEXPECTED"
+        if v == "guard9_probe":
+            want = 0 if g9off else 1
+            ok = rec["ring_site_count"] == 0 and (
+                (rec["guard9_count"] > 0) == bool(want)
+            )
+            return (
+                f"guard9 {'off' if g9off else 'on'} confirmed" if ok else "UNEXPECTED"
+            )
+        r = rec.get("ring_record") or {}
+        ok = (
+            rec["ring_site_count"] > 0
+            and rec["guard9_count"] == 0
+            and not rec["group_slot_written"]
+            and r.get("request_row") == 0
+            and r.get("layer") == LAYER
+            and r.get("source_position") in rec["historical_positions"]
+        )
+        return "request_error" if ok else "UNEXPECTED"
+    # unfixed tree
+    if v == "guard9_probe":
+        ok = (rec["guard9_count"] == 0) if g9off else (rec["guard9_count"] > 0)
+        return f"guard9 {'off' if g9off else 'on'} confirmed" if ok else "UNEXPECTED"
+    if v.startswith("ring_every_row") or v == "ring_realistic":
+        return "silent" if rec["guard9_count"] == 0 else "UNEXPECTED"
+    return "masked by guard 9" if rec["guard9_count"] > 0 else "silent"
+
+
+def main(argv) -> int:
+    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    p.add_argument("--self-test", action="store_true")
+    p.add_argument("--only", default="")
+    p.add_argument("--disable-guard9", action="store_true")
+    p.add_argument(
+        "--in-process",
+        action="store_true",
+        help="run the named variant(s) here (child mode)",
+    )
+    args = p.parse_args(argv)
+    if args.self_test:
+        os.environ["CUDA_VISIBLE_DEVICES"] = ""
+        return self_test()
+    names = [n for n in args.only.split(",") if n] or VARIANTS
+    for n in names:
+        if n not in SHAPES:
+            print(f"unknown variant {n!r}; known: {', '.join(VARIANTS)}")
+            return 2
+    if args.in_process:
+        for n in names:
+            rec = run_variant(n, args.disable_guard9)
+            rec["accept"] = verdict(rec)
+            print(json.dumps(rec, sort_keys=True), flush=True)
+        return 0
+    rc = 0
+    for n in names:
+        child = [
+            sys.executable,
+            os.path.abspath(__file__),
+            "--in-process",
+            "--only",
+            n,
+        ] + (["--disable-guard9"] if args.disable_guard9 else [])
+        out = subprocess.run(child, capture_output=True, text=True)
+        lines = [ln for ln in out.stdout.splitlines() if ln.startswith("{")]
+        if out.returncode != 0 or not lines:
+            rec = {
+                "variant": n,
+                "status": "fault",
+                "accept": "FAULT",
+                "exit": out.returncode,
+                "stderr_tail": out.stderr.strip().splitlines()[-4:],
+            }
+            print(json.dumps(rec, sort_keys=True), flush=True)
+        else:
+            for ln in lines:
+                print(ln, flush=True)
+                if json.loads(ln).get("accept") == "UNEXPECTED":
+                    rc = 1
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/tests/v1/worker/gpu/test_block_table_guards.py b/tests/v1/worker/gpu/test_block_table_guards.py
new file mode 100644
index 0000000000..b4f0450dd1
--- /dev/null
+++ b/tests/v1/worker/gpu/test_block_table_guards.py
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Real launches of the three kernels no suite was launching.
+
+An early bounds-guard boot died in warmup with a Triton CompilationError in
+`_gather_block_tables_kernel` -- a branch-typing error in guard 6 that nothing
+had ever compiled. The compile check listed it as "left to the suites" and
+`tests/v1/worker/gpu/` contained no block-table test at all, so it was left to
+nobody: its first compile was the first real forward of a four-rank boot.
+
+These tests launch the real kernels. They are cheap, they are CUDA-gated, and
+their only job is that a signature or typing error in guard 6 or guard 7 costs
+seconds in the suite rather than a boot.
+"""
+
+import pytest
+import torch
+
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.worker import guard_telemetry
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+pytestmark = pytest.mark.gpu
+
+MAX_REQS = 8
+BLOCKS = 4
+BLOCK_SIZE = 16
+NUM_REQS = 4
+NUM_TOKENS = 16
+
+
+def _tables(device):
+    bt = BlockTables(
+        block_sizes=[BLOCK_SIZE],
+        max_num_reqs=MAX_REQS,
+        max_num_batched_tokens=NUM_TOKENS,
+        max_num_blocks_per_group=[BLOCKS],
+        device=device,
+        kernel_block_sizes=[BLOCK_SIZE],
+    )
+    for r in range(NUM_REQS):
+        bt.append_block_ids(r, ([1 + r],), True)
+    bt.apply_staged_writes()
+    return bt
+
+
+def test_gather_and_slot_mapping_launch_and_are_correct():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    bt = _tables(device)
+
+    idx = torch.arange(NUM_REQS, dtype=torch.int32, device=device)
+    (gathered,) = bt.gather_block_tables(idx, num_reqs_padded=NUM_REQS)
+    torch.cuda.synchronize()
+    for r in range(NUM_REQS):
+        assert int(gathered[r, 0]) == 1 + r, gathered
+
+    qsl = torch.tensor([0, 4, 8, 12, 16], dtype=torch.int32, device=device)
+    pos = torch.arange(NUM_TOKENS, dtype=torch.int64, device=device)
+    slots = bt.compute_slot_mappings(idx, qsl, pos, num_tokens_padded=NUM_TOKENS)
+    torch.cuda.synchronize()
+    assert slots.shape[-1] == NUM_TOKENS
+
+    # A legal batch must leave both counters at zero. A guard that fires here
+    # is reporting a masked fault on correct metadata, which is worse than no
+    # guard -- see the row-bound defect.
+    for site in (guard_telemetry.SITE_BT_GATHER, guard_telemetry.SITE_SLOT_MAPPING):
+        ctr = guard_telemetry.counter(site, device)
+        assert int(ctr[0].item()) == 0, guard_telemetry.snapshot()
+
+
+def test_gather_guard_fires_and_zeroes_the_row():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    bt = _tables(device)
+
+    idx = torch.arange(NUM_REQS, dtype=torch.int32, device=device)
+    idx[2] = MAX_REQS + 3  # a request row that does not exist
+    (gathered,) = bt.gather_block_tables(idx, num_reqs_padded=NUM_REQS)
+    torch.cuda.synchronize()
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_BT_GATHER, device)
+    assert int(ctr[0].item()) > 0, "the gather guard did not fire"
+    row = int(ctr[1].item()) - guard_telemetry.GUARD_BIAS
+    val = int(ctr[2].item()) - guard_telemetry.GUARD_BIAS
+    assert row == 2, f"recorded batch row {row}, expected 2"
+    assert val == MAX_REQS + 3, f"recorded req_idx {val}"
+    # and the destination row is zeroed rather than filled from a stray row
+    assert int(gathered[2].abs().sum()) == 0, gathered[2]
+    # the rows either side are untouched
+    assert int(gathered[1, 0]) == 2 and int(gathered[3, 0]) == 4
+
+
+def test_slot_mapping_guard_pads_the_bad_request():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    bt = _tables(device)
+
+    idx = torch.arange(NUM_REQS, dtype=torch.int32, device=device)
+    idx[1] = -1  # the freed-slot sentinel
+    qsl = torch.tensor([0, 4, 8, 12, 16], dtype=torch.int32, device=device)
+    pos = torch.arange(NUM_TOKENS, dtype=torch.int64, device=device)
+    slots = bt.compute_slot_mappings(idx, qsl, pos, num_tokens_padded=NUM_TOKENS)
+    torch.cuda.synchronize()
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_SLOT_MAPPING, device)
+    assert int(ctr[0].item()) > 0, "the slot-mapping guard did not fire"
+    # request 1 owns tokens 4..7 and they must all be PAD_ID
+    assert torch.equal(
+        slots[0, 4:8],
+        torch.full((4,), PAD_SLOT_ID, dtype=slots.dtype, device=device),
+    ), slots[0, :12]
diff --git a/tests/v1/worker/gpu/test_guard_reader_nonblocking.py b/tests/v1/worker/gpu/test_guard_reader_nonblocking.py
new file mode 100644
index 0000000000..4fc79957bf
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_reader_nonblocking.py
@@ -0,0 +1,158 @@
+# SPDX-License-Identifier: Apache-2.0
+"""v2 reader fix: the instrumentation readers must never wait on
+the compute stream.
+
+The earlier cadence reader did a synchronous pageable ``tolist()`` from its thread;
+the driver held the CUDA context lock while that copy waited for the stream,
+and a pending PLE pull-transport wait on the stream (whose producer needs the
+same lock) deadlocked the worker. These tests park a kernel on the current
+(compute) stream and require a reader tick to return while it is still running.
+On the pre-fix reader the first GPU test blocks for the kernel's duration.
+"""
+
+import threading
+import time
+
+import pytest
+import torch
+
+from vllm.v1.worker import guard_telemetry
+
+SLEEP_CYCLES = (
+    4_000_000_000  # ~2 s on a 3090 (torch.cuda._sleep spins for this many cycles)
+)
+
+
+def test_cpu_tensor_reads_directly():
+    r = guard_telemetry.NonBlockingReader()
+    t = torch.tensor([[1, 2, 3]], dtype=torch.int64)
+    r.register("cpu", t)
+    assert r.poll_one("cpu") == [[1, 2, 3]]
+    t[0, 0] = 7
+    assert r.poll()["cpu"] == [[7, 2, 3]]
+
+
+def test_register_refuses_to_run_inside_a_capture(monkeypatch):
+    """Creating the side stream inside a cudagraph capture is
+    not capture-safe."""
+    r = guard_telemetry.NonBlockingReader()
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: True)
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required for the cuda-tensor branch")
+    t = torch.zeros(2, dtype=torch.int64, device="cuda")
+    with pytest.raises(RuntimeError, match="during cudagraph capture"):
+        r.register("x", t)
+
+
+def test_report_waits_for_the_confirming_tick_cpu():
+    """A count rise seen in copy k is reported from copy k+1
+    (maxima current by then)."""
+    device = torch.device("cpu")
+    guard_telemetry.reset_for_test()
+    guard_telemetry.counter(0, device)  # allocates the cpu buffer
+    full = guard_telemetry._buffers[device]
+    site = guard_telemetry.SITE_MAMBA_COPY
+    full[site, 0] = 2  # count written, maxima not yet
+    guard_telemetry._poll_once()  # rise seen -> pending, nothing reported
+    assert guard_telemetry._seen.get((device, site), 0) == 0
+    full[site, 1] = 9 + guard_telemetry.GUARD_BIAS  # maxima land before the next tick
+    guard_telemetry._poll_once()  # confirming tick reports count 2 with row 9
+    assert guard_telemetry._seen.get((device, site), 0) == 2
+    snap = guard_telemetry.snapshot()
+    key = f"{device}:{guard_telemetry.SITE_NAMES[site]}"
+    assert snap[key][:2] == [2, 9]
+    guard_telemetry.reset_for_test()
+
+
+def test_module_reader_is_the_non_blocking_kind():
+    assert isinstance(guard_telemetry._nb_reader, guard_telemetry.NonBlockingReader)
+    with open(guard_telemetry.__file__, encoding="utf-8") as fh:
+        src = fh.read()
+    body = src[src.index("def _poll_once") : src.index("def _arm(")]
+    assert ".tolist()" not in body.replace("host.tolist()", ""), (
+        "the cadence reader must not read the device buffer synchronously"
+    )
+    assert "poll_one(" in body
+
+
+@pytest.mark.gpu
+def test_reader_tick_returns_while_the_compute_stream_is_busy():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    torch.cuda.synchronize(device)
+    # prime: one poll starts the first copy (nothing to report yet)
+    guard_telemetry._poll_once()
+    torch.cuda.synchronize(device)
+
+    # Park a long kernel on the compute (current) stream, then tick the reader.
+    torch.cuda._sleep(SLEEP_CYCLES)
+    t0 = time.monotonic()
+    guard_telemetry._poll_once()
+    tick = time.monotonic() - t0
+    # Prove the stream really was busy: the sync must take a while.
+    t1 = time.monotonic()
+    torch.cuda.synchronize(device)
+    busy = time.monotonic() - t1
+    # The tick assertion comes first: a blocking reader spends the whole
+    # sleep inside the tick and would then make the busy control read ~0
+    # (negative control).
+    assert tick < 0.25, (
+        f"reader tick took {tick:.3f}s while the compute stream was busy: "
+        f"it waited on the stream (reader/compute-stream deadlock)"
+    )
+    assert tick + busy > 0.5, (
+        f"control failed: the parked kernel finished in {tick + busy:.3f}s, "
+        f"the test cannot discriminate"
+    )
+
+
+@pytest.mark.gpu
+def test_reader_tick_from_a_thread_returns_while_the_compute_stream_is_busy():
+    """The production shape: the tick runs on the reader thread while the
+    main thread owns the stream."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    guard_telemetry._poll_once()
+    torch.cuda.synchronize(device)
+    torch.cuda._sleep(SLEEP_CYCLES)
+    done = threading.Event()
+    elapsed = {}
+
+    def tick():
+        t0 = time.monotonic()
+        guard_telemetry._poll_once()
+        elapsed["tick"] = time.monotonic() - t0
+        done.set()
+
+    threading.Thread(target=tick, name="test-guard-reader", daemon=True).start()
+    finished = done.wait(timeout=1.0)
+    torch.cuda.synchronize(device)
+    assert finished, (
+        "the reader tick did not return within 1 s while the compute stream "
+        "was busy (reader/compute-stream deadlock)"
+    )
+    assert elapsed["tick"] < 0.25
+
+
+@pytest.mark.gpu
+def test_hits_written_before_a_stall_are_still_reported():
+    """Non-blocking must not mean lossy: a count written on the compute
+    stream is reported once the copy lands."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    buf = guard_telemetry._buffers[device]
+    site = guard_telemetry.SITE_MAMBA_COPY
+    buf[site, 0] += 3  # a "masked access" count, written on the compute stream
+    buf[site, 1] = 5 + guard_telemetry.GUARD_BIAS
+    torch.cuda._sleep(SLEEP_CYCLES // 4)
+    torch.cuda.synchronize(device)
+    # copy -> rise seen -> confirming copy -> report: four ticks at most
+    for _ in range(4):
+        guard_telemetry._poll_once()
+    assert guard_telemetry._seen.get((device, site), 0) == 3
+    snap = guard_telemetry.snapshot()
+    key = f"{device}:{guard_telemetry.SITE_NAMES[site]}"
+    assert snap[key][0] == 3 and snap[key][1] == 5
diff --git a/tests/v1/worker/gpu/test_guard_telemetry_defaults_drain.py b/tests/v1/worker/gpu/test_guard_telemetry_defaults_drain.py
new file mode 100644
index 0000000000..606292e2aa
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_telemetry_defaults_drain.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounds-guard instrumentation: release defaults, reader loss and the final drain.
+
+1. Release defaults are off / 0.05 with both variables absent (earlier
+   builds defaulted to warn), and a
+   non-finite or non-positive interval is rejected at import.
+2. A reader that loses a device arms the stop (the fatal-site contract is
+   otherwise silently void).
+3. drain() reports a hit the cadence reader never saw and raises for an
+   always-fatal site when asked; it is what a stage end / orderly shutdown
+   calls so a last-step hit cannot be lost.
+"""
+
+import importlib
+import sys
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.gpu
+
+
+def _fresh(monkeypatch, **env):
+    for k in ("VLLM_E2_GUARD_MODE", "VLLM_E2_GUARD_INTERVAL"):
+        monkeypatch.delenv(k, raising=False)
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+    sys.modules.pop("vllm.v1.worker.guard_telemetry", None)
+    return importlib.import_module("vllm.v1.worker.guard_telemetry")
+
+
+def test_release_defaults_with_env_absent(monkeypatch):
+    gt = _fresh(monkeypatch)
+    assert gt._MODE == "off"  # v2: default off
+    assert pytest.approx(0.05) == gt._INTERVAL
+
+
+@pytest.mark.parametrize("bad", ["nan", "inf", "-inf", "0", "-1", "abc"])
+def test_bad_interval_rejected_at_import(monkeypatch, bad):
+    with pytest.raises(ValueError):
+        _fresh(monkeypatch, VLLM_E2_GUARD_INTERVAL=bad)
+
+
+def test_reader_loss_arms_the_stop(monkeypatch):
+    gt = _fresh(
+        monkeypatch, VLLM_E2_GUARD_MODE="warn"
+    )  # the reader exists only when opted in (default off)
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt.reset_for_test()
+
+    # v2: the cadence reader no longer reads the device buffer itself; it
+    # polls the NonBlockingReader. Inject the read failure there.
+    def broken_poll(key):
+        raise RuntimeError("simulated D2H failure")
+
+    monkeypatch.setattr(gt._nb_reader, "poll_one", broken_poll)
+    gt._poll_once()
+    assert device in gt._read_disabled
+    with pytest.raises(RuntimeError, match="fatal-site contract"):
+        gt.check_pending()
+
+
+def test_drain_reports_last_step_hit_and_raises_for_fatal_site(monkeypatch):
+    gt = _fresh(
+        monkeypatch, VLLM_E2_GUARD_MODE="warn"
+    )  # warn mode (opt-in): a plain site must NOT raise
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt.reset_for_test()
+    buf = gt._buffers[device]
+    # a hit at a non-fatal site, written as the kernels would (count, row, val)
+    plain = next(s for s in gt.SITE_NAMES if s not in gt._ALWAYS_FATAL_SITES)
+    buf[plain, 0] = 3
+    snap = gt.drain(raise_on_fatal=True)
+    assert any(v[0] == 3 for v in snap.values())
+    gt.check_pending()  # nothing armed under warn for a plain site
+    # a hit at the always-fatal RoPE site: drain must raise when asked
+    buf[gt.SITE_QSA_ROPE_POS, 0] = 1
+    with pytest.raises(RuntimeError, match="FINAL DRAIN"):
+        gt.drain(raise_on_fatal=True)
+    # and the non-raising form still arms the stop for the engine thread
+    gt.reset_for_test()
+    buf[gt.SITE_QSA_ROPE_POS, 0] = 1
+    gt.drain()
+    with pytest.raises(RuntimeError):
+        gt.check_pending()
+
+
+def test_drain_is_silent_under_off(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="off")
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt._buffers[device][gt.SITE_QSA_ROPE_POS, 0] = 1
+    assert gt.drain(raise_on_fatal=True) == {}
diff --git a/tests/v1/worker/gpu/test_guard_telemetry_limits.py b/tests/v1/worker/gpu/test_guard_telemetry_limits.py
new file mode 100644
index 0000000000..09d2865196
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_telemetry_limits.py
@@ -0,0 +1,334 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Guard telemetry: the documented limits, pinned by test rather than by change.
+
+Three limits of the bounds-guard telemetry are documented rather than fixed in code.
+This module pins the ones that are testable offline. The coverage table and the
+reader/producer stream-ordering argument that go with them are design notes not
+shipped with this tree.
+The three limits:
+
+  * Independent maxima, remaining half -- the (row, value) fields are INDEPENDENT
+    lifetime maxima. The labelling half shipped earlier (the WARNING no
+    longer calls them an "example"); what was missing is a worked example
+    proving the reported pair can be a pair that never occurred. That is
+    ``test_the_reported_pair_can_be_one_that_never_occurred``.
+  * Encoding limits -- the int64 bias encoding loses or falsifies extreme values.
+    Closed by test, not by change: the encoding is correct for every value a
+    correct kernel can produce, and the tests below pin exactly where it stops
+    being able to carry one, plus the fact that the COUNT always survives.
+  * Zero hits -- "zero hits implies no output bit changed" is false in
+    general. See ``test_zero_hits_is_not_bitwise_equivalence`` below; it is a
+    documentation test, and it says so.
+
+No GPU: nothing here allocates a counter buffer or launches a kernel. The
+producer arithmetic is exercised through ``encode_slot``, which is the same
+expression the Triton bodies inline, and the consumer through the real
+``_report_rows``.
+"""
+
+import logging
+
+import pytest
+import torch
+
+from vllm.v1.worker import guard_telemetry as gt
+
+_CPU = torch.device("cpu")
+
+
+@pytest.fixture(autouse=True)
+def _clean_high_water_marks():
+    """``_report_rows`` only reports a count ABOVE what it last saw.
+
+    A test that leaves ``_seen`` behind makes the NEXT test silently measure
+    nothing -- the trap the module's own comment on ``_seen`` describes.
+    """
+    gt.reset_for_test()
+    yield
+    gt.reset_for_test()
+
+
+class _Collector(logging.Handler):
+    def __init__(self) -> None:
+        super().__init__(level=logging.WARNING)
+        self.messages: list[str] = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        self.messages.append(record.getMessage())
+
+
+@pytest.fixture
+def warnings_from_the_reader():
+    """Capture the reader's WARNINGs off the real logger object.
+
+    Not ``caplog``: vLLM's root "vllm" logger is configured with
+    ``propagate: False``, so records never reach the handler pytest installs
+    on the ROOT logger and the capture would be empty. Attaching to the
+    module's own logger is the only capture that cannot quietly see nothing
+    (a capture that can see nothing measures nothing).
+    """
+    target = getattr(gt.logger, "logger", gt.logger)
+    handler = _Collector()
+    previous_level = target.level
+    target.addHandler(handler)
+    target.setLevel(logging.WARNING)
+    try:
+        yield handler.messages
+    finally:
+        target.removeHandler(handler)
+        target.setLevel(previous_level)
+
+
+# ---------------------------------------------------------------------------
+# Encoding limits -- int64 encoding of extreme values
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "value",
+    [0, 1, -1, 42, -42, (1 << 31) - 1, -((1 << 31) - 1), 1 << 40],
+)
+def test_ordinary_values_round_trip(value: int) -> None:
+    """Every value a correct kernel can produce survives the encoding.
+
+    A row or index is an int32-range quantity, so this covers the whole domain
+    the guards actually record. The cases below are about metadata that is
+    already corrupt -- which is precisely when a guard fires.
+    """
+    assert gt.decode_slot(gt.encode_slot(value)) == value
+
+
+def test_int32_min_is_falsified_as_nothing_recorded() -> None:
+    """The one value the encoding cannot distinguish from an unwritten slot.
+
+    ``-GUARD_BIAS`` encodes to exactly 0, and 0 is the zeroed-buffer sentinel
+    for "this slot was never written". So a guard that masks an access at row
+    INT32_MIN reports its ROW as absent.
+    """
+    assert gt.encode_slot(-gt.GUARD_BIAS) == 0
+    assert gt.decode_slot(0) is None
+
+
+def test_values_below_int32_min_are_lost_by_atomic_max() -> None:
+    """Below ``-GUARD_BIAS`` the encoded word is negative.
+
+    The slot is only ever written with ``tl.atomic_max`` into a buffer zeroed
+    at allocation, and 0 > any negative, so the store is a no-op and the slot
+    still reads 0. Modelled here as ``max(0, encoded)`` because that is
+    exactly what the atomic does; there is no Triton in this test.
+    """
+    for value in (-gt.GUARD_BIAS - 1, -(1 << 40), -(1 << 62)):
+        encoded = gt.encode_slot(value)
+        assert encoded < 0, value
+        assert gt.decode_slot(max(0, encoded)) is None, value
+
+
+def test_the_encodable_window_is_where_the_constants_say_it_is() -> None:
+    """Pin the published bounds so a later change to GUARD_BIAS moves them."""
+    assert gt.decode_slot(gt.encode_slot(gt.GUARD_MIN_ENCODABLE)) == (
+        gt.GUARD_MIN_ENCODABLE
+    )
+    assert gt.decode_slot(gt.encode_slot(gt.GUARD_MAX_ENCODABLE)) == (
+        gt.GUARD_MAX_ENCODABLE
+    )
+    # One step below the window is the falsified case, not a round trip.
+    assert gt.encode_slot(gt.GUARD_MIN_ENCODABLE - 1) == 0
+    # One step above it does not fit in the int64 slot at all.
+    assert gt.encode_slot(gt.GUARD_MAX_ENCODABLE + 1) > (1 << 63) - 1
+
+
+def test_the_count_survives_an_unencodable_value_and_the_report_says_so(
+    warnings_from_the_reader: list[str],
+) -> None:
+    """The operational half of the encoding limits.
+
+    ``n_masked`` carries no bias and is written with ``atomic_add``, so it
+    advances whatever the offending value was. A report of "3 masked accesses,
+    row None, index None" is therefore a report of three REAL masked faults --
+    not a report of nothing. Before this change the message said only "row-field
+    None", which reads as "nothing recorded" to anyone who has not read the
+    encoding.
+
+    What the message must NOT do is diagnose WHY the field is None. The reader
+    has no ordering dependency on the producer, so an unobserved maximum and an
+    unencodable one read identically; the first draft of this clause claimed
+    "unencodable" outright and was wrong to.
+    """
+    rows = [[0, 0, 0] for _ in range(gt.NUM_SITES)]
+    rows[gt.SITE_MAMBA_COPY] = [3, 0, 0]  # count 3, both maxima unencodable
+
+    gt._report_rows(_CPU, rows)
+
+    assert len(warnings_from_the_reader) == 1, warnings_from_the_reader
+    text = warnings_from_the_reader[0]
+    assert "masked 3 out-of-range access(es)" in text
+    assert "row-field None" in text
+    assert "UNOBSERVED OR UNENCODABLE, not absent" in text
+    # It must not claim to know which of the two it is.
+    assert "no ordering dependency on the producer" in text
+
+
+# ---------------------------------------------------------------------------
+# Independent maxima -- the fields are independent; the worked example
+# ---------------------------------------------------------------------------
+
+
+def test_the_reported_pair_can_be_one_that_never_occurred(
+    warnings_from_the_reader: list[str],
+) -> None:
+    """THE EXAMPLE PAIR.
+
+    Two masked accesses at one site, in this order:
+
+      hit A: row 3, offending index 100
+      hit B: row 7, offending index 5
+
+    Each slot independently keeps its lifetime maximum, so the slots end at
+    row 7 and index 100 and the reader reports the pair **(7, 100)** -- a
+    combination that never happened on the device. Row 7's access was at
+    index 5; index 100's access was at row 3.
+
+    This is why the WARNING labels them independent lifetime maxima and why no
+    attribution may be built on the pair: to chase a single access you need
+    the count plus a repro, not this triple. Anyone wanting a coherent
+    (row, value) sample needs the other half -- a capture that writes
+    both slots under one atomic decision -- which this tree does NOT implement.
+    """
+    slots = [0, 0, 0]
+    for row, value in ((3, 100), (7, 5)):
+        slots[0] += 1
+        slots[1] = max(slots[1], gt.encode_slot(row))
+        slots[2] = max(slots[2], gt.encode_slot(value))
+
+    assert gt.decode_slot(slots[1]) == 7
+    assert gt.decode_slot(slots[2]) == 100
+    assert (7, 100) not in {(3, 100), (7, 5)}
+
+    rows = [[0, 0, 0] for _ in range(gt.NUM_SITES)]
+    rows[gt.SITE_GDN_DECODE_STATE] = slots
+
+    gt._report_rows(_CPU, rows)
+
+    assert len(warnings_from_the_reader) == 1, warnings_from_the_reader
+    text = warnings_from_the_reader[0]
+    assert "row-field 7, index-field 100" in text
+    assert "independent lifetime maxima, not one observed pair" in text
+    # ...and no suffix about unobservable fields: both decoded fine.
+    assert "UNOBSERVED OR UNENCODABLE" not in text
+
+
+# ---------------------------------------------------------------------------
+# Zero hits is not bitwise equivalence
+# ---------------------------------------------------------------------------
+
+
+def test_zero_hits_is_not_bitwise_equivalence() -> None:
+    """A DOCUMENTATION TEST. It asserts the guard set's shape, not a behaviour.
+
+    The tempting claim is "zero guard hits implies no output bit
+    changed". It holds only for live, valid inputs, and there are two ways out
+    of it that a counter at zero cannot exclude:
+
+    1. **The guards are bounds checks.** Every site in ``SITE_NAMES`` masks an
+       OUT-OF-RANGE access and counts it. A wrong-but-in-range row is not an
+       out-of-range access, so it is invisible here by construction -- stated
+       for the mamba copy site in the guard design notes ("Blind to: a column or row that
+       is in range but wrong -- the common case for a recycled slot,
+       producing a silent wrong state copy"). That is the whole of the
+       vllm#55506 / llama.cpp#29092 class, which is why it needed its own
+       instrument (``test_mamba_slot_ownership``) rather than a counter.
+
+    2. **``NULL_BLOCK_ID`` rows change bytes uncounted.** Block id 0 is the
+       pool's placeholder (``core/block_pool.py:188-191``,
+       ``v1/attention/backends/utils.py:46``), which no request owns. The
+       copy guard's ``<= 0`` branch is DELIBERATELY not counted -- the guard design notes:
+       "Also blind to the ``<= 0`` path, deliberately: NULL_BLOCK_ID is 0 and
+       is the ordinary unallocated marker". Where such a row is zero-filled
+       rather than skipped, inactive bytes are written and no counter moves.
+       Those bytes belong to no live request, so no OUTPUT bit changes -- but
+       "zero hits" is evidence about live rows only, and a claim of bitwise
+       equivalence has to be made about the output tensor, not inferred from
+       the counters.
+
+    So a v2.2 result may say "no guard fired", never "no output bit changed"
+    (measure the property, not the proxy). The check below is that the
+    guard set is still a bounds-check set of the size this argument was
+    written against; if a site is added, this argument is re-read.
+    """
+    assert gt.NUM_SITES == 12
+    assert set(gt.SITE_NAMES) == set(range(gt.NUM_SITES))
+    # The one non-bounds site, which is telemetry and not a masked fault.
+    assert "SKIPPED" in gt.SITE_NAMES[gt.SITE_QSA_RING_SKIP]
+    # Re-read for the ring-row tag fix (site 11): the one CONTENT check. It sees an in-range
+    # but wrong ring row only when the row's tag is wrong (never committed for
+    # that position); a row committed for the right position with the wrong
+    # speculative candidate's key still passes. So point 1 above stands for
+    # every other site and narrows, not vanishes, for this one.
+    assert "UNCOMMITTED" in gt.SITE_NAMES[gt.SITE_QSA_RING_UNCOMMITTED]
+
+
+# ---------------------------------------------------------------------------
+# The diagnostic gates are registered knobs
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        (None, "off"),
+        ("", "off"),  # `VAR=` is how scripts and fixtures clear a variable
+        ("   ", "off"),
+        ("off", "off"),
+        ("1", "warn"),  # continuity with the earlier boolean gates
+        ("warn", "warn"),
+        ("RAISE", "raise"),
+        (" Warn ", "warn"),
+    ],
+)
+def test_e2_diagnostic_gates_normalize_identically(
+    monkeypatch: pytest.MonkeyPatch, raw: str | None, expected: str
+) -> None:
+    """One normalizer for the whole family, so the registry cannot lie.
+
+    Both PLE diagnostic gates are registered in ``vllm.envs`` and read from there by the
+    modules that act on them. If a module re-parsed the variable itself, the
+    value ``vllm.envs`` reports (and hashes, and logs) could differ from the
+    value the check applies.
+    """
+    import vllm.envs as envs
+
+    for name in ("VLLM_E2_PLE_FLAG_CHECK", "VLLM_E2_MAMBA_SLOT_OWNERSHIP"):
+        monkeypatch.delenv(name, raising=False)
+        if raw is not None:
+            monkeypatch.setenv(name, raw)
+        assert envs.environment_variables[name]() == expected, (name, raw)
+
+
+def test_a_set_but_unrecognised_gate_is_a_boot_error(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Fail closed: a broken gate must not silently disarm its instrument."""
+    import vllm.envs as envs
+
+    monkeypatch.setenv("VLLM_E2_MAMBA_SLOT_OWNERSHIP", "yes")
+    with pytest.raises(ValueError, match="off|warn|raise"):
+        envs.environment_variables["VLLM_E2_MAMBA_SLOT_OWNERSHIP"]()
+
+
+def test_the_host_side_gates_are_not_compile_factors() -> None:
+    """They gate host Python outside any capture and add no graph node.
+
+    Hashing them would invalidate every compile cache the moment a diagnostic
+    boot is taken -- which is precisely when the cache is wanted. If either
+    ever grows a device-side component this test should fail and be revisited,
+    not deleted.
+    """
+    import vllm.envs as envs
+
+    monkeypatch_free = envs.compile_factors()
+    assert "VLLM_E2_PLE_FLAG_CHECK" not in monkeypatch_free
+    assert "VLLM_E2_MAMBA_SLOT_OWNERSHIP" not in monkeypatch_free
+    # ...but they ARE registered, so `vllm.envs` can report them.
+    assert "VLLM_E2_PLE_FLAG_CHECK" in envs.environment_variables
+    assert "VLLM_E2_MAMBA_SLOT_OWNERSHIP" in envs.environment_variables
