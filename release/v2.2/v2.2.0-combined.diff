+# SPDX-License-Identifier: Apache-2.0
+"""v2 ring-skip telemetry: the ring-skip telemetry site of the QSA pre-indexer.
+
+The suffix-commit loop stores one ring row per retained token, every store
+masked by ``valid_slot``. A live token whose state slot is < 0 or beyond the
+ring capacity is therefore NOT written and nothing said so (one candidate cause
+for the raw-key ring crash class). This site counts those tokens into
+``SITE_QSA_RING_SKIP``; the write stays skipped. These tests prove the wiring
+(CPU) and that the count moves for exactly the skipped tokens (GPU).
+
+Helpers mirror tests/v1/worker/gpu/test_qsa_rope_position_guard.py on purpose:
+the two files must stay independently runnable.
+"""
+
+import inspect
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.nvidia.ops import qsa_pre_indexer as qpi
+from vllm.v1.worker import guard_telemetry
+
+COMPRESS_RATIO = 4
+HEAD_DIM = 128
+N_HEADS = 4
+STATE_SIZE = 8  # ring capacity
+ROW_WIDTH = 144  # head dim + the int64 tail (pos_t, pos_h, pos_w, tag)
+MAX_MODEL_LEN = 4096
+NUM_BLOCKS = 8
+RING_CAPACITY = NUM_BLOCKS * STATE_SIZE
+
+
+class _Recorder:
+    """Stands in for the Triton kernel and keeps the launch arguments."""
+
+    def __init__(self):
+        self.launches = []
+
+    def __getitem__(self, grid):
+        def launch(*args, **kwargs):
+            self.launches.append((grid, args, kwargs))
+
+        return launch
+
+
+def _inputs(device, num_tokens=4):
+    q = torch.randn(num_tokens, N_HEADS * HEAD_DIM, dtype=torch.bfloat16, device=device)
+    k = torch.randn(num_tokens, HEAD_DIM, dtype=torch.bfloat16, device=device)
+    positions = (
+        torch.arange(num_tokens, dtype=torch.int64, device=device)
+        .unsqueeze(0)
+        .expand(3, -1)
+        .contiguous()
+    )
+    cos_sin = torch.randn(
+        MAX_MODEL_LEN, HEAD_DIM // 2, dtype=torch.bfloat16, device=device
+    )
+    ones = torch.ones(HEAD_DIM, dtype=torch.bfloat16, device=device)
+    q_out = torch.empty(
+        num_tokens, N_HEADS, HEAD_DIM, dtype=torch.bfloat16, device=device
+    )
+    state_cache = torch.zeros(
+        NUM_BLOCKS, STATE_SIZE, 1, ROW_WIDTH, dtype=torch.bfloat16, device=device
+    )
+    state_slots = torch.arange(num_tokens, dtype=torch.int32, device=device)
+    state_table = torch.zeros(1, 1, dtype=torch.int32, device=device)
+    qsl = torch.tensor([0, num_tokens], dtype=torch.int32, device=device)
+    logical = torch.arange(num_tokens, dtype=torch.int32, device=device)
+    comp_cache = torch.zeros(
+        NUM_BLOCKS, 800, 1, HEAD_DIM, dtype=torch.bfloat16, device=device
+    )
+    comp_slots = torch.zeros(num_tokens, dtype=torch.int32, device=device)
+    kwb = torch.zeros(
+        max(num_tokens // COMPRESS_RATIO, 1), 2, dtype=torch.int32, device=device
+    )
+    return dict(
+        q=q,
+        k=k,
+        positions=positions,
+        cos_sin_cache=cos_sin,
+        q_norm_weight=ones,
+        k_norm_weight=ones,
+        eps=1e-6,
+        q_out=q_out,
+        state_cache=state_cache,
+        state_slots=state_slots,
+        state_block_table=state_table,
+        query_start_loc=qsl,
+        logical_positions=logical,
+        compressed_cache=comp_cache,
+        compressed_slots=comp_slots,
+        k_work_metadata=kwb,
+    )
+
+
+def _launch(kw):
+    qpi.qsa_pre_indexer(
+        kw["q"],
+        kw["k"],
+        kw["positions"],
+        kw["cos_sin_cache"],
+        kw["q_norm_weight"],
+        kw["k_norm_weight"],
+        kw["eps"],
+        kw["q_out"],
+        kw["state_cache"],
+        kw["state_slots"],
+        kw["state_block_table"],
+        kw["query_start_loc"],
+        kw["logical_positions"],
+        kw["compressed_cache"],
+        kw["compressed_slots"],
+        kw["k_work_metadata"],
+        compress_ratio=COMPRESS_RATIO,
+        mrope_section=(11, 11, 10),
+        rope_pos_offset=HEAD_DIM,
+    )
+
+
+def test_site_is_declared_named_and_not_fatal():
+    """A site that exists but is unnamed reports as a bare integer; a site
+    that is fatal would abort a boot on the older behaviour it merely
+    observes. Both are the wrong instrument."""
+    site = guard_telemetry.SITE_QSA_RING_SKIP
+    assert site == 10 and guard_telemetry.NUM_SITES == 12  # the ring-row tag fix added site 11
+    assert site in guard_telemetry.SITE_NAMES
+    assert "SKIPPED" in guard_telemetry.SITE_NAMES[site]
+    assert site not in guard_telemetry._ALWAYS_FATAL_SITES
+    # the counter store is sized by NUM_SITES: the new site must have a row
+    ctr = guard_telemetry.counter(site, torch.device("cpu"))
+    assert ctr.dtype == torch.int64 and ctr.numel() == guard_telemetry.SLOTS_PER_SITE
+
+
+def test_launcher_passes_the_ring_skip_counter(monkeypatch):
+    """The kernel parameter must be the persistent SITE_QSA_RING_SKIP buffer
+    and must differ from the two counters the kernel already takes (the
+    rope-guard series shipped a declared-but-never-written site once; the
+    inverted assertion below is the same defence)."""
+    device = torch.device("cpu")
+    sig = inspect.signature(qpi._qsa_pre_indexer_kernel.fn)
+    assert "ring_skip_ctr" in sig.parameters
+    rec = _Recorder()
+    monkeypatch.setattr(qpi, "_qsa_pre_indexer_kernel", rec)
+    _launch(_inputs(device))
+
+    assert len(rec.launches) == 1
+    _grid, args, kwargs = rec.launches[0]
+    kwargs = {
+        k: v
+        for k, v in kwargs.items()
+        if k not in ("num_warps", "num_stages", "num_ctas", "grid")
+    }
+    bound = sig.bind(*args, **kwargs)
+    bound.apply_defaults()
+    skip_ctr = bound.arguments["ring_skip_ctr"]
+    assert skip_ctr.dtype == torch.int64 and skip_ctr.numel() == 3
+    assert (
+        skip_ctr.data_ptr()
+        == guard_telemetry.counter(
+            guard_telemetry.SITE_QSA_RING_SKIP, device
+        ).data_ptr()
+    )
+    for other in ("rope_guard_ctr", "guard_ctr"):
+        assert bound.arguments[other].data_ptr() != skip_ctr.data_ptr()
+
+
+@pytest.mark.gpu
+def test_negative_control_valid_slots_count_zero():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    kw = _inputs(device)
+    _launch(kw)
+    torch.cuda.synchronize()
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_QSA_RING_SKIP, device)
+    assert ctr.tolist() == [0, 0, 0]
+    # and the commit happened: every token's raw key and position tail, and
+    # the tag word = logical position + 1
+    for t in range(kw["k"].shape[0]):
+        row = kw["state_cache"][0, t, 0, :]
+        assert torch.equal(row[:HEAD_DIM], kw["k"][t])
+        tail = row[HEAD_DIM : HEAD_DIM + 16].contiguous().view(torch.int64)
+        assert tail.tolist() == [t, t, t, t + 1]
+
+
+@pytest.mark.gpu
+@pytest.mark.parametrize(
+    "bad_index,bad_slot",
+    [(2, -1), (1, RING_CAPACITY), (3, RING_CAPACITY + 5)],
+    ids=["negative-slot", "at-capacity", "past-capacity"],
+)
+def test_positive_control_one_skipped_token_is_counted_and_located(bad_index, bad_slot):
+    """Exactly the skipped token is counted; slot 1 names the token, slot 2
+    carries the offending state slot value; the other rows are still written
+    and the bad token's row is not."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    kw = _inputs(device)
+    kw["state_slots"][bad_index] = bad_slot
+    _launch(kw)
+    torch.cuda.synchronize()
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_QSA_RING_SKIP, device)
+    n, row, val = ctr.tolist()
+    assert n == 1, f"expected one skipped token, counter says {n}"
+    assert row - guard_telemetry.GUARD_BIAS == bad_index
+    assert val - guard_telemetry.GUARD_BIAS == bad_slot
+    # neighbours committed (key AND int64 position tail), the bad token's
+    # own ring row untouched over its WHOLE width -- the crash class lives
+    # in the tail, so a key-only check would miss a stray tail write.
+    for t in range(kw["k"].shape[0]):
+        row = kw["state_cache"][0, t, 0, :]
+        if t == bad_index:
+            assert torch.count_nonzero(row) == 0, "skipped row was written"
+        else:
+            assert torch.equal(row[:HEAD_DIM], kw["k"][t])
+            tail = row[HEAD_DIM : HEAD_DIM + 12].contiguous().view(torch.int64)
+            assert tail.tolist() == [t, t, t]
+
+
+@pytest.mark.gpu
+def test_positive_control_two_skipped_tokens_accumulate():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    kw = _inputs(device)
+    kw["state_slots"][0] = -1
+    kw["state_slots"][3] = RING_CAPACITY + 1
+    _launch(kw)
+    torch.cuda.synchronize()
+    n, row, val = guard_telemetry.counter(
+        guard_telemetry.SITE_QSA_RING_SKIP, device
+    ).tolist()
+    assert n == 2
+    assert row - guard_telemetry.GUARD_BIAS == 3  # max token index
+    assert val - guard_telemetry.GUARD_BIAS == RING_CAPACITY + 1  # max slot value
diff --git a/tests/v1/worker/gpu/test_qsa_ring_tags_gpu.py b/tests/v1/worker/gpu/test_qsa_ring_tags_gpu.py
new file mode 100644
index 0000000000..8987e52fac
--- /dev/null
+++ b/tests/v1/worker/gpu/test_qsa_ring_tags_gpu.py
@@ -0,0 +1,311 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""v2.2 ring-row tag fix, kernel half (GPU): the pre-indexer's ring-row tag contract.
+
+Writer: every committed ring row gets tag = logical_position + 1 in word 3 of
+its int64 tail. Reader: every HISTORICAL source row of a pooled group must
+carry exactly source_position + 1; otherwise the group's pooled load, its RoPE
+tail read and its compressed-slot store are masked and SITE_QSA_RING_UNCOMMITTED
+records one coherent first-offender record (layer, request row, source position
++ the tag found there).
+
+Each positive case is paired with its clean twin in the same test (same batch,
+history committed correctly) that must count 0 and write the slot -- a counter
+that reads the same in both worlds measures nothing.
+
+FAILING CONTROL: on the unmodified tree (an earlier commit) the module fails at
+collection (QSA_RING_TAIL_ELEMENTS / QSA_RING_TAG_WORD do not exist). Were the
+constants shimmed, the old launcher also has no ``layer_id`` (TypeError), no
+tag writer (the writer test reads tag 0) and no reader check (the every-row
+test counts nothing and writes the slot).
+"""
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.common.qsa_cache import (
+    QSA_RING_TAG_WORD,
+    QSA_RING_TAIL_ELEMENTS,
+)
+from vllm.v1.worker import guard_telemetry as gt
+
+pytestmark = pytest.mark.gpu
+
+CR = 4
+D = 128
+HQ = 4
+STATE = 8
+WIDTH = D + QSA_RING_TAIL_ELEMENTS
+NUM_BLOCKS = 8
+COMP_PAGE = 800
+MAX_POS = 4096
+LAYER = 7
+SENTINEL = 7.0
+MROPE = (11, 11, 10)
+
+
+def _device():
+    return torch.device("cuda", torch.cuda.current_device())
+
+
+def _pos3(position: int) -> list[int]:
+    # distinct, in-range MRoPE coordinates per position
+    return [position, position // 7 + 3, position // 13 + 11]
+
+
+class _Batch:
+    """Requests (ring block, chunk_start, query_len) as one decode/prefill batch."""
+
+    def __init__(self, requests, device):
+        self.device = device
+        self.requests = requests
+        logical, slots, comp, qsl, work = [], [], [], [0], []
+        comp_next = 0
+        self.group_slot: dict[tuple[int, int], int] = {}
+        for r, (block, start, qlen) in enumerate(requests):
+            for i in range(qlen):
+                p = start + i
+                logical.append(p)
+                slots.append(block * STATE + p % STATE if i >= qlen - STATE else -1)
+                if (p + 1) % CR == 0:
+                    comp.append(comp_next)
+                    self.group_slot[(r, p)] = comp_next
+                    comp_next += 1
+                else:
+                    comp.append(-1)
+            qsl.append(qsl[-1] + qlen)
+            groups = (start + qlen) // CR - start // CR
+            work += [[r, w] for w in range(max(groups, 1))]
+        T = len(logical)
+        self.T = T
+        self.logical = torch.tensor(logical, dtype=torch.int64, device=device)
+        self.positions = (
+            torch.tensor([_pos3(p) for p in logical], dtype=torch.int64)
+            .t()
+            .contiguous()
+            .to(device)
+        )
+        self.state_slots = torch.tensor(slots, dtype=torch.int64, device=device)
+        self.comp_slots = torch.tensor(comp, dtype=torch.int64, device=device)
+        self.qsl = torch.tensor(qsl, dtype=torch.int32, device=device)
+        self.state_table = torch.tensor(
+            [[b] for b, _s, _q in requests], dtype=torch.int32, device=device
+        )
+        self.work = torch.tensor(work, dtype=torch.int32, device=device)
+        g = torch.Generator(device="cpu").manual_seed(1234)
+        self.q = torch.randn(T, HQ * D, generator=g).to(device, torch.bfloat16)
+        self.k = torch.randn(T, D, generator=g).to(device, torch.bfloat16)
+        self.cos_sin = torch.randn(MAX_POS, D // 2, generator=g).to(
+            device, torch.bfloat16
+        )
+        self.ring = torch.zeros(
+            NUM_BLOCKS, STATE, 1, WIDTH, dtype=torch.bfloat16, device=device
+        )
+        self.comp = torch.full(
+            (NUM_BLOCKS, COMP_PAGE, 1, D), SENTINEL, dtype=torch.bfloat16, device=device
+        )
+        self.q_out = torch.empty(T, HQ, D, dtype=torch.bfloat16, device=device)
+
+    def commit(self, block: int, position: int, *, tag: int | None = None):
+        """What a correct earlier step of this request leaves in the ring."""
+        row = self.ring[block, position % STATE, 0]
+        g = torch.Generator(device="cpu").manual_seed(position)
+        row[:D] = torch.randn(D, generator=g).to(self.device, torch.bfloat16)
+        tail = row[D:].view(torch.int64)
+        tail[:3] = torch.tensor(_pos3(position), device=self.device)
+        tail[QSA_RING_TAG_WORD] = position + 1 if tag is None else tag
+
+    def tag(self, block: int, row: int) -> int:
+        return int(self.ring[block, row, 0, D:].view(torch.int64)[QSA_RING_TAG_WORD])
+
+    def run(self, *, rope=True):
+        from vllm.models.qwen4_exp.nvidia.ops.qsa_pre_indexer import qsa_pre_indexer
+
+        qsa_pre_indexer(
+            self.q,
+            self.k,
+            self.positions if rope else self.logical,
+            self.cos_sin,
+            torch.ones(D, dtype=torch.bfloat16, device=self.device),
+            torch.ones(D, dtype=torch.bfloat16, device=self.device),
+            1e-6,
+            self.q_out,
+            self.ring,
+            self.state_slots,
+            self.state_table,
+            self.qsl,
+            self.logical,
+            self.comp,
+            self.comp_slots,
+            self.work,
+            compress_ratio=CR,
+            mrope_section=MROPE if rope else None,
+            rope_pos_offset=D if rope else None,
+            layer_id=LAYER,
+        )
+        torch.cuda.synchronize()
+
+    def slot_written(self, request: int, end_position: int) -> bool:
+        slot = self.group_slot[(request, end_position)]
+        row = self.comp[slot // COMP_PAGE, slot % COMP_PAGE, 0]
+        return not bool(torch.all(row == SENTINEL))
+
+
+def _site():
+    return gt.counter(gt.SITE_QSA_RING_UNCOMMITTED, _device()).tolist()
+
+
+def _rope_site():
+    return gt.counter(gt.SITE_QSA_ROPE_POS, _device()).tolist()
+
+
+@pytest.fixture(autouse=True)
+def _fresh_counters():
+    gt.prealloc(_device())
+    gt.reset_for_test()
+    yield
+    gt.reset_for_test()
+
+
+# --------------------------------------------------------------------------
+# writer
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("rope", [True, False], ids=["mrope", "text"])
+@pytest.mark.parametrize("qlen", [3, 6, 13], ids=["no-group", "short", "long"])
+def test_writer_tags_every_committed_row(rope, qlen):
+    b = _Batch([(2, 40, qlen)], _device())
+    b.run(rope=rope)
+    committed = list(range(40 + max(qlen - STATE, 0), 40 + qlen))
+    for p in committed:
+        assert b.tag(2, p % STATE) == p + 1, f"row for position {p}"
+        if rope:
+            tail = b.ring[2, p % STATE, 0, D:].view(torch.int64)
+            assert tail[:3].tolist() == _pos3(p)
+    untouched = set(range(STATE)) - {p % STATE for p in committed}
+    for row in untouched:
+        assert b.tag(2, row) == 0
+    assert _site() == [0, 0, 0]
+
+
+# --------------------------------------------------------------------------
+# reader: the every-row control and its clean twin
+# --------------------------------------------------------------------------
+
+
+def _three_historical_rows(device):
+    # chunk start 1003 = 3 mod 4: the first group is 1000..1003 and 1000,
+    # 1001, 1002 all come from the ring
+    b = _Batch([(3, 1003, 4)], device)
+    for p in (1000, 1001, 1002):
+        b.commit(3, p)
+    return b
+
+
+def test_clean_twin_counts_zero_and_writes_the_slot():
+    b = _three_historical_rows(_device())
+    b.run()
+    assert _site() == [0, 0, 0]
+    assert b.slot_written(0, 1003)
+    assert _rope_site()[0] == 0
+
+
+@pytest.mark.parametrize("bad", [1001, 1002], ids=["row2", "row3"])
+def test_only_the_second_or_third_row_stale_is_flagged(bad):
+    """First row valid; ONE later row holds an in-range stale position and key
+    from the previous lap of the ring (it was committed for bad - 8). Guard 9
+    cannot see it (the position is in range) and neither could a first-row
+    check. The group must not be pooled and its slot must stay unwritten."""
+    b = _three_historical_rows(_device())
+    b.commit(3, bad - STATE)  # overwrites the row with the previous lap
+    assert b.tag(3, bad % STATE) == bad - STATE + 1
+    b.run()
+    n, rec, found = _site()
+    assert n == 1
+    assert gt.decode_ring_record(rec) == {
+        "layer": LAYER,
+        "request_row": 0,
+        "source_position": bad,
+    }
+    assert gt.decode_slot(found) == bad - STATE + 1
+    assert not b.slot_written(0, 1003)
+    assert _rope_site()[0] == 0  # guard 9 blind, as argued
+    # the Q path is independent of the ring and still ran
+    assert torch.isfinite(b.q_out.float()).all()
+
+
+@pytest.mark.parametrize(
+    "residue",
+    ["bf16-filler", "cleared", "negative"],
+)
+def test_uncommitted_history_is_flagged_not_faulted(residue):
+    """The production ring-residue shape: the rows the reader needs were never committed
+    by this request (allocator residue / a claimed block after the tag clear /
+    a negative int64). Before the ring-row tag fix the filler case decoded to position
+    ~0x3E803E803E803E80 and faulted in _norm_rope (guard 9 disabled) or was
+    clamped and counted (guard 9)."""
+    b = _Batch([(5, 52934 % 1024, 4)], _device())  # chunk start 2 mod 4
+    start = 52934 % 1024
+    first = start - start % CR
+    if residue == "bf16-filler":
+        b.ring[5].fill_(0.25)
+    elif residue == "negative":
+        b.ring[5].view(torch.int16).fill_(-1)
+    # "cleared": zeros, which is what the claim clear leaves
+    b.run()
+    n, rec, found = _site()
+    assert n == start - first  # both historical rows
+    assert gt.decode_ring_record(rec)["source_position"] == first
+    expect_found = {
+        "bf16-filler": 0x3E803E803E803E80,
+        "cleared": 0,
+        "negative": -1,
+    }[residue]
+    assert gt.decode_slot(found) == expect_found
+    assert not b.slot_written(0, first + CR - 1)
+    assert _rope_site()[0] == 0  # the garbage tail was never read
+
+
+def test_missing_ring_block_is_flagged():
+    """A historical row with no ring block at all (state table entry -1):
+    before the ring-row tag fix the load was masked and the group silently pooled zeros."""
+    b = _Batch([(1, 1002, 4)], _device())
+    b.state_table.fill_(-1)
+    b.run()
+    n, rec, found = _site()
+    assert n == 2
+    assert gt.decode_ring_record(rec)["source_position"] == 1000
+    assert gt.decode_slot(found) == 0
+    assert not b.slot_written(0, 1003)
+
+
+def test_one_poisoned_request_leaves_its_neighbour_intact():
+    """Containment inside the launch: only the poisoned request's group is
+    masked; the clean request's group is pooled and stored as normal."""
+    b = _Batch([(2, 1002, 4), (4, 2002, 4)], _device())
+    b.commit(2, 1000)
+    b.commit(2, 1001)
+    b.ring[4].fill_(0.25)  # request 1's history was never committed
+    b.run()
+    n, rec, _found = _site()
+    assert n == 2
+    assert gt.decode_ring_record(rec)["request_row"] == 1
+    assert b.slot_written(0, 1003)
+    assert not b.slot_written(1, 2003)
+
+
+def test_first_offender_wins_and_the_count_takes_all():
+    """Two poisoned requests: the count covers every flagged row, the record
+    is ONE of them whole (never request A's row with request B's tag)."""
+    b = _Batch([(2, 1002, 4), (4, 2003, 4)], _device())
+    b.ring[2].fill_(0.25)
+    b.commit(4, 2000)
+    b.commit(4, 2001, tag=7)  # stale: committed for another position
+    b.commit(4, 2002)
+    b.run()
+    n, rec, found = _site()
+    assert n == 3  # 2 rows of request 0 + 1 row of request 1
+    record = gt.decode_ring_record(rec)
+    pair = (record["request_row"], record["source_position"], gt.decode_slot(found))
+    assert pair in {(0, 1000, 0x3E803E803E803E80), (1, 2001, 7)}
diff --git a/tests/v1/worker/gpu/test_qsa_rope_position_guard.py b/tests/v1/worker/gpu/test_qsa_rope_position_guard.py
new file mode 100644
index 0000000000..037a20f408
--- /dev/null
+++ b/tests/v1/worker/gpu/test_qsa_rope_position_guard.py
@@ -0,0 +1,367 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Bounds guard 9: the RoPE position must be bounded before it is an address.
+
+An earlier crash-replay harness drove the QSA pre-indexer
+over a re-claimed raw-key ring block and compute-sanitizer reported eleven
+`Invalid __global__ read of size 2 bytes` at `_norm_rope`, roughly 4.6e18 bytes
+out of range. The chain: the cross-chunk pooled group takes its RoPE position
+from the ring row itself (`qsa_pre_indexer.py:305-317`), the ring is excluded
+from zeroing, and `_norm_rope` turns that value straight into a row index into
+the cos/sin table. The masks in `_norm_rope` bound the rotary PAIR, never the
+row.
+
+Two tests, because they answer different questions:
+
+* the CPU one checks the PLUMBING -- that the bound handed to the kernel is the
+  cos/sin table's real row count. A guard with the wrong bound is worse than no
+  guard, and this is the failure mode a CPU suite can actually catch;
+* the GPU one is the POSITIVE CONTROL, and it is the crash-replay case verbatim: fill
+  a re-claimed ring row with bf16 filler, run the kernel, and require that it
+  survives AND that the counter says it masked something. Before this guard the
+  same input produced an illegal address.
+"""
+
+import inspect
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.nvidia.ops import qsa_pre_indexer as qpi
+from vllm.v1.worker import guard_telemetry
+
+COMPRESS_RATIO = 4
+HEAD_DIM = 128
+N_HEADS = 4
+STATE_SIZE = 8  # ring capacity
+ROW_WIDTH = 144  # head dim + the int64 tail (pos_t, pos_h, pos_w, tag)
+MAX_MODEL_LEN = 4096
+NUM_BLOCKS = 8
+
+
+class _Recorder:
+    """Stands in for the Triton kernel and keeps the launch arguments."""
+
+    def __init__(self):
+        self.launches = []
+
+    def __getitem__(self, grid):
+        def launch(*args, **kwargs):
+            self.launches.append((grid, args, kwargs))
+
+        return launch
+
+
+def _inputs(device, num_tokens=4):
+    q = torch.randn(num_tokens, N_HEADS * HEAD_DIM, dtype=torch.bfloat16, device=device)
+    k = torch.randn(num_tokens, HEAD_DIM, dtype=torch.bfloat16, device=device)
+    positions = (
+        torch.arange(num_tokens, dtype=torch.int64, device=device)
+        .unsqueeze(0)
+        .expand(3, -1)
+        .contiguous()
+    )
+    cos_sin = torch.randn(
+        MAX_MODEL_LEN, HEAD_DIM // 2, dtype=torch.bfloat16, device=device
+    )
+    ones = torch.ones(HEAD_DIM, dtype=torch.bfloat16, device=device)
+    q_out = torch.empty(
+        num_tokens, N_HEADS, HEAD_DIM, dtype=torch.bfloat16, device=device
+    )
+    state_cache = torch.zeros(
+        NUM_BLOCKS, STATE_SIZE, 1, ROW_WIDTH, dtype=torch.bfloat16, device=device
+    )
+    state_slots = torch.arange(num_tokens, dtype=torch.int32, device=device)
+    state_table = torch.zeros(1, 1, dtype=torch.int32, device=device)
+    qsl = torch.tensor([0, num_tokens], dtype=torch.int32, device=device)
+    logical = torch.arange(num_tokens, dtype=torch.int32, device=device)
+    comp_cache = torch.zeros(
+        NUM_BLOCKS, 800, 1, HEAD_DIM, dtype=torch.bfloat16, device=device
+    )
+    comp_slots = torch.zeros(num_tokens, dtype=torch.int32, device=device)
+    kwb = torch.zeros(
+        max(num_tokens // COMPRESS_RATIO, 1), 2, dtype=torch.int32, device=device
+    )
+    return dict(
+        q=q,
+        k=k,
+        positions=positions,
+        cos_sin_cache=cos_sin,
+        q_norm_weight=ones,
+        k_norm_weight=ones,
+        eps=1e-6,
+        q_out=q_out,
+        state_cache=state_cache,
+        state_slots=state_slots,
+        state_block_table=state_table,
+        query_start_loc=qsl,
+        logical_positions=logical,
+        compressed_cache=comp_cache,
+        compressed_slots=comp_slots,
+        k_work_metadata=kwb,
+    )
+
+
+def test_launcher_passes_the_real_cos_sin_row_count(monkeypatch):
+    """The bound must be the table's row count, not a constant or a stride.
+
+    A bound that is too large lets the very reads this guard exists to stop
+    through; one that is too small makes the guard fire on correct metadata,
+    which is worse than not having it.
+    """
+    device = torch.device("cpu")
+    # grab the real signature BEFORE the kernel is replaced
+    sig = inspect.signature(qpi._qsa_pre_indexer_kernel.fn)
+    rec = _Recorder()
+    monkeypatch.setattr(qpi, "_qsa_pre_indexer_kernel", rec)
+    kw = _inputs(device)
+    qpi.qsa_pre_indexer(
+        kw.pop("q"),
+        kw.pop("k"),
+        kw.pop("positions"),
+        kw.pop("cos_sin_cache"),
+        kw.pop("q_norm_weight"),
+        kw.pop("k_norm_weight"),
+        kw.pop("eps"),
+        kw.pop("q_out"),
+        kw.pop("state_cache"),
+        kw.pop("state_slots"),
+        kw.pop("state_block_table"),
+        kw.pop("query_start_loc"),
+        kw.pop("logical_positions"),
+        kw.pop("compressed_cache"),
+        kw.pop("compressed_slots"),
+        kw.pop("k_work_metadata"),
+        compress_ratio=COMPRESS_RATIO,
+        mrope_section=(11, 11, 10),
+        rope_pos_offset=HEAD_DIM,
+    )
+
+    assert len(rec.launches) == 1
+    _grid, args, kwargs = rec.launches[0]
+    # Triton launch options are not kernel parameters.
+    kwargs = {
+        k: v
+        for k, v in kwargs.items()
+        if k not in ("num_warps", "num_stages", "num_ctas", "grid")
+    }
+    bound = sig.bind(*args, **kwargs)
+    bound.apply_defaults()
+    assert bound.arguments["cos_sin_rows"] == MAX_MODEL_LEN
+
+    # The rope guard gets its OWN site. A later revision threaded the
+    # pre-indexer's guard_ctr into _norm_rope, so SITE_QSA_ROPE_POS was declared, named
+    # and never written -- it would have read 0 for the life of every run and
+    # been reported as "the rope chain is clean", which is the exact misreading
+    # this series exists to prevent. An earlier version of this test asserted
+    # the wrong pointer and was green BECAUSE the wiring was wrong, so the
+    # assertion is inverted here on purpose: the two counters must DIFFER.
+    rope_ctr = bound.arguments["rope_guard_ctr"]
+    req_ctr = bound.arguments["guard_ctr"]
+    for ctr in (rope_ctr, req_ctr):
+        assert ctr.dtype == torch.int64 and ctr.numel() == 3
+    assert (
+        rope_ctr.data_ptr()
+        == guard_telemetry.counter(guard_telemetry.SITE_QSA_ROPE_POS, device).data_ptr()
+    )
+    assert (
+        req_ctr.data_ptr()
+        == guard_telemetry.counter(
+            guard_telemetry.SITE_QSA_PRE_INDEXER, device
+        ).data_ptr()
+    )
+    assert rope_ctr.data_ptr() != req_ctr.data_ptr()
+
+
+def test_rope_site_aborts_the_stage_even_in_warn_mode():
+    """A clamped rope position is durable damage, not a local wrong answer.
+
+    On the pooled path the wrongly-rotated key is STORED into the compressed
+    cache, so every later step reads it and the ring row that produced it is
+    still there to do it again. warn is the right default for a guard whose
+    masked value dies with the step; it is the wrong default for this one.
+    """
+    assert guard_telemetry.SITE_QSA_ROPE_POS in guard_telemetry._ALWAYS_FATAL_SITES
+
+
+@pytest.mark.gpu
+def test_ring_filler_bytes_are_masked_and_counted():
+    """Positive control: the ring-residue crash case, verbatim.
+
+    A re-claimed ring row filled with bf16 0.25 decodes, at the int64 position
+    tail, to roughly 0x3E803E803E803E80. Before guard 9 that value reached
+    cos_sin_ptr + pos * stride and compute-sanitizer reported an invalid read
+    4.6e18 bytes out of range. After it, the launch must complete and the
+    counter must be non-zero.
+
+    A silent counter here means the guard is not on the path -- the same class
+    of failure as a positive control that does not fire, and the reason this
+    test asserts the count rather than only the survival.
+    """
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+
+    kw = _inputs(device)
+    # The victim's bytes: the whole row, tail included. Nothing zeroes the ring.
+    kw["state_cache"][0].fill_(0.25)
+
+    # Drive the CROSS-CHUNK read-back, and prove the drive rather than assume
+    # it. The pooled group reads its position from the ring only when its first
+    # token lies in the PREVIOUS chunk, and the kernel decides that with
+    # (qsa_pre_indexer.py:299-311):
+    #
+    #   chunk_end      = logical[query_end - 1]
+    #   chunk_start    = chunk_end - query_len + 1
+    #   first_boundary = ((chunk_start + CR) // CR) * CR - 1
+    #   first_position = first_boundary - (CR - 1)
+    #   first_in_chunk = first_position >= chunk_start
+    #
+    # A COMPRESS_RATIO-ALIGNED chunk start gives first_position == chunk_start,
+    # i.e. IN chunk, i.e. the ring is never read. An earlier run of this control
+    # with a start of 4 and counted 0, which said nothing about the guard. The
+    # start must be unaligned: 6 gives first_position 4 < chunk_start 6.
+    start = 6
+    assert start % COMPRESS_RATIO != 0, "an aligned chunk start never crosses"
+    kw["logical_positions"] = torch.arange(
+        start,
+        start + kw["logical_positions"].numel(),
+        dtype=kw["logical_positions"].dtype,
+        device=device,
+    )
+    chunk_end = start + kw["logical_positions"].numel() - 1
+    chunk_start = chunk_end - kw["logical_positions"].numel() + 1
+    first_boundary = (
+        (chunk_start + COMPRESS_RATIO) // COMPRESS_RATIO
+    ) * COMPRESS_RATIO - 1
+    first_position = first_boundary - (COMPRESS_RATIO - 1)
+    assert first_position < chunk_start, (
+        f"first_position {first_position} >= chunk_start {chunk_start}: this "
+        f"input does NOT take the ring read-back, so a zero count below would "
+        f"be meaningless"
+    )
+    # ...and the row the reader picks must be one carrying the filler.
+    assert 0 <= (first_position % STATE_SIZE) < STATE_SIZE
+    # Guard 9 is now the SECOND net. A row whose tag does not name its
+    # logical position is rejected before its tail is read, so the filler
+    # would never reach _norm_rope and this control would count 0. Give the
+    # historical rows VALID tags (bad coordinates with valid tags) so the
+    # garbage position tail is what reaches the guard.
+    for position in range(first_position, chunk_start):
+        tail = kw["state_cache"][0, position % STATE_SIZE, 0, HEAD_DIM:]
+        tail.view(torch.int64)[3] = position + 1
+
+    kw["k_work_metadata"][:, 0] = 0
+    kw["k_work_metadata"][:, 1] = 0
+
+    qpi.qsa_pre_indexer(
+        kw["q"],
+        kw["k"],
+        kw["positions"],
+        kw["cos_sin_cache"],
+        kw["q_norm_weight"],
+        kw["k_norm_weight"],
+        kw["eps"],
+        kw["q_out"],
+        kw["state_cache"],
+        kw["state_slots"],
+        kw["state_block_table"],
+        kw["query_start_loc"],
+        kw["logical_positions"],
+        kw["compressed_cache"],
+        kw["compressed_slots"],
+        kw["k_work_metadata"],
+        compress_ratio=COMPRESS_RATIO,
+        mrope_section=(11, 11, 10),
+        rope_pos_offset=HEAD_DIM,
+    )
+    torch.cuda.synchronize()  # the pre-guard build faults here
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_QSA_ROPE_POS, device)
+    n_masked = int(ctr[0].item())
+    assert n_masked > 0, (
+        "the rope-position guard did not fire on the ring filler-bytes case. "
+        "Either the guard is not on this path or the case no longer drives the "
+        "ring read-back -- check before reading any zero counter as clean."
+    )
+    worst = int(ctr[1].item()) - guard_telemetry.GUARD_BIAS
+    assert worst >= MAX_MODEL_LEN or worst < 0, (
+        f"guard fired but recorded an in-range position {worst}"
+    )
+    # the tags were valid, so the ring-tag site must not have claimed this one
+    ring = guard_telemetry.counter(guard_telemetry.SITE_QSA_RING_UNCOMMITTED, device)
+    assert int(ring[0].item()) == 0
+
+
+@pytest.mark.gpu
+@pytest.mark.parametrize("axis,axis_id", [("t", 0), ("h", 1), ("w", 2)])
+@pytest.mark.parametrize("sign", ["mixed", "negative_only"])
+def test_a_single_bad_axis_is_caught_and_named(axis, axis_id, sign):
+    """Any ONE of t/h/w is enough, and the record must name which.
+
+    Under the production mrope section (11, 11, 10) all three components are
+    live row indices -- the IS_MROPE branch masks COLUMNS per axis while the
+    row comes unmasked from pos_rows[axis] -- so a bad pos_w faults exactly as
+    a bad pos_t does. An earlier revision recorded pos_t unconditionally, which for this
+    case would have reported an in-range value next to a non-zero count and
+    sent the reader to the wrong axis.
+
+    The negative case also pins the filler: an all-negative offender must not
+    max to 0 and read back as position 0.
+    """
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+
+    kw = _inputs(device)
+    row = {"t": 0, "h": 1, "w": 2}[axis]
+    kw["positions"] = kw["positions"].clone()
+    if sign == "mixed":
+        kw["positions"][row, 0] = MAX_MODEL_LEN + 7  # out of range, positive
+        kw["positions"][row, 1] = -5  # out of range, negative
+        expected_worst = MAX_MODEL_LEN + 7
+    else:
+        # NEGATIVE ONLY. Every offender below zero is the case
+        # the tl.where filler decides: with a 0 filler the max would be the
+        # filler itself and slot 1 would read back as position 0 -- an
+        # in-range-looking value next to a non-zero count, which is the negative-value defect
+        # wearing a different hat. -5 must survive to the record.
+        kw["positions"][row, 0] = -5
+        kw["positions"][row, 1] = -9
+        expected_worst = -5
+
+    from vllm.models.qwen4_exp.nvidia.ops.qsa_pre_indexer import qsa_pre_indexer
+
+    qsa_pre_indexer(
+        kw["q"],
+        kw["k"],
+        kw["positions"],
+        kw["cos_sin_cache"],
+        kw["q_norm_weight"],
+        kw["k_norm_weight"],
+        kw["eps"],
+        kw["q_out"],
+        kw["state_cache"],
+        kw["state_slots"],
+        kw["state_block_table"],
+        kw["query_start_loc"],
+        kw["logical_positions"],
+        kw["compressed_cache"],
+        kw["compressed_slots"],
+        kw["k_work_metadata"],
+        compress_ratio=COMPRESS_RATIO,
+        mrope_section=(11, 11, 10),
+        rope_pos_offset=HEAD_DIM,
+    )
+    torch.cuda.synchronize()
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_QSA_ROPE_POS, device)
+    assert int(ctr[0].item()) > 0, f"a bad pos_{axis} was not caught"
+    worst = int(ctr[1].item()) - guard_telemetry.GUARD_BIAS
+    got_axis = int(ctr[2].item()) - guard_telemetry.GUARD_BIAS
+    assert worst == expected_worst, (
+        f"recorded {worst}, expected the offending value {expected_worst}"
+    )
+    assert got_axis == axis_id, (
+        f"recorded axis {got_axis}, expected {axis_id} (pos_{axis})"
+    )
