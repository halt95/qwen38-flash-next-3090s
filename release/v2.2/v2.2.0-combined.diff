+class _TeardownSignalGuard:
+    """EngineCore teardown: defer ONE late SIGTERM/SIGINT, bounded.
+
+    Dying on the first late signal would SIGKILL every worker
+    (PR_SET_PDEATHSIG) before its shutdown drain; see the finally block of
+    EngineCoreProc.run_engine_core. The deferral is bounded two ways:
+      - a SECOND late signal restores the default disposition and re-delivers
+        itself, so the process dies of it (the maintainer's escalation);
+      - after the first deferred signal a watchdog ends the process with
+        exit code 1 if teardown is still running _TEARDOWN_SIGNAL_BOUND_S later.
+    """
+
+    def __init__(self, bound_s: float | None = None) -> None:
+        self.bound_s = _TEARDOWN_SIGNAL_BOUND_S if bound_s is None else bound_s
+        self.deferred = 0
+        self._done = threading.Event()
+        self._watchdog: threading.Thread | None = None
+
+    def __call__(self, signum, frame) -> None:
+        name = signal.Signals(signum).name
+        if self._done.is_set():
+            return
+        self.deferred += 1
+        if self.deferred == 1:
+            logger.warning(
+                "[shutdown] EngineCore: %s during resource teardown deferred; "
+                "workers finish their shutdown (FINAL DRAIN) first (a second "
+                "signal, or %.0f s of teardown, ends the process)",
+                name,
+                self.bound_s,
+            )
+            self._watchdog = threading.Thread(
+                target=self._expire,
+                daemon=True,
+                name="EngineCoreTeardownWatchdog",
+            )
+            self._watchdog.start()
+            return
+        # Default disposition first, so a third signal also ends the process
+        # while the (bounded) diagnostic line is written.
+        signal.signal(signum, signal.SIG_DFL)
+        _log_bounded(
+            lambda: logger.warning(
+                "[shutdown] EngineCore: second late signal (%s) during "
+                "resource teardown; not deferring again",
+                name,
+            ),
+            _TEARDOWN_EXIT_LOG_BOUND_S,
+        )
+        os.kill(os.getpid(), signum)
+
+    def _expire(self) -> None:
+        if self._done.wait(self.bound_s):
+            return
+
+        def emit() -> None:
+            logger.error(
+                "[shutdown] EngineCore: resource teardown still running %.0f s "
+                "after a deferred signal; exiting (code 1)",
+                self.bound_s,
+            )
+            for stream in (sys.stdout, sys.stderr):
+                with suppress(Exception):
+                    stream.flush()
+
+        _log_bounded(emit, _TEARDOWN_EXIT_LOG_BOUND_S)
+        os._exit(1)
+
+    def disarm(self) -> None:
+        self._done.set()
+
