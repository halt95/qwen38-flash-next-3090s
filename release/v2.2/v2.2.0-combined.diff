+    # large-path block at 4-7 and the two switch flags at 8-9. Asserting the
+    # first five dict keys against the medium-path names is what fails on any build
+    # carrying the large-path block, so assert the whole layout instead.
+    assert list(counters) == [
+        "rows",
+        "overflow",
+        "fallbacks",
+        "faults",
+        "rows_large",
+        "ties_cut",
+        "ties_dropped",
+        "faults_large",
+        "switch",
+        "switch_large",
+        "decode_overflow",
