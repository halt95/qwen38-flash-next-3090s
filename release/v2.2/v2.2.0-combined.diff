+def _make_pool_with_cached_blocks(num_blocks: int, block_size: int = 16):
+    """Build a BlockPool holding `num_blocks` allocated, hashed blocks.
+
+    Returns (pool, blocks_by_id). Each block gets a distinct hash so it is a
+    prefix-cache eviction candidate once freed (blocks without a hash are
+    always evicted first and would mask ordering).
+    """
+    pool = BlockPool(
+        num_gpu_blocks=num_blocks + 1, enable_caching=True, hash_block_size=block_size
+    )
+    blocks = pool.get_new_blocks(num_blocks)
+    for i, block in enumerate(blocks):
+        block.set_block_hash(
+            BlockHashWithGroupId(f"hash{i}".encode()), num_tokens=block_size
+        )
+    return pool, {b.block_id: b for b in blocks}
+
+
+def _eviction_order(pool: BlockPool) -> list[int]:
+    """Drain the pool's free queue, returning block ids in eviction order
+    (first returned == evicted first)."""
+    order = []
+    while pool.get_num_free_blocks() > 0:
+        order.append(pool.get_new_blocks(1)[0].block_id)
+    return order
+
+
+def _seed_request_blocks(manager, request_id: str, blocks_per_group: int):
+    """Give every group's single-type manager a real, hashed block list.
+
+    Blocks come from the manager's own pool and are hashed so that
+    ``BlockPool.free_blocks`` routes them down the cached branch, which appends
+    to the back of the free queue in the order it is handed -- that order IS
+    the eviction order. Unhashed blocks are *prepended* instead and would mask
+    what is being measured.
+
+    Returns the per-group block ids in allocation order.
+    """
+    pool = manager.block_pool
+    allocated: list[list[int]] = []
+    for group_id, group_mgr in enumerate(manager.coordinator.single_type_managers):
+        blocks = pool.get_new_blocks(blocks_per_group)
+        for i, block in enumerate(blocks):
+            block.set_block_hash(
+                BlockHashWithGroupId(f"g{group_id}b{i}".encode()),
+                num_tokens=pool.hash_block_size,
+            )
+        group_mgr.req_to_blocks[request_id] = blocks
+        allocated.append([b.block_id for b in blocks])
+    return allocated
+
+
+def _free_through_scheduler(manager, request, defer: bool, ours: set[int]) -> list[int]:
+    """Free ``request`` through the real scheduler helper, one way or the other.
+
+    ``defer=False`` takes ``_free_request_blocks``'s immediate branch
+    (``KVCacheManager.free`` -> ``KVCacheCoordinator.free`` -> one reversed
+    ``free_blocks`` per group). ``defer=True`` takes the deferred branch
+    (``pop_blocks_for_free`` -> ``deferred_frees`` -> ``_drain_deferred_frees``).
+    Both are the production methods; only the gate differs.
+    """
+    scheduler = _create_deferring_scheduler()
+    scheduler.kv_cache_manager = manager
+    scheduler.defer_block_free = defer
+    scheduler.processed_step_seq = 0
+    scheduler.sched_step_seq = 1
+    request.last_sched_seq = 1
+
+    scheduler._free_request_blocks(request)
+    if defer:
+        assert scheduler.deferred_frees, (
+            "last_sched_seq > processed_step_seq must take the deferred branch; "
+            "if it did not, this arm is not testing the deferred path"
+        )
+        scheduler.processed_step_seq = 1
+        scheduler._drain_deferred_frees()
+        assert not scheduler.deferred_frees
+    else:
+        assert not scheduler.deferred_frees
+
+    # The pool also holds blocks this request never owned; they are unhashed,
+    # so `free_blocks` never touched them and they sit ahead of ours in the
+    # queue. Filter to the request's own blocks, whose relative order is
+    # exactly what was handed to `free_blocks`.
+    return [bid for bid in _eviction_order(manager.block_pool) if bid in ours]
+
+
+def test_deferred_free_matches_immediate_free_eviction_order():
+    """Regression for the deferred-free path collapsing per-group eviction
+    order for multi-group (hybrid) KV caches.
+
+    Drives BOTH arms through the production code -- ``Scheduler.
+    _free_request_blocks`` over a real two-group ``KVCacheManager``, its real
+    ``KVCacheCoordinator``, the real ``deferred_frees`` deque and the real
+    ``_drain_deferred_frees`` -- and compares the resulting eviction order.
+    Constructing the two orders by hand and calling ``BlockPool.free_blocks``
+    directly would leave every production statement unexercised, so reverting
+    the patch would not fail the test.
+
+    The immediate path frees each group in its own reversed ``free_blocks``
+    call (``SingleTypeKVCacheManager.free``). The deferred path pops all groups
+    into ONE concatenated list and drains it in a single ``free_blocks`` call,
+    so the per-group reversal has to be applied before the concatenation --
+    which is what ``KVCacheCoordinator.pop_blocks_for_free`` now does.
+
+    Reverting the patch (no per-group reverse in ``pop_blocks_for_free``, a
+    ``reversed()`` back in ``_drain_deferred_frees``) makes the deferred arm
+    return ``reversed(g0_alloc + g1_alloc)`` -- whole groups in the wrong order
+    relative to the immediate arm -- which fails both the equality assertion
+    and the explicit pre-patch-shape assertion below.
+    """
+    blocks_per_group = 3
+    request = create_requests(num_requests=1, num_tokens=NUM_PROMPT_TOKENS)[0]
+
+    imm_manager = _make_two_group_kv_cache_manager(num_blocks=20)
+    def_manager = _make_two_group_kv_cache_manager(num_blocks=20)
+    assert len(imm_manager.coordinator.single_type_managers) == 2, (
+        "a single-group config cannot distinguish the two orders at all"
+    )
+
+    allocated = _seed_request_blocks(imm_manager, request.request_id, blocks_per_group)
+    assert allocated == _seed_request_blocks(
+        def_manager, request.request_id, blocks_per_group
+    ), "the two arms must start from identical per-group allocations"
+    assert not set(allocated[0]) & set(allocated[1]), (
+        "groups must own disjoint block ids or a group mix-up is invisible"
+    )
+    ours = {bid for group in allocated for bid in group}
+
+    immediate_order = _free_through_scheduler(imm_manager, request, False, ours)
+    deferred_order = _free_through_scheduler(def_manager, request, True, ours)
+
+    # Pin the shape as well as the equality: tail-first within a group, groups
+    # in their coordinator order.
+    expected = [bid for group in allocated for bid in reversed(group)]
+    assert immediate_order == expected
+    assert deferred_order == immediate_order
+
+    # The pre-patch deferred implementation flattened every group then reversed
+    # once. Assert the observed order is not that, so a revert cannot pass.
+    pre_patch_order = list(reversed([bid for group in allocated for bid in group]))
+    assert pre_patch_order != expected, (
+        "the fixture does not separate the two implementations; with this "
+        "shape the test could not fail on a revert"
+    )
+    assert deferred_order != pre_patch_order
+
+
+def test_pop_blocks_for_free_returns_eviction_order():
+    """``pop_blocks_for_free`` must hand back blocks already in eviction
+    order, so the deferred-free path can pass them to ``free_blocks``
+    unchanged. Reversing the flat list instead would emit whole groups in
+    the wrong order relative to the immediate-free path."""
+    scheduler = _create_deferring_scheduler()
+    coordinator = scheduler.kv_cache_manager.coordinator
+
+    request = create_requests(
+        num_requests=1,
+        num_tokens=NUM_PROMPT_TOKENS,
+        max_tokens=5,
+    )[0]
+    scheduler.add_request(request)
+    scheduler.schedule()
+
+    allocated = [
+        list(manager.req_to_blocks[request.request_id])
+        for manager in coordinator.single_type_managers
+    ]
+    expected = [block for group in allocated for block in reversed(group)]
+
+    assert coordinator.pop_blocks_for_free(request.request_id) == expected
+
+
+def _make_two_group_kv_cache_manager(num_blocks: int, block_size: int = 16):
+    """Build a KVCacheManager with two single-type managers (a hybrid
+    full-attention + sliding-window config), so CoW copies can be queued on
+    more than one group."""
+    from math import lcm
+
+    from vllm.v1.core.kv_cache_manager import KVCacheManager
+    from vllm.v1.kv_cache_interface import (
+        FullAttentionSpec,
+        KVCacheConfig,
+        KVCacheGroupSpec,
+        SlidingWindowSpec,
+    )
+
+    config = KVCacheConfig(
+        num_blocks=num_blocks,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["layer1"],
+                FullAttentionSpec(
+                    block_size=block_size,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float32,
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["layer2"],
+                SlidingWindowSpec(
+                    block_size=block_size,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float32,
+                    sliding_window=2 * block_size,
+                ),
+            ),
+        ],
+    )
+    return KVCacheManager(
+        config,
+        max_model_len=1024,
+        scheduler_block_size=lcm(
+            *(g.kv_cache_spec.block_size for g in config.kv_cache_groups)
+        ),
+        hash_block_size=block_size,
+        enable_caching=True,
+    )
+
+
+def test_cow_retained_blocks_span_groups_and_free_order_is_stable():
+    """CoW retentions from multiple KV cache groups are concatenated into one
+    flat list by ``take_kv_cache_block_copies``. Unlike per-request eviction,
+    ``_free_cow_retained_blocks`` never reverses, so the deferred path frees
+    that list in exactly the same order as the immediate path -- the
+    group-flattening does not reintroduce the eviction-order divergence.
+    """
+    manager = _make_two_group_kv_cache_manager(num_blocks=20)
+    coordinator = manager.coordinator
+    assert len(coordinator.single_type_managers) == 2
+
+    # Queue a CoW (source, cow) pair on each of the two groups.
+    blocks = manager.block_pool.get_new_blocks(4)
+    coordinator.single_type_managers[0]._pending_cow_copies.append(
+        (blocks[0], blocks[1])
+    )
+    coordinator.single_type_managers[1]._pending_cow_copies.append(
+        (blocks[2], blocks[3])
+    )
+
+    _copies, retained = manager.take_kv_cache_block_copies()
+    # Retentions from both groups are flattened into one list, group 0 first.
+    assert [b.block_id for b in retained] == [b.block_id for b in blocks]
+
+    # Drive the scheduler free helper on the same retained ordering, immediate
+    # vs deferred, and confirm identical eviction order.
+    retained_ids = [b.block_id for b in retained]
+
+    imm_scheduler = _create_deferring_scheduler()
+    imm_scheduler.defer_block_free = False
+    imm_pool, imm_by_id = _make_pool_with_cached_blocks(len(retained_ids))
+    imm_scheduler.kv_cache_manager.block_pool = imm_pool
+    imm_scheduler._free_cow_retained_blocks(
+        [imm_by_id[i] for i in retained_ids], fence_seq=1
+    )
+    immediate_order = _eviction_order(imm_pool)
+
+    def_scheduler = _create_deferring_scheduler()
+    def_pool, def_by_id = _make_pool_with_cached_blocks(len(retained_ids))
+    def_scheduler.kv_cache_manager.block_pool = def_pool
+    # fence in the future -> deferred; then drain once the fence is processed.
+    def_scheduler.processed_step_seq = 0
+    def_scheduler._free_cow_retained_blocks(
+        [def_by_id[i] for i in retained_ids], fence_seq=1
+    )
+    assert def_scheduler.deferred_frees
+    def_scheduler.processed_step_seq = 1
+    def_scheduler._drain_deferred_frees()
+    deferred_order = _eviction_order(def_pool)
+
+    assert deferred_order == immediate_order
diff --git a/tests/v1/core/test_qsa_ring_resume_alignment.py b/tests/v1/core/test_qsa_ring_resume_alignment.py
new file mode 100644
index 0000000000..9bc5cf446c
--- /dev/null
+++ b/tests/v1/core/test_qsa_ring_resume_alignment.py
@@ -0,0 +1,266 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Ring-row tag fix: can a prefix-cache hit make a request's
+FIRST QSA group read raw-key ring rows this request never wrote?
+
+The ring (CircularBufferSpec) is not prefix-cacheable: a request that resumes
+from a cache hit at position k starts with an empty ring. The pre-indexer's
+first group reads ring rows iff k is not a multiple of the compression ratio R
+(rows [k - k % R, k)). The ring-row tag fix makes such a read rank-fatal, so a legitimate
+unaligned resume would be a false positive. This file pins, on the local
+(no KV connector) path the model runs in production, that k % R == 0 always:
+
+  1. the ring never takes part in hit lookup (prefix_cacheable False, skipped
+     by the coordinator, its finder returns 0) -- kv_cache_coordinator.py
+     attention_groups loop, single_type_kv_cache_manager.py
+     CircularBufferManager.find_longest_cache_hit;
+  2. every hit length is a multiple of the coordinator's cache-hit alignment
+     (scheduler block, or the hash block under Mamba "align" partial hits),
+     including the full-prompt "recompute the last token" cap and the EAGLE
+     block drop -- kv_cache_manager.py get_computed_blocks;
+  3. boot refuses any alignment that is not a multiple of every
+     prefix-cacheable tokens_per_state, i.e. of R -- kv_cache_utils.py
+     resolve_kv_cache_block_sizes;
+  4. preemption restarts from 0 -- scheduler.py _preempt_request.
+
+The one path that CAN resume unaligned is an external KV connector
+(num_external_computed_tokens is arbitrary; a full-prompt async load resets
+to num_tokens - 1, scheduler.py _update_waiting_for_remote_kv). There the ring
+history must come from the connector: a connector that transfers the ring
+brings the producer's committed rows and tags (and the tag fix no longer clears the
+tags of a block an async load is filling); one that does not has no history
+to give, and failing closed is the correct outcome -- the recurrent GDN state
+at k cannot be rewound to an aligned k' < k. Production runs no connector.
+"""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.v1.core import kv_cache_utils as ku
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+from vllm.v1.core.kv_cache_utils import get_request_block_hasher, init_none_hash
+from vllm.v1.kv_cache_interface import (
+    CircularBufferSpec,
+    FullAttentionSpec,
+    KVCacheConfig,
+    KVCacheGroupSpec,
+    MambaSpec,
+    MLAAttentionSpec,
+)
+from vllm.v1.request import Request
+
+pytestmark = pytest.mark.cpu_test
+
+R = 4  # QSA compress ratio == MLAAttentionSpec.tokens_per_state
+BLOCK = 16  # stands in for the production 3200 (both multiples of R)
+REPO = Path(__file__).resolve().parents[3]
+
+
+def first_group_ring_rows(chunk_start: int, ratio: int = R) -> list[int]:
+    """Ring rows the pre-indexer's first group reads for a chunk starting at
+    chunk_start -- the kernel's arithmetic (qsa_pre_indexer.py: first_boundary,
+    first_position, source_in_chunk)."""
+    first_boundary = ((chunk_start + ratio) // ratio) * ratio - 1
+    first_position = first_boundary - (ratio - 1)
+    return [p for p in range(first_position, first_position + ratio) if p < chunk_start]
+
+
+def test_the_checker_can_fail():
+    """Negative control for everything below: an unaligned resume (the
+    connector full-prompt reset to num_tokens - 1) DOES read ring rows."""
+    assert first_group_ring_rows(52934) == [52932, 52933]
+    assert first_group_ring_rows(53 - 1) == []  # 52 is aligned
+    assert first_group_ring_rows(54 - 1) == [52]
+    for k in range(0, 64, R):
+        assert first_group_ring_rows(k) == []
+
+
+def _config() -> KVCacheConfig:
+    return KVCacheConfig(
+        num_blocks=256,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["attn"],
+                FullAttentionSpec(
+                    block_size=BLOCK, num_kv_heads=1, head_size=1, dtype=torch.float32
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["comp"],
+                MLAAttentionSpec(
+                    block_size=BLOCK,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float32,
+                    tokens_per_state=R,
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["ring"],
+                CircularBufferSpec(
+                    block_size=8, num_kv_heads=1, head_size=1, dtype=torch.float32
+                ),
+            ),
+        ],
+    )
+
+
+def _request(rid: str, tokens: list[int], hash_block: int) -> Request:
+    params = SamplingParams(max_tokens=4)
+    params.update_from_generation_config({}, eos_token_id=100)
+    return Request(
+        request_id=rid,
+        prompt_token_ids=tokens,
+        mm_features=None,
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(hash_block, sha256),
+    )
+
+
+def _mamba_align_group() -> KVCacheGroupSpec:
+    return KVCacheGroupSpec(
+        ["gdn"],
+        MambaSpec(
+            shapes=((4,),),
+            dtypes=(torch.float32,),
+            block_size=BLOCK,
+            mamba_cache_mode="align",
+        ),
+    )
+
+
+def _sweep_hits(*, use_eagle: bool, hash_block: int, mamba_align: bool) -> set[int]:
+    """Every hit length the real KVCacheManager returns for prompts of every
+    length in a range, for both a full-prompt repeat (capped to
+    num_tokens - 1) and a prompt continuation."""
+    init_none_hash(sha256)
+    config = _config()
+    if mamba_align:
+        config.kv_cache_groups.append(_mamba_align_group())
+    assert not config.kv_cache_groups[2].kv_cache_spec.prefix_cacheable
+    hits = set()
+    for length in range(BLOCK + 1, 5 * BLOCK + 3):
+        mgr = KVCacheManager(
+            config,
+            max_model_len=4096,
+            scheduler_block_size=BLOCK,
+            hash_block_size=hash_block,
+            enable_caching=True,
+            use_eagle=use_eagle,
+        )
+        prompt = list(range(1000, 1000 + length))
+        first = _request("a", prompt, hash_block)
+        blocks, hit, _ = mgr.get_computed_blocks(first)
+        assert hit == 0
+        assert mgr.allocate_slots(first, length, hit, blocks) is not None
+        mgr.free(first)
+        for rid, tokens in (("b", prompt), ("c", prompt + [7, 8, 9])):
+            req = _request(rid, tokens, hash_block)
+            blocks, hit, _ = mgr.get_computed_blocks(req)
+            hits.add(hit)
+            # the ring contributes no cached block: its history starts empty
+            assert len(blocks.blocks[2]) == 0
+    return hits
+
+
+@pytest.mark.parametrize(
+    "use_eagle,hash_block,mamba_align",
+    [
+        (False, BLOCK, False),
+        (True, BLOCK, False),
+        # Mamba "align" fine-grained (partial) hits: lengths 20, 24, 28, ...
+        # (EAGLE + Mamba needs the eagle-group annotation this stand-in does
+        # not model -- it returns no hit at all, so it is not swept here.)
+        (False, R, True),
+    ],
+    ids=["block", "block-eagle", "partial-hits"],
+)
+def test_every_local_prefix_hit_resumes_on_a_group_boundary(
+    use_eagle, hash_block, mamba_align
+):
+    hits = _sweep_hits(
+        use_eagle=use_eagle, hash_block=hash_block, mamba_align=mamba_align
+    )
+    for hit in hits:
+        assert hit % R == 0 and first_group_ring_rows(hit) == [], hit
+    # the sweep really produced non-trivial hits (else it proves nothing)
+    assert max(hits) >= 3 * BLOCK
+    if mamba_align:  # ...and really partial ones
+        assert any(hit % BLOCK for hit in hits)
+
+
+def test_failing_control_a_finer_hash_block_would_open_the_path():
+    """What the boot check below closes: with partial hits on a hash block of
+    2 (not a multiple of R) the SAME sweep returns hits that make the first
+    group read ring rows this request never wrote."""
+    hits = _sweep_hits(use_eagle=False, hash_block=2, mamba_align=True)
+    assert any(first_group_ring_rows(hit) for hit in hits), sorted(hits)
+
+
+def _boot_config(prefix_match_unit):
+    return SimpleNamespace(
+        cache_config=SimpleNamespace(
+            block_size=BLOCK,
+            enable_prefix_caching=True,
+            prefix_match_unit=prefix_match_unit,
+        ),
+        parallel_config=SimpleNamespace(decode_context_parallel_size=1),
+        kv_transfer_config=None,
+    )
+
+
+def _boot_groups():
+    return KVCacheConfig(
+        num_blocks=64,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            *_config().kv_cache_groups,
+            KVCacheGroupSpec(
+                ["gdn"],
+                MambaSpec(
+                    shapes=((4,),),
+                    dtypes=(torch.float32,),
+                    block_size=BLOCK,
+                    mamba_cache_mode="align",
+                ),
+            ),
+        ],
+    )
+
+
+def test_boot_refuses_a_hit_alignment_finer_than_the_qsa_group():
+    """With Mamba "align" partial hits the alignment drops to the hash block;
+    a hash block that is not a multiple of R would allow an unaligned resume,
+    and boot refuses it."""
+    with pytest.raises(ValueError, match="per-state compression"):
+        ku.resolve_kv_cache_block_sizes(_boot_groups(), _boot_config(2))
+    # control: an R-multiple hash block is accepted and stays R-aligned
+    sched, hash_bs = ku.resolve_kv_cache_block_sizes(_boot_groups(), _boot_config(4))
+    assert sched == BLOCK and hash_bs % R == 0
+
+
+def _function(path: Path, name: str) -> ast.FunctionDef:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return node
+    raise AssertionError(f"{name} not found in {path}")
+
+
+def test_preemption_restarts_from_zero():
+    fn = _function(REPO / "vllm/v1/core/sched/scheduler.py", "_preempt_request")
+    assigns = [
+        ast.unparse(n)
+        for n in ast.walk(fn)
+        if isinstance(n, ast.Assign)
+        and any("num_computed_tokens" in ast.unparse(t) for t in n.targets)
+    ]
+    assert "request.num_computed_tokens = 0" in assigns
diff --git a/tests/v1/core/test_ring_tag_clear.py b/tests/v1/core/test_ring_tag_clear.py
new file mode 100644
index 0000000000..0c5b3d5265
--- /dev/null
+++ b/tests/v1/core/test_ring_tag_clear.py
@@ -0,0 +1,367 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""v2.2 ring-row tag fix, manager half: the unconditional, ordered ring tag clear.
+
+`_record_new_block_ids` keeps `CircularBufferSpec` out of whole-block zeroing
+(single_type_kv_cache_manager.py:117-121), so a re-claimed ring block keeps
+its previous occupant's bytes. The tag fix does not change that; it records EVERY
+ring claim on a separate list, unconditionally (never under
+`needs_kv_cache_zeroing`), ships it as `SchedulerOutput.new_ring_block_ids_to_clear`
+and the runner clears the rows' TAG words right after the zeroer and before
+copies and the forward -- i.e. before the new owner's first ring access.
+
+FAILING CONTROL: on the unmodified tree (without this fix) every
+test here fails -- `take_new_ring_block_ids`, the SchedulerOutput field and
+`vllm.v1.worker.ring_tags` do not exist, and nothing calls a ring clear.
+"""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.v1.core.block_pool import BlockPool
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+from vllm.v1.core.sched.output import SchedulerOutput
+from vllm.v1.core.single_type_kv_cache_manager import (
+    CircularBufferManager,
+    FullAttentionManager,
+)
+from vllm.v1.kv_cache_interface import CircularBufferSpec, FullAttentionSpec
+from vllm.v1.worker.ring_tags import clear_ring_row_tags, ring_tag_layers
+
+pytestmark = pytest.mark.cpu_test
+
+REPO = Path(__file__).resolve().parents[3]
+
+
+def _ring_manager(pool: BlockPool, *, zeroing: bool) -> CircularBufferManager:
+    spec = CircularBufferSpec(
+        block_size=8, num_kv_heads=1, head_size=144, dtype=torch.bfloat16
+    )
+    return CircularBufferManager(
+        spec,
+        block_pool=pool,
+        enable_caching=False,
+        kv_cache_group_id=0,
+        scheduler_block_size=8,
+        needs_kv_cache_zeroing=zeroing,
+        max_admission_blocks_per_request=1,
+    )
+
+
+@pytest.mark.parametrize("zeroing", [False, True], ids=["no-zeroing", "zeroing"])
+def test_every_ring_claim_is_recorded_whatever_the_zeroing_gate(zeroing):
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=zeroing)
+    (a,) = mgr.allocate_new_blocks("a", num_tokens=100, num_tokens_main_model=100)
+    (b,) = mgr.allocate_new_blocks("b", num_tokens=3, num_tokens_main_model=3)
+    # later steps of the same request claim nothing new
+    assert mgr.allocate_new_blocks("a", 200, 200) == []
+    assert mgr.take_new_ring_block_ids() == [a.block_id, b.block_id]
+    # drained: a second take is empty
+    assert mgr.take_new_ring_block_ids() == []
+    # the ring stays OUT of whole-block zeroing (unchanged behaviour)
+    assert not mgr.records_new_block_ids
+    assert mgr.take_new_block_ids() == []
+
+
+def test_external_claim_is_recorded_too():
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=False)
+    mgr.allocate_external_computed_blocks("x", 16, 16)
+    (block,) = mgr.req_to_blocks["x"]
+    assert mgr.take_new_ring_block_ids() == [block.block_id]
+
+
+def test_a_block_freed_before_the_drain_is_not_cleared():
+    """Claimed then freed in the same scheduling pass (the request was
+    preempted after its allocation): the block may belong to another group
+    by the time the worker runs, so the clear must not touch it."""
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=False)
+    (a,) = mgr.allocate_new_blocks("a", 8, 8)
+    (b,) = mgr.allocate_new_blocks("b", 8, 8)
+    mgr.free("a")
+    assert mgr.take_new_ring_block_ids() == [b.block_id]
+
+
+def test_a_block_freed_and_reclaimed_in_one_pass_is_cleared_once():
+    pool = BlockPool(num_gpu_blocks=2, enable_caching=False, hash_block_size=8)
+    mgr = _ring_manager(pool, zeroing=False)  # one usable block (0 is null)
+    (a,) = mgr.allocate_new_blocks("a", 8, 8)
+    mgr.free("a")
+    (b,) = mgr.allocate_new_blocks("b", 8, 8)
+    assert b.block_id == a.block_id  # same physical block, new owner
+    assert mgr.take_new_ring_block_ids() == [b.block_id]
+
+
+def test_non_ring_managers_report_nothing():
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=4)
+    spec = FullAttentionSpec(
+        block_size=4, num_kv_heads=1, head_size=1, dtype=torch.float32
+    )
+    mgr = FullAttentionManager(
+        spec,
+        block_pool=pool,
+        enable_caching=False,
+        kv_cache_group_id=0,
+        scheduler_block_size=4,
+        needs_kv_cache_zeroing=True,
+    )
+    mgr.allocate_new_blocks("a", 16, 16)
+    assert mgr.take_new_ring_block_ids() == []
+    assert mgr.take_new_block_ids()  # attention still goes to the zeroer
+
+
+def test_kv_cache_manager_aggregates_every_group():
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    ring_a, ring_b = (
+        _ring_manager(pool, zeroing=False),
+        _ring_manager(pool, zeroing=True),
+    )
+    (x,) = ring_a.allocate_new_blocks("r", 8, 8)
+    (y,) = ring_b.allocate_new_blocks("r", 8, 8)
+    fake = SimpleNamespace(
+        coordinator=SimpleNamespace(single_type_managers=(ring_a, ring_b))
+    )
+    assert KVCacheManager.take_new_ring_block_ids(fake) == [x.block_id, y.block_id]
+    assert KVCacheManager.take_new_ring_block_ids(fake) == []
+
+
+def test_scheduler_output_carries_the_field_default_none():
+    field = SchedulerOutput.__dataclass_fields__["new_ring_block_ids_to_clear"]
+    assert field.default is None
+
+
+# --------------------------------------------------------------------------
+# wiring, checked on the source (the scheduler and runners need a model /
+# Triton to construct; the behavioural twin of the scheduler check is
+# test_scheduler_ships_ring_claims_without_kv_zeroing below)
+# --------------------------------------------------------------------------
+
+
+def _function(path: Path, name: str) -> ast.FunctionDef:
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and node.name == name:
+            return node
+    raise AssertionError(f"{name} not found in {path}")
+
+
+def test_scheduler_drains_ring_claims_unconditionally():
+    path = REPO / "vllm/v1/core/sched/scheduler.py"
+    fn = _function(path, "schedule")
+    found = False
+    for node in ast.walk(fn):
+        if isinstance(node, ast.keyword) and node.arg == "new_ring_block_ids_to_clear":
+            src = ast.unparse(node.value)
+            assert "_get_new_ring_block_ids_to_clear" in src
+            assert "needs_kv_cache_zeroing" not in src
+            found = True
+    assert found, "SchedulerOutput is built without new_ring_block_ids_to_clear"
+    body = _function(path, "_get_new_ring_block_ids_to_clear").body
+    if isinstance(body[0], ast.Expr) and isinstance(body[0].value, ast.Constant):
+        body = body[1:]  # the docstring may name the gate it is not under
+    drain = "\n".join(ast.unparse(stmt) for stmt in body)
+    assert "take_new_ring_block_ids" in drain
+    assert "needs_kv_cache_zeroing" not in drain
+
+
+def _drain_scheduler(ring_ids, skip):
+    from vllm.v1.core.sched.scheduler import Scheduler
+
+    sched = Scheduler.__new__(Scheduler)
+    sched.kv_cache_manager = SimpleNamespace(
+        take_new_ring_block_ids=lambda: list(ring_ids)
+    )
+    sched._skip_ring_clear_block_ids = set(skip)
+    return sched
+
+
+def test_drain_ships_every_claim_and_skips_only_async_load_targets():
+    sched = _drain_scheduler([3, 5, 9], skip={5})
+    assert sched._get_new_ring_block_ids_to_clear() == [3, 9]
+    # the skip set is one-shot, like _skip_zero_block_ids
+    assert sched._skip_ring_clear_block_ids == set()
+    assert _drain_scheduler([], skip=set())._get_new_ring_block_ids_to_clear() is None
+
+
+def test_async_kv_load_marks_the_request_ring_blocks_for_skipping():
+    """The async-load branch of schedule() records the request's ring blocks
+    in _skip_ring_clear_block_ids OUTSIDE the needs_kv_cache_zeroing guard
+    (an out-of-band write of the producer's ring must not be followed by a
+    tag clear that wipes its committed tags)."""
+    fn = _function(REPO / "vllm/v1/core/sched/scheduler.py", "schedule")
+    hits = []
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Call) and "_skip_ring_clear_block_ids.update" in (
+            ast.unparse(node.func)
+        ):
+            hits.append(ast.unparse(node))
+    assert hits and all("get_ring_block_ids" in h for h in hits)
+    for node in ast.walk(fn):
+        if isinstance(node, ast.If) and "needs_kv_cache_zeroing" in ast.unparse(
+            node.test
+        ):
+            assert "_skip_ring_clear_block_ids" not in ast.unparse(node)
+
+
+def test_ring_block_ids_of_a_request():
+    pool = BlockPool(num_gpu_blocks=10, enable_caching=False, hash_block_size=8)
+    ring = _ring_manager(pool, zeroing=False)
+    (x,) = ring.allocate_new_blocks("r", 8, 8)
+    assert ring.get_ring_block_ids("r") == [x.block_id]
+    assert ring.get_ring_block_ids("absent") == []
+    fake = SimpleNamespace(coordinator=SimpleNamespace(single_type_managers=(ring,)))
+    assert KVCacheManager.get_ring_block_ids(fake, "r") == [x.block_id]
+
+
+@pytest.mark.parametrize(
+    "path,func,zero_call,copy_call",
+    [
+        (
+            "vllm/v1/worker/gpu/model_runner.py",
+            "update_requests",
+            "zero_block_ids",
+            "copy_kv_cache_blocks_inplace",
+        ),
+        (
+            "vllm/v1/worker/gpu_model_runner.py",
+            "_update_states",
+            "_zero_block_ids",
+            "copy_kv_cache_blocks_inplace",
+        ),
+    ],
+    ids=["v2-runner", "v1-runner"],
+)
+def test_runner_clears_after_the_zeroer_and_before_copies(
+    path, func, zero_call, copy_call
+):
+    fn = _function(REPO / path, func)
+    lines: dict[str, int] = {}
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Call):
+            name = ast.unparse(node.func).rsplit(".", 1)[-1]
+            lines[name] = min(lines.get(name, node.lineno), node.lineno)
+    assert "clear_ring_row_tags" in lines, f"{path}:{func} never clears ring tags"
+    assert lines[zero_call] < lines["clear_ring_row_tags"] < lines[copy_call]
+    # and the clear is not nested under the zeroing branch
+    for node in ast.walk(fn):
+        if isinstance(node, ast.If) and "new_block_ids_to_zero" in ast.unparse(
+            node.test
+        ):
+            inner = {ast.unparse(n) for n in ast.walk(node)}
+            assert not any("clear_ring_row_tags" in s for s in inner)
+
+
+# --------------------------------------------------------------------------
+# the worker helper
+# --------------------------------------------------------------------------
+
+
+class _TagLayer:
+    def __init__(self, num_blocks: int, prefix: str = "layer"):
+        self.prefix = prefix
+        self.ring_tag_cache = torch.arange(
+            1, num_blocks * 8 + 1, dtype=torch.int64
+        ).view(num_blocks, 8, 1, 1)
+        self.cleared: list[list[int]] = []
+
+    def clear_ring_row_tags(self, block_ids: torch.Tensor) -> None:
+        self.cleared.append(block_ids.tolist())
+        self.ring_tag_cache.index_fill_(0, block_ids, 0)
+
+
+def test_helper_clears_every_tag_layer_and_skips_others():
+    a, b = _TagLayer(4, "a"), _TagLayer(4, "b")
+    ctx = {"a": a, "attn": object(), "b": b}
+    layers = ring_tag_layers(ctx)
+    assert layers == [a, b]
+    assert clear_ring_row_tags(layers, [2, 0], torch.device("cpu")) == 2
+    for layer in (a, b):
+        assert layer.cleared == [[2, 0]]
+        assert torch.all(layer.ring_tag_cache[[0, 2]] == 0)
+        assert torch.all(layer.ring_tag_cache[[1, 3]] != 0)
+
+
+def test_helper_is_a_noop_without_ids_or_layers():
+    a = _TagLayer(2)
+    assert clear_ring_row_tags([a], [], torch.device("cpu")) == 0
+    assert clear_ring_row_tags([], [1], torch.device("cpu")) == 0
+    assert a.cleared == []
+
+
+def test_helper_fails_loud_on_a_block_outside_the_pool():
+    a = _TagLayer(2)
+    with pytest.raises(ValueError, match="outside the pool"):
+        clear_ring_row_tags([a], [1, 2], torch.device("cpu"))
+    assert a.cleared == []
+
+
+def test_helper_fails_loud_on_an_unbound_layer():
+    a = _TagLayer(2)
+    a.ring_tag_cache = None
+    with pytest.raises(RuntimeError, match="no bound ring_tag_cache"):
+        clear_ring_row_tags([a], [1], torch.device("cpu"))
+
+
+def test_clear_then_commit_orders_correctly_on_a_real_ring():
+    """Claim -> clear -> the new owner's commit: the commit survives (the
+    clear never lands after it), and an uncommitted row reads tag 0."""
+    from vllm.models.qwen4_exp.common import qsa_cache
+
+    cache = qsa_cache.QSAKeyStateCache(
+        head_size=128,
+        dtype=torch.bfloat16,
+        cache_rope_positions=True,
+        cache_config=SimpleNamespace(block_size=32),
+        prefix="ringtag.order",
+        vllm_config=SimpleNamespace(
+            compilation_config=SimpleNamespace(static_forward_context={})
+        ),
+        compress_ratio=4,
+    )
+    unified = torch.full((3, 1, 8, 144), 0.25, dtype=torch.bfloat16)
+    cache.bind_kv_cache(unified)
+    residue = int(cache.ring_tag_cache[1, 0, 0, 0])
+    assert residue != 0
+    # step N: scheduler claimed block 1; the runner clears before the forward
+    clear_ring_row_tags(ring_tag_layers({"l": cache}), [1], torch.device("cpu"))
+    # step N forward: the new owner commits positions 100, 101
+    for position in (100, 101):
+        cache.ring_tag_cache[1, position % 8, 0, 0] = position + 1
+    tags = cache.ring_tag_cache[1, :, 0, 0].tolist()
+    assert tags[100 % 8] == 101 and tags[101 % 8] == 102
+    assert [t for i, t in enumerate(tags) if i not in (100 % 8, 101 % 8)] == [0] * 6
+    # other blocks untouched
+    assert int(cache.ring_tag_cache[0, 0, 0, 0]) == residue
+
+
+# --------------------------------------------------------------------------
+# behavioural scheduler check (needs the HF config of the test model: runs on
+# the reference host / CI, not offline without the model)
+# --------------------------------------------------------------------------
+
+
+def test_scheduler_ships_ring_claims_without_kv_zeroing():
+    from .utils import create_requests, create_scheduler
+
+    spec = CircularBufferSpec(
+        block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32
+    )
+    scheduler = create_scheduler(kv_cache_spec=spec)
+    assert not scheduler.needs_kv_cache_zeroing
+    requests = create_requests(num_requests=2, num_tokens=10)
+    scheduler.add_request(requests[0])
+    out0 = scheduler.schedule()
+    blocks0 = scheduler.kv_cache_manager.get_block_ids(requests[0].request_id)[0]
+    assert out0.new_ring_block_ids_to_clear == list(blocks0)
+    assert out0.new_block_ids_to_zero is None
+    scheduler.add_request(requests[1])
+    out1 = scheduler.schedule()
+    blocks1 = scheduler.kv_cache_manager.get_block_ids(requests[1].request_id)[0]
+    # only the NEW claim, never the first request's block again
+    assert out1.new_ring_block_ids_to_clear == list(blocks1)
