+# ---------------------------------------------------------------------------
+# Large-path determinism -- expanded coverage (more shapes and
+# adversarial distributions).
+#
+# The original pair of tests used one shape (8 rows x 40,960, k=512) and one
+# distribution. That gives ONE large row per group,
+# so it never exercises the `histogram[radix_iter % 3]` slot reuse that the
+# X1 barrier exists to protect, and that a single planted tie shape is not a
+# distribution class. Both are addressed below:
+#
+#   * `_largedet_reference` derives the expected index set from the SHIPPED RULE for
+#     any row, so every distribution gets an exact set assertion rather than
+#     torch.topk's arbitrary choice inside a tie. The rule: take every element
+#     strictly above the k-th largest VALUE, then the highest-indexed of those
+#     equal to it. float32 equality is exactly the kernel's ordered-uint32
+#     equality (the transform is monotonic and injective), so the reference is
+#     exact, not approximate.
+#   * five distributions: all-equal, no cutoff tie, cross-CTA ties, a cutoff
+#     landing inside a single 1,024-element tile, and narrow distinct scores
+#     that all share one coarse bin.
+#   * rows 1 / 4 / 8 / 32, which straddle both shared-memory budget steps in
+#     topk.cu (<=4, <=8, >8) and therefore different chunk sizes and
+#     ctas_per_group values; k = 512 and 2,048.
+#   * a ragged cell mixing trivial / decode / medium / large rows in one launch.
+#   * a slot-residue cell whose group geometry forces >= 3 large rows per group.
+# ---------------------------------------------------------------------------
+
+LARGEDET_RADIX_THRESHOLD = 32768  # persistent_topk.cuh: above this, the large path
+
+
+# ---------------------------------------------------------------------------
+# The EFFECTIVE policy, read from the same place the kernel
+# reads it.
+#
+# Every switch in topk.cu is a function-local static filled from std::getenv on
+# the first launch, so the environment this process started with IS the policy
+# the kernel applies -- provided nothing mutates os.environ after a top-k
+# kernel has run. Do not monkeypatch these inside a session; run each arm in
+# its own process, exactly as the fault cells do.
+# ---------------------------------------------------------------------------
+def _largedet_env_on(name: str, default: bool) -> bool:
+    raw = os.getenv(name)
+    if raw is None or raw.strip() == "":
+        return default
+    try:
+        return int(raw) != 0
+    except ValueError:
+        return default
+
+
+def _largedet_effective_tie_recent() -> bool:
+    """`effective_tie_recent(det_ties, tie_recent)` = det_ties ? tie_recent : true.
+
+    With MERLIN_TIE_DET=0 (the shipped default) the buffered paths keep their
+    racy atomic rule, which has no direction, and every deterministic emission
+    -- including the large path -- uses most-recent-wins.
+    """
+    if not _largedet_env_on("MERLIN_TIE_DET", False):
+        return True
+    return _largedet_env_on("MERLIN_TIE_RECENT", False)
+
+
+def _buffered_order_is_canonical() -> bool:
+    """Do the DECODE and MEDIUM paths promise a deterministic SELECTED SET?
+
+    Only with MERLIN_TIE_DET=1, and only the set: TIE_DET makes cutoff-tie
+    MEMBERSHIP deterministic, but the buffered paths still place every
+    selected element by atomicAdd arrival, so the RAW output order stays
+    launch-dependent. Canonical order is MERLIN_QSA_SORT's job (a Python-side
+    sort in qsa_indexer), not the kernel's -- the root-cause analysis split the
+    two mechanisms exactly this way. On the reference host, asserting raw equality
+    here failed on 3 short rows in both tie directions while values,
+    membership and tie policy all passed. Callers compare sorted indices.
+    The LARGE path is separate: it is canonical in raw order whenever
+    MERLIN_TOPK_DET_LARGE is on.
+    """
+    return _largedet_env_on("MERLIN_TIE_DET", False)
+
+
+def _largedet_reference_impl(
+    values: torch.Tensor, top_k: int, tie_recent: bool | None = None
+) -> torch.Tensor:
+    """The deterministic large path's own rule, as ascending int64 indices.
+
+    Everything strictly above the k-th largest value, plus -- in the direction
+    the launch actually runs -- the HIGHEST-indexed (most-recent-wins) or the
+    LOWEST-indexed (oldest-wins) of the elements equal to it. Computed on CPU
+    float32; float32 equality is exactly the kernel's ordered-uint32 equality,
+    because the transform is monotonic and injective, so this is exact.
+
+    This oracle used to hard-code most-recent-wins, so a
+    CORRECT oldest-wins run (MERLIN_TIE_DET=1 MERLIN_TIE_RECENT=0) failed every
+    distribution cell, and the oldest-wins behaviour the integration added had
+    no oracle at all. `tie_recent=None` resolves it from the environment the
+    kernel resolves it from; pass an explicit value only to test the oracle.
+    """
+    assert values.dtype == torch.float32 and values.dim() == 1
+    if tie_recent is None:
+        tie_recent = _largedet_effective_tie_recent()
+    pivot = torch.sort(values, descending=True).values[top_k - 1]
+    above = (values > pivot).nonzero(as_tuple=False).flatten()
+    equal = (values == pivot).nonzero(as_tuple=False).flatten()
+    need = top_k - int(above.numel())
+    assert need >= 0, "more elements above the pivot than k; reference is wrong"
+    if need == 0:
+        kept = equal[:0]
+    elif tie_recent:
+        kept = equal[equal.numel() - need :]
+    else:
+        kept = equal[:need]
+    expected = torch.sort(torch.cat([above, kept])).values.to(torch.int64)
+    assert expected.numel() == top_k
+    return expected
+
+
+def _assert_valid_topk_membership(
+    values: torch.Tensor, got: torch.Tensor, top_k: int, where: str
+) -> None:
+    """Policy-CORRECT membership, for rows whose tie choice is not canonical.
+
+    Where the output order is not promised, the set still is,
+    up to the choice WITHIN the pivot-equal group. Asserted: exactly `top_k`
+    distinct in-range indices; every selected value >= the pivot; and every
+    element strictly above the pivot selected. That leaves free exactly the one
+    degree of freedom the buffered paths have with MERLIN_TIE_DET=0, and
+    nothing else.
+    """
+    assert got.numel() == top_k, f"{where}: {got.numel()} indices, want {top_k}"
+    assert int(got.min()) >= 0 and int(got.max()) < values.numel(), (
+        f"{where}: index out of range"
+    )
+    assert got.unique().numel() == top_k, f"{where}: duplicate index"
+    pivot = torch.sort(values, descending=True).values[top_k - 1]
+    assert bool((values[got] >= pivot).all()), (
+        f"{where}: a selected element is below the k-th largest value"
+    )
+    above = (values > pivot).nonzero(as_tuple=False).flatten()
+    missing = int((~torch.isin(above, got)).sum())
+    assert missing == 0, (
+        f"{where}: {missing} elements strictly above the pivot were not selected"
+    )
+
+
+def _largedet_distribution_impl(
+    kind: str, seq_len: int, top_k: int, seed: int
+) -> torch.Tensor:
+    """One CPU float32 row. All values are positive, so no -0.0/+0.0 hazard."""
+    gen = torch.Generator(device="cpu").manual_seed(seed)
+
+    if kind == "all_equal":
+        # Every element ties. gt_total == 0 and equal_needed == k, so the whole
+        # selection is the tie cut and both halves of the cut walk run.
+        return torch.full((seq_len,), 1.5, dtype=torch.float32)
+
+    if kind == "no_cutoff_tie":
+        # All distinct: the pivot group has exactly one element, so the tie cut
+        # is a no-op and only the placement arithmetic is under test.
+        vals = torch.randperm(seq_len, generator=gen).to(torch.float32) + 1.0
+        return vals / seq_len + 0.5
+
+    if kind == "narrow_distinct":
+        # Distinct, but inside one coarse bin: the radix walk's own adversarial
+        # class (the medium path's #51782 shape, at large width).
+        steps = torch.randperm(seq_len, generator=gen).to(torch.float32)
+        return 1.0 + steps * (1.0 / (1 << 22))
+
+    row = torch.rand(seq_len, generator=gen, dtype=torch.float32) * 0.5
+
+    if kind == "cross_cta_ties":
+        # The tie group is scattered over the whole row by a seeded permutation,
+        # so it spans every CTA chunk and several index high-byte buckets, and
+        # the global cut lands mid-chunk.
+        above = top_k // 3
+        tie = top_k  # > k - above, so the cut is strictly inside the tie group
+        perm = torch.randperm(seq_len, generator=gen)
+        row[perm[:above]] = 3.0
+        row[perm[above : above + tie]] = 2.0
+        return row
+
+    if kind == "cutoff_in_tile":
+        # The whole tie group is one contiguous 1,024-element window, i.e. one
+        # tile of one CTA, so the cut falls inside a single ballot/scan tile.
+        above = top_k - 512
+        tie = 1024
+        start = (seq_len // 2) & ~1023
+        perm = torch.randperm(seq_len, generator=gen)
+        picked = perm[perm >= start + tie][:above]
+        if int(picked.numel()) < above:  # pathological seed: use the head
+            picked = torch.arange(above)
+        row[picked] = 3.0
+        row[start : start + tie] = 2.0
+        return row
+
+    raise ValueError(f"unknown large-path distribution: {kind}")
+
+
+def _largedet_reference(*args, **kwargs) -> torch.Tensor:
+    """CPU reference, whatever the global default device is.
+
+    Earlier tests in this file call torch.set_default_device("cuda:0") and
+    never reset it, so factory calls inside the helpers would otherwise land
+    on the GPU and fail the torch.equal against a .cpu() kernel output
+    (seen on the reference host) -- a harness failure that would read as a kernel one.
+    """
+    with torch.device("cpu"):
+        return _largedet_reference_impl(*args, **kwargs).cpu()
+
+
+def _largedet_distribution(*args, **kwargs) -> torch.Tensor:
+    """CPU fixture row, whatever the global default device is (see above)."""
+    with torch.device("cpu"):
+        return _largedet_distribution_impl(*args, **kwargs).cpu()
+
+
+def _largedet_launch(logits: torch.Tensor, lengths: torch.Tensor, top_k: int):
+    indices = torch.empty((logits.shape[0], top_k), dtype=torch.int32, device="cuda")
+    _run_topk_backend(
+        "persistent_topk", logits, lengths, indices, top_k, int(lengths.max())
+    )
+    torch.accelerator.synchronize()
+    return indices
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@pytest.mark.parametrize(
+    "kind",
+    [
+        "all_equal",
+        "no_cutoff_tie",
+        "cross_cta_ties",
+        "cutoff_in_tile",
+        "narrow_distinct",
+    ],
+)
+@pytest.mark.parametrize("num_rows", [1, 4, 8, 32])
+@pytest.mark.parametrize("top_k", [512, 2048])
+@torch.inference_mode()
+def test_persistent_topk_large_distributions(
+    kind: str, num_rows: int, top_k: int
+) -> None:
+    """Exact set, exact order, exact counters and bit identity, per class."""
+    torch.set_default_device("cuda:0")
+    seq_len = 40960  # > RADIX_THRESHOLD: the multi-CTA large path
+
+    before = _largedet_counters_or_skip(require_on=True)
+
+    cpu_row = _largedet_distribution(kind, seq_len, top_k, seed=19)
+    expected = _largedet_reference(cpu_row, top_k)
+    logits = cpu_row.to("cuda").unsqueeze(0).repeat(num_rows, 1).contiguous()
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+
+    first = _largedet_launch(logits, lengths, top_k).clone()
+    mid = _read_exact_counters()
+    second = _largedet_launch(logits, lengths, top_k)
+
+    assert mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS] == num_rows, (
+        "the deterministic large path did not run on every row: "
+        f"{mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS]} of {num_rows}"
+    )
+    assert mid[_SLOT_LARGE_FAULT] - before[_SLOT_LARGE_FAULT] == 0, (
+        "a large-path invariant fired; nothing below is meaningful"
+    )
+
+    ref_values = torch.topk(logits[0], top_k).values.sort().values
+    for row in range(num_rows):
+        got = first[row].to(torch.int64)
+        # Raw order and selected set are asserted SEPARATELY: a
+        # sorted-set comparison alone cannot see a placement regression.
+        assert bool((got[1:] - got[:-1] > 0).all()), (
+            f"{kind} row {row}: output is not ascending in index"
+        )
+        assert int(got.min()) >= 0 and int(got.max()) < seq_len, (
+            f"{kind} row {row}: index out of range"
+        )
+        assert got.unique().numel() == top_k, f"{kind} row {row}: duplicate index"
+        assert torch.equal(got.cpu(), expected), (
+            f"{kind} row {row}: selected set is not the "
+            f"{'most-recent' if _largedet_effective_tie_recent() else 'oldest'}"
+            "-wins set"
+        )
+        assert torch.equal(logits[row][got].sort().values, ref_values), (
+            f"{kind} row {row}: selected values are not torch.topk's values"
+        )
+
+    assert torch.equal(first, second), (
+        f"{kind}: two identical launches returned different index tensors"
+    )
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@pytest.mark.parametrize("top_k", [512, 2048])
+@torch.inference_mode()
+def test_persistent_topk_large_ragged_mixed_paths(top_k: int) -> None:
+    """Trivial, decode, medium and large rows in ONE launch.
+
+    A group that handles a short row between two large ones must not advance
+    `radix_iter` -- that is what makes the histogram-slot reuse argument hold
+    across interleaved traffic. Large rows get the exact set assertion; short
+    rows only get the value-multiset check, because their tie policy belongs to
+    the decode/medium paths, not to this branch.
+
+    The raw `torch.equal(first, second)` over the WHOLE
+    tensor is gone. The decode and medium rows in this launch emit by atomicAdd
+    arrival order unless MERLIN_TIE_DET is on, so a legitimate buffered-order
+    difference on a short row used to fail a test presented as large-path
+    qualification -- a misattribution, and on the other side a flake. Raw
+    equality is now asserted per row: unconditionally on the large rows, whose
+    canonical ascending order DET_LARGE promises, and on the short rows only
+    when TIE_DET makes that promise for them too. Where it is not promised, the
+    short rows are still held to the value multiset and to policy-correct
+    membership (a valid top-k SET: no duplicates, in range, every selected
+    value >= the pivot and every strictly-greater element selected).
+    """
+    torch.set_default_device("cuda:0")
+    lengths_list = [
+        top_k,  # trivial: length == k
+        40960,  # large
+        2048,  # decode/short
