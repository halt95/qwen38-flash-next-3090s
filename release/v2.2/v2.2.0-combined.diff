+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import os
+import queue
+import subprocess
+import sys
+import threading
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+import vllm_ple_test_fault as test_fault
+
+
+def _spec(monkeypatch, tmp_path, value):
+    monkeypatch.setenv("VLLM_PLE_TEST_FAULT_LOG", str(tmp_path / "fault.log"))
+    spec = test_fault._parse_fault_spec(value)
+    assert spec is not None
+    return spec
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "cut=park_before_publish,ordinal=1,tp=0",
+        "cut=launch_silent_ready,ordinal=1,pp=0",
+        "cut=drop_request,ordinal=1,tp=1,pp=0",
+        "cut=exc_after_prepare,ordinal=1,tp=0,pp=1",
+    ],
+)
+def test_impossible_role_selectors_are_rejected(monkeypatch, tmp_path, value):
+    monkeypatch.setenv("VLLM_PLE_TEST_FAULT_LOG", str(tmp_path / "fault.log"))
+    with pytest.raises(ValueError):
+        test_fault._parse_fault_spec(value)
+
+
+def test_armed_import_requires_dedicated_log(tmp_path):
+    env = dict(os.environ)
+    env["VLLM_PLE_TEST_FAULT"] = "cut=exc_before_prepare,ordinal=1,rank=any"
+    env.pop("VLLM_PLE_TEST_FAULT_LOG", None)
+    proc = subprocess.run(
+        [sys.executable, "-c", "import vllm_ple_test_fault"],
+        env=env,
+        text=True,
+        capture_output=True,
+        timeout=120,
+    )
+    assert proc.returncode != 0
+    assert "VLLM_PLE_TEST_FAULT_LOG is required" in proc.stderr
+
+
+def test_failed_marker_write_suppresses_action(monkeypatch, tmp_path):
+    spec = _spec(
+        monkeypatch,
+        tmp_path,
+        "cut=exc_after_prepare,ordinal=1,tp=0,pp=0",
+    )
+    monkeypatch.setattr(test_fault.os, "write", Mock(side_effect=BlockingIOError))
+    assert not spec.fires(
+        "exc_after_prepare",
+        role="gpu",
+        unit="runner-forward",
+        eligible=True,
+        tp_rank=0,
+        pp_rank=0,
+        dp_rank=0,
+        transaction_id="sequence:1",
+    )
+    assert spec._state.diagnostic_failed
+    assert not spec._state.fired
+
+
+@pytest.mark.parametrize("order", ["bootstrap-first", "package-first"])
+@pytest.mark.parametrize("armed", [False, True])
+def test_fresh_interpreter_import_identity(tmp_path, order, armed):
+    env = dict(os.environ)
+    env.pop("VLLM_PLE_TEST_FAULT", None)
+    env.pop("VLLM_PLE_TEST_FAULT_LOG", None)
+    if armed:
+        env["VLLM_PLE_TEST_FAULT"] = "cut=launch_silent_ready,ordinal=1,rank=any"
+        env["VLLM_PLE_TEST_FAULT_LOG"] = str(tmp_path / f"{order}.log")
+    script = f"""
+import sys
+if {order!r} == "bootstrap-first":
+    import vllm_ple_offload_bootstrap as bootstrap
+    absent_before_package = "vllm_ple_test_fault" not in sys.modules
+    import vllm_ple_test_fault as package
+else:
+    import vllm_ple_test_fault as package
+    import vllm_ple_offload_bootstrap as bootstrap
+    absent_before_package = False
+assert bootstrap._FAULT is package._FAULT
+assert getattr(sys.modules["vllm_ple_test_fault"], "_FAULT") is package._FAULT
+if {armed!r}:
+    assert package._FAULT is not None
+else:
+    assert package._FAULT is None
+    if {order!r} == "bootstrap-first":
+        assert absent_before_package
+"""
+    subprocess.run(
+        [sys.executable, "-c", script],
+        env=env,
+        check=True,
+        timeout=120,
+    )
+
+
+class _IncompleteEvent:
+    def query(self):
+        return False
+
+
+class _FatalObserved(BaseException):
+    pass
+
+
+@pytest.mark.parametrize(
+    ("record_completion", "complete_submission", "expected"),
+    [
+        (False, False, "host-submission"),
+        (True, False, "gpu-completion"),
+        (True, True, "gpu-completion"),
+    ],
+)
+def test_real_progress_monitor_observed_state(
+    monkeypatch,
+    record_completion,
+    complete_submission,
+    expected,
+):
+    import vllm.v1.ple_offload.progress as progress_module
+
+    observed = []
+    reached = threading.Event()
+
+    def fatal(**kwargs):
