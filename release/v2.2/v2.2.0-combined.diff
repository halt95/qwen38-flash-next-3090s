+def _e2_strict_switch(name: str) -> bool:
+    """Parse a fork on/off switch that accepts exactly ``"0"`` and ``"1"``.
+
+    Unset means off. Anything else -- ``"true"``, ``"yes"``, ``""``, ``" 1"``,
+    ``"01"`` -- is a boot error: a switch that selects a different transport
+    must not be satisfiable by a spelling nobody meant.
+    """
+    raw = os.environ.get(name)
+    if raw is None or raw == "0":
+        return False
+    if raw == "1":
+        return True
+    raise ValueError(f'{name} must be exactly "0" or "1" (or unset), got {raw!r}')
+
