+def test_unaudited_host_side_knob_stays_listed_until_it_is_classified(name: str):
+    """The fenced block in envs.py is a gate, not a note.
+
+    Registering one of these without classifying it -- which means deleting it
+    from that block once its AOT and capture identity are written down against
+    its real read site -- is the exact failure the fork's env rule
+    exists to prevent, so it fails here.
+
+    The scan is scoped to the fenced block, not to the whole file. Scanning the
+    whole file is the defect of an earlier version: a legitimately
+    registered knob NECESSARILY appears in envs.py -- as its declaration and as
+    its `environment_variables` key -- so `name in source` is True for every
+    registered knob and the `assert not listed` branch could never pass. The
+    gate could only ever be satisfied by leaving the knob unregistered, which
+    inverts what it was written to enforce.
+    """
+    listed = name in _unaudited_names(_envs_source())
+    if name in environment_variables:
+        assert not listed, (
+            f"{name} is registered but still named in the envs.py unaudited "
+            "block: classify its AOT and capture identity from its real read "
+            "site and remove it from that block"
+        )
+    else:
+        assert listed, (
+            f"{name} is neither registered nor named in the envs.py unaudited "
+            "block; every fork knob must be accounted for"
