+    precopy_mamba_align_fused_kernel[(num_reqs, NUM_LAYERS * 2, 1)](
+        dst_col,
+        src_col,
+        bias,
+        bt_ptrs,
+        bt.stride(0),
+        bt.size(0),
+        guard_ctr,
+        base,
+        blk_stride,
+        elem,
+        inner,
+        width,
+        group,
+        drc,
+        drs,
