+# ---------------------------------------------------------------------------
+# Large-path (multi-CTA radix_topk) deterministic placement and ties
+#
+# Above RADIX_THRESHOLD = 32,768 compressed columns a row is split across a
+# group of CTAs.  In v2.0.1 the pivot is exact and order-independent, but
+# everything after it is a race: a CTA's base offset into the row is its
+# arrival order at `state->output_counter`, its slot inside that base is
+# arrival order at a shared counter, and which pivot-equal elements survive the
+# `pos < TopK` cut is decided by whoever gets there first.  The first two
+# permute the selected list — which sparse attention consumes as an ordered
+# gather, so they fork the hidden state — and the third changes the set.
+#
+# The row below is built so all three are visible at once:
+#   * 200 elements strictly above the pivot, scattered over the whole row,
+#   * 700 elements exactly AT the pivot, also scattered, so the tie group spans
+#     every CTA chunk and several index high-byte buckets,
+#   * top_k = 512, so exactly 312 of the 700 must survive and 388 must be cut.
+#
+# `torch.topk`'s own index choice inside a 700-way tie is arbitrary, so it
+# cannot supply the expectation.  The reference is computed from the shipped
+# rule instead — most-recent-wins, i.e. the 312 HIGHEST indices — and
+# torch.topk is used for the weaker check it can make, the value multiset.
+# ---------------------------------------------------------------------------
+
+LARGEDET_SEQ_LEN = 40960  # > RADIX_THRESHOLD (32768): the multi-CTA radix path
+LARGEDET_TOP_K = 512
+LARGEDET_ABOVE = 200  # elements strictly greater than the pivot
+LARGEDET_TIE = 700  # elements exactly equal to the pivot
+LARGEDET_KEPT = LARGEDET_TOP_K - LARGEDET_ABOVE  # 312 of the 700 survive
+LARGEDET_DROPPED = LARGEDET_TIE - LARGEDET_KEPT  # 388 are cut
+
+
+def _build_largedet_tie_row(
+    num_rows: int, tie_recent: bool | None = None
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Identical rows with a deliberate multi-CTA tie at the cutoff.
+
+    Returns (logits, expected_indices) where expected_indices is the ascending
+    int64 index list the deterministic kernel must return for every row, in the
+    tie direction this launch actually runs (an earlier oracle hard-coded
+    most-recent-wins).
+    """
+    gen = torch.Generator(device="cpu").manual_seed(19)
+    perm = torch.randperm(LARGEDET_SEQ_LEN, generator=gen, device="cpu")
+    above_idx = perm[:LARGEDET_ABOVE]
+    tie_idx = perm[LARGEDET_ABOVE : LARGEDET_ABOVE + LARGEDET_TIE]
+
+    # Filler stays in [0, 0.5) so nothing outside the two planted groups can
+    # reach the pivot; the planted values are exact binary fractions, so the
+    # 700 tie elements are bit-identical as float32 and really do tie.
+    row = torch.rand(
+        LARGEDET_SEQ_LEN, generator=gen, dtype=torch.float32, device="cpu"
+    ) * 0.5
+    row[tie_idx] = 2.0
+    row[above_idx] = 3.0
+
+    logits = row.to("cuda").unsqueeze(0).repeat(num_rows, 1).contiguous()
+
+    if tie_recent is None:
+        tie_recent = _largedet_effective_tie_recent()
+    sorted_tie = torch.sort(tie_idx).values
+    kept_tie = sorted_tie[-LARGEDET_KEPT:] if tie_recent else sorted_tie[:LARGEDET_KEPT]
+    expected = torch.sort(torch.cat([above_idx, kept_tie])).values.to(torch.int64)
+    assert expected.numel() == LARGEDET_TOP_K
+    return logits, expected
+
+
+def _run_largedet_row(logits: torch.Tensor) -> torch.Tensor:
+    num_rows, seq_len = logits.shape
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+    indices = torch.empty((num_rows, LARGEDET_TOP_K), dtype=torch.int32, device="cuda")
+    _run_topk_backend(
+        "persistent_topk", logits, lengths, indices, LARGEDET_TOP_K, seq_len
+    )
+    torch.accelerator.synchronize()
+    return indices
+
+
+def _largedet_counters_or_skip(require_on: bool) -> list[int]:
+    counters = _read_exact_counters()
+    if counters is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: this build has "
+            "no persistent_topk_exact_counters op, so the large path cannot be "
+            "shown to have run deterministically. A skip is not a pass."
+        )
+    if require_on and counters[_SLOT_DET_LARGE_ON] == 0:
+        pytest.skip(
+            "MERLIN_TOPK_DET_LARGE=0: control arm. Determinism is not claimed "
+            "here; a qualification run must also execute the arm with the "
+            "switch on."
+        )
+    if not require_on and counters[_SLOT_DET_LARGE_ON] != 0:
+        pytest.skip(
+            "MERLIN_TOPK_DET_LARGE=1: this is the control-arm test and must be "
+            "run a second time with the switch off. A qualification run needs "
+            "BOTH arms."
+        )
+    return counters
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_large_tie_keeps_highest_indices() -> None:
+    """Multi-CTA tie at the cutoff: the effective direction, ascending, reproducible."""
+    torch.set_default_device("cuda:0")
+    num_rows = 8  # <= 32 keeps the dispatch on persistent_topk
+
+    before = _largedet_counters_or_skip(require_on=True)
+
+    logits, expected = _build_largedet_tie_row(num_rows)
+    first = _run_largedet_row(logits).clone()
+    mid = _read_exact_counters()
+    second = _run_largedet_row(logits)
+    after = _read_exact_counters()
+
+    # 1. The instrument fired, with EXACT deltas. A lower bound would hide
+    #    double counting, and a green assertion below means nothing unless the
+    #    deterministic path is what produced it.
+    assert mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS] == num_rows, (
+        "the deterministic large path did not run on every row: "
+        f"{mid[_SLOT_LARGE_ROWS] - before[_SLOT_LARGE_ROWS]} of {num_rows}"
+    )
+    assert mid[_SLOT_LARGE_TIES_CUT] - before[_SLOT_LARGE_TIES_CUT] == num_rows, (
+        "the tie cut did not fire; this row is built so it must"
+    )
+    assert (
+        mid[_SLOT_LARGE_TIES_DROPPED] - before[_SLOT_LARGE_TIES_DROPPED]
+        == num_rows * LARGEDET_DROPPED
+    ), "the number of discarded pivot-equal elements is not the expected 388/row"
+    assert after[_SLOT_LARGE_FAULT] - before[_SLOT_LARGE_FAULT] == 0, (
+        "a large-path invariant fired; the output below is not meaningful"
+    )
+
+    ref_values = torch.topk(logits[0], LARGEDET_TOP_K).values.sort().values
+
+    for row in range(num_rows):
+        got = first[row].to(torch.int64)
+
+        # 2. Ascending in index. This is what makes the Python-side
+        #    MERLIN_QSA_SORT a no-op on these rows rather than a correction.
+        assert bool((got[1:] - got[:-1] > 0).all()), (
+            f"row {row}: large-path output is not ascending in index"
+        )
+
+        # 3. The set is the analytic one: everything above the pivot, plus the
+        #    312 highest- or lowest-indexed of the 700 pivot-equal elements,
+        #    whichever the effective direction says.
+        assert torch.equal(got.cpu(), expected), (
+            f"row {row}: selected set is not the "
+            f"{'most-recent' if _largedet_effective_tie_recent() else 'oldest'}"
+            "-wins set at the cutoff"
+        )
+
+        # 4. The weaker check torch.topk can make: same value multiset.
+        got_values = logits[row][got].sort().values
+        assert torch.equal(got_values, ref_values), (
+            f"row {row}: selected values are not torch.topk's values"
+        )
+
+    # 5. Bit identity across two launches on identical input -- the property
+    #    that separates this path from the arrival-ordered one at 135K.
+    assert torch.equal(first, second), (
+        "two identical launches returned different index tensors"
+    )
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@torch.inference_mode()
+def test_persistent_topk_large_control_arm_is_untouched() -> None:
+    """MERLIN_TOPK_DET_LARGE=0 must be the real v2.0.1 baseline.
+
+    Run this with the switch OFF. Two things are asserted and one deliberately
+    is not:
+
+      * the large-path counters do not move at all -- the deterministic path adds no
+        instruction to the control arm, so an A/B comparison measures the
+        kernel change and not an added atomic (as on the medium path: a
+        control arm that quietly runs a different algorithm is not a control);
+      * the returned VALUES are still exactly torch.topk's, because v2.0.1's
+        pivot is already exact -- only placement and tie membership are racy;
+      * the index SET and the emission ORDER are NOT asserted, because their
+        being unreproducible is precisely the defect the large-path change fixes. Asserting
+        either way here would be a test that cannot fail, or a flake.
+    """
+    torch.set_default_device("cuda:0")
+    num_rows = 8
+
+    before = _largedet_counters_or_skip(require_on=False)
+
