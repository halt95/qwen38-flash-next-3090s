+def _log_bounded(emit: Callable[[], None], bound_s: float) -> None:
+    """Run ``emit`` (logging, flushes) on a daemon thread; wait <= bound_s."""
+    try:
+        thread = threading.Thread(
+            target=emit, daemon=True, name="EngineCoreTeardownLog"
+        )
+        thread.start()
+        thread.join(bound_s)
