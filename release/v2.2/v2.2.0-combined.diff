+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Focused cases for the fork's startup graph-profile guard.
+
+Compile-profile guard: the qualified profile is VLLM_COMPILE +
+FULL_AND_PIECEWISE with breakable capture off and the Qwen4Exp splitting ops
+present; everything else fails loud unless the logged opt-out is set. The
+parser cases are kept from the first version.
+
+These use a plain stand-in config rather than a real ``VllmConfig``: the guard
+reads four attributes, and building a real config needs a checkpoint.
+"""
+
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.config import CompilationMode, CUDAGraphMode
+from vllm.v1 import e2_guards
+from vllm.v1.e2_guards import (
+    ALLOW_BREAKABLE_ENV,
+    BREAKABLE_ENV,
+    EXPECTED_MODE_ENV,
+    REQUIRED_SPLITTING_OPS,
+    assert_compiled_submodule,
+    assert_graph_profile_is_executable,
+    breakable_resolved,
+)
+
+
+def _config(
+    mode: CompilationMode = CompilationMode.VLLM_COMPILE,
+    cudagraph_mode: CUDAGraphMode = CUDAGraphMode.FULL_AND_PIECEWISE,
+    architectures: tuple[str, ...] = ("Qwen4ExpForCausalLM",),
+    splitting_ops: list[str] | None = None,
+):
+    if splitting_ops is None:
+        splitting_ops = list(REQUIRED_SPLITTING_OPS)
+    return SimpleNamespace(
+        model_config=SimpleNamespace(architectures=list(architectures)),
+        compilation_config=SimpleNamespace(
+            mode=mode, cudagraph_mode=cudagraph_mode, splitting_ops=splitting_ops
+        ),
+    )
+
+
+@pytest.fixture(autouse=True)
+def _clean_env(monkeypatch):
+    for name in (BREAKABLE_ENV, ALLOW_BREAKABLE_ENV, EXPECTED_MODE_ENV):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setattr("vllm.envs.VLLM_USE_BREAKABLE_CUDAGRAPH", False, raising=False)
+
+
+# --------------------------------------------------------------- the parser
+
+
+@pytest.mark.parametrize("raw", ["0", "2", "true", "True", "FALSE", "", "01"])
+def test_only_the_exact_string_one_is_on(monkeypatch, raw: str) -> None:
+    """Match envs.py:937 exactly. A stricter parser is a FALSE REJECTION."""
+    monkeypatch.setenv(BREAKABLE_ENV, raw)
+    assert breakable_resolved() is False
+
+
+def test_the_raw_reading_wins_when_envs_is_stale(monkeypatch) -> None:
+    """_maybe_enable_breakable_cudagraph mutates os.environ after envs caches."""
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    assert breakable_resolved() is True
+
+
+def test_the_envs_reading_wins_when_the_raw_value_is_absent(monkeypatch) -> None:
+    monkeypatch.setattr("vllm.envs.VLLM_USE_BREAKABLE_CUDAGRAPH", True, raising=False)
+    assert breakable_resolved() is True
+
+
+def test_an_unreadable_switch_fails_rather_than_reporting_off(monkeypatch) -> None:
+    """A guard that cannot read its own input must not answer False."""
+
+    class _Boom:
+        def __getattr__(self, name):
+            raise RuntimeError("envs unavailable")
+
+    boom = _Boom()
+    # `import vllm.envs as envs` resolves through the parent attribute first,
+    # so replace both the sys.modules entry and the attribute.
+    monkeypatch.setitem(sys.modules, "vllm.envs", boom)
+    monkeypatch.setattr(sys.modules["vllm"], "envs", boom, raising=False)
+    with pytest.raises(RuntimeError):
+        breakable_resolved()
+
+
+# ------------------------------------------------------------- the accept
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+def test_the_qualified_profile_passes(monkeypatch, role) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    assert_graph_profile_is_executable(_config(), role=role)
+
+
+def test_expected_mode_match_passes(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    monkeypatch.setenv(EXPECTED_MODE_ENV, "FULL_AND_PIECEWISE")
+    assert_graph_profile_is_executable(_config())
+
+
+# ------------------------------------------------------------- the rejections
+
+
+def test_an_unpinned_launch_fails() -> None:
+    with pytest.raises(RuntimeError, match="is not set"):
+        assert_graph_profile_is_executable(_config())
+
+
+def test_breakable_on_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    with pytest.raises(RuntimeError, match="resolved ON"):
+        assert_graph_profile_is_executable(_config())
+
+
+@pytest.mark.parametrize("role", ["target", "draft"])
+@pytest.mark.parametrize(
+    ("mode", "cudagraph_mode"),
+    [
+        (CompilationMode.NONE, CUDAGraphMode.FULL),
+        (CompilationMode.NONE, CUDAGraphMode.FULL_DECODE_ONLY),
+        (CompilationMode.NONE, CUDAGraphMode.NONE),  # eager
+        (CompilationMode.VLLM_COMPILE, CUDAGraphMode.PIECEWISE),
+        (CompilationMode.VLLM_COMPILE, CUDAGraphMode.FULL),
+        (CompilationMode.VLLM_COMPILE, CUDAGraphMode.FULL_DECODE_ONLY),
+        (CompilationMode.STOCK_TORCH_COMPILE, CUDAGraphMode.FULL_AND_PIECEWISE),
+    ],
+)
+def test_every_other_profile_fails(monkeypatch, mode, cudagraph_mode, role) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    with pytest.raises(RuntimeError, match=rf"e2-guard\[{role}\].*qualified profile"):
+        assert_graph_profile_is_executable(
+            _config(mode=mode, cudagraph_mode=cudagraph_mode), role=role
+        )
+
+
+@pytest.mark.parametrize("op", REQUIRED_SPLITTING_OPS)
+def test_each_missing_splitting_op_fails(monkeypatch, op) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    ops = [o for o in REQUIRED_SPLITTING_OPS if o != op]
+    with pytest.raises(RuntimeError, match=op):
+        assert_graph_profile_is_executable(_config(splitting_ops=ops))
+
+
+def test_unresolved_splitting_ops_fail(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = _config()
+    cfg.compilation_config.splitting_ops = None
+    with pytest.raises(RuntimeError, match="unresolved"):
+        assert_graph_profile_is_executable(cfg)
+
+
+def test_expected_mode_mismatch_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    monkeypatch.setenv(EXPECTED_MODE_ENV, "FULL_DECODE_ONLY")
+    with pytest.raises(RuntimeError, match="EXPECTED_CUDAGRAPH_MODE"):
+        assert_graph_profile_is_executable(_config())
+
+
+def test_a_missing_compilation_config_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = SimpleNamespace(
+        model_config=SimpleNamespace(architectures=["Qwen4ExpForCausalLM"]),
+        compilation_config=None,
+    )
+    with pytest.raises(RuntimeError, match="no compilation_config"):
+        assert_graph_profile_is_executable(cfg)
+
+
+def test_a_missing_model_config_fails(monkeypatch) -> None:
+    monkeypatch.setenv(BREAKABLE_ENV, "0")
+    cfg = SimpleNamespace(model_config=None, compilation_config=SimpleNamespace())
+    with pytest.raises(RuntimeError, match="no model_config"):
+        assert_graph_profile_is_executable(cfg)
+
+
+# ----------------------------------------------------- the compiled submodule
+
+
+def test_an_uncompiled_module_fails() -> None:
+    """The #55272 shape: a plain module, no torch.compile wrapper."""
+    import torch.nn as nn
+
+    with pytest.raises(RuntimeError, match=r"e2-guard\[draft\].*cudagraph_utils"):
+        assert_compiled_submodule(nn.Linear(1, 1), _config(), role="draft")
+
+
+def test_a_disabled_wrapper_fails() -> None:
+    from vllm.compilation.wrapper import TorchCompileWithNoGuardsWrapper
+
+    fake = object.__new__(type("Wrapped", (TorchCompileWithNoGuardsWrapper,), {}))
+    fake.do_not_compile = True
+    with pytest.raises(RuntimeError, match="do_not_compile=True"):
+        assert_compiled_submodule(fake, _config())
+
+
+def test_a_live_wrapper_passes() -> None:
+    from vllm.compilation.wrapper import TorchCompileWithNoGuardsWrapper
+
+    fake = object.__new__(type("Wrapped", (TorchCompileWithNoGuardsWrapper,), {}))
+    fake.do_not_compile = False
+    assert_compiled_submodule(fake, _config())
+
+
+# ------------------------------------------------------------------ the opt-out
+
+
+def test_the_opt_out_is_loud_and_skips_the_checks(monkeypatch) -> None:
+    messages: list[str] = []
+    monkeypatch.setattr(
+        e2_guards.logger,
+        "warning",
+        lambda msg, *args: messages.append(msg % args),
+    )
+    monkeypatch.setenv(ALLOW_BREAKABLE_ENV, "1")
+    monkeypatch.setenv(BREAKABLE_ENV, "1")
+    assert_graph_profile_is_executable(
+        _config(mode=CompilationMode.NONE, cudagraph_mode=CUDAGraphMode.FULL)
+    )
+    text = "\n".join(messages)
+    assert ALLOW_BREAKABLE_ENV in text
+    # The opt-out log line must say it is not a promotion (production) boot.
+    assert "promotion" in text.lower()
