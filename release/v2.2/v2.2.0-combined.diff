+def test_overflow_without_repair_keeps_stale_bytes_semantics(path):
+    """EXACT_DECODE=0 / EXACT_MEDIUM=0 overflow can leave slots the buffered
+    path never wrote this launch; they hold whatever the output tensor held.
+    The Python sort sorts those stale values too, and so must we."""
+    rng = np.random.default_rng(11)
+    for trial in range(40):
+        written = rng.permutation(8192)[: rng.integers(100, 512)]
+        stale = rng.integers(-3, 70000, 512 - written.size)
+        row = np.concatenate([written, stale]).astype(np.int32)
+        rng.shuffle(row)
+        assert_bytes(sorted_emit_row(row), canonical(row), f"{path} #{trial}")
