+
+    parent = nn.Module()
+    parent.add_module("embed_tokens", layer)
+    parent.add_module(
+        "projection",
+        nn.Linear(HIDDEN, HIDDEN, dtype=torch.bfloat16),
+    )
+
+    parent.to("cuda")
+    assert parent.projection.weight.device.type == "cuda"
+    assert layer.weight.device.type == "cpu"
+    assert layer.weight.is_pinned()
+    assert layer.weight.data_ptr() == weight_ptr
+    assert layer.weight.untyped_storage().data_ptr() == weight_storage_ptr
+    assert view.data_ptr() == view_ptr
+    assert view.untyped_storage().data_ptr() == view_storage_ptr
+
+    with pytest.raises(RuntimeError, match="fixed dtype"):
+        parent.to(torch.float32)
+    with pytest.raises(RuntimeError, match="fixed dtype"):
+        parent.half()
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA UVA")
+def test_u4_outer_post_load_preserves_pinned_uva_storage(monkeypatch):
+    vocab = 4096
+    hidden = 256
+    _set_tp(monkeypatch, 1, 2)
+    _require_cuda_pinned_memory()
+
+    # Account for construction, loading, and the outer post-load call.
+    torch.cuda.synchronize()
+    baseline = torch.cuda.memory_allocated()
+    torch.cuda.reset_peak_memory_stats()
+
+    layer = PinnedHostVocabParallelEmbedding(
+        vocab,
+        hidden,
+        params_dtype=torch.bfloat16,
+    )
+    view = layer.accelerator_weight_view
+    assert view is not None
+    weight_ptr = layer.weight.data_ptr()
+    weight_storage_ptr = layer.weight.untyped_storage().data_ptr()
+    view_ptr = view.data_ptr()
+    view_storage_ptr = view.untyped_storage().data_ptr()
+
+    loaded_weight = _weight(vocab, hidden)
+    local_table_bytes = layer.weight.numel() * layer.weight.element_size()
+
+    assert layer.weight_loader.__func__ is VocabParallelEmbedding.weight_loader
+    layer.weight_loader(layer.weight, loaded_weight)
+
+    model = nn.Module()
+    model.add_module("embed_tokens", layer)
+    monkeypatch.setattr(
+        loader_utils,
+        "maybe_retie_word_embeddings",
+        lambda *args, **kwargs: None,
+    )
+    loader_utils.process_weights_after_loading(
+        model,
+        SimpleNamespace(quantization=None),
+        torch.device("cuda"),
+    )
+
+    torch.cuda.synchronize()
+    peak_growth = torch.cuda.max_memory_allocated() - baseline
+
+    assert layer.weight.device.type == "cpu"
+    assert layer.weight.is_pinned()
+    assert layer.weight.data_ptr() == weight_ptr
+    assert layer.weight.untyped_storage().data_ptr() == weight_storage_ptr
+    assert view.device.type == "cuda"
+    assert view.shape == layer.weight.shape
+    assert view.dtype == layer.weight.dtype
+    assert view.data_ptr() == view_ptr
+    assert view.untyped_storage().data_ptr() == view_storage_ptr
+    assert set(dict(layer.named_parameters())) == {"weight"}
+    assert peak_growth < local_table_bytes
+
+    expected = loaded_weight.narrow(0, vocab // 2, vocab // 2)
+    _assert_same_bytes(layer.weight, expected)
+
+    # Pointer stability alone is insufficient: mutate the retained CPU
+    # parameter and prove that the CUDA view reads that same storage.
+    local_row = 7
+    global_id = vocab // 2 + local_row
+    sentinel = torch.arange(hidden, dtype=torch.float32).to(torch.bfloat16)
+    layer.weight[local_row].copy_(sentinel)
+    actual = layer(torch.tensor([global_id], device="cuda"))
+    torch.cuda.synchronize()
+    _assert_same_bytes(actual[0].cpu(), sentinel)
+
+
+@pytest.mark.skipif(
+    os.environ.get("VLLM_RUN_HOST_EMBED_BUDGET") != "1",
+    reason="set VLLM_RUN_HOST_EMBED_BUDGET=1 for the 606 MiB allocation report",
+)
+def test_u5_report_production_shard_host_allocation(monkeypatch):
+    _require_cuda_pinned_memory()
+    if not hasattr(torch.cuda, "host_memory_stats"):
+        pytest.skip("torch.cuda.host_memory_stats is unavailable")
+
+    _set_tp(monkeypatch, 0, 2)
+    before = torch.cuda.host_memory_stats()
+    allocated_key = "allocated_bytes.all.current"
+    reserved_key = "reserved_bytes.all.current"
+    if allocated_key not in before or reserved_key not in before:
+        pytest.skip("host allocator byte statistics are unavailable")
+
+    try:
+        layer = PinnedHostVocabParallelEmbedding(
+            248_320,
+            2_560,
+            params_dtype=torch.bfloat16,
+        )
+    except RuntimeError as exc:
+        pytest.skip(f"production-sized pinned allocation is unavailable: {exc}")
+
+    after = torch.cuda.host_memory_stats()
+    payload_bytes = layer.weight.numel() * layer.weight.element_size()
+    allocated_delta = after[allocated_key] - before[allocated_key]
+    reserved_delta = after[reserved_key] - before[reserved_key]
+    print(
+        "HOST_EMBED_PINNED_BUDGET "
+        f"payload_bytes={payload_bytes} "
+        f"allocated_bytes={allocated_delta} "
+        f"reserved_bytes={reserved_delta}"
+    )
+    assert payload_bytes == 635_699_200
+    assert layer.weight.is_pinned()
diff --git a/tests/models/qwen4_exp/test_ple_fp8_selector_checkpoint.py b/tests/models/qwen4_exp/test_ple_fp8_selector_checkpoint.py
new file mode 100644
index 0000000000..815a22fc08
--- /dev/null
+++ b/tests/models/qwen4_exp/test_ple_fp8_selector_checkpoint.py
@@ -0,0 +1,276 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The shipped Flash-Next checkpoint must still select the FP8 PLE method on v0.30.0.
+
+Why this file exists (vLLM 0.30 rebase). Our
+fork used to force the FP8 PLE embedding method from a 21-line catch-all branch
+in ``_get_ple_embedding_quant_method``. That function lived in the half of
+``vllm/models/qwen4_exp/nvidia/ple_layer.py`` that upstream #54371 deleted, so
+the branch is gone from the 0.30 base and the environment switch that fed it
+(``VLLM_PLE_FP8_GLOBAL_SCALE``) is now inert.
+
+v0.30.0 selects instead in ``Qwen4ExpPLEEmbeddingMethod.from_quant_config``
+(``ngram_embedding.py:168-208``), which is stricter: it takes the FP8 path from
+``text_config.ple_embedding_dtype == "float8_e4m3fn"`` (``:174-175``), and for a
+quantization config that is neither ``Fp8Config`` nor a ModelOpt variant it
+**raises** ``NotImplementedError`` (``:186-190``). Our checkpoint is
+compressed-tensors, so without that key the model would not build at all.
+
+The first version of this file was rejected for reading a plain dict and
+never exercising the resolution chain, for naming the wrong engine prefix, and
+for conflating a dequantization check with a scale-loading check. This version
+walks the real chain --
+``Qwen4ExpConfig(**config.json)`` (``models/qwen4_exp/config.py:231``)
+-> ``get_hf_text_config()`` (``transformers_utils/config.py:1142``)
+-> ``getattr(text_config, "ple_embedding_dtype")`` as
+``ngram_embedding.py:694-699`` reads it -- and keeps the three questions apart.
+
+Fixture provenance: the published checkpoint's ``config.json``, the
+published v2.0.1 card. Excerpted verbatim for every field the
+selector or the resolver touches; ``config_groups`` keeps one representative
+group and ``ignore`` its first nine entries.
+"""
+
+import pytest
+
+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors import (  # noqa: E501
+    CompressedTensorsConfig,
+)
+from vllm.model_executor.layers.quantization.fp8 import Fp8Config
+from vllm.models.qwen4_exp.nvidia.ngram_embedding import (
+    Qwen4ExpPLEEmbeddingMethod,
+    Qwen4ExpPLEFp8EmbeddingMethod,
+    Qwen4ExpPLEUnquantizedEmbeddingMethod,
+)
+
+# ``ple_layer_ids = [2]`` selects the decoder layer whose ``layer_idx + 1`` is 2
+# (``nvidia/model.py:303``), i.e. zero-based layer **1** -- not layer 2. The
+# multimodal entry class wraps the text model under ``language_model``
+# (``nvidia/model.py:1111-1114``); the PLE layer prefix is ``.ple``
+# (``:309-314``), the embedding ``.ple_embedding`` (``ple_layer.py:102``) and
+# the table ``.ngram_embedding`` (``ngram_embedding.py``).
+_PLE_PREFIX_MM = "language_model.model.layers.1.ple.ple_embedding.ngram_embedding"
+_PLE_PREFIX_TEXT = "model.layers.1.ple.ple_embedding.ngram_embedding"
+
+# ---------------------------------------------------------------------------
+# Verbatim excerpt of the shipped checkpoint's config.json.
+# ---------------------------------------------------------------------------
+SHIPPED_CONFIG = {
+    "architectures": ["Qwen4ExpForConditionalGeneration"],
+    "model_type": "qwen4_exp",
+    "image_token_id": 248056,
+    "video_token_id": 248057,
+    "vision_start_token_id": 248053,
+    "vision_end_token_id": 248054,
+    "tie_word_embeddings": False,
+    "text_config": {
+        "model_type": "qwen4_exp_text",
+        # The key the whole selection now hangs on.
+        "ple_embedding_dtype": "float8_e4m3fn",
+        "ple_layer_ids": [2],
+    },
+    "quantization_config": {
+        "quant_method": "compressed-tensors",
+        "format": "pack-quantized",
+        "quantization_status": "compressed",
+        "kv_cache_scheme": None,
+        "sparsity_config": {},
+        "transform_config": {},
+        "config_groups": {
+            "group_0": {
+                "targets": ["Linear"],
+                "weights": {
+                    "num_bits": 4,
+                    "type": "int",
+                    "symmetric": True,
+                    "strategy": "group",
+                    "group_size": 128,
+                    "dynamic": False,
+                    "observer": "minmax",
+                    "observer_kwargs": {},
+                    "actorder": None,
+                    "block_structure": None,
+                },
+            },
+        },
+        # The PLE is EXCLUDED from the quantization config -- which is exactly
+        # why the type-based dispatch cannot see that the table is FP8.
+        "ignore": [
+            "lm_head",
+            "re:.*embed_tokens.*",
+            "re:.*\\.ple\\..*",
+            "re:.*visual\\..*",
+            "re:.*\\.gate$",
+            "re:.*hyper_connection.*",
+            "re:.*indexer.*",
+            "re:.*shared_expert.*",
+            "re:.*\\.self_attn\\..*",
+        ],
+    },
+}
+
+
+def _quant_config() -> CompressedTensorsConfig:
+    import copy
+
+    return CompressedTensorsConfig.from_config(
+        copy.deepcopy(SHIPPED_CONFIG["quantization_config"])
+    )
+
+
+def _resolved_text_config():
+    """Walk the real chain the engine walks, not a dict lookup.
+
+    ``ModelConfig`` stores ``get_hf_text_config(self.hf_config)``
+    (``config/model.py:641``); that calls ``PretrainedConfig.get_text_config()``
+    (``transformers_utils/config.py:1142``); ``Qwen4ExpConfig.__init__`` builds
+    the nested ``Qwen4ExpTextConfig`` from the ``text_config`` dict
+    (``models/qwen4_exp/config.py:231``).
+    """
+    import copy
+
+    from vllm.models.qwen4_exp.config import Qwen4ExpConfig
+    from vllm.transformers_utils.config import get_hf_text_config
+
+    raw = copy.deepcopy(SHIPPED_CONFIG)
+    raw.pop("architectures", None)
+    raw.pop("model_type", None)
+    return get_hf_text_config(Qwen4ExpConfig(**raw))
+
+
+def _embedding_dtype_as_the_engine_reads_it(text_config) -> str | None:
+    """``ngram_embedding.py:694-699`` -> ``getattr(config, "ple_embedding_dtype")``."""
+    return getattr(text_config, "ple_embedding_dtype", None)
+
+
+# --------------------------------------------------------------------------
+# 1. the resolution chain
+# --------------------------------------------------------------------------
+
+
+def test_the_key_survives_the_real_text_config_resolution() -> None:
+    """THE CHAIN: nested dict -> Qwen4ExpConfig -> get_hf_text_config -> getattr."""
+    text_config = _resolved_text_config()
+    assert _embedding_dtype_as_the_engine_reads_it(text_config) == "float8_e4m3fn"
+    assert list(text_config.ple_layer_ids) == [2]
+
+
+def test_a_top_level_only_key_is_lost_on_the_text_path() -> None:
+    """RESIDUAL RISK, made executable.
+
+    A checkpoint copy that carried the key at the top level of a NESTED config
+    would not be seen by ``hf_text_config``, and the same checkpoint would then
+    hit the raise. This is a known caveat of the 0.30 port.
+    It says nothing about a FLAT config, which ``Qwen4ExpConfig`` converts into
+    a text config itself -- do not generalise it.
+    """
+    import copy
+
+    from vllm.models.qwen4_exp.config import Qwen4ExpConfig
+    from vllm.transformers_utils.config import get_hf_text_config
+
+    raw = copy.deepcopy(SHIPPED_CONFIG)
+    raw.pop("architectures", None)
+    raw.pop("model_type", None)
+    raw["ple_embedding_dtype"] = raw["text_config"].pop("ple_embedding_dtype")
+    text_config = get_hf_text_config(Qwen4ExpConfig(**raw))
+    assert _embedding_dtype_as_the_engine_reads_it(text_config) is None
+
+
+# --------------------------------------------------------------------------
+# 2. the selector
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("prefix", [_PLE_PREFIX_MM, _PLE_PREFIX_TEXT])
+def test_shipped_checkpoint_selects_the_fp8_ple_method(prefix: str) -> None:
+    """THE PROPERTY: compressed-tensors + the resolved key -> FP8 PLE, no raise.
+
+    Parametrised over both prefixes because the config-key branch precedes every
+    prefix-dependent check; if that ever stops being true, this fails.
+    """
+    method = Qwen4ExpPLEEmbeddingMethod.from_quant_config(
+        _quant_config(),
+        prefix,
+        _embedding_dtype_as_the_engine_reads_it(_resolved_text_config()),
+    )
+    assert isinstance(method, Qwen4ExpPLEFp8EmbeddingMethod)
+
+
+def test_without_the_config_key_the_shipped_checkpoint_raises() -> None:
+    """FAILING CONTROL: the key is load-bearing, not decorative.
+
+    Drop it and the same checkpoint hits ``ngram_embedding.py:186-190``. If this
+    stops raising, upstream has widened the selector and the offline conclusion
+    must be re-read -- it does not mean we are safer.
+    """
+    with pytest.raises(NotImplementedError):
+        Qwen4ExpPLEEmbeddingMethod.from_quant_config(
+            _quant_config(), _PLE_PREFIX_MM, None
+        )
+
+
+def test_the_key_beats_an_otherwise_unquantized_verdict() -> None:
+    """The key short-circuits before the ignore-list check.
+
+    ``re:.*\\.ple\\..*`` puts our PLE in the ignore list. On an ``Fp8Config``
+    that resolves to the *unquantized* method -- shown here as the contrast --
+    so the key must win, or an FP8 table would be read as bf16.
+    """
+    fp8_config = Fp8Config(
+        is_checkpoint_fp8_serialized=True, ignored_layers=[_PLE_PREFIX_MM]
+    )
+    assert isinstance(
+        Qwen4ExpPLEEmbeddingMethod.from_quant_config(fp8_config, _PLE_PREFIX_MM, None),
+        Qwen4ExpPLEUnquantizedEmbeddingMethod,
+    )
+    assert isinstance(
+        Qwen4ExpPLEEmbeddingMethod.from_quant_config(
+            fp8_config, _PLE_PREFIX_MM, "float8_e4m3fn"
+        ),
+        Qwen4ExpPLEFp8EmbeddingMethod,
+    )
+
+
+# --------------------------------------------------------------------------
+# 3. the scale -- a SEPARATE question from selection
+# --------------------------------------------------------------------------
+
+
+def test_fp8_ple_method_rejects_an_unloaded_global_scale() -> None:
+    """Sentinel rejection only. This does NOT prove checkpoint scale LOADING.
+
+    ``create_fp8_scale_parameter`` fills the parameter with the float32 sentinel
+    and the weight loader is expected to overwrite it; proving that the loader
+    does so needs a checkpoint shard, which belongs to a reference-host loader test,
+    not here.
+    """
+    import torch
+    from torch import nn
+
+    method = Qwen4ExpPLEFp8EmbeddingMethod()
+    unloaded = nn.Module()
+    unloaded.weight_scale = nn.Parameter(
+        torch.full((1,), torch.finfo(torch.float32).min, dtype=torch.float32),
+        requires_grad=False,
+    )
+    with pytest.raises(ValueError, match="missing its global scale"):
+        method.process_weights_after_loading(unloaded)
+
+
+def test_fp8_ple_dequantization_applies_the_scale() -> None:
+    """Dequantization arithmetic only, with a hand-set scale. Not loading."""
+    import torch
+    from torch import nn
+
+    method = Qwen4ExpPLEFp8EmbeddingMethod()
+    loaded = nn.Module()
+    loaded.weight_scale = nn.Parameter(
+        torch.tensor([0.25], dtype=torch.float32), requires_grad=False
+    )
+    method.process_weights_after_loading(loaded)  # must not raise
+
+    embeddings = torch.tensor([[1.0, 2.0]], dtype=torch.float32)
+    torch.testing.assert_close(
+        method.dequantize(loaded, embeddings, torch.float32), embeddings * 0.25
+    )
diff --git a/tests/models/qwen4_exp/test_qsa_backend_capability.py b/tests/models/qwen4_exp/test_qsa_backend_capability.py
new file mode 100644
index 0000000000..81122b9bf9
--- /dev/null
+++ b/tests/models/qwen4_exp/test_qsa_backend_capability.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Capability contract of ``Qwen4ExpQSAFlashAttentionBackend``.
+
+QSA stores e4m3 bytes in a uint8 cache written by ``reshape_and_cache_flash``
+and dequantizes them inside its own Triton kernel; flash-attn never runs over
+that cache. The backend therefore overrides two capability classmethods so the
+parent's flash-attn fp8 probe cannot veto the configuration.
+
+``AttentionBackend.validate_configuration`` (vllm/v1/attention/backend.py:262)
+is the entry point that calls both -- ``supports_kv_cache_dtype`` at :289 and
+``supports_combination`` at :335 -- so it is what these tests drive.
+
+ON WHAT THIS DOES AND DOES NOT ESTABLISH. ``Qwen4ExpQSAAttention.__init__``
+(nvidia/qsa.py) assigns ``self.attn_backend = Qwen4ExpQSAFlashAttentionBackend``
+and constructs the impl directly; ``QWEN4_EXP_QSA_TRITON`` is not in the
+selection registry, so a boot does not route this class through
+``platforms/cuda.py``'s ``validate_configuration`` call. These tests therefore
+pin the backend's declared contract, not a boot outcome, and a boot with the
+overrides removed is NOT guaranteed to fail. (``vllm/models/hy_v4/nvidia/
+attention.py:604`` shows the in-tree pattern for a model that does validate its
+own backend explicitly; QSA does not do that today.) The fp8-cache gate that a
+boot actually hits is ``_validated_qsa_fp8_dtype`` plus the
+``_QSA_SUPPORTED_CACHE_DTYPES`` check in ``Qwen4ExpQSAAttention.__init__``.
+"""
+
+import pytest
+import torch
+
+from vllm.config.cache import CacheDType
+from vllm.models.qwen4_exp.nvidia.qsa import Qwen4ExpQSAFlashAttentionBackend
+from vllm.platforms.interface import DeviceCapability
+from vllm.v1.attention.backend import AttentionType
+from vllm.v1.attention.backends.flash_attn import FlashAttentionBackend
+
+pytestmark = pytest.mark.cpu_test
+
+# sm_86: the capability this fork's QSA fp8 path is gated to.
+_SM86 = DeviceCapability(8, 6)
+_FA_PROBE = "vllm.v1.attention.backends.flash_attn.flash_attn_supports_kv_cache_dtype"
+_FP8_REASON = "FP8 KV cache requires"
+_DTYPE_REASON = "kv_cache_dtype not supported"
+
+
+class _NoOverrideBackend(Qwen4ExpQSAFlashAttentionBackend):
+    """The same backend with exactly the two overrides taken away.
+
+    ``__func__`` is unwrapped and re-wrapped so ``cls`` still binds to this
+    subclass: it keeps our ``supported_kv_cache_dtypes`` and differs from the
+    real backend in nothing but the two methods under test. Assigning the bound
+    parent classmethods instead would silently swap the dtype list too, and the
+    control would no longer isolate the overrides.
+    """
+
+    supports_kv_cache_dtype = classmethod(
+        FlashAttentionBackend.supports_kv_cache_dtype.__func__
+    )
+    supports_combination = classmethod(
+        FlashAttentionBackend.supports_combination.__func__
+    )
+
+
+def _validate(backend, kv_cache_dtype: CacheDType | None, **overrides):
+    kwargs = dict(
+        head_size=128,
+        dtype=torch.bfloat16,
+        kv_cache_dtype=kv_cache_dtype,
+        block_size=16,
+        use_mla=False,
+        has_sink=False,
+        use_sparse=True,  # QSA.is_sparse() is True
+        use_mm_prefix=False,
+        use_per_head_quant_scales=False,
+        device_capability=_SM86,
+        attn_type=AttentionType.DECODER,
+    )
+    kwargs.update(overrides)
+    return backend.validate_configuration(**kwargs)
+
+
+def _combination(backend, kv_cache_dtype: CacheDType | None, **overrides):
+    kwargs = dict(
+        head_size=128,
+        dtype=torch.bfloat16,
+        kv_cache_dtype=kv_cache_dtype,
+        block_size=16,
+        use_mla=False,
+        has_sink=False,
+        use_sparse=True,
+        use_mm_prefix=False,
+        device_capability=_SM86,
+    )
+    kwargs.update(overrides)
+    return backend.supports_combination(**kwargs)
+
+
+@pytest.mark.parametrize("kv_cache_dtype", ["fp8", "fp8_e4m3"])
+def test_fp8_survives_validation_with_the_fa_probe_rejecting(
+    monkeypatch, kv_cache_dtype
+):
+    """With the flash-attn fp8 probe forced to reject, the overridden backend
+    must still accept the dtype, and the control without the overrides must not.
+
+    Forcing the probe is what makes this a test that can fail: on a host where
+    flash-attn happens to support fp8 the parent would accept it too, and the
+    override would be indistinguishable from its absence
+    (an instrument must discriminate both worlds).
+
+    Assertions are on the two specific reasons rather than on an empty list,
+    so unrelated reasons a particular host contributes cannot mask or fake the
+    result.
+    """
+    monkeypatch.setattr(_FA_PROBE, lambda *a, **k: False)
+
+    ours = _validate(Qwen4ExpQSAFlashAttentionBackend, kv_cache_dtype)
+    assert _DTYPE_REASON not in ours
+    assert not any(_FP8_REASON in r for r in ours), ours
+
+    # FAILING CONTROL: remove the overrides, keep everything else.
+    control = _validate(_NoOverrideBackend, kv_cache_dtype)
+    assert _DTYPE_REASON in control, (
+        "the parent must reject this dtype once the probe rejects it; if it "
+        "does not, this test proves nothing about the override"
+    )
+    assert any(_FP8_REASON in r for r in control), control
+
+    # The two classes must differ in exactly these reasons and nothing else.
+    assert set(control) - set(ours) == {
+        _DTYPE_REASON,
+        *(r for r in control if _FP8_REASON in r),
+    }
+    assert not set(ours) - set(control)
+
+
+def test_bfloat16_path_is_untouched(monkeypatch):
+    """The overrides must not change the non-quantized cache at all: the parent
+    never consults the fp8 probe for it, so both classes must agree."""
+    monkeypatch.setattr(_FA_PROBE, lambda *a, **k: False)
+    for kv_cache_dtype in ("auto", "bfloat16"):
+        assert _validate(Qwen4ExpQSAFlashAttentionBackend, kv_cache_dtype) == _validate(
+            _NoOverrideBackend, kv_cache_dtype
+        )
+
+
+def test_unsupported_cache_dtype_is_still_rejected():
+    """``supports_kv_cache_dtype`` overrides the flash-attn probe, not the
