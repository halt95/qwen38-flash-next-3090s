+            f"control arm touched the large-path {name} counter; it is not the "
+            "v2.0.1 baseline"
+        )
+
+    ref_values = torch.topk(logits[0], LARGEDET_TOP_K).values.sort().values
+    for row in range(num_rows):
+        got = out[row].to(torch.int64)
