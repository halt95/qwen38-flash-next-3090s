+# ---------------------------------------------------------------------------
+# Medium-path candidate-buffer overflow, exact restart
+#
+# The medium path (8192 < seq_len <= 32768 compressed columns) buffers the
+# coarse threshold bin's candidates into a 4,096-slot shared buffer and
+# increments the next-level histogram inside the capacity guard, so a dropped
+# candidate is invisible to refinement.  A narrow logit distribution collapses
+# far more than 4,096 values into one coarse bin and the returned set stops
+# being a top-k.
+#
+# These tests assert three things, and the third is the one upstream's own
+# regression (vLLM PR #52149) cannot see, because it sorts before comparing:
+#   1. the selected values are exactly torch.topk's,
+#   2. the instrument fired (overflow detected, exact restart taken, no fault)
+#      -- without this a pass proves nothing about the patched path,
+#   3. two runs return bit-identical index tensors, in ascending index order.
+# ---------------------------------------------------------------------------
+
+# Slot map of torch.ops._C.persistent_topk_exact_counters (see
+# csrc/libtorch_stable/topk.cu).  Eleven slots, the
+# union of the tie-determinism and large-path determinism layouts with nothing renumbered -- the large path appended four
+# large-path counters and a second switch flag (so the medium-path "enabled" flag
+# moved from [4] to [8]) and the tie-determinism change numbered its decode counter AROUND that
+# block at [10].  Slots 8-9 are `kSlotSwitchMedium` / `kSlotSwitchLarge` in
+# the kernel: host-written flags, not device counters.
+_EXACT_COUNTER_SLOTS = 11
+_SLOT_MEDIUM_ROWS = 0
+_SLOT_MEDIUM_OVERFLOW = 1
+_SLOT_MEDIUM_FALLBACK = 2
+_SLOT_MEDIUM_FAULT = 3
+_SLOT_LARGE_ROWS = 4
+_SLOT_LARGE_TIES_CUT = 5
+_SLOT_LARGE_TIES_DROPPED = 6
+_SLOT_LARGE_FAULT = 7
+_SLOT_EXACT_MEDIUM_ON = 8
+_SLOT_DET_LARGE_ON = 9
+_SLOT_DECODE_OVERFLOW = 10
+
+
+def _read_exact_counters() -> list[int] | None:
+    """Cumulative counters + the two switch flags, or None.
+
+    [0..3] medium:  rows, overflow, exact fallbacks, faults.
+    [4..7] large:   deterministic rows, tie cuts, elements cut, faults.
+    [8]    MERLIN_TOPK_EXACT_MEDIUM, [9] MERLIN_TOPK_DET_LARGE.
+    [10]   decode overflow.
+    """
+    op = getattr(torch.ops._C, "persistent_topk_exact_counters", None)
+    if op is None:
+        return None
+    # int64: the large-path determinism change widened the device counters to 64 bits
+    # and the op now rejects int32. See topk.cu's protocol-version-2 note.
+    out = torch.zeros(_EXACT_COUNTER_SLOTS, dtype=torch.int64, device="cuda")
+    # sync=1: the counters are device-global but the snapshot is issued on one
+    # stream, so without a device synchronize it can miss increments from work
+    # still in flight elsewhere. The tests compare before/after deltas, so a
+    # stream-ordered read would be a source of flakes, not just imprecision.
+    op(out, 0, 1)
+    return out.cpu().tolist()
+
+
+def _run_medium_overflow_row(
+    num_rows: int, seq_len: int, top_k: int, seed: int
+) -> tuple[torch.Tensor, torch.Tensor]:
+    set_random_seed(seed)
+    # The all-overflow distribution from vLLM issue #51782 / PR #52149: every
+    # value lands in one coarse FP16 bin, so the threshold bin's population is
+    # the whole row and the 4,096-slot buffer cannot hold it.
+    logits = 1.0 + torch.rand(
+        (num_rows, seq_len), dtype=torch.float32, device="cuda"
+    ) * 0.01
+    lengths = torch.full((num_rows,), seq_len, dtype=torch.int32, device="cuda")
+    indices = torch.empty((num_rows, top_k), dtype=torch.int32, device="cuda")
+    _run_topk_backend("persistent_topk", logits, lengths, indices, top_k, seq_len)
+    torch.accelerator.synchronize()
+    return logits, indices
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="This test requires CUDA")
+@pytest.mark.parametrize("top_k", [512, 2048])
+@pytest.mark.parametrize("seq_len", [12288, 32768])
+@torch.inference_mode()
+def test_persistent_topk_medium_overflow_is_exact(top_k: int, seq_len: int) -> None:
+    """> 4,096 candidates in one coarse bin must still return a true top-k."""
+    torch.set_default_device("cuda:0")
+    num_rows = 8  # <= 32 keeps the dispatch on persistent_topk
+
+    before = _read_exact_counters()
+    if before is None:
+        pytest.skip(
+            "QUALIFICATION FAILURE if seen on the branch build: this build has "
+            "no persistent_topk_exact_counters op, so the exact path cannot be "
+            "shown to have run. A skip here does not count as a pass."
+        )
+    if before[_SLOT_EXACT_MEDIUM_ON] == 0:
+        pytest.skip(
+            "MERLIN_TOPK_EXACT_MEDIUM=0: control arm. Exactness is not claimed "
+            "here, but a qualification run must also execute the arm with the "
+            "switch on."
+        )
+
+    logits, indices = _run_medium_overflow_row(num_rows, seq_len, top_k, seed=0)
+    after = _read_exact_counters()
+
+    # The instrument must discriminate: a green assertion below is meaningless
+    # unless the overflow actually happened and the exact path actually ran.
+    # EXACT deltas, not lower bounds -- ">= num_rows" would hide duplicate
+    # counting (the per-pass double-count this branch specifically fixes) and
+    # contamination from other CUDA work on the device.
+    assert after[0] - before[0] == num_rows, (
+        f"expected exactly {num_rows} medium rows, saw {after[0] - before[0]}"
+    )
+    assert after[1] - before[1] == num_rows, (
+        f"expected exactly {num_rows} overflow events, saw {after[1] - before[1]}"
+    )
+    assert after[2] - before[2] == num_rows, (
+        f"expected exactly {num_rows} exact fallbacks, saw "
+        f"{after[2] - before[2]}"
+    )
+    assert after[3] == before[3], "the exact fallback reported a fault"
+
+    for row in range(num_rows):
+        reference = torch.topk(logits[row], top_k)
+        got = indices[row].to(torch.int64)
+
+        # Values must match exactly -- not approximately.
+        got_vals = logits[row][got].sort(descending=True).values
+        assert torch.equal(got_vals, reference.values.sort(descending=True).values), (
+            f"row {row}: selected values are not the top-{top_k}"
+        )
+
+        # With float32 samples an exact tie at the cutoff is vanishingly
+        # unlikely; assert set equality only when the boundary is unambiguous,
+        # so the test never passes by accident on a tie.
+        boundary = torch.topk(logits[row], top_k + 1).values
+        if boundary[top_k - 1] != boundary[top_k]:
+            assert set(got.cpu().tolist()) == set(reference.indices.cpu().tolist()), (
+                f"row {row}: selected index set differs from torch.topk"
+            )
+
+        assert len(set(got.cpu().tolist())) == top_k, f"row {row}: duplicate indices"
+
+
