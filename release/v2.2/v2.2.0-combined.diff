+def test_unaudited_gate_discriminates_both_worlds():
+    """Control for the gate above: it must be able to FAIL.
+
+    A membership test that reports the same thing in the registered and the
+    unregistered world measures nothing -- which is precisely how the previous
+    whole-file version passed unnoticed. So assert the scan reports differently on
+    a source that lists a knob inside the fence and one that names it only
+    outside, and assert the real envs.py is in the state the gate claims.
+    """
+    listed = "\n".join(
+        [_UNAUDITED_START, "    #     MERLIN_EXAMPLE", _UNAUDITED_END, ""]
+    )
+    registered = "\n".join(
+        [
+            "    # MERLIN_EXAMPLE was classified and removed from the fence.",
+            _UNAUDITED_START,
+            _UNAUDITED_END,
+            "    MERLIN_EXAMPLE: str | None = None",
+            '    "MERLIN_EXAMPLE": lambda: os.getenv("MERLIN_EXAMPLE", None),',
+            "",
+        ]
+    )
+    assert "MERLIN_EXAMPLE" in _unaudited_names(listed)
+    assert "MERLIN_EXAMPLE" not in _unaudited_names(registered)
+    # The whole-file scan the defective version used cannot tell them apart,
+    # and neither can a substring scan of the fence.
+    assert "MERLIN_EXAMPLE" in listed and "MERLIN_EXAMPLE" in registered
+
+    # And the live file really is in both states at once, one knob each way.
+    names = _unaudited_names(_envs_source())
+    assert "MERLIN_FULL_K" in _envs_source()
+    assert "MERLIN_FULL_K" not in names
+    assert "MERLIN_PIN_BSM" in names
+
+    # A missing fence must fail loudly rather than scan nothing.
+    with pytest.raises(AssertionError):
+        _unaudited_names("no markers here")
