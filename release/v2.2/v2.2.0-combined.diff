+        (_SLOT_LARGE_ROWS, "rows"),
+        (_SLOT_LARGE_TIES_CUT, "ties_cut"),
+        (_SLOT_LARGE_TIES_DROPPED, "ties_dropped"),
+        (_SLOT_LARGE_FAULT, "faults"),
