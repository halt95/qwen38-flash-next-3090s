+@pytest.mark.parametrize("top_k", [512, 1024, 2048])
+def test_pathological_rows_take_the_fallback_and_still_match(top_k):
+    rng = np.random.default_rng(top_k)
+    cases = {
+        "duplicates": rng.integers(0, 64, top_k),
+        "stale_mixed": np.concatenate(
+            [
+                rng.permutation(8192)[: top_k // 2],
+                rng.integers(-5, 40000, top_k - top_k // 2),
+            ]
+        ),
+        "beyond_bitmap": rng.integers(30000, 300000, top_k),
+        "int32_max": np.where(
+            rng.random(top_k) < 0.1, INT32_MAX, rng.permutation(top_k * 4)[:top_k]
+        ),
+        "odd_negatives": np.where(
+            rng.random(top_k) < 0.3,
+            rng.integers(-100, 0, top_k),
+            rng.permutation(top_k * 8)[:top_k],
+        ),
+        "all_padding": np.full(top_k, -1),
+        "int32_min": np.where(
+            rng.random(top_k) < 0.2, -(2**31), rng.permutation(top_k * 2)[:top_k]
+        ),
+        "exact_32768": np.concatenate([[32767, 32768], np.arange(top_k - 2)]),
+    }
+    for name, row in cases.items():
+        row = row.astype(np.int32)
+        rng.shuffle(row)
+        assert_bytes(sorted_emit_row(row), canonical(row), name)
