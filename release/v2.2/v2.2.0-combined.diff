+# SPDX-License-Identifier: Apache-2.0
+
+import ctypes
+import ctypes.util
+import inspect
+import json
+import multiprocessing
+import os
+import pickle
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+from multiprocessing.connection import Connection
+from pathlib import Path
+
+import pytest
+
+
+def _native_cuda_probe(output_path: str) -> None:
+    """Run during config unpickling, before the bootstrap imports vLLM."""
+    library = ctypes.util.find_library("cudart")
+    if library is None:
+        os._exit(77)
+    cudart = ctypes.CDLL(library)
+    result = int(cudart.cudaFree(ctypes.c_void_p()))
+    Path(output_path).write_text(
+        json.dumps(
+            {
+                "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES"),
+                "cuda_result": result,
+                "torch_imported": "torch" in sys.modules,
+                "vllm_imported": "vllm" in sys.modules,
+            }
+        ),
+        encoding="utf-8",
+    )
+    os._exit(0)
+
+
+class _ProbePayload:
+    def __init__(self, output_path: str) -> None:
+        self.output_path = output_path
+
+    def __reduce__(self):
+        # The bootstrap interpreter cannot import this test module, so rebuild
+        # the probe from its source text through a builtin instead of by name.
+        source = (
+            "import ctypes, ctypes.util, json, os, sys\n"
+            "from pathlib import Path\n"
+            + inspect.getsource(_native_cuda_probe)
+            + f"_native_cuda_probe({self.output_path!r})\n"
+        )
+        return exec, (source, {})
+
+
+def test_spawn_bootstrap_sets_visibility_before_native_cuda(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from vllm.v1.ple_offload.worker import PleOffloadWorker
+
+    if ctypes.util.find_library("cudart") is None:
+        pytest.skip("CUDA runtime is not installed")
+
+    original = os.environ.get("CUDA_VISIBLE_DEVICES")
+    output_path = tmp_path / "probe.json"
+
+    # Use the production Popen launcher. Config reconstruction executes the
+    # probe in the fresh bootstrap interpreter before worker imports.
+    with monkeypatch.context() as child_settings:
+        child_settings.setenv("CUDA_VISIBLE_DEVICES", "0")
+        handle = PleOffloadWorker.make_process(
+            _ProbePayload(str(output_path)), 0, "unused"
+        )
+        try:
+            returncode = handle.proc.wait(timeout=120)
+        finally:
+            handle.close()
+
+    if returncode == 77:
+        pytest.skip("spawned child could not load the CUDA runtime")
+    assert returncode == 0
+
+    result = json.loads(output_path.read_text(encoding="utf-8"))
+    assert result["cuda_visible_devices"] == "0"
+    assert result["cuda_result"] == 0
+    assert result["torch_imported"] is False
+    assert result["vllm_imported"] is False
+    assert os.environ.get("CUDA_VISIBLE_DEVICES") == original
+
+
+class _FreshInterpreterProbe:
+    def __init__(self, output_path: str) -> None:
+        self.output_path = output_path
+
+    def __reduce__(self):
+        expression = (
+            "(__import__('pathlib').Path("
+            + repr(self.output_path)
+            + ").write_text(__import__('json').dumps({"
+            "'cuda_visible_devices': __import__('os').environ.get("
+            "'CUDA_VISIBLE_DEVICES'),"
+            "'torch_imported': 'torch' in __import__('sys').modules,"
+            "'vllm_imported': 'vllm' in __import__('sys').modules"
+            "}), encoding='utf-8'), None)[1]"
+        )
+        return eval, (expression,)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+def test_fresh_interpreter_has_child_environment_before_vllm_import(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from vllm.v1.ple_offload.worker import PleOffloadWorker
+
+    # This test module has unconditional top-level imports. The dedicated
+    # bootstrap interpreter must not import it as __mp_main__.
+    original = os.environ.get("CUDA_VISIBLE_DEVICES")
+    output_path = tmp_path / "fresh-interpreter.json"
+
+    with monkeypatch.context() as child_settings:
+        child_settings.setenv("CUDA_VISIBLE_DEVICES", "child-only")
+        handle = PleOffloadWorker.make_process(
+            _FreshInterpreterProbe(str(output_path)), 0, "unused"
+        )
+        try:
+            handle.proc.wait(timeout=120)
+        finally:
+            handle.close()
+
+    assert output_path.exists()
+    result = json.loads(output_path.read_text(encoding="utf-8"))
+    assert result["cuda_visible_devices"] == "child-only"
+    assert result["torch_imported"] is False
+    assert result["vllm_imported"] is False
+    assert os.environ.get("CUDA_VISIBLE_DEVICES") == original
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+def test_launch_payload_send_has_absolute_deadline() -> None:
+    reader, sender = socket.socketpair()
+    sender.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 1024)
+    code = (
+        "import sys,time\n"
+        "from vllm.v1.ple_offload.worker import _send_framed_payload\n"
+        "payload=b'x'*(64<<20)\n"
+        "start=time.monotonic()\n"
+        "try:\n"
+        " _send_framed_payload(int(sys.argv[1]),payload,start+0.25)\n"
+        "except TimeoutError:\n"
+        " print('TIMED_OUT',time.monotonic()-start,flush=True)\n"
+        "else:\n"
+        " raise AssertionError('blocked reader unexpectedly accepted payload')\n"
+    )
+    process = subprocess.Popen(
+        [sys.executable, "-c", code, str(sender.fileno())],
+        pass_fds=(sender.fileno(),),
+        close_fds=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    sender.close()
+    try:
+        stdout, stderr = process.communicate(timeout=120)
+    finally:
+        reader.close()
+        if process.poll() is None:
+            process.terminate()
+            process.wait(timeout=5)
+    assert process.returncode == 0, stderr
+    # The injector logs the send entry through vLLM's logger on stdout; read only
+    # the probe's own result line.
+    result = [line for line in stdout.splitlines() if line.startswith("TIMED_OUT ")]
+    assert len(result) == 1, stdout
+    marker, elapsed = result[0].split()
+    assert marker == "TIMED_OUT"
+    assert float(elapsed) < 5
+
+
+class _BlockingConfigProbe:
+    def __init__(self, output_path: str) -> None:
+        self.output_path = output_path
+
+    def __reduce__(self):
+        expression = (
+            "(__import__('pathlib').Path("
+            + repr(self.output_path)
+            + ").write_text(str(__import__('os').getpid()), encoding='utf-8'),"
+            "__import__('threading').Event().wait())[1]"
+        )
+        return eval, (expression,)
+
+
+def _launch_blocked_config(output_path: str, child_pids) -> None:
+    from vllm.v1.ple_offload.worker import PleOffloadWorker
+
+    handle = PleOffloadWorker.make_process(
+        _BlockingConfigProbe(output_path), 0, "unused"
+    )
+    child_pids.put(handle.proc.pid)
+    # The test kills this launcher parent. Do not close the handle here.
+    threading.Event().wait()
+
+
+def _pid_has_exited(pid: int) -> bool:
+    stat_path = Path(f"/proc/{pid}/stat")
+    if not stat_path.exists():
+        return True
+    try:
+        return stat_path.read_text(encoding="utf-8").split()[2] == "Z"
+    except FileNotFoundError:
+        return True
+
+
+@pytest.mark.skipif(sys.platform != "linux", reason="uses Linux process state")
+def test_parent_death_during_config_reconstruction_exits_child(
+    tmp_path: Path,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    child_pids = context.Queue()
+    marker = tmp_path / "blocked-config.pid"
+    parent = context.Process(
+        target=_launch_blocked_config,
+        args=(str(marker), child_pids),
+    )
+    parent.start()
+    child_pid = child_pids.get(timeout=120)
+    deadline = time.monotonic() + 120
+    while not marker.exists() and time.monotonic() < deadline:
+        time.sleep(0.05)
+    assert marker.exists()
+
+    os.kill(parent.pid, signal.SIGKILL)
+    parent.join(timeout=120)
+    assert not parent.is_alive()
+
+    deadline = time.monotonic() + 10
+    while not _pid_has_exited(child_pid) and time.monotonic() < deadline:
+        time.sleep(0.05)
+    if not _pid_has_exited(child_pid):
+        # Harness cleanup is performed only after the autonomous-exit assertion
+        # has failed.
+        os.kill(child_pid, signal.SIGKILL)
+        pytest.fail("PLE child survived launcher-parent death during unpickle")
+
+
+class _ExecFdProbe:
+    def __init__(
+        self,
+        output_path: str,
+        inherited: list[tuple[int, int]],
+    ) -> None:
+        self.output_path = output_path
+        self.inherited = inherited
+
+    def __reduce__(self):
+        helper = (
+            "import json,os,sys\n"
+            "from pathlib import Path\n"
+            "pairs=json.loads(sys.argv[3])\n"
+            "retained=[]\n"
+            "for fd,inode in pairs:\n"
+            " try:\n"
+            "  retained.append(os.fstat(fd).st_ino==inode)\n"
+            " except OSError:\n"
+            "  retained.append(False)\n"
+            "Path(sys.argv[1]).write_text(json.dumps({"
+            "'noninheritable_before_exec':sys.argv[2]=='True',"
+            "'closed_after_exec':not any(retained)}),encoding='utf-8')\n"
+        )
+        pairs = json.dumps(self.inherited)
+        expression = (
+            "__import__('os').execv(__import__('sys').executable,"
+            "[__import__('sys').executable,'-c',"
+            + repr(helper)
+            + ","
+            + repr(self.output_path)
+            + ",str(all(not __import__('os').get_inheritable(int(fd)) "
+            "for fd in __import__('sys').argv[1:]))," + repr(pairs) + "])"
+        )
+        return eval, (expression,)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+def test_actual_bootstrap_restores_cloexec_before_helper_exec(
+    tmp_path: Path,
+) -> None:
+    from vllm.v1.ple_offload.worker import _send_framed_payload
+
+    control_parent, control_child = socket.socketpair()
+    death_parent, death_child = socket.socketpair()
+    inherited = [
+        (control_child.fileno(), os.fstat(control_child.fileno()).st_ino),
+        (death_child.fileno(), os.fstat(death_child.fileno()).st_ino),
+    ]
+    output_path = tmp_path / "bootstrap-fds.json"
+    config_payload = pickle.dumps(
+        _ExecFdProbe(str(output_path), inherited),
+        protocol=pickle.HIGHEST_PROTOCOL,
+    )
+    payload = pickle.dumps(
+        {
+            "vllm_config_payload": config_payload,
+            "num_workers": 0,
+            "ipc_addr": "unused",
+        },
+        protocol=pickle.HIGHEST_PROTOCOL,
+    )
+    control = Connection(control_parent.detach())
+    death_writer = Connection(death_parent.detach())
+    process = subprocess.Popen(
+        [
+            sys.executable,
+            "-m",
+            "vllm_ple_offload_bootstrap",
+            str(control_child.fileno()),
+            str(death_child.fileno()),
+        ],
+        close_fds=True,
+        pass_fds=(control_child.fileno(), death_child.fileno()),
+    )
+    control_child.close()
+    death_child.close()
+    try:
+        _send_framed_payload(control.fileno(), payload, time.monotonic() + 10)
+        assert process.wait(timeout=120) == 0
+    finally:
+        control.close()
+        death_writer.close()
+        if process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=5)
+
+    result = json.loads(output_path.read_text(encoding="utf-8"))
+    assert result == {
+        "noninheritable_before_exec": True,
+        "closed_after_exec": True,
+    }
diff --git a/tests/v1/ple_offload/test_stale_flag_assertion.py b/tests/v1/ple_offload/test_stale_flag_assertion.py
new file mode 100644
index 0000000000..c6636422e7
--- /dev/null
+++ b/tests/v1/ple_offload/test_stale_flag_assertion.py
@@ -0,0 +1,135 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The pull transport's staleness precondition, read back instead of argued.
+
+vllm#53899 (GB10/sm_121, TP=1, PIECEWISE and FULL_DECODE_ONLY): the capture
+path signalled dummy PLE outputs, the first real step's
+``cuStreamWaitValue32(flag == DONE_VALUE)`` was satisfied by that DUMMY signal,
+its release reset the flag, and the worker's late copy raised it again for the
+next step -- so every forward consumed the PREVIOUS step's PLE rows for the
+life of the server. ``cudagraph_mode=NONE`` was correct.
+
+This tree holds the precondition structurally (``_signal_dummy_outputs_impl``
+-> dummy forward -> ``_release_outputs_impl`` resets every layer and
+synchronizes while ``_after_dummy`` is set -> TP barrier at the dummy->real
+transition), but nothing ever read the flag back. ``stale_offload_flags`` is
+that read, and these tests pin its contract.
+
+No GPU is required: ``CpuGpuSemaphore.from_ipc_tensor`` accepts any int32
+tensor, and only ``reset``/``signal``/``wait_reset`` (never called here) touch
+the CUDA driver. The layer is a real ``PleOffloadLayer`` subclass configured
+through the real ``setup_cross_process_offload``, not a stand-in.
+"""
+
+import torch
+
+from vllm.model_executor.layers.ple_offload_layer import (
+    CpuGpuSemaphore,
+    PleOffloadLayer,
+    flag_check_is_authoritative,
+    stale_offload_flags,
+)
+
+HIDDEN = 4
+
+
+class _ProbeLayer(PleOffloadLayer):
+    """Minimal real subclass: the base class is abstract on forward_impl."""
+
+    def forward_impl(
+        self,
+        hidden_states: torch.Tensor,
+        input_ids: torch.Tensor,
+        *args: object,
+        **kwargs: object,
+    ) -> torch.Tensor:
+        return hidden_states
+
+
+def _layer(flag_value: int) -> _ProbeLayer:
+    layer = _ProbeLayer()
+    flag = torch.tensor([flag_value], dtype=torch.int32)
+    layer.setup_cross_process_offload(
+        gpu_output_buffer=torch.zeros(8, HIDDEN, dtype=torch.bfloat16),
+        semaphore=CpuGpuSemaphore.from_ipc_tensor(flag),
+    )
+    return layer
+
+
+def test_cleared_flags_are_not_reported() -> None:
+    """The correct world: every semaphore clear before a real launch."""
+    layers = {
+        "ple.0": _layer(CpuGpuSemaphore.RESET_VALUE),
+        "ple.1": _layer(CpuGpuSemaphore.RESET_VALUE),
+    }
+    assert stale_offload_flags(layers) == []
+
+
+def test_a_leftover_signal_is_reported_with_its_layer() -> None:
+    """The #53899 world: a signal no forward consumed survives into a launch.
+
+    This is the failing control for the pre-launch assertion. Without it the
+    check would be one that cannot fail: a
+    "same prompt twice" comparison passes in the broken world, because the
+    lag is constant and produces two bit-identical output classes.
+    """
+    layers = {
+        "ple.0": _layer(CpuGpuSemaphore.RESET_VALUE),
+        "ple.1": _layer(CpuGpuSemaphore.DONE_VALUE),
+    }
+    assert stale_offload_flags(layers) == [("ple.1", CpuGpuSemaphore.DONE_VALUE)]
+
+
+def test_every_stale_layer_is_named_not_just_the_first() -> None:
+    """Attribution matters: #53899's fix resets EVERY layer's semaphore."""
+    layers = {f"ple.{i}": _layer(CpuGpuSemaphore.DONE_VALUE) for i in range(3)}
+    assert stale_offload_flags(layers) == [
+        ("ple.0", 1),
+        ("ple.1", 1),
+        ("ple.2", 1),
+    ]
+
+
+def test_a_value_that_is_neither_reset_nor_done_is_reported_verbatim() -> None:
+    """A torn or foreign write is a violation too, and its value is evidence.
+
+    The flag is binary by construction, so any third value means something
+    other than this transport wrote it. Reporting the raw value distinguishes
+    that from an ordinary leftover signal.
+    """
+    layers = {"ple.0": _layer(7)}
+    assert stale_offload_flags(layers) == [("ple.0", 7)]
+
+
+def test_a_layer_without_cross_process_offload_is_skipped() -> None:
+    """Non-offloaded layers have no ``_sem``; reading one would be an error."""
+    layers = {"ple.0": _ProbeLayer(), "ple.1": _layer(CpuGpuSemaphore.DONE_VALUE)}
+    assert stale_offload_flags(layers) == [("ple.1", CpuGpuSemaphore.DONE_VALUE)]
+
+
+# ---------------------------------------------------------------------------
+# Which rank may judge the flag at all
+# ---------------------------------------------------------------------------
+
+
+def test_only_the_publishing_rank_may_judge_the_flag() -> None:
+    """``flag == 0`` before a launch is an invariant on TP0 ONLY.
+
+    ``_launch`` publishes only on TP0. The offload worker then fans the result
+    out to EVERY registered target, each gated only on that target's own flag
+    having been reset. So this interleaving is legal and healthy:
+
+      1. TP0 checks its flag (clear) and publishes step N.
+      2. The worker fills TP1's buffer and sets TP1's flag for step N.
+      3. TP1 reaches its own pre-launch check and reads DONE.
+
+    A rank-blind check calls step 3 a stale signal and terminates a healthy
+    TP2 run. The dummy->real TP barrier is before the checks and does not
+    order this. A non-publishing rank cannot separate "this step's fan-out
+    arrived early" from "last step's signal was never consumed", because the
+    flag is binary and carries no transaction identity -- so it is skipped
+    rather than checked weakly.
+    """
+    assert flag_check_is_authoritative(0) is True
+    for tp_rank in (1, 2, 3, 7):
+        assert flag_check_is_authoritative(tp_rank) is False, tp_rank
