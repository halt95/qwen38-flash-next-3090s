+# Large-path reuse geometry, computed for the reference 3090 and asserted before use.
+#
+# topk.cu: ctas_per_group = ceil(stride / max_chunk_elements); at >8 rows and
+# 262,144 columns the chunk budget gives ~24,824 elements, so
+# ctas_per_group = 11. On a 3090 (82 SMs; occupancy 1 for a 1,024-thread CTA at
+# this shared-memory size) the cooperative headroom rule leaves
+# max_resident_ctas = 81, hence num_groups = min(81 // 11, num_rows) = 7.
+#
+# persistent_topk.cuh assigns rows `row_idx = group_id + iter * num_groups`, so
+# with num_groups = 7 the ITERATION index of a row is `row_idx // 7` and its
+# GROUP is `row_idx % 7`. Laying the classes out in blocks of 7 therefore gives
+# EVERY group the same five-iteration sequence, and the sequence is the one
+# the coverage needs.
+LARGEDET_REUSE_GROUPS = 7
+LARGEDET_REUSE_SMS = 82  # RTX 3090; the geometry above is derived from this
+LARGEDET_REUSE_LARGE_LEN = 262144
+LARGEDET_REUSE_CLASSES = ["large", "decode", "medium", "large", "large"]
+LARGEDET_REUSE_LENGTHS = {"large": LARGEDET_REUSE_LARGE_LEN, "decode": 2048, "medium": 12288}
+
