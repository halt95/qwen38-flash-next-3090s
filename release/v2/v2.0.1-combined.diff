+
+@pytest.mark.timeout(180)
+@pytest.mark.skipif(sys.platform == "win32", reason="requires POSIX pass_fds")
+@pytest.mark.parametrize(
+    ("cut", "expected_transaction"),
+    [
+        ("launch_block_reconstruction", "reducer:configuration"),
+        (
+            "launch_block_worker_import",
+            "module:vllm.v1.ple_offload.worker",
+        ),
+    ],
+)
+def test_gate_is_inside_reducer_or_loader_and_parent_death_wins(
+    tmp_path,
+    cut,
+    expected_transaction,
+):
+    gate = tmp_path / "gate"
+    os.mkfifo(gate)
+    gate_keeper = os.open(gate, os.O_RDWR | os.O_NONBLOCK)
+    control_parent, control_child = socket.socketpair()
+    death_parent, death_child = socket.socketpair()
+    fault_log = tmp_path / "fault.log"
+    env = dict(os.environ)
+    env["VLLM_PLE_TEST_FAULT"] = f"cut={cut},ordinal=1,rank=any"
+    env["VLLM_PLE_TEST_FAULT_LOG"] = str(fault_log)
+    env["VLLM_PLE_TEST_FAULT_GATE"] = str(gate)
+
+    config_payload = pickle.dumps(None, protocol=pickle.HIGHEST_PROTOCOL)
+    if cut == "launch_block_reconstruction":
+        config_payload = test_fault._FaultReconstructionPayload(config_payload)
+    launch = pickle.dumps(
+        {
+            "vllm_config_payload": config_payload,
+            "num_workers": 1,
+            "ipc_addr": "ipc:///unused-round3",
+        },
+        protocol=pickle.HIGHEST_PROTOCOL,
+    )
+
+    process = subprocess.Popen(
+        [
+            sys.executable,
+            "-m",
+            "vllm_ple_offload_bootstrap",
+            str(control_child.fileno()),
+            str(death_child.fileno()),
+        ],
+        env=env,
+        pass_fds=(control_child.fileno(), death_child.fileno()),
+    )
+    control_child.close()
+    death_child.close()
+    try:
+        control_parent.sendall(struct.pack("!Q", len(launch)) + launch)
+        deadline = time.monotonic() + 30
+        while time.monotonic() < deadline:
+            if fault_log.exists() and expected_transaction in fault_log.read_text():
+                break
+            assert process.poll() is None
+            time.sleep(0.05)
+        else:
+            pytest.fail("operation-entry acknowledgement was not emitted")
+
+        assert process.poll() is None
+        death_parent.close()
+        assert process.wait(timeout=120) != 0
+    finally:
+        with contextlib.suppress(ProcessLookupError):
+            process.kill()
+        process.wait(timeout=120)
+        control_parent.close()
+        with contextlib.suppress(OSError):
+            death_parent.close()
+        os.close(gate_keeper)
+
+
+def _load_gate_helper():
+    root = Path(__file__).resolve().parents[3]
+    path = root / "probe" / "faultcut_gate.py"
+    spec = importlib.util.spec_from_file_location("faultcut_gate", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        {"alive": False},
+        {"observed_start": 88},
+        {"bytes_sent": 0},
+        {"bytes_sent": 100},
+        {"completed": True},
+        {"child_not_reading": False},
+    ],
+)
+def test_external_partial_send_gate_rejections(change):
+    gate = _load_gate_helper()
+    values = {
+        "pid": 12,
+        "expected_start": 77,
+        "observed_start": 77,
+        "alive": True,
+        "bytes_sent": 4,
+        "frame_size": 100,
+        "completed": False,
+        "child_not_reading": True,
+    }
+    values.update(change)
+    ok, _reason = gate.validate_partial_send_gate(**values)
+    assert not ok
+
+
+def test_external_gate_rejects_failed_signal():
+    gate = _load_gate_helper()
+    ok, reason = gate.deliver_checked_signal(
+        pid=12,
+        expected_start=77,
+        read_start=lambda _pid: 77,
+        alive=lambda _pid: True,
+        send=lambda _pid, _sig: False,
+        signal_number=9,
+    )
+    assert not ok
+    assert "delivery failed" in reason
+
+
+def test_every_fault_call_has_one_boolop_guard_and_no_prior_state_read():
+    root = Path(__file__).resolve().parents[3]
+    expected = {
+        "vllm/v1/ple_offload/connector.py": 3,
+        "vllm/v1/ple_offload/worker.py": 1,
+        "vllm/v1/worker/gpu/model_runner.py": 4,
+        "vllm_ple_offload_bootstrap/__init__.py": 1,
+    }
+
+    for relative, wanted in expected.items():
+        tree = ast.parse((root / relative).read_text(encoding="utf-8"))
+        parents = {}
+        for parent in ast.walk(tree):
+            for child in ast.iter_child_nodes(parent):
+                parents[child] = parent
+
+        calls = [
+            node
+            for node in ast.walk(tree)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr == "fires"
+            and isinstance(node.func.value, ast.Name)
+            and node.func.value.id == "_FAULT"
+        ]
+        assert len(calls) == wanted, relative
+        for call in calls:
+            owner = call
+            while owner in parents and not isinstance(owner, ast.BoolOp):
+                owner = parents[owner]
+            assert isinstance(owner, ast.BoolOp), (relative, call.lineno)
+            assert isinstance(owner.op, ast.And), (relative, call.lineno)
+
+            guard_index = None
+            call_index = None
+            for index, value in enumerate(owner.values):
+                if (
+                    isinstance(value, ast.Compare)
+                    and isinstance(value.left, ast.Name)
+                    and value.left.id == "_FAULT"
+                    and len(value.ops) == 1
+                    and isinstance(value.ops[0], ast.IsNot)
+                    and len(value.comparators) == 1
+                    and isinstance(value.comparators[0], ast.Constant)
+                    and value.comparators[0].value is None
+                ):
+                    guard_index = index
+                if call in ast.walk(value):
+                    call_index = index
+            assert guard_index is not None
+            assert call_index is not None
+            assert guard_index < call_index
+
+            forbidden = {"sequence", "has_pending_completions",
+                         "completion_is_pending", "fault_transaction"}
+            before_guard = owner.values[:guard_index]
+            assert not any(
+                isinstance(node, ast.Attribute) and node.attr in forbidden
+                for value in before_guard
+                for node in ast.walk(value)
+            )
