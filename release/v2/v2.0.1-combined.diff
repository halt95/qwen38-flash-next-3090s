+def test_ring_preempt_withholds_the_ring_block_until_the_fence():
+    """The property rc5 buys: a preempted request's ring block does not
+    return to the pool while a step that may still write it is in flight,
+    and it does return once the newest in-flight step's output is processed.
+    """
+    with patch.object(
+        VllmConfig,
+        "max_concurrent_batches",
+        new_callable=PropertyMock,
+        return_value=2,
+    ):
