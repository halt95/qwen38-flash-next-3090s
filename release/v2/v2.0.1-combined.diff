+        tp_rank=0,
+        pp_rank=0,
+        dp_rank=0,
+        transaction_id="sequence:1",
+    )
+    assert spec._state.diagnostic_failed
+    assert not spec._state.fired
+
+
+@pytest.mark.parametrize("order", ["bootstrap-first", "package-first"])
+@pytest.mark.parametrize("armed", [False, True])
+def test_fresh_interpreter_import_identity(tmp_path, order, armed):
+    env = dict(os.environ)
+    env.pop("VLLM_PLE_TEST_FAULT", None)
+    env.pop("VLLM_PLE_TEST_FAULT_LOG", None)
+    if armed:
+        env["VLLM_PLE_TEST_FAULT"] = (
+            "cut=launch_silent_ready,ordinal=1,rank=any"
+        )
+        env["VLLM_PLE_TEST_FAULT_LOG"] = str(tmp_path / f"{order}.log")
+    script = f"""
+import sys
+if {order!r} == "bootstrap-first":
+    import vllm_ple_offload_bootstrap as bootstrap
+    absent_before_package = "vllm_ple_test_fault" not in sys.modules
+    import vllm_ple_test_fault as package
+else:
+    import vllm_ple_test_fault as package
+    import vllm_ple_offload_bootstrap as bootstrap
+    absent_before_package = False
+assert bootstrap._FAULT is package._FAULT
+assert getattr(sys.modules["vllm_ple_test_fault"], "_FAULT") is package._FAULT
+if {armed!r}:
+    assert package._FAULT is not None
+else:
+    assert package._FAULT is None
+    if {order!r} == "bootstrap-first":
+        assert absent_before_package
+"""
+    subprocess.run(
+        [sys.executable, "-c", script],
+        env=env,
+        check=True,
+        timeout=120,
+    )
+
+
+class _IncompleteEvent:
+    def query(self):
+        return False
+
+
+class _FatalObserved(BaseException):
+    pass
+
+
+@pytest.mark.parametrize(
+    ("record_completion", "complete_submission", "expected"),
+    [
+        (False, False, "host-submission"),
+        (True, False, "gpu-completion"),
+        (True, True, "gpu-completion"),
+    ],
+)
+def test_real_progress_monitor_observed_state(
+    monkeypatch,
+    record_completion,
+    complete_submission,
+    expected,
+):
+    import vllm.v1.ple_offload.progress as progress_module
+
+    observed = []
+    reached = threading.Event()
+
+    def fatal(**kwargs):
+        observed.append(kwargs)
+        reached.set()
+        raise _FatalObserved
+
+    monkeypatch.setattr(progress_module, "ple_fail_closed", fatal)
+    monitor = progress_module.PleProgressMonitor(
+        rank=0,
+        layer_names=("ple",),
+        serving_deadline_s=0.02,
+        startup_deadline_s=0.02,
+    )
+    monitor.begin(startup=False, num_tokens=1)
+    if record_completion:
+        monitor.track_completion(_IncompleteEvent())
+    if complete_submission:
+        monitor.complete()
+    assert reached.wait(2)
+    assert expected in observed[0]["where"]
+    monitor.close()
+
+
+def test_drop_retains_event_and_next_pool_one_launch_fails_closed(
+    monkeypatch,
+    tmp_path,
+):
+    import vllm.v1.ple_offload.connector as connector_module
+
+    spec = _spec(
+        monkeypatch,
+        tmp_path,
+        "cut=drop_request,ordinal=1,tp=0,pp=0",
+    )
+    monkeypatch.setattr(connector_module, "_FAULT", spec)
+
+    connector = object.__new__(connector_module.PleOffloadConnector)
+    connector.tp_rank = 0
+    connector.pp_rank = 0
+    connector.dp_rank = 0
+    connector._progress = SimpleNamespace(sequence=7)
+    connector._dropped_events = []
+    connector._d2h_event_pool = queue.Queue(maxsize=1)
+    event = Mock()
+    connector._d2h_event_pool.put_nowait(event)
+    connector._request_queue = Mock()
+    connector._enqueue_cuda_inputs = Mock()
+
+    connector._launch(
+        num_reqs=1,
+        num_tokens=2,
+        serving=True,
+        transaction_id="sequence:7@begin:1.000000000",
+        correlation_id="sequence:7",
+    )
+    assert connector._dropped_events == [event]
+    connector._request_queue.put_nowait.assert_not_called()
+
+    with pytest.raises(
+        RuntimeError,
+        match="more requests than configured concurrent batches",
+    ):
+        connector._launch(
+            num_reqs=1,
+            num_tokens=2,
+            serving=True,
+            transaction_id="sequence:8@begin:2.000000000",
+            correlation_id="sequence:8",
+        )
+
+
+def test_async_output_cut_uses_real_sample_boundary(monkeypatch, tmp_path):
+    import vllm.v1.worker.gpu.model_runner as model_runner_module
+
+    spec = _spec(
+        monkeypatch,
+        tmp_path,
+        "cut=exc_async_output,ordinal=1,tp=0,pp=0",
+    )
+    monkeypatch.setattr(model_runner_module, "_FAULT", spec)
+
+    class FatalReached(Exception):
+        pass
+
+    connector = SimpleNamespace(
+        tp_rank=0,
+        pp_rank=0,
+        dp_rank=0,
+        completion_is_pending=Mock(return_value=True),
+        _fail_closed=Mock(side_effect=FatalReached),
+    )
+    runner = object.__new__(model_runner_module.GPUModelRunner)
+    runner._ple_offload_connector = connector
+    runner.is_last_pp_rank = False
+    runner.pp_handler = Mock()
+    runner.execute_model_state = SimpleNamespace(
+        input_batch=object(),
+        attn_metadata=None,
+        slot_mappings_by_layer=None,
+        hidden_states=None,
+        aux_hidden_states=None,
+        dp_sync=None,
+        finished_req_ids=[],
+        ec_connector_output=None,
+        routed_experts=None,
+        cudagraph_stats=None,
+        ple_serving=True,
+        ple_sequence=11,
+        ple_transaction="sequence:11@begin:1.000000000",
+    )
+
+    with pytest.raises(FatalReached):
+        runner.sample_tokens(None)
+    assert connector._fail_closed.call_args.args[0] == "sample_tokens"
+    error = connector._fail_closed.call_args.args[1]
+    assert isinstance(error, RuntimeError)
+    assert "exc_async_output" in str(error)
