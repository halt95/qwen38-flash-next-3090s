+    reached = threading.Event()
+    monkeypatch.setattr(
+        worker.threading,
+        "Event",
+        lambda: SimpleNamespace(wait=lambda: reached.set()),
+    )
+    runner._handle_requests_impl(
+        [
+            worker._ReceivedPleOffloadRequest(
+                request,
+                True,
+                "sequence:17@begin:4.000000000",
+                "sequence:17",
+            )
+        ]
+    )
+    assert reached.is_set()
+    line = (tmp_path / "fault.log").read_text()
+    assert "transaction=request:1@sequence:17@begin:4.000000000" in line
+    assert "correlation=sequence:17" in line
