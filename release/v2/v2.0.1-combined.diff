+    connector._progress = SimpleNamespace(sequence=0)
+    connector._enqueue_cuda_inputs = Mock()
+
+    connector._launch(
+        num_reqs=1,
+        num_tokens=2,
+        serving=True,
+        transaction_id=None,
+        correlation_id=None,
+    )
+    connector._enqueue_cuda_inputs.assert_called_once()
+    connector._request_queue.put_nowait.assert_called_once()
+
+    staged = connector_module._PendingPleOffloadRequest(
+        connector_module.PleOffloadRequest(dp_rank=0, num_tokens=2, num_reqs=1),
+        event,
+        True,
+        "sequence:0",
+    )
+    socket = Mock()
+    monkeypatch.setattr(
+        connector_module.torch.accelerator,
+        "device_index",
+        lambda _index: contextlib.nullcontext(),
+    )
+    connector._process_request(staged, socket)
+    event.synchronize.assert_called_once()
+    socket.send.assert_called_once()
+
+
+def test_disarmed_release_site_continues(fault_module, monkeypatch):
+    import vllm.v1.ple_offload.connector as connector_module
+
+    monkeypatch.setattr(connector_module, "_FAULT", None)
+    monkeypatch.setattr(connector_module._rowdump, "enabled", lambda: False)
+
+    stream = Mock()
+    completion = Mock()
+    monkeypatch.setattr(
+        connector_module.torch.cuda,
+        "current_stream",
+        lambda _device: stream,
+    )
+    monkeypatch.setattr(connector_module.torch.cuda, "Event", lambda: completion)
+
+    connector = object.__new__(connector_module.PleOffloadConnector)
+    connector.tp_rank = 0
+    connector.pp_rank = 0
+    connector.device = SimpleNamespace(index=0)
+    connector._layers = {}
+    connector._after_dummy = False
+    connector._progress = Mock()
+
+    connector._release_outputs_impl()
+    completion.record.assert_called_once_with(stream)
+    connector._progress.track_completion.assert_called_once_with(completion)
+
+
+def test_disarmed_worker_park_site_continues(fault_module, monkeypatch):
+    import vllm.v1.ple_offload.worker as worker_module
+
+    monkeypatch.setattr(worker_module, "_FAULT", None)
+    runner = object.__new__(worker_module.PleOffloadRunner)
+    runner._validate_requests_before_publication = Mock()
+    runner._worker_targets = {0: {}}
+    runner._input_bufs = {}
+    runner._scratch_bufs = {}
+    runner._layers = {}
+    runner._clamp_input_ids = False
+    runner._step = 0
+    runner._request_index = 0
+    request = SimpleNamespace(dp_rank=0)
+
+    runner._handle_requests_impl([request])
+    runner._validate_requests_before_publication.assert_called_once_with([request])
+    assert runner._step == 1
+
+
+def test_all_injection_sites_use_the_disarmed_short_circuit():
+    root = Path(__file__).resolve().parents[3]
+    expected = {
+        "vllm/v1/ple_offload/connector.py": 3,
+        "vllm/v1/ple_offload/worker.py": 1,
+        "vllm/v1/worker/gpu/model_runner.py": 4,
+        "vllm_ple_offload_bootstrap/__init__.py": 1,
+    }
+    for relative, count in expected.items():
+        lines = (root / relative).read_text(encoding="utf-8").splitlines()
+        sites = [i for i, line in enumerate(lines) if "_FAULT.fires(" in line]
+        assert len(sites) == count, relative
+        for i in sites:
+            window = "\n".join(lines[max(0, i - 6): i + 1])
+            # The None check must precede fires() in the same condition, so a
+            # disarmed process never calls into the fault module.
+            assert "_FAULT is not None" in window, (relative, i + 1)
+            assert window.index("_FAULT is not None") < window.index("_FAULT.fires("), (relative, i + 1)
+
+
+class _FatalReached(Exception):
+    pass
+
+
+def test_exc_in_release_reaches_real_connector_fatal_wrapper(
+    fault_module, monkeypatch
+):
+    import vllm.v1.ple_offload.connector as connector_module
+
+    armed = fault_module._parse_fault_spec(
+        "cut=exc_in_release,ordinal=1,tp=1,pp=0"
+    )
+    assert armed is not None
+    monkeypatch.setattr(connector_module, "_FAULT", armed)
+
+    fatal = Mock(side_effect=_FatalReached)
