index 0000000000..8fd8aa5e64
--- /dev/null
+++ b/tests/v1/worker/gpu/test_block_table_guards.py
@@ -0,0 +1,118 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Real launches of the three kernels no suite was launching.
+
+rc3 boot attempt 3 died in warmup with a Triton CompilationError in
+`_gather_block_tables_kernel` -- a branch-typing error in guard 6 that nothing
+had ever compiled. The compile gate listed it as "left to the suites" and
+`tests/v1/worker/gpu/` contained no block-table test at all, so it was left to
+nobody: its first compile was the first real forward of a four-rank boot.
+
+These tests launch the real kernels. They are cheap, they are CUDA-gated, and
+their only job is that a signature or typing error in guard 6 or guard 7 costs
+seconds in the suite rather than a boot.
+"""
+
+import pytest
+import torch
+
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.worker import guard_telemetry
+from vllm.v1.worker.gpu.block_table import BlockTables
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="CUDA required"
+)
+
+MAX_REQS = 8
+BLOCKS = 4
+BLOCK_SIZE = 16
+NUM_REQS = 4
+NUM_TOKENS = 16
+
+
+def _tables(device):
+    bt = BlockTables(
+        block_sizes=[BLOCK_SIZE],
+        max_num_reqs=MAX_REQS,
+        max_num_batched_tokens=NUM_TOKENS,
+        max_num_blocks_per_group=[BLOCKS],
+        device=device,
+        kernel_block_sizes=[BLOCK_SIZE],
+    )
+    for r in range(NUM_REQS):
+        bt.append_block_ids(r, ([1 + r],), True)
+    bt.apply_staged_writes()
+    return bt
+
+
+def test_gather_and_slot_mapping_launch_and_are_correct():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    bt = _tables(device)
+
+    idx = torch.arange(NUM_REQS, dtype=torch.int32, device=device)
+    (gathered,) = bt.gather_block_tables(idx, num_reqs_padded=NUM_REQS)
+    torch.cuda.synchronize()
+    for r in range(NUM_REQS):
+        assert int(gathered[r, 0]) == 1 + r, gathered
+
+    qsl = torch.tensor([0, 4, 8, 12, 16], dtype=torch.int32, device=device)
+    pos = torch.arange(NUM_TOKENS, dtype=torch.int64, device=device)
+    slots = bt.compute_slot_mappings(idx, qsl, pos, num_tokens_padded=NUM_TOKENS)
+    torch.cuda.synchronize()
+    assert slots.shape[-1] == NUM_TOKENS
+
+    # A legal batch must leave both counters at zero. A guard that fires here
+    # is reporting a masked fault on correct metadata, which is worse than no
+    # guard -- see the round-8 row-bound defect.
+    for site in (guard_telemetry.SITE_BT_GATHER,
+                 guard_telemetry.SITE_SLOT_MAPPING):
+        ctr = guard_telemetry.counter(site, device)
+        assert int(ctr[0].item()) == 0, guard_telemetry.snapshot()
+
+
+def test_gather_guard_fires_and_zeroes_the_row():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    bt = _tables(device)
+
+    idx = torch.arange(NUM_REQS, dtype=torch.int32, device=device)
+    idx[2] = MAX_REQS + 3          # a request row that does not exist
+    (gathered,) = bt.gather_block_tables(idx, num_reqs_padded=NUM_REQS)
+    torch.cuda.synchronize()
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_BT_GATHER, device)
+    assert int(ctr[0].item()) > 0, "the gather guard did not fire"
+    row = int(ctr[1].item()) - guard_telemetry.GUARD_BIAS
+    val = int(ctr[2].item()) - guard_telemetry.GUARD_BIAS
+    assert row == 2, f"recorded batch row {row}, expected 2"
+    assert val == MAX_REQS + 3, f"recorded req_idx {val}"
+    # and the destination row is zeroed rather than filled from a stray row
+    assert int(gathered[2].abs().sum()) == 0, gathered[2]
+    # the rows either side are untouched
+    assert int(gathered[1, 0]) == 2 and int(gathered[3, 0]) == 4
+
+
+def test_slot_mapping_guard_pads_the_bad_request():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    bt = _tables(device)
+
+    idx = torch.arange(NUM_REQS, dtype=torch.int32, device=device)
+    idx[1] = -1                    # the freed-slot sentinel
+    qsl = torch.tensor([0, 4, 8, 12, 16], dtype=torch.int32, device=device)
+    pos = torch.arange(NUM_TOKENS, dtype=torch.int64, device=device)
+    slots = bt.compute_slot_mappings(idx, qsl, pos, num_tokens_padded=NUM_TOKENS)
+    torch.cuda.synchronize()
+
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_SLOT_MAPPING, device)
+    assert int(ctr[0].item()) > 0, "the slot-mapping guard did not fire"
+    # request 1 owns tokens 4..7 and they must all be PAD_ID
+    assert torch.equal(
+        slots[0, 4:8],
+        torch.full((4,), PAD_SLOT_ID, dtype=slots.dtype, device=device),
+    ), slots[0, :12]
diff --git a/tests/v1/worker/gpu/test_guard_reader_nonblocking.py b/tests/v1/worker/gpu/test_guard_reader_nonblocking.py
new file mode 100644
index 0000000000..6b9e4602ae
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_reader_nonblocking.py
@@ -0,0 +1,135 @@
+# SPDX-License-Identifier: Apache-2.0
+"""v2-rc6 (qwen38next-flash#17): the instrumentation readers must never wait on the compute stream.
+
+The rc3 cadence reader did a synchronous pageable ``tolist()`` from its thread; the driver held the CUDA context lock
+while that copy waited for the stream, and a pending PLE pull-transport wait on the stream (whose producer needs the
+same lock) deadlocked the worker. These tests park a kernel on the current (compute) stream and require a reader tick
+to return while it is still running. On the pre-fix reader the first GPU test blocks for the kernel's duration.
+"""
+import threading
+import time
+
+import pytest
+import torch
+
+from vllm.v1.worker import guard_telemetry
+
+SLEEP_CYCLES = 4_000_000_000  # ~2 s on a 3090 (torch.cuda._sleep spins for this many cycles)
+
+
+def test_cpu_tensor_reads_directly():
+    r = guard_telemetry.NonBlockingReader()
+    t = torch.tensor([[1, 2, 3]], dtype=torch.int64)
+    r.register("cpu", t)
+    assert r.poll_one("cpu") == [[1, 2, 3]]
+    t[0, 0] = 7
+    assert r.poll()["cpu"] == [[7, 2, 3]]
+
+
+def test_register_refuses_to_run_inside_a_capture(monkeypatch):
+    """Luna r1 P1: creating the side stream inside a cudagraph capture is not capture-safe."""
+    r = guard_telemetry.NonBlockingReader()
+    monkeypatch.setattr(torch.cuda, "is_current_stream_capturing", lambda: True)
+    if not torch.cuda.is_available():
+        pytest.skip("CUDA required for the cuda-tensor branch")
+    t = torch.zeros(2, dtype=torch.int64, device="cuda")
+    with pytest.raises(RuntimeError, match="during cudagraph capture"):
+        r.register("x", t)
+
+
+def test_report_waits_for_the_confirming_tick_cpu():
+    """Luna r1 P1: a count rise seen in copy k is reported from copy k+1 (maxima current by then)."""
+    device = torch.device("cpu")
+    guard_telemetry.reset_for_test()
+    buf = guard_telemetry.counter(0, device)  # allocates the cpu buffer
+    full = guard_telemetry._buffers[device]
+    site = guard_telemetry.SITE_MAMBA_COPY
+    full[site, 0] = 2                       # count written, maxima not yet
+    guard_telemetry._poll_once()            # rise seen -> pending, nothing reported
+    assert guard_telemetry._seen.get((device, site), 0) == 0
+    full[site, 1] = 9 + guard_telemetry.GUARD_BIAS   # maxima land before the next tick
+    guard_telemetry._poll_once()            # confirming tick reports count 2 with row 9
+    assert guard_telemetry._seen.get((device, site), 0) == 2
+    snap = guard_telemetry.snapshot()
+    key = f"{device}:{guard_telemetry.SITE_NAMES[site]}"
+    assert snap[key][:2] == [2, 9]
+    guard_telemetry.reset_for_test()
+
+
+def test_module_reader_is_the_non_blocking_kind():
+    assert isinstance(guard_telemetry._nb_reader, guard_telemetry.NonBlockingReader)
+    src = open(guard_telemetry.__file__, encoding="utf-8").read()
+    body = src[src.index("def _poll_once"):src.index("def _arm(")]
+    assert ".tolist()" not in body.replace("host.tolist()", ""), "the cadence reader must not read the device buffer synchronously"
+    assert "poll_one(" in body
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_reader_tick_returns_while_the_compute_stream_is_busy():
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    torch.cuda.synchronize(device)
+    # prime: one poll starts the first copy (nothing to report yet)
+    guard_telemetry._poll_once()
+    torch.cuda.synchronize(device)
+
+    # Park a long kernel on the compute (current) stream, then tick the reader.
+    torch.cuda._sleep(SLEEP_CYCLES)
+    t0 = time.monotonic()
+    guard_telemetry._poll_once()
+    tick = time.monotonic() - t0
+    # Prove the stream really was busy: the sync must take a while.
+    t1 = time.monotonic()
+    torch.cuda.synchronize(device)
+    busy = time.monotonic() - t1
+    # The tick assertion comes first: a blocking reader spends the whole sleep inside the tick and would then make
+    # the busy control read ~0 (rc5 negative control, 2026-09-17).
+    assert tick < 0.25, f"reader tick took {tick:.3f}s while the compute stream was busy: it waited on the stream (deadlock class #17)"
+    assert tick + busy > 0.5, f"control failed: the parked kernel finished in {tick + busy:.3f}s, the test cannot discriminate"
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_reader_tick_from_a_thread_returns_while_the_compute_stream_is_busy():
+    """The production shape: the tick runs on the reader thread while the main thread owns the stream."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    guard_telemetry._poll_once()
+    torch.cuda.synchronize(device)
+    torch.cuda._sleep(SLEEP_CYCLES)
+    done = threading.Event()
+    elapsed = {}
+
+    def tick():
+        t0 = time.monotonic()
+        guard_telemetry._poll_once()
+        elapsed["tick"] = time.monotonic() - t0
+        done.set()
+
+    threading.Thread(target=tick, name="test-guard-reader", daemon=True).start()
+    finished = done.wait(timeout=1.0)
+    torch.cuda.synchronize(device)
+    assert finished, "the reader tick did not return within 1 s while the compute stream was busy (deadlock class #17)"
+    assert elapsed["tick"] < 0.25
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required")
+def test_hits_written_before_a_stall_are_still_reported():
+    """Non-blocking must not mean lossy: a count written on the compute stream is reported once the copy lands."""
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+    buf = guard_telemetry._buffers[device]
+    site = guard_telemetry.SITE_MAMBA_COPY
+    buf[site, 0] += 3  # a "masked access" count, written on the compute stream
+    buf[site, 1] = 5 + guard_telemetry.GUARD_BIAS
+    torch.cuda._sleep(SLEEP_CYCLES // 4)
+    torch.cuda.synchronize(device)
+    # copy -> rise seen -> confirming copy -> report: four ticks at most
+    for _ in range(4):
+        guard_telemetry._poll_once()
+    assert guard_telemetry._seen.get((device, site), 0) == 3
+    snap = guard_telemetry.snapshot()
+    key = f"{device}:{guard_telemetry.SITE_NAMES[site]}"
+    assert snap[key][0] == 3 and snap[key][1] == 5
diff --git a/tests/v1/worker/gpu/test_guard_telemetry_replay.py b/tests/v1/worker/gpu/test_guard_telemetry_replay.py
new file mode 100644
index 0000000000..5fab2c855d
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_telemetry_replay.py
@@ -0,0 +1,167 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The test that distinguishes "B1 architecturally fixed" from "B1 fixed".
+
+Round 1 of the rc3-instr guard series allocated a counter per launch and read
+it back inline. Under CUDA-graph REPLAY the Python host code never runs, so
+that counter was re-zeroed every step and never read: the instrument was
+silently dead in exactly the configuration the crash happens in (QSA declares
+AttentionCGSupport.UNIFORM_BATCH, so the guarded kernels sit inside the
+captured forward).
+
+Round 2 rebuilt it on a persistent buffer plus captured atomics. That is the
+right architecture, but "right architecture" is a claim about code. This is the
+measurement: capture a graph around a guarded kernel with a seeded bad value,
+replay it N times WITHOUT re-entering Python, and require the counter to have
+advanced N times.
+
+A test that only ran the kernel eagerly would pass on round 1's design too,
+which is why it must be a replay.
+"""
+
+import pytest
+import torch
+
+from vllm.third_party.flash_linear_attention.ops import (
+    fused_sigmoid_gating_delta_rule_update,
+)
+from vllm.v1.worker import guard_telemetry
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="CUDA required"
+)
+
+REPLAYS = 5
+
+
+def _seeded_call(device):
+    """One guarded launch whose guard MUST fire.
+
+    num_accepted_tokens = 0 makes i_t == -1 in
+    fused_sigmoid_gating_delta_rule_update_kernel, a read before this request's
+    row of ssm_state_indices. That is the guard added in commit 3/8.
+    """
+    num_tokens, num_k_heads, num_v_heads = 4, 2, 4
+    head_k_dim = head_v_dim = 16
+    q = torch.rand(1, num_tokens, num_k_heads, head_k_dim, device=device)
+    k = torch.rand_like(q)
+    v = torch.rand(1, num_tokens, num_v_heads, head_v_dim, device=device)
+    a = torch.rand(num_tokens, num_v_heads, device=device)
+    b = torch.rand_like(a)
+    A_log = torch.rand(num_v_heads, device=device)
+    dt_bias = torch.rand_like(A_log)
+    state = torch.rand(
+        num_tokens + 1, num_v_heads, head_v_dim, head_k_dim, device=device
+    )
+    state_indices = torch.arange(
+        1, num_tokens + 1, dtype=torch.int32, device=device
+    ).view(1, num_tokens)
+    cu_seqlens = torch.tensor([0, num_tokens], dtype=torch.int32, device=device)
+    accepted = torch.zeros(1, dtype=torch.int32, device=device)  # -> i_t == -1
+
+    def run():
+        fused_sigmoid_gating_delta_rule_update(
+            A_log=A_log,
+            a=a,
+            b=b,
+            dt_bias=dt_bias,
+            q=q,
+            k=k,
+            v=v,
+            initial_state=state,
+            inplace_final_state=True,
+            ssm_state_indices=state_indices,
+            cu_seqlens=cu_seqlens,
+            num_accepted_tokens=accepted,
+        )
+
+    return run
+
+
+def _count(device):
+    ctr = guard_telemetry.counter(guard_telemetry.SITE_GDN_DECODE_STATE, device)
+    torch.cuda.synchronize()
+    return int(ctr[0].item())
+
+
+def test_guard_counts_under_cudagraph_replay():
+    device = torch.device("cuda", torch.cuda.current_device())
+    # Exactly what the model runner does, and for the same reason: allocate the
+    # counter before anything can capture.
+    guard_telemetry.prealloc(device)
+    guard_telemetry.reset_for_test()
+
+    run = _seeded_call(device)
+
+    # Warm up on a side stream, the standard pre-capture dance. This also
+    # compiles the kernel: a JIT compile inside a capture would abort it.
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for _ in range(3):
+            run()
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+
+    warm = _count(device)
+    assert warm > 0, (
+        "the seeded fault did not fire the guard even eagerly -- the control is "
+        "broken, so the replay result below would mean nothing"
+    )
+    per_launch = warm // 3
+    assert per_launch > 0
+
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        run()
+    # Capturing itself must not have aborted, and must not have counted.
+    torch.cuda.synchronize()
+    before = _count(device)
+
+    for _ in range(REPLAYS):
+        graph.replay()
+    torch.cuda.synchronize()
+    after = _count(device)
+
+    delta = after - before
+    assert delta == REPLAYS * per_launch, (
+        f"counter advanced by {delta} over {REPLAYS} replays, expected "
+        f"{REPLAYS * per_launch}. A delta of 0 means the guard telemetry is "
+        f"dead under replay -- blocker B1 is NOT fixed."
+    )
+
+
+def test_counter_pointer_is_stable_across_replays():
+    """The captured atomic addresses one fixed buffer.
+
+    If counter() ever returned a fresh tensor, the captured graph would keep
+    writing to a freed address -- the other half of B1, and the one that
+    corrupts memory rather than merely losing evidence.
+    """
+    device = torch.device("cuda", torch.cuda.current_device())
+    guard_telemetry.prealloc(device)
+    first = guard_telemetry.counter(guard_telemetry.SITE_GDN_DECODE_STATE, device)
+    second = guard_telemetry.counter(guard_telemetry.SITE_GDN_DECODE_STATE, device)
+    assert first.data_ptr() == second.data_ptr()
+    # and the unindexed alias must resolve to the same buffer (review R2-7)
+    third = guard_telemetry.counter(
+        guard_telemetry.SITE_GDN_DECODE_STATE, torch.device("cuda")
+    )
+    assert third.data_ptr() == first.data_ptr()
+
+    # ...and it must survive the reader giving up on it (review R3-3). The
+    # round-3 failure path popped the buffer, which drops the only durable
+    # reference: counter() hands out transient views, and under replay nothing
+    # holds one at all, so the storage would return to the allocator, be
+    # reused, and the CAPTURED atomics would keep writing to the baked address.
+    # Stop polling, never stop holding.
+    try:
+        guard_telemetry._read_disabled.add(device)
+        after = guard_telemetry.counter(guard_telemetry.SITE_GDN_DECODE_STATE, device)
+        assert after.data_ptr() == first.data_ptr(), (
+            "the counter moved after the reader disabled it -- captured graphs "
+            "are now writing to freed storage"
+        )
+        assert device in guard_telemetry._buffers
+    finally:
+        guard_telemetry._read_disabled.discard(device)
diff --git a/tests/v1/worker/gpu/test_guard_telemetry_round11.py b/tests/v1/worker/gpu/test_guard_telemetry_round11.py
new file mode 100644
index 0000000000..cad039ed53
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_telemetry_round11.py
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Round 11 (Astra final review, findings 1-3) of the rc3-instr guard series.
+
+1. Release defaults are off / 0.05 with both variables absent (rc7, ruling N1;
+   rc3-rc6 shipped warn), and a
+   non-finite or non-positive interval is rejected at import.
+2. A reader that loses a device arms the stop (the fatal-site contract is
+   otherwise silently void).
+3. drain() reports a hit the cadence reader never saw and raises for an
+   always-fatal site when asked; it is what a stage end / orderly shutdown
+   calls so a last-step hit cannot be lost.
+"""
+
+import importlib
+import os
+import sys
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="CUDA required"
+)
+
+
+def _fresh(monkeypatch, **env):
+    for k in ("VLLM_E2_GUARD_MODE", "VLLM_E2_GUARD_INTERVAL"):
+        monkeypatch.delenv(k, raising=False)
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+    sys.modules.pop("vllm.v1.worker.guard_telemetry", None)
+    return importlib.import_module("vllm.v1.worker.guard_telemetry")
+
+
+def test_release_defaults_with_env_absent(monkeypatch):
+    gt = _fresh(monkeypatch)
+    assert gt._MODE == "off"  # v2-rc7: default off (ruling N1)
+    assert gt._INTERVAL == pytest.approx(0.05)
+
+
+@pytest.mark.parametrize("bad", ["nan", "inf", "-inf", "0", "-1", "abc"])
+def test_bad_interval_rejected_at_import(monkeypatch, bad):
+    with pytest.raises(ValueError):
+        _fresh(monkeypatch, VLLM_E2_GUARD_INTERVAL=bad)
+
+
+def test_reader_loss_arms_the_stop(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="warn")  # the reader exists only when opted in (rc7 default off)
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt.reset_for_test()
+
+    # v2-rc6: the cadence reader no longer reads the device buffer itself; it
+    # polls the NonBlockingReader. Inject the read failure there.
+    def broken_poll(key):
+        raise RuntimeError("simulated D2H failure")
+
+    monkeypatch.setattr(gt._nb_reader, "poll_one", broken_poll)
+    gt._poll_once()
+    assert device in gt._read_disabled
+    with pytest.raises(RuntimeError, match="fatal-site contract"):
+        gt.check_pending()
+
+
+def test_drain_reports_last_step_hit_and_raises_for_fatal_site(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="warn")  # warn mode (opt-in since rc7): a plain site must NOT raise
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt.reset_for_test()
+    buf = gt._buffers[device]
+    # a hit at a non-fatal site, written as the kernels would (count, row, val)
+    plain = next(s for s in gt.SITE_NAMES if s not in gt._ALWAYS_FATAL_SITES)
+    buf[plain, 0] = 3
+    snap = gt.drain(raise_on_fatal=True)
+    assert any(v[0] == 3 for v in snap.values())
+    gt.check_pending()  # nothing armed under warn for a plain site
+    # a hit at the always-fatal RoPE site: drain must raise when asked
+    buf[gt.SITE_QSA_ROPE_POS, 0] = 1
+    with pytest.raises(RuntimeError, match="FINAL DRAIN"):
+        gt.drain(raise_on_fatal=True)
+    # and the non-raising form still arms the stop for the engine thread
+    gt.reset_for_test()
+    buf[gt.SITE_QSA_ROPE_POS, 0] = 1
+    gt.drain()
+    with pytest.raises(RuntimeError):
+        gt.check_pending()
+
+
+def test_drain_is_silent_under_off(monkeypatch):
+    gt = _fresh(monkeypatch, VLLM_E2_GUARD_MODE="off")
+    device = torch.device("cuda:0")
+    gt.prealloc(device)
+    gt._buffers[device][gt.SITE_QSA_ROPE_POS, 0] = 1
+    assert gt.drain(raise_on_fatal=True) == {}
diff --git a/tests/v1/worker/gpu/test_pp_deferred_mamba_block_table.py b/tests/v1/worker/gpu/test_pp_deferred_mamba_block_table.py
new file mode 100644
index 0000000000..c2f7a388f5
--- /dev/null
+++ b/tests/v1/worker/gpu/test_pp_deferred_mamba_block_table.py
@@ -0,0 +1,706 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Which block-table row the align post-process kernel reads.
+
+Under pipeline parallelism the Mamba align post-process is *deferred*: it is
+enqueued by ``update_pp_decode_requests`` at the top of ``execute_model``
+(``model_runner.py:1644``), before this step's ``gather_block_tables``
+(``model_runner.py:1442`` -> ``block_table.py:149``), and the ``idx_mapping`` it
+carries was captured ``pp_size`` steps earlier on a ``PendingRecv``
+(``pp_utils.py:57-58, 258-271``). There is exactly one gathered destination
+buffer, reused in place for the engine's lifetime (``block_table.py:74-76``), so
+at that moment it holds the batch of step T-1 while the mapping describes the
+batch of step T-2. With two-way PP micro-batch alternation those are different
+micro-batches by construction, so ``bt_row_idx = batch_idx``
+(``mamba_utils.py:481``) resolved a *different request's* row.
+
+These tests model the row selection on CPU: they drive the production plumbing
+(``MambaHybridModelState._ensure_align_ctx`` ->
+``MambaSpecDecodeGPUContext.initialize_from_forward_context`` ->
+``run_fused_postprocess_align``), capture the launch instead of running Triton,
+and then replay the kernel's index arithmetic against the two candidate tables.
+
+No GPU is required.
+"""
+
+import inspect
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.model_executor.layers.mamba.mamba_utils import (
+    MambaStateCopyFuncsByType,
+    get_conv_copy_spec,
+    get_temporal_copy_spec,
+)
+from vllm.v1.attention.backends.registry import MambaAttentionBackendEnum
+from vllm.v1.kv_cache_interface import KVCacheConfig, KVCacheGroupSpec, MambaSpec
+from vllm.v1.worker import mamba_utils as mamba_utils_mod
+from vllm.v1.worker.gpu.model_states.mamba_hybrid import MambaHybridModelState
+from vllm.v1.worker.mamba_utils import MambaSpecDecodeGPUContext
+
+MAX_NUM_REQS = 8
+MAX_NUM_BLOCKS = 6
+MAMBA_BLOCK_SIZE = 16
+NUM_PHYS_BLOCKS = 64
+CONV_WIDTH = 4
+CONV_INNER = 8
+TEMPORAL_DIM = 16
+DTYPE = torch.float16
+
+_COPY_FUNCS: MambaStateCopyFuncsByType = {
+    MambaAttentionBackendEnum.GDN_ATTN: (get_conv_copy_spec, get_temporal_copy_spec),
+}
+
+# Captured before any monkeypatching so the replay binds against the real
+# kernel signature; a launch that stops matching it fails loudly here.
+_POSTPROCESS_SIG = inspect.signature(
+    mamba_utils_mod.postprocess_mamba_fused_kernel.fn
+)
+_PRECOPY_SIG = inspect.signature(
+    mamba_utils_mod.precopy_mamba_align_fused_kernel.fn
+)
+
+
+class _MockCpuGpuBuffer:
+    """CpuGpuBuffer stand-in that needs no pinned memory."""
+
+    def __init__(self, size: int, dtype: torch.dtype, device: torch.device):
+        self.cpu = torch.zeros(size, dtype=dtype, device="cpu")
+        self.gpu = torch.zeros(size, dtype=dtype, device=device)
+        self.np = self.cpu.numpy()
+
+    def copy_to_gpu(self, n: int | None = None) -> torch.Tensor:
+        if n is None:
+            self.gpu.copy_(self.cpu)
+            return self.gpu
+        self.gpu[:n].copy_(self.cpu[:n])
+        return self.gpu[:n]
+
+
+class _RecordingKernel:
+    """Stands in for a triton.jit kernel and records the launch."""
+
+    def __init__(self) -> None:
+        self.launches: list[tuple[tuple[int, ...], tuple, dict]] = []
+
+    def __getitem__(self, grid):
+        def launch(*args, **kwargs):
+            self.launches.append((grid, args, kwargs))
+
+        return launch
+
+
+def _ptr_to_int(value: int) -> int:
+    """Undo ``_reinterpret_u64_as_i64`` (mamba_utils.py:186-189)."""
+    return value + (1 << 64) if value < 0 else value
+
+
+def _gather_rows(
+    persistent: torch.Tensor,
+    num_blocks: list[int],
+    idx_mapping: list[int],
+    num_reqs_padded: int,
+    dst: torch.Tensor,
+) -> None:
+    """CPU port of ``_gather_block_tables_kernel`` (block_table.py:236-273).
+
+    Row ``batch_idx`` of ``dst`` receives ``num_blocks[req_idx]`` entries of
+    persistent row ``req_idx``; rows in ``[num_reqs, num_reqs_padded)`` are
+    zeroed whole; rows at or beyond ``num_reqs_padded`` are left holding the
+    previous gather's content.
+    """
+    num_reqs = len(idx_mapping)
+    for batch_idx in range(num_reqs_padded):
+        if batch_idx >= num_reqs:
+            dst[batch_idx].zero_()
+            continue
+        req_idx = idx_mapping[batch_idx]
+        nb = num_blocks[req_idx]
+        dst[batch_idx, :nb] = persistent[req_idx, :nb]
+
+
+def _make_kv_cache_config() -> KVCacheConfig:
+    spec = MambaSpec(
+        block_size=MAMBA_BLOCK_SIZE,
+        shapes=((CONV_WIDTH, CONV_INNER), (TEMPORAL_DIM,)),
+        dtypes=(DTYPE, DTYPE),
+        mamba_type=MambaAttentionBackendEnum.GDN_ATTN,
+        mamba_cache_mode="align",
+        num_speculative_blocks=3,
+    )
+    return KVCacheConfig(
+        num_blocks=NUM_PHYS_BLOCKS,
+        kv_cache_tensors=[],
+        kv_cache_groups=[KVCacheGroupSpec(["layer_0"], spec)],
+    )
+
+
+def _make_forward_context() -> dict:
+    attention = MagicMock()
+    attention.kv_cache = [
+        torch.zeros(NUM_PHYS_BLOCKS, CONV_WIDTH, CONV_INNER, dtype=DTYPE),
+        torch.zeros(NUM_PHYS_BLOCKS, TEMPORAL_DIM, dtype=DTYPE),
+    ]
+    return {"layer_0": attention}
+
+
+def _register_block_tables(state: MambaHybridModelState, block_tables) -> bool:
+    """Hand the runner's persistent ``BlockTables`` to the model state.
+
+    Deliberately tolerant: on a tree without the fix the hook does not exist, and
+    the point of these tests is to report *which row the kernel reads*, not to
+    die on a missing attribute.
+    """
+    setter = getattr(state, "set_block_tables", None)
+    if setter is None:
+        return False
+    setter(block_tables)
+    return True
+
+
+def _build_scenario(
+    device: torch.device = torch.device("cpu"),
+    slot_mapping: list[int] = (0, 1, 2),
+    t1_mapping: list[int] = (2,),
+    register: bool = True,
+):
+    """T-2 gathers ``slot_mapping``; T-1 re-gathers ``t1_mapping`` into the same
+    buffer; the deferred post-process then runs with T-2's mapping.
+
+    ``slot_mapping`` is the batch-row -> req-slot mapping carried on the
+    PendingRecv. Making it non-identity is what separates "the kernel used the
+    persistent table" from "the kernel used req_idx as the row": with an
+    identity mapping ``batch_idx == req_idx`` and the two are indistinguishable.
+    """
+    kv_cache_config = _make_kv_cache_config()
+    forward_context = _make_forward_context()
+
+    # Persistent per-req-slot table (block_table.py:53-59). Row r owns block
+    # ids 10*(r+1) + col, so a row is identifiable from any single entry.
+    persistent = torch.zeros(
+        MAX_NUM_REQS, MAX_NUM_BLOCKS, dtype=torch.int32, device=device
+    )
+    for r in range(MAX_NUM_REQS):
+        for c in range(MAX_NUM_BLOCKS):
+            persistent[r, c] = 10 * (r + 1) + c
+    num_blocks = [3] * MAX_NUM_REQS
+
+    # The single gathered destination buffer (block_table.py:74-76).
+    slot_mapping = list(slot_mapping)
+    t1_mapping = list(t1_mapping)
+    gathered = torch.zeros_like(persistent)
+    _gather_rows(persistent, num_blocks, slot_mapping, len(slot_mapping) + 1, gathered)
+    _gather_rows(persistent, num_blocks, t1_mapping, len(t1_mapping) + 1, gathered)
+
+    ctx = MambaSpecDecodeGPUContext.create(
+        max_num_reqs=MAX_NUM_REQS,
+        kv_cache_config=kv_cache_config,
+        copy_funcs=_COPY_FUNCS,
+        device=device,
+        make_buffer=lambda n, dtype: _MockCpuGpuBuffer(n, dtype, device),
+    )
+
+    state = object.__new__(MambaHybridModelState)
+    state.device = device
+    state.max_num_reqs = MAX_NUM_REQS
+    state._align_mode = True
+    state._mamba_ctx = ctx
+    state._mamba_group_ids = []
+    state._mamba_spec = None
+    state._mamba_state_copy_funcs = _COPY_FUNCS
+    # object.__new__ skips __init__, so mirror the attribute it would set.
+    state._runner_block_tables = None
+    state.vllm_config = SimpleNamespace(
+        compilation_config=SimpleNamespace(static_forward_context=forward_context)
+    )
+    registered = (
+        _register_block_tables(
+            state,
+            SimpleNamespace(block_tables=[SimpleNamespace(gpu=persistent)]),
+        )
+        if register
+        else False
+    )
+
+    # What the runner hands prepare_attn/preprocess_state: the T-1 gather view.
+    gathered_view = gathered[: len(t1_mapping) + 1]
+    state._ensure_align_ctx(kv_cache_config, [0], (gathered_view,))
+
+    tables_by_ptr = {
+        persistent.data_ptr(): ("persistent", persistent),
+        gathered.data_ptr(): ("gathered", gathered),
+    }
+    return SimpleNamespace(
+        ctx=ctx,
+        state=state,
+        slot_mapping=slot_mapping,
+        persistent=persistent,
+        gathered=gathered,
+        tables_by_ptr=tables_by_ptr,
+        registered=registered,
+    )
+
+
+def _replay_row(scenario, launch, batch_idx: int) -> tuple[str, int, dict]:
+    """Replay the kernel's row selection (mamba_utils.py:437-490) for one row.
+
+    Returns ``(table_name, bt_row_idx, predicate)``.
+    """
+    grid, args, kwargs = launch
+    bound = _POSTPROCESS_SIG.bind(*args, **kwargs)
+    bound.apply_defaults()
+    a = bound.arguments
+
+    num_reqs = a["num_reqs"]
+    assert grid[0] == num_reqs, (grid, num_reqs)
+    assert batch_idx < num_reqs
+
+    has_idx_mapping = bool(a["HAS_IDX_MAPPING"])
+    # Absent on a tree without the fix; the kernel then always uses batch_idx.
+    bt_row_is_req = bool(a.get("BT_ROW_IS_REQ", False))
+
+    if has_idx_mapping:
+        req_idx = int(a["idx_mapping_ptr"][batch_idx])
+        if req_idx < 0:
+            return ("skipped", -1, {})
+    else:
+        req_idx = batch_idx
+
+    num_accepted = int(a["num_accepted_tokens_ptr"][req_idx])
+    src_block_idx = int(a["mamba_state_idx_ptr"][req_idx])
+    assert bool(a["PRECOMPUTED_NEW_COMPUTED"]), "V2 align path only"
+    new_num_computed = int(a["num_computed_tokens_ptr"][req_idx])
+    block_size = int(a["block_size"])
+
+    num_tokens_running_state = new_num_computed - num_accepted + 1
+    aligned_new_computed = (new_num_computed // block_size) * block_size
+    needs_copy = aligned_new_computed >= num_tokens_running_state
+    accept_token_bias = aligned_new_computed - num_tokens_running_state
+    dest_block_idx = aligned_new_computed // block_size - 1
+    predicate = {
+        "needs_copy": needs_copy,
+        "num_accepted": num_accepted,
+        "new_num_computed_mod_block": new_num_computed % block_size,
+        "src_col": src_block_idx,
+        "dst_col": dest_block_idx,
+        "token_bias": accept_token_bias,
+        "src_eq_dst": src_block_idx == dest_block_idx,
+    }
+
+    if bt_row_is_req:
+        bt_row_idx = req_idx
+    else:
+        bt_row_idx = batch_idx if has_idx_mapping else req_idx
+
+    group_idx = int(a["state_group_indices_ptr"][0])
+    ptr = _ptr_to_int(int(a["block_table_ptrs_ptr"][group_idx]))
+    name, _table = scenario.tables_by_ptr[ptr]
+    return (name, bt_row_idx, predicate)
+
+
+def _block_ids(scenario, launch, batch_idx: int) -> dict:
+    name, bt_row_idx, predicate = _replay_row(scenario, launch, batch_idx)
+    table = next(
+        tbl for label, tbl in scenario.tables_by_ptr.values() if label == name
+    )
+    return {
+        "table": name,
+        "row": bt_row_idx,
+        "src_block_id": int(table[bt_row_idx, predicate["src_col"]]),
+        "dst_block_id": int(table[bt_row_idx, predicate["dst_col"]]),
+        "temporal_src_block_id": int(
+            table[bt_row_idx, predicate["src_col"] + predicate["token_bias"]]
+        ),
+        **predicate,
+    }
+
+
+def _run_deferred(scenario, monkeypatch: pytest.MonkeyPatch) -> _RecordingKernel:
+    recorder = _RecordingKernel()
+    monkeypatch.setattr(
+        mamba_utils_mod, "postprocess_mamba_fused_kernel", recorder
+    )
+    device = scenario.persistent.device
+
+    def t(values):
+        return torch.tensor(values, dtype=torch.int32, device=device)
+
+    # Per-req-SLOT decision arrays (mamba_utils.py:439-458 reads them at
+    # req_idx, never at batch_idx), so they are keyed by the slot mapping.
+    copier, *bystanders = scenario.slot_mapping
+    num_accepted = torch.ones(MAX_NUM_REQS, dtype=torch.int32, device=device)
+    state_idx = torch.zeros(MAX_NUM_REQS, dtype=torch.int32, device=device)
+    new_num_computed = torch.zeros(MAX_NUM_REQS, dtype=torch.int32, device=device)
+    # Only the first batch row crosses a block boundary inside its accepted
+    # window: 32 % 16 = 0 < num_accepted 2.
+    num_accepted[copier] = 2
+    new_num_computed[copier] = 32
+    for slot in bystanders:
+        num_accepted[slot] = 2
+        new_num_computed[slot] = 40  # 40 % 16 = 8 >= 2 -> no copy
+
+    scenario.ctx.run_fused_postprocess_align(
+        num_reqs=len(scenario.slot_mapping),
+        num_accepted_tokens_gpu=num_accepted,
+        state_idx_gpu=state_idx,
+        new_num_computed_tokens_gpu=new_num_computed,
+        idx_mapping=t(scenario.slot_mapping),  # captured at T-2
+    )
+    return recorder
+
+
+def test_gather_port_matches_production_semantics() -> None:
+    """Instrument check: the CPU gather port must reproduce block_table.py."""
+    persistent = torch.arange(
+        MAX_NUM_REQS * MAX_NUM_BLOCKS, dtype=torch.int32
+    ).reshape(MAX_NUM_REQS, MAX_NUM_BLOCKS)
+    dst = torch.full_like(persistent, -7)
+    num_blocks = [2] * MAX_NUM_REQS
+
+    _gather_rows(persistent, num_blocks, [3, 1], 3, dst)
+
+    # Gathered rows carry only the first num_blocks entries...
+    assert dst[0, :2].tolist() == persistent[3, :2].tolist()
+    assert dst[1, :2].tolist() == persistent[1, :2].tolist()
+    # ...the tail of a gathered row is untouched (block_table.py:269-273),
+    assert dst[0, 2:].tolist() == [-7] * (MAX_NUM_BLOCKS - 2)
+    # ...padded rows in [num_reqs, num_reqs_padded) are zeroed whole,
+    assert dst[2].tolist() == [0] * MAX_NUM_BLOCKS
+    # ...and rows at or beyond num_reqs_padded keep the previous content.
+    assert dst[3].tolist() == [-7] * MAX_NUM_BLOCKS
+
+
+def test_deferred_postprocess_resolves_the_requests_own_row(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """r0's deferred copy must land on r0's blocks, not on r2's.
+
+    T-2 gathered [r0, r1, r2]; T-1 re-gathered [r2] into the same buffer, so
+    gathered row 0 now holds r2. The deferred launch still carries T-2's
+    mapping, so ``batch_idx = 0`` means r0.
+    """
+    scenario = _build_scenario()
+    recorder = _run_deferred(scenario, monkeypatch)
+    assert len(recorder.launches) == 1
+    launch = recorder.launches[0]
+
+    row0 = _block_ids(scenario, launch, 0)
+    why = (
+        f"resolved={row0} "
+        f"runner_hook_registered={scenario.registered} "
+        f"(a missing runner hook leaves the kernel on the batch-order gather)"
+    )
+
+    # The copy predicate really fires for this row, so the kernel does
+    # dereference the block table here (mamba_utils.py:462-479).
+    assert row0["needs_copy"] is True, why
+    assert row0["src_eq_dst"] is False, why
+    assert (row0["src_col"], row0["dst_col"], row0["token_bias"]) == (0, 1, 1), why
+
+    # The gathered buffer holds r2 at batch row 0 after the T-1 gather, so a
+    # kernel that still indexes it by batch_idx corrupts r2 on r0's behalf.
+    assert scenario.gathered[0, 0].item() == 30
+
+    # r0's persistent row is 10, 11, 12, ...
+    assert row0["table"] == "persistent", why
+    assert row0["row"] == 0, why
+    assert row0["src_block_id"] == 10, why
+    assert row0["dst_block_id"] == 11, why
+    assert row0["temporal_src_block_id"] == 11, why
+    assert scenario.registered, why
+
+
+def test_deferred_postprocess_skips_rows_without_a_boundary_crossing(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The other two rows do not reach the block table at all."""
+    scenario = _build_scenario()
+    recorder = _run_deferred(scenario, monkeypatch)
+    launch = recorder.launches[0]
+
+    for batch_idx in (1, 2):
+        _name, _row, predicate = _replay_row(scenario, launch, batch_idx)
+        assert predicate["needs_copy"] is False, (batch_idx, predicate)
+
+
+def test_precopy_still_uses_the_same_step_gather(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The pre-copy site must keep batch-order rows.
+
+    ``precopy_mamba_align_fused_kernel`` (mamba_utils.py:613-615) runs from
+    ``preprocess_state``, five lines after the gather that feeds it
+    (``model_runner.py:1718`` -> ``:1723``), so batch row i *is* this request.
+    Switching it to req rows would break it.
+    """
+    scenario = _build_scenario()
+    recorder = _RecordingKernel()
+    monkeypatch.setattr(
+        mamba_utils_mod, "precopy_mamba_align_fused_kernel", recorder
+    )
+    device = scenario.persistent.device
+    z = torch.zeros(MAX_NUM_REQS, dtype=torch.int32, device=device)
+
+    scenario.ctx.run_fused_precopy(
+        num_reqs=3,
+        state_idx_gpu=z.clone(),
+        src_col_gpu=z.clone(),
+        token_bias_gpu=z.clone(),
+        idx_mapping=torch.tensor([0, 1, 2], dtype=torch.int32, device=device),
+    )
+
+    assert len(recorder.launches) == 1
+    _grid, args, kwargs = recorder.launches[0]
+    bound = _PRECOPY_SIG.bind(*args, **kwargs)
+    bound.apply_defaults()
+    ptr = _ptr_to_int(int(bound.arguments["block_table_ptrs_ptr"][0]))
+    assert scenario.tables_by_ptr[ptr][0] == "gathered"
+    assert bound.arguments["HAS_IDX_MAPPING"] is True
+    assert "BT_ROW_IS_REQ" not in bound.arguments
+
+
+def test_deferred_postprocess_uses_req_rows_under_a_non_identity_mapping(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Batch row 0 -> request slot 5, so batch_idx and req_idx disagree.
+
+    The identity-mapping case above pins *which table*; this one pins *which
+    row*. Every wrong combination lands on a different set of block ids:
+
+    ==========================  ==========  ==================
+    table / row                 resolves    block ids
+    ==========================  ==========  ==================
+    persistent[req_idx=5]       correct     60, 61
+    persistent[batch_idx=0]     wrong row   10, 11
+    gathered[batch_idx=0]       rc1         30, 31 (r2, from T-1)
+    gathered[req_idx=5]         wrong both  0, 0 (never written)
+    ==========================  ==========  ==================
+    """
+    scenario = _build_scenario(slot_mapping=[5, 1, 2], t1_mapping=[2])
+    recorder = _run_deferred(scenario, monkeypatch)
+    assert len(recorder.launches) == 1
+    launch = recorder.launches[0]
+
+    _grid, args, kwargs = launch
+    bound = _POSTPROCESS_SIG.bind(*args, **kwargs)
+    bound.apply_defaults()
+    # The constexpr itself, not just its effect.
+    assert bound.arguments["BT_ROW_IS_REQ"] is True
+    assert bound.arguments["HAS_IDX_MAPPING"] is True
+
+    row0 = _block_ids(scenario, launch, 0)
+    why = f"resolved={row0} runner_hook_registered={scenario.registered}"
+
+    assert row0["needs_copy"] is True, why
+    assert row0["src_eq_dst"] is False, why
+    assert (row0["src_col"], row0["dst_col"], row0["token_bias"]) == (0, 1, 1), why
+
+    # The row index is the request slot, not the batch row.
+    assert row0["table"] == "persistent", why
+    assert row0["row"] == 5, why
+    assert row0["src_block_id"] == 60, why
+    assert row0["dst_block_id"] == 61, why
+    assert row0["temporal_src_block_id"] == 61, why
+
+    # None of the three wrong coordinates.
+    assert scenario.persistent[0, 0].item() == 10  # persistent, batch row
+    assert scenario.gathered[0, 0].item() == 30  # rc1: gathered, batch row
+    assert scenario.gathered[5, 0].item() == 0  # gathered, req row: never written
+    assert row0["src_block_id"] not in (10, 30, 0), why
+
+
+def test_align_postprocess_fails_closed_without_persistent_tables(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """No silent fallback to the batch-order gather.
+
+    A context that never received the persistent tables is a caller bug: the
+    only other thing the kernel could index is the stale gather, which is the
+    corruption this change exists to remove. It must raise, and it must raise
+    before mutating the accepted-token snapshot.
+    """
+    scenario = _build_scenario(slot_mapping=[5, 1, 2], t1_mapping=[2], register=False)
+    assert scenario.registered is False
+    assert scenario.ctx.has_persistent_block_tables is False
+
+    recorder = _RecordingKernel()
+    monkeypatch.setattr(
+        mamba_utils_mod, "postprocess_mamba_fused_kernel", recorder
+    )
+    device = scenario.persistent.device
+    before = scenario.ctx.num_accepted_tokens_out.clone()
+    num_accepted = torch.full(
+        (MAX_NUM_REQS,), 7, dtype=torch.int32, device=device
+    )
+
+    with pytest.raises(RuntimeError, match="persistent per-req-slot block tables"):
+        scenario.ctx.run_fused_postprocess_align(
+            num_reqs=3,
+            num_accepted_tokens_gpu=num_accepted,
+            state_idx_gpu=torch.zeros(MAX_NUM_REQS, dtype=torch.int32, device=device),
+            new_num_computed_tokens_gpu=torch.full(
+                (MAX_NUM_REQS,), 32, dtype=torch.int32, device=device
+            ),
+            idx_mapping=torch.tensor([5, 1, 2], dtype=torch.int32, device=device),
+        )
+
+    assert recorder.launches == []
+    torch.testing.assert_close(scenario.ctx.num_accepted_tokens_out, before)
+
+
+def test_precopy_still_works_without_persistent_tables(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The V1 pre-copy contract is untouched by the fail-closed rule.
+
+    Only the V2 align post-process needs per-req-slot rows; the pre-copy reads
+    the same-step gather and must keep launching on a context that never
+    received the persistent tables.
+    """
+    scenario = _build_scenario(register=False)
+    assert scenario.ctx.has_persistent_block_tables is False
+    recorder = _RecordingKernel()
+    monkeypatch.setattr(
+        mamba_utils_mod, "precopy_mamba_align_fused_kernel", recorder
+    )
+    device = scenario.persistent.device
+    z = torch.zeros(MAX_NUM_REQS, dtype=torch.int32, device=device)
+
+    scenario.ctx.run_fused_precopy(
+        num_reqs=1,
+        state_idx_gpu=z.clone(),
+        src_col_gpu=torch.full_like(z, -1),
+        token_bias_gpu=z.clone(),
+        idx_mapping=None,
+    )
+
+    assert len(recorder.launches) == 1
+    _grid, args, kwargs = recorder.launches[0]
+    bound = _PRECOPY_SIG.bind(*args, **kwargs)
+    bound.apply_defaults()
+    ptr = _ptr_to_int(int(bound.arguments["block_table_ptrs_ptr"][0]))
+    assert scenario.tables_by_ptr[ptr][0] == "gathered"
+
+
+# ---------------------------------------------------- generation masking (CPU)
+
+
+def mask_from_generation_change(
+    idx_mapping: list[int],
+    reused_slot_rows: list[int],
+) -> list[int]:
+    """Run the real generation masking and return the mapping it produces.
+
+    Drives ``PPHandler.get_prev_sampled_outputs`` (pp_utils.py:132-140) rather
+    than hand-writing a -1: a slot whose generation counter moved between
+    ``receive`` and consumption has been freed and handed to a new request, and
+    the handler must replace its row with -1 so the kernel skips it
+    (mamba_utils.py:441-442).
+
+    Exported so the GPU suite can consume a mapping that a real reuse produced.
+    """
+    from collections import deque
+
+    from vllm.v1.worker.gpu import pp_utils as pp_utils_mod
+
+    num_reqs = len(idx_mapping)
+    idx_np = np.asarray(idx_mapping, dtype=np.intp)
+
+    handler = object.__new__(pp_utils_mod.PPHandler)
+    handler.device = torch.device("cpu")
+    handler.main_stream = SimpleNamespace(wait_event=lambda event: None)
+    # Slot generation counters as they stand now.
+    handler.req_idx_gen_np = np.zeros(max(int(idx_np.max()) + 1, 1), dtype=np.int32)
+    # Snapshot taken at receive time; a reused slot has since been bumped.
+    gen_at_receive = handler.req_idx_gen_np[idx_np].copy()
+    for row in reused_slot_rows:
+        handler.req_idx_gen_np[idx_np[row]] += 1
+
+    slot = pp_utils_mod.PendingRecv(
+        event=object(),
+        sampled_tokens=torch.zeros(num_reqs, 1, dtype=torch.int64),
+        num_sampled=torch.ones(num_reqs, dtype=torch.int32),
+        num_rejected=torch.zeros(num_reqs, dtype=torch.int32),
+        idx_mapping=torch.as_tensor(idx_np, dtype=torch.int32),
+        idx_mapping_np=idx_np,
+        need_sampled_mask=np.ones(num_reqs, dtype=bool),
+        gen_at_receive_np=gen_at_receive,
+    )
+    handler.queue = deque([slot])
+
+    captured: dict[str, object] = {}
+
+    def fake_async_copy_to_gpu(array, device=None):
+        captured["np"] = np.asarray(array).copy()
+        return torch.as_tensor(np.asarray(array), dtype=torch.int32)
+
+    original = pp_utils_mod.async_copy_to_gpu
+    pp_utils_mod.async_copy_to_gpu = fake_async_copy_to_gpu
+    try:
+        outputs = handler.get_prev_sampled_outputs()
+    finally:
+        pp_utils_mod.async_copy_to_gpu = original
+
+    assert outputs is not None, "the whole batch was excluded"
+    return [int(v) for v in outputs["idx_mapping"].tolist()]
+
+
+def test_generation_change_masks_only_the_reused_row():
+    """A slot handed to a new request between capture and use becomes -1."""
+    assert mask_from_generation_change([5, 1, 2], [1]) == [5, -1, 2]
+    assert mask_from_generation_change([5, 1, 2], [0, 2]) == [-1, 1, -1]
+    # No reuse: the handler returns the original tensor untouched.
+    assert mask_from_generation_change([5, 1, 2], []) == [5, 1, 2]
+
+
+def test_kernel_rejects_negative_req_idx_before_any_load_that_uses_it():
+    """Structural check: the guard precedes every load indexed by req_idx.
+
+    ``mamba_utils.py:441-442`` returns on ``req_idx < 0``; the decision loads at
+    ``:445-446`` index by ``req_idx``. If a future edit reordered them, a masked
+    row would dereference index -1 before being rejected. The GPU suite plants
+    poison at index -1 to catch that at runtime; this catches it on CPU, in the
+    source, with no device.
+    """
+    import ast
+    import textwrap
+
+    source = textwrap.dedent(
+        inspect.getsource(mamba_utils_mod.postprocess_mamba_fused_kernel.fn)
+    )
+    tree = ast.parse(source)
+    func = tree.body[0]
+
+    guard_lines = [
+        node.lineno
+        for node in ast.walk(func)
+        if isinstance(node, ast.If)
+        and isinstance(node.test, ast.Compare)
+        and isinstance(node.test.left, ast.Name)
+        and node.test.left.id == "req_idx"
+        and any(isinstance(op, ast.Lt) for op in node.test.ops)
+        and any(isinstance(stmt, ast.Return) for stmt in node.body)
+    ]
+    assert guard_lines, "no `if req_idx < 0: return` guard found in the kernel"
+    guard_line = min(guard_lines)
+
+    # Every expression that adds req_idx to a pointer, i.e. every load or store
+    # that would dereference a negative index.
+    uses = [
+        node.lineno
+        for node in ast.walk(func)
+        if isinstance(node, ast.BinOp)
+        and isinstance(node.op, ast.Add)
+        and isinstance(node.right, ast.Name)
+        and node.right.id == "req_idx"
+    ]
+    assert uses, "no pointer arithmetic on req_idx found; has the kernel moved?"
+    assert min(uses) > guard_line, (
+        f"a req_idx-indexed access at line {min(uses)} precedes the "
+        f"`req_idx < 0` guard at line {guard_line} (offsets are relative to the "
+        f"kernel body)"
+    )
