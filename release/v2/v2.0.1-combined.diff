+
+    error = Error()
+elif scenario == "blocking-name-format":
+    class BlockingName(str):
+        def __format__(self, format_spec):
+            threading.Event().wait()
+
+    class Meta(type):
+        @property
+        def __name__(cls):
+            return BlockingName("Error")
+
+    class Error(Exception, metaclass=Meta):
+        pass
+
+    error = Error()
+elif scenario == "blocking-str-method":
+    class Error(Exception):
+        def __str__(self):
+            threading.Event().wait()
+
+    error = Error()
+elif scenario == "overridden-getattribute":
+    class Error(Exception):
+        def __getattribute__(self, name):
+            threading.Event().wait()
+
+    error = Error("detail")
+elif scenario == "str-subclass-argument":
+    class BlockingString(str):
+        def __format__(self, format_spec):
+            threading.Event().wait()
+
+        def __str__(self):
