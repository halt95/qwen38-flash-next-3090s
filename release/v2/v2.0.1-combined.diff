+
+def test_cut6_requires_same_incomplete_completion(monkeypatch):
+    import vllm.v1.ple_offload.progress as progress
+
+    class Event:
+        complete = False
+
+        def query(self):
+            return self.complete
+
+    monitor = progress.PleProgressMonitor(
+        rank=0,
+        layer_names=("ple",),
+        serving_deadline_s=60,
+        startup_deadline_s=60,
+    )
+    event = Event()
+    try:
+        sequence = monitor.begin(startup=False, num_tokens=1)
+        monitor.track_completion(event)
+        monitor.complete()
+        assert monitor.completion_is_pending(sequence)
+        event.complete = True
+        assert not monitor.completion_is_pending(sequence)
+        assert not monitor.completion_is_pending(sequence + 1)
+    finally:
