@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import multiprocessing
+from typing import Any
+
+import pytest
+
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.fatal import (
+    fail_ple_execute_model,
+    ple_fail_closed,
+)
+
+
+class _Progress:
+    sequence = 7
+
+    def begin(self, **_: Any) -> int:
+        return self.sequence
+
+    def complete(self) -> None:
+        return
+
+
+class _RaisingProgress(_Progress):
+    def begin(self, **_: Any) -> int:
+        raise RuntimeError("begin injection")
+
+
+class _InjectedConnector:
+    rank = 3
+    tp_rank = 1
+    _layers = {"ple": object()}
+    _progress = _Progress()
+    _input_ids_buf = None
+    _query_start_loc_buf = None
+
+    def __init__(self, where: str) -> None:
+        self.where = where
+        if where == "begin":
+            self._progress = _RaisingProgress()
+
+    def _fail_closed(self, where: str, error: BaseException) -> None:
+        ple_fail_closed(
+            where=where,
+            rank=self.rank,
+            layer="ple",
+            sequence=self._progress.sequence,
+            error=error,
+        )
+
+    def _prepare_forward_impl(self, *args: Any, **kwargs: Any) -> None:
+        if self.where == "prepare":
+            raise RuntimeError("prepare injection")
+
+    def _release_outputs_impl(self) -> None:
+        if self.where == "release":
+            raise RuntimeError("release injection")
+
+
+class _Runner:
+    def __init__(self, where: str) -> None:
+        self._ple_offload_connector = _InjectedConnector(where)
+        self.where = where
+
+    @fail_ple_execute_model
+    def execute_model(self) -> None:
+        connector = self._ple_offload_connector
+        PleOffloadConnector.prepare_forward(
+            connector,
+            1,
+            1,
+            False,
+            consumer_num_tokens=1,
+        )
+        if self.where == "forward":
+            raise RuntimeError("forward injection")
+        PleOffloadConnector.release_outputs(connector)
+
+
+def _rpc_loop(where: str, successor_count: Any) -> None:
+    runner = _Runner(where)
+    try:
+        runner.execute_model()
+    except Exception:
+        # Mirrors WorkerProc._execute_worker_rpc: this must never regain control.
+        pass
+    with successor_count.get_lock():
+        successor_count.value += 1
+
+
+@pytest.mark.parametrize("where", ["prepare", "forward", "release"])
+def test_ple_exception_kills_workerproc_style_rpc(
+    where: str,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    successor_count = context.Value("i", 0)
+    process = context.Process(
+        target=_rpc_loop,
+        args=(where, successor_count),
+    )
+    process.start()
+    # Spawned children import vLLM cold (measured 4-8 s on the reference host); the bound is
+    # about start-up, not the fatal path, which exits immediately.
+    process.join(timeout=120)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+    assert successor_count.value == 0
+
+
+def _rpc_loop_connector_only(where: str, successor_count: Any) -> None:
+    # No execute_model decorator: only the connector's own fatal wrappers can
+    # stop the RPC loop from regaining control. (The decorated test above
+    # passes on the decorator alone, so it cannot vouch for these wrappers.)
+    connector = _InjectedConnector(where)
+    try:
+        if where == "begin":
+            PleOffloadConnector.begin_forward(
+                connector, dummy_run=False, num_tokens=1
+            )
+        elif where == "prepare":
+            PleOffloadConnector.prepare_forward(
+                connector, 1, 1, False, consumer_num_tokens=1
+            )
+        else:
+            PleOffloadConnector.release_outputs(connector)
+    except Exception:
+        pass
+    with successor_count.get_lock():
+        successor_count.value += 1
+
+
+@pytest.mark.parametrize("where", ["begin", "prepare", "release"])
+def test_connector_wrappers_are_fatal_without_decorator(where: str) -> None:
+    context = multiprocessing.get_context("spawn")
+    successor_count = context.Value("i", 0)
+    process = context.Process(
+        target=_rpc_loop_connector_only,
+        args=(where, successor_count),
+    )
+    process.start()
+    process.join(timeout=120)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+    assert successor_count.value == 0
