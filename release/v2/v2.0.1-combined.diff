+# SPDX-License-Identifier: Apache-2.0
+
+import os
+from multiprocessing.reduction import ForkingPickler
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.v1.ple_offload import connector as connector_module
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.protocol import PleOffloadRegistration
+
+
+def _require_file_system_shm() -> None:
+    if (
+        os.name != "posix"
+        or not os.path.isdir("/dev/shm")
+        or not os.access("/dev/shm", os.W_OK)
+    ):
+        pytest.skip("POSIX /dev/shm is unavailable")
+    if "file_system" not in torch_mp.get_all_sharing_strategies():
+        pytest.skip("torch file_system sharing is unavailable")
+
+
+def _shm_path(tensor: torch.Tensor) -> Path:
+    _, filename, _ = tensor.untyped_storage()._share_filename_cpu_()
+    return Path("/dev/shm") / os.fsdecode(filename).lstrip("/")
+
+
+def _make_connector_storage() -> tuple[PleOffloadConnector, list[torch.Tensor]]:
+    original_strategy = torch_mp.get_sharing_strategy()
+    torch_mp.set_sharing_strategy("file_system")
+    try:
+        host_outputs = {
+            "layer.0": torch.arange(12, dtype=torch.float32)
+            .reshape(3, 4)
+            .share_memory_(),
+            "layer.1": torch.arange(8, dtype=torch.float32)
+            .reshape(2, 4)
+            .share_memory_(),
+        }
+        host_flags = {
+            name: torch.zeros(16, dtype=torch.int32).share_memory_()
+            for name in host_outputs
+        }
+        input_ids = torch.arange(16, dtype=torch.int32).share_memory_()
+        query_start_loc = torch.arange(5, dtype=torch.int32).share_memory_()
+        ngram_context = torch.arange(12, dtype=torch.int32).reshape(4, 3)
+        ngram_context.share_memory_()
+
+        registration = PleOffloadRegistration(
+            worker_id=0,
+            tp_rank=0,
+            dp_rank=0,
+            host_output_buffers=host_outputs,
+            host_flag_tensors=host_flags,
+            input_ids_buf=input_ids,
+            query_start_loc_buf=query_start_loc,
+            ngram_context_buf=ngram_context,
+        )
+        # Match producer serialization and worker reconstruction. loads()
+        # consumes the transfer reference added by dumps(), leaving storage
+        # destruction able to reach the allocator's zero-counter branch.
+        payload = ForkingPickler.dumps(registration)
+        rebuilt_registration = ForkingPickler.loads(payload)
+        assert isinstance(rebuilt_registration, PleOffloadRegistration)
+        del rebuilt_registration
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._host_output_bufs = host_outputs
+    connector._host_flags = host_flags
+    connector._reserved_host_storage_filenames = set()
+    connector._input_ids_buf = input_ids
+    connector._query_start_loc_buf = query_start_loc
+    connector._ngram_context_buf = ngram_context
+    tensors = [
+        *host_outputs.values(),
+        *host_flags.values(),
+        input_ids,
+        query_start_loc,
+        ngram_context,
+    ]
+    assert len(tensors) == 7
+    return connector, tensors
+
+
+def test_release_host_storage_unlinks_names_but_keeps_mappings() -> None:
+    _require_file_system_shm()
+    connector, tensors = _make_connector_storage()
+    paths = [_shm_path(tensor) for tensor in tensors]
+    before = [tensor.clone() for tensor in tensors]
+    assert len(set(paths)) == 7
+    assert all(path.exists() for path in paths)
+
+    connector.release_host_storage()
+    connector.release_host_storage()
+
+    assert all(not path.exists() for path in paths)
+    for tensor, expected in zip(tensors, before):
+        assert torch.equal(tensor, expected)
+        tensor.add_(1)
+        assert torch.equal(tensor, expected + 1)
+
+
+def test_without_release_helper_names_remain(monkeypatch) -> None:
+    _require_file_system_shm()
+    connector, tensors = _make_connector_storage()
+    paths = [_shm_path(tensor) for tensor in tensors]
+
+    with monkeypatch.context() as patch:
+        patch.setattr(
+            connector_module,
+            "_unlink_filename_shared_storage",
+            lambda _tensor, _reservations: None,
+        )
+        connector.release_host_storage()
+
+    # Do not manually unlink these while their unreserved storages are live.
+    # Normal storage destruction removes them after the test frame is released.
+    assert all(path.exists() for path in paths)
+
+
+def test_release_host_storage_does_not_convert_fd_shared_storage() -> None:
+    if "file_descriptor" not in torch_mp.get_all_sharing_strategies():
+        pytest.skip("torch file_descriptor sharing is unavailable")
+    original_strategy = torch_mp.get_sharing_strategy()
+    torch_mp.set_sharing_strategy("file_descriptor")
+    try:
+        fd_tensor = torch.arange(8, dtype=torch.int32).share_memory_()
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._host_output_bufs = {"layer.0": fd_tensor}
+    connector._host_flags = {}
+    connector._reserved_host_storage_filenames = set()
+    connector._input_ids_buf = torch.arange(2, dtype=torch.int32)
+    connector._query_start_loc_buf = torch.arange(2, dtype=torch.int32)
+    connector._ngram_context_buf = None
+    expected = fd_tensor.clone()
+
+    connector.release_host_storage()
+
+    assert fd_tensor.untyped_storage()._get_shared_fd() >= 0
+    assert torch.equal(fd_tensor, expected)
+
+
+class _FakeFilenameStorage:
+    def __init__(self, filename: bytes) -> None:
+        self.device = torch.device("cpu")
+        self.filename = filename
+        self.increfs = 0
+        self.decrefs = 0
+
+    def is_shared(self) -> bool:
+        return True
+
+    def _get_shared_fd(self) -> int:
+        raise RuntimeError("filename-backed storage has no shared fd")
+
+    def _share_filename_cpu_(self) -> tuple[bytes, bytes, int]:
+        return b"manager", self.filename, 4
+
+    def _shared_incref(self) -> None:
+        self.increfs += 1
+
+    def _shared_decref(self) -> "_FakeFilenameStorage":
+        self.decrefs += 1
+        return self
+
+
+class _FakeTensor:
+    def __init__(self, storage: _FakeFilenameStorage) -> None:
+        self.storage = storage
+
+    def untyped_storage(self) -> _FakeFilenameStorage:
+        return self.storage
+
+
+def _make_fake_connector(tensor: _FakeTensor) -> PleOffloadConnector:
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    # Repeat the same storage in several connector positions to cover aliases.
+    connector._host_output_bufs = {"layer.0": tensor}
+    connector._host_flags = {"layer.0": tensor}
+    connector._reserved_host_storage_filenames = set()
+    connector._input_ids_buf = tensor
+    connector._query_start_loc_buf = tensor
+    connector._ngram_context_buf = None
+    return connector
+
+
+def test_release_host_storage_reserves_each_name_once(monkeypatch) -> None:
+    storage = _FakeFilenameStorage(b"/ple-test-reservation")
+    connector = _make_fake_connector(_FakeTensor(storage))
+    unlinked: list[str] = []
+    monkeypatch.setattr(connector_module.os, "unlink", unlinked.append)
+
+    connector.release_host_storage()
+    connector.release_host_storage()
+
+    assert storage.increfs == 1
+    assert storage.decrefs == 0
+    assert unlinked == ["/dev/shm/ple-test-reservation"]
+
+
+def test_release_host_storage_rolls_back_on_unlink_failure(monkeypatch) -> None:
+    storage = _FakeFilenameStorage(b"/ple-test-rollback")
+    connector = _make_fake_connector(_FakeTensor(storage))
+
+    def fail_unlink(_path: str) -> None:
+        raise PermissionError("test unlink failure")
+
+    monkeypatch.setattr(connector_module.os, "unlink", fail_unlink)
+
+    connector.release_host_storage()
+
+    # The fake connector aliases one storage in four positions. A rolled-back
+    # reservation is retried by the next alias in the same pass (by design: the
+    # name is still present), so every reservation must be balanced by a
+    # rollback and nothing may stay reserved.
+    assert storage.increfs >= 1
+    assert storage.increfs == storage.decrefs
+    assert connector._reserved_host_storage_filenames == set()
+
+
+_BALANCED_LIFETIME_SCRIPT = r"""
+import gc
+import os
+from multiprocessing.reduction import ForkingPickler
+from pathlib import Path
+
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.v1.ple_offload.connector import (
+    PleOffloadConnector,
+    _PROCESS_LIFETIME_REGISTERED_STORAGE,
+)
+from vllm.v1.ple_offload.protocol import PleOffloadRegistration
+
+
+def shm_path(tensor):
+    _, filename, _ = tensor.untyped_storage()._share_filename_cpu_()
+    return Path("/dev/shm") / os.fsdecode(filename).lstrip("/")
+
+
+class Progress:
+    def close(self):
+        pass
+
+
+original_strategy = torch_mp.get_sharing_strategy()
+torch_mp.set_sharing_strategy("file_system")
+try:
+    host_outputs = {
+        "layer.0": torch.arange(12, dtype=torch.float32)
+        .reshape(3, 4)
+        .share_memory_(),
+        "layer.1": torch.arange(8, dtype=torch.float32)
+        .reshape(2, 4)
+        .share_memory_(),
+    }
+    host_flags = {
+        name: torch.zeros(16, dtype=torch.int32).share_memory_()
+        for name in host_outputs
+    }
+    input_ids = torch.arange(16, dtype=torch.int32).share_memory_()
+    query_start_loc = torch.arange(5, dtype=torch.int32).share_memory_()
+    ngram_context = torch.arange(12, dtype=torch.int32).reshape(4, 3)
+    ngram_context.share_memory_()
+
+    registration = PleOffloadRegistration(
+        worker_id=1,
+        tp_rank=1,
+        dp_rank=0,
+        host_output_buffers=host_outputs,
+        host_flag_tensors=host_flags,
+        input_ids_buf=input_ids,
+        query_start_loc_buf=query_start_loc,
+        ngram_context_buf=ngram_context,
+    )
+    payload = ForkingPickler.dumps(registration)
+    rebuilt_registration = ForkingPickler.loads(payload)
+finally:
+    torch_mp.set_sharing_strategy(original_strategy)
+
+connector = PleOffloadConnector.__new__(PleOffloadConnector)
+connector._host_output_bufs = host_outputs
+connector._host_flags = host_flags
+connector._reserved_host_storage_filenames = set()
+connector._input_ids_buf = input_ids
+connector._query_start_loc_buf = query_start_loc
+connector._ngram_context_buf = ngram_context
