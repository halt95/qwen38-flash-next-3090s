+import contextlib
+import os
+import queue
+import sys
+from dataclasses import FrozenInstanceError
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+
+@pytest.fixture
+def fault_module(monkeypatch, tmp_path):
+    monkeypatch.delenv("VLLM_PLE_TEST_FAULT", raising=False)
+    monkeypatch.setenv("VLLM_PLE_TEST_FAULT_LOG", str(tmp_path / "fault.log"))
+    import vllm_ple_test_fault as test_fault
+
+    return test_fault
+
+
+def test_disarmed_import_is_none(fault_module):
+    assert fault_module._FAULT is None
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "cut=exc_before_prepare,ordinal=60,rank=any",
+        "cut=exc_after_prepare,ordinal=2,tp=1",
+        "cut=exc_in_release,ordinal=3,pp=0",
+        "cut=park_before_publish,ordinal=4,rank=any,phase=any",
+    ],
+)
+def test_valid_specs(fault_module, value):
+    spec = fault_module._parse_fault_spec(value)
+    assert spec is not None
+    assert spec.ordinal > 0
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "",
+        " cut=exc_in_release,ordinal=1,rank=any",
+        "cut=unknown,ordinal=1,rank=any",
+        "cut=exc_in_release,ordinal=0,rank=any",
+        "cut=exc_in_release,ordinal=01,rank=any",
+        "cut=exc_in_release,ordinal=1",
+        "cut=exc_in_release,ordinal=1,rank=tp1",
+        "cut=exc_in_release,ordinal=1,rank=any,tp=0",
+        "cut=exc_in_release,ordinal=1,tp=-1",
+        "cut=exc_in_release,ordinal=1,tp=0,phase=startup",
+        "cut=exc_in_release,ordinal=1,tp=0,extra=x",
+        "cut=exc_in_release,cut=exc_after_release,ordinal=1,tp=0",
+    ],
+)
+def test_malformed_specs_raise(fault_module, value):
+    with pytest.raises(ValueError):
+        fault_module._parse_fault_spec(value)
+
+
+def test_one_shot_rank_phase_and_ordinal(fault_module, monkeypatch):
+    spec = fault_module._parse_fault_spec(
+        "cut=exc_after_prepare,ordinal=2,tp=1,pp=0"
+    )
+    assert spec is not None
+
+    monkeypatch.setattr(fault_module.os, "getpid", lambda: 123)
+    monkeypatch.setattr(fault_module, "_pid_start_time", lambda _pid=None: 789)
+    monkeypatch.setattr(fault_module.time, "monotonic", lambda: 12.5)
+    monkeypatch.setattr(fault_module.time, "time", lambda: 456.25)
+
+    def fires(cut, tp_rank=1, eligible=True):
+        return spec.fires(
+            cut,
+            role="gpu",
+            unit="runner-forward",
+            eligible=eligible,
+            tp_rank=tp_rank,
+            pp_rank=0,
+            dp_rank=0,
+            transaction_id="sequence:9@begin:12.000000000",
+            correlation_id="sequence:9",
+        )
+
+    assert not fires("other")
+    assert not fires("exc_after_prepare", tp_rank=0)
+    assert not fires("exc_after_prepare", eligible=False)
+    assert not fires("exc_after_prepare")
+    assert fires("exc_after_prepare")
+    assert not fires("exc_after_prepare")
+    line = Path(os.environ["VLLM_PLE_TEST_FAULT_LOG"]).read_text()
+    assert line == (
+        "PLE_TEST_FAULT v=1 cut=exc_after_prepare ordinal=2 count=2 "
+        "unit=runner-forward role=gpu tp=1 pp=0 dp=0 pid=123 "
+        "pid_start=789 transaction=sequence:9@begin:12.000000000 "
+        "correlation=sequence:9 monotonic=12.500000000 "
+        "wall=456.250000000\n"
+    )
+    with pytest.raises(FrozenInstanceError):
+        spec.ordinal = 3
+
+
+def test_disarmed_connector_sites_continue(fault_module, monkeypatch):
+    import vllm.v1.ple_offload.connector as connector_module
+
+    monkeypatch.setattr(connector_module, "_FAULT", None)
+
+    connector = object.__new__(connector_module.PleOffloadConnector)
+    connector.tp_rank = 0
+    connector.pp_rank = 0
+    connector.dp_rank = 0
