+        )
+        _prefill(manager, stub, consumer)
+        return _sibling_hit(manager, 2016, [-2] * 584, hash_block_size)
+
+    on, off = sibling_hit(True), sibling_hit(False)
+    assert on >= off, f"enabling the flag cut the sibling's hit from {off} to {on}"
