+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU correctness for the deferred-PP align post-process row selection.
+
+The CPU model in ``test_pp_deferred_mamba_block_table.py`` pins which pointer
+and which row the launcher passes; it replaces the Triton body with a recorder,
+so it proves nothing about the bytes the kernel moves. These tests launch the
+real kernel and check the destination state, including that the request the
+rc1 coordinate would have hit is left alone.
+
+Scenario, shared by every case and identical to the CPU model's:
+
+    step T-2   gather [r5, r1, r2] into the shared destination buffer
+    step T-1   gather [r2]          into the same buffer
+    step T     the deferred post-process runs with T-2's mapping
+
+so batch row 0 means request slot 5, while buffer row 0 holds r2. The four
+possible coordinates resolve to four different physical blocks:
+
+    persistent[req_idx=5]    correct
+    persistent[batch_idx=0]  wrong row   -> r0's blocks
+    gathered[batch_idx=0]    rc1         -> r2's blocks (the victim)
+    gathered[req_idx=5]      wrong both  -> never written, block 0
+
+Requires CUDA **and** an explicit opt-in: set ``VLLM_E2_GPU_TESTS=1``. The reference host
+always reports CUDA available, and the box spends most of its time running
+qualification boots and sanitizer ladders that should not share a device with a
+test suite, so `torch.cuda.is_available()` is not a sufficient gate here. Run
+this in the boot window:
+
+    export VLLM_E2_GPU_TESTS=1
+    export PYTHONPATH=<worktree>:/opt/scratch/e2/pytest-lib
+    python -m pytest -q tests/v1/worker/gpu/test_pp_deferred_mamba_gpu.py
+"""
+
+import os
+from dataclasses import dataclass
+from unittest.mock import MagicMock
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.mamba.mamba_utils import (
+    MambaStateCopyFuncsByType,
+    get_conv_copy_spec,
+    get_temporal_copy_spec,
+    is_conv_state_dim_first,
+)
+from vllm.v1.attention.backends.registry import MambaAttentionBackendEnum
+from vllm.v1.kv_cache_interface import KVCacheConfig, KVCacheGroupSpec, MambaSpec
+from vllm.v1.worker.mamba_utils import MambaSpecDecodeGPUContext
+
+pytestmark = [
+    pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA required"),
+    pytest.mark.skipif(
+        os.environ.get("VLLM_E2_GPU_TESTS") != "1",
+        reason="set VLLM_E2_GPU_TESTS=1 to run GPU tests (shared qualification box)",
+    ),
+]
+
+MAX_NUM_REQS = 8
+BLOCKS_PER_REQ = 6
+NUM_PHYS_BLOCKS = MAX_NUM_REQS * BLOCKS_PER_REQ
+# Two extra physical blocks, reachable only through the block-table guard row
+# that a negative req_idx would address: CANARY_DST sits at the poison
+# destination column and CANARY_SRC everywhere else, so a negative-index load
+# would produce a visible copy between them. See _build()'s backing tensors.
+# Block ids are 1-based (see phys()), so the canaries sit above the last real
+# id, NUM_PHYS_BLOCKS, rather than on it.
+CANARY_DST = NUM_PHYS_BLOCKS + 1
+CANARY_SRC = NUM_PHYS_BLOCKS + 2
+TOTAL_BLOCKS = NUM_PHYS_BLOCKS + 3
+# Decision values planted at index -1 of every per-req array. They describe a
+# copy (new=48, a=4 -> aligned=48, running=45, bias=3, dst_col=2, src_col=0),
+# so a missing `req_idx < 0` guard is a write, not a silent no-op.
+POISON = (4, 0, 48)  # (num_accepted, state_idx, new_num_computed)
+POISON_DST_COL = 2
+MAMBA_BLOCK_SIZE = 16
+NUM_SPEC_BLOCKS = 3
+CONV_WIDTH = 4
+CONV_INNER = 64
+TEMPORAL_DIM = 128
+DTYPE = torch.float16
+
+_COPY_FUNCS: MambaStateCopyFuncsByType = {
+    MambaAttentionBackendEnum.GDN_ATTN: (get_conv_copy_spec, get_temporal_copy_spec),
+}
+
+
+def phys(req_slot: int, col: int) -> int:
+    """Physical block id owned by ``req_slot`` at logical column ``col``.
+
+    Disjoint per request, so a stray write is attributable.
+
+    ONE-BASED, and that is load-bearing rather than cosmetic. Block id 0 is
+    NULL_BLOCK_ID (v1/attention/backends/utils.py:46); the block pool pops it
+    out of the free queue at construction "to represent a placeholder block
+    with block_id=0" (v1/core/block_pool.py:188-191), so no request ever owns
+    it. A fixture that hands out id 0 as a real block is asking the kernel to
+    copy from the null block, and the bounds guards -- correctly, and following
+    upstream #50021 -- refuse. Numbering from 0 made this fixture the one place
+    in the tree where a legitimate block id was 0.
+    """
+    return req_slot * BLOCKS_PER_REQ + col + 1
+
+
+class _MockCpuGpuBuffer:
+    def __init__(self, size: int, dtype: torch.dtype, device: torch.device):
+        self.cpu = torch.zeros(size, dtype=dtype, device="cpu")
+        self.gpu = torch.zeros(size, dtype=dtype, device=device)
+        self.np = self.cpu.numpy()
+
+    def copy_to_gpu(self, n: int | None = None) -> torch.Tensor:
+        if n is None:
+            self.gpu.copy_(self.cpu)
+            return self.gpu
+        self.gpu[:n].copy_(self.cpu[:n])
+        return self.gpu[:n]
+
+
+def _make_kv_cache_config() -> KVCacheConfig:
+    spec = MambaSpec(
+        block_size=MAMBA_BLOCK_SIZE,
+        shapes=((CONV_WIDTH, CONV_INNER), (TEMPORAL_DIM,)),
+        dtypes=(DTYPE, DTYPE),
+        mamba_type=MambaAttentionBackendEnum.GDN_ATTN,
+        mamba_cache_mode="align",
+        num_speculative_blocks=NUM_SPEC_BLOCKS,
+    )
+    return KVCacheConfig(
+        num_blocks=TOTAL_BLOCKS,
+        kv_cache_tensors=[],
+        kv_cache_groups=[KVCacheGroupSpec(["layer_0"], spec)],
+    )
+
+
+def _gather_rows(persistent, num_blocks, idx_mapping, num_reqs_padded, dst) -> None:
+    """Host port of ``_gather_block_tables_kernel`` (block_table.py:236-273)."""
+    num_reqs = len(idx_mapping)
+    for batch_idx in range(num_reqs_padded):
+        if batch_idx >= num_reqs:
+            dst[batch_idx].zero_()
+            continue
+        req_idx = idx_mapping[batch_idx]
+        nb = num_blocks[req_idx]
+        dst[batch_idx, :nb] = persistent[req_idx, :nb]
+
+
+@dataclass
+class _Fixture:
+    device: torch.device
+    ctx: MambaSpecDecodeGPUContext
+    conv: torch.Tensor
+    temporal: torch.Tensor
+    conv0: torch.Tensor
+    temporal0: torch.Tensor
+    persistent: torch.Tensor
+    gathered: torch.Tensor
+
+
+def _build(slot_mapping=(5, 1, 2), t1_mapping=(2,)) -> _Fixture:
+    device = torch.device("cuda:0")
+    torch.manual_seed(1234)
+
+    conv = torch.randn(
+        TOTAL_BLOCKS, CONV_WIDTH, CONV_INNER, dtype=DTYPE, device=device
+    )
+    temporal = torch.randn(TOTAL_BLOCKS, TEMPORAL_DIM, dtype=DTYPE, device=device)
+    attention = MagicMock()
+    attention.kv_cache = [conv, temporal]
+
+    # The block tables and the per-req decision arrays each get one extra
+    # leading row/element that the kernel is never supposed to reach. Because
+    # the real tensors are views starting one row/element in, index -1 in
+    # pointer arithmetic lands on that guard row -- so a kernel that failed to
+    # reject req_idx < 0 would load the poison decisions below and write into
+    # canaries. See test_freed_slot_is_rejected_before_any_negative_index_load.
+    persistent_backing = torch.zeros(
+        MAX_NUM_REQS + 1, BLOCKS_PER_REQ, dtype=torch.int32, device=device
+    )
+    persistent_backing[0, :] = CANARY_SRC
+    persistent_backing[0, POISON_DST_COL] = CANARY_DST
+    persistent = persistent_backing[1:]
+    for r in range(MAX_NUM_REQS):
+        for c in range(BLOCKS_PER_REQ):
+            persistent[r, c] = phys(r, c)
+    num_blocks = [BLOCKS_PER_REQ] * MAX_NUM_REQS
+
+    gathered_backing = torch.zeros_like(persistent_backing)
+    gathered_backing[0, :] = CANARY_SRC
+    gathered_backing[0, POISON_DST_COL] = CANARY_DST
+    gathered = gathered_backing[1:]
+    slot_mapping = [s for s in slot_mapping if s >= 0]
+    _gather_rows(persistent, num_blocks, slot_mapping, len(slot_mapping) + 1, gathered)
+    _gather_rows(
+        persistent, num_blocks, list(t1_mapping), len(t1_mapping) + 1, gathered
+    )
+
+    kv_cache_config = _make_kv_cache_config()
+    ctx = MambaSpecDecodeGPUContext.create(
+        max_num_reqs=MAX_NUM_REQS,
+        kv_cache_config=kv_cache_config,
+        copy_funcs=_COPY_FUNCS,
+        device=device,
+        make_buffer=lambda n, dtype: _MockCpuGpuBuffer(n, dtype, device),
+    )
+    ctx.initialize_from_forward_context(
+        kv_cache_config,
+        {"layer_0": attention},
+        _COPY_FUNCS,
+        [gathered],
+        persistent_block_tables=[persistent],
+    )
+    assert ctx.has_persistent_block_tables
+
+    return _Fixture(
+        device=device,
+        ctx=ctx,
+        conv=conv,
+        temporal=temporal,
+        conv0=conv.clone(),
+        temporal0=temporal.clone(),
+        persistent=persistent,
+        gathered=gathered,
+    )
+
+
+def _launch(fx: _Fixture, mapping, per_slot):
+    """Run the deferred align post-process.
+
+    ``per_slot`` maps req slot -> (num_accepted, state_idx, new_num_computed).
+    """
+    device = fx.device
+
+    def backed(fill: int, poison: int) -> torch.Tensor:
+        """A [MAX_NUM_REQS] view whose index -1 holds ``poison``."""
+        backing = torch.full(
+            (MAX_NUM_REQS + 1,), fill, dtype=torch.int32, device=device
+        )
+        backing[0] = poison
+        return backing[1:]
+
+    poison_acc, poison_sidx, poison_computed = POISON
+    num_accepted = backed(1, poison_acc)
+    state_idx = backed(0, poison_sidx)
+    new_computed = backed(0, poison_computed)
+    for slot, (acc, sidx, computed) in per_slot.items():
+        num_accepted[slot] = acc
+        state_idx[slot] = sidx
+        new_computed[slot] = computed
+    fx.ctx.run_fused_postprocess_align(
+        num_reqs=len(mapping),
+        num_accepted_tokens_gpu=num_accepted,
+        state_idx_gpu=state_idx,
+        new_num_computed_tokens_gpu=new_computed,
+        idx_mapping=torch.tensor(mapping, dtype=torch.int32, device=device),
+    )
+    torch.accelerator.synchronize()
+    return num_accepted
+
+
+def _assert_bitwise(actual: torch.Tensor, expected: torch.Tensor, what: str) -> None:
+    """Compare the integer view, so "bit-identical" means what it says.
+
+    A zero-tolerance float compare establishes numeric equality, not bit
+    identity: +0.0 and -0.0 compare equal and NaN payloads compare unequal.
+    These are byte copies, so the integer view is the right instrument
+    (Astra R2).
+    """
+    assert actual.dtype == expected.dtype
+    lhs = actual.contiguous().view(torch.int16)
+    rhs = expected.contiguous().view(torch.int16)
+    assert torch.equal(lhs, rhs), (
+        f"{what}: {int((lhs != rhs).sum().item())} of {lhs.numel()} 16-bit "
+        f"words differ"
+    )
+
+
+def _assert_only_blocks_changed(fx: _Fixture, changed: set[int]) -> None:
+    """Every physical block outside ``changed`` must be bit-identical.
+
+    The canary blocks (``CANARY_DST``, ``CANARY_SRC``) are included: they are
+    only reachable through the guard row a negative ``req_idx`` would select.
+    """
+    for block in range(TOTAL_BLOCKS):
+        if block in changed:
+            continue
+        _assert_bitwise(fx.conv[block], fx.conv0[block], f"conv[{block}]")
+        _assert_bitwise(fx.temporal[block], fx.temporal0[block], f"temporal[{block}]")
+
+
+@pytest.mark.skipif(
