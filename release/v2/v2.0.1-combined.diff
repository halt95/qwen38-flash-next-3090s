+# SPDX-License-Identifier: Apache-2.0
+
+import os
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+import vllm.model_executor.layers.vocab_parallel_embedding as vpe
+import vllm.model_executor.model_loader.utils as loader_utils
+import vllm.models.qwen4_exp.nvidia.model as model_mod
+import vllm.models.qwen4_exp.nvidia.mtp as mtp_mod
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    HOST_EMBED_TABLE_ENV,
+    PinnedHostVocabParallelEmbedding,
+    VocabParallelEmbedding,
+    host_embed_table_enabled,
+)
+
+
+VOCAB = 67
+HIDDEN = 16
+
+
+def _set_tp(monkeypatch, rank: int, world_size: int) -> None:
+    monkeypatch.setattr(vpe, "get_tensor_model_parallel_rank", lambda: rank)
+    monkeypatch.setattr(
+        vpe,
+        "get_tensor_model_parallel_world_size",
+        lambda: world_size,
+    )
+    monkeypatch.setattr(
+        vpe,
+        "tensor_model_parallel_all_reduce",
+        lambda value: value,
+    )
+
+
+def _require_cuda_pinned_memory() -> None:
+    if not torch.cuda.is_available():
+        pytest.skip("requires CUDA UVA")
+    if not vpe.PIN_MEMORY:
+        pytest.skip("pinned memory is unavailable")
+    try:
+        probe = torch.empty(1, pin_memory=True)
+    except RuntimeError as exc:
+        pytest.skip(f"pinned allocation is unavailable: {exc}")
+    assert probe.is_pinned()
+
+
+def _weight(vocab: int = VOCAB, hidden: int = HIDDEN) -> torch.Tensor:
+    values = torch.arange(vocab * hidden, dtype=torch.int32)
+    weight = values.reshape(vocab, hidden).to(torch.bfloat16)
+    if vocab > 64 and hidden >= 2:
+        bits = weight.view(torch.uint16)
+        bits[64, 0] = 0x8000  # -0.0
+        bits[64, 1] = 0x7FC1  # quiet NaN with a nonzero payload
+    return weight
+
+
+def _assert_same_bytes(actual: torch.Tensor, expected: torch.Tensor) -> None:
+    assert actual.shape == expected.shape
+    assert actual.dtype == expected.dtype
+    assert torch.equal(
+        actual.contiguous().view(torch.uint8),
+        expected.contiguous().view(torch.uint8),
+    )
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (None, False),
+        ("", False),
+        ("0", False),
+        ("1", True),
+        (" 1 ", False),
+        ("true", False),
+    ],
+)
+def test_host_embedding_flag_is_exact(monkeypatch, value, expected):
+    if value is None:
+        monkeypatch.delenv(HOST_EMBED_TABLE_ENV, raising=False)
+    else:
+        monkeypatch.setenv(HOST_EMBED_TABLE_ENV, value)
+    assert host_embed_table_enabled() is expected
+
+
+def test_u1_tp2_masking_and_reduction_are_bytewise_identical(monkeypatch):
+    weight = _weight()
+    ids = torch.tensor(
+        [0, 1, 63, 64, 65, 66, -1, VOCAB, 127],
+        dtype=torch.int64,
+    )
+    stock_parts = []
+    host_parts = []
+
+    for rank in range(2):
+        _set_tp(monkeypatch, rank, 2)
+        with torch.device("cpu"):
+            stock = VocabParallelEmbedding(
+                VOCAB,
+                HIDDEN,
+                params_dtype=torch.bfloat16,
+            )
+            host = PinnedHostVocabParallelEmbedding(
+                VOCAB,
+                HIDDEN,
+                params_dtype=torch.bfloat16,
+                create_accelerator_view=False,
+            )
+
+        # The CPU reference deliberately exercises the stock masked fallback,
+        # not the CUDA-only fused kernel.
+        stock.use_fused_embedding = False
+        stock.weight_loader(stock.weight, weight)
+        host.weight_loader(host.weight, weight)
+
+        stock_local = stock(ids)
+        host_local = host(ids)
+        _assert_same_bytes(host_local, stock_local)
+        stock_parts.append(stock_local)
+        host_parts.append(host_local)
+
+    # Use the same floating-point SUM ordering for both implementations. This
+    # intentionally covers the signed-zero and NaN caveat of the real TP path.
+    stock_reduced = stock_parts[0] + stock_parts[1]
+    host_reduced = host_parts[0] + host_parts[1]
+    _assert_same_bytes(host_reduced, stock_reduced)
+
+    invalid = host_reduced[-3:].contiguous().view(torch.uint8)
+    assert torch.count_nonzero(invalid) == 0
+
+
+def test_u1_tp1_matches_stock_lookup_contract(monkeypatch):
+    _set_tp(monkeypatch, 0, 1)
+    weight = _weight()
+    with torch.device("cpu"):
+        stock = VocabParallelEmbedding(
+            VOCAB,
+            HIDDEN,
+            params_dtype=torch.bfloat16,
+        )
+        host = PinnedHostVocabParallelEmbedding(
+            VOCAB,
+            HIDDEN,
+            params_dtype=torch.bfloat16,
+            create_accelerator_view=False,
+        )
+
+    assert stock.quant_method.requires_device_loading is True
+    assert host.quant_method.requires_device_loading is False
+    stock.weight_loader(stock.weight, weight)
+    host.weight_loader(host.weight, weight)
+
+    # TP1 exposes padded storage just like an ordinary embedding lookup.
+    for row, value in ((VOCAB, 11), (stock.weight.shape[0] - 1, 29)):
+        stock.weight[row].fill_(value)
+        host.weight[row].fill_(value)
+
+    ids = torch.tensor([0, 64, 66, VOCAB, stock.weight.shape[0] - 1])
+    _assert_same_bytes(host(ids), stock(ids))
+
+    # Negative IDs and IDs beyond padded storage must fail in the same way.
+    for invalid_id in (-1, stock.weight.shape[0]):
+        invalid = torch.tensor([invalid_id])
+        with pytest.raises(Exception) as stock_error:
+            stock(invalid)
+        with pytest.raises(type(stock_error.value)) as host_error:
+            host(invalid)
+        assert str(host_error.value) == str(stock_error.value)
+
+
+def test_host_budget_requires_measured_allocation():
+    doc = PinnedHostVocabParallelEmbedding.__doc__ or ""
+    assert "measured pinned allocation, not tensor payload" in doc
+
+
+class _LanguageModel(nn.Module):
+    def __init__(self, embedding: nn.Module) -> None:
+        super().__init__()
+        self.embed_tokens = embedding
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.embed_tokens(input_ids)
+
+
+def test_u1_real_multimodal_text_mask_and_merge(monkeypatch):
+    _set_tp(monkeypatch, 0, 1)
+    weight = _weight()
+    with torch.device("cpu"):
+        embedding = PinnedHostVocabParallelEmbedding(
+            VOCAB,
+            HIDDEN,
+            params_dtype=torch.bfloat16,
+            create_accelerator_view=False,
+        )
+    embedding.weight_loader(embedding.weight, weight)
+
+    model = model_mod.Qwen4ExpForConditionalGeneration.__new__(
+        model_mod.Qwen4ExpForConditionalGeneration
+    )
+    nn.Module.__init__(model)
+    model.language_model = _LanguageModel(embedding)
+    model.language_model_only = False
+    model.use_deepstack = False
+    model._has_oov_mm_tokens = True
+
+    ids = torch.tensor([1, VOCAB + 5, 2, 64], dtype=torch.int64)
+    is_multimodal = torch.tensor([False, True, False, False])
+    image_row = torch.full((1, HIDDEN), 123, dtype=torch.bfloat16)
+
+    actual = model.embed_input_ids(
+        ids,
+        multimodal_embeddings=[image_row],
+        is_multimodal=is_multimodal,
+    )
+
+    expected = torch.zeros(4, HIDDEN, dtype=torch.bfloat16)
+    expected[0].copy_(weight[1])
+    expected[1].copy_(image_row[0])
+    expected[2].copy_(weight[2])
+    expected[3].copy_(weight[64])
+    _assert_same_bytes(actual, expected)
+
+
+class _PPGroup:
+    is_first_rank = True
+    is_last_rank = False
+
+
+class _StubModule(nn.Module):
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__()
+
+
