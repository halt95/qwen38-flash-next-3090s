-                   "res": int(s.get("reserved_bytes.all.current", 0)), "res_peak": rp,
-                   "retries": int(s.get("num_alloc_retries", 0)), "ooms": int(s.get("num_ooms", 0)),
-                   "free": int(free), "total": int(total), "run_alloc_peak": run_ap, "run_res_peak": run_rp,
-                   "min_free": int(min_free)}
+            min_free = int(free) if min_free is None else min(min_free, int(free))
+            w({"kind": "sample", "t0": round(t0, 4), "t1": round(t1, 4), "m0": round(m0, 4), "m1": round(m1, 4),
+               "window": name, "seq": seq, "alloc": int(s.get("allocated_bytes.all.current", 0)),
+               "res": int(s.get("reserved_bytes.all.current", 0)), "alloc_peak_w": ap, "res_peak_w": rp,
+               "retries": int(s.get("num_alloc_retries", 0)), "ooms": int(s.get("num_ooms", 0)), "free": int(free),
+               "total": int(total), "run_alloc_peak": run_ap, "run_res_peak": run_rp, "min_free_sampled": min_free})
