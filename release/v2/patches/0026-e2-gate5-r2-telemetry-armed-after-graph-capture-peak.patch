From 5a2a7fa8dfd1de49042af8847605f22eaf475711 Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Fri, 11 Sep 2026 21:19:00 +0000
Subject: [PATCH 26/76] e2-gate5 r2: telemetry armed after graph capture; peaks
 reset only at acknowledged quiet windows; scheduled tokens per request

Astra R7-4: the V2 runner's warm-up calls execute_model before capture_model, so the telemetry now starts at the end of compile_or_warm_up_model. R7-3: peak counters are reset only when the gate driver opens/closes a window while the server is quiet (window.ctl + per-rank ack), so no peak can be lost between a read and a reset; samples carry the within-window high-water mark and monotonic times. The scheduler log adds tokens scheduled per request and per step (mixed prefill/decode and K=3 decode evidence). All env-gated, inert when unset.
---
 vllm/v1/core/sched/e2_alloc_log.py | 10 +++-
 vllm/v1/worker/e2_memstats.py      | 93 ++++++++++++++++++++----------
 vllm/v1/worker/gpu_worker.py       |  6 +-
 3 files changed, 74 insertions(+), 35 deletions(-)

diff --git a/vllm/v1/core/sched/e2_alloc_log.py b/vllm/v1/core/sched/e2_alloc_log.py
index 60d1e9fab..ad44882a7 100644
--- a/vllm/v1/core/sched/e2_alloc_log.py
+++ b/vllm/v1/core/sched/e2_alloc_log.py
@@ -3,7 +3,9 @@
 
 One JSON line per scheduler update while any request exists, and one "fin" line per request as it is freed:
   {"t": wall, "m": monotonic, "step": n, "total": pool blocks, "free": free blocks, "running": r, "waiting": w,
-   "reqs": [[id, prompt, computed, output, cached, preemptions, spec_scheduled, status, [blocks per group]]]}
+   "tot": tokens scheduled this step,
+   "reqs": [[id, prompt, computed, output, cached, preemptions, spec_scheduled, status, [blocks per group],
+             tokens scheduled for this request this step]]}
   {"t": wall, "m": monotonic, "fin": [id, prompt, computed, output, cached, preemptions, status, [blocks per group]]}
 Blocks are counted per KV-cache group, null blocks excluded. A logging failure writes an "error" line and never
 raises into the scheduler. Unset = the scheduler only pays one env check per update.
@@ -75,11 +77,13 @@ def log_step(sched, scheduler_output) -> None:
         _state["step"] += 1
         spec = getattr(scheduler_output, "scheduled_spec_decode_tokens", None) or {}
         pool = sched.kv_cache_manager.block_pool
+        nsched = getattr(scheduler_output, "num_scheduled_tokens", None) or {}
         rows = [[rid, r.num_prompt_tokens, r.num_computed_tokens, r.num_output_tokens, max(0, r.num_cached_tokens),
-                 r.num_preemptions, len(spec.get(rid, ())), _status(r), _blocks(sched, rid)]
+                 r.num_preemptions, len(spec.get(rid, ())), _status(r), _blocks(sched, rid), int(nsched.get(rid, 0))]
                 for rid, r in sched.requests.items()]
         _write({"t": round(time.time(), 4), "m": round(time.monotonic(), 4), "step": _state["step"],
                 "total": pool.num_gpu_blocks, "free": pool.get_num_free_blocks(),
-                "running": len(sched.running), "waiting": len(sched.waiting), "reqs": rows})
+                "running": len(sched.running), "waiting": len(sched.waiting),
+                "tot": int(getattr(scheduler_output, "total_num_scheduled_tokens", 0) or 0), "reqs": rows})
     except Exception as e:  # noqa: BLE001
         _error(e)
diff --git a/vllm/v1/worker/e2_memstats.py b/vllm/v1/worker/e2_memstats.py
index 339fc9ceb..c39233d37 100644
--- a/vllm/v1/worker/e2_memstats.py
+++ b/vllm/v1/worker/e2_memstats.py
@@ -1,15 +1,23 @@
 # SPDX-License-Identifier: Apache-2.0
-"""Debug-only allocator telemetry for E2 gate 5 (off unless VLLM_E2_MEMSTATS=<segment seconds> and
-VLLM_E2_MEMSTATS_DIR=<dir>).
+"""Debug-only allocator telemetry for E2 gate 5, r2 (Astra R7-3, R7-4, R7-10). Off unless VLLM_E2_MEMSTATS=<sample
+seconds> and VLLM_E2_MEMSTATS_DIR=<dir>.
 
-One daemon thread per GPU worker, started at the worker's first execute_model (after KV-cache sizing and CUDA-graph
-capture, so it can never disturb memory profiling). Every segment it reads this device's caching-allocator counters
-and cudaMemGetInfo, then resets the peak counters: each line holds the high-water mark of its own segment [t0, t1].
-Whole-run maxima and the minimum free memory are carried on every line, so a reset never loses them.
-No device synchronisation, no GPU allocation, no lock shared with the model path. A failed read writes an "error"
-line and the loop continues.
-Line: {"t0","t1","rank","local","dev","pid","alloc","alloc_peak","res","res_peak","retries","ooms","free","total",
-       "run_alloc_peak","run_res_peak","min_free"}
+The worker starts it at the END of compile_or_warm_up_model, after warm-up and CUDA-graph capture (the V2 runner's
+warm-up calls execute_model before capture, so execute_model is not a post-capture boundary).
+
+Peak counters are reset ONLY at acknowledged window boundaries, which the gate driver opens and closes while the
+server is quiet (no request running): <dir>/window.ctl holds "<seq> <name>". On a new seq this thread reads the
+counters one last time for the old window (its "close" record: the allocator high-water marks since the window
+opened), resets the peak counters, and writes an "ack" record. Inside a window nothing is reset, so no allocation
+peak can be lost between a read and a reset; every "sample" line carries the high-water mark since its window opened
+(monotone within a window), which localises when it was reached. Whole-run maxima are carried across windows.
+Retry and OOM counters are cumulative and never reset. min_free_sampled is the minimum of sampled cudaMemGetInfo
+values, not a continuous minimum.
+
+Records (one JSON per line): kind start | sample | close | ack | error; wall and monotonic times (samples: t0/t1,
+m0/m1); rank, local, dev, pid; window, seq; alloc, res, alloc_peak_w, res_peak_w, retries, ooms, free, total,
+run_alloc_peak, run_res_peak, min_free_sampled. No device synchronisation and no GPU allocation; each counter read or
+reset takes the caching allocator's own mutex briefly, and records are written with synchronous file I/O.
 """
 import json
 import os
