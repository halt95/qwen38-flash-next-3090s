diff --git a/vllm/v1/worker/e2_memstats.py b/vllm/v1/worker/e2_memstats.py
new file mode 100644
index 000000000..339fc9ceb
--- /dev/null
+++ b/vllm/v1/worker/e2_memstats.py
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Debug-only allocator telemetry for E2 gate 5 (off unless VLLM_E2_MEMSTATS=<segment seconds> and
+VLLM_E2_MEMSTATS_DIR=<dir>).
+
+One daemon thread per GPU worker, started at the worker's first execute_model (after KV-cache sizing and CUDA-graph
+capture, so it can never disturb memory profiling). Every segment it reads this device's caching-allocator counters
+and cudaMemGetInfo, then resets the peak counters: each line holds the high-water mark of its own segment [t0, t1].
+Whole-run maxima and the minimum free memory are carried on every line, so a reset never loses them.
+No device synchronisation, no GPU allocation, no lock shared with the model path. A failed read writes an "error"
+line and the loop continues.
+Line: {"t0","t1","rank","local","dev","pid","alloc","alloc_peak","res","res_peak","retries","ooms","free","total",
+       "run_alloc_peak","run_res_peak","min_free"}
+"""
+import json
+import os
+import threading
+import time
+
+import torch
+
+_SEG = float(os.environ.get("VLLM_E2_MEMSTATS", "0") or 0)
+_DIR = os.environ.get("VLLM_E2_MEMSTATS_DIR", "")
+_started = []
+
+
+def enabled() -> bool:
+    return _SEG > 0 and bool(_DIR)
+
+
+def ensure_started(worker) -> None:
+    if _started:
+        return
+    dev = torch.cuda.current_device()
+    t = threading.Thread(target=_loop, args=(dev, getattr(worker, "rank", -1), getattr(worker, "local_rank", -1)),
+                         name="e2-memstats", daemon=True)
+    _started.append(t)
+    t.start()
+
+
+def _loop(dev, rank, local):
+    os.makedirs(_DIR, exist_ok=True)
+    f = open(os.path.join(_DIR, f"memstats-rank{rank}-pid{os.getpid()}.jsonl"), "a", buffering=1)
+    run_ap = run_rp = 0
+    min_free = None
+    torch.cuda.reset_peak_memory_stats(dev)
+    t0 = time.time()
+    while True:
+        time.sleep(_SEG)
+        try:
+            s = torch.cuda.memory_stats(dev)
+            free, total = torch.cuda.mem_get_info(dev)
+            torch.cuda.reset_peak_memory_stats(dev)
+            t1 = time.time()
+            ap, rp = int(s.get("allocated_bytes.all.peak", 0)), int(s.get("reserved_bytes.all.peak", 0))
+            run_ap, run_rp = max(run_ap, ap), max(run_rp, rp)
+            min_free = free if min_free is None else min(min_free, free)
+            rec = {"t0": round(t0, 4), "t1": round(t1, 4), "rank": rank, "local": local, "dev": dev,
+                   "pid": os.getpid(), "alloc": int(s.get("allocated_bytes.all.current", 0)), "alloc_peak": ap,
+                   "res": int(s.get("reserved_bytes.all.current", 0)), "res_peak": rp,
+                   "retries": int(s.get("num_alloc_retries", 0)), "ooms": int(s.get("num_ooms", 0)),
+                   "free": int(free), "total": int(total), "run_alloc_peak": run_ap, "run_res_peak": run_rp,
+                   "min_free": int(min_free)}
+        except Exception as e:  # noqa: BLE001 - telemetry must never raise into the worker
+            t1 = time.time()
+            rec = {"t0": round(t0, 4), "t1": round(t1, 4), "rank": rank, "pid": os.getpid(),
+                   "error": f"{type(e).__name__}: {e}"[:300]}
+        f.write(json.dumps(rec, separators=(",", ":")) + "\n")
+        t0 = t1
