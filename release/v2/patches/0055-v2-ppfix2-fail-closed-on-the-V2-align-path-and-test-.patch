+)
+def test_positive_bias_copy_lands_on_the_requests_own_blocks():
+    """batch row 0 -> req slot 5, num_accepted 4, so token_bias is 3.
+
+    new=48, a=4 -> aligned=48, running=45, needs_copy; bias=3; dst_col=2.
+    state_idx=0, so conv reads column 0 and temporal reads column
+    ``src_col + bias`` = 3 -- three distinct columns, so a wrong row cannot be
+    masked by a coincidental self-copy.
+    """
+    fx = _build()
+    _launch(fx, [5, 1, 2], {5: (4, 0, 48), 1: (2, 0, 40), 2: (2, 0, 40)})
+
+    dst = phys(5, 2)
+    conv_src = phys(5, 0)
+    temporal_src = phys(5, 3)
+
+    # conv: state[bt[src_col], bias:] -> state[bt[dst_col], :width - bias]
+    torch.testing.assert_close(
+        fx.conv[dst][: CONV_WIDTH - 3], fx.conv0[conv_src][3:], rtol=0, atol=0
+    )
+    # the tail of the destination conv window is not written
+    torch.testing.assert_close(
+        fx.conv[dst][CONV_WIDTH - 3 :], fx.conv0[dst][CONV_WIDTH - 3 :], rtol=0, atol=0
+    )
+    # temporal: state[bt[src_col + bias]] -> state[bt[dst_col]]
+    torch.testing.assert_close(
+        fx.temporal[dst], fx.temporal0[temporal_src], rtol=0, atol=0
+    )
+
+    # Nothing else moved -- in particular not the victim r2 (the rc1 row) and
+    # not r0 (the "persistent table but batch row" mistake).
+    _assert_only_blocks_changed(fx, {dst})
+    victim = phys(2, 2)  # gathered[batch row 0] column 2 -- the rc1 destination
+    torch.testing.assert_close(fx.conv[victim], fx.conv0[victim], rtol=0, atol=0)
+    torch.testing.assert_close(
+        fx.temporal[victim], fx.temporal0[victim], rtol=0, atol=0
+    )
+    wrong_row = phys(0, 2)  # persistent[batch row 0] column 2
+    torch.testing.assert_close(
+        fx.conv[wrong_row], fx.conv0[wrong_row], rtol=0, atol=0
+    )
+
