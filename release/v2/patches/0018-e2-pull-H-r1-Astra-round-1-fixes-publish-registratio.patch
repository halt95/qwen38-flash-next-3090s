From 78ebf82907b900886c83c5ccb2a6e34d5bfd5c7d Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Fri, 11 Sep 2026 13:29:56 +0000
Subject: [PATCH 18/76] e2-pull H r1: Astra round-1 fixes (publish registration
 after mapping; host pointer for the DMA + bounds check; publication fence;
 bounded fatal release wait with step diagnostics; duplicate DP request fatal)

---
 .../layers/ple_offload_layer.py               | 15 ++++--
 vllm/v1/ple_offload/connector.py              | 36 +++++++++-----
 vllm/v1/ple_offload/worker.py                 | 48 +++++++++++++++----
 3 files changed, 74 insertions(+), 25 deletions(-)

diff --git a/vllm/model_executor/layers/ple_offload_layer.py b/vllm/model_executor/layers/ple_offload_layer.py
index 726ac0e3f..5313e10fe 100644
--- a/vllm/model_executor/layers/ple_offload_layer.py
+++ b/vllm/model_executor/layers/ple_offload_layer.py
@@ -223,6 +223,13 @@ def _ple_offload_wait_copy_impl(
     num_tokens: int,
 ) -> None:
     """Wait for the host-side result, then DMA it into the GPU buffer."""
+    if int(num_tokens) > gpu_output_buffer.shape[0] or int(row_bytes) != (
+        gpu_output_buffer.shape[1] * gpu_output_buffer.element_size()
+    ):
+        raise RuntimeError(
+            f"PLE wait_copy out of bounds: {num_tokens} rows x {row_bytes} B vs "
+            f"GPU buffer {tuple(gpu_output_buffer.shape)} {gpu_output_buffer.dtype}"
+        )
     stream = cuda_driver.CUstream(torch.cuda.current_stream().cuda_stream)
     _cuda_check(
         cuda_driver.cuStreamWaitValue32(
@@ -235,14 +242,16 @@ def _ple_offload_wait_copy_impl(
     )
     nbytes = int(num_tokens) * int(row_bytes)
     if nbytes > 0:
+        # host_ptr is this worker's host address of page-locked (registered)
+        # memory, so the copy is a true async DMA and is capturable.
         _cuda_check(
-            cuda_driver.cuMemcpyAsync(
+            cuda_driver.cuMemcpyHtoDAsync(
                 cuda_driver.CUdeviceptr(gpu_output_buffer.data_ptr()),
-                cuda_driver.CUdeviceptr(host_ptr),
+                host_ptr,
                 nbytes,
                 stream,
             ),
-            "cuMemcpyAsync(PLE host -> GPU)",
+            "cuMemcpyHtoDAsync(PLE host -> GPU)",
         )
 
 
