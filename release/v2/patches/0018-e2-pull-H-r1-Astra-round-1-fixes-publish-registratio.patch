diff --git a/vllm/v1/ple_offload/worker.py b/vllm/v1/ple_offload/worker.py
index 39921d886..06f6ad516 100644
--- a/vllm/v1/ple_offload/worker.py
+++ b/vllm/v1/ple_offload/worker.py
@@ -69,6 +69,23 @@ from vllm.v1.utils import record_function_or_nullcontext
 
 logger = init_logger(__name__)
 
+# Publication fence for the host-mapped pull: a locked read-modify-write (the
+# uncontended lock acquire) is a full barrier on x86 and also drains
+# write-combining buffers, so every row store of a result is globally visible
+# before the flag store that tells the GPU to DMA it (Astra 09-11: do not rely
+# on "memcpy uses no non-temporal stores at this size").
+_PUBLISH_FENCE = threading.Lock()
+
+
+def _publish_fence() -> None:
+    with _PUBLISH_FENCE:
+        pass
+
+
+# Bounded wait for the GPU to release a result (seconds). A timed-out ownership
+# transfer is fatal: the offload process raises and exits, never overwrites.
+_PLE_WAIT_TIMEOUT_S = float(os.environ.get("VLLM_PLE_OFFLOAD_WAIT_TIMEOUT", "120"))
+
 
 @dataclass
 class PleOffloadOutputTarget:
@@ -388,6 +405,7 @@ class PleOffloadRunner:
         # shared host buffer. Nothing in this process is pinned or on a GPU.
         self._scratch_bufs: dict[int, dict[str, torch.Tensor]] = {}
         self._shutdown_event: threading.Event | None = None
+        self._step = 0  # number of handled request batches (diagnostics)
         # Shared-memory inputs are registered once per DP rank by TP rank zero.
         self._input_bufs: dict[int, PleOffloadInputBuffers] = {}
         self._load_weights()
@@ -699,12 +717,15 @@ class PleOffloadRunner:
                 )
                 continue
             if request.dp_rank in requests_by_dp:
-                logger.warning(
-                    "Duplicate PLE request for dp_rank=%d; skipping duplicate.",
-                    request.dp_rank,
+                # One input slot and one output slot per DP rank: a second
+                # request in the same batch would alias them. Fatal, never
+                # silently dropped (Astra 09-11).
+                raise RuntimeError(
+                    f"Two PLE requests for dp_rank={request.dp_rank} in one batch "
+                    f"(step {self._step}); the single-slot protocol is violated"
                 )
-                continue
             requests_by_dp[request.dp_rank] = request
+        self._step += 1
 
         # Speculative placeholders are not vocabulary IDs. Normalize each DP
         # input once before all PLE layers consume the shared buffer.
@@ -741,8 +762,7 @@ class PleOffloadRunner:
                 for target in targets:
                     self._wait_flag_released(target, layer_name, dp_rank)
                     target.host_output_buffer[slices].copy_(result[slices])
-                    # Plain store after the row stores (x86 TSO keeps them in
-                    # order for the GPU's flag observation + DMA read).
+                    _publish_fence()
                     target.host_flag[0] = 1
 
     def _wait_flag_released(
@@ -757,17 +777,25 @@ class PleOffloadRunner:
         start = time.monotonic()
         while int(flag[0]) != 0:
             spins += 1
+            if self._shutdown_event is not None and self._shutdown_event.is_set():
+                raise RuntimeError("PLE offload shutting down while waiting for GPU")
             if spins > 200:
                 time.sleep(0.0001)
-                if self._shutdown_event is not None and self._shutdown_event.is_set():
-                    raise RuntimeError("PLE offload shutting down while waiting for GPU")
-                if not warned and time.monotonic() - start > 5.0:
+                waited = time.monotonic() - start
+                if not warned and waited > 5.0:
                     warned = True
                     logger.warning(
                         "PLE offload waited >5 s for the GPU to release %s "
-                        "(dp=%d, tp=%d); flag=%d",
+                        "(dp=%d, tp=%d, step %d); flag=%d",
                         layer_name,
                         dp_rank,
                         target.tp_rank,
+                        self._step,
                         int(flag[0]),
                     )
+                if waited > _PLE_WAIT_TIMEOUT_S:
+                    raise RuntimeError(
+                        f"PLE offload: GPU did not release {layer_name} (dp={dp_rank}, "
+                        f"tp={target.tp_rank}, step {self._step}) within "
+                        f"{_PLE_WAIT_TIMEOUT_S:.0f} s; refusing to overwrite"
+                    )
