-"""IPC message definitions for PLE CPU offload."""
+"""IPC message definitions for PLE CPU offload (pull design).
+
+The offload process owns no CUDA context. It writes each layer's result into
+a shared host buffer owned by the requesting GPU worker and sends a
+:class:`PleOffloadOutputReady` notice; the worker copies host -> GPU on its own
+stream, signals its local semaphore, and returns a :class:`PleOffloadAck`
+once the DMA has completed so the host buffer can be reused.
+"""
 
 from dataclasses import dataclass
 
@@ -19,9 +26,11 @@ class PleOffloadRegistration:
     worker_id: int
     tp_rank: int
     dp_rank: int
-    # CUDA tensors are serialized through PyTorch CUDA IPC.
-    gpu_output_buffers: dict[str, torch.Tensor]
-    sem_flag_tensors: dict[str, torch.Tensor]
+    # Shared CPU tensors (one per PLE layer) that the offload process fills.
+    # The GPU worker page-locks them in its own CUDA context for async H2D.
+    host_output_buffers: dict[str, torch.Tensor]
+    # ZMQ address (bound by this worker) on which it receives output notices.
+    reply_ipc_addr: str
     # CPU tensors are allocated in shared memory and registered once.
     input_ids_buf: torch.Tensor
     query_start_loc_buf: torch.Tensor
@@ -37,4 +46,33 @@ class PleOffloadRequest:
     num_reqs: int
 
 
+@dataclass
+class PleOffloadOutputReady:
+    """Sent by the offload process to one GPU worker per layer per step."""
+
+    layer_name: str
+    num_tokens: int
+
+
+@dataclass
+class PleOffloadAck:
+    """Sent by a GPU worker once its H2D copy of a layer result completed."""
+
+    dp_rank: int
+    tp_rank: int
+    layer_name: str
+
+
 _PLE_OFFLOAD_REQUEST_DECODER = msgspec.msgpack.Decoder(PleOffloadRequest)
+_PLE_OFFLOAD_OUTPUT_READY_DECODER = msgspec.msgpack.Decoder(PleOffloadOutputReady)
+_PLE_OFFLOAD_ACK_DECODER = msgspec.msgpack.Decoder(PleOffloadAck)
+
+
+def ple_offload_ack_ipc_addr(ipc_addr: str) -> str:
+    """Address of the offload process's ack socket derived from the base."""
+    return f"{ipc_addr}-ack"
+
+
+def ple_offload_reply_ipc_addr(ipc_addr: str, worker_id: int) -> str:
+    """Address of one GPU worker's output-notice socket."""
+    return f"{ipc_addr}-out{worker_id}"
