+    def _output_loop(self) -> None:
+        """Receive output notices; copy, signal and ack on a private stream."""
+        reply_socket: zmq.Socket | None = None
+        ack_socket: zmq.Socket | None = None
+        try:
+            if self._zmq_ctx is None:
+                raise RuntimeError("PLE ZMQ context closed before thread startup")
+            reply_socket = self._zmq_ctx.socket(zmq.PULL)
+            reply_socket.bind(self._reply_ipc_addr)
+            ack_socket = self._zmq_ctx.socket(zmq.PUSH)
+            ack_socket.connect(self._ack_ipc_addr)
+            poller = zmq.Poller()
+            poller.register(reply_socket, zmq.POLLIN)
+            with torch.accelerator.device_index(self.device.index):
+                copy_stream = torch.cuda.Stream(device=self.device)
+                done_event = torch.cuda.Event()
+                self._output_thread_ready.set()
+                while not self._output_thread_stop.is_set():
+                    if reply_socket not in dict(poller.poll(timeout=100)):
+                        continue
+                    notice = _PLE_OFFLOAD_OUTPUT_READY_DECODER.decode(
+                        reply_socket.recv()
+                    )
+                    self._pull_output(notice.layer_name, notice.num_tokens,
+                                      copy_stream, done_event)
+                    ack_socket.send(
+                        msgspec.msgpack.encode(
+                            PleOffloadAck(
+                                dp_rank=self.dp_rank,
+                                tp_rank=self.tp_rank,
+                                layer_name=notice.layer_name,
+                            )
+                        )
+                    )
+        except Exception as error:
+            self._output_thread_error = error
+            logger.exception("PLE output thread failed")
+            if self._output_thread_ready.is_set():
+                os._exit(1)
+        finally:
+            self._output_thread_ready.set()
+            if reply_socket is not None:
+                reply_socket.close(linger=0)
+            if ack_socket is not None:
+                ack_socket.close(linger=0)
+
+    def _pull_output(
+        self,
+        layer_name: str,
+        num_tokens: int,
+        copy_stream: torch.cuda.Stream,
+        done_event: torch.cuda.Event,
+    ) -> None:
+        """Copy one layer result host -> GPU and signal its semaphore."""
+        layer = self._layers[layer_name]
+        host_buffer = self._host_output_bufs[layer_name]
+        with (
+            record_function_or_nullcontext("ple_offload: pull_output"),
+            torch.cuda.stream(copy_stream),
+        ):
+            # The GPU output buffer must not be overwritten until the previous
+            # forward consumed it; the runner resets the flag after the
+            # forward, and this wait is stream-ordered before the copy.
+            layer._sem.wait_reset(copy_stream)
+            layer._gpu_output_buffer[:num_tokens].copy_(
+                host_buffer[:num_tokens], non_blocking=True
+            )
+            layer._sem.signal(copy_stream)
+            done_event.record(copy_stream)
+        # The host buffer is reusable by the offload process only after the
+        # DMA has read it; block this thread (not the model stream) until then.
+        done_event.synchronize()
