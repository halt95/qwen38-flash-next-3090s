+    def _start_output_thread(self) -> None:
+        """Start the thread that copies finished layer outputs host -> GPU."""
+        self._output_thread = threading.Thread(
+            target=self._output_loop,
+            name=f"ple-offload-out-dp{self.dp_rank}-tp{self.tp_rank}",
+            daemon=True,
+        )
+        self._output_thread.start()
+        if not self._output_thread_ready.wait(timeout=10):
+            raise RuntimeError("Timed out starting the PLE output thread")
+        if self._output_thread_error is not None:
+            raise RuntimeError(
+                "PLE output thread failed to start"
+            ) from self._output_thread_error
