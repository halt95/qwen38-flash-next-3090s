         for manager in self.single_type_managers:
             # Only cache tokens with finalized KV. The last num_reprefillable_tokens
             # tokens can be re-prefilled during multi-module MTP.
@@ -352,7 +351,7 @@ class KVCacheCoordinator(ABC):
                 request,
