+def test_u1_real_multimodal_text_mask_and_merge(monkeypatch):
+    _set_tp(monkeypatch, 0, 1)
+    weight = _weight()
+    with torch.device("cpu"):
+        embedding = PinnedHostVocabParallelEmbedding(
+            VOCAB,
+            HIDDEN,
+            params_dtype=torch.bfloat16,
+            create_accelerator_view=False,
+        )
+    embedding.weight_loader(embedding.weight, weight)
+
+    model = model_mod.Qwen4ExpForConditionalGeneration.__new__(
+        model_mod.Qwen4ExpForConditionalGeneration
+    )
+    nn.Module.__init__(model)
+    model.language_model = _LanguageModel(embedding)
+    model.language_model_only = False
+    model.use_deepstack = False
+    model._has_oov_mm_tokens = True
+
+    ids = torch.tensor([1, VOCAB + 5, -1, 64], dtype=torch.int64)
+    is_multimodal = torch.tensor([False, True, False, False])
+    image_row = torch.full((1, HIDDEN), 123, dtype=torch.bfloat16)
+
+    actual = model.embed_input_ids(
+        ids,
+        multimodal_embeddings=[image_row],
+        is_multimodal=is_multimodal,
+    )
+
+    expected = torch.zeros(4, HIDDEN, dtype=torch.bfloat16)
+    expected[0].copy_(weight[1])
+    expected[1].copy_(image_row[0])
+    expected[3].copy_(weight[64])
+    _assert_same_bytes(actual, expected)
+
