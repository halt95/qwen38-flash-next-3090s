+class PinnedHostVocabParallelEmbedding(VocabParallelEmbedding):
+    """TP-sharded embedding read on CUDA through mapped pinned host memory."""
+
+    def __init__(
+        self,
+        num_embeddings: int,
+        embedding_dim: int,
+        params_dtype: torch.dtype | None = None,
+        org_num_embeddings: int | None = None,
+        padding_size: int = DEFAULT_VOCAB_PADDING_SIZE,
+        prefix: str = "",
+        *,
+        disable_tp: bool = False,
+        create_accelerator_view: bool = True,
+    ) -> None:
+        construction_device = torch.empty(0).device
+        is_meta = construction_device.type == "meta"
+        if (
+            create_accelerator_view
+            and not is_meta
+            and current_platform.is_cuda()
+            and not PIN_MEMORY
+        ):
+            raise RuntimeError(
+                "VLLM_HOST_EMBED_TABLE requires available pinned host memory"
+            )
+
+        storage_device = construction_device if is_meta else torch.device("cpu")
+        pin_memory = (
+            not is_meta
+            and current_platform.is_cuda()
+            and PIN_MEMORY
+        )
+        quant_method = _PinnedHostUnquantizedEmbeddingMethod(
+            device=storage_device,
+            pin_memory=pin_memory,
+        )
+        super().__init__(
+            num_embeddings,
+            embedding_dim,
+            params_dtype=params_dtype,
+            org_num_embeddings=org_num_embeddings,
+            padding_size=padding_size,
+            prefix=prefix,
+            disable_tp=disable_tp,
+            quant_method=quant_method,
+        )
+
+        # The custom fused kernel is specified for ordinary device-resident
+        # shards, not device-mapped host allocations. Use the regular masked
+        # embedding path whose CUDA tensor argument is the mapped view.
+        self.use_fused_embedding = False
+        self._uva_weight: torch.Tensor | None = None
+        if (
+            create_accelerator_view
+            and self.weight.device.type == "cpu"
+            and current_platform.is_cuda()
+        ):
+            if not self.weight.is_pinned():
+                raise RuntimeError(
+                    "VLLM_HOST_EMBED_TABLE weight was not allocated pinned"
+                )
+            self._uva_weight = get_accelerator_view_from_cpu_tensor(self.weight)
+
+    @property
+    def accelerator_weight_view(self) -> torch.Tensor | None:
+        return self._uva_weight
+
+    def _apply(self, fn, recurse: bool = True):
+        # Parent-model device/dtype transforms must not replace the pinned
+        # allocation or invalidate the stable address held by CUDA graphs.
+        del fn, recurse
+        return self
+
+    def _lookup_weight(self, input_: torch.Tensor) -> torch.Tensor:
+        if input_.device.type == "cpu":
+            return self.weight
+        if self._uva_weight is None:
+            raise RuntimeError(
+                "Host embedding received accelerator IDs without a UVA view"
+            )
+        if self._uva_weight.device != input_.device:
+            raise RuntimeError(
+                "Host embedding UVA view and input IDs are on different devices"
+            )
+        return self._uva_weight
+
+    def forward(self, input_: torch.Tensor) -> torch.Tensor:
+        masked_input, input_mask = get_masked_input_and_mask(
+            input_,
+            self.shard_indices.org_vocab_start_index,
+            self.shard_indices.org_vocab_end_index,
+            self.shard_indices.num_org_vocab_padding,
+            self.shard_indices.added_vocab_start_index,
+            self.shard_indices.added_vocab_end_index,
+        )
+        output_parallel = F.embedding(
+            masked_input.long(),
+            self._lookup_weight(input_),
+        )
+        output_parallel.masked_fill_(input_mask.unsqueeze(-1), 0)
+        if self.tp_size == 1:
+            return output_parallel
+        return tensor_model_parallel_all_reduce(output_parallel)
+
+
