+def _set_tp(monkeypatch, rank: int, world_size: int) -> None:
+    monkeypatch.setattr(vpe, "get_tensor_model_parallel_rank", lambda: rank)
+    monkeypatch.setattr(
+        vpe,
+        "get_tensor_model_parallel_world_size",
+        lambda: world_size,
+    )
+    monkeypatch.setattr(
+        vpe,
+        "tensor_model_parallel_all_reduce",
+        lambda value: value,
+    )
+
