+def _run_bounded_child(
+    source: str,
+    tmp_path: Path,
+    *arguments: str,
+    expected_exitcode: int = 0,
+) -> None:
+    marker = tmp_path / f"started-{time.monotonic_ns()}"
+    process = subprocess.Popen(
+        [sys.executable, "-c", source, str(marker), *arguments],
+        stderr=subprocess.DEVNULL,
+        start_new_session=os.name == "posix",
+    )
+    deadline = time.monotonic() + 120
+    while not marker.exists() and time.monotonic() < deadline:
+        time.sleep(0.05)
+    assert marker.exists(), "child did not finish cold startup within 120 seconds"
+
+    stayed_alive = False
+    try:
+        process.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        stayed_alive = True
+    finally:
+        if process.poll() is None:
+            if os.name == "posix":
+                os.killpg(process.pid, signal.SIGKILL)
+            else:
+                process.terminate()
+            process.wait(timeout=120)
+
+    assert not stayed_alive, "child stayed alive after the bounded operation"
+    assert process.returncode == expected_exitcode
+
+
+_FATAL_SOURCE = r"""
+import os
+import sys
+import threading
+from pathlib import Path
+
+from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+scenario = sys.argv[2]
+
+if scenario == "blocking-name-property":
+    class Meta(type):
+        @property
+        def __name__(cls):
+            threading.Event().wait()
+
+    class Error(Exception, metaclass=Meta):
+        pass
+
+    error = Error()
+elif scenario == "blocking-str-descriptor":
+    class Descriptor:
+        def __get__(self, instance, owner):
+            threading.Event().wait()
+
+    class Error(Exception):
+        __str__ = Descriptor()
+
+    error = Error()
+elif scenario == "blocking-name-format":
+    class BlockingName(str):
+        def __format__(self, format_spec):
+            threading.Event().wait()
+
+    class Meta(type):
+        @property
+        def __name__(cls):
+            return BlockingName("Error")
+
+    class Error(Exception, metaclass=Meta):
+        pass
+
+    error = Error()
+elif scenario == "blocking-str-method":
+    class Error(Exception):
+        def __str__(self):
+            threading.Event().wait()
+
+    error = Error()
+elif scenario == "overridden-getattribute":
+    class Error(Exception):
+        def __getattribute__(self, name):
+            threading.Event().wait()
+
+    error = Error("detail")
+elif scenario == "str-subclass-argument":
+    class BlockingString(str):
+        def __format__(self, format_spec):
+            threading.Event().wait()
+
+        def __str__(self):
+            threading.Event().wait()
+
+    error = RuntimeError(BlockingString("detail"))
+elif scenario == "huge-string":
+    error = RuntimeError("x" * (32 << 20))
+else:
+    raise AssertionError(scenario)
+
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+ple_fail_closed(
+    where="round5-fatal",
+    rank=1,
+    layer="ple",
+    sequence=3,
+    error=error,
+)
+"""
+
+
+@pytest.mark.parametrize(
+    "scenario",
+    [
+        "blocking-name-property",
+        "blocking-str-descriptor",
+        "blocking-name-format",
+    ],
+)
+def test_fatal_helper_avoids_exception_controlled_descriptors(
+    tmp_path: Path,
+    scenario: str,
+) -> None:
+    _run_bounded_child(
