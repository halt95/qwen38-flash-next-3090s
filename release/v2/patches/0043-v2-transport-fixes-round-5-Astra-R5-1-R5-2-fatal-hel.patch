+def test_startup_response_payload_at_cap_is_accepted(tmp_path: Path) -> None:
+    source = r"""
+import pickle
+import sys
+import threading
+from pathlib import Path
+
+import vllm.v1.ple_offload.worker as worker_module
+
+writer_type = getattr(
+    worker_module,
+    "_BoundedStartupResponseWriter",
+    None,
+)
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+if writer_type is None:
+    threading.Event().wait()
+
+cap = worker_module._PLE_READY_MAX_PAYLOAD_BYTES
+name = "x" * cap
+for unused in range(8):
+    message = {"status": "READY", "layer_names": [name]}
+    payload = pickle.dumps(message, protocol=pickle.HIGHEST_PROTOCOL)
+    if len(payload) == cap:
+        break
+    next_size = len(name) + cap - len(payload)
+    if next_size < 0:
+        raise AssertionError("cannot construct exact-cap payload")
+    name = "x" * next_size
+else:
+    raise AssertionError("exact-cap payload did not converge")
+
+class Writer:
+    def __init__(self):
+        self.payload = None
+
+    def send_bytes(self, payload):
+        self.payload = payload
+
+    def close(self):
+        return None
+
+raw_writer = Writer()
+writer_type(raw_writer).send(message)
+if raw_writer.payload != payload or len(raw_writer.payload) != cap:
+    raise AssertionError("exact-cap startup response was not preserved")
+"""
+    _run_bounded_child(source, tmp_path)
