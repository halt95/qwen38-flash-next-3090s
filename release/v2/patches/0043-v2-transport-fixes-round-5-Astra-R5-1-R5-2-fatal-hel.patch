+@pytest.mark.parametrize("identity", ["duplicate", "unbound"])
+def test_profile_breakable_initializer_follows_identity_validation(
+    tmp_path: Path,
+    identity: str,
+) -> None:
+    source = r"""
+import os
+import sys
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+
+from vllm.v1.worker.gpu.cudagraph_utils import ModelCudaGraphManager
+
+identity = sys.argv[2]
+if identity == "duplicate":
+    identities = ("shared", "shared")
+else:
+    identities = ("<unbound>",)
+
+modules = [
+    (
+        "module_" + str(index),
+        SimpleNamespace(
+            _is_cpu_offloaded=True,
+            _host_output_ptr=1,
+            _ple_offload_name=value,
+        ),
+    )
+    for index, value in enumerate(identities)
+]
+model = SimpleNamespace(named_modules=lambda: iter(modules))
+manager = ModelCudaGraphManager.__new__(ModelCudaGraphManager)
+spy = Path(sys.argv[1] + ".initializer")
+
+def blocking_initializer(model):
+    spy.write_text("called", encoding="utf-8")
+    threading.Event().wait()
+
+manager.init_breakable_cg_runner = blocking_initializer
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+
+prepare = getattr(manager, "_prepare_ple_capture", None)
+if prepare is None:
+    # This is the pre-fix profiling order: initialize before validation.
+    manager.init_breakable_cg_runner(model)
+else:
+    try:
+        prepare(model, initialize_breakable=True)
+    except RuntimeError as error:
+        if "distinct, bound" not in str(error):
+            raise
+    else:
+        raise AssertionError("invalid identities were accepted")
+
+if spy.exists():
+    raise AssertionError("initializer ran before identity rejection")
+"""
+    _run_bounded_child(source, tmp_path, identity)
+
