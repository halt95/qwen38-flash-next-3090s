+@pytest.mark.skipif(sys.platform == "win32", reason="process groups are POSIX-only")
+@pytest.mark.parametrize("status", ["READY", "FAILURE"])
+def test_oversized_startup_response_becomes_bounded_failure(
+    tmp_path: Path,
+    status: str,
+) -> None:
+    source = r"""
+import socket
+import sys
+from multiprocessing.connection import Connection
+from pathlib import Path
+
+import vllm.v1.ple_offload.worker as worker_module
+
+parent_socket, child_socket = socket.socketpair()
+raw_writer = Connection(child_socket.detach())
+writer_type = getattr(
+    worker_module,
+    "_BoundedStartupResponseWriter",
+    None,
+)
+writer = raw_writer if writer_type is None else writer_type(raw_writer)
+
+if sys.argv[2] == "READY":
+    message = {
+        "status": "READY",
+        "layer_names": ["x" * (2 << 20)],
+    }
+else:
+    message = {
+        "status": "FAILURE",
+        "error": "x" * (2 << 20),
+    }
+
+Path(sys.argv[1]).write_text("armed", encoding="utf-8")
+writer.send(message)
+"""
+    _run_bounded_child(source, tmp_path, status)
+
