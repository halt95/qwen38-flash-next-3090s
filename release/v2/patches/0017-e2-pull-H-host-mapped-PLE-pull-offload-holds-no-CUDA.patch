+# ---------------------------------------------------------------------------
+# Custom op: vllm::ple_offload_wait_copy (host-mapped pull design)
+# ---------------------------------------------------------------------------
+# The offload process writes the result into a page-locked shared host buffer
+# and stores flag=1 in a page-locked shared host int32; it holds no CUDA
+# context. On the CURRENT stream (captured into the graph like the wait above):
+#   cuStreamWaitValue32(host flag == 1)  -> GPU polls host memory
+#   cuMemcpyAsync(gpu buffer <- host buffer, num_tokens * row_bytes)
+# The copy engine reads host memory coherently after the flag was observed,
+# and the consumers read device memory as before. The flag is NOT reset here:
+# ``release_outputs`` resets it after the forward (unchanged semantics), so
+# capture warm-ups and dummy runs behave exactly as with ``ple_offload_wait``.
+# Pointers are passed as ints so no CPU tensor enters the compiled graph.
+# ---------------------------------------------------------------------------
+
+
+def _ple_offload_wait_copy_impl(
+    gpu_output_buffer: torch.Tensor,
+    hidden_states: torch.Tensor,
+    flag_ptr: int,
+    host_ptr: int,
+    row_bytes: int,
+    num_tokens: int,
+) -> None:
+    """Wait for the host-side result, then DMA it into the GPU buffer."""
+    stream = cuda_driver.CUstream(torch.cuda.current_stream().cuda_stream)
+    _cuda_check(
+        cuda_driver.cuStreamWaitValue32(
+            stream,
+            cuda_driver.CUdeviceptr(flag_ptr),
+            CpuGpuSemaphore.DONE_VALUE,
+            CUstreamWaitValue_flags.CU_STREAM_WAIT_VALUE_EQ.value,
+        ),
+        "cuStreamWaitValue32(host flag done)",
+    )
+    nbytes = int(num_tokens) * int(row_bytes)
+    if nbytes > 0:
+        _cuda_check(
+            cuda_driver.cuMemcpyAsync(
+                cuda_driver.CUdeviceptr(gpu_output_buffer.data_ptr()),
+                cuda_driver.CUdeviceptr(host_ptr),
+                nbytes,
+                stream,
+            ),
+            "cuMemcpyAsync(PLE host -> GPU)",
+        )
+
+
+def _ple_offload_wait_copy_fake(
+    gpu_output_buffer: torch.Tensor,
+    hidden_states: torch.Tensor,
+    flag_ptr: int,
+    host_ptr: int,
+    row_bytes: int,
+    num_tokens: int,
+) -> None:
+    """Represent the side-effect-only wait + copy during dynamo tracing."""
+    pass
+
+
+direct_register_custom_op(
+    op_name="ple_offload_wait_copy",
+    op_func=_ple_offload_wait_copy_impl,
+    mutates_args=["gpu_output_buffer"],
+    fake_impl=_ple_offload_wait_copy_fake,
+)
+
+
 class PleOffloadLayer(nn.Module, ABC):
     """Base class for embedding-like PLE layers that can run on CPU.
 
@@ -185,6 +278,10 @@ class PleOffloadLayer(nn.Module, ABC):
     _is_cpu_offloaded = False
