+_BALANCED_LIFETIME_SCRIPT = r"""
+import gc
+import os
+from multiprocessing.reduction import ForkingPickler
+from pathlib import Path
+
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.v1.ple_offload.connector import (
+    PleOffloadConnector,
+    _PROCESS_LIFETIME_REGISTERED_STORAGE,
+)
+from vllm.v1.ple_offload.protocol import PleOffloadRegistration
+
+
+def shm_path(tensor):
+    _, filename, _ = tensor.untyped_storage()._share_filename_cpu_()
+    return Path("/dev/shm") / os.fsdecode(filename).lstrip("/")
+
+
+class Progress:
+    def close(self):
+        pass
+
+
+original_strategy = torch_mp.get_sharing_strategy()
+torch_mp.set_sharing_strategy("file_system")
+try:
+    host_outputs = {
+        "layer.0": torch.arange(12, dtype=torch.float32)
+        .reshape(3, 4)
+        .share_memory_(),
+        "layer.1": torch.arange(8, dtype=torch.float32)
+        .reshape(2, 4)
+        .share_memory_(),
+    }
+    host_flags = {
+        name: torch.zeros(16, dtype=torch.int32).share_memory_()
+        for name in host_outputs
+    }
+    input_ids = torch.arange(16, dtype=torch.int32).share_memory_()
+    query_start_loc = torch.arange(5, dtype=torch.int32).share_memory_()
+    ngram_context = torch.arange(12, dtype=torch.int32).reshape(4, 3)
+    ngram_context.share_memory_()
+
+    registration = PleOffloadRegistration(
+        worker_id=1,
+        tp_rank=1,
+        dp_rank=0,
+        host_output_buffers=host_outputs,
+        host_flag_tensors=host_flags,
+        input_ids_buf=input_ids,
+        query_start_loc_buf=query_start_loc,
+        ngram_context_buf=ngram_context,
+    )
+    payload = ForkingPickler.dumps(registration)
+    rebuilt_registration = ForkingPickler.loads(payload)
+finally:
+    torch_mp.set_sharing_strategy(original_strategy)
+
+connector = PleOffloadConnector.__new__(PleOffloadConnector)
+connector._host_output_bufs = host_outputs
+connector._host_flags = host_flags
+connector._reserved_host_storage_filenames = set()
+connector._input_ids_buf = input_ids
+connector._query_start_loc_buf = query_start_loc
+connector._ngram_context_buf = ngram_context
+
+# Exercise the production close ordering without CUDA or transport setup.
+connector._request_thread = None
+connector._pinned_input_buffers = []
+connector._mapped_host_buffers = []
+connector._d2h_event_pool = object()
+connector._registration_socket = None
+connector._zmq_ctx = None
+connector._progress = Progress()
+
+tensors = [
+    *host_outputs.values(),
+    *host_flags.values(),
+    input_ids,
+    query_start_loc,
+    ngram_context,
+]
+assert len(tensors) == 7
+assert len({tensor.untyped_storage()._weak_ref() for tensor in tensors}) == 7
+
+# TP != 0 creates and serializes its input buffers without CUDA registration
+# or the process-lifetime reference used by TP0.
+unpinned_tp_input = input_ids
+assert not connector._pinned_input_buffers
+assert all(
+    unpinned_tp_input is not registered
+    for registered in _PROCESS_LIFETIME_REGISTERED_STORAGE
+)
+
+paths = [shm_path(tensor) for tensor in tensors]
+before = [tensor.clone() for tensor in tensors]
+assert all(path.exists() for path in paths)
+
+connector.close()
+connector.close()
+
+assert all(not path.exists() for path in paths)
+for tensor, expected in zip(tensors, before):
+    assert torch.equal(tensor, expected)
+    tensor.add_(1)
+    assert torch.equal(tensor, expected + 1)
+del tensor, expected
+
+# Remove every original and reconstructed tensor reference. With an unreserved
+# allocator this reaches counter zero after manual unlink and aborts the child.
+connector._host_output_bufs = {}
+connector._host_flags = {}
+connector._input_ids_buf = None
+connector._query_start_loc_buf = None
+connector._ngram_context_buf = None
+del connector
+del rebuilt_registration
+del registration
+del payload
+del unpinned_tp_input
+del tensors
+del before
+del host_outputs
+del host_flags
+del input_ids
+del query_start_loc
+del ngram_context
+gc.collect()
+
+assert all(not path.exists() for path in paths)
+"""
+
+
+def test_close_balanced_filename_storage_lifetime_exits_cleanly() -> None:
+    _require_file_system_shm()
+
+    # Resolve from the connector actually imported by this pytest process. This
+    # lets the red command run this patched test against an unpatched worktree.
+    import_root = Path(connector_module.__file__).resolve().parents[3]
+    env = os.environ.copy()
+    inherited_pythonpath = env.get("PYTHONPATH")
+    env["PYTHONPATH"] = (
+        os.pathsep.join((str(import_root), inherited_pythonpath))
+        if inherited_pythonpath
+        else str(import_root)
+    )
+
+    completed = subprocess.run(
+        [sys.executable, "-c", _BALANCED_LIFETIME_SCRIPT],
+        cwd=import_root,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+
+    assert completed.returncode == 0, (
+        "balanced PLE storage destruction failed "
+        f"(exit code {completed.returncode})\n"
+        f"stdout:\n{completed.stdout}\n"
+        f"stderr:\n{completed.stderr}"
+    )
