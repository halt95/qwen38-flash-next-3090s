+def test_launch_payload_send_has_absolute_deadline() -> None:
+    reader, sender = socket.socketpair()
+    sender.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 1024)
+    code = (
+        "import sys,time\n"
+        "from vllm.v1.ple_offload.worker import _send_framed_payload\n"
+        "payload=b'x'*(64<<20)\n"
+        "start=time.monotonic()\n"
+        "try:\n"
+        " _send_framed_payload(int(sys.argv[1]),payload,start+0.25)\n"
+        "except TimeoutError:\n"
+        " print('TIMED_OUT',time.monotonic()-start,flush=True)\n"
+        "else:\n"
+        " raise AssertionError('blocked reader unexpectedly accepted payload')\n"
+    )
+    process = subprocess.Popen(
+        [sys.executable, "-c", code, str(sender.fileno())],
+        pass_fds=(sender.fileno(),),
+        close_fds=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    sender.close()
+    try:
+        stdout, stderr = process.communicate(timeout=120)
+    finally:
+        reader.close()
+        if process.poll() is None:
+            process.terminate()
+            process.wait(timeout=5)
+    assert process.returncode == 0, stderr
+    marker, elapsed = stdout.strip().split()
+    assert marker == "TIMED_OUT"
+    assert float(elapsed) < 5
+
