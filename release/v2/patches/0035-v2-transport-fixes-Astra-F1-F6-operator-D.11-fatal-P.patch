+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Independent progress deadline for PLE transactions."""
+
+import os
+import threading
+import time
+
+from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+_DEFAULT_SERVING_DEADLINE_S = 300.0
+_DEFAULT_STARTUP_DEADLINE_S = 1800.0
+
+
+def _positive_deadline(name: str, default: float) -> float:
+    value = float(os.environ.get(name, str(default)))
+    if value <= 0:
+        raise ValueError(f"{name} must be greater than zero")
+    return value
+
+
+class PleProgressMonitor:
+    """Charge only time spent inside an outstanding PLE transaction."""
+
+    def __init__(
+        self,
+        *,
+        rank: int,
+        layer_names: tuple[str, ...],
+        serving_deadline_s: float,
+        startup_deadline_s: float,
+    ) -> None:
+        if serving_deadline_s <= 0 or startup_deadline_s <= 0:
+            raise ValueError("PLE progress deadlines must be greater than zero")
+        self._rank = rank
+        self._layer = ",".join(layer_names)
+        self._serving_deadline_s = serving_deadline_s
+        self._startup_deadline_s = startup_deadline_s
+        self._condition = threading.Condition()
+        self._active: tuple[int, bool, int, float] | None = None
+        self._depth = 0
+        self._sequence = 0
+        self._stopping = False
+        self._thread = threading.Thread(
+            target=self._run,
+            name=f"ple-progress-rank{rank}",
+            daemon=True,
+        )
+        self._thread.start()
+
+    @classmethod
+    def from_environment(
+        cls, *, rank: int, layer_names: tuple[str, ...]
+    ) -> "PleProgressMonitor":
+        return cls(
+            rank=rank,
+            layer_names=layer_names,
+            serving_deadline_s=_positive_deadline(
+                "VLLM_PLE_PROGRESS_DEADLINE_S",
+                _DEFAULT_SERVING_DEADLINE_S,
+            ),
+            startup_deadline_s=_positive_deadline(
+                "VLLM_PLE_STARTUP_DEADLINE_S",
+                _DEFAULT_STARTUP_DEADLINE_S,
+            ),
+        )
+
+    @property
+    def sequence(self) -> int:
+        with self._condition:
+            return self._sequence
+
+    def begin(self, *, startup: bool, num_tokens: int) -> int:
+        now = time.monotonic()
+        budget = (
+            self._startup_deadline_s if startup else self._serving_deadline_s
+        )
+        with self._condition:
+            if self._active is not None:
+                if not startup or not self._active[1]:
+                    raise RuntimeError(
+                        "Overlapping real PLE transactions violate the "
+                        "serialized single-slot protocol"
+                    )
+                # Capture can contain nested startup dummy executions. Keep the
+                # outer transaction armed and extend only the startup deadline.
+                sequence = self._active[0]
+                self._depth += 1
+                self._active = (sequence, True, num_tokens, now + budget)
+            else:
+                self._sequence += 1
+                sequence = self._sequence
+                self._depth = 1
+                self._active = (sequence, startup, num_tokens, now + budget)
+            self._condition.notify_all()
+            return sequence
+
+    def complete(self) -> None:
+        with self._condition:
+            if self._active is None or self._depth <= 0:
+                raise RuntimeError("PLE release has no matching transaction")
+            self._depth -= 1
+            if self._depth == 0:
+                self._active = None
+            self._condition.notify_all()
+
+    def close(self) -> None:
+        with self._condition:
+            self._stopping = True
+            self._condition.notify_all()
+        self._thread.join(timeout=1)
+
+    def _run(self) -> None:
+        while True:
+            with self._condition:
+                while self._active is None and not self._stopping:
+                    self._condition.wait()
+                if self._stopping:
+                    return
+                assert self._active is not None
+                sequence, startup, num_tokens, deadline = self._active
+                remaining = deadline - time.monotonic()
+                if remaining > 0:
+                    self._condition.wait(timeout=remaining)
+                    continue
+                # Recheck identity after waking so a completed/replaced
+                # transaction is never charged.
+                if self._active != (
+                    sequence,
+                    startup,
+                    num_tokens,
+                    deadline,
+                ):
+                    continue
+
+            mode = "startup" if startup else "serving"
+            ple_fail_closed(
+                where=f"progress-deadline:{mode}:tokens={num_tokens}",
+                rank=self._rank,
+                layer=self._layer,
+                sequence=sequence,
+                error=TimeoutError("PLE transaction made no bounded progress"),
+            )
