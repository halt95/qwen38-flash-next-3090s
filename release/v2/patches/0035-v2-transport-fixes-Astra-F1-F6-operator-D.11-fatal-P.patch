@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+
+from vllm.v1.worker import gpu_worker
+
+
+def test_shutdown_marks_ple_stopping_before_teardown(monkeypatch) -> None:
+    worker = gpu_worker.Worker.__new__(gpu_worker.Worker)
+    worker._ple_offload_stopping = False
+    order: list[tuple[str, bool]] = []
+
+    def record(name: str):
+        def call() -> None:
+            order.append((name, worker._ple_offload_stopping))
+        return call
+
+    monkeypatch.setattr(gpu_worker.gc, "unfreeze", record("gc"))
+    monkeypatch.setattr(
+        gpu_worker,
+        "ensure_kv_transfer_shutdown",
+        record("kv"),
+    )
+    monkeypatch.setattr(
+        gpu_worker,
+        "ensure_ec_transfer_shutdown",
+        record("ec"),
+    )
+    monkeypatch.setattr(
+        gpu_worker.current_platform,
+        "is_cuda_alike",
+        lambda: False,
+    )
+
+    worker.profiler = None
+    worker.weight_transfer_engine = None
+    worker.elastic_ep_executor = SimpleNamespace(
+        shutdown=record("elastic")
+    )
+    worker._ple_offload_worker_handle = SimpleNamespace(
+        close=record("offload")
+    )
+    worker.model_runner = SimpleNamespace(
+        shutdown=record("runner")
+    )
+
+    worker.shutdown()
+
+    assert order
+    assert all(stopping for _, stopping in order)
+    assert [name for name, _ in order][:2] == ["gc", "kv"]
diff --git a/tests/v1/ple_offload/test_spawn_bootstrap_cuda.py b/tests/v1/ple_offload/test_spawn_bootstrap_cuda.py
new file mode 100644
index 000000000..cb6222015
--- /dev/null
+++ b/tests/v1/ple_offload/test_spawn_bootstrap_cuda.py
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import ctypes
+import ctypes.util
+import json
+import multiprocessing
+import os
+import pickle
+import sys
+from pathlib import Path
+
+import pytest
+
+from vllm_ple_offload_bootstrap import proc_main
+
+
+def _native_cuda_probe(output_path: str) -> None:
+    """Run during config unpickling, before the bootstrap imports vLLM."""
+    library = ctypes.util.find_library("cudart")
+    if library is None:
+        os._exit(77)
+    cudart = ctypes.CDLL(library)
+    result = int(cudart.cudaFree(ctypes.c_void_p()))
+    Path(output_path).write_text(
+        json.dumps(
+            {
+                "cuda_visible_devices": os.environ.get(
+                    "CUDA_VISIBLE_DEVICES"
+                ),
+                "cuda_result": result,
+                "torch_imported": "torch" in sys.modules,
+                "vllm_imported": "vllm" in sys.modules,
+            }
+        ),
+        encoding="utf-8",
+    )
+    os._exit(0)
+
+
+class _ProbePayload:
+    def __init__(self, output_path: str) -> None:
+        self.output_path = output_path
+
+    def __reduce__(self):
+        return _native_cuda_probe, (self.output_path,)
+
+
+def test_spawn_bootstrap_sets_visibility_before_native_cuda(
+    tmp_path: Path,
+) -> None:
+    if ctypes.util.find_library("cudart") is None:
+        pytest.skip("CUDA runtime is not installed")
+
+    original = os.environ.get("CUDA_VISIBLE_DEVICES")
+    child_env = dict(os.environ)
+    child_env["CUDA_VISIBLE_DEVICES"] = "0"
+    output_path = tmp_path / "probe.json"
+    payload = pickle.dumps(
+        _ProbePayload(str(output_path)),
+        protocol=pickle.HIGHEST_PROTOCOL,
+    )
+
+    context = multiprocessing.get_context("spawn")
+    process = context.Process(
+        target=proc_main,
+        kwargs={
+            "child_env": child_env,
+            "vllm_config_payload": payload,
+        },
+    )
+    process.start()
+    process.join(timeout=15)
+
+    assert not process.is_alive()
+    if process.exitcode == 77:
+        pytest.skip("spawned child could not load the CUDA runtime")
+    assert process.exitcode == 0
+
+    result = json.loads(output_path.read_text(encoding="utf-8"))
+    assert result["cuda_visible_devices"] == "0"
+    assert result["cuda_result"] == 0
+    assert result["torch_imported"] is False
+    assert result["vllm_imported"] is False
+    assert os.environ.get("CUDA_VISIBLE_DEVICES") == original
diff --git a/vllm/model_executor/layers/ple_offload_layer.py b/vllm/model_executor/layers/ple_offload_layer.py
index ec551c083..e6a78dd01 100644
--- a/vllm/model_executor/layers/ple_offload_layer.py
+++ b/vllm/model_executor/layers/ple_offload_layer.py
@@ -6,15 +6,22 @@ Synchronization between the offload process and the GPU main stream is
 handled by :class:`CpuGpuSemaphore`, which uses CUDA's
 ``cuStreamWaitValue32`` / ``cuStreamWriteValue32`` stream memory operations.
 
-Typical decode-step timeline
-----------------------------
-Offload process (CPU)                  GPU main stream (forward)
------------------------------          ------------------------------
+Decode-step timeline, host-mapped PULL design (design H)
+--------------------------------------------------------
+Offload process (CPU, no CUDA)          GPU main stream (forward)
+------------------------------          ------------------------------
 forward_impl() on CPU                  ... other GPU ops ...
-pinned -> GPU async H2D (copy_stream)   WaitValue32(flag==1)  <- in Graph
-WriteValue32(flag=1, copy_stream)       return _gpu_output_buffer[:n]
-                                       ... model consumes output ...
-                                       WriteValue32(flag=0)  <- after forward
+wait host flag == 0                    WaitValue32(host flag == 1)   <- in graph
+rows -> shared pinned host slot         cuMemcpyHtoDAsync(slot -> GPU) <- in graph
+publish fence; host flag = 1            return _gpu_output_buffer[:n]
+                                        ... model consumes output ...
+                                        WriteValue32(host flag = 0)   <- release_outputs
+
+``release_outputs`` performs the sole reset. Safety requires serialized local
+forwards on one ordered model stream: a new transaction cannot begin until the
+prior release has been enqueued. If any prepared forward is abandoned or its
+correspondence becomes uncertain, the worker must terminate; resetting,
+retrying, or continuing could reuse stale rows or overwrite live input.
 """
 
 import functools
