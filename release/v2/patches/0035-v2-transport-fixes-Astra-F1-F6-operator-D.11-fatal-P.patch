@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fail-closed helpers for the PLE single-slot transport."""
+
+import functools
+import os
+from collections.abc import Callable
+from typing import Any, NoReturn, TypeVar
+
+_F = TypeVar("_F", bound=Callable[..., Any])
+
+
+def ple_fail_closed(
+    *,
+    where: str,
+    rank: int,
+    layer: str,
+    sequence: int,
+    error: BaseException,
+) -> NoReturn:
+    """Emit one best-effort nonblocking diagnostic and terminate immediately."""
+    try:
+        os.set_blocking(2, False)
+        message = (
+            f"PLE fatal: where={where} rank={rank} layer={layer} "
+            f"sequence={sequence} error={type(error).__name__}\n"
+        )
+        os.write(2, message.encode("utf-8", "backslashreplace")[:2048])
+    except BaseException:
+        pass
+    os._exit(1)
+
+
+def fail_ple_execute_model(func: _F) -> _F:
+    """Make every non-shutdown execute_model escape fatal when PLE is active."""
+
+    @functools.wraps(func)
+    def wrapped(self: Any, *args: Any, **kwargs: Any) -> Any:
+        try:
+            return func(self, *args, **kwargs)
+        except SystemExit:
+            # WorkerProc's signal handler uses SystemExit for clean shutdown.
+            raise
+        except BaseException as error:
+            connector = getattr(self, "_ple_offload_connector", None)
+            if connector is None:
+                raise
+            connector._fail_closed("execute_model", error)
+
+    return wrapped  # type: ignore[return-value]
