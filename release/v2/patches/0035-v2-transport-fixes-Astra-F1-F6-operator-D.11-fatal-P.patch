index 000000000..e6f1441c1
--- /dev/null
+++ b/tests/v1/ple_offload/test_correspondence.py
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+import torch
+
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.protocol import PleOffloadRequest
+from vllm.v1.ple_offload.worker import (
+    PleOffloadInputBuffers,
+    PleOffloadRunner,
+)
+
+
+class _ConnectorForValidation:
+    _input_ids_buf = torch.empty(4, dtype=torch.int32)
+    _query_start_loc_buf = torch.empty(3, dtype=torch.int32)
+    _rowdump_n = None
+
+    def _signal_dummy_outputs_impl(self, num_tokens: int) -> None:
+        raise AssertionError("must fail before dummy publication")
+
+    def _launch(self, num_reqs: int, num_tokens: int) -> None:
+        raise AssertionError("must fail before request publication")
+
+
+def test_request_consumer_count_mismatch_precedes_publication() -> None:
+    connector = _ConnectorForValidation()
+    with pytest.raises(RuntimeError, match="request/consumer"):
+        PleOffloadConnector._prepare_forward_impl(
+            connector,
+            1,
+            3,
+            False,
+            consumer_num_tokens=4,
+        )
+
+
+def _runner(query_start_loc: list[int]) -> PleOffloadRunner:
+    runner = PleOffloadRunner.__new__(PleOffloadRunner)
+    flag = torch.zeros(1, dtype=torch.int32)
+    target = SimpleNamespace(
+        host_output_buffer=torch.zeros(4, 2),
+        host_flag=flag,
+    )
+    runner._worker_targets = {0: {"ple": [target]}}
+    runner._scratch_bufs = {0: {"ple": torch.empty(4, 2)}}
+    query = torch.zeros(3, dtype=torch.int32)
+    query[: len(query_start_loc)] = torch.tensor(
+        query_start_loc, dtype=torch.int32
+    )
+    runner._input_bufs = {
+        0: PleOffloadInputBuffers(
+            input_ids_buf=torch.zeros(4, dtype=torch.int32),
+            query_start_loc_buf=query,
+            ngram_context_buf=torch.zeros(2, 1, dtype=torch.int32),
+        )
+    }
+    return runner
+
+
+@pytest.mark.parametrize(
+    ("ple_request", "query_start_loc", "match"),
+    [
+        (PleOffloadRequest(dp_rank=0, num_tokens=3, num_reqs=2), [0, 2, 1],
+         "query_start_loc"),
+        (PleOffloadRequest(dp_rank=0, num_tokens=5, num_reqs=1), [0, 1],
+         "num_tokens"),
+        (PleOffloadRequest(dp_rank=0, num_tokens=1, num_reqs=3), [0, 1, 1],
+         "num_reqs"),
+        (PleOffloadRequest(dp_rank=9, num_tokens=1, num_reqs=1), [0, 1],
+         "dp_rank=9"),
+    ],
+)
+def test_invalid_request_fails_before_publication(
+    ple_request: PleOffloadRequest,
+    query_start_loc: list[int],
+    match: str,
+) -> None:
+    runner = _runner(query_start_loc)
+    flags = [
+        target.host_flag
+        for layers in runner._worker_targets.values()
+        for targets in layers.values()
+        for target in targets
+    ]
+    with pytest.raises(RuntimeError, match=match):
+        runner._validate_requests_before_publication([ple_request])
+    assert all(int(flag[0]) == 0 for flag in flags)
diff --git a/tests/v1/ple_offload/test_fatal_rpc.py b/tests/v1/ple_offload/test_fatal_rpc.py
new file mode 100644
index 000000000..834406e8c
--- /dev/null
+++ b/tests/v1/ple_offload/test_fatal_rpc.py
@@ -0,0 +1,134 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import multiprocessing
+from typing import Any
+
+import pytest
+
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.fatal import (
+    fail_ple_execute_model,
+    ple_fail_closed,
+)
+
+
+class _Progress:
+    sequence = 7
+
+    def begin(self, **_: Any) -> int:
+        return self.sequence
+
+    def complete(self) -> None:
+        return
+
+
+class _InjectedConnector:
+    rank = 3
+    tp_rank = 1
+    _layers = {"ple": object()}
+    _progress = _Progress()
+    _input_ids_buf = None
+    _query_start_loc_buf = None
+
+    def __init__(self, where: str) -> None:
+        self.where = where
+
+    def _fail_closed(self, where: str, error: BaseException) -> None:
+        ple_fail_closed(
+            where=where,
+            rank=self.rank,
+            layer="ple",
+            sequence=self._progress.sequence,
+            error=error,
+        )
+
+    def _prepare_forward_impl(self, *args: Any, **kwargs: Any) -> None:
+        if self.where == "prepare":
+            raise RuntimeError("prepare injection")
+
+    def _release_outputs_impl(self) -> None:
+        if self.where == "release":
+            raise RuntimeError("release injection")
+
+
+class _Runner:
+    def __init__(self, where: str) -> None:
+        self._ple_offload_connector = _InjectedConnector(where)
+        self.where = where
+
+    @fail_ple_execute_model
+    def execute_model(self) -> None:
+        connector = self._ple_offload_connector
+        PleOffloadConnector.prepare_forward(
+            connector,
+            1,
+            1,
+            False,
+            consumer_num_tokens=1,
+        )
+        if self.where == "forward":
+            raise RuntimeError("forward injection")
+        PleOffloadConnector.release_outputs(connector)
+
+
+def _rpc_loop(where: str, successor_count: Any) -> None:
+    runner = _Runner(where)
+    try:
+        runner.execute_model()
+    except Exception:
+        # Mirrors WorkerProc._execute_worker_rpc: this must never regain control.
+        pass
+    with successor_count.get_lock():
+        successor_count.value += 1
+
+
+@pytest.mark.parametrize("where", ["prepare", "forward", "release"])
+def test_ple_exception_kills_workerproc_style_rpc(
+    where: str,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    successor_count = context.Value("i", 0)
+    process = context.Process(
+        target=_rpc_loop,
+        args=(where, successor_count),
+    )
+    process.start()
+    # Spawned children import vLLM cold (measured 4-8 s on bfgpu); the bound is
+    # about start-up, not the fatal path, which exits immediately.
+    process.join(timeout=120)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+    assert successor_count.value == 0
+
+
+def _rpc_loop_connector_only(where: str, successor_count: Any) -> None:
+    # No execute_model decorator: only the connector's own fatal wrappers can
+    # stop the RPC loop from regaining control. (The decorated test above
+    # passes on the decorator alone, so it cannot vouch for these wrappers.)
+    connector = _InjectedConnector(where)
+    try:
+        if where == "prepare":
+            PleOffloadConnector.prepare_forward(
+                connector, 1, 1, False, consumer_num_tokens=1
+            )
+        else:
+            PleOffloadConnector.release_outputs(connector)
+    except Exception:
+        pass
+    with successor_count.get_lock():
+        successor_count.value += 1
+
+
+@pytest.mark.parametrize("where", ["prepare", "release"])
+def test_connector_wrappers_are_fatal_without_decorator(where: str) -> None:
+    context = multiprocessing.get_context("spawn")
+    successor_count = context.Value("i", 0)
+    process = context.Process(
+        target=_rpc_loop_connector_only,
+        args=(where, successor_count),
+    )
+    process.start()
+    process.join(timeout=120)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
+    assert successor_count.value == 0
diff --git a/tests/v1/ple_offload/test_progress_deadline.py b/tests/v1/ple_offload/test_progress_deadline.py
new file mode 100644
index 000000000..8953abb49
--- /dev/null
+++ b/tests/v1/ple_offload/test_progress_deadline.py
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import multiprocessing
+import threading
+from typing import Any
+
+import pytest
+
+from vllm.v1.ple_offload.progress import PleProgressMonitor
+
+
+def _silent_producer_case(block_input: bool, started: Any) -> None:
+    monitor = PleProgressMonitor(
+        rank=2,
+        layer_names=("ple",),
+        serving_deadline_s=0.2,
+        startup_deadline_s=1.0,
+    )
+    monitor.begin(startup=False, num_tokens=32)
+    started.set()
+
+    if block_input:
+        # Models the request thread stuck in d2h_done_event.synchronize().
+        threading.Thread(
+            target=threading.Event().wait,
+            daemon=True,
+        ).start()
+
+    # Neither the fake producer nor the test terminates the process. The
+    # independent progress monitor must do so.
+    threading.Event().wait()
+
+
+@pytest.mark.parametrize("block_input", [False, True])
+def test_progress_deadline_terminates_alive_silent_worker(
+    block_input: bool,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    started = context.Event()
+    process = context.Process(
+        target=_silent_producer_case,
+        args=(block_input, started),
+    )
+    process.start()
+    # Cold vLLM import in the spawned child takes 4-8 s on bfgpu; the deadline
+    # itself (0.2 s) is only charged after `started` is set.
+    assert started.wait(timeout=120)
+    process.join(timeout=10)
+    assert not process.is_alive()
+    assert process.exitcode not in (None, 0)
