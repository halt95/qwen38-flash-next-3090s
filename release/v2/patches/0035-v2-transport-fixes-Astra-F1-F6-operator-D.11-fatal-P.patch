+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Minimal PLE child bootstrap; intentionally imports no torch or vLLM."""
+
+import os
+import pickle
+from typing import Any
+
+
+def proc_main(
+    *,
+    child_env: dict[str, str],
+    vllm_config_payload: bytes,
+    **worker_kwargs: Any,
+) -> None:
+    """Install child-only environment before config or implementation imports."""
+    os.environ.clear()
+    os.environ.update(child_env)
+
+    # VllmConfig unpickling and the worker import can both import implementation
+    # modules, so neither may happen before the environment is established.
+    vllm_config = pickle.loads(vllm_config_payload)
+
+    from vllm.v1.ple_offload.worker import PleOffloadWorker
+
+    PleOffloadWorker.proc_main(
+        vllm_config=vllm_config,
+        **worker_kwargs,
+    )
