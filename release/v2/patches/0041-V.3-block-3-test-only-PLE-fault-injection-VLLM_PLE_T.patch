+def _send_partial_ready_frame(fd: int) -> None:
+    """Write a complete frame header and an incomplete pickle body."""
+    body = pickle.dumps(
+        {"status": "READY", "layer_names": []},
+        protocol=pickle.HIGHEST_PROTOCOL,
+    )
+    fragment = memoryview(struct.pack("!i", len(body)) + body[: max(1, len(body) // 2)])
+    while fragment:
+        written = os.write(fd, fragment)
+        if written <= 0:
+            raise BrokenPipeError("PLE READY control socket closed")
+        fragment = fragment[written:]
+
