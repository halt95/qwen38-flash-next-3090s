+
+class NonBlockingReader:
+    """Reads device counter tensors from a side thread without ever waiting on
+    the compute stream (v2-rc6, qwen38next-flash#17).
+
+    The rc3 reader called ``buf.tolist()`` on its cadence: a synchronous,
+    pageable device-to-host copy on the compute stream. The driver services
+    that copy holding the CUDA context lock until the stream's queued work has
+    completed. Under the PLE pull transport the stream can hold a GPU-side
+    wait whose producer needs the same lock (the connector thread's
+    ``event.synchronize()`` and the main thread's next kernel launch), so a
+    reader tick landing inside that window deadlocked the whole worker until
+    the executor timeout killed the engine (two hangs, 2026-09-16/17, both at
+    the end of long prefills; py-spy stacks in the #17 record).
+
+    Here every registered tensor gets a pinned host mirror and the copy runs
+    on a dedicated side stream with ``non_blocking=True``; completion is
+    observed with ``event.query()``. Nothing in this class blocks on the GPU.
+    The side stream has no dependency on the compute stream, so a pending
+    wait there cannot stall the copy, and a non-blocking pinned copy returns
+    from the driver immediately. The rows a tick reports are therefore the
+    values as of the previous tick's copy, and the three slots of one site
+    may come from slightly different moments while kernels are still
+    counting: the count is monotone and the maxima are lifetime maxima, so
+    this changes nothing the reader claims.
+    """
+
+    def __init__(self) -> None:
+        self._streams: dict[torch.device, "torch.cuda.Stream"] = {}
+        # key -> [device_tensor, pinned_host_tensor | None, event | None, inflight]
+        self._jobs: dict[object, list] = {}
+        self._lock = threading.Lock()
+
+    def register(self, key: object, tensor: torch.Tensor) -> None:
+        with self._lock:
+            if key in self._jobs:
+                return
+            if tensor.device.type != "cuda":
+                self._jobs[key] = [tensor, None, None, False]
+                return
+            dev = tensor.device
+            # Luna r1 P1: a stream/event/pinned allocation inside a cudagraph
+            # capture is not capture-safe. prealloc() registers before capture
+            # and the reader thread registers lazily (it is never capturing);
+            # any other caller reaching this during a capture is a bug.
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError(
+                    "guard_telemetry: NonBlockingReader.register() called during "
+                    "cudagraph capture; prealloc() must run before capture"
+                )
+            if dev not in self._streams:
+                with torch.cuda.device(dev):
+                    self._streams[dev] = torch.cuda.Stream(device=dev)
+            host = torch.empty(tensor.shape, dtype=tensor.dtype, device="cpu", pin_memory=True)
+            with torch.cuda.device(dev):
+                event = torch.cuda.Event()
+            self._jobs[key] = [tensor, host, event, False]
+
+    def registered(self, key: object) -> bool:
+        return key in self._jobs
+
+    def poll_one(self, key: object) -> list | None:
+        """Return the rows of a completed copy for ``key`` and start the next
+        one; return None when the previous copy is still in flight. Never
+        blocks."""
+        job = self._jobs[key]
+        tensor, host, event, inflight = job
+        if host is None:  # CPU tensor: nothing can block
+            return tensor.tolist()
+        rows = None
+        if inflight:
+            if not event.query():
+                return None
+            rows = host.tolist()
+        stream = self._streams[tensor.device]
+        with torch.cuda.device(tensor.device), torch.cuda.stream(stream):
+            host.copy_(tensor, non_blocking=True)
+            event.record(stream)
+        job[3] = True
+        return rows
+
+    def poll(self) -> dict[object, list]:
+        out = {}
+        with self._lock:
+            keys = list(self._jobs)
+        for key in keys:
+            rows = self.poll_one(key)
+            if rows is not None:
+                out[key] = rows
+        return out
+
+    def read_now(self, key: object) -> list:
+        """Blocking read for orderly shutdown / tests ONLY: copies through the
+        pinned mirror on the side stream and waits for THAT copy (never a
+        pageable copy, never a wait on the compute stream). Callers sync the
+        device first when they need the latest kernel writes."""
+        job = self._jobs[key]
+        tensor, host, event, _ = job
+        if host is None:
+            return tensor.tolist()
+        stream = self._streams[tensor.device]
+        with torch.cuda.device(tensor.device), torch.cuda.stream(stream):
+            host.copy_(tensor, non_blocking=True)
+            event.record(stream)
+        event.synchronize()
+        job[3] = False
+        return host.tolist()
+
+    def reset(self) -> None:
+        """Test helper: drop in-flight copies so a zeroed counter is not
+        reported from a stale mirror."""
+        for job in self._jobs.values():
+            if job[1] is not None:
+                if job[3]:
+                    job[2].synchronize()
+                job[1].zero_()
+            job[3] = False
+
+
+_nb_reader = NonBlockingReader()
+# device -> the copy in which a count increase was first seen (reported on the next tick)
+_confirm_pending: dict[torch.device, list] = {}
+
 # Sites that arm the pending raise even under VLLM_E2_GUARD_MODE=warn. warn is
 # the right default for a guard that turns a crash into a locally wrong answer,
 # because the run continues and produces more evidence. It is the wrong default
@@ -223,6 +346,10 @@ def counter(site: int, device: torch.device) -> torch.Tensor:
                     (NUM_SITES, SLOTS_PER_SITE), dtype=torch.int64, device=device
                 )
                 _buffers[device] = buf
+                # v2-rc6 (#17): the reader mirrors this buffer through a pinned
+                # host copy on a side stream (registered by prealloc() before
+                # capture, or lazily by the reader thread -- never here, where
+                # a capture may be in progress).
     return buf[site]
 
 
@@ -237,6 +364,9 @@ def prealloc(device: torch.device) -> None:
     """
     for site in range(NUM_SITES):
         counter(site, device)
+    device = _normalize(device)
+    if not _nb_reader.registered(device):
+        _nb_reader.register(device, _buffers[device])
 
 
 def start_reader() -> None:
@@ -311,7 +441,30 @@ def _poll_once() -> None:
         if device in _read_disabled:
             continue
         try:
-            rows = buf.tolist()
+            # v2-rc6 (#17): a non-blocking side-stream copy; None means the
+            # previous copy is still in flight (report on a later tick).
+            if not _nb_reader.registered(device):
+                _nb_reader.register(device, buf)  # reader thread: never capturing
+            rows = _nb_reader.poll_one(device)
+            if rows is None:
+                continue
+            # Luna r1 P1: the side-stream copy is not a coherent snapshot of a
+            # site's three slots -- the kernels write the count first, then
+            # the maxima. A copy taken between them pairs a new count with
+            # stale maxima. So a count increase seen in copy k is REPORTED
+            # from copy k+1 (one tick later, >= 50 ms after the increment,
+            # by which time the maxima of that hit are written). The fatal
+            # decision is count-based either way; only its report waits a tick.
+            pend = _confirm_pending.get(device)
+            rising = [site for site, (n, _r, _v) in enumerate(rows) if n > _seen.get((device, site), 0)]
+            if pend is None:
+                if rising:
+                    _confirm_pending[device] = rows
+                continue
+            _confirm_pending.pop(device, None)
+            # report with the CONFIRMING copy's values (never lower than the
+            # pending copy's counts: the counters are monotone)
+            rows = [[max(a[0], b[0]), b[1], b[2]] for a, b in zip(pend, rows)]
         except Exception:  # noqa: BLE001 -- a reader must never kill the run
             # Never silent: a reader that cannot read is an instrument that
             # is not there, and this whole series depends on it. Log once,
@@ -406,7 +559,9 @@ def drain(*, raise_on_fatal: bool = False) -> dict[str, list[int]]:
         try:
             if device.type == "cuda":
                 torch.cuda.synchronize(device)
-            rows = buf.tolist()
+            if not _nb_reader.registered(device):
+                _nb_reader.register(device, buf)
+            rows = _nb_reader.read_now(device)  # pinned mirror, side stream only
         except Exception:  # noqa: BLE001
             logger.exception("rc3-instr FINAL DRAIN could not read %s", device)
             fatal.append(f"reader lost {device}")
@@ -456,5 +611,7 @@ def reset_for_test() -> None:
     global _pending
     for buf in _buffers.values():
         buf.zero_()
+    _nb_reader.reset()
+    _confirm_pending.clear()
     _seen.clear()
     _pending = None
