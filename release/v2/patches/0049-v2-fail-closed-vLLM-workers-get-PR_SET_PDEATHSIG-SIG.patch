+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import multiprocessing as mp
+import os
+import selectors
+import signal
+import subprocess
+import sys
+import time
+from contextlib import suppress
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+_PARENT_DEATH_EXIT_BOUND_S = 5.0
+_STARTUP_TIMEOUT_S = 180.0
+_TEST_FILE = Path(__file__).resolve()
+
+pytestmark = [
+    pytest.mark.skipif(not sys.platform.startswith("linux"), reason="Linux only"),
+    pytest.mark.timeout(240),
+]
+
+
+def _proc_identity(pid: int) -> tuple[str, str] | None:
+    try:
+        stat = Path(f"/proc/{pid}/stat").read_text()
+    except FileNotFoundError:
+        return None
+    closing_paren = stat.rfind(")")
+    fields = stat[closing_paren + 2 :].split()
+    # fields starts at proc(5)'s field 3: state; starttime is field 22.
+    return fields[0], fields[19]
+
+
+def _run_fake_worker_main(
+    ready_pipe,
+    workload_entered_pipe,
+    death_pipe,
+    inherited_fds: list[int],
+    expected_parent_pid: int,
+    block_mode: str,
+) -> None:
+    import vllm.v1.executor.multiproc_executor as executor_module
+
+    real_worker_proc = executor_module.WorkerProc
+    worker_main = real_worker_proc.worker_main
+
+    class FakeMessageQueue:
+        def export_handle(self):
+            identity = _proc_identity(os.getpid())
+            assert identity is not None
+            return os.getpid(), identity[1]
+
+        def wait_until_ready(self):
+            pass
+
+        def shutdown(self):
+            pass
+
+    class FakeWorkerProc:
+        READY_STR = real_worker_proc.READY_STR
+
+        def __init__(self, *args, **kwargs):
+            self.rank = 0
+            self.rpc_broadcast_mq = None
+            self.worker_response_mq = FakeMessageQueue()
+            self.peer_response_handles = []
+
+        def monitor_death_pipe(self, pipe, shutdown_requested):
+            return real_worker_proc.monitor_death_pipe(
+                self, pipe, shutdown_requested
+            )
+
+        def worker_busy_loop(self):
+            if block_mode == "gil-spin":
+                # Model a C extension that holds the GIL while polling.
+                sys.setswitchinterval(1000.0)
+                workload_entered_pipe.send(block_mode)
+                workload_entered_pipe.close()
+                while True:
+                    pass
+            if block_mode == "sleep":
+                workload_entered_pipe.send(block_mode)
+                workload_entered_pipe.close()
+                while True:
+                    time.sleep(3600)
+            raise AssertionError(f"unknown block mode: {block_mode}")
+
+        def shutdown(self):
+            pass
+
+    executor_module.WorkerProc = FakeWorkerProc
+    executor_module.maybe_init_worker_tracer = lambda **kwargs: None
+    executor_module.set_worker_net_device = lambda *args, **kwargs: None
+    config = SimpleNamespace(
+        parallel_config=SimpleNamespace(
+            assigned_physical_gpu_ids=None,
+            numa_bind=False,
+        )
+    )
+    worker_main(
+        vllm_config=config,
+        ready_pipe=ready_pipe,
+        death_pipe=death_pipe,
+        inherited_fds=inherited_fds,
+        expected_parent_pid=expected_parent_pid,
+    )
+
+
+def _worker_like_child(
+    ready_pipe,
+    workload_entered_pipe,
+    death_pipe,
+    inherited_fds: list[int],
+    expected_parent_pid: int,
+    block_mode: str,
+) -> None:
+    _run_fake_worker_main(
+        ready_pipe,
+        workload_entered_pipe,
+        death_pipe,
+        inherited_fds,
+        expected_parent_pid,
+        block_mode,
+    )
+
+
+def _orphan_parent(start_method: str, block_mode: str) -> None:
+    context = mp.get_context(start_method)
+    ready_reader, ready_writer = context.Pipe(duplex=False)
+    workload_reader, workload_writer = context.Pipe(duplex=False)
+    death_reader, death_writer = context.Pipe(duplex=False)
+    inherited_fds = []
+    if start_method == "fork":
+        inherited_fds.extend(
+            (
+                ready_reader.fileno(),
+                workload_reader.fileno(),
+                death_writer.fileno(),
+            )
+        )
+
+    proc = context.Process(
+        target=_worker_like_child,
+        args=(
+            ready_writer,
+            workload_writer,
+            death_reader,
+            inherited_fds,
+            os.getpid(),
+            block_mode,
+        ),
+        daemon=True,
+    )
+    proc.start()
+    ready_writer.close()
+    workload_writer.close()
+    death_reader.close()
+
+    if not ready_reader.poll(_STARTUP_TIMEOUT_S):
+        raise TimeoutError("worker-like child did not become ready")
+    response = ready_reader.recv()
+    ready_reader.close()
+    if not workload_reader.poll(_STARTUP_TIMEOUT_S):
+        raise TimeoutError("worker-like child did not enter its workload")
+    assert workload_reader.recv() == block_mode
+    workload_reader.close()
+    child_pid, start_time = response["handle"]
+    print(f"READY {child_pid} {start_time}", flush=True)
+
+    # Keep the death-pipe writer open until the test SIGKILLs this process.
+    assert death_writer is not None
+    while True:
+        signal.pause()
+
+
+class _StdoutReadyPipe:
+    def send(self, response) -> None:
+        child_pid, start_time = response["handle"]
+        print(f"READY {child_pid} {start_time}", flush=True)
+
+    def close(self) -> None:
+        pass
+
+
+class _UnusedWorkloadPipe:
+    def send(self, value) -> None:
+        pass
+
+    def close(self) -> None:
+        pass
+
+
+def _graceful_child() -> None:
+    _run_fake_worker_main(
+        _StdoutReadyPipe(),
+        _UnusedWorkloadPipe(),
+        death_pipe=None,
+        inherited_fds=[],
+        expected_parent_pid=os.getppid(),
+        block_mode="sleep",
+    )
+
+
+def _run_cli() -> None:
+    if sys.argv[1] == "orphan-parent":
+        _orphan_parent(sys.argv[2], sys.argv[3])
+    elif sys.argv[1] == "graceful-child":
+        _graceful_child()
+    else:
+        raise AssertionError(f"unknown command: {sys.argv[1]}")
+
+
+def _start_cli(*args: str) -> subprocess.Popen:
+    return subprocess.Popen(
+        [sys.executable, str(_TEST_FILE), *args],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        start_new_session=True,
+    )
+
+
+def _wait_for_ready(proc: subprocess.Popen) -> tuple[int, str]:
+    assert proc.stdout is not None
+    selector = selectors.DefaultSelector()
+    selector.register(proc.stdout, selectors.EVENT_READ)
+    deadline = time.monotonic() + _STARTUP_TIMEOUT_S
+    buffered = b""
+    try:
+        while time.monotonic() < deadline:
+            timeout = min(
+                1.0,
+                max(0.0, deadline - time.monotonic()),
+            )
+            if not selector.select(timeout):
+                if proc.poll() is not None:
+                    raise AssertionError(
+                        f"launcher exited before readiness: {proc.returncode}"
+                    )
+                continue
+            chunk = os.read(proc.stdout.fileno(), 4096)
+            if not chunk:
+                raise AssertionError("launcher closed stdout before readiness")
+            buffered += chunk
+            while b"\n" in buffered:
+                line, buffered = buffered.split(b"\n", 1)
+                if line.startswith(b"READY "):
+                    _, pid, start_time = line.split()
+                    return int(pid), start_time.decode()
+        raise AssertionError("timed out waiting for worker-like child readiness")
+    finally:
+        selector.close()
+
+
+def _wait_for_state(
+    pid: int, start_time: str, expected_state: str, deadline: float
+) -> bool:
+    while time.monotonic() < deadline:
+        identity = _proc_identity(pid)
+        if identity is None or identity[1] != start_time:
+            return False
+        if identity[0] == expected_state:
+            return True
+        time.sleep(0.01)
+    return False
+
+
+def _wait_for_exit(pid: int, start_time: str, deadline: float) -> float | None:
+    while time.monotonic() < deadline:
+        identity = _proc_identity(pid)
+        if (
+            identity is None
+            or identity[0] in {"X", "Z"}
+            or identity[1] != start_time
+        ):
+            return time.monotonic()
+        time.sleep(0.01)
+    return None
+
+
+def _kill_process_group(proc: subprocess.Popen) -> None:
+    with suppress(ProcessLookupError):
+        os.killpg(proc.pid, signal.SIGKILL)
+    with suppress(subprocess.TimeoutExpired):
+        proc.wait(timeout=10)
+    if proc.stdout is not None:
+        proc.stdout.close()
+
+
+@pytest.mark.parametrize(
+    ("start_method", "block_mode", "expected_state"),
+    [("fork", "gil-spin", "R"), ("spawn", "sleep", "S")],
+)
+def test_worker_dies_when_engine_core_parent_is_sigkilled(
+    start_method: str, block_mode: str, expected_state: str
+):
+    launcher = _start_cli("orphan-parent", start_method, block_mode)
+    try:
+        child_pid, start_time = _wait_for_ready(launcher)
+        assert _wait_for_state(
+            child_pid,
+            start_time,
+            expected_state,
+            time.monotonic() + 10,
+        ), f"worker {child_pid} did not enter {block_mode} state"
+        assert launcher.poll() is None
+
+        killed_at = time.monotonic()
+        os.kill(launcher.pid, signal.SIGKILL)
+        launcher.wait(timeout=_PARENT_DEATH_EXIT_BOUND_S)
+        exited_at = _wait_for_exit(
+            child_pid,
+            start_time,
+            killed_at + _PARENT_DEATH_EXIT_BOUND_S,
+        )
+
+        assert launcher.returncode == -signal.SIGKILL
+        assert exited_at is not None, (
+            f"worker {child_pid} survived its parent by more than "
+            f"{_PARENT_DEATH_EXIT_BOUND_S:.1f}s"
+        )
+        assert exited_at - killed_at <= _PARENT_DEATH_EXIT_BOUND_S
+    finally:
+        _kill_process_group(launcher)
+
+
+def test_sigterm_with_live_parent_uses_worker_system_exit_path():
+    worker = _start_cli("graceful-child")
+    try:
+        child_pid, start_time = _wait_for_ready(worker)
+        assert child_pid == worker.pid
+        assert _proc_identity(child_pid) is not None
+
+        os.kill(worker.pid, signal.SIGTERM)
+        worker.wait(timeout=10)
+
+        # WorkerProc's SIGTERM handler raises and re-raises SystemExit, so this
+        # is a clean Python exit rather than default signal termination (-15).
+        assert worker.returncode == 0
+        identity = _proc_identity(child_pid)
+        assert identity is None or identity[1] != start_time
+    finally:
+        _kill_process_group(worker)
+
+
+if __name__ == "__main__":
+    _run_cli()
