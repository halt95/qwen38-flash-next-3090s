+    num_cache_blocks,  # rc3-instr
+    guard_ctr,  # rc3-instr persistent int64[3]
     PAGE_SIZE: tl.constexpr,
     NUM_HEADS: tl.constexpr,
     HEAD_DIM: tl.constexpr,
@@ -181,6 +218,11 @@ def _qsa_mqa_paged_prefill_kernel(
         other=0.0,
     )
     column_offsets = tl.arange(0, BLOCK_N)
+    # rc3-instr (review E7): accumulate in registers inside the pipelined loop
+    # and do the cross-lane reduction + atomics once after it, so an
+    # atomic-bearing conditional does not sit in the loop body.
+    guard_bad_n = tl.zeros([BLOCK_N], dtype=tl.int32)
+    guard_bad_col = tl.full([BLOCK_N], -1, tl.int32)
     for tile in tl.range(k_tile_start, k_tile_end, num_stages=STAGES):
         columns = tile * BLOCK_N + column_offsets
         live = columns < max_visible
@@ -189,11 +231,22 @@ def _qsa_mqa_paged_prefill_kernel(
         physical_page = tl.load(
             page_table_ptr + request * stride_table_req + logical_page,
             mask=live,
-            other=0,
+            other=-1,
+        )
+        # Mirror of the QSA attention kernel (qsa.py:137): the VALUE read out of
+        # the page table is untrusted and must be bounded before it becomes an
+        # address. Folds into the existing live mask.
+        page_bad = live & ((physical_page < 0) | (physical_page >= num_cache_blocks))
+        guard_bad_n += page_bad.to(tl.int32)
+        guard_bad_col = tl.maximum(
+            guard_bad_col, tl.where(page_bad, logical_page, -1).to(tl.int32)
         )
+        live = live & (physical_page >= 0) & (physical_page < num_cache_blocks)
+        # physical_page * block stride can overflow int32 for large caches.
+        safe_page = tl.maximum(physical_page, 0).to(tl.int64)
         keys = tl.load(
             k_cache_ptr
-            + physical_page[:, None].to(tl.int64) * stride_cache_block
+            + safe_page[:, None] * stride_cache_block
             + page_offset[:, None] * stride_cache_token
             + dims[None, :],
             mask=live[:, None] & (dims[None, :] < HEAD_DIM),
@@ -214,6 +267,15 @@ def _qsa_mqa_paged_prefill_kernel(
             mask=store_mask,
         )
 
+    # rc3-instr: one reduction and at most one atomic per program.
+    guard_n = tl.sum(guard_bad_n, axis=0)
+    if guard_n > 0:
+        tl.atomic_add(guard_ctr, guard_n.to(tl.int64))
+        tl.atomic_max(guard_ctr + 1, (request).to(tl.int64) + _GUARD_BIAS)
+        tl.atomic_max(
+            guard_ctr + 2, (tl.max(guard_bad_col, axis=0)).to(tl.int64) + _GUARD_BIAS
+        )
+
 
