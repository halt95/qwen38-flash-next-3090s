+class _CleanupConfig:
+    def __init__(self, started_path: str, cleaned_path: str) -> None:
+        self.started_path = started_path
+        self.cleaned_path = cleaned_path
+
+    def __reduce__(self):
+        source = (
+            "import signal,threading\n"
+            "from pathlib import Path\n"
+            "from vllm.v1.ple_offload.worker import PleOffloadWorker\n"
+            f"_started=Path({self.started_path!r})\n"
+            f"_cleaned=Path({self.cleaned_path!r})\n"
+            "def _cleanup_proc_main(vllm_config,num_workers,ipc_addr,ready_pipe):\n"
+            " _stop=threading.Event()\n"
+            " signal.signal(signal.SIGTERM,lambda *_args:_stop.set())\n"
+            " _started.write_text('started',encoding='utf-8')\n"
+            " try:\n"
+            "  _stop.wait()\n"
+            " finally:\n"
+            "  _cleaned.write_text('cleaned',encoding='utf-8')\n"
+            "PleOffloadWorker.proc_main=staticmethod(_cleanup_proc_main)\n"
+        )
+        return exec, (source, {})
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+def test_normal_close_runs_child_cleanup(tmp_path: Path) -> None:
+    from vllm.v1.ple_offload.worker import PleOffloadWorker
+
+    started = tmp_path / "cleanup-started"
+    cleaned = tmp_path / "cleanup-finished"
+    handle = PleOffloadWorker.make_process(
+        _CleanupConfig(str(started), str(cleaned)),
+        0,
+        "unused",
+    )
+    try:
+        deadline = time.monotonic() + 120
+        while not started.exists() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert started.exists()
+    finally:
+        handle.close()
+
+    assert handle.proc.returncode == 0
+    assert cleaned.read_text(encoding="utf-8") == "cleaned"
