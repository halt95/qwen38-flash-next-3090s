+
+class _BlockingStrError(Exception):
+    def __str__(self) -> str:
+        __import__("threading").Event().wait()
+        return "unreachable"
+
+
+def _blocking_fatal_formatter_case(marker_path: str) -> None:
+    from vllm.v1.ple_offload.fatal import ple_fail_closed
+
+    Path(marker_path).write_text("armed", encoding="utf-8")
+    try:
+        raise _BlockingStrError()
+    except BaseException as error:
+        ple_fail_closed(
+            where="blocking-formatter",
+            rank=1,
+            layer="ple",
+            sequence=3,
+            error=error,
+        )
+
+
+def test_fatal_helper_does_not_call_blocking_exception_str(
+    tmp_path: Path,
+) -> None:
+    context = multiprocessing.get_context("spawn")
+    marker = tmp_path / "fatal-formatter-armed"
+    process = context.Process(
+        target=_blocking_fatal_formatter_case,
+        args=(str(marker),),
+    )
+    process.start()
+    try:
+        deadline = time.monotonic() + 120
+        while not marker.exists() and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert marker.exists()
+
+        process.join(timeout=5)
+        assert not process.is_alive()
+        assert process.exitcode not in (None, 0)
+    finally:
+        if process.is_alive():
+            process.terminate()
+            process.join(timeout=120)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+@pytest.mark.parametrize(
+    ("behavior", "ready_timeout", "expected_exception"),
+    [
+        pytest.param("partial", "1", TimeoutError, id="partial-frame"),
+        pytest.param("silent", "1", TimeoutError, id="no-response"),
+        pytest.param("ready", "120", None, id="complete-ready"),
+        pytest.param("invalid", "120", RuntimeError, id="invalid-layer-names"),
+    ],
+)
+def test_wait_for_ready_receives_complete_bounded_frame(
+    monkeypatch: pytest.MonkeyPatch,
+    behavior: str,
+    ready_timeout: str,
+    expected_exception: type[BaseException] | None,
+) -> None:
+    import vllm.v1.ple_offload.worker as worker_module
+
+    real_popen = subprocess.Popen
+    spawned: list[subprocess.Popen] = []
+    child_code = (
+        "import os,signal,struct,sys,time\n"
+        "from multiprocessing.connection import Connection\n"
+        "signal.alarm(10)\n"
+        "fd=int(sys.argv[1])\n"
+        "behavior=sys.argv[3]\n"
+        "if behavior=='partial':\n"
+        " os.write(fd,struct.pack('!i',128)+b'partial')\n"
+        "elif behavior=='ready':\n"
+        " Connection(fd).send({'status':'READY','layer_names':['ple']})\n"
+        "elif behavior=='invalid':\n"
+        " Connection(fd).send({'status':'READY','layer_names':'ple'})\n"
+        "time.sleep(120)\n"
+    )
+
+    def launch_fixture(argv: list[str], **kwargs: Any) -> subprocess.Popen:
+        process = real_popen(
+            [
+                sys.executable,
+                "-c",
+                child_code,
+                argv[-2],
+                argv[-1],
+                behavior,
+            ],
+            **kwargs,
+        )
+        spawned.append(process)
+        return process
+
+    monkeypatch.setenv("VLLM_PLE_OFFLOAD_READY_TIMEOUT", ready_timeout)
+    monkeypatch.setattr(worker_module.subprocess, "Popen", launch_fixture)
+
+    handle = worker_module.PleOffloadWorker.make_process(None, 0, "unused")
+    try:
+        started = time.monotonic()
+        if expected_exception is None:
+            worker_module.PleOffloadWorker.wait_for_ready(handle)
+            assert handle.ready_pipe_reader is None
+        else:
+            with pytest.raises(expected_exception):
+                worker_module.PleOffloadWorker.wait_for_ready(handle)
+            if expected_exception is TimeoutError:
+                assert time.monotonic() - started < 5
+            assert spawned[0].poll() is not None
+    finally:
+        handle.close(graceful=False)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+def test_make_process_large_payload_send_has_absolute_deadline(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    import vllm.v1.ple_offload.worker as worker_module
+
+    real_popen = subprocess.Popen
+    spawned: list[subprocess.Popen] = []
+
+    def launch_nonreader(argv: list[str], **kwargs: Any) -> subprocess.Popen:
+        process = real_popen(
+            [
+                sys.executable,
+                "-c",
+                "import signal,time; signal.alarm(120); time.sleep(120)",
+                argv[-2],
+                argv[-1],
+            ],
+            **kwargs,
+        )
+        spawned.append(process)
+        return process
+
+    monkeypatch.setenv("VLLM_PLE_OFFLOAD_READY_TIMEOUT", "5")
+    monkeypatch.setattr(worker_module.subprocess, "Popen", launch_nonreader)
+
+    started = time.monotonic()
+    with pytest.raises(TimeoutError, match="transmission"):
+        worker_module.PleOffloadWorker.make_process(
+            b"x" * (64 << 20),
+            0,
+            "unused",
+        )
+
+    assert time.monotonic() - started < 20
+    assert spawned
+    assert spawned[0].poll() is not None
