From 81e872e9e739f200629b94e51b0bae9c692dd057 Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Fri, 11 Sep 2026 00:03:06 +0000
Subject: [PATCH 11/76] e2: Qwen4ExpMTP.forward branches on
 intermediate_tensors (PR #46994 rule) so the drafter runs on the last PP
 stage

---
 vllm/models/qwen4_exp/nvidia/mtp.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/vllm/models/qwen4_exp/nvidia/mtp.py b/vllm/models/qwen4_exp/nvidia/mtp.py
index 932e16338..7d8c81d3d 100644
--- a/vllm/models/qwen4_exp/nvidia/mtp.py
+++ b/vllm/models/qwen4_exp/nvidia/mtp.py
@@ -282,7 +282,11 @@ class Qwen4ExpMultiTokenPredictor(nn.Module):
         hidden_size = self.hidden_size
         prev_block_output: torch.Tensor | None = None
 
-        if get_pp_group().is_first_rank:
+        # Branch on the inputs, not the rank (vllm PR #46994's rule, applied
+        # there to Qwen3_5MTP / DeepSeek MTP): the drafter is built entirely on
+        # the LAST pipeline stage, where is_first_rank is False, and it always
+        # starts from the target's hidden state + token ids it embeds itself.
+        if intermediate_tensors is None:
             assert hidden_states is not None
             if inputs_embeds is None:
                 assert input_ids is not None
@@ -304,7 +308,6 @@ class Qwen4ExpMultiTokenPredictor(nn.Module):
             hidden_states = hidden_states.flatten(-2)
             prev_block_output = inputs_embeds
         else:
-            assert intermediate_tensors is not None
             hidden_states = intermediate_tensors["hidden_states"]
 
         current_step_idx = spec_step_idx % self.num_mtp_layers
-- 
2.47.3

