+class _FreshInterpreterProbe:
+    def __init__(self, output_path: str) -> None:
+        self.output_path = output_path
+
+    def __reduce__(self):
+        expression = (
+            "(__import__('pathlib').Path("
+            + repr(self.output_path)
+            + ").write_text(__import__('json').dumps({"
+            "'cuda_visible_devices': __import__('os').environ.get("
+            "'CUDA_VISIBLE_DEVICES'),"
+            "'torch_imported': 'torch' in __import__('sys').modules,"
+            "'vllm_imported': 'vllm' in __import__('sys').modules"
+            "}), encoding='utf-8'), None)[1]"
+        )
+        return eval, (expression,)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="pass_fds is POSIX-only")
+def test_fresh_interpreter_has_child_environment_before_vllm_import(
+    tmp_path: Path,
+) -> None:
+    # This test module has unconditional top-level imports. The dedicated
+    # bootstrap interpreter must not import it as __mp_main__.
+    original = os.environ.get("CUDA_VISIBLE_DEVICES")
+    child_env = dict(os.environ)
+    child_env["CUDA_VISIBLE_DEVICES"] = "child-only"
+    output_path = tmp_path / "fresh-interpreter.json"
+    payload = pickle.dumps(
+        _FreshInterpreterProbe(str(output_path)),
+        protocol=pickle.HIGHEST_PROTOCOL,
+    )
+
+    parent_socket, child_socket = socket.socketpair()
+    control = Connection(parent_socket.detach())
+    process = subprocess.Popen(
+        [
+            sys.executable,
+            "-m",
+            "vllm_ple_offload_bootstrap",
+            str(child_socket.fileno()),
+        ],
+        env=child_env,
+        close_fds=True,
+        pass_fds=(child_socket.fileno(),),
+    )
+    child_socket.close()
+    try:
+        control.send(
+            {
+                "vllm_config_payload": payload,
+                "num_workers": 0,
+                "ipc_addr": "unused",
+            }
+        )
+        deadline = time.monotonic() + 120
+        while (
+            not output_path.exists()
+            and process.poll() is None
+            and time.monotonic() < deadline
+        ):
+            time.sleep(0.05)
+    finally:
+        control.close()
+        if process.poll() is None:
+            process.terminate()
+        process.wait(timeout=120)
+
+    assert output_path.exists()
+    result = json.loads(output_path.read_text(encoding="utf-8"))
+    assert result["cuda_visible_devices"] == "child-only"
+    assert result["torch_imported"] is False
+    assert result["vllm_imported"] is False
+    assert os.environ.get("CUDA_VISIBLE_DEVICES") == original
