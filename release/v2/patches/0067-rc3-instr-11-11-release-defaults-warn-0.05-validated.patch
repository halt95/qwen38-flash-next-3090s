+# Release defaults (round 11, Astra final review finding 1): warn, 0.05 s.
+# Rounds 1-10 shipped raise / 0.5 while every qualification boot set both
+# variables explicitly, so the defaults were never the thing being tested.
+_MODE = os.environ.get("VLLM_E2_GUARD_MODE", "warn").strip().lower()
 if _MODE not in ("raise", "warn", "off"):
     # fail closed: a set-but-broken gate must not silently disarm the instrument
     raise ValueError(
         f"VLLM_E2_GUARD_MODE must be raise|warn|off, got {_MODE!r}"
     )
