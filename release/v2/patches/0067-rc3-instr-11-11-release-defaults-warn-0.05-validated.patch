+        try:
+            time.sleep(_INTERVAL)
+            _poll_once()
+        except Exception:  # noqa: BLE001 -- the daemon itself must survive
+            # Round 11 (Astra finding 2): a reader that dies is an instrument
+            # that is not there, and _ALWAYS_FATAL_SITES depends on it. Arm
+            # the stop so the engine thread learns that the fatal-site
+            # contract is no longer held, then keep polling.
+            logger.exception("rc3-instr guard reader loop failed")
+            _arm(
+                "rc3-instr guard reader loop failed; the fatal-site contract "
+                "(_ALWAYS_FATAL_SITES) can no longer be enforced."
+            )
+            time.sleep(max(_INTERVAL, 0.05))
+
+
+def _report_rows(device: torch.device, rows: list[list[int]]) -> None:
+    """Report every (device, site) whose masked count advanced. Shared by the
+    cadence reader and the final drain."""
+    for site, (n_masked, biased_row, biased_val) in enumerate(rows):
+        if n_masked <= _seen.get((device, site), 0):
+            continue
+        _seen[(device, site)] = n_masked
+        row = biased_row - GUARD_BIAS if biased_row else None
+        val = biased_val - GUARD_BIAS if biased_val else None
+        msg = (
+            f"rc3-instr guard masked {n_masked} out-of-range access(es) "
+            f"in {SITE_NAMES.get(site, site)} on {device} "
+            f"(cumulative maxima: row-field {row}, index-field {val}; these "
+            f"are independent lifetime maxima, not one observed pair). The "
+            f"access was suppressed, so this is a MASKED FAULT and not a "
+            f"correct result -- the metadata is wrong upstream."
+        )
+        logger.warning("%s", msg)
+        if _MODE == "raise" or site in _ALWAYS_FATAL_SITES:
+            _arm(msg)
+
+
+def _poll_once() -> None:
+    for device, buf in list(_buffers.items()):
+        if device in _read_disabled:
+            continue
+        try:
+            rows = buf.tolist()
+        except Exception:  # noqa: BLE001 -- a reader must never kill the run
+            # Never silent: a reader that cannot read is an instrument that
+            # is not there, and this whole series depends on it. Log once,
+            # then stop polling that device.
+            #
+            # STOP POLLING IT, NOT STOP HOLDING IT (review R3-3). Round 3
+            # popped the buffer here, which drops the only durable Python
+            # reference: counter() hands out transient buf[site] views that
+            # are released after each launch, and under FULL replay nothing
+            # holds one at all. The storage would return to the caching
+            # allocator, be reused, and the CAPTURED atomics would keep
+            # writing to the baked address -- the memory-corrupting half of
+            # blocker B1, re-entering through the error handler.
+            logger.exception(
+                "rc3-instr guard reader failed to read the counter on %s; "
+                "no further guard telemetry will be reported for it. The "
+                "buffer is kept alive: captured graphs still write to it.",
+                device,
+            )
+            _read_disabled.add(device)
+            # Round 11 (Astra finding 2): losing the reader on a device
+            # silently voids the fatal-site contract for it. Arm the stop
+            # regardless of MODE (off never reaches here: no reader).
+            _arm(
+                f"rc3-instr guard reader lost the counter on {device}; the "
+                f"fatal-site contract (_ALWAYS_FATAL_SITES) is no longer "
+                f"enforced there."
+            )
+            continue
+        _report_rows(device, rows)
 
 
 def _arm(msg: str) -> None:
@@ -319,10 +372,58 @@ def check_pending() -> None:
     msg = _pending
     _pending = None
     raise RuntimeError(
-        f"{msg} Set VLLM_E2_GUARD_MODE=warn to continue past this."
+        f"{msg} (Sites in _ALWAYS_FATAL_SITES and reader failures stop the "
+        f"rank under every mode except off; MODE=warn only softens the other "
+        f"sites.)"
     )
 
 
+def drain(*, raise_on_fatal: bool = False) -> dict[str, list[int]]:
+    """Synchronous final read of every counter, off the cadence (round 11,
+    Astra finding 3).
+
+    The cadence reader can miss a hit on the LAST step of a run: the forward
+    completes, its result is consumed, no further execute_model polls
+    check_pending, and the process exits before the reader's next tick. Call
+    this at stage end / orderly shutdown, outside capture. It synchronizes the
+    device, reports anything the reader has not, and returns the unbiased
+    snapshot. With raise_on_fatal it raises for a hit at a site in
+    _ALWAYS_FATAL_SITES or, under MODE=raise, at any site. MODE=off drains
+    nothing (no reporting under off, by contract).
+    """
+    if _MODE == "off":
+        return {}
+    fatal: list[str] = []
+    for device, buf in list(_buffers.items()):
+        try:
+            if device.type == "cuda":
+                torch.cuda.synchronize(device)
+            rows = buf.tolist()
+        except Exception:  # noqa: BLE001
+            logger.exception("rc3-instr FINAL DRAIN could not read %s", device)
+            fatal.append(f"reader lost {device}")
+            continue
+        _report_rows(device, rows)
+        for site, (n_masked, _r, _v) in enumerate(rows):
+            if n_masked and (_MODE == "raise" or site in _ALWAYS_FATAL_SITES):
+                fatal.append(
+                    f"{SITE_NAMES.get(site, site)} on {device}: {n_masked}"
+                )
+    snap = snapshot()
+    if fatal:
+        logger.error(
+            "rc3-instr FINAL DRAIN: fatal-site hits %s (snapshot %s)",
+            fatal, snap,
+        )
+        if raise_on_fatal:
+            raise RuntimeError(f"rc3-instr FINAL DRAIN: fatal-site hits {fatal}")
+    else:
+        logger.info(
+            "rc3-instr FINAL DRAIN: no fatal-site hits (snapshot %s)", snap
+        )
+    return snap
+
+
 def snapshot() -> dict[str, list[int]]:
     """Test/diagnostic helper: current counters, unbiased. Syncs -- not for the
     step path."""
