+#!/usr/bin/env python3
+"""CPU-testable validation for external gates excluded from GPU campaigns."""
+
+from collections.abc import Callable
+
+
+def validate_partial_send_gate(
+    *,
+    pid: int,
+    expected_start: int,
+    observed_start: int,
+    alive: bool,
+    bytes_sent: int,
+    frame_size: int,
+    completed: bool,
+    child_not_reading: bool,
+) -> tuple[bool, str]:
+    if pid <= 1 or not alive:
+        return False, "target is stale or not alive"
+    if expected_start <= 0 or observed_start != expected_start:
+        return False, "target PID was reused"
+    if frame_size <= 0 or not 0 < bytes_sent < frame_size:
+        return False, "send is zero-byte or complete"
+    if completed:
+        return False, "send already completed"
+    if not child_not_reading:
+        return False, "child non-reading state was not acknowledged"
+    return True, "valid partial send"
+
+
+def deliver_checked_signal(
+    *,
+    pid: int,
+    expected_start: int,
+    read_start: Callable[[int], int],
+    alive: Callable[[int], bool],
+    send: Callable[[int, int], bool],
+    signal_number: int,
+) -> tuple[bool, str]:
+    if pid <= 1 or not alive(pid):
+        return False, "target is stale or not alive"
+    if read_start(pid) != expected_start:
+        return False, "target PID was reused"
+    if not send(pid, signal_number):
+        return False, "signal delivery failed"
+    return True, "signal delivered"
