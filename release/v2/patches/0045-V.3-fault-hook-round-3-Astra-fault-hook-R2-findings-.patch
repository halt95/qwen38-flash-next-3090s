--- /dev/null
+++ b/tests/v1/ple_offload/test_fault_round3_wire.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Round-3 apply checks: the disarmed PLE request wire format stays single-frame."""
+
+import contextlib
+import queue
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import msgspec
+import pytest
+
+
+def _request():
+    from vllm.v1.ple_offload.protocol import PleOffloadRequest
+
+    return PleOffloadRequest(dp_rank=0, num_tokens=2, num_reqs=1)
+
+
+def test_disarmed_offload_receive_uses_single_frame(monkeypatch):
+    import vllm.v1.ple_offload.worker as worker_module
+
+    monkeypatch.setattr(worker_module, "_FAULT", None)
+    request = _request()
+    socket = Mock()
+    socket.recv.return_value = msgspec.msgpack.encode(request)
+    socket.recv_multipart.side_effect = AssertionError("multipart read while disarmed")
+
+    assert worker_module._receive_offload_request(socket) == request
+    socket.recv.assert_called_once_with(0)
+
+
+def test_armed_offload_receive_requires_metadata_frame(monkeypatch):
+    import vllm.v1.ple_offload.worker as worker_module
+
+    monkeypatch.setattr(worker_module, "_FAULT", object())
+    request = _request()
+    metadata = {"serving": True, "transaction": "request:1", "correlation": "sequence:3"}
+    socket = Mock()
+    socket.recv.side_effect = AssertionError("single-frame read while armed")
+    socket.recv_multipart.return_value = [
+        msgspec.msgpack.encode(request),
+        msgspec.msgpack.encode(metadata),
+    ]
+
+    received = worker_module._receive_offload_request(socket, 1)
+    assert received.request == request
+    assert received.serving is True
+    assert received.transaction_id == "request:1"
+    assert received.correlation_id == "sequence:3"
+    socket.recv_multipart.assert_called_once_with(1)
+
+    socket.recv_multipart.return_value = [msgspec.msgpack.encode(request)]
+    with pytest.raises(RuntimeError):
+        worker_module._receive_offload_request(socket)
+
+
+@pytest.mark.parametrize("armed", [False, True])
+def test_connector_publication_frames_follow_arming(monkeypatch, armed):
+    import vllm.v1.ple_offload.connector as connector_module
+
+    fault = SimpleNamespace(fires=lambda *args, **kwargs: False) if armed else None
+    monkeypatch.setattr(connector_module, "_FAULT", fault)
+    monkeypatch.setattr(
+        connector_module.torch.accelerator,
+        "device_index",
+        lambda _index: contextlib.nullcontext(),
+    )
+    connector = object.__new__(connector_module.PleOffloadConnector)
+    connector.tp_rank = 0
+    connector.pp_rank = 0
+    connector.dp_rank = 0
+    connector.device = SimpleNamespace(index=0)
+    connector._d2h_event_pool = queue.Queue()
+    event = Mock()
+    request = _request()
+    pending = connector_module._PendingPleOffloadRequest(
+        request, event, True, "sequence:4@begin:1.000000000", "sequence:4"
+    )
+    socket = Mock()
+
+    connector._process_request(pending, socket)
+
+    event.synchronize.assert_called_once()
+    if armed:
+        socket.send.assert_not_called()
+        payload, metadata = socket.send_multipart.call_args.args[0]
+        assert msgspec.msgpack.decode(metadata) == {
+            "serving": True,
+            "transaction": "sequence:4@begin:1.000000000",
+            "correlation": "sequence:4",
+        }
+    else:
+        socket.send_multipart.assert_not_called()
+        (payload,) = socket.send.call_args.args
+    assert payload == msgspec.msgpack.encode(request)
+    assert connector._d2h_event_pool.get_nowait() is event
