@@ -40,6 +40,69 @@ logger = init_logger(__name__)
 _PROCESS_LIFETIME_REGISTERED_STORAGE: list[torch.Tensor] = []
 
 
+def _torch_shm_unlink(filename: bytes) -> bool:
+    """Use a torch shm-unlink helper when the installed build exposes one."""
+    for namespace in (torch, torch._C):
+        for helper_name in ("_shm_unlink", "_unlink_shm", "_unlink_shared_memory"):
+            helper = getattr(namespace, helper_name, None)
+            if helper is None:
+                continue
+            try:
+                helper(filename)
+            except FileNotFoundError:
+                return True
+            except OSError as error:
+                logger.warning(
+                    "Torch failed to unlink PLE shared memory %r: %s; "
+                    "falling back to os.unlink",
+                    filename,
+                    error,
+                )
+                return False
+            except (RuntimeError, TypeError):
+                # Private helper signatures vary; the filesystem fallback
+                # below has the same Linux shm_unlink namespace effect.
+                return False
+            return True
+    return False
+
+
+def _unlink_filename_shared_storage(tensor: torch.Tensor) -> None:
+    """Best-effort unlink of one already filename-shared CPU storage."""
+    try:
+        storage = tensor.untyped_storage()
+        if storage.device.type != "cpu" or not storage.is_shared():
+            return
+        try:
+            storage._get_shared_fd()
+        except RuntimeError:
+            # Filename-shared storages do not expose a shared fd. Only now is
+            # it safe to query the filename: doing so on ordinary or fd-shared
+            # storage would convert it to a new filename-backed allocation.
+            pass
+        else:
+            return
+        _, filename, _ = storage._share_filename_cpu_()
+        if not isinstance(filename, bytes):
+            filename = os.fsencode(filename)
+        path = os.path.join("/dev/shm", os.fsdecode(filename).lstrip("/"))
+    except Exception:
+        logger.warning(
+            "Failed to inspect a PLE shared-memory storage during teardown",
+            exc_info=True,
+        )
+        return
+
+    if _torch_shm_unlink(filename):
+        return
+    try:
+        os.unlink(path)
+    except FileNotFoundError:
+        pass
+    except OSError as error:
+        logger.warning("Failed to unlink PLE shared memory %s: %s", path, error)
+
+
