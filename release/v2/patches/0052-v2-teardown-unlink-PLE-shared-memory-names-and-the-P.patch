diff --git a/tests/v1/ple_offload/test_ipc_socket_unlink.py b/tests/v1/ple_offload/test_ipc_socket_unlink.py
new file mode 100644
index 000000000..92fbc4279
--- /dev/null
+++ b/tests/v1/ple_offload/test_ipc_socket_unlink.py
@@ -0,0 +1,133 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import contextlib
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+
+import pytest
+
+from vllm.v1.ple_offload.worker import PleOffloadWorkerHandle
+
+
+pytestmark = pytest.mark.skipif(
+    sys.platform != "linux", reason="requires Linux filesystem ipc sockets"
+)
+
+
+_STUB_CHILD = r"""
+import pathlib
+import signal
+import sys
+import threading
+
+import zmq
+
+from vllm.v1.ple_offload.worker import _unlink_ipc_socket
+
+ipc_addr, mode, marker = sys.argv[1:]
+stopping = threading.Event()
+if mode == "graceful":
+    signal.signal(signal.SIGTERM, lambda _signum, _frame: stopping.set())
+else:
+    signal.signal(signal.SIGTERM, signal.SIG_IGN)
+
+context = zmq.Context()
+socket = context.socket(zmq.PULL)
+socket.bind(ipc_addr)
+try:
+    stopping.wait()
+finally:
+    socket.close(linger=0)
+    context.term()
+    if mode == "graceful":
+        _unlink_ipc_socket(ipc_addr)
+        pathlib.Path(marker).touch()
+"""
+
+
+def _start_stub(ipc_addr: str, mode: str, marker: Path) -> subprocess.Popen:
+    return subprocess.Popen(
+        [sys.executable, "-c", _STUB_CHILD, ipc_addr, mode, str(marker)],
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+
+def _wait_for_socket(proc: subprocess.Popen, path: Path) -> None:
+    deadline = time.monotonic() + 30
+    while time.monotonic() < deadline:
+        if path.exists():
+            return
+        if proc.poll() is not None:
+            stderr = proc.stderr.read() if proc.stderr is not None else ""
+            pytest.fail(f"stub child exited before bind: {stderr}")
+        time.sleep(0.01)
+    pytest.fail("stub child did not bind its ipc socket")
+
+
+def _cleanup_process(proc: subprocess.Popen, socket_path: Path) -> None:
+    if proc.poll() is None:
+        proc.kill()
+        proc.wait(timeout=5)
+    with contextlib.suppress(FileNotFoundError):
+        os.unlink(socket_path)
+    if proc.stderr is not None:
+        proc.stderr.close()
+
+
+def test_handle_graceful_close_removes_child_bound_socket() -> None:
+    with tempfile.TemporaryDirectory(prefix="ple-ipc-", dir="/tmp") as temp_dir:
+        socket_path = Path(temp_dir) / "owned.sock"
+        marker = Path(temp_dir) / "child-cleaned"
+        ipc_addr = f"ipc://{socket_path}"
+        proc = _start_stub(ipc_addr, "graceful", marker)
+        try:
+            handle = PleOffloadWorkerHandle(
+                proc=proc,
+                death_writer=None,
+                ready_pipe_reader=None,
+                launch_deadline=time.monotonic() + 30,
+                ipc_addr=ipc_addr,
+            )
+            _wait_for_socket(proc, socket_path)
+
+            handle.close()
+
+            assert proc.returncode == 0
+            assert marker.exists(), "the child ran its post-context unlink"
+            assert not socket_path.exists()
+        finally:
+            _cleanup_process(proc, socket_path)
+
+
+def test_handle_close_removes_socket_after_child_sigkill() -> None:
+    with tempfile.TemporaryDirectory(prefix="ple-ipc-", dir="/tmp") as temp_dir:
+        socket_path = Path(temp_dir) / "owned.sock"
+        marker = Path(temp_dir) / "unused"
+        ipc_addr = f"ipc://{socket_path}"
+        proc = _start_stub(ipc_addr, "park", marker)
+        try:
+            handle = PleOffloadWorkerHandle(
+                proc=proc,
+                death_writer=None,
+                ready_pipe_reader=None,
+                launch_deadline=time.monotonic() + 30,
+                ipc_addr=ipc_addr,
+            )
+            _wait_for_socket(proc, socket_path)
+            proc.kill()
+            proc.wait(timeout=5)
+            assert proc.returncode == -signal.SIGKILL
+            assert socket_path.exists()
+
+            handle.close()
+
+            assert not socket_path.exists()
+        finally:
+            _cleanup_process(proc, socket_path)
diff --git a/tests/v1/ple_offload/test_shm_unlink.py b/tests/v1/ple_offload/test_shm_unlink.py
new file mode 100644
index 000000000..0073a4f5e
--- /dev/null
+++ b/tests/v1/ple_offload/test_shm_unlink.py
@@ -0,0 +1,158 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import os
+from multiprocessing.reduction import ForkingPickler
+from pathlib import Path
+
+import pytest
+import torch
+import torch.multiprocessing as torch_mp
+
+from vllm.v1.ple_offload import connector as connector_module
+from vllm.v1.ple_offload.connector import PleOffloadConnector
+from vllm.v1.ple_offload.protocol import PleOffloadRegistration
+
+
+def _require_file_system_shm() -> None:
+    if (
+        os.name != "posix"
+        or not os.path.isdir("/dev/shm")
+        or not os.access("/dev/shm", os.W_OK)
+    ):
+        pytest.skip("POSIX /dev/shm is unavailable")
+    if "file_system" not in torch_mp.get_all_sharing_strategies():
+        pytest.skip("torch file_system sharing is unavailable")
+
+
+def _shm_path(tensor: torch.Tensor) -> Path:
+    _, filename, _ = tensor.untyped_storage()._share_filename_cpu_()
+    return Path("/dev/shm") / os.fsdecode(filename).lstrip("/")
+
+
+def _cleanup_paths(paths: list[Path]) -> None:
+    # Keep red runs against the unpatched tree from leaking their test names.
+    for path in paths:
+        try:
+            os.unlink(path)
+        except FileNotFoundError:
+            pass
+
+
+def _make_connector_storage() -> tuple[PleOffloadConnector, list[torch.Tensor]]:
+    original_strategy = torch_mp.get_sharing_strategy()
+    torch_mp.set_sharing_strategy("file_system")
+    try:
+        host_outputs = {
+            "layer.0": torch.arange(12, dtype=torch.float32)
+            .reshape(3, 4)
+            .share_memory_(),
+            "layer.1": torch.arange(8, dtype=torch.float32)
+            .reshape(2, 4)
+            .share_memory_(),
+        }
+        host_flags = {
+            name: torch.zeros(16, dtype=torch.int32).share_memory_()
+            for name in host_outputs
+        }
+        input_ids = torch.arange(16, dtype=torch.int32).share_memory_()
+        query_start_loc = torch.arange(5, dtype=torch.int32).share_memory_()
+        ngram_context = torch.arange(12, dtype=torch.int32).reshape(4, 3)
+        ngram_context.share_memory_()
+
+        registration = PleOffloadRegistration(
+            worker_id=0,
+            tp_rank=0,
+            dp_rank=0,
+            host_output_buffers=host_outputs,
+            host_flag_tensors=host_flags,
+            input_ids_buf=input_ids,
+            query_start_loc_buf=query_start_loc,
+            ngram_context_buf=ngram_context,
+        )
+        # Match PleOffloadConnector._serialize_registration: this is what
+        # fixes each file_system storage's final shared-memory name.
+        assert ForkingPickler.dumps(registration)
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._host_output_bufs = host_outputs
+    connector._host_flags = host_flags
+    connector._input_ids_buf = input_ids
+    connector._query_start_loc_buf = query_start_loc
+    connector._ngram_context_buf = ngram_context
+    tensors = [
+        *host_outputs.values(),
+        *host_flags.values(),
+        input_ids,
+        query_start_loc,
+        ngram_context,
+    ]
+    assert len(tensors) == 7
+    return connector, tensors
+
+
+def test_release_host_storage_unlinks_names_but_keeps_mappings() -> None:
+    _require_file_system_shm()
+    connector, tensors = _make_connector_storage()
+    paths: list[Path] = []
+    try:
+        for tensor in tensors:
+            paths.append(_shm_path(tensor))
+        before = [tensor.clone() for tensor in tensors]
+        assert len(set(paths)) == 7
+        assert all(path.exists() for path in paths)
+
+        connector.release_host_storage()
+
+        assert all(not path.exists() for path in paths)
+        for tensor, expected in zip(tensors, before):
+            assert torch.equal(tensor, expected)
+            tensor.add_(1)
+            assert torch.equal(tensor, expected + 1)
+    finally:
+        _cleanup_paths(paths)
+
+
+def test_without_release_helper_names_remain(monkeypatch) -> None:
+    _require_file_system_shm()
+    connector, tensors = _make_connector_storage()
+    paths: list[Path] = []
+    try:
+        for tensor in tensors:
+            paths.append(_shm_path(tensor))
+        with monkeypatch.context() as patch:
+            patch.setattr(
+                connector_module,
+                "_unlink_filename_shared_storage",
+                lambda _tensor: None,
+            )
+            connector.release_host_storage()
+
+        assert all(path.exists() for path in paths)
+    finally:
+        _cleanup_paths(paths)
+
+
+def test_release_host_storage_does_not_convert_fd_shared_storage() -> None:
+    if "file_descriptor" not in torch_mp.get_all_sharing_strategies():
+        pytest.skip("torch file_descriptor sharing is unavailable")
+    original_strategy = torch_mp.get_sharing_strategy()
+    torch_mp.set_sharing_strategy("file_descriptor")
+    try:
+        fd_tensor = torch.arange(8, dtype=torch.int32).share_memory_()
+    finally:
+        torch_mp.set_sharing_strategy(original_strategy)
+
+    connector = PleOffloadConnector.__new__(PleOffloadConnector)
+    connector._host_output_bufs = {"layer.0": fd_tensor}
+    connector._host_flags = {}
+    connector._input_ids_buf = torch.arange(2, dtype=torch.int32)
+    connector._query_start_loc_buf = torch.arange(2, dtype=torch.int32)
+    connector._ngram_context_buf = None
+    expected = fd_tensor.clone()
+
+    connector.release_host_storage()
+
+    assert fd_tensor.untyped_storage()._get_shared_fd() >= 0
+    assert torch.equal(fd_tensor, expected)
