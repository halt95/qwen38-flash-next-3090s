+# --- FP8 K/V runtime clipping counter (qwen38next-flash issue #1) -------------
+# Under-coverage guard for the calibrated scales sidecar: counts K/V elements
+# that would saturate E4M3 after scaling (|x| > 448 * scale), i.e. inputs that
+# exceed the calibration-time absmax. Active ONLY when VLLM_QSA_KV_CLIP_COUNT
+# is set to a positive read interval in seconds.
+#
+# Graph-safety: unlike the calibration collector above, this MUST work under
+# FULL cudagraph replay, where the Python forward does not run per step. The
+# counters are persistent per-layer GPU int64 tensors allocated on the first
+# (eager, pre-capture) forward; the increment is pure captured GPU ops, so
+# graph replay keeps counting. A daemon reader thread .item()s the counters on
+# a cadence and logs: WARNING on any new clips, INFO heartbeat every 10th pass
+# so a quiet log still proves the instrument is alive.
+_QSA_CLIP_ENV = "VLLM_QSA_KV_CLIP_COUNT"
+_qsa_clip_raw = os.environ.get(_QSA_CLIP_ENV, "").strip()
