--- /dev/null
+++ b/tests/v1/worker/gpu/test_recoverssm_pp_deferral.py
@@ -0,0 +1,408 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The RecoverSSM commit under pipeline parallelism (CPU, no GPU).
+
+A non-last PP rank verifies a speculative window at step T but receives the
+accepted counts only when the PP broadcast of step T is consumed, pp_size steps
+later (``PPHandler.get_prev_sampled_outputs`` in ``update_pp_decode_requests``).
+Upstream #58863 keeps one recorded step (``RecoverSSMState._step``) and commits
+it in the same step's postprocess, so it requires pipeline_parallel_size=1:
+under PP the deferred postprocess of step T would commit the metadata of the
+most recent step instead, and that metadata's spec state indices, query offsets
+and batch-order block table are persistent buffers the next build overwrites.
+
+The fork detaches the step in ``sample_tokens`` (a snapshot whose commit inputs
+are clones), keeps it on step T's pending PP entry, restores it right before
+step T's deferred postprocess, and masks rows whose request was freed in
+between (their blocks may already belong to another request).
+
+Every scenario here has a failing control that flips: the upstream single-slot
+flow and a snapshot that aliases the persistent buffers both commit the wrong
+step; a deferred commit without the freed-row mask commits into a freed slot;
+a teardown without the PP purge keeps the profiling KV cache alive.
+"""
+
+import ast
+import gc
+import inspect
+import textwrap
+import weakref
+from collections import deque
+from dataclasses import dataclass, fields
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from vllm.v1.attention.backends import gdn_recoverssm as gdn_mod
+from vllm.v1.attention.backends.gdn_recoverssm import (
+    GDNRecoverSSMCommitMetadata,
+    GDNRecoverSSMMetadata,
+)
+from vllm.v1.attention.backends.ple_recoverssm import (
+    PleRecoverSSMCommitMetadata,
+    PleRecoverSSMMetadata,
+)
+from vllm.v1.worker.gpu import pp_utils as pp_utils_mod
+from vllm.v1.worker.gpu.model_states.recoverssm import RecoverSSMState
+
+MAX_REQS = 8
+SPEC_LEN = 4  # 1 + K, K = 3 (prod)
+
+
+class _RecordingContext:
+    """Stands in for GDNRecoverSSMCommitContext: records what each commit
+    reads, at commit time (clones, like the kernels reading device memory)."""
+
+    def __init__(self) -> None:
+        self.commits: list[dict] = []
+
+    def commit(self, num_accepted_tokens, state_indices, query_start_loc, **kw):
+        req = kw.get("request_indices")
+        rows = (
+            list(range(state_indices.shape[0]))
+            if req is None
+            else [int(r) for r in req.tolist()]
+        )
+        self.commits.append(
+            dict(
+                state_indices=state_indices.tolist(),
+                query_start_loc=query_start_loc.tolist(),
+                num_accepted=[
+                    int(num_accepted_tokens[r])
+                    if r < num_accepted_tokens.shape[0]
+                    else None
+                    for r in rows
+                ],
+                block_table=None
+                if kw.get("block_table") is None
+                else kw["block_table"].clone(),
+            )
+        )
+
+
+class _Buffers:
+    """The builder's persistent, graph-staged buffers (one set per builder)."""
+
+    def __init__(self) -> None:
+        self.spec_state_indices = torch.full((MAX_REQS, SPEC_LEN), -1, dtype=torch.int32)
+        self.spec_query_start_loc = torch.zeros(MAX_REQS + 1, dtype=torch.int32)
+        self.block_table = torch.zeros(MAX_REQS, 6, dtype=torch.int32)
+
+
+def _gdn_meta(buf: _Buffers, slots, ctx, *, align=False) -> GDNRecoverSSMMetadata:
+    """Build step metadata the way GDNRecoverSSMMetadataBuilder.build does: the
+    commit points at views of the persistent buffers, written in place."""
+    n = len(slots)
+    buf.spec_state_indices[:n, 0] = torch.tensor(slots, dtype=torch.int32)
+    buf.spec_query_start_loc[: n + 1] = torch.arange(
+        0, (n + 1) * SPEC_LEN, SPEC_LEN, dtype=torch.int32
+    )
+    for i, s in enumerate(slots):
+        buf.block_table[i] = s * 10 + torch.arange(6, dtype=torch.int32)
+    commit = GDNRecoverSSMCommitMetadata(
+        state_indices=buf.spec_state_indices[:, :1],
+        query_start_loc=buf.spec_query_start_loc,
+        request_indices=None,
+        block_table=buf.block_table[:n] if align else None,
+        num_computed_tokens=torch.full((n,), 100, dtype=torch.int32)
+        if align
+        else None,
+        block_size=64 if align else None,
+    )
+    required = dict(
+        num_prefills=0,
+        num_prefill_tokens=0,
+        num_decodes=0,
+        num_decode_tokens=0,
+        num_spec_decodes=n,
+        num_spec_decode_tokens=n * SPEC_LEN,
+        num_actual_tokens=n * SPEC_LEN,
+    )
+    kwargs = {
+        f.name: required.get(f.name)
+        for f in fields(GDNRecoverSSMMetadata)
+        if f.init and f.name not in ("recoverssm_commit", "recoverssm_context")
+    }
+    return GDNRecoverSSMMetadata(
+        **kwargs, recoverssm_commit=commit, recoverssm_context=ctx
+    )
+
+
+def _record(state: RecoverSSMState, meta) -> None:
+    group = SimpleNamespace(layer_names=["model.layers.0.linear_attn"])
+    state.record_step(
+        {"model.layers.0.linear_attn": meta}, [[group]], for_capture=False
+    )
+
+
+def _handler() -> pp_utils_mod.PPHandler:
+    h = object.__new__(pp_utils_mod.PPHandler)
+    h.is_last_rank = False
+    h.device = torch.device("cpu")
+    h.main_stream = SimpleNamespace(wait_event=lambda event: None)
+    h.req_idx_gen_np = np.zeros(MAX_REQS, dtype=np.int32)
+    h.queue = deque([None, None])  # pp_size = 2, pre-seeded like __init__
+    return h
+
+
+def _receive(h: pp_utils_mod.PPHandler, idx_mapping, num_sampled) -> None:
+    """What PPHandler.receive leaves in the queue (minus the NCCL broadcast)."""
+    idx_np = np.asarray(idx_mapping, dtype=np.int64)
+    n = len(idx_mapping)
+    h.queue[-1] = pp_utils_mod.PendingRecv(
+        event=object(),
+        sampled_tokens=torch.zeros(n, SPEC_LEN, dtype=torch.int64),
+        num_sampled=torch.tensor(num_sampled, dtype=torch.int32),
+        num_rejected=torch.zeros(n, dtype=torch.int32),
+        idx_mapping=torch.tensor(idx_mapping, dtype=torch.int32),
+        idx_mapping_np=idx_np,
+        need_sampled_mask=np.ones(n, dtype=bool),
+        gen_at_receive_np=h.req_idx_gen_np[idx_np].copy(),
+    )
+
+
+@pytest.fixture
+def h2d(monkeypatch):
+    monkeypatch.setattr(
+        pp_utils_mod,
+        "async_tensor_h2d",
+        lambda a, device=None, dtype=None, out=None: torch.as_tensor(
+            np.asarray(a), dtype=torch.int32
+        ),
+    )
+
+
+def _run_two_microbatches(mode: str, *, free_slot: int | None = None):
+    """Non-last rank, pp_size 2: micro-batch A at step T (req slots 0, 1 with
+    state blocks 3, 5), micro-batch B at T+1 (req slots 2, 4, 6 with blocks 7,
+    9, 11), then step T+2 consumes A's broadcast. Returns the commit A got.
+
+    mode: "fork" (detach/attach/restore), "upstream" (#58863 single slot) or
+    "alias" (fork flow, but the snapshot aliases the persistent buffers)."""
+    ctx = _RecordingContext()
+    buf = _Buffers()  # one builder: both micro-batches share its buffers
+    state = RecoverSSMState()
+    h = _handler()
+
+    def sample_tokens(idx_mapping, num_sampled):
+        _receive(h, idx_mapping, num_sampled)
+        if mode != "upstream":
+            h.attach_deferred_state(state.detach_step())
+
+    # step T: micro-batch A (execute_model first consumes a pre-seeded None)
+    assert h.get_prev_sampled_outputs() is None
+    _record(state, _gdn_meta(buf, [3, 5], ctx))
+    sample_tokens([0, 1], [2, 4])
+    # step T+1: micro-batch B; its build overwrites the builder's buffers
+    assert h.get_prev_sampled_outputs() is None
+    _record(state, _gdn_meta(buf, [7, 9, 11], ctx))
+    sample_tokens([2, 4, 6], [1, 1, 1])
+    if free_slot is not None:
+        h.on_req_idx_freed(free_slot)  # A's request freed before T+2
+    # step T+2: update_pp_decode_requests consumes A's entry
+    out = h.get_prev_sampled_outputs()
+    assert out is not None
+    deferred = out.pop("deferred_state")
+    if mode != "upstream":
+        state.restore_step(deferred)
+    state.commit_step(
+        out["num_sampled"],
+        out["idx_mapping"],
+        state_indices=None,
+        num_accepted_tokens=torch.ones(MAX_REQS, dtype=torch.int32),
+    )
+    assert ctx.commits, "no commit ran"
+    return ctx.commits[-1]
+
+
+A_COMMIT = dict(state_indices=[3, 5], num_accepted=[2, 4])
+
+
+def test_deferred_commit_commits_its_own_step(h2d):
+    got = _run_two_microbatches("fork")
+    assert got["state_indices"] == A_COMMIT["state_indices"]
+    assert got["num_accepted"] == A_COMMIT["num_accepted"]
+    assert got["query_start_loc"] == [0, 4, 8]
+
+
+def test_control_upstream_single_slot_commits_the_wrong_step(h2d):
+    # #58863 as-is under PP: step T's counts land on micro-batch B's blocks.
+    got = _run_two_microbatches("upstream")
+    assert got["state_indices"] != A_COMMIT["state_indices"]
+    assert got["state_indices"] == [7, 9, 11]
+
+
+def test_control_aliasing_snapshot_commits_the_wrong_blocks(h2d, monkeypatch):
+    # Detaching without cloning keeps views of the builder's persistent
+    # buffers: the next micro-batch's build rewrites them before the commit.
+    monkeypatch.setattr(
+        GDNRecoverSSMMetadata, "snapshot_for_deferred_commit", lambda self: self
+    )
+    got = _run_two_microbatches("alias")
+    assert got["state_indices"] != A_COMMIT["state_indices"]
+
+
+def test_freed_row_commits_nothing(h2d):
+    # Request slot 1 (block 5) freed between verify and commit: count 0 makes
+    # the commit plan skip it (commit_len 0), slot 0 still commits.
+    got = _run_two_microbatches("fork", free_slot=1)
+    assert got["state_indices"] == A_COMMIT["state_indices"]
+    assert got["num_accepted"] == [2, 0]
+
+
+def test_control_unmasked_deferred_commit_writes_a_freed_slot(h2d, monkeypatch):
+    real = RecoverSSMState.restore_step
+
+    def restore_without_mask(self, deferred):
+        real(self, deferred)
+        self._step_is_deferred = False  # what a commit without the mask sees
+
+    monkeypatch.setattr(RecoverSSMState, "restore_step", restore_without_mask)
+    got = _run_two_microbatches("fork", free_slot=1)
+    assert got["num_accepted"] == [2, 4]  # block 5 would be written
+
+
+def test_snapshot_clones_every_commit_input_gdn_align():
+    ctx = _RecordingContext()
+    buf = _Buffers()
+    meta = _gdn_meta(buf, [3, 5], ctx, align=True)
+    snap = meta.snapshot_for_deferred_commit()
+    before = (
+        snap.recoverssm_commit.state_indices.clone(),
+        snap.recoverssm_commit.query_start_loc.clone(),
+        snap.recoverssm_commit.block_table.clone(),
+    )
+    _gdn_meta(buf, [7, 9], ctx, align=True)  # next build rewrites the buffers
+    c = snap.recoverssm_commit
+    assert torch.equal(c.state_indices, before[0])
+    assert torch.equal(c.query_start_loc, before[1])
+    assert torch.equal(c.block_table, before[2])
+    # control: the live metadata's views did change
+    assert not torch.equal(meta.recoverssm_commit.state_indices[:2], before[0])
+    assert not torch.equal(meta.recoverssm_commit.block_table, before[2])
+    for t in (c.state_indices, c.query_start_loc, c.block_table):
+        assert all(t.data_ptr() != b.data_ptr() for b in vars(buf).values())
+
+
+def test_snapshot_ple():
+    sidx = torch.tensor([3, 5, -1, -1], dtype=torch.int32)
+    qsl = torch.tensor([0, 4, 8, 8, 8], dtype=torch.int32)
+    commit = PleRecoverSSMCommitMetadata(
+        state_indices=sidx,
+        query_start_loc=qsl,
+        request_indices=None,
+        block_table=None,
+        num_computed_tokens=None,
+        block_size=None,
+    )
+    names = [
+        f.name
+        for f in fields(PleRecoverSSMMetadata)
+        if f.init and f.name not in ("recoverssm_commit", "recoverssm_context")
+    ]
+    meta = PleRecoverSSMMetadata(
+        **{n: None for n in names},
+        recoverssm_commit=commit,
+        recoverssm_context=_RecordingContext(),
+    )
+    meta.num_spec_decodes = 2
+    snap = meta.snapshot_for_deferred_commit()
+    sidx.fill_(9)
+    qsl.fill_(0)
+    assert snap.recoverssm_commit.state_indices.tolist() == [3, 5]
+    assert snap.recoverssm_commit.query_start_loc.tolist() == [0, 4, 8]
+
+
+def test_attach_without_a_pending_entry_raises():
+    h = _handler()
+    h.queue[-1] = None  # receive() skipped the broadcast for this step
+    with pytest.raises(RuntimeError, match="without sampled outputs"):
+        h.attach_deferred_state(object())
+    h.attach_deferred_state(None)  # nothing to keep: fine
+
+
+def test_restored_step_without_counts_raises():
+    state = RecoverSSMState()
+    ctx = _RecordingContext()
+    _record(state, _gdn_meta(_Buffers(), [3], ctx))
+    state.restore_step(state.detach_step())
+    with pytest.raises(RuntimeError, match="without sampled counts"):
+        state.commit_step(
+            0, torch.zeros(1, dtype=torch.int32), state_indices=None,
+            num_accepted_tokens=torch.ones(1, dtype=torch.int32),
+        )
+
+
+def test_detach_of_a_step_without_spec_rows_is_none():
+    state = RecoverSSMState()
+    meta = _gdn_meta(_Buffers(), [3], _RecordingContext())
+    meta.recoverssm_commit = None
+    _record(state, meta)
+    assert state.detach_step() is None
+
+
+@dataclass
+class _Holder:
+    kv: torch.Tensor
+
+
+def test_teardown_drops_the_deferred_states_and_their_kv_cache():
+    """Profiling-state leak guard (the ~26 GiB on H200 class, #58863 commit 4):
+    a deferred step on a pending PP entry references the KV cache through its
+    commit context; the teardown must release it."""
+    h = _handler()
+    kv = torch.zeros(1024)
+    ref = weakref.ref(kv)
+    _receive(h, [0], [1])
+    h.attach_deferred_state(_Holder(kv))
+    del kv
+    gc.collect()
+    assert ref() is not None  # control: held by the pending entry
+    assert h.drop_deferred_states() == 1
+    gc.collect()
+    assert ref() is None
+    assert h.queue[-1] is not None  # the sampled-token entry itself stays
+
+
+def test_teardown_calls_the_pp_purge():
+    from vllm.v1.worker.gpu import cudagraph_utils
+
+    src = inspect.getsource(cudagraph_utils._teardown_profiling_state)
+    assert "drop_deferred_states()" in src
+    assert "recoverssm.reset()" in src
+
+
+def test_context_binding_guard():
+    good = torch.zeros(4)
+    ctx = SimpleNamespace(checkpoints=(good,))
+    gdn_mod._check_context_binding(ctx, [good])
+    with pytest.raises(RuntimeError, match="stale context"):
+        gdn_mod._check_context_binding(ctx, [torch.zeros(4)])
+
+
+def _calls_in(fn) -> list[str]:
+    tree = ast.parse(textwrap.dedent(inspect.getsource(fn)))
+    names = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+            names.append((node.lineno, node.col_offset, node.func.attr))
+    return [n for _, _, n in sorted(names)]
+
+
+def test_runner_wiring_order():
+    """The runner detaches after receive() and before the immediate prefill-
+    chunk postprocess (which would otherwise drop the step), and restores
+    before the deferred postprocess."""
+    from vllm.v1.worker.gpu.model_runner import GPUModelRunner
+
+    calls = _calls_in(GPUModelRunner.sample_tokens)
+    i_recv = calls.index("receive")
+    i_attach = calls.index("attach_deferred_state")
+    i_detach = calls.index("detach_deferred_state")
+    i_post = calls.index("postprocess_state")
+    assert i_recv < i_attach and i_recv < i_detach < i_post and i_attach < i_post
+
+    calls = _calls_in(GPUModelRunner.update_pp_decode_requests)
