+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The RecoverSSM pipeline-parallel lift at the config level.
+
+Upstream (#58863) rejects RecoverSSM for pipeline_parallel_size > 1. The fork
+lifts that for Qwen4Exp GDN/PLE on Model Runner V2, where non-last PP ranks
+defer the commit with a snapshot of its inputs. Kimi-K3 KDA keeps the PP=1
+check (its metadata has no snapshot), and Model Runner V1 has no deferral.
+
+Failing control: on the unlifted port (upstream check), test_pp2_qwen4exp_v2_*
+raises "RecoverSSM currently requires pipeline_parallel_size=1".
+"""
+
+import pytest
+
+from tests.config.test_recoverssm_config import _config, _validator
+
+TARGET = "Qwen4ExpForConditionalGeneration"
+
+
+@pytest.mark.parametrize("pp", [2, 4])
+@pytest.mark.parametrize(
+    "arch", ["Qwen4ExpForConditionalGeneration", "Qwen4ExpForCausalLM", "Qwen4ExpMTP"]
+)
+def test_pp2_qwen4exp_v2_is_accepted(arch, pp):
+    cfg = _config(arch, parallel_config__pipeline_parallel_size=pp)
+    _validator()(cfg)
+    assert cfg.cache_config.use_recoverssm is True
+
+
+def test_pp2_kda_keeps_the_pp1_requirement():
+    cfg = _config(
+        "KimiK3ForConditionalGeneration", parallel_config__pipeline_parallel_size=2
+    )
+    with pytest.raises(ValueError, match="only for Qwen4Exp"):
+        _validator()(cfg)
+
+
+def test_pp2_v1_runner_is_rejected():
+    # none mode, so the align-mode V2 check does not fire first
+    cfg = _config(TARGET, parallel_config__pipeline_parallel_size=2)
+    cfg.cache_config.mamba_cache_mode = "none"
+    cfg.use_v2_model_runner = False
+    with pytest.raises(ValueError, match="pipeline_parallel_size > 1 requires"):
+        _validator()(cfg)
+
+
+def test_pp2_still_runs_the_other_checks():
+    cfg = _config(
+        TARGET,
+        parallel_config__pipeline_parallel_size=2,
+        mamba_config__backend="flashinfer",
+    )
+    with pytest.raises(ValueError, match="mamba-backend triton"):
+        _validator()(cfg)
