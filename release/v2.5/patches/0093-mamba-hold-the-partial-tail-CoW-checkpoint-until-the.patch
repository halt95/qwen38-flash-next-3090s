+# ---------------------------------------------------------------------------
+# A partial-tail resume must leave its own tail checkpoint referenced
+# (the tail-CoW total miss, measured at --prefix-match-unit 64/256/512/1024).
+# ---------------------------------------------------------------------------
+TAIL_BLOCK = 32  # mamba block
+TAIL_HASH = 8  # prefix-match unit (full attention hashes at the unit)
+TAIL_SPEC = 3  # MTP K=3, as deployed
+TAIL_SWITCH = "VLLM_E2_MAMBA_RETAIN_CHECKPOINT"
+TAIL_ATTN = 0  # group ids
+TAIL_MAMBA = 1
+
+
+@pytest.fixture(params=["1", "0"], ids=["retain-on", "retain-off-control"])
+def tail_retain(request, monkeypatch) -> bool:
+    from vllm import envs
+
+    monkeypatch.setenv(TAIL_SWITCH, request.param)
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+    return request.param == "1"
+
+
+def _tail_manager(num_blocks: int, use_eagle: bool = True):
+    """Full attention at the hash unit + one align-mode Mamba group at the
+    block, eagle/MTP drop on, retention interval 0 (the deployed default)."""
+    kv_cache_config = KVCacheConfig(
+        num_blocks=num_blocks,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["full"],
+                FullAttentionSpec(
+                    block_size=TAIL_HASH,
+                    num_kv_heads=1,
+                    head_size=1,
+                    dtype=torch.float32,
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["mamba"],
+                MambaSpec(
+                    block_size=TAIL_BLOCK,
+                    shapes=(1, 1),
+                    dtypes=(torch.float32,),
+                    mamba_cache_mode="align",
+                    num_speculative_blocks=TAIL_SPEC,
+                ),
+            ),
+        ],
+    )
+    manager = make_kv_cache_manager(
+        kv_cache_config=kv_cache_config,
+        max_model_len=8192,
+        enable_caching=True,
+        hash_block_size=TAIL_HASH,
+        use_eagle=use_eagle,
+        retention_interval=0,
+    )
+    assert manager.coordinator.enable_partial_hash_hits
+    return manager
+
+
+def _tail_split(
+    request, num_new: int, num_local_hit: int = 0, use_eagle: bool = True
+) -> int:
+    """The real ``Scheduler._mamba_block_aligned_split`` on a stub self."""
+    stub = SimpleNamespace(
+        block_size=TAIL_BLOCK,
+        cache_config=SimpleNamespace(block_size=TAIL_BLOCK),
+        use_eagle_block_drop=use_eagle,
+        max_num_scheduled_tokens=8192,
+        scheduler_config=SimpleNamespace(long_prefill_token_threshold=0),
+        mamba_partial_cache_hit=True,
+        mamba_fine_grained_prefix_cache=False,
+        hash_block_size=TAIL_HASH,
+        mamba_has_prefill_checkpoint_blocks=False,
+        mamba_prefill_checkpoint_alignment=None,
+    )
+    return Scheduler._mamba_block_aligned_split(stub, request, num_new, num_local_hit)
+
+
+def _tail_drain_copies(manager) -> None:
+    """What the scheduler does once a step's CoW copies have run: release
+    both endpoints' copy retentions."""
+    _, retained = manager.take_kv_cache_block_copies()
+    manager.block_pool.free_blocks(retained)
+
+
+def _tail_prefill(manager, request) -> int:
+    """Prefill to the prompt end in the chunks the scheduler would cut
+    (block ends, the partial-tail stop); returns the admitted hit length."""
+    computed_blocks, num_hit, _ = manager.get_computed_blocks(request)
+    first = True
+    while request.num_computed_tokens < request.num_tokens:
+        start = request.num_computed_tokens + (num_hit if first else 0)
+        num_new = _tail_split(
+            request, request.num_tokens - start, num_hit if first else 0
+        )
+        assert num_new > 0
+        blocks = manager.allocate_slots(
+            request,
+            num_new,
+            num_new_computed_tokens=num_hit if first else 0,
+            new_computed_blocks=computed_blocks if first else None,
+            num_lookahead_tokens=TAIL_SPEC,
+        )
+        assert blocks is not None, "prefill chunk did not fit"
+        request.num_computed_tokens = start + num_new
+        manager.new_step_starts()
+        _tail_drain_copies(manager)
+        first = False
+    return num_hit
+
+
+def _tail_decode(manager, request, steps: int) -> None:
+    """MTP K=3 decode steps, no drafts accepted."""
+    next_tok = 50000 + len(request.output_token_ids)
+    if request.num_computed_tokens == request.num_tokens:
+        request.append_output_token_ids(next_tok)
+        next_tok += 1
+    for _ in range(steps):
+        assert request.num_computed_tokens == request.num_tokens - 1
+        request.spec_token_ids = [next_tok + i for i in range(TAIL_SPEC)]
+        blocks = manager.allocate_slots(
+            request, 1 + TAIL_SPEC, num_lookahead_tokens=TAIL_SPEC
+        )
+        assert blocks is not None, "decode step did not fit"
+        request.spec_token_ids = []
+        request.num_computed_tokens += 1
+        request.append_output_token_ids([next_tok])
+        next_tok += 1
+        manager.new_step_starts()
+        _tail_drain_copies(manager)
+
+
+def _tail_tokens(seed: int, n: int) -> list[int]:
+    return [seed * 10000 + i for i in range(n)]
+
+
+def _tail_position(num_prompt_tokens: int) -> int:
+    """Where the prompt's partial-tail state is keyed (eagle shifts it one
+    unit below the last hash boundary)."""
+    return num_prompt_tokens // TAIL_HASH * TAIL_HASH - TAIL_HASH
+
+
+def _tail_followup(prev, user_tokens: int, seed: int):
+    """The next turn: the previous turn's prompt + its output + new text,
+    sized so that its tail lands strictly inside a block above the last
+    cacheable block end (the deployed case; a block-aligned tail is a
+    full-block key, not a partial one)."""
+    while True:
+        prompt = len(prev.all_token_ids) + user_tokens
+        tail = _tail_position(prompt)
+        last_block_end = prompt - prompt % TAIL_BLOCK - TAIL_BLOCK
+        if tail % TAIL_BLOCK != 0 and last_block_end < tail:
+            break
+        user_tokens += 1
+    return make_request(
+        prev.request_id + "+",
+        list(prev.all_token_ids) + _tail_tokens(seed, user_tokens),
+        TAIL_HASH,
+        sha256,
+    )
+
+
+def _tail_mamba(manager):
+    return manager.coordinator.single_type_managers[TAIL_MAMBA]
+
+
+def _tail_free_ids(manager) -> set[int]:
+    return {b.block_id for b in manager.block_pool.free_block_queue.get_all_free_blocks()}
+
+
+def _tail_assert_pool_clean(manager, num_blocks: int) -> None:
+    pool = manager.block_pool
+    assert pool.get_num_free_blocks() == num_blocks - 1  # all but the null block
+    assert all(blk.ref_cnt == 0 for blk in pool.blocks[1:])
+    mamba = _tail_mamba(manager)
+    assert not mamba._retained_checkpoints
+    assert not mamba._partial_hit_reqs
+    assert not mamba.req_to_blocks
+
+
+def test_partial_tail_resume_next_turn_hits_after_concurrent_allocation(tail_retain):
+    """Behaviour only (the observed miss): A1 resumed at A0's partial
+    tail; while A1 decodes, concurrent prefills pop every free block; A1
+    finishes; A2 must resume at A1's tail. Before the fix A2's hit is 0 --
+    a total miss on a prompt whose whole attention prefix is still cached."""
+    manager = _tail_manager(96)
+    pool = manager.block_pool
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_prefill(manager, a0)
+    _tail_decode(manager, a0, steps=4)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+
+    a1 = _tail_followup(a0, 26, seed=2)
+    num_hit = _tail_prefill(manager, a1)
+    assert num_hit == _tail_position(a0.num_prompt_tokens)  # a partial tail
+    assert num_hit % TAIL_BLOCK != 0
+    _tail_decode(manager, a1, steps=4)
+    pool.free_blocks(pool.get_new_blocks(pool.get_num_free_blocks()))  # burst
+    manager.free(a1)
+    _tail_drain_copies(manager)
+
+    a2 = _tail_followup(a1, 20, seed=3)
+    _, num_hit, _ = manager.get_computed_blocks(a2)
+    assert all(
+        pool.get_cached_block(a1.block_hashes[i], [TAIL_ATTN])
+        for i in range(a1.num_prompt_tokens // TAIL_HASH)
+    )
+    assert num_hit == (_tail_position(a1.num_prompt_tokens) if tail_retain else 0)
+
+
+def test_partial_tail_resume_keeps_its_own_tail_under_concurrent_allocation(
+    tail_retain,
+):
+    """Turn 0 (A0) is a cold prefill; turn 1 (A1) resumes at A0's partial tail
+    (mid-block). A1 hashes no boundary state -- its replay boundary is below
+    its resume point -- so its own tail, moved into a CoW block by the chunk
+    after the tail stop, is the only GDN state its next turn can hit. Before
+    the fix the scheduler's post-copy release left that block at ref 0 in the
+    free queue while A1 still decoded; a concurrent prefill popped it and the
+    next turn (A2) got a TOTAL miss although every attention block of A1 was
+    still cached. With retention on, A1 holds the moved tail until it is
+    freed and A2 resumes at it. ``retain-off-control`` is the old behaviour
+    (and v2.5.0 fails the retain-on case the same way).
+    """
+    num_blocks = 96
+    manager = _tail_manager(num_blocks)
+    pool = manager.block_pool
+    mamba = _tail_mamba(manager)
+
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    assert _tail_prefill(manager, a0) == 0
+    _tail_decode(manager, a0, steps=4)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+
+    # A1 resumes at A0's tail: a sub-block hit, so its first chunk copies the
+    # hit state into a private block (CoW).
+    a1 = _tail_followup(a0, 26, seed=2)
+    a1_tail = _tail_position(a1.num_prompt_tokens)
+    num_hit = _tail_prefill(manager, a1)
+    assert num_hit == _tail_position(a0.num_prompt_tokens)
+    assert num_hit % TAIL_BLOCK != 0
+    [tail_block] = pool.get_cached_block(
+        a1.block_hashes[a1_tail // TAIL_HASH - 1], [TAIL_MAMBA]
+    )
+    # The tail state was moved out of A1's table into the CoW block, and A1
+    # keyed no full-block boundary state of its own.
+    assert tail_block not in mamba.req_to_blocks.get(a1.request_id, [])
+    assert tail_block.block_hash_num_tokens == a1_tail
+    for position in range(TAIL_BLOCK, a1_tail, TAIL_BLOCK):
+        if position > num_hit:
+            assert (
+                pool.get_cached_block(
+                    a1.block_hashes[position // TAIL_HASH - 1], [TAIL_MAMBA]
+                )
+                is None
+            )
+    _tail_decode(manager, a1, steps=4)
+
+    if tail_retain:
+        assert mamba._retained_checkpoints[a1.request_id] == (a1_tail, tail_block)
+        assert tail_block.ref_cnt == 1
+        assert tail_block.block_id not in _tail_free_ids(manager)
+    else:
+        # The exposure: cached-free while A1 still runs.
+        assert tail_block.ref_cnt == 0 and tail_block.block_hash is not None
+        assert tail_block.block_id in _tail_free_ids(manager)
+
+    # A burst of concurrent prefills pops every free block while A1 decodes.
+    taken = pool.get_new_blocks(pool.get_num_free_blocks())
+    assert (tail_block.block_hash is not None) is tail_retain
+    pool.free_blocks(taken)
+
+    # A1 finishes; its next turn arrives.
+    manager.free(a1)
+    _tail_drain_copies(manager)
+    a2 = _tail_followup(a1, 20, seed=3)
+    _, num_hit, _ = manager.get_computed_blocks(a2)
+    # Every attention block of A1's prompt is still cached in both worlds.
+    assert all(
+        pool.get_cached_block(a1.block_hashes[i], [TAIL_ATTN])
+        for i in range(a1.num_prompt_tokens // TAIL_HASH)
+    )
+    if tail_retain:
+        assert num_hit == a1_tail
+    else:
+        # FAILING CONTROL: total miss with the whole attention prefix cached.
+        assert num_hit == 0
+
+    # The next turn runs to completion on what it got; nothing leaks.
+    _tail_prefill(manager, a2)
+    _tail_decode(manager, a2, steps=2)
+    manager.free(a2)
+    _tail_drain_copies(manager)
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_partial_tail_hit_admission_reserves_the_tail_swap(tail_retain):
+    """Full-sequence admission of a partial-tail follow-up reserves one block
+    per Mamba group above the per-step estimate (the held hit source and the
+    moved tail coexist for the swap); a block-aligned follow-up reserves none.
+    """
+    num_blocks = 96
+    manager = _tail_manager(num_blocks)
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_prefill(manager, a0)
+    _tail_decode(manager, a0, steps=2)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+
+    a1 = _tail_followup(a0, 26, seed=2)
+    computed, num_hit, _ = manager.get_computed_blocks(a1)
+    assert num_hit % TAIL_BLOCK != 0
+
+    def need(apply_admission_cap: bool) -> int:
+        return manager.coordinator.get_num_blocks_to_allocate(
+            request_id=a1.request_id,
+            num_tokens=a1.num_tokens,
+            new_computed_blocks=computed.blocks,
+            num_encoder_tokens=0,
+            total_computed_tokens=num_hit,
+            num_local_computed_tokens=num_hit,
+            num_tokens_main_model=a1.num_tokens,
+            apply_admission_cap=apply_admission_cap,
+        )
+
+    assert need(True) == need(False) + (1 if tail_retain else 0)
+
+
+@pytest.mark.parametrize("deferred", [False, True], ids=["free", "pop_blocks_for_free"])
+@pytest.mark.parametrize("stop_at", ["after-hit-copy", "after-tail-copy"])
+def test_partial_tail_resume_freed_with_queued_copy_leaks_nothing(
+    tail_retain, deferred, stop_at
+):
+    """A request that resumed at a partial tail is freed (finish, abort or
+    preemption) while its CoW copy is still queued -- before the scheduler
+    has released the copy retentions. Whatever order the retentions and the
+    request's hold are released in, every block ends at ref 0 and the pool
+    returns to baseline; the superseded hit source ages instead of leaking.
+    """
+    num_blocks = 96
+    manager = _tail_manager(num_blocks)
+    pool = manager.block_pool
+    mamba = _tail_mamba(manager)
+
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_prefill(manager, a0)
+    _tail_decode(manager, a0, steps=2)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+
+    a1 = _tail_followup(a0, 26, seed=2)
+    a1_tail = _tail_position(a1.num_prompt_tokens)
+    computed_blocks, num_hit, _ = manager.get_computed_blocks(a1)
+    assert 0 < num_hit < a1_tail and num_hit % TAIL_BLOCK != 0
+    [source] = pool.get_cached_block(
+        a0.block_hashes[num_hit // TAIL_HASH - 1], [TAIL_MAMBA]
+    )
+    assert source.ref_cnt == 0
+
+    # First chunk: the hit source is copied into A1's private block.
+    num_new = _tail_split(a1, a1.num_tokens - num_hit, num_hit)
+    assert manager.allocate_slots(
+        a1, num_new, num_hit, computed_blocks, num_lookahead_tokens=TAIL_SPEC
+    )
+    a1.num_computed_tokens = num_hit + num_new
+    manager.new_step_starts()
+    if tail_retain:
+        assert mamba._retained_checkpoints[a1.request_id] == (num_hit, source)
+    if stop_at == "after-tail-copy":
+        _tail_drain_copies(manager)
+        # Run to the chunk that moves A1's own tail into a CoW block.
+        while a1.num_computed_tokens <= a1_tail:
+            num_new = _tail_split(a1, a1.num_tokens - a1.num_computed_tokens)
+            assert manager.allocate_slots(a1, num_new, num_lookahead_tokens=TAIL_SPEC)
+            a1.num_computed_tokens += num_new
+            manager.new_step_starts()
+            if a1.num_computed_tokens <= a1_tail:
+                _tail_drain_copies(manager)
+        [tail_block] = pool.get_cached_block(
+            a1.block_hashes[a1_tail // TAIL_HASH - 1], [TAIL_MAMBA]
+        )
+        if tail_retain:
+            assert mamba._retained_checkpoints[a1.request_id] == (a1_tail, tail_block)
+            assert source.ref_cnt == 0  # superseded: ages, not leaked
+            assert source.block_hash is not None
+
+    # Freed with the copy still queued.
+    if deferred:
+        pool.free_blocks(manager.pop_blocks_for_free(a1))
+    else:
+        manager.free(a1)
+    assert a1.request_id not in mamba._retained_checkpoints
+    assert all(blk.ref_cnt >= 0 for blk in pool.blocks[1:])
+    # The copy's retentions are released afterwards.
+    _tail_drain_copies(manager)
+    assert source.ref_cnt == 0
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_consumer_hold_follows_the_producers_moved_tail(tail_retain):
+    """Without the eagle drop a sibling can resume at a producer's tail while
+    that tail is still the producer's LIVE running block (published at the
+    tail stop, hit before the producer's next chunk). The consumer's hold
+    then pins the producer's block; when the producer's next chunk moves the
+    hashes into its CoW block, the hold must follow them -- it pins the
+    hashed state, never another request's running block -- and both
+    requests must still free cleanly.
+    """
+    num_blocks = 96
+    manager = _tail_manager(num_blocks, use_eagle=False)
+    pool = manager.block_pool
+    mamba = _tail_mamba(manager)
+
+    producer = make_request("P", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    tail = producer.num_prompt_tokens // TAIL_HASH * TAIL_HASH  # 144, no shift
+    computed, num_hit, _ = manager.get_computed_blocks(producer)
+    while producer.num_computed_tokens < tail:
+        # The real split gets the whole remainder and stops at the tail.
+        num_new = _tail_split(
+            producer, producer.num_tokens - producer.num_computed_tokens, use_eagle=False
+        )
+        assert producer.num_computed_tokens + num_new <= tail
+        assert manager.allocate_slots(
+            producer,
+            num_new,
+            num_new_computed_tokens=num_hit,
+            new_computed_blocks=computed,
+            num_lookahead_tokens=TAIL_SPEC,
+        )
+        producer.num_computed_tokens += num_new
+        computed, num_hit = None, 0
+        manager.new_step_starts()
+        _tail_drain_copies(manager)
+    [live] = pool.get_cached_block(
+        producer.block_hashes[tail // TAIL_HASH - 1], [TAIL_MAMBA]
+    )
+    assert live in mamba.req_to_blocks["P"]  # the tail is keyed on the live block
+
+    consumer = make_request(
+        "C", list(producer.prompt_token_ids) + _tail_tokens(2, 30), TAIL_HASH, sha256
+    )
+    c_computed, c_hit, _ = manager.get_computed_blocks(consumer)
+    assert c_hit == tail
+    num_new = _tail_split(
+        consumer, consumer.num_tokens - c_hit, c_hit, use_eagle=False
+    )
+    assert manager.allocate_slots(
+        consumer, num_new, c_hit, c_computed, num_lookahead_tokens=TAIL_SPEC
+    )
+    consumer.num_computed_tokens = c_hit + num_new
+    if tail_retain:
+        assert mamba._retained_checkpoints["C"] == (tail, live)
+
