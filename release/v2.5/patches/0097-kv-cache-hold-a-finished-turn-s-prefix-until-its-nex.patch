+def _check_pool_invariants(scheduler) -> None:
+    """Every block's refs are accounted for by a table, a deferred free, a
+    waiter pin or a grace; a referenced block is never in the free queue;
+    every ref-0 block is in it; nothing is pinned twice by one holder."""
+    manager = scheduler.kv_cache_manager
+    pool = manager.block_pool
+    expected: dict[int, int] = {}
+    holders = [
+        blocks
+        for group in manager.coordinator.single_type_managers
+        for blocks in group.req_to_blocks.values()
+    ]
+    holders += [blocks for _, blocks in scheduler.deferred_frees]
+    holders += list(manager._pinned_hits.values())
+    holders += list(manager._grace_pins.values())
+    for blocks in holders:
+        seen: set[int] = set()
+        for block in blocks:
+            if block.is_null:
+                continue
+            assert block.block_id not in seen, f"block {block.block_id} held twice"
+            seen.add(block.block_id)
+            expected[block.block_id] = expected.get(block.block_id, 0) + 1
+    free_ids = _free_block_ids(manager)
+    num_ref0 = 0
+    for block in pool.blocks:
+        if block.is_null:
+            continue
+        assert block.ref_cnt == expected.get(block.block_id, 0), (
+            f"block {block.block_id}: ref {block.ref_cnt}, "
+            f"holders {expected.get(block.block_id, 0)}"
+        )
+        if block.ref_cnt == 0:
+            num_ref0 += 1
+            assert block.block_id in free_ids, f"block {block.block_id} leaked"
+        else:
+            assert block.block_id not in free_ids, f"block {block.block_id} in queue"
+    assert num_ref0 == pool.get_num_free_blocks() == len(free_ids)
+
+
+def test_scheduler_random_mix_keeps_pool_invariants_and_progress():
+    """Seeded random request mixes on small pools (fresh, shared-prefix,
+    follow-up and exact-fit prompts, aborts, finishes, the EAGLE drop on or
+    off). After every step the pool accounting closes, and a head waiter
+    that fits an idle pool is admitted within three passes."""
+    import random
+
+    from vllm.v1.request import RequestStatus
+
+    for seed in range(200):
+        rng = random.Random(seed)
+        num_blocks = rng.randint(16, 40)
+        usable = num_blocks - 1
+        scheduler = _grace_scheduler(num_blocks=num_blocks)
+        manager = scheduler.kv_cache_manager
+        pool = manager.block_pool
+        if rng.random() < 0.7:
+            manager.coordinator.eagle_group_ids = {0}
+        prompts: list[list[int]] = []  # every prompt seen, for prefixes
+        finished_prompts: list[list[int]] = []  # with their outputs
+        live: dict[str, object] = {}
+        next_id = 0
+        stuck = 0
+        for _ in range(80):
+            if len(live) < 4 and rng.random() < 0.6:
+                kind = rng.choice(["fresh", "prefix", "follow", "exact", "exact"])
+                max_tokens = rng.randint(1, 6)
+                if kind == "fresh" or not prompts:
+                    n = rng.randint(1, max(1, usable * 16 - max_tokens))
+                    tokens = [rng.randint(1, 50000) for _ in range(n)]
+                elif kind == "prefix":
+                    base = rng.choice(prompts)
+                    cut = rng.randint(1, len(base))
+                    tokens = base[:cut] + [
+                        rng.randint(1, 50000) for _ in range(rng.randint(1, 48))
+                    ]
+                elif kind == "follow" and finished_prompts:
+                    tokens = rng.choice(finished_prompts) + [
+                        rng.randint(1, 50000) for _ in range(rng.randint(1, 64))
+                    ]
+                else:  # exact: a cached prompt extended to fill the pool
+                    base = rng.choice(finished_prompts or prompts)
+                    max_tokens = 1
+                    room = usable * 16 - 1 - len(base)
+                    tokens = base + [rng.randint(1, 50000) for _ in range(max(room, 1))]
+                limit = usable * 16 - max_tokens
+                if len(tokens) > limit:
+                    tokens = tokens[:limit]
+                if not tokens:
+                    continue
+                req = _sched_request(f"q{seed}-{next_id}", tokens, max_tokens)
+                next_id += 1
+                prompts.append(list(tokens))
+                scheduler.add_request(req)
+                live[req.request_id] = req
+            if live and rng.random() < 0.08:
+                victim = rng.choice(list(live))
+                scheduler.finish_requests(victim, RequestStatus.FINISHED_ABORTED)
+            idle_head = not scheduler.running and len(scheduler.waiting) > 0
+            head = scheduler.waiting.peek_request() if idle_head else None
+            out = _sched_step(scheduler)
+            _check_pool_invariants(scheduler)
+            if head is not None:
+                need = -(-(head.num_prompt_tokens + head.max_tokens) // 16)
+                if need <= usable and head.request_id not in out.num_scheduled_tokens:
+                    stuck += 1
+                    assert stuck < 3, (
+                        f"seed {seed}: head {head.request_id} ({need} blocks of "
+                        f"{usable}) not admitted on an idle pool: free "
+                        f"{pool.get_num_free_blocks()} own pin "
+                        f"{len(manager.pinned_hit_blocks(head.request_id))} "
+                        f"graces {manager.num_grace_pinned_blocks} shortfall "
+                        f"{manager.last_alloc_shortfall}"
+                    )
+                else:
+                    stuck = 0
+            for request_id, req in list(live.items()):
+                if req.is_finished():
+                    if req.num_output_tokens > 0:
+                        finished_prompts.append(list(req.all_token_ids))
+                    del live[request_id]
+        for request_id in list(live):
+            scheduler.finish_requests(request_id, RequestStatus.FINISHED_ABORTED)
+        _sched_step(scheduler)
+        manager.yield_pinned_hits()
+        _check_pool_invariants(scheduler)
+        assert pool.get_num_free_blocks() == usable, f"seed {seed}: leak"
+
+
+def test_scheduler_follow_up_is_admitted_on_the_grace_and_takes_it_over():
+    """A's next turn is admitted on A's grace and takes it over (no double
+    ref). A new conversation that only shares the system prompt with the
+    finished turns A and B releases neither grace."""
+    scheduler = _grace_scheduler(num_blocks=32)
+    manager = scheduler.kv_cache_manager
+    pool = manager.block_pool
+    system = list(range(500, 532))  # 2 shared blocks
+    a = _sched_request("A", system + list(range(1000, 1048)), max_tokens=2)
+    _sched_finish(scheduler, a)
+    b = _sched_request("B", system + list(range(2000, 2048)), max_tokens=2)
+    _sched_finish(scheduler, b)  # B's admission on the system blocks keeps A's
+    grace = manager.grace_pinned_blocks("A")
+    assert len(grace) == 5 and len(manager.grace_pinned_blocks("B")) == 5
+
+    c = _sched_request("C", system + list(range(3000, 3040)), max_tokens=2)
+    scheduler.add_request(c)
+    out = _sched_step(scheduler)
+    assert out.num_scheduled_tokens["C"] == c.num_prompt_tokens - 32  # system hit
+    assert set(manager._grace_pins) == {"A", "B"}
+
+    a2 = _sched_request("A2", list(a.all_token_ids) + list(range(4000, 4030)), 2)
+    scheduler.add_request(a2)
+    out = _sched_step(scheduler)
+    assert out.num_scheduled_tokens["A2"] == a2.num_prompt_tokens - 80  # hit 80
+    assert "A" not in manager._grace_pins and "B" in manager._grace_pins
+    shared = {id(blk) for blk in manager.grace_pinned_blocks("B")}
+    for blk in grace:  # A2's table (+ C's table or grace, B's grace: system)
+        assert blk.ref_cnt == 1 + 2 * (id(blk) in shared)
+    while not (a2.is_finished() and c.is_finished()):
+        _sched_step(scheduler)
+    manager.yield_pinned_hits()
+    assert pool.get_num_free_blocks() == 31
