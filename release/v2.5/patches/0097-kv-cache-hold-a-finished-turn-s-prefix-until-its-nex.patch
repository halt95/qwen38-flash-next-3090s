+# ---------------------------------------------------------------------------
+# A finished turn's hashed blocks stay referenced ("grace") until the
+# conversation's next turn is admitted on them.
+# ---------------------------------------------------------------------------
+def _graces(manager) -> dict:
+    return getattr(manager, "_grace_pins", {})
+
+
+def _finish(request, status=None) -> None:
+    from vllm.v1.request import RequestStatus
+
+    request.status = status or RequestStatus.FINISHED_STOPPED
+
+
+def _finish_and_free(manager, request, path: str = "immediate", status=None):
+    """The scheduler's _free_request_blocks for a finished turn: free now, or
+    (a step still in flight) pop now and free the list at the fence."""
+    _finish(request, status)
+    if path == "immediate":
+        manager.free(request)
+    else:
+        deferred = manager.pop_blocks_for_free(request)
+        grace = _graces(manager).get(request.request_id, [])
+        assert all(b.ref_cnt >= 2 for b in grace)  # the table's + the grace's
+        manager.block_pool.free_blocks(deferred)  # the fence drains
+    _tail_drain_copies(manager)
+
+
+def _table_and_hold(manager, request) -> list:
+    blocks = [b for g in manager.get_blocks(request.request_id).blocks for b in g]
+    held = _tail_mamba(manager)._retained_checkpoints.get(request.request_id)
+    if held is not None:
+        blocks.append(held[1])
+    return [b for b in blocks if not b.is_null]
+
+
+@pytest.mark.parametrize("free_path", ["immediate", "deferred"])
+def test_finished_turn_keeps_its_prefix_through_the_arrival_gap(
+    tail_retain, free_path
+):
+    """The residual miss at a fine prefix unit: a conversation's turn A1
+    has finished and its next turn A2 has not been looked up yet. Meanwhile
+    another conversation's follow-up B1 is admitted, which frees blocks that
+    are dead from then on (B0's CoW source, superseded states) -- AFTER A1's
+    prefix -- and the running set then consumes about that many blocks. LRU
+    (without the grace) consumes A1's older prefix first, its top attention block
+    first, while the dead blocks survive: A2 is a total miss. With the grace
+    A1's hashed blocks stay referenced, the dead blocks go, A2 resumes at
+    A1's tail, and A2's admission hands the grace over (no double ref)."""
+    num_blocks = 64
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    _finish_and_free(manager, a0, free_path)
+    a1 = _tail_followup(a0, 26, seed=3)
+    _tail_run(manager, a1)
+    a1_ids = {id(b) for b in _table_and_hold(manager, a1) if b.block_hash is not None}
+    _finish_and_free(manager, a1, free_path)
+    a1_tail = _tail_position(a1.num_prompt_tokens)
+
+    b0 = make_request("B0", _tail_tokens(2, 150), TAIL_HASH, sha256)
+    _tail_run(manager, b0)
+    _finish_and_free(manager, b0, free_path)
+    b1 = _tail_followup(b0, 26, seed=5)
+    _tail_run(manager, b1)  # B1 stays running
+
+    # The running set consumes as many blocks as are free besides A1's.
+    free_now = pool.free_block_queue.get_all_free_blocks()
+    dead = [b for b in free_now if id(b) not in a1_ids]
+    taken = pool.get_new_blocks(len(dead))
+
+    a2 = _tail_followup(a1, 20, seed=4)
+    _, num_hit, _ = manager.get_computed_blocks(a2)
+    if tail_retain:
+        assert num_hit == a1_tail
+    # (Retain off = the no-hold control: A1's tail state is a CoW copy
+    # nobody holds, so it is among the "dead" blocks and the hit drops.)
+    pool.free_blocks(taken)
+
+    # Admission hands the grace over: the table holds the hit, nothing else.
+    _tail_prefill(manager, a2)
+    if tail_retain:
+        assert a1.request_id not in _graces(manager)
+        attn = manager.coordinator.single_type_managers[TAIL_ATTN]
+        for block in attn.req_to_blocks[a2.request_id]:
+            if id(block) in a1_ids:
+                assert block.ref_cnt == 1
+    _tail_decode(manager, a2, steps=2)
+    _finish_and_free(manager, a2, free_path)
+    _finish_and_free(manager, b1, free_path)
+    assert {a2.request_id, b1.request_id} <= set(_graces(manager))
+    assert manager.yield_pinned_hits() > 0
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_grace_pins_yield_before_waiter_pins_oldest_first_and_are_bounded(
+    tail_retain,
+):
+    num_blocks = 192
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    finished = []
+    for i in range(3):
+        req = make_request(f"F{i}", _tail_tokens(10 + i, 150), TAIL_HASH, sha256)
+        _tail_run(manager, req)
+        _finish_and_free(manager, req)
+        finished.append(req)
+    assert list(_graces(manager)) == ["F0", "F1", "F2"]
+    for req in finished:
+        grace = manager.grace_pinned_blocks(req.request_id)
+        assert grace and all(b.block_hash is not None for b in grace)
+        assert all(b.ref_cnt == 1 for b in grace)
+
+    # A waiter pinned on F2's prefix: graces yield first, oldest first.
+    w = _tail_followup(finished[2], 20, seed=5)
+    assert manager.pin_waiting_hit(w) > 0
+    f0 = manager.grace_pinned_blocks("F0")
+    assert manager.yield_pinned_hits(limit=1) == len(f0)
+    assert all(b.ref_cnt == 0 for b in f0)  # back in the free queue
+    assert list(_graces(manager)) == ["F1", "F2"]
+    assert w.request_id in _pinned(manager)
+    assert manager.yield_pinned_hits(keep=w.request_id, limit=2) > 0
+    assert not _graces(manager) and w.request_id in _pinned(manager)
+    # The waiter's hit outlived F2's grace: its own pin holds it.
+    assert all(b.ref_cnt == 1 for b in _pinned(manager)[w.request_id])
+
+    # Bound: beyond MAX_GRACE_PINS the oldest grace goes.
+    for i in range(manager.MAX_GRACE_PINS + 2):
+        req = make_request(
+            f"G{i}", _tail_tokens(100 + i, 2 * TAIL_BLOCK + 9), TAIL_HASH, sha256
+        )
+        _tail_run(manager, req, decode_steps=1)
+        _finish_and_free(manager, req)
+    assert manager.num_grace_pins == manager.MAX_GRACE_PINS
+    assert list(_graces(manager))[0] == "G2"
+
+    # An aborted waiter (no output) takes no grace; reset releases all.
+    from vllm.v1.request import RequestStatus
+
+    _finish(w, RequestStatus.FINISHED_ABORTED)
+    manager.free(w)
+    assert w.request_id not in _graces(manager) and not _pinned(manager)
+    assert manager.reset_prefix_cache()
+    assert not _graces(manager) and not _pinned(manager)
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+@pytest.mark.parametrize("free_path", ["immediate", "deferred"])
+def test_grace_only_for_turns_that_finished_with_output(tail_retain, free_path):
+    """Abort after decoding / stop / length: grace. Error, ignored, a
+    preemption (frees while RUNNING), graces off (connector) and a
+    block-sized unit: plain free. Nothing leaks."""
+    from vllm.v1.request import RequestStatus
+
+    num_blocks = 96
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+
+    def turn(name, seed, status):
+        req = make_request(
+            name, _tail_tokens(seed, 2 * TAIL_BLOCK + 9), TAIL_HASH, sha256
+        )
+        _tail_run(manager, req, decode_steps=1)
+        _finish_and_free(manager, req, free_path, status)
+        return req
+
+    graced = [
+        turn("stop", 1, RequestStatus.FINISHED_STOPPED),
+        turn("len", 2, RequestStatus.FINISHED_LENGTH_CAPPED),
+        turn("abort", 3, RequestStatus.FINISHED_ABORTED),
+    ]
+    plain = [
+        turn("err", 4, RequestStatus.FINISHED_ERROR),
+        turn("ign", 5, RequestStatus.FINISHED_IGNORED),
+        turn("pre", 6, RequestStatus.RUNNING),  # a preemption's free
+    ]
+    assert list(_graces(manager)) == [r.request_id for r in graced]
+    for req in plain:
+        assert req.request_id not in _graces(manager)
+    held = manager.num_grace_pinned_blocks
+    assert held > 0
+    assert pool.get_num_free_blocks() == num_blocks - 1 - held
+    manager.enable_grace_pins = False  # what the scheduler sets with a connector
+    turn("conn", 7, RequestStatus.FINISHED_STOPPED)
+    assert "conn" not in _graces(manager)
+    manager.enable_grace_pins = True
+    assert manager.yield_pinned_hits() == held
+    _tail_assert_pool_clean(manager, num_blocks)
+
+    # A block-sized prefix unit (the U=4096 lane): graces are off.
+    coarse = make_kv_cache_manager(
+        kv_cache_config=manager.kv_cache_config,
+        max_model_len=8192,
+        enable_caching=True,
+        hash_block_size=TAIL_BLOCK,
+        use_eagle=True,
+        retention_interval=0,
+    )
+    assert not coarse.enable_grace_pins
+
+
+def test_grace_pin_never_stops_a_running_request_at_a_full_pool(tail_retain):
+    """Pool exactly full (graces + running): a running request that needs a
+    block gets one after yielding one grace (the oldest), no preemption,
+    the newer graces stay; nothing leaks."""
+    num_blocks = 40
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+    r = make_request("R", _tail_tokens(7, 2 * TAIL_BLOCK), TAIL_HASH, sha256)
+    _tail_run(manager, r, decode_steps=0)
+    for i in range(3):
+        req = make_request(
+            f"F{i}", _tail_tokens(20 + i, 2 * TAIL_BLOCK + 9), TAIL_HASH, sha256
+        )
+        _tail_run(manager, req, decode_steps=1)
+        _finish_and_free(manager, req)
+    taken = pool.get_new_blocks(pool.get_num_free_blocks())
+    assert pool.get_num_free_blocks() == 0 and manager.num_grace_pins == 3
+    r.append_output_token_ids(777)
+    r.spec_token_ids = [778, 779, 780]
+    blocks = manager.allocate_slots(r, 1 + TAIL_SPEC, num_lookahead_tokens=TAIL_SPEC)
+    assert blocks is None and manager.last_alloc_shortfall > 0
+    # The scheduler's running loop: yield one, retry; never preempt.
+    yields = 0
+    while blocks is None:
+        assert manager.yield_pinned_hits(limit=1) > 0, "nothing left to yield"
+        yields += 1
+        blocks = manager.allocate_slots(
+            r, 1 + TAIL_SPEC, num_lookahead_tokens=TAIL_SPEC
+        )
+    assert yields == 1 and manager.last_alloc_shortfall == 0
+    assert list(_graces(manager)) == ["F1", "F2"]
+    r.spec_token_ids = []
+    r.num_computed_tokens += 1
+    manager.new_step_starts()
+    _tail_drain_copies(manager)
+    pool.free_blocks(taken)
+    _finish_and_free(manager, r)
+    manager.yield_pinned_hits()
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_yieldable_blocks_exclude_the_head_waiters_own_hit(tail_retain):
+    """num_yieldable_blocks counts only blocks a release would return to the
+    free queue: never the head waiter's own pinned hit."""
+    num_blocks = 96
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    _finish_and_free(manager, a0)
+    grace = manager.grace_pinned_blocks("A0")
+    assert manager.num_yieldable_blocks() == len(grace)
+    a1 = _tail_followup(a0, 26, seed=3)
+    assert manager.pin_waiting_hit(a1) > 0
+    own = {id(b) for b in _pinned(manager)[a1.request_id]}
+    others = [b for b in grace if id(b) not in own]
+    assert manager.num_yieldable_blocks(keep=a1.request_id) == len(others)
+    assert manager.num_yieldable_blocks() == len({id(b) for b in grace} | own)
+    _tail_run(manager, a1)  # admission releases both the pin and A0's grace
+    assert not _graces(manager) and not _pinned(manager)
+    _finish_and_free(manager, a1)
+    manager.yield_pinned_hits()
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_pins_and_graces_follow_a_producers_moved_tail(tail_retain):
+    """Without the eagle drop a sibling can resume at a producer's LIVE tail
+    block. A waiter pin (and, retain on, a finished consumer's grace via its
+    hold) on that block must follow the hash into the producer's CoW copy:
+    otherwise it leaves ref 2 on a running state block its owner keeps
+    writing, and protects nothing."""
+    from vllm.v1.request import RequestStatus
+
+    num_blocks = 96
+    manager = _tail_manager(num_blocks, use_eagle=False)
+    pool = manager.block_pool
+
+    producer = make_request("P", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    tail = producer.num_prompt_tokens // TAIL_HASH * TAIL_HASH
+    computed, num_hit, _ = manager.get_computed_blocks(producer)
+    while producer.num_computed_tokens < tail:
+        num_new = _tail_split(
+            producer,
+            producer.num_tokens - producer.num_computed_tokens,
+            use_eagle=False,
+        )
+        assert manager.allocate_slots(
+            producer, num_new, num_hit, computed, num_lookahead_tokens=TAIL_SPEC
+        )
+        producer.num_computed_tokens += num_new
+        computed, num_hit = None, 0
+        manager.new_step_starts()
+        _tail_drain_copies(manager)
+    [live] = pool.get_cached_block(
+        producer.block_hashes[tail // TAIL_HASH - 1], [TAIL_MAMBA]
+    )
+
+    # A consumer admitted on the live tail finishes (aborted after one output
+    # token) before the producer moves on; retain on, its hold of the live
+    # block becomes part of its grace.
+    consumer = make_request(
+        "C", list(producer.prompt_token_ids) + _tail_tokens(2, 30), TAIL_HASH, sha256
+    )
+    c_computed, c_hit, _ = manager.get_computed_blocks(consumer)
+    assert c_hit == tail
+    num_new = _tail_split(
+        consumer, consumer.num_tokens - c_hit, c_hit, use_eagle=False
+    )
+    assert manager.allocate_slots(
+        consumer, num_new, c_hit, c_computed, num_lookahead_tokens=TAIL_SPEC
+    )
+    consumer.num_computed_tokens = c_hit + num_new
+    consumer.append_output_token_ids(4242)
+    _finish(consumer, RequestStatus.FINISHED_ABORTED)
+    manager.free(consumer)
+    assert (live in manager.grace_pinned_blocks("C")) == tail_retain
+    # And a waiter pinned on the same live tail.
+    w = make_request(
+        "W", list(producer.prompt_token_ids) + _tail_tokens(3, 30), TAIL_HASH, sha256
+    )
+    assert manager.pin_waiting_hit(w) > 0
+    assert live in _pinned(manager)["W"]
+
+    # The producer's next chunk moves the tail hash into its CoW block.
+    manager.new_step_starts()
+    _tail_drain_copies(manager)
+    num_new = _tail_split(
+        producer, producer.num_tokens - producer.num_computed_tokens, use_eagle=False
+    )
+    assert manager.allocate_slots(producer, num_new, num_lookahead_tokens=TAIL_SPEC)
+    producer.num_computed_tokens += num_new
+    [moved] = pool.get_cached_block(
+        producer.block_hashes[tail // TAIL_HASH - 1], [TAIL_MAMBA]
+    )
+    assert moved is not live and live.block_hash is None
+    assert live not in manager.grace_pinned_blocks("C")
+    assert live not in _pinned(manager)["W"] and moved in _pinned(manager)["W"]
+    if tail_retain:
+        assert moved in manager.grace_pinned_blocks("C")
+    manager.new_step_starts()
+    _tail_drain_copies(manager)
+    assert live.ref_cnt == 1  # the producer's table alone
+
+    _tail_decode(manager, producer, steps=2)
+    _finish_and_free(manager, producer)
+    _, w_hit, _ = manager.get_computed_blocks(w)
+    assert w_hit == tail
+    manager.free(w)  # abort the waiter (no output: no grace)
+    manager.yield_pinned_hits()
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+# --- the real scheduler (full attention, block 16; graces forced on, as the
+# --- fine-grained hybrid lane gets them by default) -------------------------
+def _sched_request(request_id: str, tokens: list[int], max_tokens: int):
+    from vllm.sampling_params import SamplingParams
+    from vllm.v1.core.kv_cache_utils import get_request_block_hasher
+    from vllm.v1.request import Request
+
+    params = SamplingParams(ignore_eos=True, max_tokens=max_tokens)
+    params.update_from_generation_config({}, 50256)
+    return Request(
+        request_id=request_id,
+        prompt_token_ids=tokens,
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(16, sha256),
+    )
+
+
+def _sched_step(scheduler):
+    from vllm.v1.outputs import ModelRunnerOutput
+
+    out = scheduler.schedule()
+    req_ids = list(out.num_scheduled_tokens)
+    scheduler.update_from_output(
+        out,
+        ModelRunnerOutput(
+            req_ids=req_ids,
+            req_id_to_index={r: i for i, r in enumerate(req_ids)},
+            sampled_token_ids=[[7] for _ in req_ids],
+            logprobs=None,
+            prompt_logprobs_dict={},
+            pooler_output=[],
+        ),
+    )
+    return out
+
+
+def _grace_scheduler(num_blocks: int):
+    import os
+
+    from tests.v1.core.utils import create_scheduler
+
+    scheduler = create_scheduler(
+        model=os.environ.get("VLLM_TEST_DEFER_FREE_MODEL", "facebook/opt-125m"),
+        enable_prefix_caching=True,
+        num_blocks=num_blocks,
+        block_size=16,
+        max_num_seqs=4,
+    )
+    scheduler.kv_cache_manager.enable_grace_pins = True
+    return scheduler
+
+
+def _sched_finish(scheduler, request) -> None:
+    scheduler.add_request(request)
+    while not request.is_finished():
+        _sched_step(scheduler)
+
+
+def test_scheduler_running_request_yields_graces_never_preempts():
+    scheduler = _grace_scheduler(num_blocks=12)  # 11 usable
+    manager = scheduler.kv_cache_manager
+    pool = manager.block_pool
+    a = _sched_request("A", list(range(1000, 1048)), max_tokens=2)
+    _sched_finish(scheduler, a)
