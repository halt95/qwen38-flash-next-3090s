+def test_scheduler_pins_never_report_a_common_prefix():
+    """A finished on a 2-block system prefix and its grace holds it. R1
+    (system + own) and R2 (unrelated) run. The system blocks have ref 2 =
+    R1's table + A's grace, equal to the number of running requests, which
+    the per-block count would read as a prefix common to all of them. With
+    a pin or grace held the scheduler reports no common prefix, so cascade
+    attention cannot read R2 against blocks it does not share."""
+    scheduler = _grace_scheduler(num_blocks=64)
+    manager = scheduler.kv_cache_manager
+    system = list(range(500, 532))
+    a = _sched_request("A", system + list(range(1000, 1064)), max_tokens=2)
+    _sched_finish(scheduler, a)  # prompt 96: R1's 32-token hit is no follow-up
+    assert len(manager.grace_pinned_blocks("A")) == 6
+    r1 = _sched_request("R1", system + list(range(2000, 2032)), max_tokens=8)
+    r2 = _sched_request("R2", list(range(3000, 3048)), max_tokens=8)
+    scheduler.add_request(r1)
+    scheduler.add_request(r2)
+    out = _sched_step(scheduler)
+    assert "R1" in out.num_scheduled_tokens and "R2" in out.num_scheduled_tokens
+    assert "A" in manager._grace_pins
+    assert out.num_common_prefix_blocks == [0], out.num_common_prefix_blocks
+    # Without any pin the count is what it was: R2 gone, R3 joins the prefix,
+    # every running request shares the system blocks.
+    from vllm.v1.request import RequestStatus
+
+    scheduler.finish_requests("R2", RequestStatus.FINISHED_ABORTED)
+    manager.yield_pinned_hits()  # A's grace and R2's
+    r3 = _sched_request("R3", system + list(range(4000, 4032)), max_tokens=8)
+    scheduler.add_request(r3)
+    out = _sched_step(scheduler)
+    assert "R3" in out.num_scheduled_tokens and not manager._grace_pins
+    assert out.num_common_prefix_blocks == [2]
+    while not (r1.is_finished() and r3.is_finished()):
+        _sched_step(scheduler)
+    manager.yield_pinned_hits()
+    assert manager.block_pool.get_num_free_blocks() == 63
+
+
+def test_release_pinned_extras_drops_only_the_blocks_outside_the_hit():
+    """A waiter's pin = its hit + the proof block past it. Only the proof
+    block counts as yieldable for the waiter itself, and only when its hit is
+    given; releasing the extras drops exactly that block, once, and leaves a
+    block another holder still references out of the free queue."""
+    scheduler = _grace_scheduler(num_blocks=100)
+    manager = scheduler.kv_cache_manager
+    manager.coordinator.eagle_group_ids = {0}
+    pool = manager.block_pool
+    a = _sched_request("A", list(range(1000, 1048)), max_tokens=2)
+    _sched_finish(scheduler, a)  # grace on A1..A3
+    h = _sched_request("H", list(a.prompt_token_ids) + list(range(5000, 5064)), 2)
+    hit, num_hit, _ = manager.get_computed_blocks(h)
+    assert num_hit == 32 and len(hit.blocks[0]) == 2  # A3 dropped
+    assert manager.pin_waiting_hit(h) == 3  # A1, A2 + the proof A3
+    [a3] = pool.get_cached_block(a.block_hashes[2], [0])
+    assert a3.ref_cnt == 2  # A's grace + H's pin
+    assert manager.num_yieldable_blocks(keep="H") == 0
+    assert manager.num_yieldable_blocks(keep="H", keep_hit=hit.blocks) == 1
+    assert manager.release_pinned_extras("H", hit.blocks) == 1
+    assert manager.release_pinned_extras("H", hit.blocks) == 0
+    assert [b.block_id for b in manager.pinned_hit_blocks("H")] == [
+        b.block_id for b in hit.blocks[0]
+    ]
+    assert a3.ref_cnt == 1 and pool.get_num_free_blocks() == 96  # A's grace holds it
+    assert manager.num_yieldable_blocks(keep="H") == 1  # now A's grace can go
+    manager.yield_pinned_hits(keep="H")
+    assert a3.ref_cnt == 0 and pool.get_num_free_blocks() == 97
+    manager.release_pinned_hit("H")
+    assert pool.get_num_free_blocks() == 99
+
