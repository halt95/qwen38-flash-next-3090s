+def _proof_pin_scene():
+    """99 usable blocks, EAGLE drop on. A (80 tokens) and B (16) finished; R
+    took every free block and its first decode step made A's grace (the
+    oldest) yield: R consumed A's 5th block, A's first four stay cached in
+    the free queue. Returns (scheduler, manager, pool, a, a4, r): free 4,
+    B's 1-block grace the only other pin."""
+    scheduler = _grace_scheduler(num_blocks=100)
+    manager = scheduler.kv_cache_manager
+    manager.coordinator.eagle_group_ids = {0}  # lookups drop the last hit block
+    pool = manager.block_pool
+    a = _sched_request("A", list(range(1000, 1080)), max_tokens=2)
+    _sched_finish(scheduler, a)  # grace: its 5 prompt blocks
+    b = _sched_request("B", list(range(2000, 2016)), max_tokens=2)
+    _sched_finish(scheduler, b)  # grace: 1 block, newer than A's
+    assert pool.get_num_free_blocks() == 93
+    r = _sched_request("R", list(range(3000, 4488)), max_tokens=4)
+    scheduler.add_request(r)
+    out = _sched_step(scheduler)
+    assert out.num_scheduled_tokens["R"] == 1488 and pool.get_num_free_blocks() == 0
+    _sched_step(scheduler)
+    assert list(manager._grace_pins) == ["B"] and r.num_preemptions == 0
+    assert pool.get_num_free_blocks() == 4
+    [a4] = pool.get_cached_block(a.block_hashes[3], [0])
+    assert a4.ref_cnt == 0
+    assert pool.get_cached_block(a.block_hashes[4], [0]) is None
+    return scheduler, manager, pool, a, a4, r
+
+
+def test_scheduler_head_waiter_measures_its_shortfall_after_pinning():
+    """The head waiter's own pin can raise its shortfall. With the EAGLE drop
+    its hit ends one block below what is cached, and that proof block is
+    pinned along with the hit; when it was free, the failed admission counted
+    it as free and the pin takes it out of the queue. The yield decision uses
+    the shortfall measured after the pin, and the head gives its proof block
+    back first: it is admitted in the same step on exactly the blocks it
+    pinned plus the one grace that covers the rest."""
+    scheduler, manager, pool, a, a4, r = _proof_pin_scene()
+    # H resends A's prompt: 4 cached blocks, the drop returns 3 and the 4th
+    # is the proof block. Admission needs 2 new blocks + the 3 free hit
+    # blocks against 4 free: short by 1 before the pin, by 2 after it (the
+    # pin took the proof block too). The proof block comes back first, B's
+    # grace covers the other one: H is admitted on its 48-token hit. Before
+    # the recompute B's grace yielded against the stale shortfall of 1 and
+    # H still waited.
+    h = _sched_request("H", list(a.prompt_token_ids), max_tokens=2)
+    scheduler.add_request(h)
+    out = _sched_step(scheduler)
+    assert out.num_scheduled_tokens["H"] == 32
+    assert not manager.pinned_hit_blocks("H") and not manager._grace_pins
+    assert pool.get_num_free_blocks() == 0 and r.num_preemptions == 0
+    while not (r.is_finished() and h.is_finished()):
+        _sched_step(scheduler)
+    manager.yield_pinned_hits()
+    assert pool.get_num_free_blocks() == 99
+
+
+def test_scheduler_head_waiter_keeps_every_pin_when_nothing_covers_it():
+    """Same scene, H one block longer: 3 new blocks needed, short by 3 after
+    the pin. Its proof block and B's grace together give 2: nothing is
+    released, nothing yields. B keeps its grace, H keeps its whole pin, and
+    once R has finished H is admitted on the hit the pin protected."""
+    scheduler, manager, pool, a, a4, r = _proof_pin_scene()
+    h = _sched_request("H", list(a.prompt_token_ids) + list(range(5000, 5016)), 2)
+    scheduler.add_request(h)
+    out = _sched_step(scheduler)
+    assert "H" not in out.num_scheduled_tokens
+    assert manager.grace_pinned_blocks("B"), "B's grace yielded for nothing"
+    assert len(manager.pinned_hit_blocks("H")) == 4 and a4.ref_cnt == 1
+    assert pool.get_num_free_blocks() == 0 and r.num_preemptions == 0
+    while not r.is_finished():
+        _sched_step(scheduler)
+    out = _sched_step(scheduler)  # R's grace covers it now; the oldest yields
+    assert out.num_scheduled_tokens["H"] == 96 - 48
+    assert not manager.pinned_hit_blocks("H")
+    while not h.is_finished():
+        _sched_step(scheduler)
+    manager.yield_pinned_hits()
+    assert pool.get_num_free_blocks() == 99
+
+
+def test_scheduler_head_waiter_gives_its_proof_block_back_at_an_exact_fit():
+    """No running request. A finished (grace on its 3 blocks). H resends A's
+    prompt + 1535 tokens: 99 blocks, the whole usable pool. Its hit is 3
+    blocks, the EAGLE drop returns 2 and the 3rd is pinned as the proof. H
+    needs 97 new blocks; the pool has 96 free plus the proof block, held by
+    A's grace and H's own pin. Nothing else ever yields H's own pin, so H
+    gives the proof block back itself, A's grace is then yieldable and H is
+    admitted. Before that H waited forever: shortfall 1, nothing yieldable."""
+    scheduler = _grace_scheduler(num_blocks=100)  # 99 usable
+    manager = scheduler.kv_cache_manager
+    manager.coordinator.eagle_group_ids = {0}
+    pool = manager.block_pool
+    a = _sched_request("A", list(range(1000, 1048)), max_tokens=2)
+    _sched_finish(scheduler, a)
+    assert pool.get_num_free_blocks() == 96 and manager.num_grace_pinned_blocks == 3
+
+    # One output token: the prompt's last block has room for it, so the
+    # whole request fits the pool exactly.
+    h = _sched_request("H", list(a.prompt_token_ids) + list(range(5000, 6535)), 1)
+    assert len(h.block_hashes) == 98 and h.num_prompt_tokens == 1583
+    scheduler.add_request(h)
+    out = _sched_step(scheduler)
+    assert out.num_scheduled_tokens.get("H") == 1583 - 32, (
+        f"H not admitted: free={pool.get_num_free_blocks()} "
+        f"own pin={len(manager.pinned_hit_blocks('H'))} "
+        f"graces={list(manager._grace_pins)} "
+        f"shortfall={manager.last_alloc_shortfall}"
+    )
+    assert h.is_finished() and not manager.pinned_hit_blocks("H")
+    assert list(manager._grace_pins) == ["H"]  # A's yielded, H's taken
+    manager.yield_pinned_hits()
+    assert pool.get_num_free_blocks() == 99
+
