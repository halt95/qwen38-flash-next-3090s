+    release-on-retire behaviour, and a misspelt value is a boot error rather
+    than a silent arm flip."""
+    name = "VLLM_E2_MAMBA_RETAIN_CHECKPOINT"
+    monkeypatch.delenv(name, raising=False)
+    assert _fresh_env_value(name) is True
+    monkeypatch.setenv(name, "1")
+    assert _fresh_env_value(name) is True
+    monkeypatch.setenv(name, "0")
