diff --git a/tests/v1/core/test_mamba_checkpoint_retention.py b/tests/v1/core/test_mamba_checkpoint_retention.py
new file mode 100644
index 0000000000..1a4ebe51a4
--- /dev/null
+++ b/tests/v1/core/test_mamba_checkpoint_retention.py
@@ -0,0 +1,563 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Align-mode Mamba prefix-checkpoint retention (v2.5, HF discussion #2).
+
+In align mode a recurrent-state block leaves the request's block table as soon
+as the request has computed one block past it (``remove_skipped_blocks``). When
+that block is hashed it is the request's GDN prefix checkpoint (under
+``prefix_cache_retention_interval=0``, the prompt's replay boundary), and the
+old code returned it to the free queue there and then -- mid-request, long
+before the request's own attention blocks, which stay referenced until it
+finishes. Other requests' prefills pop the free queue from the head, so the
+checkpoint was evicted first; the hybrid hit is the shortest group's, so that
+one block zeroed the next turn's reuse (measured: FP32 state, 8 x ~80K agent
+conversations, cached fraction 0.000 with 0 preemptions).
+
+``VLLM_E2_MAMBA_RETAIN_CHECKPOINT=1`` (default) keeps the newest hashed retired
+state referenced until the request is freed, then releases it after the
+request's attention blocks. ``=0`` is the old behaviour and is the FAILING
+control in every test below.
+
+These tests drive ``KVCacheManager`` through the calls the scheduler makes:
+``get_computed_blocks`` -> ``allocate_slots`` per step (chunk ends from the real
+``Scheduler._mamba_block_aligned_split``, MTP lookahead slots, draft tokens) ->
+``free`` / ``pop_blocks_for_free``. CPU only.
+"""
+
+from collections.abc import Callable
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm import envs
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+from vllm.v1.core.kv_cache_utils import (
+    KVCacheBlock,
+    get_request_block_hasher,
+    init_none_hash,
+)
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.core.single_type_kv_cache_manager import MambaManager
+from vllm.v1.kv_cache_interface import (
+    FullAttentionSpec,
+    KVCacheConfig,
+    KVCacheGroupSpec,
+    MambaSpec,
+)
+from vllm.v1.request import Request
+
+pytestmark = pytest.mark.cpu_test
+
+BLOCK = 32
+NUM_SPEC = 3  # MTP K=3, as deployed
+SWITCH = "VLLM_E2_MAMBA_RETAIN_CHECKPOINT"
+# Group 0 = full attention; groups 1, 2 = two GDN-like align-mode Mamba groups
+# (the deployment has several; a hit needs the checkpoint in EVERY one).
+ATTN = 0
+MAMBA_GROUPS = (1, 2)
+
+
+@pytest.fixture(autouse=True)
+def _init_hash():
+    init_none_hash(sha256)
+
+
+@pytest.fixture(params=["1", "0"], ids=["retain-on", "retain-off-control"])
+def retain(request, monkeypatch) -> bool:
+    monkeypatch.setenv(SWITCH, request.param)
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+    return request.param == "1"
+
+
+def _config(num_blocks: int) -> KVCacheConfig:
+    mamba = MambaSpec(
+        block_size=BLOCK,
+        shapes=((1, 1),),
+        dtypes=(torch.float32,),
+        mamba_cache_mode="align",
+        num_speculative_blocks=NUM_SPEC,
+    )
+    return KVCacheConfig(
+        num_blocks=num_blocks,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["attn"],
+                FullAttentionSpec(
+                    block_size=BLOCK, num_kv_heads=1, head_size=1, dtype=torch.float16
+                ),
+            ),
+            KVCacheGroupSpec(["gdn_a"], mamba),
+            KVCacheGroupSpec(["gdn_b"], mamba),
+        ],
+    )
+
+
+def _manager(num_blocks: int, num_prefill_lookahead: int = 0) -> KVCacheManager:
+    # retention interval 0 = the deployed default (cache.py): keep only the
+    # replay-boundary (and shared-prefix) states.
+    config = replace(_config(num_blocks), prefix_cache_retention_interval=0)
+    return KVCacheManager(
+        config,
+        max_model_len=8192,
+        scheduler_block_size=BLOCK,
+        hash_block_size=BLOCK,
+        enable_caching=True,
+        use_eagle=True,
+        num_prefill_lookahead=num_prefill_lookahead,
+    )
+
+
+def _mamba(manager: KVCacheManager, gid: int) -> MambaManager:
+    mgr = manager.coordinator.single_type_managers[gid]
+    assert isinstance(mgr, MambaManager)
+    return mgr
+
+
+def _request(rid: str, tokens: list[int]) -> Request:
+    params = SamplingParams(max_tokens=4096)
+    params.update_from_generation_config({}, eos_token_id=100000)
+    return Request(
+        request_id=rid,
+        prompt_token_ids=tokens,
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(BLOCK, sha256),
+    )
+
+
+def _split(request: Request, num_new: int, num_local_hit: int = 0) -> int:
+    """The real `Scheduler._mamba_block_aligned_split` on a stub self."""
+    stub = SimpleNamespace(
+        block_size=BLOCK,
+        cache_config=SimpleNamespace(block_size=BLOCK),
+        use_eagle_block_drop=True,
+        max_num_scheduled_tokens=8192,
+        scheduler_config=SimpleNamespace(long_prefill_token_threshold=0),
+        mamba_partial_cache_hit=False,
+        mamba_fine_grained_prefix_cache=False,
+        hash_block_size=BLOCK,
+        mamba_has_prefill_checkpoint_blocks=False,
+        mamba_prefill_checkpoint_alignment=None,
+    )
+    return Scheduler._mamba_block_aligned_split(stub, request, num_new, num_local_hit)
+
+
+def _prefill(manager: KVCacheManager, request: Request, budget: int = 8192) -> int:
+    """Prefill to the end of the prompt in scheduler-sized chunks; returns the
+    local prefix-hit length the request was admitted with."""
+    computed_blocks, num_hit, _ = manager.get_computed_blocks(request)
+    first = True
+    while request.num_computed_tokens < request.num_tokens:
+        start = request.num_computed_tokens + (num_hit if first else 0)
+        remaining = request.num_tokens - start
+        num_new = _split(
+            request, min(remaining, budget), num_hit if first else 0
+        )
+        assert num_new > 0
+        blocks = manager.allocate_slots(
+            request,
+            num_new,
+            num_new_computed_tokens=num_hit if first else 0,
+            new_computed_blocks=computed_blocks if first else None,
+            num_lookahead_tokens=NUM_SPEC,
+        )
+        assert blocks is not None, "prefill chunk did not fit"
+        request.num_computed_tokens = start + num_new
+        manager.new_step_starts()
+        first = False
+    return num_hit
+
+
+def _decode(
+    manager: KVCacheManager,
+    request: Request,
+    steps: int,
+    accepted: Callable[[int], int] = lambda step: 0,
+    on_step: Callable[[], None] | None = None,
+) -> None:
+    """MTP K=3 decode: each step schedules the last token + K drafts and
+    reserves K lookahead slots; ``accepted(step)`` drafts are accepted."""
+    next_tok = 50000 + len(request.output_token_ids)
+    if request.num_computed_tokens == request.num_tokens:
+        request.append_output_token_ids(next_tok)  # sampled by the prefill
+        next_tok += 1
+    for step in range(steps):
+        assert request.num_computed_tokens == request.num_tokens - 1
+        request.spec_token_ids = [next_tok + i for i in range(NUM_SPEC)]
+        blocks = manager.allocate_slots(
+            request, 1 + NUM_SPEC, num_lookahead_tokens=NUM_SPEC
+        )
+        assert blocks is not None, "decode step did not fit"
+        n_acc = accepted(step)
+        request.spec_token_ids = []
+        request.num_computed_tokens += 1 + n_acc
+        request.append_output_token_ids(list(range(next_tok, next_tok + n_acc + 1)))
+        next_tok += n_acc + 1
+        manager.new_step_starts()
+        if on_step is not None:
+            on_step()
+
+
+def _tokens(seed: int, n: int) -> list[int]:
+    return [seed * 10000 + i for i in range(n)]
+
+
+def _hashed_cached(manager: KVCacheManager, block: KVCacheBlock) -> bool:
+    return block.block_hash is not None and block.ref_cnt == 0
+
+
+def _free_queue_ids(manager: KVCacheManager) -> list[int]:
+    return [b.block_id for b in manager.block_pool.free_block_queue.get_all_free_blocks()]
+
+
+def _replay_checkpoint(manager: KVCacheManager, request: Request, gid: int):
+    """The group's state block hashed at the request's replay boundary."""
+    [boundary] = set(manager.coordinator.get_replay_boundaries(request))
+    block_hash = request.block_hashes[boundary // BLOCK - 1]
+    cached = manager.block_pool.get_cached_block(block_hash, [gid])
+    assert cached is not None, "the replay checkpoint was never registered"
+    return boundary, cached[0]
+
+
+# --------------------------------------------------------------------------
+# 1. The multi-turn eviction scenario (Hugging Face discussion #2).
+# --------------------------------------------------------------------------
+def test_concurrent_prefill_cannot_evict_running_requests_checkpoint(retain):
+    """Conversation A decodes; conversation D finishes meanwhile; a cold
+    prefill B then needs a few more blocks than the uncached free ones. LRU
+    order decides the victim: with the old release-on-retire, A's checkpoint
+    (released early in A's decode) is the OLDEST cached free block, so B takes
+    it and A's next turn gets no reuse at all although A's whole attention
+    prefix survives. With retention, B takes D's least-recent blocks instead
+    and A's next turn resumes at its replay boundary.
+    """
+    manager = _manager(num_blocks=64)
+    pool = manager.block_pool
+
+    # A: 150-token prompt -> replay boundary 96 (eagle drop): state block 2.
+    a = _request("A", _tokens(1, 150))
+    assert _prefill(manager, a) == 0
+    _decode(manager, a, steps=4)  # first decode step retires state@96
+    ckpts = {gid: _replay_checkpoint(manager, a, gid)[1] for gid in MAMBA_GROUPS}
+    for gid, block in ckpts.items():
+        assert block.block_hash is not None
+        if retain:
+            assert block.ref_cnt == 1, "checkpoint must stay referenced"
+            assert block.block_id not in _free_queue_ids(manager)
+        else:
+            # The exposure the fix removes: cached-free while A still runs.
+            assert _hashed_cached(manager, block)
+
+    # D: a short conversation that runs and finishes while A decodes.
+    d = _request("D", _tokens(2, 200))
+    _prefill(manager, d)
+    _decode(manager, d, steps=2)
+    manager.free(d)
+
+    uncached_free = sum(
+        blk.block_hash is None
+        for blk in pool.free_block_queue.get_all_free_blocks()
+    )
+    cached_free = pool.get_num_free_blocks() - uncached_free
+    # Precondition: the two worlds differ only by A's checkpoints being in the
+    # free queue (off) or held (on); the uncached supply is identical.
+    assert cached_free >= 4
+
+    # B: a cold prefill that pops every uncached free block plus two cached.
+    taken = pool.get_new_blocks(uncached_free + 2)
+
+    a_ckpt_lost = any(blk.block_hash is None for blk in ckpts.values())
+    assert a_ckpt_lost is (not retain)
+    pool.free_blocks(taken)
+
+    # A finishes; its next turn (prompt + output + new user text) arrives.
+    manager.free(a)
+    a2 = _request("A2", list(a.all_token_ids) + _tokens(3, 40))
+    _, num_hit, _ = manager.get_computed_blocks(a2)
+    if retain:
+        assert num_hit == 96
+    else:
+        # FAILING CONTROL: every attention block of A is still cached, yet
+        # the hybrid hit is zero because one Mamba group lost its state.
+        assert all(
+            pool.get_cached_block(a.block_hashes[i], [ATTN]) for i in range(3)
+        )
+        assert num_hit == 0
+
+
+def test_real_cold_prefill_evicts_checkpoint_only_without_retention(retain):
+    """Same scenario with B as a real request prefilled through allocate_slots
+    (attention + both Mamba groups + MTP scratch), not a raw pool pop."""
+    manager = _manager(num_blocks=48)
+    a = _request("A", _tokens(1, 150))
+    _prefill(manager, a)
+    _decode(manager, a, steps=4)
+
+    d = _request("D", _tokens(2, 200))
+    _prefill(manager, d)
+    _decode(manager, d, steps=2)
+    manager.free(d)
+
+    pool = manager.block_pool
+    cached_free = [
+        b for b in pool.free_block_queue.get_all_free_blocks() if b.block_hash
+    ]
+    # B (448 tokens, sized on this 48-block pool) needs more than the
+    # uncached supply but fits in what is free in both worlds.
+    b = _request("B", _tokens(4, 448))
+    _prefill(manager, b)
+    _decode(manager, b, steps=1)
+    # Precondition, both worlds: B's prefill did reach the cached blocks.
+    evicted = [blk for blk in cached_free if blk.block_hash is None]
+    assert evicted
+
+    manager.free(a)
+    a2 = _request("A2", list(a.all_token_ids) + _tokens(3, 40))
+    _, num_hit, _ = manager.get_computed_blocks(a2)
+    assert num_hit == (96 if retain else 0)
+
+
+# --------------------------------------------------------------------------
+# 2. Accounting.
+# --------------------------------------------------------------------------
+def _held_blocks(manager: KVCacheManager) -> set[int]:
+    held: set[int] = set()
+    for mgr in manager.coordinator.single_type_managers:
+        for blocks in mgr.req_to_blocks.values():
+            held.update(b.block_id for b in blocks if not b.is_null)
+        if isinstance(mgr, MambaManager):
+            held.update(b.block_id for _, b in mgr._retained_checkpoints.values())
+    return held
+
+
+def test_retained_checkpoint_is_counted_by_the_pool_and_admission(retain):
+    manager = _manager(num_blocks=64)
+    pool = manager.block_pool
+    a = _request("A", _tokens(1, 150))
+    _prefill(manager, a)
+
+    def check_pool():
+        # Every block is free, in a table, or retained -- never two of these.
+        held = _held_blocks(manager)
+        free = set(_free_queue_ids(manager))
+        assert not held & free
+        assert len(held) + len(free) == pool.num_gpu_blocks - 1  # null block
+        for gid in MAMBA_GROUPS:
+            # Referenced hashed states outside A's table: at most the one
+            # retained checkpoint, and none at all without retention.
+            mgr = _mamba(manager, gid)
+            in_table = {b.block_id for b in mgr.req_to_blocks["A"]}
+            outside = [
+                bid
+                for bid in held - in_table
+                if pool.blocks[bid].block_hash is not None
+                and bid in {b.block_id for _, b in mgr._retained_checkpoints.values()}
+            ]
+            assert len(outside) <= (1 if retain else 0)
+
+    _decode(manager, a, steps=6, on_step=check_pool)
+    for gid in MAMBA_GROUPS:
+        assert ("A" in _mamba(manager, gid)._retained_checkpoints) is retain
+
+    # Admission (full-sequence gate): a fresh request reserves one retained
+    # checkpoint per Mamba group; a request already holding one does not.
+    fresh = _request("F", _tokens(5, 150))
+    empty = manager.empty_kv_cache_blocks.blocks
+
+    def admission(req: Request, computed: int) -> int:
+        return manager.coordinator.get_num_blocks_to_allocate(
+            request_id=req.request_id,
+            num_tokens=req.num_tokens,
+            new_computed_blocks=empty,
+            num_encoder_tokens=0,
+            total_computed_tokens=computed,
+            num_local_computed_tokens=computed,
+            num_tokens_main_model=req.num_tokens,
+            apply_admission_cap=True,
+        )
+
+    def per_step(req: Request) -> int:
+        return manager.coordinator.get_num_blocks_to_allocate(
+            request_id=req.request_id,
+            num_tokens=req.num_tokens,
+            new_computed_blocks=empty,
+            num_encoder_tokens=0,
+            total_computed_tokens=0,
+            num_local_computed_tokens=0,
+            num_tokens_main_model=req.num_tokens,
+        )
+
+    extra = len(MAMBA_GROUPS) if retain else 0
+    assert admission(fresh, 0) == per_step(fresh) + extra
+    # A already retains: only a swap remains, so no extra reservation.
+    assert admission(a, a.num_computed_tokens) == per_step_running(manager, a)
+
+
+def per_step_running(manager: KVCacheManager, req: Request) -> int:
+    return manager.coordinator.get_num_blocks_to_allocate(
+        request_id=req.request_id,
+        num_tokens=req.num_tokens,
+        new_computed_blocks=manager.empty_kv_cache_blocks.blocks,
+        num_encoder_tokens=0,
+        total_computed_tokens=req.num_computed_tokens,
+        num_local_computed_tokens=req.num_computed_tokens,
+        num_tokens_main_model=req.num_tokens,
+        apply_admission_cap=False,
+    )
+
+
+def test_admission_refuses_a_request_whose_checkpoints_would_overcommit(retain):
+    """Size the pool so the full-sequence gate passes by exactly the retained
+    blocks' margin: with retention it must refuse (the request would hold
+    those blocks for its lifetime), without it admit."""
+    req = _request("R", _tokens(6, 150))
+    probe = _manager(num_blocks=256)
+    need = probe.coordinator.get_num_blocks_to_allocate(
+        request_id="R",
+        num_tokens=req.num_tokens,
+        new_computed_blocks=probe.empty_kv_cache_blocks.blocks,
+        num_encoder_tokens=0,
+        total_computed_tokens=0,
+        num_local_computed_tokens=0,
+        num_tokens_main_model=req.num_tokens,
+        apply_admission_cap=True,
+    )
+    # The managers' own estimate excludes the retained term, so the pool size
+    # is the same in both worlds.
+    base_need = sum(
+        mgr.get_num_blocks_to_allocate(
+            "R", req.num_tokens, [], 0, 0, req.num_tokens, apply_admission_cap=True
+        )
+        for mgr in probe.coordinator.single_type_managers
+    )
+    assert need == base_need + (len(MAMBA_GROUPS) if retain else 0)
+    manager = _manager(num_blocks=base_need + 1)  # + null block
+    admitted = manager.allocate_slots(req, BLOCK, full_sequence_must_fit=True)
+    assert (admitted is None) is retain
+
+
+# --------------------------------------------------------------------------
+# 3. Finish path.
+# --------------------------------------------------------------------------
+@pytest.mark.parametrize("deferred", [False, True], ids=["free", "pop_blocks_for_free"])
+def test_finish_releases_checkpoint_after_attention_blocks(retain, deferred):
+    manager = _manager(num_blocks=64)
+    pool = manager.block_pool
+    a = _request("A", _tokens(1, 150))
+    _prefill(manager, a)
+    _decode(manager, a, steps=4)
+    attn_ids = [b.block_id for b in manager.coordinator.single_type_managers[
+        ATTN].req_to_blocks["A"]]
+    ckpt_ids = {
+        gid: _replay_checkpoint(manager, a, gid)[1].block_id for gid in MAMBA_GROUPS
+    }
+    queue_before = _free_queue_ids(manager)
+
+    if deferred:
+        # Async-connector path: the scheduler holds the list, frees it later.
+        blocks = manager.pop_blocks_for_free(a)
+        if retain:
+            assert [b.block_id for b in blocks[-2:]] == list(ckpt_ids.values())
+        pool.free_blocks(blocks)
+    else:
+        manager.free(a)
+
+    for gid, bid in ckpt_ids.items():
