From 263bd02e3344175daa8686d1da04e262c6bc43a2 Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Thu, 1 Oct 2026 05:05:23 -0400
Subject: [PATCH 68/97] guard: the bounds-guard telemetry code default is warn

VLLM_E2_GUARD_MODE now defaults to warn in code, matching what the shipped launchers set; v2 through v2.2.0
defaulted to off. The comment above it, the MODES docstring, the vllm/envs.py default and its annotation follow.
tests/v1/worker/gpu/test_guard_default_mode.py checks that code, comment and envs.py agree, from the sources, so
it runs without CUDA, and fails on the earlier source.
---
 .../v1/worker/gpu/test_guard_default_mode.py  | 86 +++++++++++++++++++
 .../test_guard_telemetry_defaults_drain.py    | 10 +--
 vllm/envs.py                                  |  4 +-
 vllm/v1/worker/guard_telemetry.py             | 22 ++---
 4 files changed, 105 insertions(+), 17 deletions(-)
 create mode 100644 tests/v1/worker/gpu/test_guard_default_mode.py

diff --git a/tests/v1/worker/gpu/test_guard_default_mode.py b/tests/v1/worker/gpu/test_guard_default_mode.py
new file mode 100644
index 0000000000..4dc451683d
--- /dev/null
+++ b/tests/v1/worker/gpu/test_guard_default_mode.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""The guard's CODE default is warn (since v2.5), and the code, its comment and
+vllm/envs.py agree.
+
+Source-level pins: they parse the files instead of importing them, so they run on a machine with no
+CUDA, no zmq and no working vllm import. The behavioural check at the end imports the
+module only when that works.
+"""
+
+import ast
+import importlib
+import os
+import re
+import sys
+
+import pytest
+
+_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), *([".."] * 4)))
+_GT = os.path.join(_ROOT, "vllm", "v1", "worker", "guard_telemetry.py")
+_ENVS = os.path.join(_ROOT, "vllm", "envs.py")
+
+
+def _read(path):
+    with open(path, encoding="utf-8") as fh:
+        return fh.read()
+
+
+def _getenv_defaults(src, name):
+    """every default literal passed to os.environ.get / os.getenv for `name`"""
+    out = []
+    for node in ast.walk(ast.parse(src)):
+        if not isinstance(node, ast.Call) or len(node.args) < 2:
+            continue
+        fn = ast.unparse(node.func)
+        if fn not in ("os.environ.get", "os.getenv"):
+            continue
+        a0, a1 = node.args[0], node.args[1]
+        if isinstance(a0, ast.Constant) and a0.value == name and isinstance(a1, ast.Constant):
+            out.append(a1.value)
+    return out
+
+
+def test_code_default_is_warn():
+    d = _getenv_defaults(_read(_GT), "VLLM_E2_GUARD_MODE")
+    assert d == ["warn"], d
+
+
+def test_envs_default_is_warn_everywhere():
+    src = _read(_ENVS)
+    assert _getenv_defaults(src, "VLLM_E2_GUARD_MODE") == ["warn"]
+    assert re.search(r'VLLM_E2_GUARD_MODE: str = "warn"', src)
+    assert 'VLLM_E2_GUARD_MODE: str = "off"' not in src
+
+
+def test_comment_and_docstring_agree_with_the_default():
+    src = _read(_GT)
+    line = next(ln for ln in src.splitlines() if ln.startswith("_MODE = os.environ.get("))
+    i = src.splitlines().index(line)
+    above = "\n".join(src.splitlines()[max(0, i - 8) : i])
+    assert "Release defaults" in above and "warn, 0.05 s" in above
+    assert "v2.5" in above
+    # the MODES block must name warn as the default and must not call off the default
+    assert re.search(r"warn\s+\(DEFAULT since v2\.5", src)
+    assert not re.search(r"off\s+\(DEFAULT", src)
+    # the interval default stays 0.05 (the comment says so)
+    assert _getenv_defaults(src, "VLLM_E2_GUARD_INTERVAL") == ["0.05"]
+
+
+def test_failing_control_the_old_default_would_be_caught():
+    """the pin must fail on the earlier source (default off)"""
+    old = _read(_GT).replace('"VLLM_E2_GUARD_MODE", "warn"', '"VLLM_E2_GUARD_MODE", "off"')
+    assert old != _read(_GT)
+    assert _getenv_defaults(old, "VLLM_E2_GUARD_MODE") == ["off"]
+    assert _getenv_defaults(old, "VLLM_E2_GUARD_MODE") != ["warn"]
+
+
+def test_module_default_with_env_absent(monkeypatch):
+    monkeypatch.delenv("VLLM_E2_GUARD_MODE", raising=False)
+    monkeypatch.delenv("VLLM_E2_GUARD_INTERVAL", raising=False)
+    sys.modules.pop("vllm.v1.worker.guard_telemetry", None)
+    try:
+        gt = importlib.import_module("vllm.v1.worker.guard_telemetry")
+    except Exception as e:  # noqa: BLE001  (no CUDA / zmq on this host: the source pins above stand in)
+        pytest.skip(f"vllm.v1.worker.guard_telemetry not importable here: {e!r}")
+    assert gt._MODE == "warn"
