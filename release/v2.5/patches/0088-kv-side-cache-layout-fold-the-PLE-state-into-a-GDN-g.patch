+# ---------------------------------------------------------------------------
+# v2.5 side-cache layout (VLLM_E2_SIDE_CACHE_LAYOUT, default ON).
+#
+# The packed block-outermost layout strides every pool block by the widest
+# group, and every group draws whole blocks from the one pool. Flash-Next has
+# two side caches whose real state is tiny next to that stride (12.9 MB on the
+# binding PP stage): the TP-replicated PLE short-conv state (one layer, 2 + K
+# blocks per request in align mode, a 1.6 MB padded page) and the QSA raw-key
+# ring (one block per request, 16 KB for all of a stage's layers). Together
+# they hold 6 of the 103 blocks a 262K request needs. Two layout-only changes
+# remove that cost without changing any value a kernel reads:
+#
+# 1. PLE fold. The replicated Mamba group joins a sharded Mamba group with the
+#    same scheduling parameters whose block has a spare page on every worker
+#    (Flash-Next: a GDN group holds 6 of PP0's 7 pages), so the PLE state rides
+#    in that group's blocks under the block table it would have had on its
+#    own. No worker's stride changes, so the pool block count does not change.
+# 2. Ring slot packing. The ring group splits every pool block into S equal
+#    slots and the ring manager hands out slots; a pool block goes back to the
+#    pool when its last slot is released. The ring then costs cdiv(requests, S)
+#    blocks in all instead of one per request.
+#
+# Off (=0) restores one group each, block for block.
+# ---------------------------------------------------------------------------
+
+# Slot stride alignment for packed ring views (bytes) and the largest S tried.
+_RING_SLOT_ALIGN = 256
+_RING_MAX_SLOTS = 1024
