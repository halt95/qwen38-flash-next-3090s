+# ---------------------------------------------------------------------------
+# 3. Worker views and KV zeroing (CPU allocation of a 3-block pool).
+# ---------------------------------------------------------------------------
+def _views(monkeypatch, value: str, rank: int):
+    from vllm.v1.worker.utils import allocate_kv_cache
+
+    _set_switch(monkeypatch, value)
+    # 24 blocks (~300 MB on CPU): one 3200-token request (22 blocks in the old
+    # layout) must still pass the boot's memory check.
+    _, _, configs = _configs(override=24, max_model_len=3200)
+    config = configs[rank]
+    caches = allocate_kv_cache(config, torch.device("cpu"), KVCacheLayout.BLNHC)
+    return config, caches
+
+
+def _byte_range(view: torch.Tensor, index: int, base: int) -> tuple[int, int]:
+    page = view[index]
+    start = page.data_ptr() - base
+    span = page.element_size() * (
+        1 + sum((s - 1) * st for s, st in zip(page.shape, page.stride()))
+    )
+    return start, start + span
+
+
+@pytest.mark.parametrize("rank", [0, 2], ids=["pp0", "pp1"])
+def test_slot_and_ple_views_stay_inside_their_block(monkeypatch, rank):
+    config, caches = _views(monkeypatch, "1", rank)
+    stride = ku._get_kv_cache_bytes_per_block(config.kv_cache_groups)
+    base = min(v.data_ptr() for v in caches.values())
+    rings = sorted(n for n in caches if n.endswith("raw_key_cache"))
+    slots = 800
+    assert all(caches[n].shape[0] == 24 * slots for n in rings)
+    for pool_block in (1, 2):
+        spans = []
+        for slot in (0, 1, slots - 1):
+            for name in rings:
+                lo, hi = _byte_range(caches[name], pool_block * slots + slot, base)
+                assert pool_block * stride <= lo < hi <= (pool_block + 1) * stride
+                spans.append((lo, hi))
+        spans.sort()
+        assert all(a[1] <= b[0] for a, b in zip(spans, spans[1:])), "slots overlap"
+    if rank == 0:
+        group = next(g for g in config.kv_cache_groups if PLE in g.layer_names)
+        lo, hi = _byte_range(caches[PLE], 1, base)
+        assert stride <= lo < hi <= 2 * stride
+        for name in group.layer_names[:-1]:  # the GDN layers of that group
+            for state in (
+                caches[name] if isinstance(caches[name], list) else [caches[name]]
+            ):
+                glo, ghi = _byte_range(state, 1, base)
+                assert ghi <= lo or glo >= hi, f"PLE page overlaps {name}"
+
+
+def _zeroed_offsets(config, caches, skip: bool) -> tuple[set, int]:
+    """Block-relative byte ranges the KV zeroer would clear, from its own
+    segment table (built on CPU tensors; the kernel is not launched)."""
+    from vllm.v1.worker.utils import KVBlockZeroer
+
+    groups = []
+    for gid, group in enumerate(config.kv_cache_groups):
+        for name in group.layer_names:
+            spec = group.kv_cache_spec
+            if isinstance(spec, UniformTypeKVCacheSpecs):
+                spec = spec.kv_cache_specs[name]
+            groups.append(
+                SimpleNamespace(
+                    kv_cache_spec=spec, kv_cache_group_id=gid, layer_names=[name]
+                )
+            )
+    kernel_block_sizes = [_first_spec(g).block_size for g in config.kv_cache_groups]
+    ctx = {name: SimpleNamespace(kv_cache=view) for name, view in caches.items()}
+    zeroer = KVBlockZeroer(
+        torch.device("cpu"),
+        attn_groups_iter=iter(groups),
+        kernel_block_sizes=kernel_block_sizes,
+        static_forward_context=ctx,
+        num_blocks=config.num_blocks,
+        skip_kv_cache_group_ids=config.slot_packed_group_ids if skip else (),
+    )
+    addrs, strides, pages, *_ = zeroer._meta
+    num_segments = len(addrs)
+    base = min(v.data_ptr() for v in caches.values())
+    stride = ku._get_kv_cache_bytes_per_block(config.kv_cache_groups)
+    covered: list[tuple[int, int]] = []
+    for addr, page in zip(addrs.tolist(), pages.tolist()):
+        lo = (addr - base) % stride
+        covered.append((lo, lo + 4 * page))
+    # Merge into a canonical union of intervals.
+    covered.sort()
+    merged: list[list[int]] = []
+    for lo, hi in covered:
+        if merged and lo <= merged[-1][1]:
+            merged[-1][1] = max(merged[-1][1], hi)
+        else:
+            merged.append([lo, hi])
+    return {tuple(m) for m in merged}, num_segments
+
+
+@pytest.mark.parametrize("rank", [0, 2], ids=["pp0", "pp1"])
+def test_zeroed_bytes_per_block_are_unchanged(monkeypatch, rank):
+    old_config, old_caches = _views(monkeypatch, "0", rank)
+    new_config, new_caches = _views(monkeypatch, "1", rank)
+    old, old_segments = _zeroed_offsets(old_config, old_caches, skip=True)
+    new, new_segments = _zeroed_offsets(new_config, new_caches, skip=True)
+    assert new == old
+    # The old ring segments were redundant (inside the first attention page);
+    # the new table drops exactly those.
+    assert new_segments <= old_segments
+    # FAILING CONTROL: without the slot-group skip every ring slot becomes a
+    # segment. On PP0 that zeroes bytes the old layout never zeroed (past the
+    # attention pages, inside the 7th GDN page); on PP1 the attention pages
+    # already cover the block, so it is "only" 5,600 redundant segments.
+    unskipped, unskipped_segments = _zeroed_offsets(new_config, new_caches, skip=False)
+    assert unskipped_segments > new_segments + 4000  # ~800 per ring layer
+    if rank == 0:
+        assert unskipped != old
+    else:
+        assert unskipped == old
