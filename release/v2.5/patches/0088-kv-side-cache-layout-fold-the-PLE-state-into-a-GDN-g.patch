+def _choose_ring_slots(
+    projected_groups_per_worker: list[list[KVCacheGroupSpec]],
+) -> dict[int, int]:
+    """Slots per pool block for every ring group (group index -> S >= 2).
+
+    S must cut every worker's block stride into equal slots that are
+    `_RING_SLOT_ALIGN`-aligned and hold that worker's ring pages; the largest
+    such S up to `_RING_MAX_SLOTS` is taken. Block ids are global, so S is the
+    same on every worker. A ring group with no valid S keeps one pool block
+    per request.
+    """
+    chosen: dict[int, int] = {}
+    if not projected_groups_per_worker or not projected_groups_per_worker[0]:
+        return chosen
+    num_groups = len(projected_groups_per_worker[0])
+    strides = [
+        _get_kv_cache_bytes_per_block(groups)
+        if any(g.layer_names for g in groups)
+        else 0
+        for groups in projected_groups_per_worker
+    ]
+    for group_index in range(num_groups):
+        if not _is_ring_group(projected_groups_per_worker[0][group_index]):
+            continue
+        needs = []
+        for groups, stride in zip(projected_groups_per_worker, strides):
+            group = groups[group_index]
+            if not group.layer_names:
+                continue
+            ring_bytes = sum(spec.page_size_bytes for spec in _group_layer_specs(group))
+            needs.append((stride, ring_bytes))
