+        # The A/B evidence line: boot logs must show which arm ran.
+        logger.info(
+            "Side-cache layout: %s (VLLM_E2_SIDE_CACHE_LAYOUT)%s",
+            "on" if enabled else "off",
+            "".join(f"; {note}" for note in notes),
+        )
