+def _running_footprint(value: str, prompt: int) -> int:
+    with pytest.MonkeyPatch.context() as mp:
+        _set_switch(mp, value)
+        manager = _manager(num_blocks=400)
+        req = _request("X", _tokens(99, prompt))
+        _prefill(manager, req)
+        _decode(manager, req, 3)
+        return 399 - manager.block_pool.get_num_free_blocks()
+
+
+def test_freed_blocks_admit_requests_the_old_layout_refuses(layout):
+    """Admission under pool pressure, through the full-sequence gate. The
+    per-request footprint is measured, not assumed; the pool is sized to six
+    requests of the NEW footprint plus less than one request's saving. ON
+    admits all six; the old layout cannot."""
+    on, off = _running_footprint("1", 160), _running_footprint("0", 160)
+    # 2 + K PLE state blocks (retained checkpoint included) and the ring block,
+    # minus the one shared ring page the new layout holds for everyone.
+    assert off - on == (2 + K) + 1 - 1
+    n = 6
+    margin = off - on - 1
+    manager = _manager(num_blocks=1 + n * on + margin)  # + the null block
+    admitted = []
+    for i in range(n):
+        req = _request(f"C{i}", _tokens(200 + i, 160))
+        if _prefill(manager, req, may_stall=True) is None:
+            break
+        _decode(manager, req, 3)
+        admitted.append(req)
+    if layout:
+        assert len(admitted) == n
+    else:
+        # FAILING CONTROL: the same pool fits fewer conversations.
+        assert len(admitted) < n
+    for req in admitted:
+        manager.free(req)
+    assert manager.block_pool.get_num_free_blocks() == n * on + margin
+
