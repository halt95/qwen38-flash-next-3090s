+def _side_cache_layout_enabled(vllm_config: VllmConfig) -> bool:
+    """Whether the v2.5 side-cache layout may apply to this engine.
+
+    KV connectors (NIXL, offload, P/D) address groups and blocks themselves
+    (the NIXL worker requires exactly one single-layer replicated group), and
+    HiSparse has its own pool layout, so those engines keep the old layout.
+    """
+    if not envs.VLLM_E2_SIDE_CACHE_LAYOUT:
+        return False
+    if getattr(vllm_config, "kv_transfer_config", None) is not None:
+        return False
+    attention_config = getattr(vllm_config, "attention_config", None)
+    if getattr(attention_config, "hisparse_config", None) is not None:
+        return False
+    parallel_config = getattr(vllm_config, "parallel_config", None)
+    if getattr(parallel_config, "decode_context_parallel_size", 1) not in (1, None):
+        return False
