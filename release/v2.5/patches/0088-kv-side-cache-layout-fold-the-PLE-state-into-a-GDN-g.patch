+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""v2.5 side-cache layout (``VLLM_E2_SIDE_CACHE_LAYOUT``, default ON).
+
+Flash-Next's packed block-outermost KV pool strides every block by the widest
+group (12,902,400 B on PP1 at FP32 SSM state) and every group draws whole
+blocks from it. The TP-replicated PLE short-conv state (one layer, 2 + K blocks
+per request in align mode) and the QSA raw-key ring (one block per request)
+hold ~1.2 MB of real state but took 6 of the 103 blocks a 262K request needs.
+The layout fix folds the PLE group into a GDN group that has a spare page on
+every PP stage, and packs several requests' rings into one pool block.
+
+What these tests pin (CPU only):
+
+1. Pool size. On the reference host's per-layer specs (TP2 x PP2, partition 25/23, MTP
+   K=3, fp8 KV, BLNHC, pin 4.1e9) the block count and both stages' strides are
+   unchanged and a 262K request needs 97 blocks instead of 103 at FP32 state
+   (173 instead of 179 at FP16). FAILING CONTROL: switch "0" reproduces the
+   logged pools (806,792 and 894,804 tokens) block for block.
+2. Allocation / eviction through ``KVCacheManager`` as the scheduler drives it
+   (aligned prefill chunks, MTP K=3 decode with draft acceptance, finish,
+   preemption, the deferred ``pop_blocks_for_free`` path, prefix hits with the
+   retained checkpoints). The PLE state's block table evolves exactly as
+   it did in its own group, hits are identical, and N rings share one pool
+   block. FAILING CONTROLS: with the switch off the same pool cannot admit the
+   extra request, and every ring takes its own block.
+3. Worker views. The ring slots and the folded PLE page lie inside their pool
+   block and overlap nothing they must not, and the KV zeroer zeroes exactly
+   the same bytes of every block in both layouts. FAILING CONTROL: a zeroer
+   built without the slot-group skip zeroes different bytes.
+"""
+
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm import envs
+from vllm.model_executor.layers.mamba.mamba_utils import MambaStateShapeCalculator
+from vllm.sampling_params import SamplingParams
+from vllm.utils.hashing import sha256
+from vllm.utils.math_utils import cdiv
+from vllm.v1.attention.backends.registry import MambaAttentionBackendEnum
+from vllm.v1.core import kv_cache_utils as ku
+from vllm.v1.core.block_pool import BlockPool
+from vllm.v1.core.kv_cache_manager import KVCacheManager
+from vllm.v1.core.kv_cache_utils import get_request_block_hasher, init_none_hash
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.core.single_type_kv_cache_manager import (
+    CircularBufferManager,
+    RingSlotPool,
+)
+from vllm.v1.kv_cache_interface import (
+    CircularBufferSpec,
+    FullAttentionSpec,
+    KVCacheLayout,
+    MambaSpec,
+    MLAAttentionSpec,
+    UniformTypeKVCacheSpecs,
+    get_kv_quant_mode,
+)
+from vllm.v1.request import Request
+
+pytestmark = pytest.mark.cpu_test
+
+SWITCH = "VLLM_E2_SIDE_CACHE_LAYOUT"
+TP = 2
+K = 3  # MTP num_speculative_tokens, as deployed
+PIN = 4_100_000_000  # --kv-cache-memory on every rank
+MAX_LEN = 262_144
+
+
+def _set_switch(monkeypatch, value: str) -> None:
+    monkeypatch.setenv(SWITCH, value)
+    if hasattr(envs.__getattr__, "cache_clear"):
+        envs.__getattr__.cache_clear()
+
+
+@pytest.fixture(params=["1", "0"], ids=["layout-on", "layout-off-control"])
+def layout(request, monkeypatch) -> bool:
+    _set_switch(monkeypatch, request.param)
+    return request.param == "1"
+
+
+@pytest.fixture(autouse=True)
+def _init_hash():
+    init_none_hash(sha256)
+
+
+# ---------------------------------------------------------------------------
+# Flash-Next per-layer specs (the reference fixture, in align mode, any block size
+# and SSM dtype). Boot log: "Setting attention block size to 3200 tokens" at FP32
+# state, 1664 at FP16; every Mamba page padded to the attention page.
+# ---------------------------------------------------------------------------
+def _flash_next_specs(
+    block: int = 3200,
+    ssm_dtype: torch.dtype = torch.float32,
+    *,
+    tiny_state: bool = False,
+) -> tuple[dict, dict]:
+    attn_page = block * 1 * 256 * 2  # fp8 K+V, 1 KV head per TP rank
+    main = FullAttentionSpec(
+        block_size=block,
+        num_kv_heads=2 // TP,
+        head_size=256,
+        head_size_v=256,
+        dtype=torch.uint8,
+        kv_quant_mode=get_kv_quant_mode("fp8_e4m3"),
+    )
+    ring = CircularBufferSpec(
+        block_size=8, num_kv_heads=1, head_size=144, head_size_v=0, dtype=torch.bfloat16
+    )
+    comp = MLAAttentionSpec(
+        block_size=block,
+        num_kv_heads=1,
+        head_size=128,
+        dtype=torch.bfloat16,
+        tokens_per_state=4,
+    )
+    if tiny_state:
+        # Small blocks for scheduler tests: the real states exceed the page.
+        gdn_shapes: tuple = ((4,),)
+        gdn_dtypes: tuple = (torch.float32,)
+        ple_shapes: tuple = ((2,),)
+    else:
+        gdn_shapes = tuple(
+            MambaStateShapeCalculator.gated_delta_net_state_shape(
+                TP, 16, 48, 128, 128, 4, K
+            )
+        )
+        gdn_dtypes = (torch.bfloat16, ssm_dtype)
+        ple_shapes = tuple(
+            MambaStateShapeCalculator.short_conv_state_shape(
+                tp_world_size=1, intermediate_size=10240, conv_kernel=10, num_spec=K
+            )
+        )
+    gdn = MambaSpec(
+        shapes=gdn_shapes,
+        dtypes=gdn_dtypes,
+        block_size=block,
+        page_size_padded=attn_page,
+        mamba_type=MambaAttentionBackendEnum.GDN_ATTN,
+        mamba_cache_mode="align",
+        num_speculative_blocks=K,
+    )
+    ple = MambaSpec(
+        shapes=ple_shapes,
+        dtypes=(torch.bfloat16,),
+        block_size=block,
+        page_size_padded=attn_page,
+        mamba_type=MambaAttentionBackendEnum.SHORT_CONV,
+        mamba_cache_mode="align",
+        tp_replicated=True,
+        num_speculative_blocks=K,
+    )
+
+    def qsa(prefix: str, specs: dict) -> None:
+        specs[f"{prefix}.self_attn.indexer.raw_key_cache"] = ring
+        specs[f"{prefix}.self_attn.indexer.compressed_key_cache"] = comp
+        specs[f"{prefix}.self_attn.attn"] = main
+
+    def stage(lo: int, hi: int, mtp: bool) -> dict:
+        specs: dict = {}
+        for i in range(lo, hi):
+            prefix = f"language_model.model.layers.{i}"
+            if i == 2:
+                specs[f"{prefix}.ple"] = ple
+            if i % 4 == 3:
+                qsa(prefix, specs)
+            else:
+                specs[f"{prefix}.linear_attn"] = gdn
+        if mtp:
+            qsa("mtp.layers.48", specs)
+        return specs
+
+    return stage(0, 25, False), stage(25, 48, True)
+
+
+def _vllm_config(
+    *,
+    override: int | None = None,
+    max_num_seqs: int = 8,
+    kv_transfer_config=None,
+    max_model_len: int = MAX_LEN,
+):
+    cache = SimpleNamespace(
+        kv_cache_layout="BLNHC",
+        num_gpu_blocks_override=override,
+        prefix_cache_retention_interval=0,
+        mamba_cache_mode="align",
+        get_resolved_kv_cache_layout=lambda: KVCacheLayout.BLNHC,
+    )
+    return SimpleNamespace(
+        cache_config=cache,
+        speculative_config=SimpleNamespace(
+            num_speculative_tokens=K,
+            method="mtp",
+            use_multi_module_mtp=lambda: False,
+            use_eagle=lambda: True,
+            use_eagle_block_drop=lambda: True,
+        ),
+        scheduler_config=SimpleNamespace(
+            disable_hybrid_kv_cache_manager=False,
+            max_num_encoder_input_tokens=0,
+            max_num_seqs=max_num_seqs,
+        ),
+        attention_config=SimpleNamespace(hisparse_config=None),
+        model_config=SimpleNamespace(
+            original_max_model_len=max_model_len,
+            max_model_len=max_model_len,
+            hf_config=SimpleNamespace(model_type="qwen4_exp"),
+            get_total_num_hidden_layers=lambda: 48,
+        ),
+        device_config=SimpleNamespace(device_type="cuda"),
+        parallel_config=SimpleNamespace(
+            pipeline_parallel_size=2, decode_context_parallel_size=1
+        ),
+        kv_transfer_config=kv_transfer_config,
+    )
+
+
+def _configs(block=3200, ssm_dtype=torch.float32, *, pin=PIN, **kw):
+    pp0, pp1 = _flash_next_specs(block, ssm_dtype, tiny_state=kw.pop("tiny", False))
+    cfg = _vllm_config(**kw)
+    specs = [pp0, pp0, pp1, pp1]  # TP2 x PP2
+    return cfg, specs, ku.get_kv_cache_configs(cfg, specs, [pin] * 4)
+
+
+def _first_spec(group):
+    spec = group.kv_cache_spec
+    return spec.first_spec if isinstance(spec, UniformTypeKVCacheSpecs) else spec
+
+
+def _request_blocks(cfg, config) -> int:
+    """Blocks one max_model_len request holds, as the boot's capacity line
+    counts them (shared ring pages excluded)."""
+    total = 0
+    for group in config.kv_cache_groups:
+        if group.slots_per_block > 1:
+            continue
+        total += cdiv(
+            group.kv_cache_spec.max_memory_usage_bytes(cfg),
+            group.kv_cache_spec.page_size_bytes,
+        )
+    return total
+
+
+# ---------------------------------------------------------------------------
+# 1. Pool size (blocks freed per request), FP32 and FP16 state.
+# ---------------------------------------------------------------------------
+# (block, ssm dtype, stage strides, blocks, per-request OFF, ON, pool OFF, ON)
+_POOL_CASES = {
+    "fp32": (
+        3200,
+        torch.float32,
+        (11_468_800, 12_902_400),
+        317,
+        103,
+        97,
+        806_792,
+        853_994,
+    ),
+    "fp16": (
+        1664,
+        torch.float16,
+        (5_963_776, 6_709_248),
+        611,
+        179,
+        173,
+        894_804,
+        924_322,
+    ),
+}
+
+
+@pytest.mark.parametrize("case", sorted(_POOL_CASES))
+def test_pool_blocks_per_request(case, layout):
+    block, dtype, strides, blocks, req_off, req_on, pool_off, pool_on = _POOL_CASES[
+        case
+    ]
+    cfg, specs, configs = _configs(block, dtype)
+    for rank, config in enumerate(configs):
+        # The pool itself does not move: same block count, same stride on
+        # both stages (PP1 binds), so not one byte of pin is spent.
+        assert config.num_blocks == blocks, f"rank {rank}"
+        assert (
+            ku._get_kv_cache_bytes_per_block(config.kv_cache_groups)
+            == strides[rank // 2]
+        )
+    per_request = _request_blocks(cfg, configs[0])
+    capacity, _ = ku.get_kv_cache_capacity(cfg, configs[0])
+    if layout:
+        assert per_request == req_on
+        assert req_off - per_request == 6  # 5 PLE + 1 ring blocks freed
+        assert capacity == pool_on
+    else:
+        # FAILING CONTROL: the old layout, exactly as the reference host logged it
+        # ("GPU KV cache size: 806,792 tokens" / "894,804 tokens").
+        assert per_request == req_off
+        assert capacity == pool_off
+    # Every rank agrees, and so does the scheduler's config, which is what
+    # update_kv_cache_capacity logs at boot ("GPU KV cache size: N tokens").
+    assert {ku.get_kv_cache_capacity(cfg, c)[0] for c in configs} == {capacity}
+    sched = ku.generate_scheduler_kv_cache_config(configs)
+    assert ku.get_kv_cache_capacity(cfg, sched)[0] == capacity
+
+
+def test_ple_rides_in_a_gdn_group_with_a_spare_page(layout):
+    _, specs, configs = _configs()
+    ple = "language_model.model.layers.2.ple"
+    for rank, config in enumerate(configs):
+        tensor_layers = sorted(n for t in config.kv_cache_tensors for n in t.layers)
+        assert tensor_layers == sorted(specs[rank]), f"rank {rank}"
+        owner = [g for g in config.kv_cache_groups if ple in g.layer_names]
+        mamba_groups = [
+            g for g in config.kv_cache_groups if isinstance(_first_spec(g), MambaSpec)
+        ]
+        if rank >= 2:
+            assert not owner  # PLE lives on PP0 only
+        if layout:
+            assert len(mamba_groups) == 3
+            assert all(g.layer_names for g in config.kv_cache_groups)
+            if rank < 2:
+                [group] = owner
+                gdn = [n for n in group.layer_names if n.endswith("linear_attn")]
+                assert len(gdn) == 6 and group.layer_names[-1] == ple
+        else:
+            # FAILING CONTROL: its own group, empty on PP1 (the reference shape).
+            assert len(mamba_groups) == 4
+            if rank < 2:
+                assert owner[0].layer_names == [ple]
+
+
+def test_ring_slots_divide_both_stage_strides():
+    _, _, configs = _configs()
+    rings = [
+        (rank, g)
+        for rank, c in enumerate(configs)
+        for g in c.kv_cache_groups
+        if isinstance(_first_spec(g), CircularBufferSpec)
+    ]
+    assert {g.slots_per_block for _, g in rings} == {800}
+    for rank, config in enumerate(configs):
+        stride = ku._get_kv_cache_bytes_per_block(config.kv_cache_groups)
+        for tensor in config.kv_cache_tensors:
+            if tensor.slots_per_block > 1:
+                assert tensor.block_stride * tensor.slots_per_block == stride
+                assert tensor.block_stride % 256 == 0
+                assert tensor.block_stride >= len(tensor.layers) * 2304
+                assert config.num_blocks_of(tensor) == config.num_blocks * 800
+
+
+def test_kv_connector_keeps_the_old_layout(monkeypatch):
+    """NIXL / offload / P/D address groups themselves: layout stays off."""
+    _set_switch(monkeypatch, "1")
+    cfg, _, configs = _configs(kv_transfer_config=SimpleNamespace())
+    assert _request_blocks(cfg, configs[0]) == 103
+    assert all(g.slots_per_block == 1 for g in configs[0].kv_cache_groups)
+
+
+def test_fold_never_widens_a_stage(monkeypatch):
+    """The PP-aware target choice. Folding into GDN group 0 (7 pages on PP0)
+    would widen PP0's block to 8 pages; the pass must pick a 6-page group.
+    CONTROL: the forced group-0 fold really does widen PP0."""
+    _set_switch(monkeypatch, "0")
+    pp0, pp1 = _flash_next_specs()
+    specs = [pp0, pp0, pp1, pp1]
+    merged: dict = {}
+    for s in specs:
+        merged.update(s)
+    groups = ku.get_kv_cache_groups(_vllm_config(), merged)
+    base = ku._worker_strides(groups, specs)
+    folded, notes = ku._fold_replicated_mamba_groups(groups, specs)
+    assert ku._worker_strides(folded, specs) == base
+    assert len(folded) == len(groups) - 1 and "into Mamba group 1" in notes[0]
+
+    ple_index = next(
+        i
+        for i, g in enumerate(groups)
+        if any(n.endswith(".ple") for n in g.layer_names)
+    )
+    g0 = groups[0]
+    forced = UniformTypeKVCacheSpecs(
+        block_size=g0.kv_cache_spec.block_size,
+        kv_cache_specs={
+            **g0.kv_cache_spec.kv_cache_specs,
+            **groups[ple_index].kv_cache_spec.kv_cache_specs,
+        },
+    )
+    wrong = [
+        replace(
+            g0,
+            layer_names=g0.layer_names + groups[ple_index].layer_names,
+            kv_cache_spec=forced,
+        )
+    ]
+    wrong += [g for i, g in enumerate(groups) if i not in (0, ple_index)]
+    widened = ku._worker_strides(wrong, specs)
+    assert widened[0] == base[0] + 1_638_400  # PP0: 8 pages instead of 7
+
+
+# ---------------------------------------------------------------------------
+# 2. Allocation / eviction through KVCacheManager (tiny states, block 32).
+# ---------------------------------------------------------------------------
+BLOCK = 32
+PLE = "language_model.model.layers.2.ple"
+
+
+SCHED_MAX_LEN = 512  # small, so small test pools pass the boot memory check
+
+
+def _manager(num_blocks: int) -> KVCacheManager:
+    _, _, configs = _configs(
+        BLOCK, tiny=True, override=num_blocks, max_model_len=SCHED_MAX_LEN
+    )
+    config = ku.generate_scheduler_kv_cache_config(configs)
+    return KVCacheManager(
+        replace(config, prefix_cache_retention_interval=0),
+        max_model_len=SCHED_MAX_LEN,
+        scheduler_block_size=BLOCK,
+        hash_block_size=BLOCK,
+        enable_caching=True,
+        use_eagle=True,
+    )
+
+
+def _group_of(manager: KVCacheManager, layer: str) -> int:
+    return next(
+        i
+        for i, g in enumerate(manager.kv_cache_config.kv_cache_groups)
+        if layer in g.layer_names
+    )
+
+
+def _ring_gid(manager: KVCacheManager) -> int:
+    return next(
+        i
+        for i, m in enumerate(manager.coordinator.single_type_managers)
+        if type(m) is CircularBufferManager
+    )
+
+
+def _ring(manager: KVCacheManager) -> CircularBufferManager:
+    mgr = manager.coordinator.single_type_managers[_ring_gid(manager)]
+    assert isinstance(mgr, CircularBufferManager)
+    return mgr
+
+
+def _request(rid: str, tokens: list[int]) -> Request:
+    params = SamplingParams(max_tokens=4096)
+    params.update_from_generation_config({}, eos_token_id=100000)
+    return Request(
+        request_id=rid,
+        prompt_token_ids=tokens,
+        sampling_params=params,
+        pooling_params=None,
+        block_hasher=get_request_block_hasher(BLOCK, sha256),
+    )
+
+
+def _tokens(seed: int, n: int) -> list[int]:
+    return [seed * 10000 + i for i in range(n)]
+
+
+def _split(request: Request, num_new: int, num_local_hit: int = 0) -> int:
+    stub = SimpleNamespace(
+        block_size=BLOCK,
+        cache_config=SimpleNamespace(block_size=BLOCK),
+        use_eagle_block_drop=True,
+        max_num_scheduled_tokens=8192,
+        scheduler_config=SimpleNamespace(long_prefill_token_threshold=0),
+        mamba_partial_cache_hit=False,
+        mamba_fine_grained_prefix_cache=False,
+        hash_block_size=BLOCK,
+        mamba_has_prefill_checkpoint_blocks=False,
+        mamba_prefill_checkpoint_alignment=None,
+    )
+    return Scheduler._mamba_block_aligned_split(stub, request, num_new, num_local_hit)
+
+
+def _prefill(manager, request, budget=40, trace=None, may_stall=False) -> int | None:
+    """Prefill in scheduler-sized chunks; None if admission is refused (or,
+    with ``may_stall``, if a later chunk does not fit -- the request is then
+    freed, as a scheduler would preempt it)."""
+    computed, num_hit, _ = manager.get_computed_blocks(request)
+    first = True
+    while request.num_computed_tokens < request.num_tokens:
+        start = request.num_computed_tokens + (num_hit if first else 0)
+        num_new = _split(
+            request, min(request.num_tokens - start, budget), num_hit if first else 0
+        )
+        blocks = manager.allocate_slots(
+            request,
+            num_new,
+            num_new_computed_tokens=num_hit if first else 0,
+            new_computed_blocks=computed if first else None,
+            num_lookahead_tokens=K,
+            full_sequence_must_fit=first,
+        )
+        if blocks is None:
+            if not first:
+                assert may_stall, "a later prefill chunk did not fit"
+                manager.free(request)
+            return None
+        request.num_computed_tokens = start + num_new
+        manager.new_step_starts()
+        first = False
+        if trace is not None:
+            trace()
+    return num_hit
+
+
+def _decode(manager, request, steps, accepted=lambda step: 0, trace=None) -> None:
+    next_tok = 50000 + len(request.output_token_ids)
+    if request.num_computed_tokens == request.num_tokens:
+        request.append_output_token_ids(next_tok)
+        next_tok += 1
+    for step in range(steps):
+        request.spec_token_ids = [next_tok + i for i in range(K)]
+        assert manager.allocate_slots(request, 1 + K, num_lookahead_tokens=K)
+        n_acc = accepted(step)
+        request.spec_token_ids = []
+        request.num_computed_tokens += 1 + n_acc
+        request.append_output_token_ids(list(range(next_tok, next_tok + n_acc + 1)))
+        next_tok += n_acc + 1
+        manager.new_step_starts()
+        if trace is not None:
+            trace()
+
+
+def _pattern(blocks) -> tuple:
+    """A block table with ids renamed by first appearance (null = -1), so two
+    layouts can be compared position by position."""
+    names: dict[int, int] = {}
+    return tuple(
+        -1 if b.is_null else names.setdefault(b.block_id, len(names)) for b in blocks
+    )
+
+
+def _trajectory(manager: KVCacheManager, accept_seed: int = 7) -> list:
+    """Run A (prefill + MTP decode across block boundaries, varying accepts),
+    finish it, resume it as A2 (prefix hit), run cold B beside it, free B via
+    the deferred path, resume it as B2, and record, after every step, the
+    block-table pattern of the attention group, of the PLE layer's group and
+    of every GDN group, the ring table width, and every hit length."""
+    groups = manager.kv_cache_config.kv_cache_groups
+    ple_gid = _group_of(manager, PLE)
+    gdn_gids = [
+        i
+        for i, g in enumerate(groups)
+        if any(n.endswith("linear_attn") for n in g.layer_names)
+    ]
+    attn_gid = _group_of(manager, "language_model.model.layers.3.self_attn.attn")
+    ring_gid = _ring_gid(manager)
+    log: list = []
+    live: list[Request] = []
+
+    def trace():
+        for req in live:
+            blocks = manager.coordinator.get_blocks(req.request_id)
+            if not blocks[attn_gid]:
+                continue
+            log.append(
+                (
+                    req.request_id,
+                    _pattern(blocks[attn_gid]),
+                    _pattern(blocks[ple_gid]),
+                    tuple(sorted(_pattern(blocks[g]) for g in gdn_gids)),
+                    len(blocks[ring_gid]),
+                )
+            )
+
+    a = _request("A", _tokens(1, 150))
+    live.append(a)
+    log.append(("hitA", _prefill(manager, a, trace=trace)))
+    _decode(manager, a, 30, accepted=lambda s: (s * accept_seed) % 4, trace=trace)
+    manager.free(a)
+    live.remove(a)
+    a2 = _request("A2", list(a.all_token_ids) + _tokens(3, 40))
+    live.append(a2)
+    log.append(("hitA2", _prefill(manager, a2, trace=trace)))
+    b = _request("B", _tokens(4, 120))
+    live.append(b)
+    log.append(("hitB", _prefill(manager, b, trace=trace)))
+    _decode(manager, a2, 6, accepted=lambda s: s % 4, trace=trace)
+    _decode(manager, b, 3, trace=trace)
+    popped = manager.pop_blocks_for_free(b)  # deferred free (the block-free fence)
+    live.remove(b)
+    manager.block_pool.free_blocks(popped)  # the scheduler's fenced drain
+    b2 = _request("B2", list(b.all_token_ids) + _tokens(5, 10))
+    live.append(b2)
+    log.append(("hitB2", _prefill(manager, b2, trace=trace)))
+    for req in (a2, b2):
+        manager.free(req)
+    return log
+
+
+def test_ple_block_table_and_hits_match_the_old_layout(monkeypatch):
+    """The PLE layer's block table (null/live positions, which entries share a
+    block across steps) and every hybrid hit length are the same as when it
+    had its own group: its kernels index the same state positions, so its
+    outputs cannot change. A large pool keeps eviction out of the comparison.
+    The retained checkpoints are on (the default) in both runs."""
+    runs = {}
+    for value in ("0", "1"):
+        _set_switch(monkeypatch, value)
+        manager = _manager(num_blocks=400)
+        assert envs.VLLM_E2_MAMBA_RETAIN_CHECKPOINT
+        runs[value] = _trajectory(manager)
+        # Nothing leaked: only the null block is not free.
+        assert manager.block_pool.get_num_free_blocks() == 399
+    assert len(runs["1"]) > 50
+    assert runs["1"] == runs["0"]
+    hits = {
+        e[0]: e[1] for e in runs["1"] if isinstance(e[0], str) and e[0][:3] == "hit"
+    }
+    assert hits["hitA"] == 0 and hits["hitB"] == 0
+    assert hits["hitA2"] > 0 and hits["hitB2"] > 0  # real hits were compared
+    # CONTROL: the comparison is not vacuous -- a different accept pattern
+    # gives different tables, and the comparator sees it.
+    manager = _manager(num_blocks=400)
+    assert _trajectory(manager, accept_seed=1) != runs["1"]
+
+
+def _held(manager: KVCacheManager) -> set[int]:
+    ids: set[int] = set()
+    for mgr in manager.coordinator.single_type_managers:
+        pool = getattr(mgr, "slot_pool", None)
+        if pool is not None:
+            ids |= set(pool._pages)
+            continue
+        for blocks in mgr.req_to_blocks.values():
+            ids |= {b.block_id for b in blocks if not b.is_null}
+        held = getattr(mgr, "_retained_checkpoints", {})
+        ids |= {blk.block_id for _, blk in held.values()}
+    return ids
+
+
+def _owner_count(manager: KVCacheManager) -> int:
+    """Owner references to pool blocks, counting shared prefix blocks once
+    per holder. Equal to len(_held) iff no block has two exclusive owners."""
+    total = 0
+    for mgr in manager.coordinator.single_type_managers:
+        pool = getattr(mgr, "slot_pool", None)
+        if pool is not None:
+            total += pool.num_pages
+            continue
+        total += len(
+            {
+                b.block_id
+                for blocks in mgr.req_to_blocks.values()
+                for b in blocks
+                if not b.is_null
+            }
+        )
+        total += len(getattr(mgr, "_retained_checkpoints", {}))
+    return total
+
+
+def test_rings_share_one_pool_block_and_pool_partitions(layout):
+    manager = _manager(num_blocks=400)
+    pool = manager.block_pool
+    ring = _ring(manager)
+    reqs = [_request(f"R{i}", _tokens(10 + i, 70)) for i in range(5)]
+    for req in reqs:
+        assert _prefill(manager, req) == 0
+        _decode(manager, req, 2)
+        # Partition: every non-null block is free XOR held, by one owner.
+        assert pool.get_num_free_blocks() + len(_held(manager)) == 399
+        assert _owner_count(manager) == len(_held(manager))
+    ring_ids = [ring.get_ring_block_ids(r.request_id)[0] for r in reqs]
+    assert len(set(ring_ids)) == 5
+    claimed = manager.take_new_ring_block_ids()
+    assert claimed == ring_ids  # tag clears name exactly the claimed ids
+    if layout:
+        slots = ring.slot_pool.slots_per_block
+        assert slots > 5
+        assert ring.slot_pool.num_pages == 1  # five rings, one pool block
+        assert len({rid // slots for rid in ring_ids}) == 1
+        assert sorted(rid % slots for rid in ring_ids) == [0, 1, 2, 3, 4]
+    else:
+        # FAILING CONTROL: one pool block per ring.
+        assert ring.slot_pool is None
+        assert all(pool.blocks[rid].ref_cnt == 1 for rid in ring_ids)
+    # Free in a mixed order, one through the deferred path.
+    manager.free(reqs[1])
+    popped = manager.pop_blocks_for_free(reqs[3])
+    if layout:
+        # The popped slot is not reusable before the fence: still live.
+        assert ring.slot_pool.num_live_slots == 4
+    manager.block_pool.free_blocks(popped)
+    if layout:
+        assert ring.slot_pool.num_live_slots == 3
+        # A new request reuses the lowest free slot of the same page.
+        r5 = _request("R5", _tokens(30, 70))
+        _prefill(manager, r5)
+        assert ring.get_ring_block_ids("R5") == [ring_ids[1]]
+        manager.free(r5)
+    for req in (reqs[0], reqs[2], reqs[4]):
+        manager.free(req)
+    assert pool.get_num_free_blocks() == 399
+    if layout:
+        assert ring.slot_pool.num_pages == 0
+
