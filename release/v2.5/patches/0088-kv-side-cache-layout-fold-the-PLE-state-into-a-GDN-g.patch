+def test_ring_slot_pool_unit():
+    pool = BlockPool(num_gpu_blocks=6, enable_caching=True, hash_block_size=16)
+    slots = RingSlotPool(pool, slots_per_block=3)
+    got = slots.get_new_blocks(4)
+    assert [b.block_id // 3 for b in got] == [got[0].block_id // 3] * 3 + [
+        got[3].block_id // 3
+    ]
+    assert slots.num_pages == 2 and pool.get_num_free_blocks() == 3
+    # Routed through the main pool's free path (as the scheduler drain does).
+    pool.free_blocks([got[3]])
+    assert slots.num_pages == 1 and pool.get_num_free_blocks() == 4
+    pool.free_blocks(got[:2])
+    assert slots.has_free_slot() and slots.num_pages == 1
+    with pytest.raises(AssertionError):
+        slots.free_blocks([got[0]])  # double free is loud
+    pool.free_blocks([got[2]])
+    assert slots.num_pages == 0 and pool.get_num_free_blocks() == 5
