+def _is_ring_group(group: KVCacheGroupSpec) -> bool:
+    spec = group.kv_cache_spec
+    layer_specs = (
+        list(spec.kv_cache_specs.values())
+        if isinstance(spec, UniformTypeKVCacheSpecs)
+        else [spec]
+    )
+    return bool(layer_specs) and all(
+        type(layer_spec) is CircularBufferSpec for layer_spec in layer_specs
