+            if all(
+                stride % slots == 0
+                and (stride // slots) % _RING_SLOT_ALIGN == 0
+                and stride // slots >= ring_bytes
+                for stride, ring_bytes in needs
+            ):
+                chosen[group_index] = slots
+                break
