+class _RingSlotPage:
+    """One pool block shared by up to ``slots`` requests' rings."""
+
+    __slots__ = ("block", "free_slots", "live")
+
+    def __init__(self, block: KVCacheBlock, slots: int) -> None:
+        self.block = block
+        # Highest first, so pop() hands out the lowest free slot.
+        self.free_slots = list(range(slots - 1, -1, -1))
+        self.live = 0
+
+
+class RingSlotPool:
+    """v2.5 side-cache layout: ring blocks as slots of shared pool blocks.
+
+    The QSA ring needs one block per request for the request's lifetime, but
+    its pages for every layer of a stage are ~16 KB against a 12.9 MB pool
+    block. This pool takes whole blocks from the main ``BlockPool`` and cuts
+    each into ``slots_per_block`` slots; a slot's block id is
+    ``pool_block_id * slots_per_block + slot``, which is exactly the index of
+    the slot in the worker's ring view (``KVCacheTensor.slots_per_block``).
+
+    The slot blocks it hands out carry ``pool=self``, so every existing free
+    path -- ``SingleTypeKVCacheManager.free``, the coordinator's deferred
+    ``pop_blocks_for_free`` and the scheduler's fenced drain, which all call
+    ``BlockPool.free_blocks`` -- routes them back here, at the time the old
+    per-request block would have gone back (the deferred free is kept). A pool
+    block returns to the main pool when its last slot is freed. Rings are never
+    prefix-cached, so a slot block carries no hash.
+    """
+
+    def __init__(self, block_pool: BlockPool, slots_per_block: int) -> None:
+        assert slots_per_block > 1
+        self.block_pool = block_pool
+        self.slots_per_block = slots_per_block
+        # Pool block id -> page, in claim order (the oldest page fills first).
+        self._pages: dict[int, _RingSlotPage] = {}
+
+    @property
+    def num_pages(self) -> int:
+        """Pool blocks currently held for rings."""
+        return len(self._pages)
+
+    @property
+    def num_live_slots(self) -> int:
+        return sum(page.live for page in self._pages.values())
+
+    def has_free_slot(self) -> bool:
+        return any(page.free_slots for page in self._pages.values())
+
+    def get_new_blocks(self, num_blocks: int) -> list[KVCacheBlock]:
+        out: list[KVCacheBlock] = []
+        for _ in range(num_blocks):
+            page = next((p for p in self._pages.values() if p.free_slots), None)
+            if page is None:
+                (pool_block,) = self.block_pool.get_new_blocks(1)
+                page = _RingSlotPage(pool_block, self.slots_per_block)
+                self._pages[pool_block.block_id] = page
+            slot = page.free_slots.pop()
+            page.live += 1
+            out.append(
+                KVCacheBlock(
+                    page.block.block_id * self.slots_per_block + slot,
+                    ref_cnt=1,
+                    pool=self,  # type: ignore[arg-type]
+                )
+            )
+        return out
+
+    def free_blocks(self, ordered_blocks) -> None:
+        released: list[KVCacheBlock] = []
+        for block in ordered_blocks:
+            assert block.pool is self, "not a ring slot of this pool"
+            block.ref_cnt -= 1
+            assert block.ref_cnt == 0, "ring slots have a single owner"
+            page_id, slot = divmod(block.block_id, self.slots_per_block)
+            page = self._pages[page_id]
+            assert slot not in page.free_slots, f"slot {block.block_id} freed twice"
+            page.free_slots.append(slot)
+            page.free_slots.sort(reverse=True)
+            page.live -= 1
+            if page.live == 0:
+                del self._pages[page_id]
+                released.append(page.block)
+        if released:
+            self.block_pool.free_blocks(released)
+
