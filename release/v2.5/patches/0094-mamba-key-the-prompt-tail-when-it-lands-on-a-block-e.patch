+    def _block_aligned_prompt_tail(self, request: Request) -> int:
+        """The prompt's tail key when it falls on a block end, else 0.
+
+        Only with a hash unit finer than the block (at the block unit the
+        tail IS the replay boundary, which the mask already keeps). The key
+        is placed exactly as `_cache_partial_tail_block` places a sub-block
+        tail, eagle shift included.
+        """
+        hash_block_size = self.block_pool.hash_block_size
+        if self.mamba_cache_mode != "align" or self.block_size <= hash_block_size:
+            return 0
+        tail = request.num_prompt_tokens // hash_block_size * hash_block_size
+        if self.drop_eagle_checkpoint_block:
+            tail = max(tail - hash_block_size, 0)
+        return tail if tail % self.block_size == 0 else 0
