+@pytest.mark.parametrize("resume", ["cold", "partial-tail"])
+def test_block_aligned_tail_key_is_hashed_and_held(tail_retain, resume):
+    """The prompt's tail key can land exactly on a block end (1 in
+    block/unit turns). It is then a full-block key: `_cache_partial_tail_block`
+    registers nothing, and under retention interval 0 the mask kept only the
+    replay boundary one block below it, so that state was never hashed. The
+    next turn then resumed one block (cold) or one turn (partial-tail resume:
+    at the held source) lower. Now the tail block is hashed, retired into the
+    hold like any boundary state, survives a concurrent burst, and the next
+    turn resumes at the tail itself. At the block unit nothing changes: the
+    tail is the replay boundary.
+    """
+    num_blocks = 96
+    manager = _tail_manager(num_blocks)
+    pool = manager.block_pool
+    mamba = _tail_mamba(manager)
+
+    if resume == "cold":
+        # 136 tokens: tail 128 = 4 blocks exactly; replay boundary 96.
+        a1 = make_request("A1", _tail_tokens(1, 136), TAIL_HASH, sha256)
+        below = 3 * TAIL_BLOCK
+        assert _tail_prefill(manager, a1) == 0
+    else:
+        a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+        _tail_prefill(manager, a0)
+        _tail_decode(manager, a0, steps=4)
+        manager.free(a0)
+        _tail_drain_copies(manager)
+        a1 = _tail_followup(a0, 13, seed=2, aligned_tail=True)
+        below = _tail_position(a0.num_prompt_tokens)  # the held source
+        assert _tail_prefill(manager, a1) == below
+        assert below % TAIL_BLOCK != 0
+    tail = _tail_position(a1.num_prompt_tokens)
+    assert tail % TAIL_BLOCK == 0 and tail > below
+    _tail_decode(manager, a1, steps=4)
+
+    # The tail state is keyed (without the block-end tail key the next turn
+    # resumed at `below` instead).
+    cached = pool.get_cached_block(a1.block_hashes[tail // TAIL_HASH - 1], [TAIL_MAMBA])
+    assert cached is not None, f"tail state@{tail} is not keyed (block-end tail)"
+    [tail_block] = cached
+    assert tail_block.block_hash_num_tokens == tail
+    if tail_retain:
+        assert mamba._retained_checkpoints[a1.request_id] == (tail, tail_block)
+        assert tail_block.ref_cnt == 1
+    else:
+        assert tail_block.ref_cnt == 0
+
+    # Concurrent prefills pop every free block while A1 decodes.
+    taken = pool.get_new_blocks(pool.get_num_free_blocks())
+    assert (tail_block.block_hash is not None) is tail_retain
+    pool.free_blocks(taken)
+
+    manager.free(a1)
+    _tail_drain_copies(manager)
+    a2 = _tail_followup(a1, 20, seed=3)
+    _, num_hit, _ = manager.get_computed_blocks(a2)
+    assert num_hit == (tail if tail_retain else 0)
+
+    _tail_prefill(manager, a2)
+    _tail_decode(manager, a2, steps=2)
+    manager.free(a2)
+    _tail_drain_copies(manager)
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_block_unit_replay_boundary_is_unchanged():
+    """At the block unit (U = block) the tail helper is inert and the hashed
+    boundary set is exactly the replay boundary, as before."""
+    hash_block_size = block_size = 32
+    kv_cache_config = KVCacheConfig(
+        num_blocks=64,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["full"],
+                FullAttentionSpec(
+                    block_size=block_size, num_kv_heads=1, head_size=1, dtype=torch.float32
+                ),
+            ),
+            KVCacheGroupSpec(
+                ["mamba"],
+                MambaSpec(
+                    block_size=block_size,
+                    shapes=(1, 1),
+                    dtypes=(torch.float32,),
+                    mamba_cache_mode="align",
+                    num_speculative_blocks=TAIL_SPEC,
+                ),
+            ),
+        ],
+    )
+    manager = make_kv_cache_manager(
+        kv_cache_config=kv_cache_config,
+        max_model_len=8192,
+        enable_caching=True,
+        hash_block_size=hash_block_size,
+        use_eagle=True,
+        retention_interval=0,
+    )
+    mamba = manager.coordinator.single_type_managers[TAIL_MAMBA]
+    # 136 tokens: tail key 96 (eagle) = the replay boundary; the scheduler
+    # cuts the prefill there (last cacheable block end), then the rest.
+    request = make_request("R", _tail_tokens(1, 136), hash_block_size, sha256)
+    [boundary] = set(manager.coordinator.get_replay_boundaries(request))
+    assert boundary == 96
+    if hasattr(mamba, "_block_aligned_prompt_tail"):
+        assert mamba._block_aligned_prompt_tail(request) == 0
+    for chunk in (96, 40):
+        assert manager.allocate_slots(request, chunk, num_lookahead_tokens=TAIL_SPEC)
+        request.num_computed_tokens += chunk
+        manager.new_step_starts()
+    hashed = [
+        i * block_size
+        for i in range(1, 136 // block_size + 1)
+        if manager.block_pool.get_cached_block(
+            request.block_hashes[i - 1], [TAIL_MAMBA]
+        )
+    ]
+    assert hashed == [boundary]
