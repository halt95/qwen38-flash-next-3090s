@@ -78,8 +78,12 @@ def prepare_commit_plan_kernel(
             tl.int32
         )
         final_num_computed = num_computed + commit_len
+        # The committed state belongs to the block holding the last committed
+        # token. A window ending exactly on a boundary stays in that block; the
+        # next block may still be unallocated.
         final_state_col = tl.minimum(
-            final_num_computed // mamba_block_size, block_table_width - 1
+            tl.maximum(final_num_computed - 1, 0) // mamba_block_size,
+            block_table_width - 1,
         )
         final_state_idx = tl.load(
             block_table_ptr
diff --git a/vllm/v1/worker/gpu/model_states/recoverssm.py b/vllm/v1/worker/gpu/model_states/recoverssm.py
index cfbe1a4d45..b02a6c19aa 100644
--- a/vllm/v1/worker/gpu/model_states/recoverssm.py
+++ b/vllm/v1/worker/gpu/model_states/recoverssm.py
@@ -91,10 +91,12 @@ def _postprocess_recoverssm_align_kernel(
         return
     num_sampled = tl.load(num_sampled_ptr + batch_idx)
     num_computed = tl.load(num_computed_ptr + batch_idx)
+    # Match the commit plan: the running state lives in the block holding the
