From 18a7052f3228eff3030c2ff6ee676eae80adc513 Mon Sep 17 00:00:00 2001
From: halt95 <halt95@users.noreply.github.com>
Date: Mon, 5 Oct 2026 00:13:13 -0400
Subject: [PATCH 91/97] config, envs: pass use_replayssm to the breakable-graph
 fallback; register VLLM_FAIL_ON_PROFILING_KV_LEAK

CompilationConfig.resolve_cudagraph_mode_and_sizes read self.cache_config.use_replayssm, but CompilationConfig has
no cache_config, so with VLLM_USE_BREAKABLE_CUDAGRAPH=1 the fallback branch raised AttributeError. Both model
runners now pass cache_config.use_replayssm as an argument. The shipped launchers set VLLM_USE_BREAKABLE_CUDAGRAPH=0
and never reach this branch.

VLLM_FAIL_ON_PROFILING_KV_LEAK was read with a raw os.getenv, so setting it printed the unknown-variable warning. It
is now registered in vllm.envs with the same spellings (unset fails the boot; 0, false or no warn instead), listed
as an ignored compile factor and read through vllm.envs. Tests cover both.
---
 tests/config/test_recoverssm_config.py | 27 ++++++++++++++++++++++++++
 tests/test_envs.py                     | 19 ++++++++++++++++++
 vllm/config/compilation.py             |  4 +++-
 vllm/envs.py                           | 13 +++++++++++++
 vllm/v1/worker/gpu/cudagraph_utils.py  |  6 ++----
 vllm/v1/worker/gpu/model_runner.py     |  1 +
 vllm/v1/worker/gpu_model_runner.py     |  1 +
 7 files changed, 66 insertions(+), 5 deletions(-)

diff --git a/tests/config/test_recoverssm_config.py b/tests/config/test_recoverssm_config.py
index 352b8bfc7c..50d5aa0096 100644
--- a/tests/config/test_recoverssm_config.py
+++ b/tests/config/test_recoverssm_config.py
@@ -197,5 +197,32 @@ def test_never_support_falls_back_to_piecewise_with_breakable_cudagraphs(
         AttentionCGSupport.NEVER,
         "GDNRecoverSSMAttentionBackend",
         uniform_decode_query_len=4,
+        use_replayssm=True,
     )
     assert resolved.name == expected
+
+
+def test_breakable_fallback_needs_replayssm_and_never_reads_cache_config(monkeypatch):
+    """The breakable-graph branch reads the RecoverSSM flag from its argument:
+    CompilationConfig has no cache_config, and reading one raised AttributeError
+    whenever VLLM_USE_BREAKABLE_CUDAGRAPH=1. Without RecoverSSM the branch is not
+    taken, so the unsupported FULL decode mode falls back to NONE."""
+    from vllm.config.compilation import (
+        CompilationConfig,
+        CompilationMode,
+        CUDAGraphMode,
+    )
+
+    monkeypatch.setenv("VLLM_USE_BREAKABLE_CUDAGRAPH", "1")
+    compilation_config = CompilationConfig(
+        mode=CompilationMode.NONE,
+        cudagraph_mode=CUDAGraphMode.FULL_AND_PIECEWISE,
+        splitting_ops=[],
+    )
+    assert not hasattr(compilation_config, "cache_config")
+    resolved = compilation_config.resolve_cudagraph_mode_and_sizes(
+        AttentionCGSupport.NEVER,
+        "GDNRecoverSSMAttentionBackend",
+        uniform_decode_query_len=4,
+    )
+    assert resolved.name == "NONE"
