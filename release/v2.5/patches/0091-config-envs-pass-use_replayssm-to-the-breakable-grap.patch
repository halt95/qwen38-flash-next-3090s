     "VLLM_E2_SIDE_CACHE_LAYOUT": "vllm/v1/core/kv_cache_utils.py",
+    "VLLM_FAIL_ON_PROFILING_KV_LEAK": "vllm/v1/worker/gpu/cudagraph_utils.py",
 }
 _INERT_NO_READ_SITE = ["VLLM_PLE_FP8_GLOBAL_SCALE"]
 
@@ -1151,3 +1154,19 @@ def test_side_cache_layout_switch_defaults_on_and_is_strict(
         monkeypatch.setenv(name, bad)
         with pytest.raises(ValueError, match=name):
             _fresh_env_value(name)
+
+
+def test_fail_on_profiling_kv_leak_is_registered_and_defaults_to_fail(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    """Registered (no unknown-variable warning), unset fails the boot, and the three
+    documented spellings downgrade it to a warning."""
+    name = "VLLM_FAIL_ON_PROFILING_KV_LEAK"
+    assert name in envs.environment_variables
+    monkeypatch.delenv(name, raising=False)
+    assert _fresh_env_value(name) is True
+    for off in ("0", "false", "No"):
+        monkeypatch.setenv(name, off)
+        assert _fresh_env_value(name) is False
+    monkeypatch.setenv(name, "1")
+    assert _fresh_env_value(name) is True
