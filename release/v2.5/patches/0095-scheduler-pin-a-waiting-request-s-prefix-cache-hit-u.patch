+    def _log_prefix_cache_features(self) -> None:
+        """One startup line per prefix-cache retention feature that is active
+        (nothing when it is off)."""
+        manager = self.kv_cache_manager
+        if manager.enable_caching and self.connector is None:
+            logger.info(
+                "Prefix cache: waiting requests' cached prefixes are pinned "
+                "until admission (up to %d waiters; hash unit %d, block %d)",
+                manager.MAX_PINNED_WAITERS,
+                self.hash_block_size,
+                self.block_size,
+            )
+
+    def _pin_waiting_hits(self) -> None:
+        """Pin the prefix-cache hits of the requests at the front of the
+        waiting queue (arrival order, bounded by the manager) so the
+        admissions and decode growth of other requests cannot evict them
+        while they wait -- also while the running set is full, when they are
+        not even looked up. Released on admission, free, and whenever a
+        running request would otherwise fail to allocate.
+        """
+        manager = self.kv_cache_manager
+        if (
+            not manager.enable_caching
+            or self.connector is not None
+            or manager.num_pinned_waiters >= manager.MAX_PINNED_WAITERS
+        ):
