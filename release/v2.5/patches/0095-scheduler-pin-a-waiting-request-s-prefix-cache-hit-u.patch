+# ---------------------------------------------------------------------------
+# A waiting follow-up's prefix-cache hit is pinned until admission.
+# ---------------------------------------------------------------------------
+def _pinned(manager) -> dict:
+    return getattr(manager, "_pinned_hits", {})
+
+
+def _tail_run(manager, request, decode_steps: int = 2) -> int:
+    hit = _tail_prefill(manager, request)
+    _tail_decode(manager, request, steps=decode_steps)
+    return hit
+
+
+def test_pinned_waiter_survives_concurrent_allocation(tail_retain):
+    """A1 finished and its next turn A2 waits (a slot is busy). Another
+    follow-up B is admitted meanwhile and its CoW/growth allocations pop the
+    free queue. Unpinned (the previous commit): A1's top attention block goes first
+    and A2 is a total miss. Pinned: A2's hit (attention prefix + the GDN
+    hold) is referenced, B's allocations take other blocks, A2 resumes at
+    A1's tail; the pin is released by A2's own admission and nothing leaks.
+    """
+    num_blocks = 64
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    b0 = make_request("B0", _tail_tokens(2, 150), TAIL_HASH, sha256)
+    _tail_run(manager, b0)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+    a1 = _tail_followup(a0, 26, seed=3)
+    _tail_run(manager, a1)
+    manager.free(a1)
+    _tail_drain_copies(manager)
+    manager.free(b0)
+    _tail_drain_copies(manager)
+
+    # A2 arrives and must wait; B1 (older in the queue) is admitted.
+    a2 = _tail_followup(a1, 20, seed=4)
+    a1_tail = _tail_position(a1.num_prompt_tokens)
+    pinned = manager.pin_waiting_hit(a2) if hasattr(manager, "pin_waiting_hit") else 0
+    assert pinned == (
+        len([b for g in manager.get_computed_blocks(a2)[0].blocks for b in g if not b.is_null])
+    )
+    assert manager.pin_waiting_hit(a2) == 0  # idempotent
+    hold = _tail_mamba(manager)
+    hit_blocks = _pinned(manager)[a2.request_id]
+    assert all(b.ref_cnt == 1 for b in hit_blocks)
+    assert set(b.block_id for b in hit_blocks).isdisjoint(_tail_free_ids(manager))
+
+    # Pool pressure from B1's admission and a burst: everything free goes.
+    b1 = _tail_followup(b0, 26, seed=5)
+    _tail_run(manager, b1)
+    taken = pool.get_new_blocks(pool.get_num_free_blocks())
+    assert all(b.block_hash is not None for b in hit_blocks)
+    pool.free_blocks(taken)
+
+    # A2 is admitted: its hit is intact; the admission releases the pin.
+    computed, num_hit, _ = manager.get_computed_blocks(a2)
+    assert num_hit == a1_tail
+    _tail_prefill(manager, a2)
+    assert a2.request_id not in _pinned(manager)
+    # Still cached: A2's table or CoW sources, never evicted.
+    assert all(b.block_hash is not None for b in hit_blocks)
+    _tail_decode(manager, a2, steps=2)
+    manager.free(a2)
+    manager.free(b1)
+    _tail_drain_copies(manager)
+    _tail_assert_pool_clean(manager, num_blocks)
+    del hold
+
+
+def test_pins_yield_before_a_running_request_fails_and_waiter_is_admitted_later(
+    tail_retain,
+):
+    """Pool exactly full: a running request needs a block, the free queue is
+    empty, the only reclaimable blocks are a waiter's pin. The pin yields
+    (``yield_pinned_hits``), the running request allocates without anyone
+    being preempted, and the waiter is still admitted when a slot frees
+    (possibly with a smaller hit). Nothing leaks."""
+    num_blocks = 48
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+    a1 = _tail_followup(a0, 26, seed=3)
+    a1_tail = _tail_position(a1.num_prompt_tokens)
+    assert manager.pin_waiting_hit(a1) > 0
+    pinned_ids = {b.block_id for b in _pinned(manager)[a1.request_id]}
+
+    # R runs and consumes the whole free queue (a cold prefill), then needs
+    # more: the pin is the only thing left to reclaim.
+    r = make_request("R", _tail_tokens(7, 2 * TAIL_BLOCK), TAIL_HASH, sha256)
+    _tail_run(manager, r, decode_steps=0)
+    taken = pool.get_new_blocks(pool.get_num_free_blocks())
+    assert pool.get_num_free_blocks() == 0
+    r.append_output_token_ids(777)
+    r.spec_token_ids = [778, 779, 780]
+    blocks = manager.allocate_slots(r, 1 + TAIL_SPEC, num_lookahead_tokens=TAIL_SPEC)
+    if blocks is None:
+        # The scheduler's step: yield pins, retry, no preemption.
+        released = manager.yield_pinned_hits()
+        assert released == len(pinned_ids)
+        assert a1.request_id not in _pinned(manager)
+        blocks = manager.allocate_slots(r, 1 + TAIL_SPEC, num_lookahead_tokens=TAIL_SPEC)
+    assert blocks is not None
+    r.spec_token_ids = []
+    r.num_computed_tokens += 1
+    manager.new_step_starts()
+    _tail_drain_copies(manager)
+    pool.free_blocks(taken)
+
+    # Slot frees: the waiter is admitted (hit may have shrunk, never stuck).
+    manager.free(r)
+    _tail_drain_copies(manager)
+    computed, num_hit, _ = manager.get_computed_blocks(a1)
+    assert 0 <= num_hit <= a1_tail
+    _tail_run(manager, a1)
+    manager.free(a1)
+    _tail_drain_copies(manager)
+    _tail_assert_pool_clean(manager, num_blocks)
+    assert not _pinned(manager)
+
+
+def test_pin_released_on_abort_admission_and_yield_without_leak(tail_retain):
+    num_blocks = 64
+    manager = _tail_manager(num_blocks, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+    free_baseline = pool.get_num_free_blocks()
+
+    # Abort while pinned.
+    w1 = _tail_followup(a0, 20, seed=3, suffix="w1")
+    assert manager.pin_waiting_hit(w1) > 0
+    assert pool.get_num_free_blocks() < free_baseline
+    manager.free(w1)  # abort path
+    assert not _pinned(manager) and pool.get_num_free_blocks() == free_baseline
+
+    # Bound: at most MAX_PINNED_WAITERS pins; one more is refused.
+    w2 = _tail_followup(a0, 21, seed=4, suffix="w2")
+    w3 = _tail_followup(a0, 22, seed=5, suffix="w3")
+    assert manager.pin_waiting_hit(w2) > 0
+    assert manager.pin_waiting_hit(w3) > 0
+    extra = [
+        _tail_followup(a0, 24 + i, seed=10 + i, suffix=f"x{i}")
+        for i in range(manager.MAX_PINNED_WAITERS - 1)
+    ]
+    for req in extra[:-1]:
+        assert manager.pin_waiting_hit(req) > 0
+    assert manager.pin_waiting_hit(extra[-1]) == 0
+    assert manager.num_pinned_waiters == manager.MAX_PINNED_WAITERS
+    # Yield one at a time, newest first, keeping the head.
+    assert manager.yield_pinned_hits(keep=w2.request_id, limit=1) > 0
+    assert list(_pinned(manager))[-1] == extra[-3].request_id
+    assert manager.yield_pinned_hits(keep=w2.request_id) > 0
+    assert list(_pinned(manager)) == [w2.request_id]
+    # Admission releases the head's pin; the hit it brought is referenced.
+    _tail_run(manager, w2)
+    assert not _pinned(manager)
+    manager.free(w2)
+    _tail_drain_copies(manager)
+    assert pool.get_num_free_blocks() == free_baseline
+    # reset_prefix_cache yields pins first and succeeds.
+    assert manager.pin_waiting_hit(w3) > 0
+    assert manager.reset_prefix_cache()
+    assert not _pinned(manager)
+    _tail_assert_pool_clean(manager, num_blocks)
+
+
+def test_scheduler_pins_the_front_of_the_waiting_queue(tail_retain):
+    """The scheduler's pass pins waiting follow-ups in arrival order up to
+    the manager's bound, skips requests that are not fresh lookups (partly
+    computed, async KV) and does nothing with a connector or caching off."""
+    manager = _tail_manager(96, attn_block=TAIL_BLOCK)
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+    waiters = [
+        _tail_followup(a0, 20 + i, seed=30 + i, suffix=f"q{i}")
+        for i in range(manager.MAX_PINNED_WAITERS + 2)
+    ]
+    waiters[1].num_computed_tokens = 8  # resumed async load: not a lookup
+    cold = make_request("COLD", _tail_tokens(9, 40), TAIL_HASH, sha256)
+    stub = SimpleNamespace(
+        kv_cache_manager=manager, connector=None, waiting=[cold, *waiters]
+    )
+    Scheduler._pin_waiting_hits(stub)
+    pinned = list(_pinned(manager))
+    assert waiters[1].request_id not in pinned
+    assert cold.request_id not in pinned  # nothing cached for it
+    assert pinned[0] == waiters[0].request_id
+    assert len(pinned) == manager.MAX_PINNED_WAITERS
+    assert waiters[-1].request_id not in pinned  # over the bound
+    # A second pass is idempotent; with a connector it is a no-op.
+    Scheduler._pin_waiting_hits(stub)
+    assert list(_pinned(manager)) == pinned
+    manager.yield_pinned_hits()
+    stub.connector = object()
+    Scheduler._pin_waiting_hits(stub)
+    assert not _pinned(manager)
+    _tail_assert_pool_clean(manager, 96)
