@@ -3368,3 +3368,26 @@ def test_scheduler_pins_the_front_of_the_waiting_queue(tail_retain):
     Scheduler._pin_waiting_hits(stub)
     assert not _pinned(manager)
     _tail_assert_pool_clean(manager, 96)
+
+
+def test_deferred_abort_of_a_pinned_waiter_releases_the_pin(tail_retain):
+    """pop_blocks_for_free (the deferred-free path a scheduler takes when a
+    step may still be in flight) releases a waiter's pin at once: the pin
+    is never written by any step, and leaving it would keep the blocks
+    pinned and a waiter slot taken until the next yield or reset."""
+    manager = _tail_manager(64, attn_block=TAIL_BLOCK)
+    pool = manager.block_pool
+    a0 = make_request("A0", _tail_tokens(1, 150), TAIL_HASH, sha256)
+    _tail_run(manager, a0)
+    manager.free(a0)
+    _tail_drain_copies(manager)
+    baseline = pool.get_num_free_blocks()
+    w = _tail_followup(a0, 20, seed=3)
+    assert manager.pin_waiting_hit(w) > 0
+    assert pool.get_num_free_blocks() < baseline
+    deferred = manager.pop_blocks_for_free(w)
+    assert deferred == []  # a waiter has no table blocks
+    assert not _pinned(manager) and manager.num_pinned_waiters == 0
+    assert pool.get_num_free_blocks() == baseline
+    pool.free_blocks(deferred)
+    _tail_assert_pool_clean(manager, 64)
