diff --git a/tests/test_merlin_toggle_defaults.py b/tests/test_merlin_toggle_defaults.py
new file mode 100644
index 0000000000..bb17582500
--- /dev/null
+++ b/tests/test_merlin_toggle_defaults.py
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fork (v2.5): the MERLIN_* kernel toggles default to the shipped value (1) when
+unset, and an explicit "0" is left alone. Each case runs `import vllm` in a
+fresh interpreter, since env_override applies the defaults at import time."""
+
+import json
+import os
+import subprocess
+import sys
+
+import pytest
+
+NAMES = (
+    "MERLIN_FULL_K",
+    "MERLIN_QSA_SORT",
+    "MERLIN_TIE_DET",
+    "MERLIN_TIE_RECENT",
+    "MERLIN_TOPK_SORTED_EMIT",
+)
+
+
+def _env_after_import(overrides: dict) -> dict:
+    env = {k: v for k, v in os.environ.items() if k not in NAMES}
+    env.update(overrides)
+    code = (
+        "import json, os, vllm, vllm.envs as e;"
+        f"print(json.dumps({{n: os.environ.get(n) for n in {NAMES!r}}}"
+        " | {'QSA_SORT_ENVS': e.MERLIN_QSA_SORT}))"
+    )
+    out = subprocess.run(
+        [sys.executable, "-c", code], env=env, capture_output=True, text=True, check=True
+    )
+    return json.loads(out.stdout.strip().splitlines()[-1])
+
+
+def test_unset_toggles_default_to_the_shipped_value():
+    got = _env_after_import({})
+    assert {n: got[n] for n in NAMES} == dict.fromkeys(NAMES, "1")
+    assert got["QSA_SORT_ENVS"] is True
+
+
+@pytest.mark.parametrize("name", NAMES)
+def test_explicit_zero_is_kept(name):
+    got = _env_after_import({name: "0"})
+    assert got[name] == "0"
+    others = [n for n in NAMES if n != name]
+    assert all(got[n] == "1" for n in others)
diff --git a/vllm/env_override.py b/vllm/env_override.py
index a6b3c373fa..fc15a40d03 100644
--- a/vllm/env_override.py
+++ b/vllm/env_override.py
@@ -182,6 +182,22 @@ os.environ.setdefault("TRITON_CACHE_AUTOTUNING", "1")
 # debug layout (see https://github.com/vllm-project/vllm/issues/41410).
 os.environ.setdefault("TILELANG_CLEANUP_TEMP_FILES", "1")
 
+# Fork (v2.5, knob-absent boot): the MERLIN_* kernel toggles are read by
+# getenv in C++ (FULL_K, TIE_DET, TIE_RECENT, TOPK_SORTED_EMIT) and by
+# vllm.envs (QSA_SORT) with OFF as the code default, while every shipped
+# launcher sets them to 1. Unset now means the shipped value; an explicit "0"
+# still turns a toggle off. Set here because this module runs on `import vllm`,
+# before any reader, and worker processes inherit the environment.
+_SHIPPED_KERNEL_TOGGLE_DEFAULTS = (
+    "MERLIN_FULL_K",
+    "MERLIN_QSA_SORT",
+    "MERLIN_TIE_DET",
+    "MERLIN_TIE_RECENT",
+    "MERLIN_TOPK_SORTED_EMIT",
+)
+for _name in _SHIPPED_KERNEL_TOGGLE_DEFAULTS:
+    os.environ.setdefault(_name, "1")
+
